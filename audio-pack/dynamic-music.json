{
  "version": 1,
  "music": [
    { "track": "encounter", "file": "audio/encounter.ogg", "priority": 900, "when": { "combat": 1 } },
    { "track": "solar-eclipse", "file": "audio/solar-eclipse.ogg", "priority": 800, "when": { "solarEclipse": true } },
    { "track": "blood-moon", "file": "audio/blood-moon.ogg", "priority": 700, "when": { "bloodMoon": true } },
    { "track": "meteor-shower", "file": "audio/meteor-shower.ogg", "priority": 600, "when": { "meteorShower": true } },
    { "track": "night", "file": "audio/night.ogg", "priority": 100, "when": { "dayState": "night" } },
    { "track": "day", "file": "audio/day.ogg", "priority": 0, "when": {} }
  ],
  "ambience": [
    { "track": "ambience-thunderstorm", "file": "audio/ambience-thunderstorm.ogg", "priority": 600, "when": { "weather": ["storm", "thunderstorm"] } },
    { "track": "ambience-rain", "file": "audio/ambience-rain.ogg", "priority": 500, "when": { "precipitation": "rain" } },
    { "track": "ambience-wind", "file": "audio/ambience-wind.ogg", "priority": 400, "when": { "precipitation": "snow" } }
  ]
}

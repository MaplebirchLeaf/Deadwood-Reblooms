{
  "name": "deadwood-reblooms",
  "version": "1.1.2",
  "private": true,
  "description": "DoL mod built on the maplebirch.",
  "author": "楓樺葉",
  "type": "module",
  "scripts": {
    "dev": "rspack serve",
    "prep": "bun run scripts/prep.ts",
    "build": "bun run rspack -- build --mode=production",
    "build:dev": "bun run rspack -- build --mode=development",
    "package": "bun run scripts/package.ts",
    "package:zip": "bun run scripts/package.ts --zip-only",
    "package:modpack": "bun run scripts/package.ts --modpack-only",
    "package:encrypted": "bun run build:all && bun run scripts/protected-release.ts",
    "build:all": "bun run prep && bun run build && bun run package",
    "bump": "bumpp --no-push --tag v%s",
    "release": "bun run scripts/release.ts",
    "check": "oxlint --disable-nested-config && oxfmt --check --disable-nested-config",
    "fix": "oxlint --fix --disable-nested-config && oxfmt --disable-nested-config"
  },
  "devDependencies": {
    "@rspack/cli": "^2.2.7",
    "@rspack/core": "^2.2.7",
    "@scml-dol-maplebirch/types": "5.1.3",
    "@types/adm-zip": "^0.5.8",
    "@types/bun": "^1.4.2",
    "@types/jquery": "^4.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/json5": "^2.2.0",
    "@types/jszip": "^3.4.1",
    "@types/node": "^26.6.3",
    "adm-zip": "^0.6.1",
    "bumpp": "^11.1.0",
    "js-yaml": "^4.3.2",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.85.0",
    "pkg-types": "^2.3.3",
    "spectrum-colorpicker": "^1.8.1",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.2",
  "scml": {
    "nickName": {
      "en": "Deadwood Reblooms",
      "cn": "枯木逢春"
    },
    "dependenceInfo": [
      {
        "modName": "maplebirch",
        "version": ">=5.1.3"
      },
      {
        "modName": "ModdedClothesAddon",
        "version": "^1.1.0"
      },
      {
        "modName": "ModLoader",
        "version": ">=2.0.0"
      },
      {
        "modName": "ModLoaderGui",
        "version": ">=1.0.0"
      },
      {
        "modName": "ModSubUiAngularJs",
        "version": ">=1.0.0"
      },
      {
        "modName": "ConflictChecker",
        "version": ">=1.0.0"
      },
      {
        "modName": "BeautySelectorAddon",
        "version": ">=2.0.0"
      },
      {
        "modName": "ReplacePatcher",
        "version": ">=1.0.0"
      },
      {
        "modName": "TweeReplacer",
        "version": ">=1.0.0"
      },
      {
        "modName": "GameVersion",
        "version": ">=0.5.12.13"
      }
    ]
  }
}

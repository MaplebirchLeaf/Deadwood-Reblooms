:: Deadwood Reblooms Longer Combat Widgets [widget]

<<widget 'Deadwood-Reblooms-LongerCombat-Options'>>
  <details open>
    <summary class='settingsHeader options'><span class='gold'><<lanSwitch 'Longer Combat' '更长遭遇战'>></span></summary>
    <div class='settingsGrid'>
      <div class='settingsToggleItemWide'>
        <div class='numberslider-inline maplebirch-relationcount-slider maplebirch-longercombat-option'>
          <label>
            <span class='maplebirch-longercombat-label'><<lanSwitch 'Time Per Turn(seconds)' '每回合时间(秒)'>></span>
            <span class='maplebirch-longercombat-slider'><<numberslider '$options.maplebirch.LongerCombat.seconds' $options.maplebirch.LongerCombat.seconds 5 60 5>></span>
          </label>
        </div>
        <div class='numberslider-inline maplebirch-relationcount-slider maplebirch-longercombat-option'>
          <label>
            <span class='maplebirch-longercombat-label'><<lanSwitch 'Max Encounters' '最大遭遇次数'>></span>
            <span class='maplebirch-longercombat-slider'><<numberslider '$options.maplebirch.LongerCombat.max' $options.maplebirch.LongerCombat.max 1 10 1>></span>
          </label>
        </div>
        <div class='numberslider-inline maplebirch-relationcount-slider maplebirch-longercombat-option'>
          <label>
            <span class='maplebirch-longercombat-label'><<lanSwitch 'Again Rate' '延续概率'>></span>
            <span class='maplebirch-longercombat-slider'><<numberslider '$options.maplebirch.LongerCombat.again' $options.maplebirch.LongerCombat.again 5 100 5 { value: v => `${v}%` }>></span>
          </label>
        </div>
      </div>
    </div>
  </details><hr>
<</widget>>
:: Deadwood Reblooms Sirris Estate Sirris Bath Meeting []
<<set $outside to 0>><<set $location to 'sirris_estate'>><<effects>>
<<deadwood-reblooms-sirris-estate-presence>>
<<if !_sirrisAtEstate or $SydneyExpansion.estate.bathVisitDay isnot Time.days
  or $SydneyExpansion.estate.bathVisitor isnot 'Sirris'>>
  <<lanSwitch 'You have already answered. The water runs on behind the door.' '你已经应过声了。门后的水声还在响。'>>
  <br><br><<getouticon>><<lanLink '返回门厅' 'Deadwood Reblooms Sirris Estate Hall'>><</lanLink>>
<<else>>
  <<language>>
    <<option 'EN'>>You answer from the hall. The water stops. "Oh, it's you," Sirris says through the closed door. "I thought I'd brought a towel in with me. Is there one outside? I'll be out in a moment."
    <<option 'CN'>>你站在走廊里应了一声。水声停了。“原来是你。”西里斯隔着门说，“我还以为把毛巾带进来了。门外有一条吗？我一会儿就出来。”
  <</language>>
  <br><br>
  <<socialiseicon 'ask'>><<lanLink '告诉西里斯毛巾就在门外' 'Deadwood Reblooms Sirris Estate Sirris Bath Towel'>><</lanLink>>
  <br><br><<getouticon>><<lanLink '让西里斯独自洗浴' 'Deadwood Reblooms Sirris Estate Hall'>><<set $SydneyExpansion.estate.bathVisitor to ''>><</lanLink>>
<</if>>

:: Deadwood Reblooms Sirris Estate Sirris Bath Towel []
<<set $outside to 0>><<set $location to 'sirris_estate'>><<effects>>
<<deadwood-reblooms-sirris-estate-presence>>
<<if _sirrisAtEstate and $SydneyExpansion.estate.bathVisitDay is Time.days
  and $SydneyExpansion.estate.bathVisitor is 'Sirris'>>
  <<set $SydneyExpansion.estate.bathVisitor to ''>>
  <<lanSwitch 'You tell Sirris the towel is on the shelf and step away from the door. The latch clicks behind you. "Thank you," Sirris calls. "There is fresh soap in the cupboard by the stairs if you want to bathe next."' '你告诉西里斯毛巾就在搁板上，随后退离门口。身后传来门锁轻响。“谢谢。”西里斯隔着门说，“你想接着洗的话，楼梯旁的橱柜里有新肥皂。”'>>
  <<npcincr Sirris love 1>><<glove 'Sirris'>>
<<else>>
  <<lanSwitch 'You have already said it. The towel is still on the shelf.' '你已经说过了。毛巾还在搁板上。'>>
<</if>>
<br><br><<getouticon>><<lanLink '返回门厅' 'Deadwood Reblooms Sirris Estate Hall'>><</lanLink>>

:: Deadwood Reblooms Sydney Bath Intimacy []
<<set $outside to 0>><<set $location to ($SydneyExpansion.bathReturn is 'estate') ? 'sirris_estate' : 'temple'>>
<<if $sexstart is 1>>
  <<clearnpc>><<npc Sydney>>
<</if>>
<<person1>><<run statusCheck('Sydney')>>
<<set $corruptionEvent to 1>>
<<if $sexstart is 1>>
  <<set $sexstart to 0>>
  <<set $daily.sydney.sex to ($daily.sydney.sex || 0) + 1>><<set $sydney.sexTotal += 1>>
  <<consensual>><<set $consensual to 1>><<neutral 1>><<maninit>>
  <<if _sydneyChastity>>
    <<npcClothesType $NPCList[0] 'undies'>>
  <<else>>
    <<npcexpose>>
  <</if>>
  <<set $enemytrust += 500>><<set $enemyarousalmax to 600>>
  <<if _sydneyStatus.includes('corrupt')>><<set $enemyarousalmax += 100>>
  <<elseif _sydneyStatus.includes('pure')>><<set $enemyarousalmax -= 100>><</if>>
  <<if _sydneyChastity and C.npc.Sydney.chastity.anus.includes('shield')>>
    <<set $enemyarousalmax -= 100>>
  <</if>>
  <<language>>
    <<option 'EN'>>Sydney takes your answer seriously, then closes the screen behind you.
    <<if _sydneyStatus.includes('pure')>>
      The cloister is still within earshot. "<span class='teal'>Tell me if you want to stop.</span>" <<He>> glances toward the corridor, then waits for your answer before kissing you.
    <<elseif _sydneyStatus.includes('corrupt')>>
      "<span class='lewd'>Come closer.</span>" <<He>> waits for your answer before kissing you.
    <<else>>
      "Is this all right?" <<he>> asks, waiting for your answer before kissing you.
    <</if>>
    <<option 'CN'>>悉尼认真听了你的回答，才在你身后合上屏风。
    <<if _sydneyStatus.includes('pure')>>
      回廊离得很近，外面仍能听见动静。“<span class='teal'>想停就告诉我。</span>”<<He>>朝走廊看了一眼，等你回答后才吻住你。
    <<elseif _sydneyStatus.includes('corrupt')>>
      “<span class='lewd'>再靠近一点。</span>”<<He>>等你回答后才吻住你。
    <<else>>
      “这样可以吗？”<<he>>问过，等你回答后才吻住你。
    <</if>>
  <</language>><br><br>
<</if>>
<<set $enemyanger to -10>>
<<effects>><<effectsman>><<man>><<stateman>>
<br><br><<actionsman>>
<<if _combatend>>
  <span id='next'><<lanLink '继续' 'Deadwood Reblooms Sydney Bath Intimacy Finish'>><</lanLink>></span><<nexttext>>
<<else>>
  <span id='next'><<lanLink '继续' 'Deadwood Reblooms Sydney Bath Intimacy'>><</lanLink>></span><<nexttext>>
<</if>>

:: Deadwood Reblooms Sydney Bath Intimacy Finish []
<<set $outside to 0>><<set $location to ($SydneyExpansion.bathReturn is 'estate') ? 'sirris_estate' : 'temple'>><<effects>>
<<if $SydneyExpansion.bathReturn is 'estate'>>
  <<set $SydneyExpansion.estate.bathVisitor to ''>>
<</if>>
<<person1>><<run statusCheck('Sydney')>>
<<if $enemyarousal gte $enemyarousalmax>>
  <<ejaculation>>
  <<if _sydneyChastity and $sydneyChastityKnown>><<sydneyChastityMessage>><<npcincr Sydney lust 3>><<ggslust>>
  <<else>><<npcincr Sydney lust -20>><<lllslust>><</if>>
  <<npcincr Sydney purity -2>><<lspurity>><<npcincr Sydney love 1>><<glove>><<sydneyFinish>>
  <<lanSwitch 'Sydney stays beside you while you catch your breath. <<He>> holds out a clean towel before moving the screen aside.' '你们平复呼吸时，悉尼仍留在你身边。<<He>>递给你干净的毛巾，才移开屏风。'>>
<<elseif $enemyhealth lte 0>>
  <<npcincr Sydney love -1>><<llove>>
  <<lanSwitch 'Sydney asks you to stop. You give <<him>> space and step away.' '悉尼请你停下。你给<<him>>留出空间，退到一旁。'>>
<<else>>
  <<npcincr Sydney lust 5>><<npcincr Sydney purity 2>><<gglust>><<gspurity>>

:: Deadwood Reblooms Sydney Science Widgets [widget]

<!-- 原版食堂谈话到 Sydney 好感 10 才会提到转班，入口沿用这道关系门槛。 -->
<<widget 'deadwood-reblooms-sydney-science-transfer-link'>>
  <<if $sydneyScience isnot 1 and $SydneyExpansion.scienceHint and C.npc.Sydney.love gte 10>>
    <<schoolicon 'science'>><<lanLink ['Ask about the class transfer', '询问换班的事'] 'Deadwood Reblooms Sydney Science Transfer'>><</lanLink>><br>
  <</if>>
<</widget>>

<!-- 科学课提示需先与 Sydney 熟识，随后首次同桌再按纯洁度播放介绍。 -->
<<widget 'deadwood-reblooms-sydney-science-intro'>>
  <<sydneySchedule>>
  <<if maplebirch.get('Sydney').available and C.npc.Sydney.love gte 10 and !$SydneyExpansion.scienceHint and $sydneyScience isnot 1 and Time.weekDay isnot 6>>
    <<set $SydneyExpansion.scienceHint to true>>
    <<lanSwitch 'Sirris sets aside a science book with Sydney’s name inside the cover. When you look at it, Sirris says, "Sydney asked about joining this class. There may be room for one more student."' '西里斯把一本封面内写着悉尼名字的科学课本放到一旁。见你望过去，西里斯说：“悉尼问过换班的事。这间教室或许还能坐下一个人。”'>>
    <br><span class='blue'><i><<lanSwitch 'You could ask Sydney about it at lunch.' '午餐时，你可以问问悉尼。'>></i></span><br><br>
  <</if>>
  <<if maplebirch.get('Sydney').available and $sydneyScience is 1 and _sydney_location is 'science' and !$sydneySeen.includes('science')>>
    <<run $sydneySeen.pushUnique('science')>>
    <<npc Sydney>><<person1>><<run statusCheck('Sydney')>>
    <<language>>
      <<option 'EN'>>
        Sydney arrives with <<his>> arms full of books and takes the empty seat beside you. Sirris glances over from the front. "Your
        class transfer was approved, Sydney. Try not to let the change distract you."
        <br><br>
        <<if _sydneyStatus.includes('corrupt')>>
          "No promises," Sydney whispers, opening <<his>> book with an innocent smile.
          <<if isLoveInterest('Sydney')>>
            <<His>> knee presses against yours beneath the desk.
          <</if>>
        <<elseif _sydneyStatus.includes('pure')>>
          Sydney straightens <<his>> notes. "I won't. Studying beside a friend should help me focus."
        <<else>>
          Sydney arranges <<his>> notes into a precise stack, then smiles at you. "I think it will help me focus."
        <</if>>
      <<option 'CN'>>
        悉尼抱着满怀的书走进教室，在你身边的空位坐下。西里斯从讲台前看过来。“你的换班申请通过了，悉尼。别因为换了教室就分心。”
        <br><br>
        <<if _sydneyStatus.includes('corrupt')>>
          “我可不敢保证。”悉尼低声说，带着无辜的笑容翻开课本。
          <<if isLoveInterest('Sydney')>>
            桌下，<<his>>的膝盖紧挨着你的。
          <</if>>
        <<elseif _sydneyStatus.includes('pure')>>
          悉尼理了理笔记。“不会的。和朋友一起学习，应该能让我更专心。”
        <<else>>
          悉尼把笔记码成整齐的一摞，然后朝你微笑。“我觉得这样反而更能专心。”
        <</if>>
    <</language>>
    <<endevent>>
    <br><br>
  <</if>>
<</widget>>

<!-- 科学课互动：提供核对笔记、聊天等常规行动。 -->
<<widget 'deadwood-reblooms-sydney-science-actions'>>
  <<if maplebirch.get('Sydney').available and $sydneyScience is 1 and _sydney_location is 'science'>>
    <<scienceicon>><<lanLink ['Compare notes with Sydney', '和悉尼核对笔记'] 'Deadwood Reblooms Sydney Science Study' >><</lanLink>><<gstress>><<gscience>><<glove 'Sydney'>>
    <br>
    <<socialiseicon>><<lanLink ['Chat with Sydney', '和悉尼聊天'] 'Deadwood Reblooms Sydney Science Chat' >><</lanLink>><<gcool>><<lstress>><<glove 'Sydney'>>
    <br>
  <</if>>
<</widget>>

<!-- gate 记录进入课堂时的阶段，原版推进检查后才在 LinkZone 补充离场对白。 -->
<<widget 'deadwood-reblooms-sydney-science-inspection-leave'>>
  <<sydneySchedule>>
  <<if maplebirch.get('Sydney').available and $sydneyScience is 1 and _sydney_location is 'science' and !$replayScene
    and [0, 1, 2].includes(_deadwood_science_event) and $schoolevent is _deadwood_science_event + 1>>
    <<language>>
      <<option 'EN'>>
        From the doorway, Sirris calls Sydney. "Come and help me with the books." Sydney gathers <<nnpc_his 'Sydney'>> things,
        glances back at you, and follows Sirris out. The seat beside you is left empty.
      <<option 'CN'>>
        西里斯在门口叫了悉尼一声。“来帮我搬一下课本。”悉尼收好东西，回头看了你一眼，跟着西里斯出去了。你身边的座位空了下来。
    <</language>>
    <br><br>
  <</if>>
<</widget>>

<!-- 解剖示范沿用原版选项与结算，仅在链接区域追加同桌反应，不替换西里斯和学生的 NPC 槽位。 -->
<<widget 'deadwood-reblooms-sydney-science-anatomy'>>
  <<sydneySchedule>>
  <<if maplebirch.get('Sydney').available and $sydneyScience is 1 and _sydney_location is 'science' and !$replayScene>>
    <<run statusCheck('Sydney')>>
    <<if $passage is 'Science Refusal'
      or ($passage is 'Science Undress' and [1, 2, 5].includes($phase))
      or ($passage is 'Science Undress Desk' and $phase is 3)
      or ($passage is 'Science Event3' and (($scienceprogression lt 1 and $delinquency lt 400) or $delinquency lt 10))>>
      <<language>>
        <<option 'EN'>>
          Sydney moves <<nnpc_his 'Sydney'>> books aside as you take your seat.
          <<if $passage is 'Science Refusal'>>
            <<if _sydneyStatus.includes('corrupt')>>
              "They can find someone else to stare at," <<nnpc_he 'Sydney'>> mutters, then opens <<nnpc_his 'Sydney'>> notebook between you.
            <<elseif _sydneyStatus.includes('pure')>>
              "Are you all right?" <<nnpc_he 'Sydney'>> whispers. "I wrote down the lesson. You haven't missed much."
            <<else>>
              "Here," <<nnpc_he 'Sydney'>> whispers, turning <<nnpc_his 'Sydney'>> notebook towards you. "I've kept up with the notes."
            <</if>>
          <<elseif $passage is 'Science Event3'>>
            "I labelled the diagram while you were up there," <<nnpc_he 'Sydney'>> whispers, showing you the page.
          <<elseif $passage is 'Science Undress' and $phase is 5>>
            <<if _sydneyStatus.includes('corrupt') and isLoveInterest('Sydney')>>
              "You enjoyed that, didn't you?" <<nnpc_he 'Sydney'>> whispers with a grin. "I nearly forgot to take notes."
            <<else>>
              Sydney looks down at <<nnpc_his 'Sydney'>> notebook, cheeks still pink. "I think I got everything. The notes, I mean."
            <</if>>
          <<else>>
            <<if _sydneyStatus.includes('corrupt')>>
              Sydney looks over your face, then glances at the students still watching. "Lesson's over," <<nnpc_he 'Sydney'>> tells them.
              <<nnpc_He 'Sydney'>> pushes <<nnpc_his 'Sydney'>> notebook towards you. "You can copy mine."
            <<elseif _sydneyStatus.includes('pure')>>
              Sydney keeps <<nnpc_his 'Sydney'>> eyes on your face. "I-I took notes," <<nnpc_he 'Sydney'>> whispers. "If you'd like them."
            <<else>>
              "You can copy what you missed," Sydney whispers, laying <<nnpc_his 'Sydney'>> notebook between you.
            <</if>>
          <</if>>
        <<option 'CN'>>
          你回到座位时，悉尼把课本往旁边挪了挪。
          <<if $passage is 'Science Refusal'>>
            <<if _sydneyStatus.includes('corrupt')>>
              “想看就找别人去。”<<nnpc_he 'Sydney'>>小声嘀咕，把笔记本摊在你们中间。
            <<elseif _sydneyStatus.includes('pure')>>
              “你还好吗？”<<nnpc_he 'Sydney'>>轻声问，“我记了笔记。你没落下多少。”
            <<else>>
              “看这里。”<<nnpc_he 'Sydney'>>压低声音，把笔记本转向你，“我一直在记。”
            <</if>>
          <<elseif $passage is 'Science Event3'>>
            “你在前面的时候，我把图上的标注写好了。”<<nnpc_he 'Sydney'>>轻声说，给你看那一页。
          <<elseif $passage is 'Science Undress' and $phase is 5>>
            <<if _sydneyStatus.includes('corrupt') and isLoveInterest('Sydney')>>
              “刚才挺得意的，对吧？”<<nnpc_he 'Sydney'>>笑着低声说，“我差点忘了记笔记。”
            <<else>>
              悉尼低头看着笔记本，脸颊还泛着红。“应该都记下来了。我是说，笔记。”
            <</if>>
          <<else>>
            <<if _sydneyStatus.includes('corrupt')>>
              悉尼打量了一下你的脸，又看向那些还在张望的学生。“讲完了。”<<nnpc_he 'Sydney'>>对他们说，随后把笔记本推向你。“抄我的吧。”
            <<elseif _sydneyStatus.includes('pure')>>
              悉尼只看着你的脸。“我、我记了笔记。”<<nnpc_he 'Sydney'>>轻声说，“你想看的话。”
            <<else>>
              “没听到的可以抄我的。”悉尼轻声说，把笔记本摊在你们中间。
            <</if>>
          <</if>>
      <</language>>
      <br><br>
      <<deadwood-reblooms-sydney-science-borrow-notes>>
    <<elseif $passage is 'Science Event3' or ($passage is 'Science Undress' and [3, 4].includes($phase))>>
      <<language>>
        <<option 'EN'>>
          You catch Sydney's eye from the front of the room.
          <<if _sydneyStatus.includes('corrupt') and isLoveInterest('Sydney') and $uncomfortable.nude is false>>
            <<nnpc_He 'Sydney'>> gives you a quick wink, then looks back at <<nnpc_his 'Sydney'>> notes as Sirris turns towards the class.
          <<elseif _sydneyStatus.includes('pure')>>
            Sydney's fingers tighten round <<nnpc_his 'Sydney'>> pen. <<nnpc_He 'Sydney'>> gives you a small, uncertain smile.
          <<else>>
            Sydney glances at Sirris, then back at you. <<nnpc_He 'Sydney'>> keeps the seat beside <<nnpc_him 'Sydney'>> clear.
          <</if>>
        <<option 'CN'>>
          你站在教室前面，与悉尼的目光相遇。
          <<if _sydneyStatus.includes('corrupt') and isLoveInterest('Sydney') and $uncomfortable.nude is false>>
            <<nnpc_He 'Sydney'>>飞快地朝你眨了一下眼。西里斯转向全班时，<<nnpc_he 'Sydney'>>又低头看起了笔记。
          <<elseif _sydneyStatus.includes('pure')>>
            悉尼握紧了手中的笔，朝你露出一个有些不安的微笑。
          <<else>>
            悉尼看了看西里斯，又望向你，身边的座位仍为你空着。
          <</if>>
      <</language>>
      <br><br>
    <</if>>
  <</if>>
<</widget>>

<<widget 'deadwood-reblooms-sydney-science-borrow-notes'>>
  <<if $SydneyExpansion.science_notes_day isnot Time.days>>
    <<linkreplace `lanSwitch("Borrow Sydney's notes", '借悉尼的笔记')`>>
      <<if $SydneyExpansion.science_notes_day isnot Time.days>>
        <<set $SydneyExpansion.science_notes_day to Time.days>>
        <<scienceskill 1>><<npcincr Sydney love 1>>
        <<language>>
          <<option 'EN'>>
            You thank Sydney and copy the missing notes. <<nnpc_He 'Sydney'>> points out a label you nearly missed, smiling as you add it.
          <<option 'CN'>>
            你谢过悉尼，补上没记下的内容。<<nnpc_He 'Sydney'>>指了指你差点漏掉的标注，见你添上后，露出了笑容。
        <</language>>
        <<gscience>><<glove 'Sydney'>>
      <</if>>
    <</linkreplace>><br><br>
  <</if>>
<</widget>>

<!-- 科学课随机事件：注册 Sydney 参与的课堂事件。 -->
<<widget 'deadwood-reblooms-sydney-science-events'>>
  <<sydneySchedule>><<run statusCheck('Sydney')>>
  <<if maplebirch.get('Sydney').available and $sydneyScience is 1 and _sydney_location is 'science'>>
    <<addinlineevent 'scienceSydneyPartner' 2>>
      <<npc Sydney>><<person1>>
      <<npcincr Sydney love 1>><<scienceskill 1>>
      <<language>>
        <<option 'EN'>>
          Sirris divides the class into pairs for a short experiment. Sydney moves <<his>> equipment beside yours before anyone else can
          claim the seat.
          <br><br>
          <<if _sydneyStatus.includes('corrupt')>>
            <<He>> follows the instructions, then taps the word "insert" with <<his>> pen and glances at you.
            <<if isLoveInterest('Sydney')>>
              "Only the probe," <<he>> whispers, brushing <<his>> knee against yours beneath the bench.
            <<else>>
              "Careful. That's the part everyone gets wrong," <<he>> says with a grin.
            <</if>>
            Sirris asks for the next measurement. Sydney looks back at the apparatus and reads it out correctly.
          <<elseif _sydneyStatus.includes('pure')>>
            <<He>> checks each measurement twice and catches your hand before you add too much reagent. Your final result matches the textbook
              exactly.
          <<else>>
            <<He>> divides the work into a neat list and passes you the more interesting half. Together, you finish before most of the class.
          <</if>>
          <<glove>><<gscience>>
        <<option 'CN'>>
          西里斯把全班分成两人一组，进行一项简短实验。还没等别人占走座位，悉尼便把实验器材搬到了你旁边。
          <br><br>
          <<if _sydneyStatus.includes('corrupt')>>
            <<He>>照着步骤操作，用笔点了点“插入”两个字，又看向你。
            <<if isLoveInterest('Sydney')>>
              “我是说探针。”<<he>>低声说，桌下的膝盖轻轻碰了碰你的。
            <<else>>
              “小心，这一步最容易弄错。”<<he>>笑着说。
            <</if>>
            西里斯问起下一项读数。悉尼重新看向仪器，准确地报了出来。
          <<elseif _sydneyStatus.includes('pure')>>
            <<He>>把每项测量都核对两遍，并在你加入过量试剂前及时握住你的手。最终结果与课本完全一致。
          <<else>>
            <<He>>把工作整理成一张清单，将更有趣的一半分给你。你们比班上大多数人都更早完成。
          <</if>>
          <<glove>><<gscience>>
      <</language>>
      <br><br>
      <<lanLink ["Continue","继续"] 'Science Lesson'>><<endevent>><</lanLink>>
      <br>
    <</addinlineevent>>

    <<if _sydneyStatus.includes('corrupt') and C.npc.Sydney.lust gte 20 and ($sydneyromance is 1 or hasSexStat('promiscuity', 2))>>
      <<addinlineevent 'scienceSydneyTease' 1>>
        <<npc Sydney>><<person1>>
        <<language>>
          <<option 'EN'>>
            A folded note slides beneath your hand. It asks whether you would like a "practical demonstration" after class. Sydney keeps
            <<his>> eyes on Sirris, but <<his>> foot brushes slowly along your ankle beneath the desk.
          <<option 'CN'>>
            一张折好的纸条滑到你的手下，上面问你课后要不要来一次“实践演示”。悉尼仍看着西里斯，桌下的脚却缓缓蹭过你的脚踝。
        <</language>>
        <br><br>
        <<lanLink ['Play along', '陪悉尼玩'] 'Deadwood Reblooms Sydney Science Tease'>>
          <<set $phase to 1>><<npcincr Sydney lust 1>>
        <</lanLink>><<garousal>><<glust>><br>
        <<lanLink '继续学习' 'Deadwood Reblooms Sydney Science Tease'>><<set $phase to 0>><</lanLink>><<gscience>><br>
      <</addinlineevent>>
    <</if>>
  <</if>>
<</widget>>

<!-- 课堂保护事件：让 Sydney 按当前状态制止同学骚扰。 -->
<<widget 'deadwood-reblooms-sydney-science-protect'>>
  <<npc Sydney>><<person1>><<run statusCheck('Sydney')>>
  <<stress -6>><<trauma -3>><<npcincr Sydney love 1>>
  <<language>>
    <<option 'EN'>>
      A group of delinquents turn towards you, but Sydney is already out of <<his>> seat.
      <<if _sydneyStatus.includes('corrupt')>>
        <<He>> plants a hand on their desk and uncaps a red marker. "Overdue books," <<he>> says, turning the pen between <<his>> fingers, "I have
          ways of dealing with those. Do you have a way of dealing with me?"
        <<if $sydneyWhitneyBook gte 1>>
          You've seen <<him>> use that marker on Whitney. The delinquents glance at it, then look away.
        <<else>>
          <<He>> holds their gaze until Sirris looks up. The delinquents turn back to their books.
        <</if>>
      <<elseif _sydneyStatus.includes('pure')>>
        <<He>> steps between you and them despite <<his>> trembling hands. "Leave <<phim>> alone," <<he>> says, loud enough for Sirris to hear.
          Sirris promptly sends the offenders to the other side of the classroom.
      <<else>>
        <<He>> moves <<his>> chair beside yours, putting <<himself>> squarely in their path. "<<pShe>> isn't alone," Sydney says. Sirris notices the
          gathering and orders the delinquents back to their seats.
      <</if>>
      Sydney stays close until they have gone.
      <<lstress>><<ltrauma>><<glove>>
    <<option 'CN'>>
      一群坏学生转身盯上了你，但悉尼已经离开座位。
      <<if _sydneyStatus.includes('corrupt')>>
        <<He>>一只手按在他们桌上，拔开红色记号笔的笔帽，把笔在指间转了一圈。“逾期的书，”<<he>>说，
          “我有的是办法。你们有办法对付我吗？”
        <<if $sydneyWhitneyBook gte 1>>
          你见过<<him>>拿这支笔对付惠特尼。那群坏学生看了看笔，又移开视线。
        <<else>>
          <<He>>一直盯着他们，直到西里斯抬起头。那群坏学生这才转回去看书。
        <</if>>
      <<elseif _sydneyStatus.includes('pure')>>
        尽管双手还在发抖，<<he>>仍挡在你和他们之间。“别碰<<phim>>。”<<he>>故意说得足够响亮，让西里斯听见。西里斯立刻把那些人赶到了教室另一边。
      <<else>>
        <<He>>把椅子挪到你旁边，正好挡住他们的去路。“<<pShe>>不是一个人。”悉尼说道。西里斯注意到这边的动静，命令那群坏学生回到座位。
      <</if>>
      悉尼一直守在你身边，直到他们离开。
      <<lstress>><<ltrauma>><<glove>>
  <</language>>
  <br><br>
  <<schoolicon 'science'>><<lanLink '继续上课' 'Science Lesson'>><<endevent>><</lanLink>><br>
<</widget>>

<!-- 迟到补救入口：仅在上课日清晨，原版日程确认悉尼睡过头时显示。 -->
<<widget 'deadwood-reblooms-sydney-science-late-intro'>>
  <<sydneySchedule>>
  <<if maplebirch.get('Sydney').available and $exposed lte 0 and Time.schoolDay and _sydney_location is 'late' and $sydneyScience is 1 and !$sydneySeen.includes('science')>>
    <br>
    <<language>>
      <<option 'EN'>>
        You find Sydney asleep on a pew, with <<nnpc_his 'Sydney'>> neatly folded school clothes beside <<nnpc_him 'Sydney'>>.
        <<if Time.hour is 9>>
          <<nnpc_He 'Sydney'>> has slept through the start of <<nnpc_his 'Sydney'>> new science class.
        <<else>>
          If no one wakes <<nnpc_him 'Sydney'>>, <<nnpc_he 'Sydney'>> may miss <<nnpc_his 'Sydney'>> first science class with you.
        <</if>>
      <<option 'CN'>>
        你发现悉尼睡在长椅上，身旁放着叠得整整齐齐的校服。
        <<if Time.hour is 9>>
          <<nnpc_He 'Sydney'>>已经错过了换到这间教室后的第一堂科学课开头。
        <<else>>
          如果没人叫醒<<nnpc_him 'Sydney'>>，<<nnpc_he 'Sydney'>>可能会错过第一次和你一起上的科学课。
        <</if>>
    <</language>>
    <br>
    <<if Time.hour is 9>>
      <<templeicon 'pew'>><<lanLink '叫醒悉尼' 'Deadwood Reblooms Sydney Science Late Wake'>><<npcincr Sydney love 1>><</lanLink>>
    <<else>>
      <<templeicon 'pew'>><<lanLink '叫醒悉尼' 'Temple Sydney Wakeup'>><<npcincr Sydney love 1>><</lanLink>>
    <</if>>
    <<glove 'Sydney'>>
    <br>
  <</if>>
<</widget>>

:: Deadwood Reblooms Sydney Science Transfer []
<<set $sydneyScience to 1>><<npc Sydney>><<person1>><<run statusCheck('Sydney')>>
<<language>>
  <<option 'EN'>>
    "<span class='green'>It was approved</span>," Sydney says, brightening. "My <<nnpc_mum 'Sirris'>> arranged the transfer. Starting tomorrow, I'll be in your
    science class."
    <br><br>
    <<if _sydneyStatus.includes('corrupt')>>
      <<He>> taps <<his>> pen against your hand. "<span class='lewd'>Maybe we can arrange a few practical experiments of our own.</span>"
    <<elseif _sydneyStatus.includes('pure')>>
      <<He>> gathers <<his>> books into a neater stack. "<span class='teal'>It will be nice studying beside someone I trust.</span>"
    <<else>>
      <<He>> gathers <<his>> books into a neater stack. "It will be nice having someone I know there."
    <</if>>
  <<option 'CN'>>
    “<span class='green'>已经批准了。</span>”悉尼的神情明亮起来。“我的<<nnpc_mum 'Sirris'>>帮忙安排了换班。从明天开始，我就会和你一起上科学课。”
    <br><br>
    <<if _sydneyStatus.includes('corrupt')>>
      <<He>>用笔轻轻敲了敲你的手。“<span class='lewd'>也许我们还能安排几项自己的实践实验。</span>”
    <<elseif _sydneyStatus.includes('pure')>>
      <<He>>把书收拾成更整齐的一摞。“<span class='teal'>能和信任的人一起学习，真好。</span>”
    <<else>>
      <<He>>把书收拾成更整齐的一摞。“教室里能有个熟人，真好。”
    <</if>>
<</language>>
<br><br>
<<endevent>>
<<historyicon>><<lanLink ['Go to your history lesson (0:01)', '去上历史课 (0:01)'] 'History Classroom' >><<set $justEntered to true>><<pass 1>><</lanLink>><br>
<<schoolicon 'library'>><<lanLink ['Follow Sydney to the library (0:02)', '跟悉尼去图书馆 (0:02)'] 'School Library'>><<pass 2>><</lanLink>><br>

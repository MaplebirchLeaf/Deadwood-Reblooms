<<sydneySchedule>>
<<set _requestedHours to $sleephour>>
<<set _nightWake to _sydneyResting
  and isLoveInterest('Sydney')
  and _requestedHours gte 3
  and (Time.hour gte 22 or Time.hour lt 3)
  and $SydneyExpansion.night_wake_day isnot Time.days
  and $nightmares lte 0
  and random(1, 8) is 1>>
<<if _nightWake>>
  <<set $sleephour to random(1, Math.min(2, _requestedHours - 1))>>
<</if>>
<<sleep>>
<<if !_dreaming>>
  <<effects>><<wakingEffects $sleepHoursTotal>>
  <<sydneySchedule>><<run statusCheck('Sydney')>>
  <<set _nightWake to _nightWake
    and _sydneyResting
    and !_wakingEffect
    and $sleepHoursTotal gte 1
    and (Time.hour gte 23 or Time.hour lt 6)>>
  <<if _nightWake>>
    <<set $SydneyExpansion.night_wake_day to Time.days>>
    <<set $sleephour to Math.max(1, _requestedHours - $sleepHoursTotal)>>

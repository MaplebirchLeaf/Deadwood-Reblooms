:: Deadwood Reblooms Sydney Dorm Widgets [widget]
<<widget 'deadwood-reblooms-sydney-dorm-link'>><<silently>>
  <<set _position to _args[0]>>
  <<if _sydneyAvailable is undefined>>
    <<sydneySchedule>>
  <</if>>
  <<set _cleaningLink to $exposed lt 1 and Time.dayState isnot 'night' and $temple_quarters lt 100 and !pcAreArmsBound('both')>>
  <<set _showDormLink to _dormAccess and $temple_rank is 'monk' and $stress lt $stressmax and _position is (_cleaningLink ? 2 : 1)>>
<</silently>><<if _showDormLink and !$SydneyExpansion.dormInvited and _sydneyWorking>>
  <<icon 'temple/sydney-quarters.png'>><<lanLink ['Ask Sydney to sit by the bunk', '问悉尼能否来床铺旁坐坐'] 'Deadwood Reblooms Sydney Dorm Bunk Invitation'>><</lanLink>><br>
<<elseif _showDormLink and $SydneyExpansion.dormInvited>>
  <<icon 'temple/sydney-quarters.png'>><<lanLink ["Sydney's bunk (0:01)", '悉尼的床铺 (0:01)'] 'Deadwood Reblooms Sydney Dorm'>><<pass 1>><</lanLink>><br>
<</if>><</widget>>

<<widget 'deadwood-reblooms-sydney-dorm-sirris-link'>><<silently>>
  <<if _sydneyAvailable is undefined>>
    <<sydneySchedule>>
  <</if>>
<</silently>>
<<if _sirrisMorning>>
  <<getouticon>><<lanLink '和悉尼去见西里斯' 'Deadwood Reblooms Sydney Halloween Morning'>><</lanLink>><br>
<</if>>
<</widget>>

<<widget 'deadwood-reblooms-sydney-dorm-bed-links'>>
  <<if $earSlime.event and $earSlime.noSleep>>
    <span class='red'><<lanSwitch 'The slime will not let you sleep yet.' '史莱姆现在不让你睡觉。'>></span><br>
  <<else>>
    <<icon 'temple/sydney-bed.png'>>
    <<lanLink ['Strip and lie beside Sydney', '脱衣躺到悉尼身旁'] 'Deadwood Reblooms Sydney Dorm Bed'>>
      <<undressSleep 'Deadwood Sydney Dorm Bed'>>
    <</lanLink>><br>
    <<if !$earSlime.alwaysSleepNaked or $hypnosis_traits.silence>>
      <<set $storeLocation to 'Deadwood Sydney Dorm Bed'>>
      <<set $wardrobe_location to 'temple'>><<wardrobeSelection true>>
      <<for _index, _outfit range $outfit>>
        <<if _outfit.type.includes('sleep')>>
          <<capture _index _outfit>>
            <<icon 'temple/sydney-bed.png'>>
            <<set _outfitname to _outfit.name + (_outfit.colors is false ? '' : ' [C]')>>
            <<lanLink `['Wear ' + _outfitname + ' and lie beside Sydney', '穿上' + _outfitname + '并躺到悉尼身旁']` 'Deadwood Reblooms Sydney Dorm Bed'>>
              <<set $wear_outfit to _index>><<saveTempHairStyle>>
            <</lanLink>><br>
          <</capture>>
        <</if>>
      <</for>>
    <</if>>
  <</if>>
<</widget>>

:: Deadwood Reblooms Sydney Dorm Bunk Invitation []
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<sydneySchedule>>
<<npc Sydney>><<person1>>
<<if _dormAccess and $temple_rank is 'monk' and _sydneyWorking>>
  <<set $SydneyExpansion.dormInvited to true>>
  <<language>>
    <<option 'EN'>>
      Sydney finishes folding a robe and looks up when you ask about <<his>> bunk.
      "You can come and sit with me when I'm here," <<he>> says. <<He>> moves a stack of books from the end of the bed.
      <br><br>
      "If I'm asleep, wake me gently. The others get up early."
    <<option 'CN'>>
      悉尼叠好修道袍。你问起<<his>>的床铺，<<he>>抬头看向你。
      “我在这儿的时候，你可以过来坐。”<<he>>说着，把床尾的书挪开。
      <br><br>
      “要是我睡着了，轻点叫醒我。其他人起得很早。”
  <</language>>
<<else>>
  <<lanSwitch 'Sydney is not by the bunks now. You can ask another time.' '悉尼现在不在床铺旁。你可以改天再问。'>>
<</if>>
<br><br>
<<getouticon>><<lanLink '返回宿舍' 'Temple Quarters'>><</lanLink>>

:: Deadwood Reblooms Sydney Dorm []
<<set $outside to 0>><<set $location to 'temple'>><<sydneySchedule>><<temple_effects>><<effects>>
<!-- 宿舍床上的衣物单独存放。返回宿舍时按原版床铺的做法取回。 -->
<<if setup.clothingLayer.all.some(slot => $store[slot]?.some(item => item.location === 'Deadwood Sydney Dorm Bed'))>>
  <<set $wardrobe_location to 'temple'>>
  <<storeon 'Deadwood Sydney Dorm Bed'>><<loadTempHairStyle>>
  <<set $wear_outfit to 'none'>>
<</if>>
<!-- 在宿舍场景再次检查权限，避免节日链接绕过入口条件。 -->
<<if !_dormAccess>>
  <<if !['monk', 'priest'].includes($temple_rank) or $sydney?.rank isnot 'monk'>>
    <<lanSwitch "You and Sydney must both pass the temple's trial before you can use the bunks." '你和悉尼都通过神殿的考核后，才能使用这里的床铺。'>>
  <<elseif $sydneyromance isnot 1>>
    <<lanSwitch "Sydney has not invited you to stay beside the bunk yet." '悉尼还没有邀请你留在床铺旁。'>>
  <<else>>
    <<lanSwitch "Sydney is not here today. The bunk is empty." '悉尼今天不在这里。床铺空着。'>>
  <</if>>
  <br><br>
  <<lanLink ["Continue","继续"] 'Temple Quarters'>><</lanLink>>
<<elseif !$SydneyExpansion.dormInvited>>
  <<lanSwitch 'Sydney has not shown you the bunk yet. You leave the quarters alone.' '悉尼还没有带你看过床铺。你独自离开宿舍。'>>
  <br><br>
  <<lanLink ["Continue","继续"] 'Temple Quarters'>><</lanLink>>
<<elseif !_sydneyResting and !_sydneyWorking>>
  <<if _sirrisMorning>>
    <<lanSwitch 'Sydney is already outside with Sirris.' '悉尼已经和西里斯在神殿外面了。'>>
    <br><br>
    <<lanLink '和悉尼去见西里斯' 'Deadwood Reblooms Sydney Halloween Morning'>><</lanLink>>
  <<elseif _sydney_location is 'temple' and $sydney_templeWork is 'pray'>>
    <<lanSwitch "Sydney's bunk is empty. Sydney is praying on a pew downstairs." '悉尼的床铺空着。悉尼正在楼下的长椅上祈祷。'>>
  <<elseif _sydney_location is 'temple' and $sydney_templeWork is 'garden'>>
    <<lanSwitch "Sydney's bunk is empty. Sydney is working in the temple garden." '悉尼的床铺空着。悉尼正在神殿花园里忙碌。'>>
  <<elseif _sydneyWorking>>
    <<lanSwitch "Sydney's bunk is empty. Sydney is carrying laundry and cleaning supplies around the quarters." '悉尼的床铺空着。悉尼正拎着衣物和清洁用品在宿舍区域忙碌。'>>
  <<else>>
    <<lanSwitch "Sydney is not by the bunks now. You can ask another time." '悉尼现在不在床铺旁。你可以改天再问。'>>
  <</if>>
  <br><br>
  <<getouticon>><<lanLink '返回宿舍' 'Temple Quarters'>><</lanLink>>
<<else>>
<<npc Sydney>><<person1>><<run statusCheck('Sydney')>>

<!-- 首访说明双方通过试炼后的床铺权限，普通日程和节日同行都需要悉尼当面邀请。 -->
<<if !$SydneyExpansion.dormVisited>>
  <<set $SydneyExpansion.dormVisited to true>>
  <<language>>
    <<option 'EN'>>
      You and Sydney have both passed the temple's trial. When you reach the quarters together, <<he>> shows you the bunk that is now <<his>> to use
      between duties. A folded robe rests at the head of the bed; the books below it have already found their places.
      <br><br>
      <<if _sydneyStatus.includes('pure')>>
        "<span class='green'>We made it</span>," <<he>> says, touching the neatly folded sleeve. <<He>> smiles at you before looking away.
      <<elseif _sydneyStatus.includes('corrupt')>>
        "Same floor, different shifts," <<he>> murmurs. "At least we'll know where to find each other."
      <<else>>
        "I kept wondering whether we'd both pass," <<he>> admits. "It's good to see you here."
      <</if>>
    <<option 'CN'>>
      你和悉尼都通过了神殿的考核。你们一起来到宿舍，<<he>>指给你看今后轮班之余属于<<him>>的床铺。
      床头叠着一件修道袍，床下的书也已经归置妥当。
      <br><br>
      <<if _sydneyStatus.includes('pure')>>
        “<span class='green'>我们都通过了。</span>”<<he>>摸了摸叠好的衣袖，朝你笑了一下，又不好意思地移开目光。
      <<elseif _sydneyStatus.includes('corrupt')>>
        “同一层楼，不同的值班时间。”<<he>>轻声说，“至少我们知道该去哪里找对方。”
      <<else>>
        “我一直怕只有我们中的一个能通过。”<<he>>承认道，“能在这里见到你，真好。”
      <</if>>
  <</language>>
  <br><br>
<</if>>

<<language>>
  <<option 'EN'>>
    You stop beside Sydney's bunk in the temple quarters. A robe hangs neatly from the bedpost. Books are stacked beneath it, with a ribbon marking
    the page Sydney left open. A wardrobe stands against the wall, and a screen gives the residents somewhere to change.
    <br><br>
    <<if _sydneyWorking>>
      Sydney is sorting the laundry for the next shift. <<He>> puts down a folded robe and makes room for you beside the wardrobe.
    <<elseif _festivalNight>>
      The Halloween lantern stands beside the books, its candle finally extinguished. Sydney has spread a spare blanket over the end of the bunk.
    <<elseif $sydney_templeWork is 'sleep'>>
      The other residents are asleep. Sydney stirs at your footsteps and lifts the edge of the blanket so you can sit down without waking anyone.
    <<else>>
      Sydney puts down the robe <<he>> was folding and makes room for you among the books.
    <</if>>
    <br><br>
    <<if _sydneyWorking>>
      Sydney shows you the robes still waiting to be folded. "Could you give me a hand?" <<he>> asks, clearing a space beside the wardrobe.
    <<elseif _sydneyStatus.includes('corrupt')>>
      Sydney moves a book aside. "You found me," <<he>> whispers, glancing at the neighbouring beds.
    <<elseif _sydneyStatus.includes('pure')>>
      Sydney smooths the blanket beside <<him>>. "<span class='teal'>I'm glad you came</span>," <<he>> says softly.
    <<else>>
      Sydney moves a book aside. "I could use a little company," <<he>> says.
    <</if>>
    <<if $exposed gte 1>>
      <br><br>
      Sydney notices your uncovered skin.
      <<if _sydneyStatus.includes('corrupt')>>
        <span class="lewd"><<He>> lets <<his>> gaze linger</span> until you catch <<him>>, then smiles.
      <<else>>
        <<He>> looks away, the tips of <<his>> ears turning pink.
      <</if>>
    <</if>>
  <<option 'CN'>>
    你走到神殿宿舍里悉尼的床铺旁。一件修道袍整齐地挂在床柱上，下面叠着几本书。
    悉尼在读到一半的那页夹了根缎带。墙边是收纳衣物的柜子，屏风挡住了换衣服的地方。
    <br><br>
    <<if _sydneyWorking>>
      悉尼正为下一班值勤的人整理衣物。<<He>>放下叠好的修道袍，在柜子旁给你腾出位置。
    <<elseif _festivalNight>>
      万圣节的灯笼放在书旁，里面的蜡烛终于熄了。悉尼在床尾铺好一条备用的毯子。
    <<elseif $sydney_templeWork is 'sleep'>>
      其他住客都已睡下。悉尼听见脚步声，掀起毯子一角，让你坐下，又不至于吵醒别人。
    <<else>>
      悉尼放下叠到一半的修道袍，把书挪开，给你腾出位置。
    <</if>>
    <br><br>
    <<if _sydneyWorking>>
      悉尼指了指还没叠好的修道袍。“可以搭把手吗？”<<he>>问，在衣柜旁给你腾出位置。
    <<elseif _sydneyStatus.includes('corrupt')>>
      悉尼挪开一本书。“你找到我了。”<<he>>瞥了眼旁边的床铺，轻声说。
    <<elseif _sydneyStatus.includes('pure')>>
      悉尼理平身旁的毯子。“<span class='teal'>你能来真好。</span>”<<he>>轻声说。
    <<else>>
      悉尼把一本书挪开。“正好有人陪我说说话。”<<he>>说。
    <</if>>
    <<if $exposed gte 1>>
      <br><br>
      悉尼注意到你露在外面的皮肤。
      <<if _sydneyStatus.includes('corrupt')>>
        <span class="lewd"><<He>>故意多看了一会儿</span>，直到被你发现，才笑着移开眼。
      <<else>>
        <<He>>移开目光，耳尖却悄悄红了。
      <</if>>
    <</if>>
<</language>>

<br><br>
<<if _festivalNight and $SydneyExpansion.halloweenTalkYear isnot Time.year>>
  <<socialiseicon>><<lanLink ['Talk with Sydney about tonight (0:10)', '和悉尼谈谈今晚 (0:10)'] 'Deadwood Reblooms Sydney Dorm Halloween'>><<pass 10>><</lanLink>><br>
<</if>>
<<if (Time.month is 12 and Time.monthDay is 25 and $SydneyExpansion.christmasYear is Time.year or _christmasRest) and $SydneyExpansion.christmasTalkYear isnot Time.year>>
  <<gifticon 'christmas'>><<lanLink ['Exchange Christmas gifts with Sydney (0:10)', '与悉尼私下交换圣诞礼物 (0:10)'] 'Deadwood Reblooms Sydney Dorm Christmas'>><<pass 10>><</lanLink>><br>
<</if>>
<<if _sydneyResting>>
  <<schoolicon 'library'>><<lanLink ['Read with Sydney (0:10)', '和悉尼一起读书 (0:10)'] 'Deadwood Reblooms Sydney Dorm Reading'>><<pass 10>><</lanLink>><br>
<</if>>
<!-- 与原版悉尼的转化互动共用每日次数，床铺旁另有一次安静的相处机会。 -->
<<if _sydneyResting and C.npc.Sydney.love gte 10 and !($daily.sydney.tf gte 3) and $SydneyExpansion.touchDay isnot Time.days>>
  <<set _tf to checkTFparts()>>
  <<set _touchPart to ''>>
  <<set _touchLabel to ''>>
  <<if $fox gte 6 and _tf.foxTail>>
    <<set _touchPart to 'fox'>><<set _touchLabel to '让悉尼枕着你的尾巴 (0:10)'>>
  <<elseif $wolfgirl gte 6 and _tf.wolfEars>>
    <<set _touchPart to 'wolf'>><<set _touchLabel to '让悉尼摸摸你的耳朵 (0:10)'>>
  <<elseif $cat gte 6 and _tf.catEars>>
    <<set _touchPart to 'cat'>><<set _touchLabel to '让悉尼挠挠你的耳朵 (0:10)'>>
  <<elseif $harpy gte 6 and _tf.birdWings>>
    <<set _touchPart to 'bird'>><<set _touchLabel to '请悉尼帮你整理羽毛 (0:10)'>>
  <<elseif $cow gte 6 and _tf.cowEars and _tf.cowHorns>>
    <<set _touchPart to 'cow'>><<set _touchLabel to '请悉尼抚摸你的头 (0:10)'>>
  <<elseif $maplebirch?.transformation?.horse?.level gte 6 and _tf.horseEars>>
    <<set _touchPart to 'horse'>><<set _touchLabel to '让悉尼摸摸你的马耳 (0:10)'>>
  <<elseif $maplebirch?.transformation?.whale?.level gte 6 and _tf.whaleFins>>
    <<set _touchPart to 'whale'>><<set _touchLabel to '让悉尼抚摸你的耳鳍 (0:10)'>>
  <</if>>
  <<if _touchPart>>
    <<loveicon>>
    <<lanLink _touchLabel 'Deadwood Reblooms Sydney Dorm Transformation'>>
      <<set $SydneyExpansion.touchPart to _touchPart>>
      <<set $SydneyExpansion.touchDay to Time.days>>
      <<set $daily.sydney.tf to ($daily.sydney.tf || 0) + 1>>
      <<pass 10>><<npcincr Sydney love 2>>
      <<if _sydneyStatus.includes('corrupt')>>
        <<npcincr Sydney lust 1>><<npcincr Sydney purity -1>>
      <<elseif _sydneyStatus.includes('pure')>>
        <<npcincr Sydney purity 1>>
      <</if>>
    <</lanLink>><<glove>><br>
  <</if>>
<</if>>
<<if _sydneyWorking>>
  <<wardrobeicon>><<lanLink ['Help Sydney sort the wardrobe (0:10)', '帮悉尼整理衣柜 (0:10)'] 'Deadwood Reblooms Sydney Dorm Wardrobe'>><<pass 10>><</lanLink>><br>
<</if>>
<<if _shareSydneyBed>>
  <<deadwood-reblooms-sydney-dorm-bed-links>>
<</if>>
<<if _festivalNight>>
  <br>
  <<lanLink '陪悉尼守夜到早晨' 'Deadwood Reblooms Sydney Halloween Morning'>><<pass _minutesUntilSirris>><</lanLink>><br>
<<elseif _sirrisMorning>>
  <br>
  <<lanLink '和悉尼去见西里斯' 'Deadwood Reblooms Sydney Halloween Morning'>><</lanLink>><br>
<</if>>
<br>
<<getouticon>><<lanLink '返回宿舍' 'Temple Quarters'>><</lanLink>>
<</if>>

:: Deadwood Reblooms Sydney Dorm Transformation []
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>>
<<npc Sydney>><<person1>><<run statusCheck('Sydney')>>
<<language>>
  <<option 'EN'>>
    <<switch $SydneyExpansion.touchPart>>
      <<case 'fox'>>
        You settle beside Sydney's bunk and lay your tail across the blanket. <<He>> hesitates, then rests <<his>> head against it. <<His>> fingers comb gently through the fur while the other residents murmur in their sleep.
        <br><br>
        "It's warmer than my pillow," <<he>> says, reluctant to lift <<his>> head.
      <<case 'wolf'>>
        You lean into Sydney as <<he>> sits at the edge of the bunk. <<He>> runs <<his>> fingers behind your wolf ears, slowly enough for you to guide <<his>> hand when <<he>> finds a tender spot.
        <br><br>
        "There?" <<he>> asks. You press closer instead of answering.
      <<case 'cat'>>
        Sydney makes a little room on the blanket. When you curl up beside <<him>>, <<he>> scratches behind your cat ears. The book in <<his>> other hand soon slips shut.
        <br><br>
        "I think you like this more than the story," <<he>> whispers.
      <<case 'bird'>>
        A feather has come loose from your wing. Sydney asks before touching it, then carefully smooths the others back into place. <<He>> keeps one hand beneath your wing until you fold it comfortably.
        <br><br>
        "There. It shouldn't catch on the blanket now," <<he>> says.
      <<case 'cow'>>
        You lower your head toward Sydney. <<He>> strokes between your horns, avoiding their tips, and traces a finger along one soft ear. The careful touch makes you lean against <<his>> shoulder.
        <br><br>
        Sydney laughs under <<his>> breath. "I suppose that means I found the right place."
      <<case 'horse'>>
        Sydney notices one of your horse ears twitch when <<he>> opens a book. You lean closer, and <<he>> rubs the soft fur behind it with two fingers.
        <br><br>
        "You heard the pages turn, didn't you?" <<he>> says. The ear flicks beneath <<his>> hand again.
      <<case 'whale'>>
        A fold of the blanket catches against the fin beside your ear. Sydney frees it before running a careful fingertip along the fin's edge.
        <br><br>
        "Tell me if that tickles," <<he>> says, keeping the blanket well clear this time.
    <</switch>>
    <br><br>
    <<if _sydneyStatus.includes('pure')>>
      Sydney draws the blanket over you both. "We should keep our voices down," <<he>> says, but <<he>> does not move away.
    <<elseif _sydneyStatus.includes('corrupt')>>
      Sydney catches your hand before you can pull back. "Stay a little longer," <<he>> murmurs, <span class="lewd">drawing you close under the blanket</span>.
    <<else>>
      Sydney moves <<his>> book aside to make room for you. For a while, neither of you feels the need to speak.
    <</if>>
  <<option 'CN'>>
    <<switch $SydneyExpansion.touchPart>>
      <<case 'fox'>>
        你挨着悉尼的床铺坐下，把尾巴铺在毯子上。<<He>>迟疑了一下，才枕上去。其他住客还在睡梦中低声呢喃，<<his>>的手指轻轻梳过尾巴上的绒毛。
        <br><br>
        “比我的枕头还暖和。”<<he>>说，舍不得抬头。
      <<case 'wolf'>>
        悉尼坐在床边，你靠过去。<<He>>把手指伸到你的狼耳后面，慢慢抚摸。摸到一处发痒的地方时，你牵着<<his>>的手，让<<he>>再多摸一会儿。
        <br><br>
        “这里？”<<he>>问。你没有回答，只是靠得更近了。
      <<case 'cat'>>
        悉尼在毯子上给你腾出位置。你蜷在<<him>>身旁，<<he>>便轻轻挠你的猫耳。<<He>>另一只手里的书没过多久就合上了。
        <br><br>
        “看来比起故事，你更喜欢这个。”<<he>>低声说。
      <<case 'bird'>>
        你的翅膀上翘起一根羽毛。悉尼先问过你，才小心地替你理顺，另一只手托着翅膀，直到你能舒服地把它收拢。
        <br><br>
        “好了，这下不会勾到毯子了。”<<he>>说。
      <<case 'cow'>>
        你朝悉尼低下头。<<He>>避开角尖，抚过两角之间，又用手指轻触一只柔软的耳朵。你不由得把头靠在<<his>>肩上。
        <br><br>
        悉尼轻笑一声。“看来我找对地方了。”
      <<case 'horse'>>
        悉尼翻开书，你的一只马耳跟着抖了抖。你凑近些，<<he>>便伸出两根手指，轻揉耳后柔软的绒毛。
        <br><br>
        “听见我翻书了？”<<he>>说。那只耳朵又在<<his>>手下动了一下。
      <<case 'whale'>>
        毯子的褶皱勾住了你耳边的鳍。悉尼替你解开，才小心地沿着耳鳍边缘抚过去。
        <br><br>
        “痒的话要告诉我。”<<he>>说，这次把毯子挪得远远的。
    <</switch>>
    <br><br>
    <<if _sydneyStatus.includes('pure')>>
      悉尼把毯子拉过来，盖在你们身上。“声音小些，别吵醒他们。”<<he>>说，却没有挪开。
    <<elseif _sydneyStatus.includes('corrupt')>>
      你正要退开，悉尼拉住你的手。“再待一会儿。”<<he>>低声说，<span class="lewd">把你拢进毯子里</span>。
    <<else>>
      悉尼把书挪开，给你留出位置。你们安静地挨了一会儿，谁也不急着说话。
    <</if>>
<</language>>
<<glove>>
<<if _sydneyStatus.includes('corrupt')>>
  <<gslust>><<lspurity>>
<<elseif _sydneyStatus.includes('pure')>>
  <<gspurity>>
<</if>>
<br><br>
<<lanLink ["Continue","继续"] 'Deadwood Reblooms Sydney Dorm'>><</lanLink>>

:: Deadwood Reblooms Sydney Dorm Reading []
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>>
<<if _sydneyAvailable is undefined>>
  <<sydneySchedule>>
<</if>>
<<npc Sydney>><<person1>><<run statusCheck('Sydney')>>
<<language>>
  <<option 'EN'>>
    Sydney draws a book from beneath the bunk. A loose paper marker rests between pages describing the temple's older rites and how they changed. You take turns reading aloud, quietly enough not to disturb the other residents.
    <br><br>
    <<if _sydneyStatus.includes('pure')>>
      "I keep coming back to this part," <<he>> says, tapping the margin. "It makes the next day's work feel a little easier."
    <<elseif _sydneyStatus.includes('corrupt')>>
      Sydney closes the book over your hand, gently trapping your fingers. "You weren't looking at the page," <<he>> murmurs. <<He>> caught you <span class="lewd">watching <<him>></span> instead.
    <<else>>
      Sydney points out a line that made <<him>> laugh. You cover your mouth before the other residents can hear you.
    <</if>>
    <br><br>
    <<if currentSkillValue('history') gte 400>>
      You recognise a note in the margin explaining why the rite changed. Sydney shifts close enough to read over your shoulder and asks you to tell <<him>> more.
    <<else>>
      A faded note in the margin stops you both. Sydney turns the page back so you can read it again together.
    <</if>>
  <<option 'CN'>>
    悉尼从床下抽出一本书。一张纸条夹在记载神殿旧时仪式及其变迁的章节里。你们轮流念出其中几段，声音压得很低，以免打扰其他住客。
    <br><br>
    <<if _sydneyStatus.includes('pure')>>
      “我总会翻回这一页。”<<he>>点点书边，“读完这段，明天的差事似乎也没那么难了。”
    <<elseif _sydneyStatus.includes('corrupt')>>
      悉尼忽然合上书，轻轻压住你还没收回的手。“你根本没在看书。”<<he>>低声说。原来<<he>>早就发现你一直在<span class="lewd">看<<him>></span>。
    <<else>>
      悉尼指给你看一句让<<him>>发笑的话。你赶紧捂住嘴，免得被其他住客听见。
    <</if>>
    <br><br>
    <<if currentSkillValue('history') gte 400>>
      你认出页边一条说明仪式为何改变的注释。<<He>>挨过来，越过你的肩膀看书，又央你多讲几句。
    <<else>>
      页边一行褪色的注释难住了你们。悉尼把书翻回去，陪你又读了一遍。
    <</if>>
<</language>>
<!-- 共读每天只提供一次历史技能收益，反复进入仍可看剧情。 -->
<<if $SydneyExpansion.readDay isnot Time.days>>
  <<set $SydneyExpansion.readDay to Time.days>>
  <<ghistory>><<historyskill 2>>
<</if>>
<br><br>
<<if _sydneyResting and $SydneyExpansion.talkDay isnot Time.days>>
  <<socialiseicon>><<lanLink ['Ask Sydney about the day (0:10)', '问悉尼今天过得如何 (0:10)'] 'Deadwood Reblooms Sydney Dorm Conversation'>><<pass 10>><</lanLink>><br>
<</if>>
<<if _shareSydneyBed>>
  <<deadwood-reblooms-sydney-dorm-bed-links>>
<</if>>
<<if (_sydneyResting and $SydneyExpansion.talkDay isnot Time.days) or _shareSydneyBed>>
  <br>
<</if>>
<<lanLink ["Continue","继续"] 'Deadwood Reblooms Sydney Dorm'>><</lanLink>>

:: Deadwood Reblooms Sydney Dorm Conversation []
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>>
<<if _sydneyAvailable is undefined>>
  <<sydneySchedule>>
<</if>>
<<npc Sydney>><<person1>><<run statusCheck('Sydney')>>
<<set $SydneyExpansion.talkDay to Time.days>>
<<language>>
  <<option 'EN'>>
    You close the book and ask Sydney how the day has treated <<him>>. <<He>> glances toward the robes prepared for tomorrow's shift before answering.
    <br><br>
    <<if _sydneyStatus.includes('pure')>>
      "I wanted to stay here because I thought I could help people," <<he>> says. "Some days I spend so long worrying about doing everything properly that I forget to ask how they are."
    <<elseif _sydneyStatus.includes('corrupt')>>
      Sydney runs a thumb along the edge of the closed book. "I still want to be here," <<he>> says. "That doesn't mean I agree with every rule they make for us." <<He>> looks to you to see whether that surprises you.
    <<else>>
      "They let me through the vigil in the end, but only because you were holding on to me," <<he>> admits. "I still feel like someone might tell me I got here by mistake."
    <</if>>
    <br><br>
    The distant bells mark the next shift. Sydney stays beside you instead of reaching for the book again.
  <<option 'CN'>>
    你合上书，问悉尼今天过得怎么样。<<He>>先看了看为明天轮班准备的修道袍，才开口回答。
    <br><br>
    <<if _sydneyStatus.includes('pure')>>
      “我想留在这里，是因为我觉得自己能帮到别人。”<<he>>说，“有些日子，我光顾着担心有没有把每条规矩做好，都忘了问他们过得好不好。”
    <<elseif _sydneyStatus.includes('corrupt')>>
      悉尼用拇指摩挲着合上的书页。“我还是想待在这里。”<<he>>说，“这不代表我认同他们给我们定下的每一条规矩。”<<He>>看向你，似乎想知道你会不会意外。
    <<else>>
      “守夜最后还是让我过了——只因为有你拉着我。”<<he>>承认道，“可我总觉得，有人会说我来错了地方。”
    <</if>>
    <br><br>
    远处的钟声提醒人们该换班了。悉尼却仍坐在你身旁，没有再去拿那本书。
<</language>>
<br><br>
<<if _sydneyResting>>
  <<socialiseicon>><<lanLink ['Reassure Sydney (0:05)', '安慰悉尼 (0:05)'] 'Deadwood Reblooms Sydney Dorm Reassure'>><<pass 5>><</lanLink>><br>
  <<if !pcAreArmsBound('both')>>
    <<loveicon>><<lanLink "牵住悉尼的手 (0:05)" 'Deadwood Reblooms Sydney Dorm Hand'>><<pass 5>><</lanLink>><<handholdingvirginitywarning>><<NPCvirginitywarning 'Sydney' 'handholding'>><br>
  <</if>>
  <br>
<</if>>
<<lanLink ["Continue","继续"] 'Deadwood Reblooms Sydney Dorm'>><</lanLink>>

:: Deadwood Reblooms Sydney Dorm Reassure []
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>>
<<if _sydneyAvailable is undefined>>
  <<sydneySchedule>>
<</if>>
<<npc Sydney>><<person1>><<run statusCheck('Sydney')>>
<<if _dormAccess and _sydneyResting and maplebirch.get('Sydney').available>>
  <<language>>
    <<option 'EN'>>
      You remind Sydney of the people <<he>> helped today. <<He>> listens without interrupting, then nods as though <<he>> has been trying to remember the same things.
      <br><br>
      <<if _sydneyStatus.includes('pure')>>
        "I'll ask how they're doing tomorrow," <<he>> says. "Thank you for reminding me why I came here."
      <<elseif _sydneyStatus.includes('corrupt')>>
        "I don't have to agree with them to keep caring about people," <<he>> says. "I'm glad you understand that."
      <<else>>
        Sydney breathes out. "Perhaps I don't have to feel certain every minute," <<he>> says. "It's enough to come back and try."
      <</if>>
    <<option 'CN'>>
      你提醒悉尼，今天有多少人得到过<<his>>的帮助。<<He>>静静听完，点了点头，仿佛自己也一直在努力记住这些事。
      <br><br>
      <<if _sydneyStatus.includes('pure')>>
        “明天我会问问他们过得怎么样。”<<he>>说，“谢谢你提醒我，自己为什么来到这里。”
      <<elseif _sydneyStatus.includes('corrupt')>>
        “就算不认同他们，我也还是能关心别人。”<<he>>说，“你明白这一点，我很高兴。”
      <<else>>
        悉尼缓缓呼出一口气。“也许我不需要时时刻刻都有把握。”<<he>>说，“明天继续试就够了。”
      <</if>>
  <</language>>
  <<npcincr Sydney love 1>><<glove>><<stress -3>><<lstress>>
<<else>>
  <<lanSwitch 'Sydney is not by the bunks now. You can ask another time.' '悉尼现在不在床铺旁。你可以改天再问。'>>
<</if>>
<br><br>
<<if _shareSydneyBed>>
  <<deadwood-reblooms-sydney-dorm-bed-links>>
  <br>
<</if>>
<<lanLink ["Continue","继续"] 'Deadwood Reblooms Sydney Dorm'>><</lanLink>>

:: Deadwood Reblooms Sydney Dorm Hand []
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>>
<<if _sydneyAvailable is undefined>>
  <<sydneySchedule>>
<</if>>
<<npc Sydney>><<person1>><<run statusCheck('Sydney')>>
<<if _dormAccess and _sydneyResting and maplebirch.get('Sydney').available and !pcAreArmsBound('both')>>
  <<language>>
    <<option 'EN'>>
      You take Sydney's hand. <<He>> falls quiet and turns <<his>> palm against yours, holding on as the bells finish ringing.
      <br><br>
      <<if _sydneyStatus.includes('pure')>>
        "You make it easier to stay," <<he>> says, looking at your joined hands.
      <<elseif _sydneyStatus.includes('corrupt')>>
        "I'd rather have you here than an answer to every question," <<he>> says, moving closer.
      <<else>>
        Sydney gives your hand a small squeeze. "I think I'll be all right tomorrow."
      <</if>>
    <<option 'CN'>>
      你牵起悉尼的手。<<He>>安静下来，翻过手掌回握住你。钟声停了，<<he>>也没有松开。
      <br><br>
      <<if _sydneyStatus.includes('pure')>>
        “有你在，我更愿意留下。”<<he>>望着你们相握的手说。
      <<elseif _sydneyStatus.includes('corrupt')>>
        “比起找到所有问题的答案，我更想让你陪在这里。”<<he>>靠近了些。
      <<else>>
        悉尼轻轻捏了捏你的手。“我想明天会没事的。”
      <</if>>
  <</language>>
  <<takeHandholdingVirginity 'Sydney' 'romantic'>>
  <<npcincr Sydney love 1>><<glove>><<npcincr Sydney lust 2>><<glust>>
<<else>>
  <<lanSwitch "You can't hold Sydney's hand here now." '你现在没法在这里牵住悉尼的手。'>>
<</if>>
<br><br>
<<if _shareSydneyBed>>
  <<deadwood-reblooms-sydney-dorm-bed-links>>
  <br>
<</if>>
<<lanLink ["Continue","继续"] 'Deadwood Reblooms Sydney Dorm'>><</lanLink>>

:: Deadwood Reblooms Sydney Dorm Wardrobe []
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>>
<<if _sydneyAvailable is undefined>>
  <<sydneySchedule>>
<</if>>
<<npc Sydney>><<person1>><<run statusCheck('Sydney')>>
<<language>>
  <<option 'EN'>>
    Sydney has taken the clean robes from the laundry basket, but the shelves beside <<his>> bunk are already crowded with books. You hold the hangers while <<he>> decides which clothes will be needed for the next shift.
    <br><br>
    <<if _sydneyStatus.includes('pure')>>
      "Jordan always knows when I've forgotten to mend a sleeve," <<he>> says, showing you a loose seam. <<He>> looks pleased when you offer to help.
    <<elseif _sydneyStatus.includes('corrupt')>>
      Sydney holds a robe against you and <span class="lewd">smooths it over your waist</span> before lowering it. "It suits you. Though I don't think I asked you here to talk about clothes."
    <<else>>
      Sydney finds a ribbon tucked inside one of the books. "I thought I'd lost that," <<he>> says, and leaves it beside you for safekeeping.
    <</if>>
    <br><br>
    The other residents are occupied with evening duties. For now, the room is quiet enough to hear one another without whispering.
  <<option 'CN'>>
    悉尼把洗好的修道袍从篮子里取出，床边的架子却已经被书占满。你帮<<him>>拿着衣架，等<<he>>挑出下次轮班要穿的衣服。
    <br><br>
    <<if _sydneyStatus.includes('pure')>>
      “我每次忘了缝衣袖，约旦都会发现。”<<he>>指给你看一处松开的针脚。见你愿意帮忙，<<he>>露出笑容。
    <<elseif _sydneyStatus.includes('corrupt')>>
      悉尼把一件修道袍贴在你身前，<span class="lewd">顺着你的腰抚平衣料</span>，才笑着放下。“很适合你。不过，我叫你来好像不是为了谈衣服。”
    <<else>>
      悉尼从书里翻出一根缎带。“原来在这里。”<<he>>说，把它放在你身边，托你保管一会儿。
    <</if>>
    <br><br>
    其他住客都在忙晚间的差事。宿舍暂时很安静，你们不用压低声音也能听清彼此。
<</language>>
<br><br>
<<if _sydneyWorking>>
  <<wardrobeicon>><<lanLink ['Fold the robes with Sydney (0:10)', '和悉尼叠好衣服 (0:10)'] 'Deadwood Reblooms Sydney Dorm Wardrobe Finish'>><<pass 10>><</lanLink>><br>
<</if>>
<<if _sydneyWorking and $sydneyromance is 1>>
  <<loveicon>><<lanLink ['Stay with Sydney (0:05)', '留在悉尼身边 (0:05)'] 'Deadwood Reblooms Sydney Dorm Screen'>><<pass 5>><</lanLink>><br>
<</if>>
<br>
<<lanLink ["Stop here","到此为止"] 'Deadwood Reblooms Sydney Dorm'>><</lanLink>>

:: Deadwood Reblooms Sydney Dorm Wardrobe Finish []
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>>
<<npc Sydney>><<person1>><<run statusCheck('Sydney')>>
<<language>>
  <<option 'EN'>>
    You make room for the robes without disturbing Sydney's books. <<He>> folds the last one with you and checks the repaired sleeve against the light.
    <br><br>
    <<if _sydneyStatus.includes('pure')>>
      "That's better," <<he>> says. "Now I can face Jordan tomorrow."
    <<elseif _sydneyStatus.includes('corrupt')>>
      Sydney sets the robe aside and brushes your shoulder. "You can come and help me again. I might even leave something untidy for you."
    <<else>>
      "I'd have been here twice as long on my own," <<he>> says, keeping the recovered ribbon in the book you chose together.
    <</if>>
  <<option 'CN'>>
    你们没有碰乱悉尼的书，就给修道袍腾出了位置。<<He>>和你一起叠好最后一件，又对着灯光检查了缝好的袖口。
    <br><br>
    <<if _sydneyStatus.includes('pure')>>
      “这下好多了。”<<he>>说，“明天也不怕约旦看见了。”
    <<elseif _sydneyStatus.includes('corrupt')>>
      悉尼放下衣服，轻碰你的肩膀。“下次也来帮我吧。我或许会特意留点东西不收拾。”
    <<else>>
      “没有你，我得忙上两倍的时间。”<<he>>说，把找回的缎带夹进你们一起选好的书里。
    <</if>>
<</language>>
<<if $SydneyExpansion.wardrobeDay isnot Time.days>>
  <<set $SydneyExpansion.wardrobeDay to Time.days>>
  <<npcincr Sydney love 1>><<glove>><<stress -2>><<lstress>>
<</if>>
<br><br>
<<lanLink ["Continue","继续"] 'Deadwood Reblooms Sydney Dorm'>><</lanLink>>

:: Deadwood Reblooms Sydney Dorm Screen []
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>>
<<npc Sydney>><<person1>><<run statusCheck('Sydney')>>
<<language>>
  <<option 'EN'>>
    Sydney puts the hangers away. As <<he>> steps behind the changing screen, <<he>> stops and turns back to you. "Would you stay?" <<he>> asks. "We have a little time before the others return."
    <br><br>
    <<if _sydneyStatus.includes('pure')>>
      <<He>> waits with one hand on the screen. "Only if you want to," <<he>> adds, voice unsteady.
    <<elseif _sydneyStatus.includes('corrupt')>>
      Sydney gestures toward the unfinished stack of books. "I wanted to show you what I found."
    <<else>>
      "I wanted a little time to talk after all that work," <<he>> admits.
    <</if>>
  <<option 'CN'>>
    悉尼放好衣架，走到换衣用的屏风后，却又停下来回头看你。“再留一会儿，好吗？”<<he>>问，“其他人回来前，我们还有一点时间。”
    <br><br>
    <<if _sydneyStatus.includes('pure')>>
      <<He>>一手扶着屏风，声音不太稳。“当然，你愿意才行。”<<he>>补充道。
    <<elseif _sydneyStatus.includes('corrupt')>>
      悉尼指了指尚未收好的几本书。“我还想给你看看我找到的东西。”
    <<else>>
      “忙完以后，我还想和你说会儿话。”<<he>>坦白说。
    <</if>>
<</language>>
<br><br>
<<if hasSexStat('promiscuity', 1)>>
  <<loveicon 'kiss'>><<lanLink '提议与悉尼亲密' 'Deadwood Reblooms Sydney Dorm Intimacy'>><<set $SydneyExpansion.dormScene to 'screen'>><<set $sexstart to 1>><</lanLink>><<promiscuous1>><br>
<</if>>
<br>
<<lanLink ["Stop here","到此为止"] 'Deadwood Reblooms Sydney Dorm'>><</lanLink>>

:: Deadwood Reblooms Sydney Dorm Halloween []
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>>
<<if _sydneyAvailable is undefined>>
  <<sydneySchedule>>
<</if>>
<<npc Sydney>><<person1>><<run statusCheck('Sydney')>>
<<set $SydneyExpansion.halloweenTalkYear to Time.year>>
<<language>>
  <<option 'EN'>>
    Sydney sets the extinguished lantern beside the bunk. The laughter of the last trick-or-treaters has faded outside; down here, only the rustle of blankets answers you.
    <br><br>
    You help put the spare candles back in their box. Sydney leaves one where the morning shift will find it.
    <br><br>
    <<if _sydneyStatus.includes('pure')>>
      "I thought tonight would be frightening," <<he>> admits. "But the lights brought people here when they needed somewhere safe."
    <<elseif _sydneyStatus.includes('corrupt')>>
      Sydney brushes a fleck of wax from your sleeve. "I liked having you to myself after everyone left," <<he>> says, then glances at the occupied beds. "Almost to myself."
    <<else>>
      "I'm glad you stayed until the last candle," <<he>> says. <<He>> shares the sweets left at the bottom of the basket with you.
    <</if>>
  <<option 'CN'>>
    悉尼把熄灭的灯笼放在床边。最后一批讨糖人的笑声也消失在神殿外，宿舍里只听得到翻动被褥的声音。
    <br><br>
    你帮<<him>>把备用蜡烛收回盒里。悉尼留下一支，好让早班的人找得到。
    <br><br>
    <<if _sydneyStatus.includes('pure')>>
      “我本以为今晚会很吓人。”<<he>>承认道，“可是有人需要安全的地方时，灯光把他们带来了这里。”
    <<elseif _sydneyStatus.includes('corrupt')>>
      悉尼拂去你衣袖上的一点蜡。“等人都走了，我喜欢你只陪着我。”<<he>>看看旁边的床铺，“好吧，差不多算只有我们。”
    <<else>>
      “最后一盏蜡烛熄灭前，你都在这里。”<<he>>说着，与你分吃糖篮底下剩的几颗糖。
    <</if>>
<</language>>
<br><br>
<<if _shareSydneyBed>>
  <<deadwood-reblooms-sydney-dorm-bed-links>>
  <br>
<</if>>
<<lanLink ["Continue","继续"] 'Deadwood Reblooms Sydney Dorm'>><</lanLink>>

:: Deadwood Reblooms Sydney Dorm Christmas []
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>>
<<if _sydneyAvailable is undefined>>
  <<sydneySchedule>>
<</if>>
<<npc Sydney>><<person1>><<run statusCheck('Sydney')>>
<<set $SydneyExpansion.christmasTalkYear to Time.year>>
<<language>>
  <<option 'EN'>>
    The last ribbon from the gift parcels lies across Sydney's blanket. <<He>> folds it around the paper card with your name on it.
    <br><br>
    You know how early the temple work starts tomorrow. You put the remaining parcels by the door for the morning shift.
    <br><br>
    <<if _sydneyStatus.includes('pure')>>
      "I wanted you to have something of your own," <<he>> says. Inside the card is a line <<he>> copied from the book beside <<his>> bunk.
    <<elseif _sydneyStatus.includes('corrupt')>>
      Sydney slips the card into your hand and keeps hold of your fingers. "You can read it later," <<he>> whispers. <span class="lewd">"I wrote what I couldn't say in front of Jordan."</span>
    <<else>>
      "I didn't know what to write," Sydney confesses. "Then I thought about how much easier today was with you here."
    <</if>>
  <<option 'CN'>>
    包礼物剩下的最后一截缎带横在悉尼的毯子上。<<He>>把它系在写着你名字的小卡片上。
    <br><br>
    你知道神殿明天一早还有差事，便把剩下的包裹放在门边，方便早班的人来取。
    <br><br>
    <<if _sydneyStatus.includes('pure')>>
      “我想给你留一份只属于你的礼物。”<<he>>说。卡片上抄着<<he>>床边那本书里的一段话。
    <<elseif _sydneyStatus.includes('corrupt')>>
      悉尼把卡片放进你手里，却没有松开你的指尖。“等会儿再看。”<<he>>轻声说，<span class="lewd">“上面写了我刚才不敢在约旦面前讲的话。”</span>
    <<else>>
      “我想了很久该写什么。”悉尼承认道，“然后我想起，有你在，今天轻松多了。”
    <</if>>
<</language>>
<br><br>
<<if _shareSydneyBed>>
  <<deadwood-reblooms-sydney-dorm-bed-links>>
  <br>
<</if>>
<<lanLink ["Continue","继续"] 'Deadwood Reblooms Sydney Dorm'>><</lanLink>>

:: Deadwood Reblooms Sydney Dorm Bed []
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<wearoutfit>>
<<npc Sydney>><<person1>><<run statusCheck('Sydney')>>
<<language>>
  <<option 'EN'>>
    Sydney shifts closer to the wall and leaves you a place beneath the blanket.
    <br><br>
    <<if _sydneyStatus.includes('corruptLust')>>
      <span class="lewd">"Come closer,"</span> <<he>> whispers at your ear. "If you keep turning over, the bunk will give us away."
    <<elseif _sydneyStatus.includes('corrupt')>>
      Sydney shifts to give you more room. "Try to get some rest," <<he>> whispers.
    <<elseif _sydneyStatus.includes('pure')>>
      "You can sleep here," <<he>> says, blushing. "I don't mind."
    <<else>>
      "There's room for both of us," <<he>> says.
    <</if>>
  <<option 'CN'>>
    悉尼往墙边挪了挪，在毯子下给你留出位置。
    <br><br>

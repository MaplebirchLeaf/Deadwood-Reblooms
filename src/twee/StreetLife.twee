:: Deadwood Street Life Widgets [widget]

<!-- 系数与 deadwood-street-weapon 的 _streetAim 公式保持一致，只读原版练枪统计，不另建技能。 -->
<<widget 'deadwood-street-firearm-effectiveness'>>
  <<if maplebirch.get('StreetLife') and ['handheld', 'handheld_left'].some(slot => setup.clothes.handheld[$worn[slot]?.index]?.streetWeapon)>>
    <<set _streetGunFactor to Math.clamp(0.6 + Math.clamp($stat_shoot / 1000, 0, 1) * 0.4 - Math.clamp($pain / 100, 0, 1) * 0.1, 0.6, 1)>>
    <<language>>
      <<option 'EN'>>
        <<set _streetGunDescription to 'Effective damage: ' + Number((_streetGunFactor * 100).toFixed(2)) + '%<br>Shooting practice: ' + $stat_shoot>>
      <<option 'CN'>>
        <<set _streetGunDescription to '有效伤害系数：' + Number((_streetGunFactor * 100).toFixed(2)) + '%<br>射击练习：' + $stat_shoot>>
    <</language>>
    <<if $pain gt 0>>
      <<set _streetGunPainPenalty to Number(((0.6 + Math.clamp($stat_shoot / 1000, 0, 1) * 0.4 - _streetGunFactor) * 100).toFixed(2))>>
      <<if _streetGunPainPenalty gt 0>>
        <<language>>
          <<option 'EN'>>
            <<set _streetGunDescription += '<br><span class="red">Pain: −' + _streetGunPainPenalty + ' percentage points</span>'>>
          <<option 'CN'>>
            <<set _streetGunDescription += '<br><span class="red">疼痛影响：−' + _streetGunPainPenalty + ' 个百分点</span>'>>
        <</language>>
      <</if>>
    <</if>>
    <<characteristic-box `{name: lanSwitch('Firearm effectiveness', '枪械效能'), icon: 'misc/icon/clothes/street-handgun', currentValue: _streetGunFactor * 100, description: _streetGunDescription, color: 'blue', meterColor: 'blue', modifier: 100, modTypes: {good: [], bad: []}}`>>
  <</if>>
<</widget>>

<<widget 'deadwood-street-reputation'>>
  <<set $_streetRep to maplebirch.get('StreetLife').reputation>>
  <<if $_streetRep gte 80>>
    <<set $_streetDescription to lanSwitch('On the town’s streets, you are known for <span class="gold">getting difficult jobs done.</span>', '在镇上的街头，你已经有了<span class="gold">能办成棘手差事的名声。</span>')>>
  <<elseif $_streetRep gte 50>>
    <<set $_streetDescription to lanSwitch('<span class="green">Your name is familiar</span> in conversations around town.', '镇上街头的闲谈里，<span class="green">越来越多人认得你的名字。</span>')>>
  <<elseif $_streetRep gte 20>>
    <<set $_streetDescription to lanSwitch('Word on the street is that <span class="teal">you deliver what you promise.</span>', '你<span class="teal">说到做到的名声</span>，正在镇上的街头传开。')>>
  <<elseif $_streetRep gt 0>>
    <<set $_streetDescription to lanSwitch('<span class="lblue">A few people around town remember you</span> getting a job done.', '镇上<span class="lblue">有几个人记得你</span>替人办成过事。')>>
  <<else>>
    <<set $_streetDescription to lanSwitch('On the town’s streets, <span class="blue">your name means little.</span>', '镇上的街头<span class="blue">还没多少人听过你的名字。</span>')>>
  <</if>>
  <<set $_streetBox to {name: 'Street', cn_name: '街头', icon: 'img/misc/icon/street-life.png', description: $_streetDescription}>>
  <<relation-box-simple $_streetBox>>
<</widget>>

<!-- ReputationModify 在原版警局卡片绘制前运行，只扩充原卡片的说明。 -->
<<widget 'deadwood-street-police-reputation'>>
  <<if _policeBoxConfig and maplebirch.get('StreetLife')>>
    <<set _policeBoxConfig.description += '<br><<deadwood-street-police-reputation-text>>'>>
  <</if>>
<</widget>>

<!-- 罪证与历史仍由原版两段 relation-text 显示，查案记录不抵消犯罪记录。 -->
<<widget 'deadwood-street-police-reputation-text'>>
  <<set _streetPolice to maplebirch.get('StreetLife').bounties>>
  <<if _streetPolice.wanted>>
    <<language>>
      <<option 'EN'>>
        <span class='red'>You cannot take new cases or collect rewards while the police have enough evidence for an arrest.</span>
      <<option 'CN'>>
        <span class='red'>警方已有足够的逮捕证据，你暂时不能接取新案或领取赏金。</span>
    <</language>><br>
  <</if>>
  <<language>>
    <<option 'EN'>>
      <<if _streetPolice.state.cooperating>>
        You have agreed to assist Grant with enquiries.
      <<elseif _streetPolice.state.completed gt 0>>
        You are no longer taking cases from Grant.
      <<elseif C.npc.Grant.init is 1>>
        You have not agreed to assist Grant with enquiries.
      <<else>>
        The station has no record of you assisting with enquiries.
      <</if>>
      <<if _streetPolice.state.completed gt 0>>
        The station has verified <span class='teal'><<= _streetPolice.state.completed>></span> of your completed cases.
      <</if>>
    <<option 'CN'>>
      <<if _streetPolice.state.cooperating>>
        你已同意协助格兰特查案。
      <<elseif _streetPolice.state.completed gt 0>>
        你已停止接取格兰特的案件。
      <<elseif C.npc.Grant.init is 1>>
        你尚未同意协助格兰特查案。
      <<else>>
        警局还没有你协助查案的记录。
      <</if>>
      <<if _streetPolice.state.completed gt 0>>
        警局已核验你完成的<span class='teal'><<= _streetPolice.state.completed>></span>件案件。
      <</if>>
  <</language>>
  <<if $StreetLife.bailey?.resolution is 'reported'>>
    <br>
    <<language>>
      <<option 'EN'>>
        The station has recorded your report about the disputed shipment. <span class='blue'>The information is awaiting verification.</span>
      <<option 'CN'>>
        警局已登记你报告的货物纠纷线索，<span class='blue'>仍待核验。</span>
    <</language>>
  <</if>>
  <<if _streetPolice.state.cooperating or _streetPolice.state.completed gt 0>>
    <br>
    <<language>>
      <<option 'EN'>>
        <<if _streetPolice.trust gte 60>>
          Grant <span @class="_streetPolice.wanted ? 'blue' : 'green'">treats your reports as reliable</span>, while still checking the details.
        <<elseif _streetPolice.trust gte 20>>
          Grant <span @class="_streetPolice.wanted ? 'blue' : 'teal'">recognises your ability</span> to follow a lead through town.
        <<else>>
          Grant <span class='blue'>expects an accurate account</span> before accepting your work.
        <</if>>
      <<option 'CN'>>
        <<if _streetPolice.trust gte 60>>
          格兰特<span @class="_streetPolice.wanted ? 'blue' : 'green'">认为你的报告可靠</span>，仍会逐项核实细节。
        <<elseif _streetPolice.trust gte 20>>
          格兰特<span @class="_streetPolice.wanted ? 'blue' : 'teal'">认可你追查线索的本事</span>。
        <<else>>
          格兰特等着你<span class='blue'>如实说明差事的经过</span>，再核验你的工作。
        <</if>>
    <</language>>
  <</if>>
<</widget>>

<<widget 'deadwood-street-shop-link'>>
  <<if maplebirch.get('StreetLife').available and !($temple_spear_mission gte 1 and !$smuggler_pub_zephyr) and !(C.npc.Wren.love gte 40 and !$smuggler_pub_wren)>>
    <<deadwood-street-cargo-link 'smuggler'>>
    <<icon 'street/weapon-case.png'>><<lanLink ["Look over the weapon seller's stock (0:01)", '看看武器卖家的货 (0:01)'] 'Deadwood Street Weapon Shop'>><<pass 1>><</lanLink>><br>
  <</if>>
<</widget>>

:: Deadwood Street Weapon Shop
<div id='clothingShop-div' class='main-shop-div'>
  <<deadwoodStreetShop-main>>
</div>

:: Deadwood Street Shop Widgets [widget]
<<widget 'deadwoodStreetShop-main'>>
  <<set $location to 'underground'>><<set $outside to 0>><<effects>>
  <<if $tryOn.autoReset isnot false>>
    <<tryOnReset>>
    <!-- 原版试穿快照不含模组副手槽，结账遍历所有服装槽前补齐空记录。 -->
    <<if $worn.handheld_left>>
      <<set $tryOn.ownedStored.handheld_left to clone($worn.handheld_left)>>
      <<set $tryOn.tryingOn.handheld_left to null>>
    <</if>>
  <</if>>
  <<if !maplebirch.get('StreetLife').available>>
    <<clothingReset>><<set $tryOn.autoReset to true>>
    <<lanSwitch 'The seller closes the case before you can browse.' '你还没来得及看货，卖家就合上了箱子。'>><br>
    <<getouticon>><<lanLink ['Return to the pub', '返回酒馆'] 'Smuggler Pub'>><</lanLink>><<exit>>
  <</if>>
  <<set $shopName to 'deadwoodStreet'>><<set _shopCloseOverride to false>>
  <<unset $clothes_choice>><<unset $shopListStartCount>><<set $shopPage to 0>>
  <<language>>
    <<option 'EN'>>
      Behind one of the wooden partitions, a seller lifts a cloth from an open case. The noise of the bar covers the click of its catches. "Prices are on the tags. Keep them covered until you're out of here." The seller leaves enough room for you to look, but keeps the case within reach.
    <<option 'CN'>>
      木板隔间后，卖家掀开敞口箱子上的布。箱扣的轻响淹没在酒馆的喧闹里。“价钱写在签上。出了这里再亮出来。”卖家给你留出看货的位置，箱子始终放在伸手可及的地方。
  <</language>><br><br>
  <<icon 'street/weapon-case.png'>><<lanLink ['Browse handheld equipment', '查看手持物品']>>
    <<replace '#clothingShop-div'>><<HandheldShop>><</replace>>
  <</lanLink>><br>
  <<if $tryOn.value gt 0>>
    <<lanSwitch 'Equipment you are trying: ' '正在试拿的物品：'>><<printmoney $tryOn.value>><br>
    <<refuseicon>><<lanLink ['Return the equipment', '归还试拿物品']>>
      <<clothingReset>><<updatesidebarimg>><<updatesidebardescription>><<updateclothingshop>>
    <</lanLink>><br>
    <<if maplebirch.get('Finance')?.canPay($tryOn.value, 'clothes') ?? $tryOn.value lte $money>>
      <<highicon>><<lanLink ['Buy and keep holding', '购买并继续手持']>>
        <<buyTryOnClothes 'wear'>><<updatesidebarmoney>><<updateclothingshop>>
      <</lanLink>><br>
      <<sendItemsToDropdown>>
      <<wardrobeicon>><<lanLink ['Buy and store in wardrobe', '购买并送入衣柜']>>
        <<buyTryOnClothes 'wardrobe'>><<updatesidebarmoney>><<updatesidebarimg>><<updatesidebardescription>><<updateclothingshop>>
      <</lanLink>><br>
    <</if>>
  <</if>><br>
  <<deadwood-street-ammunition>><br>
  <<getouticon>><<lanLink ['Return to the pub (0:01)', '返回酒馆 (0:01)'] 'Smuggler Pub'>>
    <<clothingReset>><<set $tryOn.autoReset to true>><<shopClothingFilterReset>><<pass 1>>
  <</lanLink>><br>
<</widget>>

<!-- 弹药留在武器店主柜台，原版目录自行布局返回按钮与分类页。money 宏沿用侧栏支付方式。 -->
<<widget 'deadwood-street-ammunition'>>
  <span class='gold bold'><<lanSwitch 'Ammunition' '弹药'>></span><br>
  <<for _streetAmmoId, _streetAmmo range maplebirch.get('StreetLife').ammunition>>
    <<capture _streetAmmoId _streetAmmo>>
      <<icon _streetAmmo.icon>><<= lanSwitch(_streetAmmo.name[0], _streetAmmo.name[1])>> · <<lanSwitch 'In reserve: ' '备用：'>><span class='teal'><<= $StreetLife.ammo[_streetAmmoId]>></span><br>
      <<if maplebirch.get('Finance')?.canPay(_streetAmmo.cost, 'clothes') ?? _streetAmmo.cost lte $money>>
        <<lanLink ['Buy ' + _streetAmmo.count + ' rounds', '购买 ' + _streetAmmo.count + ' 发']>>
          <<if maplebirch.get('StreetLife').available and (maplebirch.get('Finance')?.canPay(_streetAmmo.cost, 'clothes') ?? _streetAmmo.cost lte $money)>>
            <<money `-_streetAmmo.cost` 'clothes'>><<set $StreetLife.ammo[_streetAmmoId] += _streetAmmo.count>><<updatesidebarmoney>><<updateclothingshop>>
          <</if>>
        <</lanLink>>
      <<else>>
        <span class='grey'><<lanSwitch 'Buy ' '购买 '>><<= _streetAmmo.count>><<lanSwitch ' rounds' ' 发'>></span>
      <</if>> · <<printmoney _streetAmmo.cost>><br>
    <</capture>>
  <</for>>
<</widget>>

:: Deadwood Street Weapon Widgets [widget]
<<widget 'deadwood-street-weapon'>>
  <<if !maplebirch.get('StreetLife').canUse(_args[0])>><<exit>><</if>>
  <<set _streetHand to _args[0]>><<set _streetTarget to Number(maplebirch.SugarCube.State.variables[_streetHand + 'target'])>>
  <<set _streetWeapon to setup.clothes.handheld[$worn[_streetHand is 'left' ? 'handheld_left' : 'handheld'].index]>>
  <<switch _streetWeapon.variable>>
    <<case 'street_knife'>>
      <<lanSwitch 'You strike with your small knife.' '你用小刀发动攻击。'>><<defiance 3 _streetTarget>><<attackstat>>
    <<case 'street_crowbar'>>
      <<lanSwitch 'You swing your crowbar at your attacker.' '你抡起撬棍，砸向袭击者。'>><<defiance _streetWeapon.streetMelee _streetTarget>><<attackstat>>
    <<case 'street_machete'>>
      <<lanSwitch 'You slash at your attacker with your machete.' '你挥动砍刀，劈向袭击者。'>><<defiance _streetWeapon.streetMelee _streetTarget>><<attackstat>>
    <<case 'street_stunner'>>
      <<lanSwitch 'You press the stun device against your attacker.' '你把电击器抵向袭击者。'>>
      <<set _thedamage to Math.min(6, $enemyno gte 2 ? $NPCList[_streetTarget].health : $enemyhealth)>>
      <<if $enemyno gte 2>><<npcdamage _streetTarget>><</if>>
      <<set $enemyhealth -= _thedamage>><<set $enemyanger += 5>><<attackstat>>
    <<case 'street_handgun' 'street_shotgun' 'street_smg' 'street_rifle'>>
      <<set _streetFirearm to _streetWeapon.streetWeapon>>
      <<set _streetShots to Math.min(_streetFirearm.shots, $StreetLife.ammo[_streetFirearm.ammo])>>
      <<set $StreetLife.ammo[_streetFirearm.ammo] -= _streetShots>>
      <<language>>
        <<option 'EN'>>
          You fire your <<= _streetWeapon.name>>. <<if _streetShots gt 1>>Shots crack in quick succession, cutting through the struggle.<<else>>The shot cracks through the struggle.<</if>> Your attacker staggers, clutching the wound.
        <<option 'CN'>>
          你用<<= _streetWeapon.cn_name_cap>>开火。<<if _streetShots gt 1>>枪声接连响起，打断了拉扯。<<else>>枪声骤然响起，打断了拉扯。<</if>>袭击者踉跄了一下，捂住伤处。
      <</language>>
      <<set _streetHealthMax to $enemyno gte 2 ? $NPCList[_streetTarget].healthmax : $enemyhealthmax>>
      <!-- 练枪统计达到 1000 时熟练，伤害系数保持 60%–100%，疼痛最多扣 10 个百分点。 -->
      <<set _streetAim to Math.clamp(0.6 + Math.clamp($stat_shoot / 1000, 0, 1) * 0.4 - Math.clamp($pain / 100, 0, 1) * 0.1, 0.6, 1)>>
      <<set _thedamage to Math.min((_streetFirearm.damage + _streetHealthMax * _streetFirearm.damage_percent / 100) * _streetShots * _streetAim, $enemyno gte 2 ? $NPCList[_streetTarget].health : $enemyhealth)>>
      <<if $enemyno gte 2>><<npcdamage _streetTarget>><</if>>
      <<set $enemyhealth -= _thedamage, $enemyanger += 30>><<attackstat>>
      <<set $NPCList[_streetTarget].deadwoodGunshot to true>>
      <<crimeUp _streetFirearm.crime 'assault'>>
  <</switch>><br>
<</widget>>

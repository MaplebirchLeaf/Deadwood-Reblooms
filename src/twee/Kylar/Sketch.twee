:: Deadwood Reblooms Kylar Sketch Widgets [widget]
<!-- 公园原版已有凯拉尔的素描描写，只在原版对话入口补充回应。 -->
<<widget 'deadwood-kylar-sketch-ready'>><<silently>>
  <!-- 与原版 Kylar Park.twee 一致：素描只在 Love 状态下公开，否则凯拉尔会藏起来。 -->
  <<run statusCheck('Kylar')>>
  <<set _kylarSketchReady to !!maplebirch.get('Kylar') and !!$KylarExpansion and C.npc.Kylar.init is 1
    and C.npc.Kylar.state is 'active' and _kylarStatus.includes('Love') and getKylarLocation().area is 'park'
    and $location is 'park' and $outside is 1 and Time.hour * 60 + Time.minute lt 18 * 60 - (_args[0] ? 0 : 10)
    and (_args[0] is 'answer' ? $KylarExpansion.sketch_day is Time.days : $KylarExpansion.sketch_day isnot Time.days)
    and !$nextPassage and !$nextPassageCheck and !$combat and !$possessed and !$eventforced
    and !$replayScene and !$statFreeze and !$frozenValues>>
<</silently>><</widget>>

<<widget 'deadwood-reblooms-kylar-sketch-link'>>
  <<deadwood-kylar-sketch-ready>>
  <<if _kylarSketchReady>>
    <<icon 'kylar/sketchbook.png'>><<lanLink ['Ask what Kylar is drawing (0:10)', '问凯拉尔在画什么 (0:10)'] 'Deadwood Reblooms Kylar Sketch'>><</lanLink>><br>
  <</if>>
<</widget>>

:: Deadwood Reblooms Kylar Sketch
<<set $outside to 1>><<set $location to 'park'>><<effects>><<deadwood-kylar-sketch-ready>>
<<if !_kylarSketchReady>>
  <<lanSwitch 'You cannot stop to look at the drawing now.' '现在没法留下来看画。'>>
<<else>>
  <<pass 10>><<deadwood-kylar-sketch-ready true>>
  <<if $passage isnot 'Deadwood Reblooms Kylar Sketch'>><<exit>><</if>>
  <<if !_kylarSketchReady>>
    <<lanSwitch 'Kylar has to go. You leave the drawing for another time.' '凯拉尔得走了。画留着下次再看。'>><br><br>
    <<getouticon>><<lanLink ['Return to the park', '返回公园'] 'Park'>><</lanLink>><<exit>>
  <</if>>
  <<set $KylarExpansion.sketch_day to Time.days>>
  <<set $phase to 'kylar-sketch-open'>>
  <<npc Kylar>><<person1>>
  <<language>>
    <<option 'EN'>>
      Kylar has been drawing you again.
      <<if $KylarExpansion.sketch_response is 'praise'>>
        <<He>> turns the book just enough for you to see. "I did the path again. The bit you liked." <<His>> thumb covers the edge of a drawing of your face.
      <<elseif $KylarExpansion.sketch_response is 'wait'>>
        <<He>> catches you looking, but leaves the book open this time. "You can look. Just— don't turn the page."
      <<elseif $KylarExpansion.sketch_response is 'leave'>>
        Kylar keeps working on the trees behind your figure. <<if _kylarStatus.includes('Rage')>><<He>> looks up when you shift your feet. "You're staying?"<<else>><<He>> looks up when you ask about the picture. "You want to see it this time?"<</if>> You nod, and <<he>> turns the book towards you.
      <<else>>
        <<He>> notices you looking and shuts the book, then, after a moment, opens it a little way.
      <</if>>
      A few lines show the park path and the place where you stood a moment ago. "It's— it's not finished," <<he>> says.
    <<option 'CN'>>
      凯拉尔又在画你了。
      <<if $KylarExpansion.sketch_response is 'praise'>>
        <<He>>把本子转过一点，让你看见。“我又画了那条小路。你上次说喜欢的地方。”<<His>>拇指盖住了画中你的半张脸。
      <<elseif $KylarExpansion.sketch_response is 'wait'>>
        <<He>>发现你在看，这次却没合上本子。“可以看。只是、只是别翻页。”
      <<elseif $KylarExpansion.sketch_response is 'leave'>>
        凯拉尔还在画你身后的树。<<if _kylarStatus.includes('Rage')>>你挪了挪脚，<<he>>便抬起头。“你会留下吧？”<<else>>听见你问起画，<<he>>才抬起头。“这次想看吗？”<</if>>你点点头，<<he>>才把本子转向你。
      <<else>>
        <<He>>发现你在看，立刻合上本子，过了一会儿才又稍稍打开。
      <</if>>
      纸上勾出公园的小路，还有你刚才站过的位置。“还没、还没画完。”<<he>>说。
  <</language>><br><br>
  <<socialiseicon>><<lanLink ['Wait for Kylar to show you', '等凯拉尔自己展示'] 'Deadwood Reblooms Kylar Sketch Answer'>>
    <<if $passage is 'Deadwood Reblooms Kylar Sketch' and $phase is 'kylar-sketch-open'>><<set $phase to 'kylar-sketch-wait'>><</if>>
  <</lanLink>><br>
  <<loveicon>><<lanLink ["Praise Kylar's drawing of the path", '称赞凯拉尔画的小路'] 'Deadwood Reblooms Kylar Sketch Answer'>>
    <<if $passage is 'Deadwood Reblooms Kylar Sketch' and $phase is 'kylar-sketch-open'>><<set $phase to 'kylar-sketch-praise'>><</if>>
  <</lanLink>><br>
  <<socialiseicon>><<lanLink ['Do not press further', '不再追问'] 'Deadwood Reblooms Kylar Sketch Answer'>>
    <<if $passage is 'Deadwood Reblooms Kylar Sketch' and $phase is 'kylar-sketch-open'>><<set $phase to 'kylar-sketch-leave'>><</if>>
  <</lanLink>>
<</if>>
<br><br><<getouticon>><<lanLink ['Return to the park', '返回公园'] 'Park'>><</lanLink>>

:: Deadwood Reblooms Kylar Sketch Answer
<<set $_sketchChoice to ['kylar-sketch-wait', 'kylar-sketch-praise', 'kylar-sketch-leave'].includes($phase) ? $phase : null>>
<<if $_sketchChoice>><<unset $phase>><</if>>
<<set $outside to 1>><<set $location to 'park'>><<effects>>
<<deadwood-kylar-sketch-ready 'answer'>>
<<if !$_sketchChoice or !_kylarSketchReady>>
  <span class='blue'><i><<lanSwitch 'There is nothing more to do here.' '这里已经没有别的事可做。'>></i></span>
<<else>>
  <<npc Kylar>><<person1>>
  <<if $_sketchChoice is 'kylar-sketch-wait'>>
    <<lanSwitch 'You keep your hands to yourself. After a while Kylar opens the book again and points out a detail <<he>> likes. <<He>> keeps hold of the page while you look.' '你没有去碰素描本。过了一会儿，凯拉尔重新翻开它，指给你看<<he>>喜欢的一处细节。你看的时候，<<he>>始终自己拿着画纸。'>>
    <<npcincr Kylar love 1>><<glove>>
    <<set $KylarExpansion.sketch_response to 'wait'>>
  <<elseif $_sketchChoice is 'kylar-sketch-praise'>>
    <<lanSwitch 'You tell Kylar the winding path looks just like the one beneath your feet. <<He>> looks from the page to the path, then quickly adds another line. "You noticed, <<kylar_pet_name>>," <<he>> says softly.' '你说纸上弯曲的小路和脚下这条一模一样。凯拉尔在画纸与小路之间看了看，飞快地补上一笔。“你注意到了，<<kylar_pet_name>>。”<<he>>轻声说。'>>
    <<npcincr Kylar love 1>><<glove>>
    <<set $KylarExpansion.sketch_response to 'praise'>>
  <<else>>
    <<lanSwitch 'You leave the sketchbook closed and change the subject. Kylar loosens <<his>> grip on the cover.' '你没有要求看画，转而聊起别的事。凯拉尔按着封面的手渐渐放松了。'>>
    <<set $KylarExpansion.sketch_response to 'leave'>>
  <</if>>
<</if>>
<br><br><<getouticon>><<lanLink ['Return to the park', '返回公园'] 'Park'>><</lanLink>>

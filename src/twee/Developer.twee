:: Deadwood Reblooms Developer Widgets [widget]

<!-- 场景回放准备：为历史课题场景建立完整的最小状态，原版 Scene Viewer 会在退出时还原存档。 -->
<<widget 'deadwood-reblooms-history-replay-state'>>
  <<set $VanillaPlus.historyProject to {
    status: 'ongoing',
    source: 'paintingward',
    availableDay: 0,
    deadline: Time.days + 25,
    assistant: _args[0] is true,
    kylar: 'help',
    kylarStreet: true,
    kylarPrepared: true,
    archive: 30,
    museum: 30,
    recovery: 'recorded',
    ruin: 2,
    draft: 25,
    final: 0
  }>>
  <<set $phase to 0>>
<</widget>>

<!-- 场景回放配置：setupReplayScene 先冻结存档，再由此处补齐场景所需状态；离开回放时原版会统一还原。 -->
<<widget 'deadwood-reblooms-replay-state'>>
  <<switch _args[0]>>
    <<case 'sydney'>>
      <<if !Array.isArray($sydneySeen)>><<set $sydneySeen to []>><</if>>
      <<if !$sydney>><<set $sydney to {}>><</if>>
      <<set $sydney.sexTotal to Number($sydney.sexTotal) || 0>>
      <<if !$daily.sydney>><<set $daily.sydney to {}>><</if>>
      <<set $daily.sydney.sex to Number($daily.sydney.sex) || 0>>
    <<case 'sydney-science'>>
      <<set $sydneyScience to 0>>
      <<set $phase to 2>>
    <<case 'virginity-restoration'>>
      <<set $money to Math.max(100000, Number($money) || 0)>>
      <<if $player.vaginaExist>>
        <<set $player.virginity.vaginal to false>>
      <<elseif $player.penisExist>>
        <<set $player.virginity.penile to false>>
      <</if>>
    <<case 'beauty'>>
      <<if !$photo>><<set $photo to {}>><</if>>
      <<set $photo.time to Number($photo.time) || 0>>
      <<run maplebirch.VP.prepare('beauty')>>
      <<set $outside to 1>>
      <<facestrip>>
    <<case 'physique'>>
      <<run maplebirch.VP.prepare('physique')>>
    <<case 'willpower'>>
      <<run maplebirch.VP.prepare('willpower')>>
      <<set $oxygen to Math.max(1000, Number($oxygen) || 0)>>
      <<if !$wraith>><<set $wraith to {}>><</if>>
      <<set $wraith.defeated to Number($wraith.defeated) || 0>>
      <<if !$wraithPrison>><<set $wraithPrison to {}>><</if>>
      <<set $wraithPrison.timer to 0>>
      <<set $wraithPrison.timePassed to 0>>
      <<set $wraithPrison.search to Number($wraithPrison.search) || 0>>
      <<set $wraithPrison.state to 'present'>>
      <<set $wraithPrison.possession to false>>
      <<set $wraithPrison.masturbation to false>>
      <<if !$lakeRuin>><<set $lakeRuin to {}>><</if>>
      <<set $lakeRuin.rune to true>>
    <<case 'exhibitionism'>>
      <<run maplebirch.VP.prepare('exhibitionism')>>
    <<case 'deviancy'>>
      <<set $VanillaPlus.lock.deviancy to false>>
      <<set $VanillaPlus.deviancy.wildsong to true>>
      <<set $VanillaPlus.deviancy.conducted to false>>
      <<set $VanillaPlus.deviancy.conducting to false>>
      <<set $deviancy to Math.max(100, Number($deviancy) || 0)>>
      <<if !$gwylan>><<set $gwylan to {}>><</if>>
      <<set $gwylan.purged to Math.max(20, Number($gwylan.purged) || 0)>>
      <<if !$dateCount>><<set $dateCount to {}>><</if>>
      <<set $dateCount.GwylanSex to Math.max(3, Number($dateCount.GwylanSex) || 0)>>
      <<set $dateCount.GwylanBeast to Math.max(3, Number($dateCount.GwylanBeast) || 0)>>
      <<if !Array.isArray($gwylanSeen)>><<set $gwylanSeen to []>><</if>>
      <<run $gwylanSeen.pushUnique('ritual_sex', 'ritual_beast')>>
    <<case 'promiscuity'>>
      <<run maplebirch.VP.prepare('promiscuity')>>
    <<case 'finance'>>
      <<run maplebirch.VP.finance.openBankAccount()>>
      <<set $VanillaPlus.finance.bank.debitCard to true>>
      <<set $VanillaPlus.finance.bank.baileyKnowsAccount to false>>
  <</switch>>
<</widget>>

<!-- 无独立剧情入口的属性突破：通过原版回放保护展示实际结算文本。 -->
:: Deadwood Reblooms Developer Attribute Breakthrough [nosave]
<<switch $phase>>
  <<case 'physique'>><<deadwood-reblooms-physique-unlock>>
  <<case 'exhibitionism'>><<deadwood-reblooms-exhibitionism-unlock>>
  <<case 'promiscuity'>><<deadwood-reblooms-promiscuity-unlock>>
  <<default>>
    <span class='red'><<lanSwitch 'No attribute test was selected.' '未选择属性测试。'>></span><br><br>
<</switch>>
<<lanLink 'Finish the test' 'Scene Viewer End'>><</lanLink>><br>

:: Deadwood Reblooms Developer Scene Viewer [nosave]
<<if $debug isnot 1>><<exit>><</if>>
<<if !$VanillaPlus>>
  <span class='red'><<lanSwitch 'Vanilla Plus is disabled for this save.' '当前存档未启用原版增强。'>></span><br><br>
  <<lanLink 'Return' 'Scene Viewer'>><</lanLink>>
  <<exit>>
<</if>>


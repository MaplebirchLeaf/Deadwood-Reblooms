  'Deadwood Reblooms Financial Centre Securities Trading',
  'Deadwood Reblooms Bailey Bank Account',
  'Deadwood Reblooms Bailey Bank Account Authorised',
  'Scene Viewer End'
]>>

<div class='settingsGrid'>
  <div class='settingsHeader options'><<lanSwitch 'Deadwood Reblooms scene viewer' '枯木逢春场景查看器'>></div>
  <div class='settingsToggleItemWide'><span class='red'><<lanSwitch
    'Scenes use the original replay protection. Leave through Scene Viewer End so the current save can be restored.'
    '场景使用原版回放保护。请从场景查看器结尾退出，以便还原当前存档。'
  >></span></div>
</div>

<!-- 场景入口按剧情线分类；所有入口都先冻结存档，再补齐最小测试状态。 -->
<div class='settingsGrid'>
  <div class='settingsToggleItemWide'>
  <span class='gold'><<lanSwitch 'History project' '历史课题'>></span><br>
  <<lanLink 'Project acceptance' 'Deadwood Reblooms History Project Begin'>>
    <<setupReplayScene 'Deadwood Reblooms - History project acceptance' 'Deadwood Reblooms History Project Begin' _historyPassages>>
    <<deadwood-reblooms-history-replay-state false>>
  <</lanLink>><br>
  <<lanLink 'Archive research' 'Deadwood Reblooms History Project Archive'>>
    <<setupReplayScene 'Deadwood Reblooms - Archive research' 'Deadwood Reblooms History Project Archive' _historyPassages>>
    <<deadwood-reblooms-history-replay-state false>>
  <</lanLink>><br>
  <<lanLink 'Museum research' 'Deadwood Reblooms History Project Museum'>>
    <<setupReplayScene 'Deadwood Reblooms - Museum research' 'Deadwood Reblooms History Project Museum' _historyPassages>>
    <<deadwood-reblooms-history-replay-state false>>
  <</lanLink>><br>
  <<lanLink 'Lake survey with Robin' 'Deadwood Reblooms History Project Lake Preparation'>>
    <<setupReplayScene 'Deadwood Reblooms - Lake survey with Robin' 'Deadwood Reblooms History Project Lake Preparation' _historyPassages>>
    <<deadwood-reblooms-history-replay-state true>>
  <</lanLink>><br>
  <<lanLink 'Lake survey alone' 'Deadwood Reblooms History Project Lake Preparation'>>
    <<setupReplayScene 'Deadwood Reblooms - Lake survey alone' 'Deadwood Reblooms History Project Lake Preparation' _historyPassages>>
    <<deadwood-reblooms-history-replay-state false>>
  <</lanLink>><br>
  <<lanLink 'Draft the exhibition' 'Deadwood Reblooms History Project Draft'>>
    <<setupReplayScene 'Deadwood Reblooms - Exhibition draft' 'Deadwood Reblooms History Project Draft' _historyPassages>>
    <<deadwood-reblooms-history-replay-state true>>
  <</lanLink>><br>
  <<lanLink 'Present the exhibition' 'Deadwood Reblooms History Project Exhibition'>>
    <<setupReplayScene 'Deadwood Reblooms - Exhibition presentation' 'Deadwood Reblooms History Project Exhibition' _historyPassages>>
    <<deadwood-reblooms-history-replay-state true>>
  <</lanLink>>
  </div>
  <div class='settingsToggleItemWide'>
  <span class='gold'><<lanSwitch 'Attribute breakthroughs' '属性突破'>></span><br>
  <<lanLink 'Willpower breakthrough' 'Deadwood Reblooms Willpower Unlock 1'>>
    <<setupReplayScene 'Deadwood Reblooms - Willpower breakthrough' 'Deadwood Reblooms Willpower Unlock 1' _willpowerPassages>>

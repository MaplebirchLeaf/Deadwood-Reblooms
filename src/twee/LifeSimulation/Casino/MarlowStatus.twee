:: Deadwood Reblooms Casino Marlow Status Widgets [widget]

<<widget 'Marlowrelationshiptext'>>
	<<set $_casino to $LifeSimulation.casino>>
	<<if maplebirch.get('LifeSimulation').casino.barred>>
		<<language>>
			<<option 'EN'>> <span class='red'>refuses to seat you tonight</span> after catching you cheating.
			<<option 'CN'>>抓到你作弊后，<span class='red'>今晚不准你再上牌桌</span>。
		<</language>>
	<<elseif C.npc.Marlow.rage gte 10>>
		<<language>>
			<<option 'EN'>> <span class='purple'>doesn't trust you to deal</span> after what happened at the table.
			<<option 'CN'>>还记着牌桌上的事，<span class='purple'>不放心让你发牌</span>。
		<</language>>
	<<elseif C.npc.Marlow.rage gt 0>>
		<<language>>
			<<option 'EN'>> remains <span class='purple'>wary of your intentions</span> at the table.
			<<option 'CN'>>对你在牌桌上的举动仍<span class='purple'>有所戒备</span>。
		<</language>>
	<<elseif $_casino.work_scenario isnot null>>
		<<language>>
			<<option 'EN'>> <span class='blue'>watches your table</span>, ready to catch a miscount.
			<<option 'CN'>>正<span class='blue'>留意着你的牌桌</span>，以免你点错筹码。
		<</language>>
	<<elseif $_casino.shifts gt 0 and $_casino.last_work_correct is false>>
		<<language>>
			<<option 'EN'>> wants you to <span class='purple'>check the payout</span> before handing over the chips.
			<<option 'CN'>>希望你<span class='purple'>把金额核对清楚</span>，再交出筹码。
		<</language>>
	<<elseif $_casino.trained and $_casino.good_shifts gte 5 and C.npc.Marlow.love gte 20>>
		<<language>>
			<<option 'EN'>> <span class='green'>trusts you</span> to settle a disputed payout.
			<<option 'CN'>><span class='green'>放心让你</span>处理结算争议。
		<</language>>
	<<elseif $_casino.trained and $_casino.good_shifts gte 3>>
		<<language>>
			<<option 'EN'>> knows you can <span class='teal'>count a pot correctly</span>.
			<<option 'CN'>>知道你能<span class='teal'>算清底池的筹码</span>。
		<</language>>
	<<elseif $_casino.shifts gt 0>>
		<<language>>
			<<option 'EN'>> <span class='blue'>checks your payouts</span> while you find your feet.
			<<option 'CN'>>还会<span class='blue'>替你检查结算</span>，让你慢慢熟悉工作。
		<</language>>
	<<elseif $_casino.trained>>
		<<language>>
			<<option 'EN'>> expects you to <span class='blue'>ask before paying</span> a doubtful hand.
			<<option 'CN'>>希望你遇到拿不准的牌局，<span class='blue'>先问清楚</span>再付筹码。
		<</language>>
	<<elseif C.npc.Marlow.love gte 20>>
		<<language>>
			<<option 'EN'>> will pause the shuffle to <span class='teal'>answer your questions</span>.
			<<option 'CN'>>愿意停下洗牌，<span class='teal'>回答你的问题</span>。
		<</language>>
	<<elseif C.npc.Marlow.love gte 10>>
		<<language>>
			<<option 'EN'>> <span class='blue'>recognises you</span> when you approach the table.
			<<option 'CN'>>见你走到牌桌旁，就会<span class='blue'>点头招呼</span>。
		<</language>>
	<<else>>
		<<language>>
			<<option 'EN'>> keeps attention on the cards and chips.
			<<option 'CN'>>把注意力放在牌和筹码上。
		<</language>>
	<</if>>
<</widget>>

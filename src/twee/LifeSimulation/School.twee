:: Deadwood Reblooms Life Simulation School Widgets [widget]

<!-- 礼顿先审成绩，贝利只签监护人许可。原版连续交租次数作为贝利的条件。 -->
<<widget 'deadwood-reblooms-life-simulation-attendance-link'>>
  <<if !$RobinExpansion?.bailey_defeated and !$LifeSimulation.school.attendanceExempt and !$LifeSimulation.school.baileySigned and $LifeSimulation.school.leightonApprovalDay gte 0 and Time.hour gte 7 and Time.hour lte 9>>
    <<icon 'school/exemption.png'>><<lanLink ['Ask Bailey for a class exemption', '请贝利批准免听凭证'] 'Deadwood Reblooms Life Simulation Attendance Approval'>><</lanLink>><br>
  <</if>>
<</widget>>

<!-- 原版 Avery 纸牌路线确认贝利住在倒钩街公寓。反抗成功后只在公寓找他。 -->
<<widget 'deadwood-reblooms-life-simulation-bailey-flat-link'>>
  <<if $RobinExpansion?.bailey_defeated and !$LifeSimulation.school.attendanceExempt and !$LifeSimulation.school.baileySigned and $LifeSimulation.school.leightonApprovalDay gte 0 and $exposed lt 1 and Time.hour gte 7 and Time.hour lt 21>>
    <<dooricon>><<lanLink ["Visit Bailey's flat about a class exemption (0:02)", '去贝利的公寓申请免听凭证 (0:02)'] 'Deadwood Reblooms Life Simulation Attendance Approval'>><<pass 2>><</lanLink>><br><br>
  <</if>>
<</widget>>

<!-- 用实际结算值显示反馈，达到上限时不会虚报收益。 -->
<<widget 'deadwood-reblooms-life-simulation-school-feedback'>>
  <<set _changes to $LifeSimulation.school.feedback>>
  <<if _changes>>
    <<set _names to [lanSwitch('School order', '校内秩序'), lanSwitch('Student standing', '学生声望'), lanSwitch('Staff trust', '教职工信任'), lanSwitch('School corruption', '校内堕落')]>>
    <<for _index, _change range _changes>>
      <<if _change isnot 0>>
        <span @class="(_change > 0) === (_index !== 3) ? 'green' : 'red'"><<print _names[_index]>> <<print _change > 0 ? '+' + _change : _change>></span><br>
      <</if>>
    <</for>>
    <<set $LifeSimulation.school.feedback to null>>
  <</if>>
<</widget>>

<!-- 学校公告栏入口：身份、校园状态与校规集中在同一个面板。 -->
<<widget 'deadwood-reblooms-life-simulation-school-board-link'>>
  <<assignmenticon>><<lanLink ['Check the student affairs noticeboard (0:02)', '查看学生事务公告栏 (0:02)'] 'Deadwood Reblooms Life Simulation School Board'>><<pass 2>><</lanLink>><br>
<</widget>>

<!-- 职位申请与新校规提案都必须当面向礼顿提出。 -->
<<widget 'deadwood-reblooms-life-simulation-school-office-options'>>
  <<if Time.schoolDay and $schoolstate isnot 'early' and $schoolstate isnot 'late' and $pillory.tenant.special.name isnot 'Leighton' and (wearingSchoolOutfit() or Time.hour gte 14)>>
    <<if !$LifeSimulation.school.attendanceExempt and $LifeSimulation.school.leightonApprovalDay lt 0>>
      <<icon 'school/exemption.png'>><<lanLink ['Apply to Leighton for class exemption', '向礼顿申请免听凭证'] 'Deadwood Reblooms Life Simulation Attendance Application'>><</lanLink>><br>
    <</if>>
    <<if $LifeSimulation.school.baileySigned and !$LifeSimulation.school.attendanceExempt>>
      <<icon 'school/exemption.png'>><<lanLink ['Return the signed exemption form', '交回签好的免听申请'] 'Deadwood Reblooms Life Simulation Attendance Filing'>><</lanLink>><br>
    <</if>>
    <<if $LifeSimulation.school.role is 'student'>>
      <<icon 'school/prefect.png'>><<lanLink ['Apply to become a prefect', '申请担任风纪委员'] 'Deadwood Reblooms Life Simulation Prefect Appointment'>><</lanLink>><br>
    <</if>>
    <<if $LifeSimulation.school.role is 'prefect'>>
      <<icon 'school/council.png'>><<lanLink ['Apply to be student council president', '申请担任学生会长'] 'Deadwood Reblooms Life Simulation President Appointment'>><</lanLink>><br>
    <</if>>
    <<if maplebirch.get("LifeSimulation").school.canProposePolicy>>
      <<icon 'school/dress-policy.png'>><<lanLink ['Propose the next dress policy', '提出下一项着装规范'] 'Deadwood Reblooms Life Simulation Dress Proposal'>><</lanLink>><br>
    <</if>>
    <<if $LifeSimulation.school.dress.proposal>>
      <<icon 'school/dress-policy.png'>><<lanLink ['Discuss the dress policy with Leighton', '与礼顿讨论着装规范'] 'Deadwood Reblooms Life Simulation Dress Approval'>><</lanLink>><br>
    <</if>>
    <<if maplebirch.get("LifeSimulation").school.canReviewPolicy>>
      <<icon 'school/dress-policy.png'>><<lanLink ['Review the dress policy with Leighton', '与礼顿复核着装规范'] 'Deadwood Reblooms Life Simulation Dress Review'>><</lanLink>><br>
    <</if>>
  <</if>>
<</widget>>

<!-- 风纪职责每天早晨只执行一次。 -->
<<widget 'deadwood-reblooms-life-simulation-school-duty-link'>>
  <<if maplebirch.get("LifeSimulation").school.canPerformDuty>>
    <<icon 'school/duty.png'>><<lanLink ['Perform morning duty', '执行晨间值勤'] 'Deadwood Reblooms Life Simulation Morning Duty'>><</lanLink>><br>
  <</if>>
<</widget>>

<!-- 仅替代原版中庭通往走廊的入口链接。 -->
<<widget 'deadwood-reblooms-life-simulation-school-entry'>>
  <<if maplebirch.get("LifeSimulation").school.requiresNudity and !$LifeSimulation.school.clothesStored>>
    <<language>>
      <<option 'EN'>>A member of staff points to the rule beside the doors. You must <span class='red'>remove your clothes</span> before entering today.
      <<option 'CN'>>教职工指了指门旁的校规。今天入校前，你<span class='red'>必须脱下衣服</span>。
    <</language>><br><br>
    <<lockericon>><<lanLink ['Obey the rule and enter naked (0:01)', '遵守校规，脱衣入校 (0:01)'] 'Hallways'>>
      <<undress 'lifeSimulationSchool'>>
      <<set $LifeSimulation.school.clothesStored to true>>
      <<pass 1>>
    <</lanLink>>
  <<else>>
    <<entranceicon>><<lanLink ['Enter the school (0:01)', '进入学校 (0:01)'] 'Hallways'>><<pass 1>><</lanLink>>
    <<if maplebirch.get("LifeSimulation").school.allowsNudity and !$LifeSimulation.school.clothesStored>>
      <br>
      <<lockericon>><<lanLink ['Undress before entering school (0:01)', '脱衣入校 (0:01)'] 'Hallways'>>
        <<undress 'lifeSimulationSchool'>>
        <<set $LifeSimulation.school.clothesStored to true>>
        <<pass 1>>
      <</lanLink>>
    <</if>>
  <</if>>
<</widget>>

<!-- 正文设置实际地点后调用。后庭与泳池仍属于校园。 -->
<<widget 'deadwood-reblooms-life-simulation-school-sync-clothes'>>
  <<if $LifeSimulation?.school>>
    <<if $LifeSimulation.school.clothesStored and !['school', 'school_rear_courtyard', 'pool'].includes($location)>>
      <<deadwood-reblooms-life-simulation-school-restore-clothes>>
    <<elseif !$LifeSimulation.school.clothesStored and $location is 'school' and $outside is 0 and $combat isnot 1 and !$statFreeze and maplebirch.get("LifeSimulation").school.requiresNudity>>
      <<deadwood-reblooms-life-simulation-school-enforce-clothes>>
    <</if>>
  <</if>>
<</widget>>

<!-- 离校时恢复衣物。收容或战斗中仅归还储物，保留原版的服装与束缚。 -->
<<widget 'deadwood-reblooms-life-simulation-school-restore-clothes'>>
  <<if $LifeSimulation?.school?.clothesStored>>
    <<silently>>
      <<if $combat is 1 or $statFreeze or ['hospital', 'asylum', 'prison'].includes($location)>>
        <<storeon 'lifeSimulationSchool' 'return'>>
      <<else>>
        <<storeon 'lifeSimulationSchool'>>
      <</if>>
      <<set $LifeSimulation.school.clothesStored to setup.clothingLayer.all.some(slot => $store[slot]?.some(item => item.location === 'lifeSimulationSchool'))>>
      <<exposure>>
    <</silently>>
  <</if>>
<</widget>>

<!-- 处理从其它入口进入学校的情况，确保强制校规不会只在前庭生效。 -->
<<widget 'deadwood-reblooms-life-simulation-school-enforce-clothes'>>
  <<silently>>
    <<undress 'lifeSimulationSchool'>>
    <<set $LifeSimulation.school.clothesStored to true>>
  <</silently>>
  <<language>>
    <<option 'EN'>>A member of staff stops you and points to the posted rule. You must <span class='red'>remove your clothes</span> before they let you pass.
    <<option 'CN'>>一名教职工拦住你，指向墙上的校规。你<span class='red'>脱下衣服</span>后，才被放行。
  <</language>><br><br>
<</widget>>

<!-- 声望沿用原版等级色；堕落为零不显示警告色。 -->
<<widget 'deadwood-reblooms-life-simulation-school-standing'>>
  <span @class="_args[1] ? (_args[0] > 0 ? 'purple' : 'green') : maplebirch.get('LifeSimulation').school.standingColour(_args[0])"><<print _args[0]>>/100</span>
<</widget>>

<<widget 'deadwood-reblooms-life-simulation-school-standing-list'>>
  <ul class='journal'>
    <li>
      <<lanSwitch 'School order: ' '校内秩序：'>><<deadwood-reblooms-life-simulation-school-standing $LifeSimulation.school.order>>
      <<if _args[0]>><<lanSwitch ' (at least ' '（至少 '>> <span class='gold'><<= _args[0]>></span><<lanSwitch ')' '）'>><</if>>
    </li>
    <li>
      <<lanSwitch 'Student standing: ' '学生声望：'>><<deadwood-reblooms-life-simulation-school-standing $LifeSimulation.school.studentSupport>>
      <<if _args[0]>><<lanSwitch ' (at least ' '（至少 '>> <span class='gold'><<= _args[0]>></span><<lanSwitch ')' '）'>><</if>>
    </li>
    <li>
      <<lanSwitch 'Staff trust: ' '教职工信任：'>><<deadwood-reblooms-life-simulation-school-standing $LifeSimulation.school.staffSupport>>
      <<if _args[0]>><<lanSwitch ' (at least ' '（至少 '>> <span class='gold'><<= _args[0]>></span><<lanSwitch ')' '）'>><</if>>
    </li>
    <li><<lanSwitch 'School corruption: ' '校内堕落：'>><<deadwood-reblooms-life-simulation-school-standing $LifeSimulation.school.corruption true>></li>
  </ul>
<</widget>>

<!-- 社交页追加校规状态，原版“学校”声望仍按原逻辑显示。 -->
<<widget 'deadwood-reblooms-life-simulation-school-social'>>
  <<if $LifeSimulation and $LifeSimulation.school>>
    <div class='relation-box'>
      <div class='relation-top-line'>
        <<if $options.images>>
          <img class='relation-icon' src='img/misc/icon/assignment.png'>
        <</if>>
        <span class='relation-name'><<lanSwitch 'School affairs' '校园事务'>></span>
      </div>
      <div class='relation-description'>
        <<lanSwitch 'Dress rule: ' '着装规范：'>>
        <span class='blue'><<print maplebirch.t('deadwood-reblooms:LifeSimulation:school:policy:' + $LifeSimulation.school.dress.active)>></span>
      </div>
    </div>
  <</if>>
<</widget>>

:: Deadwood Reblooms Life Simulation Attendance Application []
<<set $outside to 0>><<set $location to 'school'>><<schooleffects>><<effects>>
<<npc Leighton>><<person1>>
<<lanSwitch 'You ask Leighton to review an application to arrange your own attendance. <<He>> pulls out your marks for all four subjects.' '你请礼顿审核自行安排上课时间的申请。<<He>>抽出四门课的成绩单。'>><br><br>
<<if $schooltrait gte 4 and $sciencetrait gte 4 and $mathstrait gte 4 and $englishtrait gte 4 and $historytrait gte 4>>
  <<if C.npc.Leighton.love gte 10>>
    <<lanSwitch '"These marks are hard to argue with," <<he>> says. "You still need your guardian to sign."' '“这样的成绩，倒没什么可反对的。”<<he>>说，“但还要监护人签字。”'>><br><br>
    <<schoolicon 'building'>><<lanLink ['Ask Leighton to review your marks', '请礼顿审核成绩'] 'Deadwood Reblooms Life Simulation Attendance Application Result'>><</lanLink>><br>
  <<elseif $headblackmailed is 1>>
    <<lanSwitch 'Leighton pauses when you mention the matter you both remember. <<He>> agrees to review your marks, but leaves Bailey’s signature line blank.' '你提起那件彼此都记得的事。礼顿停下笔，答应审核成绩，却把贝利的签名栏留了下来。'>><br><br>
    <<crimeicon 'coercion'>><<lanLink ['Press Leighton to review the form', '要求礼顿审核申请'] 'Deadwood Reblooms Life Simulation Attendance Application Result'>><</lanLink>><br>
  <<else>>
    <span class='pink'><<lanSwitch 'Leighton knows your marks, but does not yet trust you with a separate attendance arrangement.' '礼顿看过成绩，却还不信任你能自行安排上课时间。'>></span><br>
  <</if>>
<<else>>
  <span class='pink'><<lanSwitch 'Leighton wants the highest grade in science, maths, English and history before considering the form.' '礼顿要先看到科学、数学、语文和历史都达到最高档。'>></span><br>
<</if>>
<br><<getouticon>><<lanLink ['Return to the head teacher’s office', '返回校长办公室'] "Head's Office">><</lanLink>>

:: Deadwood Reblooms Life Simulation Attendance Application Result []
<<set $outside to 0>><<set $location to 'school'>><<schooleffects>><<effects>>
<<npc Leighton>><<person1>>
<<if maplebirch.get('LifeSimulation').school.canRequestAttendanceExemption>>
  <<set $LifeSimulation.school.leightonApprovalDay to Time.days>>
  <<lanSwitch 'Leighton signs the school half of the form. "Bring it back with Bailey’s signature. Until then, lessons are still compulsory."' '礼顿签了学校的那一栏。“拿到贝利的签名再来。在那之前，你还得照常上课。”'>><br><br>
  <span class='gold'><<lanSwitch 'The school review is complete. Bailey’s permission is still required.' '学校审核已通过，还需贝利许可。'>></span><br>
<<else>>
  <<lanSwitch 'Leighton sets the form aside. Your application cannot be approved today.' '礼顿放下表格。今天还不能通过申请。'>><br>
<</if>>
<br><<getouticon>><<lanLink ['Return to the head teacher’s office', '返回校长办公室'] "Head's Office">><</lanLink>>

:: Deadwood Reblooms Life Simulation Attendance Approval []
<<set $outside to 0>>
<<set $location to $RobinExpansion?.bailey_defeated ? 'flats' : 'home'>>
<<effects>>
<<npc Bailey>><<person1>>
<<if $LifeSimulation.school.leightonApprovalDay gte 0 and !$LifeSimulation.school.attendanceExempt and !$LifeSimulation.school.baileySigned>>
  <<language>>
    <<option 'EN'>>
      <<if $RobinExpansion?.bailey_defeated>>
        Bailey opens the flat's door just far enough to see you. "What now?" You hold out the school form. <<He>> reads Leighton's signature, then looks up. "You wanted me out."
        <br><br>
        "The school still has you down as my guardian." Bailey keeps a hand on the door. You remind <<him>> that the copies of the rent ledger are still safe. For a moment, neither of you moves. Then <<he>> takes the form. "This is the last time."
        <br><br>
        <<He>> signs against the doorframe and pushes the paper back at you. "Tell Leighton to stop sending you here."
      <<elseif $baileypaychain gte 3>>
        Bailey checks your name in the rent ledger, then turns to Leighton's signature. "So you think you don't need lessons anymore?" <<He>> taps the payment entries with <<his>> pen. "Keep paying on time. I don't want to hear that school got in the way."
        <br><br>
        <<He>> signs the guardian section and slides the form across the desk.
      <<else>>
        Bailey reads Leighton's signature, then sets your form beside the rent ledger. "Three weeks on time. Then I'll sign." <<He>> pushes the paper back before you can explain your marks. "You heard me."
      <</if>>
    <<option 'CN'>>
      <<if $RobinExpansion?.bailey_defeated>>
        贝利只把公寓的门打开一道够看见你的缝。“又怎么了？”你递上学校的表格。<<He>>看过礼顿的签名，抬起头。“不是你们要我走的吗？”
        <br><br>
        “学校那边，你还是我的监护人。”贝利的手仍扶着门。你提醒<<him>>，房租账本的副本还好好留着。你们僵持了片刻，<<he>>才接过表格。“最后一次。”
        <br><br>
        <<He>>抵着门框签完，把纸塞回你手里。“叫礼顿别再让你来烦我。”
      <<elseif $baileypaychain gte 3>>
        贝利在房租账本里找到你的名字，又看了看礼顿的签名。“觉得自己不用上课了？”<<He>>用笔点了点交租记录。“钱照常交。别到时候拿学校当借口。”
        <br><br>
        <<He>>签了监护人的那一栏，把表格推过桌面。
      <<else>>
        贝利看过礼顿的签名，把表格放在房租账本旁。“连续三周按时交租，我才签。”还没等你解释成绩，<<he>>就把纸推了回来。“听清楚了？”
      <</if>>
  <</language>><br><br>
  <<if maplebirch.get('LifeSimulation').school.canSignAttendanceExemption>>
    <<set $LifeSimulation.school.baileySigned to true>>
    <span class='green'><<lanSwitch 'Bailey has signed the guardian section.' '贝利签了监护人的那一栏。'>></span><br>
    <span class='teal'><i><<lanSwitch 'Take the form back to Leighton before skipping any lessons.' '要把表格交回礼顿，上课才能由你自行安排。'>></i></span><br>
  <</if>>
<<elseif $LifeSimulation.school.baileySigned and !$LifeSimulation.school.attendanceExempt>>
  <<lanSwitch 'Bailey has already signed. Take the form back to Leighton.' '贝利已经签字了。把表格交回礼顿。'>><br>
<<else>>
  <<lanSwitch 'Bailey has no reason to sign another request.' '贝利没理由再签一份申请。'>><br>
<</if>>
<br>
<<set _return to $RobinExpansion?.bailey_defeated ? 'Flats' : "Bailey's Office">>
<<getouticon>><<lanLink ['Leave', '离开'] _return>><</lanLink>>

:: Deadwood Reblooms Life Simulation Attendance Filing []
<<set $outside to 0>><<set $location to 'school'>><<schooleffects>><<effects>>
<<npc Leighton>><<person1>>
<<if maplebirch.get('LifeSimulation').school.canGrantAttendanceExemption>>
  <<set $LifeSimulation.school.attendanceExempt to true>>
  <<set $LifeSimulation.school.attendanceDay to Time.days>>
  <<lanSwitch 'Leighton checks Bailey’s signature, stamps the form, and files it. "The choice to attend is yours now. The exams are not going away."' '礼顿核对贝利的签名，在表格上盖章并归档。“来不来上课由你决定，考试可不会因此取消。”'>><br><br>
  <span class='green'><<lanSwitch 'Missing lessons will no longer count as truancy.' '缺课不再记作旷课。'>></span><br>
  <<lanSwitch 'Your exemption remains separate from any student council position.' '免听凭证与学生会职务分别办理。'>><br>
<<else>>
  <<lanSwitch 'The form still lacks one of the required signatures.' '表格仍缺少必要的签名。'>><br>
<</if>>
<br><<getouticon>><<lanLink ['Return to the head teacher’s office', '返回校长办公室'] "Head's Office">><</lanLink>>

:: Deadwood Reblooms Life Simulation School Board []
<<set $outside to 0>>
<<set $location to 'school'>>
<<schooleffects>>
<<effects>>
<<set _school to $LifeSimulation.school>>
<<set _policies to maplebirch.get("LifeSimulation").school.policies>>
<<set _availablePolicies to _policies.slice(0, _policies.indexOf(_school.dress.highest) + 1)>>
<<set _canSelect to _school.role is 'president' and _school.dress.proposal is null and _school.dress.trialUntil is 0>>
<h1 class='header gold bold'><<lanSwitch "Student affairs noticeboard" "学生事务公告栏">></h1>
<<language>>
  <<option 'EN'>>Notices, duty records and dress rules cover the board. New sheets overlap older ones, with Leighton's signature at the foot of each rule.
  <<option 'CN'>>公告栏上贴着通知、值勤记录和着装校规。新告示压在旧告示上，每条校规的末尾都留着礼顿的签名。
<</language>><br><br>
<span class='gold'><<lanSwitch 'Student council' '学生会'>></span><br>
<ul class='journal'>
  <li>
    <<lanSwitch 'School role: ' '校内身份：'>>
    <<if _school.role is 'student'>>
      <<lanSwitch 'Student' '学生'>>
    <<else>>
      <span class='green'><<print maplebirch.t('deadwood-reblooms:LifeSimulation:school:trait:' + _school.role + ':name')>></span>
    <</if>>
  </li>
  <<if _school.role isnot 'student'>>
    <li><<lanSwitch 'Duties completed: ' '已完成值勤：'>><span class='teal'><<= _school.duties.completed>></span></li>
  <</if>>
</ul>
<<deadwood-reblooms-life-simulation-school-standing-list>>
<<if _school.attendanceExempt>>
  <span class='green'><<lanSwitch 'Leighton and Bailey approved your exemption from class attendance.' '礼顿与贝利已批准免听凭证，不上课也不会记缺课。'>></span><br>
<</if>>
<br>
<span class='gold'><<lanSwitch 'Dress policy' '着装规范'>></span><br>
<<lanSwitch "Current dress policy" "当前着装规范">><<lanSwitch ': ' '：'>><span class='blue'><<print maplebirch.t('deadwood-reblooms:LifeSimulation:school:policy:' + _school.dress.active)>></span><br>
<<switch _school.dress.active>>
  <<case 'uniform'>>
    <<language>>
      <<option 'EN'>>The old uniform notice still hangs at eye level. For now, the corridors follow the familiar rule. Staff check clothing at the doors, and the council records any complaints.
      <<option 'CN'>>标准校服的告示仍挂在最显眼的位置。走廊里暂时沿用熟悉的规定。教职工在门口检查衣着，学生会则记录各种抱怨。
    <</language>>
  <<case 'free'>>
    <<language>>
      <<option 'EN'>>The uniform requirement has been struck through. Students may <span class='blue'>choose their own clothes</span>, while staff watch for anyone pushing the new freedom too far. Disputes over the wording are sent to the student council.
      <<option 'CN'>>校服要求被一道粗线划去。如今学生可以<span class='blue'>自行选择衣着</span>，教职工则盯着有没有人把新自由用得过了头。对条文有争议的人，会被指去找学生会。
    <</language>>
  <<case 'revealing'>>
    <<language>>
      <<option 'EN'>>The revised notice <span class='purple'>permits less coverage</span>. Each morning, students pause before the board to check just how far the rule now goes. The earlier limits remain visible beneath the fresh ink.
      <<option 'CN'>>修改过的告示<span class='purple'>放宽了遮掩要求</span>。每天早晨，总有人在公告栏前停下，确认这条规定究竟放到了什么程度。新墨迹下仍看得出过去的限制。
    <</language>>
  <<case 'optionalNudity'>>
    <<language>>
      <<option 'EN'>>Clothing is now <span class='purple'>a choice</span> on campus. The notice makes that freedom explicit, though the arguments around it have not died down. Staff keep a copy of the signed rule beside the doors.
      <<option 'CN'>>校园里的着装如今<span class='purple'>由个人选择</span>。告示把这份自由写得明明白白，围绕它的争论却没有平息。教职工在门旁留着一份签过字的校规。
    <</language>>
  <<case 'nudeDay'>>
    <<language>>
      <<option 'EN'>>Friday has its own dress rule. The date is <span class='pink'>circled in red</span> on the weekly schedule so nobody can claim to have missed it. A second notice explains when the rule begins and ends.
      <<option 'CN'>>周五另有一条着装规定。每周日程上的那一天被<span class='pink'>红笔圈起</span>，谁也不能说自己没看见。旁边另一份告示写明了规定的起止时间。
    <</language>>
  <<case 'mandatoryNudity'>>
    <<language>>
      <<option 'EN'>>The newest rule leaves <span class='red'>no choice of clothing</span> during school hours. Staff repeat it at the doors, while the board records who approved it. Appeals are directed to the headmaster.
      <<option 'CN'>>最新规定在上课时段<span class='red'>不再留给学生着装选择</span>。教职工在门口反复提醒，公告栏上也清楚记着是谁批准了它。异议必须交给校长处理。
    <</language>>
<</switch>>
<br><br>

<<if _school.dress.proposal>>
  <<language>>
    <<option 'EN'>>Your proposal for <span class='blue'><<print maplebirch.t('deadwood-reblooms:LifeSimulation:school:policy:' + _school.dress.proposal)>></span> is waiting for Leighton's decision.
    <<option 'CN'>>你提出的<span class='blue'>“<<print maplebirch.t('deadwood-reblooms:LifeSimulation:school:policy:' + _school.dress.proposal)>>”</span>正在等待礼顿决定。
  <</language>><br>
  <br>
<<elseif maplebirch.get("LifeSimulation").school.canReviewPolicy>>
  <<language>>
    <<option 'EN'>>The trial period has ended. The rule now needs a formal review.
    <<option 'CN'>>试行期已经结束，这项校规需要正式复核。
  <</language>><br><br>
<<elseif _school.dress.trialUntil gt Time.days>>
  <<language>>
    <<option 'EN'>>The current rule remains on trial for <<print _school.dress.trialUntil - Time.days>> more days.
    <<option 'CN'>>当前校规还将试行 <<print _school.dress.trialUntil - Time.days>> 天。
  <</language>><br><br>
<<elseif maplebirch.get("LifeSimulation").school.canProposePolicy>>
  <<language>>
    <<option 'EN'>>Leighton will hear your next proposal in the <span class='blue'>head's office</span>.
    <<option 'CN'>>下一项校规提案，要去<span class='blue'>校长办公室</span>当面交给礼顿。
  <</language>><br><br>
<</if>>

<<if _canSelect and _availablePolicies.length gt 1>>
  <<lanSwitch 'Earlier rules that survived review remain on file. As president, you may reinstate one without repeating its trial.' '通过复核的旧规定仍留在档案里。作为学生会长，你可以恢复其中一项，无须重新试行。'>><br><br>
  <<assignmenticon>><<lanLink ['Choose an approved dress policy', '选择已批准的着装规范'] 'Deadwood Reblooms Life Simulation Dress Selection'>><</lanLink>><br><br>
<</if>>

<<getouticon>><<lanLink ['Return to the hallways', '返回走廊'] 'Hallways'>><</lanLink>>

:: Deadwood Reblooms Life Simulation Dress Selection []
<<set $outside to 0>>
<<set $location to 'school'>>
<<effects>>
<<set _school to $LifeSimulation.school>>
<<set _policies to maplebirch.get("LifeSimulation").school.policies>>
<<set _availablePolicies to _policies.slice(0, _policies.indexOf(_school.dress.highest) + 1)>>
<<set _canSelect to _school.role is 'president' and _school.dress.proposal is null and _school.dress.trialUntil is 0>>
<h1 class='header gold bold'><<lanSwitch 'Approved dress policies' '已批准的着装规范'>></h1>
<<if _canSelect and _availablePolicies.length gt 1>>
  <<lanSwitch 'The board keeps a copy of every rule that passed its trial. Choose which one to put back into effect.' '公告栏保存着每条通过试行的规定。你可以选择其中一条恢复执行。'>><br><br>
  <<for _policy range _availablePolicies>>
    <<if _policy isnot $LifeSimulation.school.dress.active>>
      <<switch _policy>>
        <<case 'uniform'>><<set _policyLabel to '标准校服'>>
        <<case 'free'>><<set _policyLabel to '自由着装'>>
        <<case 'revealing'>><<set _policyLabel to '允许暴露着装'>>
        <<case 'optionalNudity'>><<set _policyLabel to '允许裸体'>>
        <<case 'nudeDay'>><<set _policyLabel to '每周裸体日'>>
        <<case 'mandatoryNudity'>><<set _policyLabel to '强制裸体'>>
      <</switch>>
      <<capture _policy>>
        <<assignmenticon>><<lanLink _policyLabel 'Deadwood Reblooms Life Simulation School Board'>><<run maplebirch.get("LifeSimulation").school.selectPolicy(_policy)>><</lanLink>><br>
      <</capture>>
    <</if>>
  <</for>>
<<else>>
  <<if _canSelect>>
    <<lanSwitch 'No earlier dress rule has been approved yet.' '目前还没有通过复核的旧校规。'>><br>
  <<elseif _school.role isnot 'president'>>
    <span class='blue'><i><<lanSwitch 'Only the student council president can restore an older rule.' '只有学生会长才能恢复旧校规。'>></i></span><br>
  <<elseif _school.dress.proposal>>
    <span class='blue'><i><<lanSwitch 'Leighton has not decided on your proposal yet. You cannot replace the current rule.' '礼顿还没决定是否批准提案，现行校规暂时不能更换。'>></i></span><br>
  <<else>>
    <span class='blue'><i><<lanSwitch 'The current rule must finish its trial and review before you can change it.' '现行校规还需完成试行和复核，暂时不能更换。'>></i></span><br>
  <</if>>
<</if>>
<br>
<<getouticon>><<lanLink ['Return to the noticeboard', '返回公告栏'] 'Deadwood Reblooms Life Simulation School Board'>><</lanLink>>

:: Deadwood Reblooms Life Simulation Prefect Appointment []
<<set $outside to 0>>
<<set $location to 'school'>>
<<effects>>
<<npc Leighton>>
<<person1>>
<<language>>
  <<option 'EN'>>Leighton opens the prefect register. <<He>> checks the staff's reports and your classmates' opinion of you. "This is about keeping order. Your attendance arrangement is a separate matter."
  <<option 'CN'>>礼顿翻开风纪委员名册，核对教师记录和同学对你的评价。“这份工作要维持校园秩序。至于你怎么安排上课，那是另一回事。”
<</language>><br><br>
<<if maplebirch.get('LifeSimulation').school.canRequestPrefect>>
  <<if C.npc.Leighton.love gte 10>>
    <<lanSwitch '"The staff trust you, and the students will listen," ' '“老师信得过你，同学也愿意听你说话，”'>><<he>><<lanSwitch ' says.' '说道。'>><br><br>
    <<schoolicon 'building'>><<lanLink ['Accept the prefect badge', '接受风纪委员徽章'] 'Deadwood Reblooms Life Simulation Prefect Appointment Result'>><<set $phase to 'formal'>><</lanLink>><br>
  <</if>>
  <<if $headblackmailed is 1>>
    <<lanSwitch 'Leighton notices your glance toward the locked drawer. <<His>> fingers tighten around the application.' '礼顿注意到你看向锁住的抽屉，捏紧了申请书。'>><br><br>
    <<crimeicon 'coercion'>><<lanLink ['Remind Leighton what you know', '提醒礼顿你掌握的把柄'] 'Deadwood Reblooms Life Simulation Prefect Appointment Result'>><<set $phase to 'pressure'>><</lanLink>><br>
  <</if>>
  <<if C.npc.Leighton.love lt 10 and $headblackmailed isnot 1>>
    <span class='pink'><<lanSwitch 'Leighton needs a reason to entrust you with the badge.' '礼顿还需要一个把徽章交给你的理由。'>></span><br>
  <</if>>
<<else>>
  <span class='pink'><<language>>
    <<option 'EN'>>"The teachers must consider you <span class='green'>a model student</span>, and your classmates must think you're at least <span class='blue'>cool</span>. A badge means very little if neither side will listen."
    <<option 'CN'>>“老师要认定你是<span class='green'>模范学生</span>，同学也得至少觉得你<span class='blue'>很酷</span>。两边都不肯听你说话，挂个徽章有什么用？”
  <</language>></span><br>
<</if>>
<br>
<<getouticon>><<lanLink "返回校长办公室" "Head's Office">><</lanLink>>

:: Deadwood Reblooms Life Simulation Prefect Appointment Result []
<<set $outside to 0>>
<<set $location to 'school'>>
<<effects>>
<<npc Leighton>>
<<person1>>
<<if maplebirch.get("LifeSimulation").school.appointPrefect($phase is 'pressure')>>
  <<language>>
    <<option 'EN'>>Leighton slides a prefect badge across the desk.
    <<if $phase is 'pressure'>>
      "You have made your point," <<he>> says, looking at the locked drawer. "Keep it out of the register."
    <<else>>
      "Keep order before classes and report serious trouble to me."
    <</if>>
    <<option 'CN'>>礼顿把一枚风纪委员徽章推到桌前。
    <<if $phase is 'pressure'>>
      “你的意思我明白。”<<he>>看向锁住的抽屉，“别把那件事写进值勤簿。”
    <<else>>
      “上课前维持秩序，严重的问题交给我处理。”
    <</if>>
  <</language>><br><br>
  <<language>>
    <<option 'EN'>>Leighton adds your name to the duty rota and hands you a key. "The council room is through the hallways. Use the desk and the rest corner, but leave a record of any complaints you handle. You may excuse yourself from detention. <span class='blue'>Lessons are a separate matter.</span>"
    <<option 'CN'>>礼顿把你的名字添进值勤表，递来一把钥匙。“学生会室从走廊进去。书桌和休息角可以用，受理申诉要留下记录。留堂你可以自行决定。<span class='blue'>上课另说。</span>”
  <</language>><br><br>
  <span class='green'><<lanSwitch "You became a prefect." "你成为了风纪委员。">></span>
  <br><<deadwood-reblooms-life-simulation-school-feedback>>
<<else>>
  <<lanSwitch 'Leighton closes your record. The appointment has not been approved.' '礼顿合上你的档案。这次任命没有获批。'>>
<</if>>
<br><br>
<<getouticon>><<lanLink "返回校长办公室" "Head's Office">><</lanLink>>

:: Deadwood Reblooms Life Simulation President Appointment []
<<set $outside to 0>>
<<set $location to 'school'>>
<<effects>>
<<npc Leighton>>
<<person1>>
<<lanSwitch 'You ask Leighton to make you student council president. ' '你向礼顿申请担任学生会长。'>><<He>><<lanSwitch ' lays your duty reports beside notes from students and staff.' '把你的值勤报告与学生、教职工的意见放在一起。'>><br><br>
<ul class='journal'>
  <li><<lanSwitch 'Morning duties: ' '晨间值勤：'>><span class='teal'><<= Math.clamp($LifeSimulation.school.duties.completed, 0, 5)>>/5</span></li>
</ul>
<<deadwood-reblooms-life-simulation-school-standing-list 25>>
<br>
<<if maplebirch.get('LifeSimulation').school.canAppointPresident>>
  <<lanSwitch '"You have earned enough trust to lead them. The final decision is yours," ' '“你已经赢得了足够的信任。要不要接下这份职责，由你决定，”'>><<he>><<lanSwitch ' says.' '说道。'>><br><br>
  <<schoolicon 'building'>><<lanLink ['Accept the presidency', '接受学生会长任命'] 'Deadwood Reblooms Life Simulation President Appointment Result'>><</lanLink>><br>
<<else>>
  <span class='pink'><<lanSwitch '"I need more duty reports and stronger support before I can approve this."' '“我还需要更多值勤记录，以及学生和教职工更明确的支持。”'>></span><br>
<</if>>
<br>
<<getouticon>><<lanLink "返回校长办公室" "Head's Office">><</lanLink>>

:: Deadwood Reblooms Life Simulation President Appointment Result []
<<set $outside to 0>>
<<set $location to 'school'>>
<<effects>>
<<npc Leighton>>
<<person1>>
<<if maplebirch.get('LifeSimulation').school.appointPresident()>>
  <<language>>
    <<option 'EN'>>Leighton signs the appointment and slides the student council ledger toward you. "Lead them well. Bring any proposed rules to me before you announce them."
    <<option 'CN'>>礼顿签下任命书，把学生会的记录簿推到你面前。“好好带领他们。新校规宣布前，先亲自拿来给我看。”
  <</language>><br><br>
  <span class='green'><<lanSwitch "You became student council president." "你成为了学生会长。">></span>
  <br><<deadwood-reblooms-life-simulation-school-feedback>>
<<else>>
  <<lanSwitch 'Leighton sets the appointment aside. The council will have to wait.' '礼顿把任命书放到一旁。学生会暂时还不能交给你。'>>
<</if>>
<br><br>
<<getouticon>><<lanLink "返回校长办公室" "Head's Office">><</lanLink>>

:: Deadwood Reblooms Life Simulation Morning Duty []
<<set $outside to 1>>
<<set $location to 'school'>>
<<schooleffects>>
<<effects>>
<<set _student to maplebirch.get("LifeSimulation").school.startDuty()>>
<<if _student>>
  <<lanSwitch 'Leighton has put you on the morning gate. You check the arrivals and decide how to handle each breach yourself.' '礼顿安排你在校门口值早班。进校的人从你面前经过，如何处理违规者都要由你亲自决定。'>><br><br>
  <<if _student is 'Robin'>>
    <<language>>
      <<option 'EN'>>
        Robin hurries up with a younger pupil. The child's shoelace has come undone,
        and Robin stops to tie it before showing you a pass for the delay.
        Robin looks from your badge to the register in your hand.
      <<option 'CN'>>
        罗宾领着一名低年级学生赶来。那孩子的鞋带散了，罗宾蹲下替他系好，
        才把说明耽搁原因的条子递给你。罗宾的目光在你的徽章和记录簿之间来回。
    <</language>>
    <br><br><<schoolicon 'building'>><<lanLink ["Record Robin's delay", '记下罗宾耽搁的原因'] 'Deadwood Reblooms Life Simulation Morning Duty Result'>><<set $phase to 'enforce'>><</lanLink>><br>
    <<socialiseicon>><<lanLink ['Speak to Robin privately', '私下与罗宾谈谈'] 'Deadwood Reblooms Life Simulation Morning Duty Private Talk'>><</lanLink>><br>
    <<getouticon>><<lanLink ['Wave Robin through without checking', '不查记录，直接放罗宾进去'] 'Deadwood Reblooms Life Simulation Morning Duty Result'>><<set $phase to 'overlook'>><</lanLink>>
  <<elseif _student is 'Sydney'>>
    <<language>>
      <<option 'EN'>>
        Sydney reaches the gate with a bundle of temple papers under one arm.
        You ask why the temple errand has delayed the trip to school.
        Sydney explains it plainly, then waits for you to decide whether it belongs on the duty register.
      <<option 'CN'>>
        悉尼夹着一叠神殿的文件来到校门。你问起神殿的差事为何耽搁了入校，
        悉尼平静地说明原委，等你决定是否记入值勤簿。
    <</language>>
    <br><br><<schoolicon 'building'>><<lanLink ["Record Sydney's reason", '记下悉尼的缘由'] 'Deadwood Reblooms Life Simulation Morning Duty Result'>><<set $phase to 'enforce'>><</lanLink>><br>
    <<socialiseicon>><<lanLink ['Speak to Sydney privately', '私下与悉尼谈谈'] 'Deadwood Reblooms Life Simulation Morning Duty Private Talk'>><</lanLink>><br>
    <<getouticon>><<lanLink ['Let Sydney pass without checking', '不查记录，放悉尼过去'] 'Deadwood Reblooms Life Simulation Morning Duty Result'>><<set $phase to 'overlook'>><</lanLink>>
  <<elseif _student is 'Kylar'>>
    <<language>>
      <<option 'EN'>>
        You find Kylar alone beside the side gate, holding <<his>> books close.
        <<He>> keeps away from the stream of students entering by the main doors.
        Kylar looks up at your voice, then shrinks back when <<he>> notices your badge.
        Someone has scrawled a cruel word across the cover of the top book.
      <<option 'CN'>>
        你在侧门边发现独自站着的凯拉尔，书本被紧紧抱在怀里。
        凯拉尔避开了从正门入校的人群，听见你的声音才抬起头，看到你的徽章又往后缩了缩。
        最上面那本书的封面被人写了难听的话。
    <</language>>
    <br><br><<schoolicon 'building'>><<lanLink ['Order Kylar straight to class', '命令凯拉尔马上去上课'] 'Deadwood Reblooms Life Simulation Morning Duty Result'>><<set $phase to 'enforce'>><</lanLink>><br>
    <<socialiseicon>><<lanLink ['Speak to Kylar privately', '私下与凯拉尔谈谈'] 'Deadwood Reblooms Life Simulation Morning Duty Private Talk'>><</lanLink>><br>
    <<getouticon>><<lanLink ['Leave Kylar at the gate', '任由凯拉尔留在校门口'] 'Deadwood Reblooms Life Simulation Morning Duty Result'>><<set $phase to 'overlook'>><</lanLink>>
  <<else>>
    <<language>>
      <<option 'EN'>>
        Whitney plants themself across the entrance and sends the next student back with a sneer.
        You step between them and the queue. Whitney spots your badge and grins,
        daring you to make a scene in front of everyone.
      <<option 'CN'>>
        惠特尼横在入口，讥笑着把下一个学生逼了回去。你挡在惠特尼与队伍之间。
        惠特尼瞥见你的徽章，咧嘴一笑，像是在等你当众出丑。
    <</language>>
    <br><br><<schoolicon 'building'>><<lanLink ["Write up Whitney's obstruction", '记录惠特尼堵门的行为'] 'Deadwood Reblooms Life Simulation Morning Duty Result'>><<set $phase to 'enforce'>><</lanLink>><br>
    <<socialiseicon>><<lanLink ['Speak to Whitney privately', '私下与惠特尼谈谈'] 'Deadwood Reblooms Life Simulation Morning Duty Private Talk'>><</lanLink>><br>
    <<getouticon>><<lanLink ['Ignore Whitney', '不理会惠特尼'] 'Deadwood Reblooms Life Simulation Morning Duty Result'>><<set $phase to 'overlook'>><</lanLink>>
  <</if>>
<<else>>
  <span class='blue'><<lanSwitch 'The morning gate duty has ended.' '晨间校门值勤已经结束。'>></span>
<</if>>

:: Deadwood Reblooms Life Simulation Morning Duty Private Talk []
<<set $outside to 1>>
<<set $location to 'school'>>
<<schooleffects>>
<<effects>>
<<set _student to $LifeSimulation.school.duties.target>>
<<if _student and maplebirch.get("LifeSimulation").school.canPerformDuty>>
  <<switch _student>>
    <<case 'Robin'>>
      <<language>>
        <<option 'EN'>>You draw Robin aside without losing sight of the younger pupil. Robin explains the delay quietly, keeping one eye on the child by the gate.
        <<option 'CN'>>你请罗宾走到一旁，又留意着等在校门边的低年级学生。罗宾压低声音解释耽搁的原因，目光仍不时落在那孩子身上。
      <</language>>
      <<if C.npc.Robin.trauma gte 20>>
        <<lanSwitch 'Robin keeps a little distance and asks you to finish the register before the child gets anxious.' '罗宾与你隔着一点距离，请你先处理登记，免得那孩子等得不安。'>>
      <<elseif C.npc.Robin.love gte 40>>
        <<lanSwitch 'When you lower the register, Robin relaxes and smiles at you, though <<he>> still waits for the child to be let inside.' '你放低记录簿，罗宾才松了口气，朝你笑了笑，但仍等着你放那孩子进去。'>>
      <<else>>
        <<lanSwitch 'Robin waits for your decision, ready to take the child straight to class.' '罗宾等你作出决定，准备带那孩子直接去教室。'>>
      <</if>><br><br>
      <<socialiseicon>><<lanLink ['Hear Robin out and let them in', '听罗宾说明并放行'] 'Deadwood Reblooms Life Simulation Morning Duty Result'>><<set $phase to 'mediate'>><</lanLink>><br>
      <<crimeicon 'coercion'>><<lanLink ['Threaten to report both pupils', '威胁把两名学生都记进报告'] 'Deadwood Reblooms Life Simulation Morning Duty Result'>><<set $phase to 'pressure'>><</lanLink>><br>
      <<if maplebirch.get("LifeSimulation").school.canInviteStudent>>
        <<loveicon>><<lanLink ['Invite Robin to meet in private', '邀罗宾单独见面'] 'Deadwood Reblooms Life Simulation Morning Duty Invitation'>><</lanLink>><<promiscuous3>><br>
      <</if>>
    <<case 'Sydney'>>
      <<language>>
        <<option 'EN'>>You step away from the queue with Sydney. The temple papers remain tucked under one arm while Sydney explains the errand in a low voice.
        <<option 'CN'>>你和悉尼走到队伍旁边。悉尼仍把神殿文件夹在臂弯里，低声向你说明这趟差事。
      <</language>>
      <<if C.npc.Sydney.purity gte 50 and C.npc.Sydney.corruption lt 10>>
        <<lanSwitch 'Sydney glances at the school doors. "I should get to class once you have written down the reason."' '悉尼看了眼校门：“记下缘由后，我就该去上课了。”'>>
      <<elseif C.npc.Sydney.love gte 40 and C.npc.Sydney.corruption gte 30>>
        <<lanSwitch 'Sydney meets your eyes for a moment longer than the explanation requires, then carefully folds the papers shut.' '悉尼与你对视的时间比解释差事所需的久了一点，随后仔细合上文件。'>>
      <<else>>
        <<lanSwitch 'Sydney keeps to the facts and waits for you to decide what belongs in the register.' '悉尼只说了事情的经过，等你决定值勤簿该怎么写。'>>
      <</if>><br><br>
      <<socialiseicon>><<lanLink ['Hear the reason and send Sydney to class', '听完缘由，送悉尼去上课'] 'Deadwood Reblooms Life Simulation Morning Duty Result'>><<set $phase to 'mediate'>><</lanLink>><br>
      <<crimeicon 'coercion'>><<lanLink ["Threaten to report Sydney's temple errand", '威胁上报悉尼的神殿差事'] 'Deadwood Reblooms Life Simulation Morning Duty Result'>><<set $phase to 'pressure'>><</lanLink>><br>
      <<if maplebirch.get("LifeSimulation").school.canInviteStudent>>
        <<loveicon>><<lanLink ['Invite Sydney to meet in private', '邀悉尼单独见面'] 'Deadwood Reblooms Life Simulation Morning Duty Invitation'>><</lanLink>><<promiscuous3>><br>
      <</if>>
    <<case 'Kylar'>>
      <<language>>
        <<option 'EN'>>You lower your voice beside the side gate and ask Kylar about the writing on the book. No one else is close enough to hear the answer.
        <<option 'CN'>>你在侧门边放低声音，问起书封上的涂写。其他学生离得够远，听不见凯拉尔的回答。
      <</language>>
      <<if C.npc.Kylar.rage gte 60>>
        <<lanSwitch 'Kylar grips the book harder. "Are you going to write down my name too?"' '凯拉尔把书抱得更紧：“连我的名字也要记上吗？”'>>
      <<elseif C.npc.Kylar.love gte 30>>
        <<lanSwitch 'Kylar edges closer to you. "They took it from me," Kylar whispers, turning the ruined cover away from the queue.' '凯拉尔朝你靠近了一点，避开队伍举起被涂坏的书封，小声说：“他们抢走了我的书。”'>>
      <<else>>
        <<lanSwitch 'Kylar looks down at the book before admitting that someone snatched it on the way to school.' '凯拉尔低头看着书，好一会儿才承认有人在上学路上抢走了它。'>>
      <</if>><br><br>
      <<socialiseicon>><<lanLink ['Record what happened to Kylar', '记下凯拉尔的遭遇'] 'Deadwood Reblooms Life Simulation Morning Duty Result'>><<set $phase to 'mediate'>><</lanLink>><br>
      <<crimeicon 'coercion'>><<lanLink ['Threaten Kylar with a disciplinary report', '威胁将凯拉尔记作违纪'] 'Deadwood Reblooms Life Simulation Morning Duty Result'>><<set $phase to 'pressure'>><</lanLink>><br>
      <<if maplebirch.get("LifeSimulation").school.canInviteStudent>>
        <<loveicon>><<lanLink ['Invite Kylar to meet in private', '邀凯拉尔单独见面'] 'Deadwood Reblooms Life Simulation Morning Duty Invitation'>><</lanLink>><<promiscuous3>><br>
      <</if>>
    <<case 'Whitney'>>
      <<language>>
        <<option 'EN'>>You ask Whitney to step away from the entrance so the waiting students can pass. Whitney follows you a few paces, watching to see whether you will reach for your register.
        <<option 'CN'>>你让惠特尼先离开入口，好让等候的学生通过。惠特尼跟你走了几步，瞟着你会不会翻开记录簿。
      <</language>>
      <<if C.npc.Whitney.love gte 25 or $whitneyromance is 1>>
        <<lanSwitch 'Whitney leans against the wall and grins. "So, what did you really want to say?"' '惠特尼靠在墙上，笑得意味深长：“所以，你到底想说什么？”'>>
      <<else>>
        <<lanSwitch 'Whitney folds <<his>> arms. "Got something to say? Say it where everyone can hear."' '惠特尼抱起手臂：“有话就当着所有人的面说。”'>>
      <</if>><br><br>
      <<socialiseicon>><<lanLink ['Tell Whitney to move aside', '要求惠特尼让开'] 'Deadwood Reblooms Life Simulation Morning Duty Result'>><<set $phase to 'mediate'>><</lanLink>><br>
      <<crimeicon 'coercion'>><<lanLink ['Threaten to bring Leighton to the gate', '威胁叫礼顿到校门口'] 'Deadwood Reblooms Life Simulation Morning Duty Result'>><<set $phase to 'pressure'>><</lanLink>><br>
      <<if maplebirch.get("LifeSimulation").school.canInviteStudent>>
        <<loveicon>><<lanLink ['Invite Whitney to meet in private', '邀惠特尼单独见面'] 'Deadwood Reblooms Life Simulation Morning Duty Invitation'>><</lanLink>><<promiscuous3>><br>
      <</if>>
  <</switch>>
  <<getouticon>><<lanLink ['Return to the gate', '返回校门口'] 'Deadwood Reblooms Life Simulation Morning Duty'>><</lanLink>>
<<else>>
  <span class='blue'><<lanSwitch 'The student has already left the gate.' '那名学生已经离开校门。'>></span><br><br>
  <<entranceicon>><<lanLink ['Return to the front courtyard', '返回前庭'] 'School Front Courtyard'>><</lanLink>>
<</if>>

:: Deadwood Reblooms Life Simulation Morning Duty Invitation []
<<set $outside to 1>>
<<set $location to 'school'>>
<<schooleffects>>
<<effects>>
<<set _student to $LifeSimulation.school.duties.target>>
<<set _loveBefore to _student ? C.npc[_student].love : 0>>
<<set _kylarClose to _student is 'Kylar' and C.npc.Kylar.love gte 30>>
<<set _invitation to maplebirch.get("LifeSimulation").school.inviteStudent()>>
<<set _loveChange to _student ? C.npc[_student].love - _loveBefore : 0>>
<<if _invitation is 'accepted'>>
  <<switch _student>>
    <<case 'Robin'>>
      <<language>>
        <<option 'EN'>>You wait while Robin takes the younger pupil inside. When Robin returns, you ask for a moment alone after the gate clears. Robin understands your meaning, glances at the thinning queue and quietly agrees.
        <<option 'CN'>>你等罗宾把低年级学生送进去。罗宾回来后，你说等队伍散了，想和罗宾单独待一会儿。罗宾听懂了，看一眼渐渐空下来的入口，轻声答应。
      <</language>>
    <<case 'Sydney'>>
      <<language>>
        <<option 'EN'>>You suggest putting the temple papers aside and finding somewhere quiet together. Sydney studies you for a moment, then gives a small, deliberate nod. The papers can wait.
        <<option 'CN'>>你提议先放下神殿文件，找个安静的地方待一会儿。悉尼打量了你片刻，认真地点了点头。那叠文件暂时被放到了一旁。
      <</language>>
    <<case 'Kylar'>>
      <<language>>
        <<option 'EN'>>You ask Kylar if <<he>> wants to be alone and intimate with you, somewhere no one will bother you. Kylar goes still, then glances at the gate, at the students, at you. "<span class='teal'>You—</span>" <<he>> starts, and has to try again. "<span class='teal'>Yes. Yes, I do.</span>" <<He>> follows you away from the side gate, closer than <<he>> needs to be.
        <<option 'CN'>>你问凯拉尔愿不愿意避开人群，与你亲密一会儿。凯拉尔僵了一下，看看校门、看看学生、又看看你。“<span class='teal'>你——</span>”<<he>>开了个头，又不得不重新说一遍。“<span class='teal'>好。好，我想。</span>”<<He>>跟着你离开侧门，靠得比需要的还近。
      <</language>>
    <<case 'Whitney'>>
      <<language>>
        <<option 'EN'>>You lean close and invite Whitney away from the crowd. Whitney smirks. "Finally putting that badge to good use?" Whitney orders their friends to clear the gate, then leads you toward an empty room.
        <<option 'CN'>>你凑近惠特尼，邀对方避开人群。惠特尼坏笑起来：“总算知道那块徽章该怎么用了？”惠特尼叫朋友们让开入口，随后领着你往空教室走。
      <</language>>
  <</switch>>
  <<if _loveChange gt 0>>
    <<glove _student>>
  <</if>>
  <br>
  <<deadwood-reblooms-life-simulation-school-feedback>><br>
  <<loveicon>><<lanLink ['Go somewhere private together (0:02)', '一起去僻静处 (0:02)'] 'Deadwood Reblooms Life Simulation Morning Duty Encounter'>>
    <<set $sexstart to 1>>
    <<pass 2>>
  <</lanLink>><br>
<<elseif _invitation is 'refused'>>
  <<switch _student>>
    <<case 'Robin'>>
      <<language>>
        <<option 'EN'>>Robin makes sure the younger pupil is through the doors before answering. "I need to get to class. Ask me another time, away from the gate." Robin leaves you with the duty sheet.
        <<option 'CN'>>罗宾先确认那名低年级学生进了校门，才回答你：“我得去上课。下次别在校门口说这个。”罗宾把值勤记录留给你，转身走了。
      <</language>>
    <<case 'Sydney'>>
      <<language>>
        <<option 'EN'>>Sydney closes the bundle of papers. "Not here, and not while you are supposed to be on duty." Sydney goes inside without waiting for another suggestion.
        <<option 'CN'>>悉尼合上文件：“不在这里，也不在你值勤的时候。”说完便进了学校，没有给你再次提议的机会。
      <</language>>
    <<case 'Kylar'>>
      <<if C.npc.Kylar.rage gte 60>>
        <<language>>
          <<option 'EN'>>Kylar clutches the marked book and glares at you. "You noticed me now?" The anger in <<his>> voice ends the invitation. Kylar goes through the side door alone.
          <<option 'CN'>>凯拉尔抱紧被涂写的书，瞪了你一眼：“现在才看见我？”那股怒气截断了你的邀约。凯拉尔独自从侧门进了学校。
        <</language>>
      <<else>>
        <<if _kylarClose>>
          <<language>>
            <<option 'EN'>>Kylar looks down at the writing on <<his>> book and shakes <<his>> head. "Not today," <<he>> says, and then, quieter, "Not today, <<kylar_pet_name>>. Please." Kylar slips through the side door before you can say more.
            <<option 'CN'>>凯拉尔低头看了看书上的涂写，摇了摇头：“今天不行。”<<he>>顿了顿，声音低下去：“今天不行，<<kylar_pet_name>>。求你了。”你还没来得及再说什么，凯拉尔就从侧门进了学校。
          <</language>>
        <<else>>
          <<language>>
            <<option 'EN'>>Kylar turns the marked book away from you. "I need to get inside." Kylar slips through the side door before you can say more.
            <<option 'CN'>>凯拉尔把涂写过的书转到你看不见的一侧：“我得进去了。”你还没来得及再说什么，凯拉尔就从侧门走了。
          <</language>>
        <</if>>
      <</if>>
    <<case 'Whitney'>>
      <<language>>
        <<option 'EN'>>Whitney laughs, but takes a step back. "Try asking when you are not waving that badge at me." Whitney clears the doorway with a shove of the shoulder and walks off.
        <<option 'CN'>>惠特尼笑出了声，却退开一步：“等你不拿那块徽章冲我摆架子，再来问。”惠特尼用肩膀挤开堵着门的人，转身走了。
      <</language>>
  <</switch>>
  <<if _loveChange lt 0>>
    <<llove _student>>
  <</if>>
  <br>
  <<deadwood-reblooms-life-simulation-school-feedback>><br>
<<else>>
  <span class='blue'><<lanSwitch 'The student has gone before you can speak in private.' '那名学生已经走了，你没能私下开口。'>></span><br><br>
<</if>>
<<entranceicon>><<lanLink ['Return to the front courtyard', '返回前庭'] 'School Front Courtyard'>>
  <<set $LifeSimulation.school.duties.encounter to null>>
<</lanLink>>

:: Deadwood Reblooms Life Simulation Morning Duty Encounter []
<<set $outside to 0>>
<<set $location to 'school'>>
<<schooleffects>>
<<if $sexstart is 1 and $LifeSimulation.school.duties.encounter>>
  <<set $sexstart to 0>>
  <<clearnpc>>
  <<npc $LifeSimulation.school.duties.encounter>>
  <<consensual>>
  <<set $consensual to 1>>
  <<neutral 1>>
  <<maninit>>
<</if>>
<<if $LifeSimulation.school.duties.encounter>>
  <<if $LifeSimulation.school.duties.encounter is 'Sydney'>>
    <<run statusCheck('Sydney')>><<set $corruptionEvent to 1>><<set $enemyanger to -10>>
  <</if>>
  <<effects>>
  <<effectsman>>
  <<man>>
  <<stateman>>
  <br><br>
  <<actionsman>>
  <<if _combatend or _controlRegain is 1>>
    <span id='next'><<lanLink ["Next","继续"] 'Deadwood Reblooms Life Simulation Morning Duty Encounter Finish'>><</lanLink>></span>
  <<else>>
    <span id='next'><<lanLink ["Next","继续"] 'Deadwood Reblooms Life Simulation Morning Duty Encounter'>><</lanLink>></span>
  <</if>>
  <<nexttext>>
<<else>>
  <span class='blue'><<lanSwitch 'There is no private meeting to continue.' '没有尚未结束的私下约见。'>></span><br><br>
  <<entranceicon>><<lanLink ['Return to the front courtyard', '返回前庭'] 'School Front Courtyard'>><</lanLink>>
<</if>>

:: Deadwood Reblooms Life Simulation Morning Duty Encounter Finish []
<<set $outside to 0>>
<<set $location to 'school'>>
<<schooleffects>>
<<effects>>
<<set _student to $LifeSimulation.school.duties.encounter>>
<<if _student>>
  <<if $enemyarousal gte $enemyarousalmax>>
    <<ejaculation>><br>
  <</if>>
  <<if $enemyhealth lte 0 or $finish is 1>>
    <<lanSwitch 'The encounter ends abruptly. You give each other room to recover before leaving the empty classroom.' '这次相处戛然而止。你们各自缓了缓，才离开空教室。'>>
  <<else>>
    <<switch _student>>
      <<case 'Robin'>>
        <<language>>
          <<option 'EN'>>Robin straightens <<his>> clothes and checks the corridor before stepping out. "We really should get to class," Robin says, smiling despite themself.
          <<option 'CN'>>罗宾整理好衣着，先探头看了看走廊。“我们真该去上课了。”罗宾说着，还是忍不住笑了。
        <</language>>
      <<case 'Sydney'>>
        <<language>>
          <<option 'EN'>>Sydney retrieves the temple papers and takes a steadying breath. "We should return before anyone notices how long we were gone."
          <<option 'CN'>>悉尼拿回神殿文件，深吸了一口气：“我们该回去了，免得有人发现离开得太久。”
        <</language>>
      <<case 'Kylar'>>
        <<language>>
          <<option 'EN'>>Kylar stays beside you a moment longer, then checks the empty corridor. "Can we leave together?" Kylar asks quietly.
          <<option 'CN'>>凯拉尔又在你身边待了一会儿，才看了看空荡荡的走廊。“我们能一起走吗？”凯拉尔小声问。
        <</language>>
      <<case 'Whitney'>>
        <<language>>
          <<option 'EN'>>Whitney gives you a crooked grin while putting <<his>> clothes in order. "Next time, find me before the bell," Whitney says, and slips into the hall.
          <<option 'CN'>>惠特尼一边整理衣服一边冲你歪嘴笑了笑。“下回赶在铃响之前来找我。”说完便溜进了走廊。
        <</language>>
    <</switch>>
  <</if>><br><br>
  <<clotheson>>
  <<endcombat>>
  <<set $LifeSimulation.school.duties.encounter to null>>
<<else>>
  <span class='blue'><<lanSwitch 'The meeting has ended.' '这次约见已经结束。'>></span><br><br>
<</if>>
<<entranceicon>><<lanLink ['Return to the hallways', '返回走廊'] 'Hallways'>><</lanLink>>

:: Deadwood Reblooms Life Simulation Morning Duty Result []
<<set $outside to 1>>
<<set $location to 'school'>>
<<schooleffects>>
<<effects>>
<<set _student to $LifeSimulation.school.duties.target>>
<<set _loveBefore to _student ? C.npc[_student].love : 0>>
<<set _whitneyClose to _student is 'Whitney' and (C.npc.Whitney.love gte 25 or $whitneyromance is 1)>>
<<if maplebirch.get("LifeSimulation").school.finishDuty($phase)>>
  <<if _student is 'Robin'>>
    <<if $phase is 'enforce'>>
      <<language>>
        <<option 'EN'>>You put Robin's name in the duty register, but write down why <<he>> stopped. Robin accepts the entry and takes the younger pupil inside.
        <<option 'CN'>>你在值勤簿上记下罗宾的名字，也写明了耽搁的原因。罗宾接受记录，领着那名学生进了学校。
      <</language>>
    <<elseif $phase is 'mediate'>>
      <<language>>
        <<option 'EN'>>You check the note, add a line about the younger pupil and wave them both through. Robin thanks you and hurries to class.
        <<option 'CN'>>你看过条子，记下低年级学生的情况，放两人过去。罗宾向你道谢，赶往教室。
      <</language>>
    <<elseif $phase is 'pressure'>>
      <<language>>
        <<option 'EN'>>Out of the queue's hearing, you threaten to put <span class='red'>both names</span> in the report unless Robin leaves the child and goes straight to class. Robin takes the child's hand. "Write mine down if you must. I won't leave them." Robin leads the pupil away without looking back.
        <<option 'CN'>>你避开队伍，威胁罗宾若不丢下那孩子去上课，就把<span class='red'>两人的名字</span>一起记进报告。罗宾握住孩子的手：“要记就记我的。我不会丢下他。”罗宾领着孩子离开，没有再回头看你。
      <</language>>
    <<else>>
      <<language>>
        <<option 'EN'>>You wave Robin through without opening the register. Robin looks relieved, though another student notices your exception.
        <<option 'CN'>>你没有翻开记录簿，直接放罗宾进去。罗宾松了口气，旁边的学生却也看见了这次例外。
      <</language>>
    <</if>>
  <<elseif _student is 'Sydney'>>
    <<if $phase is 'enforce'>>
      <<language>>
        <<option 'EN'>>You record Sydney's arrival and the reason given. Sydney asks you to keep the explanation beside the time, then goes to class without another word.
        <<option 'CN'>>你记下悉尼到校的时间和所说的缘由。悉尼请你把解释留在时间旁边，随后一言不发地去了教室。
      <</language>>
    <<elseif $phase is 'mediate'>>
      <<language>>
        <<option 'EN'>>You glance through the temple papers, note the errand and send Sydney inside. Sydney gives you a brief, grateful nod.
        <<option 'CN'>>你看了看神殿文件，记下差事，放悉尼进校。悉尼简短地点头致谢。
      <</language>>
    <<elseif $phase is 'pressure'>>
      <<language>>
        <<option 'EN'>>Away from the queue, you threaten to tell the teachers Sydney chose temple work over school. Sydney meets your stare. "Then include what I actually told you." Sydney takes back the papers and heads inside, keeping a careful distance from you.
        <<option 'CN'>>你避开队伍，威胁要告诉老师，悉尼把神殿差事看得比上课更重要。悉尼迎着你的目光：“那就把我刚才说的原委也写上。”悉尼取回文件，与你保持距离，走进学校。
      <</language>>
    <<else>>
      <<language>>
        <<option 'EN'>>You leave the register closed. Sydney passes you with a brief nod, while the other students wait to see whether they too can go unmarked.
        <<option 'CN'>>你合上记录簿，放悉尼过去。其他排队进校的学生则等着看自己能否也不用登记。
      <</language>>
    <</if>>
  <<elseif _student is 'Kylar'>>
    <<if $phase is 'enforce'>>
      <<language>>
        <<option 'EN'>>You tell Kylar it is time to go inside. Kylar hides the marked book beneath the others and obeys without explaining the delay.
        <<option 'CN'>>你叫凯拉尔进校。凯拉尔把被涂写的书藏到下面，没解释为何迟疑，低头走了进去。
      <</language>>
    <<elseif $phase is 'mediate'>>
      <<language>>
        <<option 'EN'>>You record that someone took and defaced Kylar's book, without blaming Kylar for the delay.
        <<option 'CN'>>你记下有人抢走并涂坏凯拉尔的书，没有把迟到的错推给凯拉尔。
      <</language>>
      <<if C.npc.Kylar.rage gte 60>>
        <<lanSwitch 'Kylar checks the entry, then goes inside without another word.' '凯拉尔看了一眼记录，没再说话，独自进了学校。'>>
      <<else>>
        <<lanSwitch 'Kylar keeps close as you walk inside together.' '凯拉尔贴着你，一起走进了学校。'>>
      <</if>>
    <<elseif $phase is 'pressure'>>
      <<language>>
        <<option 'EN'>>You threaten to report Kylar for loitering if <<he>> stays another moment. Kylar goes still and turns the marked book away from you. "You brought me aside just to say that?" Kylar enters alone, leaving you with the report in your hand.
        <<option 'CN'>>你威胁凯拉尔再不走就上报逗留违纪。凯拉尔僵在原地，把涂写过的书转到你看不见的一侧：“你叫我过来，就是为了说这个？”凯拉尔独自进了学校，只留下你和手里的记录簿。
      <</language>>
    <<else>>
      <<language>>
        <<option 'EN'>>You leave Kylar by the side gate. Kylar stays there with the marked book pressed against <<his>> chest, watching you until the corridor beyond the door falls quiet.
        <<option 'CN'>>你没有催凯拉尔离开。凯拉尔仍抱着那本被涂写的书站在侧门边，一直望着你，直到门后的走廊安静下来。
      <</language>>
    <</if>>
  <<else>>
    <<if $phase is 'enforce'>>
      <<language>>
        <<option 'EN'>>You write Whitney's name and the obstruction in your report. Whitney swears at you, then steps aside when you hold up the finished page. The waiting students file past.
        <<option 'CN'>>你把惠特尼的名字和堵门经过写进报告。惠特尼骂了你一句，你举起写好的记录，惠特尼才让开。学生们赶紧从旁边通过。
      <</language>>
    <<elseif $phase is 'mediate'>>
      <<if _whitneyClose>>
        <<language>>
          <<option 'EN'>>You tell Whitney to let the students pass. Whitney gives you a crooked smile and steps aside, making a show of obeying only because you asked. You keep the queue moving until the gate clears.
          <<option 'CN'>>你让惠特尼放学生过去。惠特尼歪嘴一笑，终于让开，还故意做出一副只听你话的样子。你守在入口，直到队伍通过。
        <</language>>
      <<else>>
        <<language>>
          <<option 'EN'>>You stand in front of Whitney and tell <<him>> to let the students pass. Whitney studies you, then steps aside with a mocking bow. You keep the queue moving until the gate clears.
          <<option 'CN'>>你站到惠特尼面前，要求放学生过去。惠特尼打量了你一会儿，做了个挖苦人的鞠躬，终于让开。你守在入口，直到队伍通过。
        <</language>>
      <</if>>
    <<elseif $phase is 'pressure'>>
      <<language>>
        <<option 'EN'>>You warn Whitney that you will bring Leighton to the gate and make <<him>> answer for blocking it.
        <<option 'CN'>>你警告惠特尼，再堵着校门就叫礼顿过来问责。
      <</language>>
      <<if _whitneyClose>>
        <<lanSwitch "Whitney's smile disappears. You have made the threat in private, but it still stings." '惠特尼脸上的笑容消失了。你虽然私下说出这番威胁，仍然伤到了对方。'>>
      <<else>>
        <span class='red'><<lanSwitch '"This is not over," Whitney mutters.' '“这事没完。”惠特尼低声说。'>></span>
      <</if>>
      <<lanSwitch 'Whitney steps aside when you return to the entrance, and the students hurry through.' '你们回到入口时，惠特尼让开了，学生们赶紧进校。'>>
    <<else>>
      <<language>>
        <<option 'EN'>>You leave Whitney alone. Whitney notices and stays in the doorway, forcing the next arrivals to squeeze past.
        <<option 'CN'>>你没有处理。惠特尼看出你的态度，继续堵在门口，逼得后来的人侧身挤过去。
      <</language>>
    <</if>>
  <</if>>
  <<set _loveChange to C.npc[_student].love - _loveBefore>>
  <<if _loveChange gt 0>>
    <<glove _student>>
  <</if>>
  <<if _loveChange lt 0>>
    <<llove _student>>
  <</if>>
  <br><<deadwood-reblooms-life-simulation-school-feedback>>
<<else>>
  <span class='blue'><<lanSwitch "Morning duty has already ended today." "今天的晨间值勤已经结束。">></span>
<</if>>
<br><br>
<<entranceicon>><<lanLink ['Return to the front courtyard', '返回前庭'] 'School Front Courtyard'>><</lanLink>>

:: Deadwood Reblooms Life Simulation Dress Proposal []
<<set $outside to 0>>
<<set $location to 'school'>>
<<effects>>
<<npc Leighton>>
<<person1>>
<<set _policies to maplebirch.get("LifeSimulation").school.policies>>
<<set _policy to _policies[_policies.indexOf($LifeSimulation.school.dress.highest) + 1]>>
<<if _policy and maplebirch.get("LifeSimulation").school.canProposePolicy>>
  <<set _requirements to maplebirch.get('LifeSimulation').school.policyRequirements[_policy]>>
  <<language>>
    <<option 'EN'>>
      You bring the next dress proposal, <span class='blue'><<print maplebirch.t('deadwood-reblooms:LifeSimulation:school:policy:' + _policy)>></span>, to Leighton's office.
      <<He>> reads the heading and asks whether the students, staff and school climate can bear the change.
    <<option 'CN'>>
      你把下一项着装提案<span class='blue'>“<<print maplebirch.t('deadwood-reblooms:LifeSimulation:school:policy:' + _policy)>>”</span>带进礼顿的办公室。
      <<He>>扫了一眼标题，问你学生、教职工和眼下的校风是否承受得起这种改变。
  <</language>><br><br>
  <<lanSwitch "Student standing" "学生声望">><<lanSwitch ': ' '：'>><<print _requirements.studentSupport>><br>
  <<lanSwitch "Staff trust" "教职工信任">><<lanSwitch ': ' '：'>><<print _requirements.staffSupport>><br>
  <<lanSwitch "School corruption" "校内堕落">><<lanSwitch ': ' '：'>><<print _requirements.corruption>><br><br>
  <<schoolicon 'building'>><<lanLink ['Present the proposal to Leighton', '向礼顿呈交提案'] 'Deadwood Reblooms Life Simulation Dress Approval'>><<run maplebirch.get("LifeSimulation").school.proposePolicy()>><</lanLink>><br>
<<else>>
  <<if $LifeSimulation.school.role isnot 'president'>>
    <span class='blue'><i><<lanSwitch 'Only the student council president may submit a dress proposal.' '只有学生会长可以提出着装校规。'>></i></span><br>
  <<elseif $LifeSimulation.school.dress.proposal>>
    <span class='blue'><<lanSwitch 'Leighton has not decided on your previous proposal.' '礼顿还没有决定是否批准上一份提案。'>></span><br>
  <<elseif $LifeSimulation.school.dress.trialUntil gt 0>>
    <span class='blue'><<lanSwitch 'The current dress rule is still awaiting its review.' '现行着装校规还在等待复核。'>></span><br>
  <<elseif $LifeSimulation.school.dress.cooldownUntil gt Time.days>>
    <span class='blue'><<lanSwitch 'You must wait before proposing another dress rule.' '还得再等几天，才能提出下一项着装校规。'>></span><br>
  <<else>>
    <span class='blue'><<lanSwitch 'Every dress rule has already been considered.' '所有着装校规都已提出。'>></span><br>
  <</if>>
<</if>>
<<getouticon>><<lanLink "返回校长办公室" "Head's Office">><</lanLink>>

:: Deadwood Reblooms Life Simulation Dress Approval []
<<set $outside to 0>>
<<set $location to 'school'>>
<<effects>>
<<npc Leighton>>
<<person1>>
<<set _policy to $LifeSimulation.school.dress.proposal>>
<<language>>
  <<option 'EN'>>
    You place the proposal for <span class='blue'><<print maplebirch.t('deadwood-reblooms:LifeSimulation:school:policy:' + _policy)>></span> on Leighton's desk.
    "A proposal is not a rule," <<he>> says. "Show me why the school will accept it."
  <<option 'CN'>>
    你把<span class='blue'>“<<print maplebirch.t('deadwood-reblooms:LifeSimulation:school:policy:' + _policy)>>”</span>提案放在礼顿桌上。
    “提案还不是校规。”<<he>>说道，“先证明学校能够接受它。”
<</language>><br><br>
<<if maplebirch.get("LifeSimulation").school.canApprovePolicy('formal')>>
  <<schoolicon 'building'>><<lanLink ['Present staff support', '提交教职工支持意见'] 'Deadwood Reblooms Life Simulation Dress Approval Result'>><<set $phase to 'formal'>><</lanLink>><br>
<</if>>
<<if maplebirch.get("LifeSimulation").school.canApprovePolicy('petition')>>
  <<socialiseicon>><<lanLink ['Present the student petition', '提交学生联署'] 'Deadwood Reblooms Life Simulation Dress Approval Result'>><<set $phase to 'petition'>><</lanLink>><br>
<</if>>
<<if maplebirch.get("LifeSimulation").school.canApprovePolicy('pressure')>>
  <<crimeicon 'coercion'>><<lanLink ['Force Leighton to approve', '迫使礼顿批准'] 'Deadwood Reblooms Life Simulation Dress Approval Result'>><<set $phase to 'pressure'>><</lanLink>><br>
<</if>>
<<if !maplebirch.get("LifeSimulation").school.canApprovePolicy('formal') and !maplebirch.get("LifeSimulation").school.canApprovePolicy('petition') and !maplebirch.get("LifeSimulation").school.canApprovePolicy('pressure')>>
  <span class='blue'><<lanSwitch "You lack the support or leverage needed to make Leighton approve this proposal." "目前没有足够的支持，也没有可以迫使礼顿批准的把柄。">></span><br>
<</if>>
<<getouticon>><<lanLink ['Withdraw the proposal', '撤回提案'] "Head's Office">>
  <<set $LifeSimulation.school.dress.proposal to null>>
<</lanLink>><br>
<<getouticon>><<lanLink "返回校长办公室" "Head's Office">><</lanLink>>

:: Deadwood Reblooms Life Simulation Dress Approval Result []
<<set $outside to 0>>
<<set $location to 'school'>>
<<effects>>
<<npc Leighton>>
<<person1>>
<<if maplebirch.get("LifeSimulation").school.approvePolicy($phase)>>
  <<language>>
    <<option 'EN'>>
      <<if $phase is 'formal'>>
        Leighton reads the supporting statements and signs the page. "Seven days. If it disrupts the school, it ends."
      <<elseif $phase is 'petition'>>
        You lay the students' signatures across the desk. Leighton counts them twice before signing. "Seven days. Their support had better survive the experience."
      <<else>>
        You remind Leighton exactly what you can reveal. <<He>> signs without another objection. "Seven days," <<he>> mutters.
      <</if>>
    <<option 'CN'>>
      <<if $phase is 'formal'>>
        礼顿读完支持意见，在文件末尾签下名字。“试行七天。要是扰乱学校，就立刻终止。”
      <<elseif $phase is 'petition'>>
        你把学生签名铺在桌上。礼顿数了两遍才签字。“试行七天。希望他们亲身经历以后还能继续支持。”
      <<else>>
        你提醒礼顿，自己随时可以公开哪些东西。<<he>>没有再反对，只是一边签字一边低声说道：“试行七天。”
      <</if>>
  <</language>><br><br>
  <span class='green'><<lanSwitch "The new policy begins its trial." "新校规开始试行。">></span>
  <br><<deadwood-reblooms-life-simulation-school-feedback>>
<<else>>
  <span class='blue'><<lanSwitch 'There is no pending dress proposal for Leighton to review.' '目前没有等待礼顿审议的着装提案。'>></span>
<</if>>
<br><br>
<<getouticon>><<lanLink "返回校长办公室" "Head's Office">><</lanLink>>

:: Deadwood Reblooms Life Simulation Dress Review []
<<set $outside to 0>>
<<set $location to 'school'>>
<<effects>>
<<npc Leighton>>
<<person1>>
<<language>>
  <<option 'EN'>>Leighton places the week's reports beside the dress rule. "The trial is over. Does this remain school policy?"
  <<option 'CN'>>礼顿把一周的记录放在校规旁边。“试行结束了。这条规定还要保留吗？”
<</language>><br><br>
<<if maplebirch.get("LifeSimulation").school.canKeepPolicy>>
  <<schoolicon 'building'>><<lanLink ['Make the policy permanent', '正式保留校规'] 'Deadwood Reblooms Life Simulation School Board'>><<run maplebirch.get("LifeSimulation").school.reviewPolicy(true)>><</lanLink>><br>
<<else>>
  <span class='blue'><<lanSwitch "The policy cannot be kept without enough order and support." "秩序或支持度不足，校规无法正式保留。">></span><br>
<</if>>
<<getouticon>><<lanLink ['Revoke the policy', '撤销校规'] 'Deadwood Reblooms Life Simulation School Board'>><<run maplebirch.get("LifeSimulation").school.reviewPolicy(false)>><</lanLink>><br>
<<getouticon>><<lanLink "返回校长办公室" "Head's Office">><</lanLink>>

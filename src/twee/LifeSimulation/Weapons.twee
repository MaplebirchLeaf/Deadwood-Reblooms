:: Deadwood Reblooms Weapons [widget]
<<widget 'deadwood-reblooms-weapon-hit'>>
  <<set _weaponHit to maplebirch.get('LifeSimulation')?.weapons.hit(_args[0])>>
  <<if _weaponHit>>
    <<tentacleadvdisable _weaponHit.target>><<tentacle_record 'damage' _weaponHit.damage>>
    <<defiance 2>><<tiredness 1>><<prof _weaponHit.weapon 0.2>>
    <<set $attackstat += 1>><<set $speechhit to 1>>
    <<language>>
      <<option 'EN'>>
        You strike <<= _weaponHit.target.fullDesc>> with your <<if _weaponHit.weapon is 'whip'>>whip<<else>>baton<</if>>.
      <<option 'CN'>>
        你挥动<<if _weaponHit.weapon is 'whip'>>鞭子<<else>>短棍<</if>>，击中<<= _weaponHit.target.fullDesc>>。
    <</language>>
    <<gtiredness>><<if _weaponHit.weapon is 'whip'>><<gwhip>><<else>><<gbaton>><</if>><br>
  <<else>>
    <span class='blue'><i><<lanSwitch 'You can no longer make that weapon attack.' '你现在无法进行这次武器攻击。'>></i></span><br>
  <</if>>
<</widget>>

:: Deadwood Reblooms Pool Party Sex Widgets [widget]

<<widget 'deadwood-reblooms-pool-party-together'>>
  <<set _pool to maplebirch.get('LifeSimulation').pool_party>>
  <<if _pool.canInteract>>
    <<for _name range _pool.companions>>
      <<if _pool.canTogether(_name) and !_pool.hasScene('with:' + _name)>>
        <<set _cn to { Robin: '和罗宾找个灯光照不到的角落', Whitney: '和惠特尼一起下水', Kylar: '把凯拉尔带去远离人群的地方', Sydney: '和悉尼避开人群' }[_name]>>
        <<set _en to { Robin: 'Find a corner the light does not reach with Robin', Whitney: 'Get in the water with Whitney', Kylar: 'Take Kylar somewhere far from the crowd', Sydney: 'Slip away from the crowd with Sydney' }[_name]>>
        <<capture _name>><<lanLink [_en, _cn] 'Deadwood Reblooms Pool Party Together'>><<set $LifeSimulation.pool_party.selected to _name>><<pass 20>><</lanLink>><</capture>><br>
      <</if>>
    <</for>>
    <<if _pool.vowReady and !_pool.hasScene('with:Robin:Sydney')>>
      <<lanLink ['Take Robin and Sydney somewhere private', '带罗宾和悉尼去没人的地方'] 'Deadwood Reblooms Pool Party Vow'>><<pass 20>><</lanLink>><br>
    <</if>>
    <<for _mate range _pool.kylarPartners>>
      <<if !_pool.hasScene('with:Kylar:' + _mate)>>
        <<set _cn to '要凯拉尔和' + maplebirch.auto(_mate) + '一起'>>
        <<set _en to 'Have Kylar join you and ' + _mate>>
        <<capture _mate>>
          <<lanLink [_en, _cn] 'Deadwood Reblooms Pool Party Kylar Group'>><<set $LifeSimulation.pool_party.selected to _mate>><<pass 20>><</lanLink>><br>
        <</capture>>
      <</if>>
    <</for>>
    <<if _pool.groupAllowed and !_pool.hasScene('with:Whitney:group')>>
      <<lanLink ['Stay in the pool with Whitney and the others', '留在泳池里，和惠特尼还有那些人一起'] 'Deadwood Reblooms Pool Party Group'>><<pass 20>><</lanLink>><br>
    <</if>>
  <</if>>
<</widget>>

<<widget 'deadwood-reblooms-pool-party-sex-loop'>>
  <<set _loop to _args[0]>>
  <<effects>><<effectsman>><<man>><<stateman>>
  <br><br>
  <<actionsman>>
  <<if _combatend>>
    <<endcombat>>
    <span id='next'><<lanLink ['Next', '继续'] 'School Pool'>><</lanLink>></span><<nexttext>>
  <<else>>
    <span id='next'><<lanLink ['Next', '继续'] _loop>><</lanLink>></span><<nexttext>>
  <</if>>
  <br>
<</widget>>

<<widget 'deadwood-reblooms-pool-party-witness'>>
  <<set _pool to maplebirch.get('LifeSimulation').pool_party>>
  <<set _scene to _args[0]>>
  <<set _loop to _args[1]>>
  <<set _except to _args.slice(2)>>
  <<set _key to 'jealous:' + _scene + ':' + _except.join(',')>>
  <<if _pool.once(_key)>>
    <<set _witnesses to _pool.bystanders(_except)>>
    <<if _witnesses.includes('Kylar')>>
      <span class='blue'><i>
      <<if _scene is 'group'>>
        <<lanSwitch 'Kylar watches from the edge of the pool.' '凯拉尔站在池边，盯着你。'>>
      <<else>>
        <<lanSwitch 'Kylar watches you leave with someone else.' '凯拉尔盯着你和别人一起离开。'>>
      <</if>>
      </i></span><br><br>
    <</if>>
    <<run _pool.jealous(_witnesses)>>
  <</if>>
  <<deadwood-reblooms-pool-party-sex-loop _loop>>
<</widget>>

:: Deadwood Reblooms Pool Party Together []
<<set $outside to 0>><<set $location to 'pool'>><<schooleffects>><<effects>>
<<set _pool to maplebirch.get('LifeSimulation').pool_party>>
<<set _name to $LifeSimulation.pool_party.selected>>
<<if !_name or !_pool.canTogether(_name)>>
  <span class='blue'><i><<lanSwitch 'There is no one here with you.' '这里没有人和你在一起。'>></i></span>
<<elseif !_pool.once('with:' + _name)>>
  <span class='blue'><i><<lanSwitch 'You have already spent time together tonight.' '今晚已经一起待过了。'>></i></span>
<<else>>
  <<run statusCheck(_name)>>
  <<set $pronoun to C.npc[_name].pronoun>>
  <<switch _name>>
    <<case 'Robin'>>
      <<language>>
        <<option 'EN'>>
          You find a corner the pool light does not quite reach. Robin follows without being asked, and only stops when your back meets the tiles. "Here?" Robin asks. "Wouldn't you rather find somewhere quieter?"
          <br><br>
          <<if C.npc.Robin.trauma gte 40>>
            Robin glances back at the pool, then takes your hand. "Stay close, okay? I don't want to be left on my own here."
          <<else>>
            Robin's hand finds yours under the water, and the grip is steadier than the voice. "...I want this. I want you."
          <</if>>
          <br><br>
          <span class='lewd'>The water carries the heat off your skin and puts Robin's mouth at your collarbone without either of you deciding it. When you hook a leg around <<his>> and pull, <<he>> lets out a startled, swallowed sound against your throat and presses <<his>> hips forward until you can feel <<him>> pressed hard and twitching through the wet fabric. "Out here," <<he>> whispers, half a protest, and then <<he>> is the one pushing you flat against the tiles.</span>
        <<option 'CN'>>
          你找到一个灯光照不到的角落。罗宾没等你开口就跟了上来，一直到你后背抵住瓷砖才停下。“在这里？”<<he>>问，“你不想再找个安静点的地方吗？”
          <br><br>
          <<if C.npc.Robin.trauma gte 40>>
            罗宾回头看了一眼泳池，拉住你的手。“靠近一点，好吗？我不想一个人待在这里。”
          <<else>>
            罗宾的手在水下找到你的手，握得比声音稳。“……我想要这个。我想要你。”
          <</if>>
          <br><br>
          <span class='lewd'>水把皮肤上的热带走，也把罗宾的嘴送到你的锁骨上，谁都没来得及决定。你一条腿勾住<<him>>往回一拉，<<he>>喉咙里挤出一声被自己咽下去的轻响，胯往前顶上来，隔着湿透的布料，你能摸到<<he>>早就硬得发颤。“在、在外面……”<<he>>小声说了半句，像要拦你，随即却是<<he>>自己把你按在了瓷砖上。</span>
      <</language>>
      <br><br>
      <<if C.npc.Robin.trauma gte 40>>
        <<npcincr Robin trauma 1>><<npcincr Robin love 1>>
      <<else>>
        <<npcincr Robin love 2>>
      <</if>>
    <<case 'Whitney'>>
      <<language>>
        <<option 'EN'>>
          Whitney is already waist-deep and waiting. "Took you long enough." Whitney takes you by the wrist and pulls. "You're mine tonight. Everybody here already knows it."
          <br><br>
          "Kneel," <<he>> says, right there in the water, loud enough for the nearest students to hear. When you hesitate, <<he>> fists a hand in your hair and pushes you down until the surface laps at your chin. "Slut," <<he>> says, sounding pleased about it. "Open your mouth and hold your breath."
        <<option 'CN'>>
          惠特尼已经站在齐腰深的水里等着。“磨蹭够了？”<<he>>拽着你的手腕把你拉下来。“今晚你是我的。这里每个人都知道。”
          <br><br>
          “跪下。”<<he>>就在水里说，声音大到近处的学生都能听见。你一犹豫，<<he>>一把攥住你的头发把你往下按，按到下巴都泡进水里。“骚货。”<<he>>说，语气里全是满意。“把嘴张开，憋住气。”
      <</language>>
      <br><br>
      <<npcincr Whitney dom 1>><<npcincr Whitney lust 2>>
    <<case 'Kylar'>>
      <<language>>
        <<option 'EN'>>
          You lead Kylar far enough from the pool that the noise thins. Kylar says nothing until you stop, then takes your face in both hands and turns it so you cannot look anywhere else. "Better," Kylar says. "Now I can't see them either."
        <<option 'CN'>>
          你把凯拉尔领到离泳池足够远的地方，喧闹稀薄下来。<<he>>一直没说话，直到你停下，然后用双手捧住你的脸，让你没法看向别处。“这样好多了，”<<he>>说，“现在我也看不见他们了。”
      <</language>>
      <br><br>
      <<npcincr Kylar love 2>>
      <<npcincr Kylar rage -2>><<lksuspicion>>
    <<case 'Sydney'>>
      <<language>>
        <<option 'EN'>>
          Sydney takes your hand first and leads, then stops at the edge of the light. "If we are going to do this, we are going to do it properly," <<he>> says, and presses your palm flat against the clasp at <<his>> waist. "That thing has to come off first. You undo it, or I will."
          <<if _sydneyChastity and C.npc.Sydney.chastity.anus.includes('shield')>>
            A second clasp sits lower still, and <<he>> does not pretend it is not there. "…And that one stays on. Everything but that."
          <<elseif _sydneyChastity>>
            <<He>> does not look away while <<his>> own hands shake.
          <</if>>
        <<option 'CN'>>
          悉尼先牵起你的手，由<<he>>带路，走到灯光外侧便停下。“既然要做，就好好做。”<<he>>说，随即把你的掌心按在<<his>>腰侧的锁扣上。“这东西今晚得先解下来。你来解，还是我自己来？”
          <<if _sydneyChastity and C.npc.Sydney.chastity.anus.includes('shield')>>
            更下面还有一枚扣子，<<he>>也没打算装作没有。“……那一个留着。别的都可以，就它不行。”
          <<elseif _sydneyChastity>>
            <<He>>说这话时没有低头，只有按着你的那只手在抖。
          <</if>>
      <</language>>
      <br><br>
      <<npcincr Sydney purity -5>><<lspurity>>
  <</switch>>
  <br><br>
  <<clearnpc>><<npc _name -1>><<person1>>
  <<consensual>><<set $consensual to 1>><<neutral 1>>
  <<set $enemyno to 1>><<set $enemynomax to 1>><<maninit>><<npcexpose>>
  <<set $enemytrust += 800>><<set $enemyarousalmax to 600>>
  <<deadwood-reblooms-pool-party-witness together 'Deadwood Reblooms Pool Party Together Sex' _name>>
<</if>>
<br><br>
<<if !$combat>>
  <<getouticon>><<lanLink ['Back to the pool', '回到泳池'] 'School Pool'>><<set $LifeSimulation.pool_party.selected to null>><</lanLink>>
<</if>>


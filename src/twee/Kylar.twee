:: Deadwood Reblooms Kylar Expansion Widgets [widget]

<!-- 原版首次借宿会被凯拉尔的父母带走。只有经历过该事件，才出现常规留宿入口。 -->
<<widget 'deadwood-reblooms-kylar-bedroom-links'>>
  <<if $kylar_sleep_abduction is 1 and $KylarExpansion>>
    <<set _kylarAtManor to maplebirch.get('Kylar').atManor>>
    <<if !$KylarExpansion.stay_invited and isLoveInterest('Kylar') and _kylarAtManor>>
      <<language>>
        <<option 'EN'>><<socialiseicon 'ask'>><<link 'Ask Kylar if you can stay again' 'Deadwood Reblooms Kylar Stay Invitation'>><</link>>
        <<option 'CN'>><<socialiseicon 'ask'>><<link '问凯拉尔以后能否留宿' 'Deadwood Reblooms Kylar Stay Invitation'>><</link>>
      <</language>><br><br>
    <<elseif $KylarExpansion.stay_invited>>
      <<language>>
        <<option 'EN'>>A space beside Kylar's bed has been cleared for your things. Kylar left a folded blanket there.
        <<option 'CN'>>凯拉尔在床边为你的东西腾出了地方，还放了一条叠好的毯子。
      <</language>><br><br>
      <<if !isLoveInterest('Kylar')>>
        <span class='red'><<lanSwitch "You leave Kylar's bed as it is." '你没有动凯拉尔的床铺。'>></span><br>
      <<elseif !($earSlime.event and $earSlime.noSleep)>>
        <<language>>
          <<option 'EN'>>
            <<bedicon 'kylar'>><<link 'Strip and get in bed' 'Deadwood Reblooms Kylar Bed'>><<undressSleep 'kylar manor bed'>><</link>>
          <<option 'CN'>>
            <<bedicon 'kylar'>><<link '脱衣上床' 'Deadwood Reblooms Kylar Bed'>><<undressSleep 'kylar manor bed'>><</link>>
        <</language>><br>
        <<run maplebirch.get('Kylar').openWardrobe()>>
        <<set $storeLocation to 'kylar manor bed'>>
        <<wardrobeSelection true>>
        <<if !$earSlime.alwaysSleepNaked or $hypnosis_traits.silence>>
          <<for _index, _outfit range $outfit>>
            <<if _outfit.type.includes('sleep')>>
              <<capture _index _outfit>>
                <<bedicon 'kylar'>>
                <<set _outfitname to _outfit.name + (_outfit.colors is false ? '' : ' [C]')>>
                <<lanLink `['Wear ' + _outfitname + " and climb into Kylar's bed", '穿上' + _outfitname + '并钻进凯拉尔的被窝']` 'Deadwood Reblooms Kylar Bed'>><<set $wear_outfit to _index>><<saveTempHairStyle>><</lanLink>><br>
              <</capture>>
            <</if>>
          <</for>>
        <</if>>
      <<else>>
        <span class='red'><<lanSwitch 'The slime will not let you sleep yet.' '史莱姆现在不让你睡觉。'>></span><br>
      <</if>>
      <<language>>
        <<option 'EN'>><<wardrobeicon>><<link 'Your clothes' 'Deadwood Reblooms Kylar Wardrobe'>><</link>>
        <<option 'CN'>><<wardrobeicon>><<link '你的衣物' 'Deadwood Reblooms Kylar Wardrobe'>><</link>>
      <</language>><br>
      <<language>>
        <<option 'EN'>><<mirroricon>><<link 'Mirror' 'Deadwood Reblooms Kylar Mirror'>><<preMirror>><</link>>
        <<option 'CN'>><<mirroricon>><<link '镜子' 'Deadwood Reblooms Kylar Mirror'>><<preMirror>><</link>>
      <</language>><br>
      <<if _kylarAtManor and !pcAreArmsBound('both') and $KylarExpansion.game_day isnot Time.days>>
        <<language>>
          <<option 'EN'>><<techicon 'monitors'>><<link 'Play a game with Kylar (0:20)' 'Deadwood Reblooms Kylar Game'>><</link>>
          <<option 'CN'>><<techicon 'monitors'>><<link '和凯拉尔玩游戏 (0:20)' 'Deadwood Reblooms Kylar Game'>><</link>>
        <</language>><br>
      <</if>>
      <<if _kylarAtManor and isLoveInterest('Kylar') and $KylarExpansion.notes_day isnot Time.days>>
        <<schoolicon 'library'>><<lanLink ["Sort through Kylar's notes (0:20)", '陪凯拉尔整理笔记 (0:20)'] 'Deadwood Reblooms Kylar Notes'>><</lanLink>><br>
      <</if>>
      <<roomoptions>>
      <<safehouseEvents>>
      <<if playerHasSexToys()>>
        <<language>>
          <<option 'EN'>><<sextoysicon>><<link 'Sex toys' 'Sextoys Inventory'>><<set $sextoyInvReturnLink to 'Manor Kylar Room'>><</link>>
          <<option 'CN'>><<sextoysicon>><<link '性玩具' 'Sextoys Inventory'>><<set $sextoyInvReturnLink to 'Manor Kylar Room'>><</link>>
        <</language>><br>
      <</if>>
      <br>
    <</if>>
  <</if>>
<</widget>>


<!-- 起床后去公园或街机厅前的花园空档，不覆盖学校日程。 -->
<<widget 'deadwood-reblooms-kylar-yard-link'>>
  <<if maplebirch.get('Kylar').canGarden and $exposed lte 0 and !pcAreArmsBound('both')
    and $KylarExpansion.yard_day isnot Time.days>>
    <<socialiseicon>><<lanLink ['Find Kylar in the garden (0:20)', '到花园找凯拉尔 (0:20)'] 'Deadwood Reblooms Kylar Yard'>><</lanLink>><br><br>
  <</if>>
<</widget>>
<<widget 'deadwood-reblooms-kylar-kitchen-link'>>
  <<if $KylarExpansion?.stay_invited and !pcAreArmsBound('both') and $KylarExpansion.tea_day isnot Time.days>>
    <<language>>
      <<option 'EN'>><<kitchenicon 'stove'>><<link 'Make tea (0:10)' 'Deadwood Reblooms Kylar Kitchen Tea'>><</link>>
      <<option 'CN'>><<kitchenicon 'stove'>><<link '泡一杯茶 (0:10)' 'Deadwood Reblooms Kylar Kitchen Tea'>><</link>>
    <</language>><br><br>
  <</if>>
<</widget>>

<<widget 'deadwood-reblooms-kylar-wardrobe-exit'>>
  <<language>>
    <<option 'EN'>><<link 'Close the wardrobe' 'Manor Kylar Room'>><<cleanupOnWardrobeExit>><</link>>
    <<option 'CN'>><<link '关上衣柜' 'Manor Kylar Room'>><<cleanupOnWardrobeExit>><</link>>
  <</language>>
<</widget>>

:: Deadwood Reblooms Kylar Stay Invitation []
<<set $outside to 0>><<location 'kylarmanor'>><<effects>>
<<set _kylarAtManor to maplebirch.get('Kylar').atManor>>
<<if $kylar_sleep_abduction isnot 1 or !isLoveInterest('Kylar') or !_kylarAtManor>>
  <<lanSwitch 'Kylar is not in the room. You can ask another time.' '凯拉尔不在房间里。你可以改天再问。'>>
<<elseif $KylarExpansion.stay_invited>>
  <<lanSwitch 'Kylar has already made room for you.' '凯拉尔已经为你腾出地方了。'>>
<<else>>
  <<npc Kylar>><<person1>>
  <<language>>
    <<option 'EN'>>
      You glance at the bed. Kylar follows your gaze and stops turning in <<his>> chair.
      <br><br>
      "After what happened last time?" <<He>> looks toward the door. "I thought you wouldn't want to come back."
      <br><br>
      You tell <<him>> you would like to stay. Kylar clears a space beside the bed for your clothes, then folds a blanket over the foot of it.
      <span class='teal'>"You can—"</span> Kylar stops, starts over. <span class='teal'>"Whenever you want. That is, if you want to come back at all."</span> <<He>> pulls the blanket straighter than it needs to be. "If anything scares you, wake me. I do not mind being woken."
    <<option 'CN'>>
      你看了眼床。凯拉尔顺着你的目光望过去，转椅慢慢停下。
      <br><br>
      “上次都那样了，你还想留下？”<<He>>朝门口看了一眼，“我还以为你不会再来了。”
      <br><br>
      你告诉<<him>>，今晚仍想在这里过夜。凯拉尔在床边腾出放衣服的地方，又把一条毯子叠在床尾。
      <span class='teal'>“你想来——”</span>凯拉尔话说一半又停住，重新开口，<span class='teal'>“你想来就来。我是说，如果你还愿意回来的话。”</span><<He>>把那条毯子抻得比需要的还平。“要是害怕，就叫醒我。我不介意被叫醒。”
  <</language>>
  <<set $KylarExpansion.stay_invited to true>>
  <<npcincr Kylar love 1>><<glove>>
<</if>>
<br><br>
<<language>>
  <<option 'EN'>><<getouticon>><<link "Return to Kylar's room" 'Manor Kylar Room'>><</link>>
  <<option 'CN'>><<getouticon>><<link '返回凯拉尔的房间' 'Manor Kylar Room'>><</link>>
<</language>>

:: Deadwood Reblooms Kylar Wardrobe [exitCheckBypass]
<<set $outside to 0>><<location 'kylarmanor'>><<effects>>
<<if !$KylarExpansion.stay_invited>>
  <<lanSwitch 'You leave Kylar’s things where they are.' '你没有动凯拉尔的东西。'>><br><br>
  <<language>>
    <<option 'EN'>><<link "Return to Kylar's room" 'Manor Kylar Room'>><</link>>
    <<option 'CN'>><<link '返回凯拉尔的房间' 'Manor Kylar Room'>><</link>>
  <</language>>
<<else>>
  <<run maplebirch.get('Kylar').openWardrobe()>>
  <<lanSwitch 'You look through the space Kylar cleared for your clothes.' '你查看凯拉尔为你腾出的衣物存放处。'>><br><br>
  <<wardrobeSelection>>
  <div id='wardrobewear'><<wardrobewear>></div>
  <div id='wardrobeExits'><<wardrobeExits>></div>
  <<wardrobe>>
<</if>>

:: Deadwood Reblooms Kylar Mirror []
<<set $outside to 0>><<location 'kylarmanor'>><<effects>>
<<if !$KylarExpansion.stay_invited>>
  <<lanSwitch 'You step away from the mirror.' '你从镜子前退开。'>><br><br>
  <<language>>
    <<option 'EN'>><<link "Return to Kylar's room" 'Manor Kylar Room'>><</link>>
    <<option 'CN'>><<link '返回凯拉尔的房间' 'Manor Kylar Room'>><</link>>
  <</language>>
<<else>>
  <<if maplebirch.get('VanillaPlus')>><<run maplebirch.get("VanillaPlus").deviancy.discover('kylar')>><</if>>
  <<language>>
    <<option 'EN'>><<getouticon>><<link 'Step away' 'Manor Kylar Room'>><<unset $mirrorMenu>><<unset $bodywritingSet>><<postMirror>><</link>>
    <<option 'CN'>><<getouticon>><<link '走开' 'Manor Kylar Room'>><<unset $mirrorMenu>><<unset $bodywritingSet>><<postMirror>><</link>>
  <</language>><br>
  <<if maplebirch.get('VanillaPlus')>><<deadwood-reblooms-deviancy-mirror-enter-link 'kylar'>><</if>>
  <<mirror>><br><br>
<</if>>

:: Deadwood Reblooms Kylar Kitchen Tea []
<<set $outside to 0>><<location 'kylarmanor'>><<effects>>
<<if !$KylarExpansion.stay_invited or $KylarExpansion.tea_day is Time.days or pcAreArmsBound('both')>>
  <<lanSwitch 'You cannot make tea here right now.' '现在无法在这里泡茶。'>>
<<else>>
  <<set _kylarTeaTogether to maplebirch.get('Kylar').atManor>>
  <<pass 10>><<set $KylarExpansion.tea_day to Time.days>>
  <<if _kylarTeaTogether>>
    <<npc Kylar>><<person1>>
  <</if>>
  <<language>>
    <<option 'EN'>>
      You rinse two cups and put the kettle on. The kitchen still smells faintly of chemicals, but the tea is warm in your hands.
      <<if _kylarTeaTogether>>
        <br><br>
        Kylar peers in from the hall. You offer <<him>> the second cup. <<He>> takes it carefully and stays beside you while it cools.
      <</if>>
    <<option 'CN'>>
      你洗净两只杯子，烧开一壶水。厨房里仍有淡淡的化学气味，手里的茶却是热的。
      <<if _kylarTeaTogether>>
        <br><br>
        凯拉尔从门厅探头。你把另一只杯子递给<<him>>。<<He>>小心接过，留在你身边等茶稍凉。
      <</if>>
  <</language>>
  <<stress -2>><<lstress>>
<</if>>
<br><br>
<<language>>
  <<option 'EN'>><<kitchenicon 'stove'>><<link 'Return to the kitchen' 'Manor Kitchen'>><</link>>
  <<option 'CN'>><<kitchenicon 'stove'>><<link '返回厨房' 'Manor Kitchen'>><</link>>
<</language>>

:: Deadwood Reblooms Kylar Bed []
<<set $outside to 0>><<set $bus to 'kylarmanor'>><<location 'kylarmanor'>><<effects>><<wearoutfit>>
<<set _kylarAtManor to maplebirch.get('Kylar').atManor>>
<<if !$KylarExpansion.stay_invited or !isLoveInterest('Kylar')>>
  <<lanSwitch 'You pull back the sheets and step away.' '你掀开被子，从床边退开。'>><br><br>
<<else>>
  <<if _kylarAtManor>><<npc Kylar>><<person1>><</if>>
  <<language>>
    <<option 'EN'>>
      You climb into the bed beneath the skylights. The sheets smell of soap and the faint warmth of Kylar's computer.
      <br><br>
      <<if _kylarAtManor>>
        Kylar turns off a monitor and slips in beside you, careful not to jar the mattress. <<His>> arm hovers at your waist for a long moment before <<he>> lets it settle there, and <<he>> keeps still after that, as though moving might end it.
      <<else>>
        The other side of the bed is empty. You draw the blanket up while the monitors hum softly across the room.
      <</if>>
    <<option 'CN'>>
      你钻进天窗下的床。被单带着皂香，屋里还留着电脑运转的微热。
      <br><br>
      <<if _kylarAtManor>>
        凯拉尔关掉一台显示器，钻到你身边，动作轻得不敢让床垫晃一下。<<His>>手臂在你的腰侧悬了很久，才敢落下，之后便一动不动，仿佛一动这一切就会结束。
      <<else>>
        床的另一侧空着。你拉好被子，听见房间另一头的显示器轻轻嗡响。
      <</if>>
  <</language>>
  <br><br>
  <<nightmareCheck 'Deadwood Reblooms Kylar Sleep'>>
  <<generateSleepLinks 'Deadwood Reblooms Kylar Sleep'>>
<</if>>
<<language>>
  <<option 'EN'>><<bedicon 'kylar'>><<link 'Get up' 'Manor Kylar Room'>><<run maplebirch.get('Kylar').openWardrobe()>><<storeon 'kylar manor bed'>><<loadTempHairStyle>><</link>>
  <<option 'CN'>><<bedicon 'kylar'>><<link '起床' 'Manor Kylar Room'>><<run maplebirch.get('Kylar').openWardrobe()>><<storeon 'kylar manor bed'>><<loadTempHairStyle>><</link>>
<</language>>

:: Deadwood Reblooms Kylar Sleep []
<<set $outside to 0>><<location 'kylarmanor'>>
<<set _requestedHours to $sleephour>>
<<set _kylarAtManor to maplebirch.get('Kylar').atManor>>
<<set _nightWake to _kylarAtManor and _requestedHours gte 3
  and (Time.hour gte 22 or Time.hour lt 3)
  and $KylarExpansion.night_day isnot Time.days
  and $nightmares lte 0 and random(1, 8) is 1>>
<<if _nightWake>>
  <<set _nightScene to Weather.meteorShower ? 'meteor'
    : Weather.precipitation is 'rain' ? 'rain'
    : random(1, 2) is 1 ? 'monitor' : 'wrist'>>
  <<set $sleephour to random(1, Math.min(2, _requestedHours - 1))>>
<</if>>
<<set $bedGuest to _kylarAtManor ? 'Kylar' : ''>>
<<set _autosavehere to true>><<sleep>>
<<if !_dreaming>>
  <<effects>><<wakingEffects $sleepHoursTotal>>
  <<set _nightWake to _nightWake and C.npc.Kylar.state is 'active'
    and (Time.hour gte 18 or getKylarLocation().area is 'manor_bedroom')
    and (!maplebirch.get('VanillaPlus') or !maplebirch.get("VanillaPlus").realEstate.residenceOf('Kylar'))
    and !_wakingEffect and $sleepHoursTotal gte 1
    and (Time.hour gte 23 or Time.hour lt 6)>>
  <<if _nightWake>>
    <<set $KylarExpansion.night_day to Time.days>>
    <<set $KylarExpansion.night_scene to _nightScene>>
    <<set $sleephour to Math.max(1, _requestedHours - $sleepHoursTotal)>>
    <<sleepeffects>>
    <<switch $KylarExpansion.night_scene>>
      <<case 'meteor'>>
        <<lanSwitch 'A streak of light crosses the skylights. You wake to find Kylar watching the sky.' '一道亮光划过天窗。你醒来时，凯拉尔正望着夜空。'>>
      <<case 'rain'>>
        <<lanSwitch 'Rain rattles against the skylights. Kylar shifts beside you, and you wake before dawn.' '雨点敲打着天窗。凯拉尔在你身边动了动，你在黎明前醒来。'>>
      <<case 'monitor'>>
        <<lanSwitch 'Blue light moves across the ceiling. One of Kylar’s monitors is still on.' '蓝光在天花板上晃动。凯拉尔的一台显示器还亮着。'>>
      <<default>>
        <<lanSwitch 'Something touches your wrist beneath the blanket. You wake before dawn.' '被子里有什么碰了碰你的手腕。你在黎明前醒来。'>>
    <</switch>>
    <br><br>
    <<language>>
      <<option 'EN'>><<bedicon 'kylar'>><<link 'Open your eyes' 'Deadwood Reblooms Kylar Night Wake'>><</link>>
      <<option 'CN'>><<bedicon 'kylar'>><<link '睁开眼' 'Deadwood Reblooms Kylar Night Wake'>><</link>>
    <</language>>
  <<else>>
    <<if $nightmares gte 1 and $controlled is 0>>
      <<nightmareWake>>
    <<elseif !_wakingEffect>>
      <<language>>
        <<option 'EN'>>
          You wake in Kylar's bed. <<if Time.dayState is 'night'>>The monitors paint the ceiling blue.<<else>>Daylight falls through the skylights.<</if>>
          <br><br>
          <<if C.npc.Kylar.state is 'active' and (Time.hour gte 18 or getKylarLocation().area is 'manor_bedroom')
            and (!maplebirch.get('VanillaPlus') or !maplebirch.get("VanillaPlus").realEstate.residenceOf('Kylar'))>>Kylar is still beside you, watching to make sure you are awake.<<else>>Kylar has left the blanket tucked around you.<</if>>
        <<option 'CN'>>
          你在凯拉尔的床上醒来。<<if Time.dayState is 'night'>>显示器的蓝光映在天花板上。<<else>>日光从天窗洒进来。<</if>>
          <br><br>
          <<if C.npc.Kylar.state is 'active' and (Time.hour gte 18 or getKylarLocation().area is 'manor_bedroom')
            and (!maplebirch.get('VanillaPlus') or !maplebirch.get("VanillaPlus").realEstate.residenceOf('Kylar'))>>凯拉尔还在身边，见你睁眼才放下心。<<else>>凯拉尔离开前替你掖好了被角。<</if>>
      <</language>><br><br>
    <</if>>
    <<sleepeffects>>
    <<language>>
      <<option 'EN'>><<bedicon 'kylar'>><<link 'Get up' 'Manor Kylar Room'>><<run maplebirch.get('Kylar').openWardrobe()>><<storeon 'kylar manor bed'>><<loadTempHairStyle>><</link>>
      <<option 'CN'>><<bedicon 'kylar'>><<link '起床' 'Manor Kylar Room'>><<run maplebirch.get('Kylar').openWardrobe()>><<storeon 'kylar manor bed'>><<loadTempHairStyle>><</link>>
    <</language>>
  <</if>>
  <<set $phase to 0>>
<</if>>

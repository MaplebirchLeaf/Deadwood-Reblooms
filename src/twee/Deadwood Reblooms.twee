:: Deadwood Reblooms Widgets [widget]

<!-- 模组设置 -->
<<widget 'Deadwood-Reblooms-Options'>>
  <details open>
    <summary class='settingsHeader options'><span class='gold'><<lanSwitch 'Deadwood Reblooms' '枯木逢春'>></span></summary>
    <div class='settingsGrid'>
      <div class='settingsToggleItem'>
        <span class='gold'><<lanSwitch 'Sidebar Control Position Selection' '侧边栏控件位置选择'>></span>
        <<lanListbox '$options.maplebirch.modhint' autoselect>>
          <<option 'disable' 'disable'>>
          <<option 'desktop client' 'desktop'>>
          <<option 'mobile client' 'mobile'>>
        <</lanListbox>>
        <span
          class='tooltip-anchor linkBlue'
          tooltip="<span class='teal'><<lanSwitch 'Update next time the interface is opened' '在下次打开界面时更新'>></span>"
        >(?)</span>
      </div>
      <div class='settingsToggleItem'>
        <label><<checkbox '$options.maplebirch.bodywriting' false true autocheck>><<lanSwitch 'Custom Bodywriting' '定制涂鸦'>></label>
        <span
          class='tooltip-anchor linkBlue'
          tooltip="<span class='teal'><<lanSwitch 'Customized bodywriting can be created at the mirror after activation.' '启用后在镜子处可定制涂鸦。'>></span>"
        >(?)</span>
      </div>
      <div class='settingsToggleItem'>
        <label><<checkbox '$options.maplebirch.baileyRent' false true autocheck>><<lanSwitch 'Bailey Rent Accumulation' '贝利租金累积'>></label>
        <span
          class='tooltip-anchor linkBlue'
          tooltip="<span class='teal'><<lanSwitch
            'Unpaid rent from each week is added to the next amount due.'
            '每周未缴的租金会加入下一次应付金额。'
          >></span>"
        >(?)</span>
      </div>
      <div class='settingsToggleItem'>
        <label
          ><<checkbox '$options.maplebirch.hideEarSlimeParasites' false true autocheck>><<lanSwitch
            'Hide Ear Slime Parasites'
            '隐藏耳史寄生物'
          >></label
        >
        <span
          class='tooltip-anchor linkBlue'
          tooltip="<span class='teal'><<lanSwitch
            'Hides the parasites formed by ear slime from the player model. Their traits and effects remain active.'
            '在玩家模型中隐藏耳中史莱姆生成的寄生物。其特质与效果保持不变。'
          >></span>"
        >(?)</span>
      </div>
    </div>
  </details><hr>
<</widget>>

<!-- 模组作弊：由框架 Cheats zone 调用，只修改枯木逢春自己的进度与金融数据。 -->
<<widget 'deadwood-reblooms-cheats'>>
  <details open>
    <summary class='settingsHeader options'><span class='gold'><<lanSwitch 'Deadwood Reblooms cheats' '枯木逢春作弊'>></span></summary>
    <div id='deadwood-reblooms-cheats-content'>
      <<deadwood-reblooms-cheats-content>>
    </div>
  </details>
<</widget>>

<!-- 作弊面板刷新：每次操作后重绘状态，避免关闭并重新打开菜单。 -->
<<widget 'deadwood-reblooms-cheats-refresh'>>
  <<replace '#deadwood-reblooms-cheats-content'>><<deadwood-reblooms-cheats-content>><</replace>>
<</widget>>

<!-- 六属性作弊卡：分别显示数值、突破条件和特质，并提供可重复的测试操作。 -->
<<widget 'deadwood-reblooms-attribute-cheat'>>
  <<set _attribute to _args[0]>>
  <<switch _attribute>>
    <<case 'willpower'>><<set _attributeName to lanSwitch('Willpower', '意志')>>
    <<case 'physique'>><<set _attributeName to lanSwitch('Physique', '体格')>>
    <<case 'beauty'>><<set _attributeName to lanSwitch('Beauty', '容貌')>>
    <<case 'exhibitionism'>><<set _attributeName to lanSwitch('Exhibitionism', '暴露癖')>>
    <<case 'deviancy'>><<set _attributeName to lanSwitch('Deviancy', '异种癖')>>
    <<case 'promiscuity'>><<set _attributeName to lanSwitch('Promiscuity', '淫乱')>>
  <</switch>>
  <<set _attributeUnlocked to $VanillaPlus.lock[_attribute]>>
  <<set _attributeReady to maplebirch.VP[_attribute].unlock>>
  <<set _attributeTrait to $VanillaPlus.traits[_attribute]>>
  <div class='settingsToggleItem'>
    <span @class='["exhibitionism", "deviancy", "promiscuity"].includes(_attribute) ? "lustful" : "gold"'><strong><<= _attributeName>></strong></span><br>
    <<lanSwitch 'Value' '数值'>>：<<= State.variables[_attribute]>> / <<= maplebirch.VP.ceiling(_attribute)>><br>
    <<lanSwitch 'Breakthrough' '突破'>>：
    <<if _attributeUnlocked>>
      <span class='green'><<lanSwitch 'Complete' '已完成'>></span>
    <<elseif _attributeReady>>
      <span class='gold'><<lanSwitch 'Ready' '可触发'>></span>
    <<else>>
      <span class='red'><<lanSwitch 'Requirements incomplete' '条件未完成'>></span>
    <</if>><br>
    <<lanSwitch 'Trait' '特质'>>：
    <<if _attributeTrait>>
      <span class='green'><<lanSwitch 'Granted' '已获得'>></span>
    <<else>>
      <span class='red'><<lanSwitch 'Not granted' '未获得'>></span>
    <</if>><br><br>
    <<capture _attribute>>
      <<lanLink 'Prepare breakthrough'>>
        <<run maplebirch.VP.prepare(_attribute)>>
        <<deadwood-reblooms-cheats-refresh>>
      <</lanLink>><br>
      <<lanLink 'Complete and maximise'>>
        <<run maplebirch.VP.complete(_attribute)>>
        <<deadwood-reblooms-cheats-refresh>>
      <</lanLink>><br>
      <<if _attributeTrait>>
        <<lanLink 'Remove trait'>>
          <<run maplebirch.VP.setTrait(_attribute, false)>>
          <<deadwood-reblooms-cheats-refresh>>
        <</lanLink>>
      <<else>>
        <<lanLink 'Grant trait'>>
          <<run maplebirch.VP.setTrait(_attribute, true)>>
          <<deadwood-reblooms-cheats-refresh>>
        <</lanLink>>
      <</if>><br>
    <</capture>>
  </div>
<</widget>>

<!-- 模组作弊内容：操作完成后局部刷新，便于立即核对当前状态。 -->
<<widget 'deadwood-reblooms-cheats-content'>>
  <<if !$VanillaPlus>>
    <span class='red'><<lanSwitch 'Vanilla Plus is disabled for this save.' '当前存档未启用原版增强。'>></span>
  <<else>>
  <div class='settingsGrid'>
  <<deadwood-reblooms-attribute-cheat 'willpower'>>
  <<deadwood-reblooms-attribute-cheat 'physique'>>
  <<deadwood-reblooms-attribute-cheat 'beauty'>>
  <<deadwood-reblooms-attribute-cheat 'exhibitionism'>>
  <<deadwood-reblooms-attribute-cheat 'deviancy'>>
  <<deadwood-reblooms-attribute-cheat 'promiscuity'>>
  <div class='settingsToggleItemWide'>
  <span class='silver'><strong><<lanSwitch 'All six attributes' '全部六项属性'>></strong></span><br>
  <<lanLink 'Prepare all six breakthroughs'>>
    <<run maplebirch.VP.prepareAll()>>
    <<deadwood-reblooms-cheats-refresh>>
  <</lanLink>><br>
  <<lanLink 'Complete all six breakthroughs'>>
    <<run maplebirch.VP.completeAll()>>
    <<deadwood-reblooms-cheats-refresh>>
  <</lanLink>><br>
  <<if $VanillaPlus.traits.incorrigible>>
    <<lanLink 'Remove all Vanilla Plus traits'>>
      <<run maplebirch.VP.setAllTraits(false)>>
      <<deadwood-reblooms-cheats-refresh>>
    <</lanLink>>
  <<else>>
    <<lanLink 'Unlock all Vanilla Plus traits'>>
      <<run maplebirch.VP.setAllTraits(true)>>
      <<deadwood-reblooms-cheats-refresh>>
    <</lanLink>>
  <</if>><br>
  </div>
  <div class='settingsToggleItem'>
  <<lanLink 'Open all financial services'>>
    <<run maplebirch.VP.finance.canPay(0)>>
    <<set $VanillaPlus.finance.bank.opened to true>>
    <<set $VanillaPlus.finance.bank.openedDay to Math.max(0, Number(Time.days) || 0)>>
    <<set $VanillaPlus.finance.bank.bankInterestLastDay to Math.max(0, Number(Time.days) || 0)>>
    <<set $VanillaPlus.finance.bank.debitCard to true>>
    <<set $VanillaPlus.finance.bank.creditCard to true>>
    <<set $VanillaPlus.finance.brokerage.opened to true>>
    <<replace '#deadwood-reblooms-cheats-content'>><<deadwood-reblooms-cheats-content>><</replace>>
  <</lanLink>>
  </div>
  <div class='settingsToggleItem'>
  <<lanLink 'Add £1,000 to the bank account'>>
    <<run maplebirch.VP.finance.openBankAccount()>>
    <<set $VanillaPlus.finance.bank.balance += 100000>>
    <<replace '#deadwood-reblooms-cheats-content'>><<deadwood-reblooms-cheats-content>><</replace>>
  <</lanLink>>
  </div>
  <div class='settingsToggleItem'>
  <<lanLink 'Add £10,000 to the bank account'>>
    <<run maplebirch.VP.finance.openBankAccount()>>
    <<set $VanillaPlus.finance.bank.balance += 1000000>>
    <<replace '#deadwood-reblooms-cheats-content'>><<deadwood-reblooms-cheats-content>><</replace>>
  <</lanLink>>
  </div>
  <div class='settingsToggleItem'>
  <<lanLink 'Grant premier account status'>>
    <<run maplebirch.VP.finance.canPay(0)>>
    <<set $VanillaPlus.finance.bank.opened to true>>
    <<set $VanillaPlus.finance.bank.openedDay to Math.max(0, (Number(Time.days) || 0) - 30)>>
    <<set $VanillaPlus.finance.bank.peakBalance to Math.max($VanillaPlus.finance.bank.peakBalance, 2500000)>>
    <<set $VanillaPlus.finance.bank.creditMissedPayments to 0>>
    <<set $VanillaPlus.finance.bank.loanMissedPayments to 0>>
    <<run maplebirch.VP.finance.canPay(0)>>
    <<replace '#deadwood-reblooms-cheats-content'>><<deadwood-reblooms-cheats-content>><</replace>>
  <</lanLink>>
  </div>
  <div class='settingsToggleItem'>
  <<lanLink 'Clear credit card and loan debt'>>
    <<run maplebirch.VP.finance.canPay(0)>>
    <<set $VanillaPlus.finance.bank.creditDebt to 0>>
    <<set $VanillaPlus.finance.bank.creditMinimumPayment to 0>>
    <<set $VanillaPlus.finance.bank.creditDueDay to 0>>
    <<set $VanillaPlus.finance.bank.creditLastDay to -1>>
    <<set $VanillaPlus.finance.bank.creditMissedPayments to 0>>
    <<set $VanillaPlus.finance.bank.loanDebt to 0>>
    <<set $VanillaPlus.finance.bank.loanPayment to 0>>
    <<set $VanillaPlus.finance.bank.loanRate to 0>>
    <<set $VanillaPlus.finance.bank.loanTerm to 0>>
    <<set $VanillaPlus.finance.bank.loanDueDay to 0>>
    <<set $VanillaPlus.finance.bank.loanLastDay to -1>>
    <<set $VanillaPlus.finance.bank.loanMissedPayments to 0>>
    <<replace '#deadwood-reblooms-cheats-content'>><<deadwood-reblooms-cheats-content>><</replace>>
  <</lanLink>>
  </div>
  <<if $VanillaPlus.finance?.bank?.opened>>
    <div class='settingsToggleItemWide'>
    <span class='gold'><<lanSwitch 'Bank balance' '银行余额'>></span>: <<deadwood-reblooms-finance-money $VanillaPlus.finance.bank.balance>><br>
    </div>
  <</if>>
  </div>

  <!-- 开发测试通道：跟随原版 $debug 开关，不向普通玩家显示内部状态与测试操作。 -->
  <<if $debug is 1>>
    <br><details>
      <summary class='settingsHeader options'><span class='red'><<lanSwitch 'DEBUG developer tests' 'DEBUG 开发者测试'>></span></summary>
      <div class='settingsGrid'>
        <div class='settingsToggleItem'>
          <span class='gold'><strong><<lanSwitch 'Runtime state' '运行状态'>></strong></span><br>
          <<lanSwitch 'Passage' '段落'>>：<<= passage()>><br>
          <<lanSwitch 'Location' '地点'>>：<<= $location ?? 'undefined'>><br>
          <<lanSwitch 'Day and time' '日期与时间'>>：<<= Time.days>> / <<= Time.hour>>:<<= String(Time.minute).padStart(2, '0')>><br>
          <<lanSwitch 'Combat state' '战斗状态'>>：<<= $combat ?? 0>><br>
          <<lanSwitch 'Market day and seed' '行情日期与种子'>>：<<= $VanillaPlus.finance?.market?.day ?? 'undefined'>> / <<= $VanillaPlus.finance?.market?.seed ?? 'undefined'>><br>
        </div>
        <div class='settingsToggleItem'>
          <span class='gold'><strong><<lanSwitch 'Attribute tests' '属性测试'>></strong></span><br>
          <<set _developerReadyCount to Number(maplebirch.VP.willpower.unlock) + Number(maplebirch.VP.physique.unlock) + Number(maplebirch.VP.beauty.unlock) + Number(maplebirch.VP.exhibitionism.unlock) + Number(maplebirch.VP.deviancy.unlock) + Number(maplebirch.VP.promiscuity.unlock)>>
          <<set _developerCompleteCount to Object.values($VanillaPlus.lock).filter(Boolean).length>>
          <<set _developerTraitCount to Number($VanillaPlus.traits.willpower) + Number($VanillaPlus.traits.physique) + Number($VanillaPlus.traits.beauty) + Number($VanillaPlus.traits.exhibitionism) + Number($VanillaPlus.traits.deviancy) + Number($VanillaPlus.traits.promiscuity)>>
          <<lanSwitch 'Breakthroughs ready' '可触发突破'>>：<<= _developerReadyCount>> / 6<br>
          <<lanSwitch 'Breakthroughs complete' '已完成突破'>>：<<= _developerCompleteCount>> / 6<br>
          <<lanSwitch 'Traits granted' '已获得特质'>>：<<= _developerTraitCount>> / 6<br><br>
          <<lanLink 'Prepare all six breakthroughs'>>
            <<run maplebirch.VP.prepareAll()>><<deadwood-reblooms-cheats-refresh>>
          <</lanLink>><br>
          <<lanLink 'Complete all six breakthroughs'>>
            <<run maplebirch.VP.completeAll()>><<deadwood-reblooms-cheats-refresh>>
          <</lanLink>><br>
          <<lanLink 'Open the Deadwood Reblooms scene viewer' 'Deadwood Reblooms Developer Scene Viewer'>><</lanLink>><br>
        </div>
        <div class='settingsToggleItemWide'>
          <span class='gold'><strong><<lanSwitch 'System tests' '系统测试'>></strong></span><br>
          <<lanSwitch 'History project state' '历史课题状态'>>：<<= $VanillaPlus.historyProject.status>><br>
          <<lanSwitch 'Bank account state' '银行账户状态'>>：<<= $VanillaPlus.finance.bank.opened ? lanSwitch('Open', '已开户') : lanSwitch('Closed', '未开户')>><br><br>
          <<lanLink 'Open the financial centre' 'Deadwood Reblooms Financial Centre'>><</lanLink>><br>
          <<lanLink 'Prepare a perfect history exhibition'>>
            <<set $VanillaPlus.historyProject to {
              status: 'ongoing',
              source: 'paintingward',
              availableDay: 0,
              deadline: Time.days,
              assistant: true,
              kylar: 'help',
              kylarStreet: true,
              kylarPrepared: true,
              archive: 30,
              museum: 30,
              recovery: 'recorded',
              ruin: 2,
              draft: 25,
              final: 0
            }>>
            <<deadwood-reblooms-cheats-refresh>>
          <</lanLink>><br>
          <<lanLink 'Reset the history project'>>
            <<set $VanillaPlus.historyProject to {
              status: 'none',
              source: 'none',
              availableDay: 0,
              deadline: 0,
              assistant: false,
              kylar: 'none',
              kylarStreet: false,
              kylarPrepared: false,
              archive: 0,
              museum: 0,
              recovery: 'none',
              ruin: 0,
              draft: 0,
              final: 0
            }>>
            <<deadwood-reblooms-cheats-refresh>>
          <</lanLink>><br>
          <<lanLink 'Reset the weekly ATM allowance'>>
            <<set $VanillaPlus.finance.bank.atmWeek to -1>>
            <<set $VanillaPlus.finance.bank.atmWithdrawn to 0>>
            <<deadwood-reblooms-cheats-refresh>>
          <</lanLink>><br>
          <<lanLink 'Reroll the market on the next daily update'>>
            <<set $VanillaPlus.finance.market.seed to random(1, 2147483646)>>
            <<set $VanillaPlus.finance.market.day to -1>>
            <<deadwood-reblooms-cheats-refresh>>
          <</lanLink>><br>
          <<lanLink 'Refresh dynamic music'>>
            <<run maplebirch.DM?.refresh()>>
          <</lanLink>><br>
        </div>
      </div>
    </details>
  <</if>>
  <</if>>
<</widget>>

<!-- 模组提示 -->
<<widget 'DeadwoodRebloomsHint'>>
  <<if !$DeadwoodReblooms.activeTab>>
    <<set $DeadwoodReblooms.activeTab to 'Hint'>>
  <</if>>
  <<switch $DeadwoodReblooms.activeTab>>
    <<case 'Hint'>>
      <<DeadwoodRebloomsContent>>
    <<case 'Content'>>
      <<= setup.maplebirch.content.play>>
    <<default>>
      <<DeadwoodRebloomsContent>>
  <</switch>>
<</widget>>

<!-- 侧边栏提示标题：根据当前页签切换标题与关闭按钮。 -->
<<widget 'titleDeadwoodRebloomsHint'>>
  <<if !$DeadwoodReblooms.activeTab>>
    <<set $DeadwoodReblooms.activeTab to 'Hint'>>
  <</if>>
  <<switch $DeadwoodReblooms.activeTab>>
    <<case 'Hint'>>
      <<setupTabs 0>>
    <<case 'Content'>>
      <<setupTabs 1>>
    <<default>>
      <<setupTabs 0>>
  <</switch>>
  <div id='overlayTabs' class='tab'>
    <<closeButtonMobile>>
    <<lanButton 'mods introduction' 'title'>>
      <<toggleTab>><<set $DeadwoodReblooms.activeTab to 'Hint'>>
      <<replace #customOverlayContent>><<DeadwoodRebloomsHint>><</replace>>
    <</lanButton>>
    <<lanButton 'mods contents' 'title'>>
      <<toggleTab>><<set $DeadwoodReblooms.activeTab to 'Content'>>
      <<replace #customOverlayContent>><<DeadwoodRebloomsHint>><</replace>>
    <</lanButton>>
  </div>
  <<closeButton>>
<</widget>>

<!-- 侧边栏提示内容：提供提示搜索与清空操作。 -->
<<widget 'DeadwoodRebloomsContent'>>
  <span class='searchButtons' style='display:flex'>
    <<textbox '_DeadwoodRebloomsHintTextbox' ''>>
    <<lanButton 'search' 'title'>><<run maplebirch.DR.hint?.search()>><</lanButton>>
    <<lanButton 'clear' 'title'>><<run maplebirch.DR.hint?.clear()>><</lanButton>>
  </span>
  <div id='modhint-content'><<= setup.maplebirch.hint.play>></div>
<</widget>>

<!-- 音频播放器 -->
<<widget 'DeadwoodRebloomsPlayback'>>
  <<set $_playlist to maplebirch.audio.playlist(_args[0])>>
  <div class='deadwood-reblooms-playback-left'>
    <<for _track range $_playlist.tracks>>
      <div class='deadwood-reblooms-playback-track'>
        <<link _track.title>>
          <<run maplebirch.audio.playFromMod(_args[0], _track.audioName).then((modName) =>
            $.wiki(`<<replace '#deadwood-reblooms-playback'>><<DeadwoodRebloomsPlayback ${modName}>><</replace>>`)
          )>>
        <</link>>
        <span class='deadwood-reblooms-playback-format'><<= _track.format>></span>
      </div>
    <</for>>
    <div class='deadwood-reblooms-playback-import-head'>
      <span class='deadwood-reblooms-playback-import-label'><<lanSwitch 'Import Audio' '导入音频'>></span>
      <span class='deadwood-reblooms-playback-clear'>
        <<lanLink 'clear cache' 'title'>>
          <<run maplebirch.audio.clearAudio(_args[0]).then((modName) =>
            $.wiki(`<<replace '#deadwood-reblooms-playback'>><<DeadwoodRebloomsPlayback ${modName}>><</replace>>`)
          )>>
        <</lanLink>>
      </span>
    </div>
    <div class='deadwood-reblooms-playback-import-file'>
      <input
        type='file'
        accept='audio/*'
        onchange='
          maplebirch.audio.addFile(this.files[0], "deadwood-reblooms").then((modName) =>
            $.wiki(`<<replace "#deadwood-reblooms-playback">><<DeadwoodRebloomsPlayback "${modName}">><</replace>>`)
          )
        '
      >
    </div>
  </div>
  <div id='deadwood-reblooms-playback-controls' class='deadwood-reblooms-playback-right'><<DeadwoodRebloomsPlaybackControls _args[0]>></div>
<</widget>>

<!-- 音频控制栏：显示当前曲目并提供播放模式、切歌与音量控制。 -->
<<widget 'DeadwoodRebloomsPlaybackControls'>>
  <<if maplebirch.audio.CurrentTrack>>
    <<set _snap to maplebirch.audio.snapshot>>
    <div class='deadwood-reblooms-playback-now'>
      <span><<lanSwitch 'Now Playing: ' '当前播放：'>></span>
      <strong><span class='gold'><<= _snap.track.title>></span></strong>
      <span><<= _snap.index + 1>> / <<= _snap.length>></span>
      <span class='deadwood-reblooms-playback-mode'>
        <<switch _snap.mode>>
          <<case 'sequential'>>
            <<lanSwitch 'Sequential' '顺序播放'>>
          <<case 'loop_all'>>
            <<lanSwitch 'Loop All' '列表循环'>>
          <<case 'loop_one'>>
            <<lanSwitch 'Loop One' '单曲循环'>>
          <<default>>
            <<lanSwitch 'Shuffle' '随机播放'>>
        <</switch>>
      </span>
    </div>
    <div class='deadwood-reblooms-playback-progress-row'>
      <input id='deadwood-reblooms-playback-progress' type='range' min='0' max='100' step='0.1' value='<<= _snap.progress.percent>>'>
      <span id='deadwood-reblooms-playback-time'>
        <<= maplebirch.audio.formatTime(_snap.progress.currentTime)>> /
        <<= maplebirch.audio.formatTime(_snap.progress.duration)>>
      </span>
    </div>
    <div class='deadwood-reblooms-playback-button-row'>
      <<lanLink 'previous' 'title'>>
        <<run maplebirch.audio.previous().then(() =>
          $.wiki(`<<replace "#deadwood-reblooms-playback">><<DeadwoodRebloomsPlayback ${_args[0]}>><</replace>>`)
        )>>
      <</lanLink>>
      <<if _snap.state is 'playing'>>
        <<lanLink 'pause' 'title'>>
          <<run maplebirch.audio.pause()>>
          <<replace '#deadwood-reblooms-playback-controls'>>
            <<DeadwoodRebloomsPlaybackControls _args[0]>>
          <</replace>>
        <</lanLink>>
      <<else>>
        <<lanLink 'resume' 'title'>>
          <<run maplebirch.audio.resume()>>
          <<replace '#deadwood-reblooms-playback-controls'>>
            <<DeadwoodRebloomsPlaybackControls _args[0]>>
          <</replace>>
        <</lanLink>>
      <</if>>
      <<lanLink 'stop' 'title'>>
        <<run maplebirch.audio.stop()>>
        <<replace '#deadwood-reblooms-playback-controls'>>
          <<DeadwoodRebloomsPlaybackControls _args[0]>>
        <</replace>>
      <</lanLink>>
      <<lanLink 'next' 'title'>>
        <<run maplebirch.audio.next().then(() =>
          $.wiki(`<<replace "#deadwood-reblooms-playback">><<DeadwoodRebloomsPlayback ${_args[0]}>><</replace>>`)
        )>>
      <</lanLink>>
      <<lanLink 'loop mode' 'title'>>
        <<run maplebirch.audio.cyclePlayMode()>>
        <<replace '#deadwood-reblooms-playback-controls'>>
          <<DeadwoodRebloomsPlaybackControls _args[0]>>
        <</replace>>
      <</lanLink>>
    </div>
    <div class='deadwood-reblooms-playback-volume'>
      <<numberslider '_snap.volume' _snap.volume 0 1 0.01 {
        value: v => lanSwitch('Volume: ', '音量：') + Math.round(v * 100) + '%',
        onInputChange: value => { maplebirch.audio.Volume = value; }
      }>>
    </div>
    <<run maplebirch.audio.bindProgress('deadwood-reblooms-playback-progress', 'deadwood-reblooms-playback-time')>>
  <<else>>
    <div class='deadwood-reblooms-playback-empty'>
      <div class='deadwood-reblooms-playback-empty-title'><<lanSwitch 'No audio selected' '未选择音频'>></div>
      <div class='deadwood-reblooms-playback-empty-text'>
        <<lanSwitch 'Choose a track from the left list, or import an audio file first.' '请从左侧列表选择音频，或先导入音频文件。'>>
      </div>
    </div>
  <</if>>
<</widget>>

<!-- 定制涂鸦 -->
<<widget 'DeadwoodRebloomsBodyWriting'>>
  <<if Object.keys(_bodyPartOptions).length gt 0 && $options.maplebirch.bodywriting is true>>
    <div class='settingsToggleItemWide'>
    <<set _bodywriting to {}>>
    <<set _bodywritingSpecialList to [...new Set([
      'none',
      ...new Set(Object.values(setup.bodywriting).map(item => item.special).filter(Boolean)),
      'loveInterest'
    ])].filter(special => !setup.loveInterestNpc?.includes(special))>>
    <<set _bodywritingSpecialTranslations to {
      none          : { cn: '无'      , en: 'None' },
      rape          : { cn: '强奸'    , en: 'Rape' },
      slave         : { cn: '奴隶'    , en: 'Slave' },
      violence      : { cn: '暴力'    , en: 'Violence' },
      sex           : { cn: '性爱'    , en: 'Sex' },
      bestiality    : { cn: '兽交'    , en: 'Bestiality' },
      prostitution  : { cn: '卖淫'    , en: 'Prostitution' },
      exhibitionism : { cn: '暴露癖'  , en: 'Exhibitionism' },
      combat        : { cn: '战斗'    , en: 'Combat' },
      holy          : { cn: '神圣'    , en: 'Holy' },
      cattle        : { cn: '牲畜'    , en: 'Cattle' },
      criminal      : { cn: '罪犯'    , en: 'Criminal' },
      pregnancy     : { cn: '怀孕'    , en: 'Pregnancy' },
      impreg        : { cn: '受孕'    , en: 'Impregnation' },
      islander      : { cn: '岛民'    , en: 'Islander' },
      esoteric      : { cn: '隐秘'    , en: 'Esoteric' },
      loveInterest  : { cn: '恋爱对象', en: 'Love Interest' }
    }>>
    <<set _textColorNames to [
      ['red'           , ['<span class="red">Red</span>'                      , '<span class="red">红色</span>']],
      ['pink'          , ['<span class="pink">Pink</span>'                    , '<span class="pink">粉色</span>']],
      ['light-pink'    , ['<span class="light-pink">Light Pink</span>'        , '<span class="light-pink">浅粉色</span>']],
      ['rose-gold'     , ['<span class="rose-gold">Rose Gold</span>'          , '<span class="rose-gold">玫瑰金</span>']],
      ['hospital-pink' , ['<span class="hospital-pink">Hospital Pink</span>'  , '<span class="hospital-pink">医院粉</span>']],
      ['purple'        , ['<span class="purple">Purple</span>'                , '<span class="purple">紫色</span>']],
      ['lilac'         , ['<span class="lilac">Lilac</span>'                  , '<span class="lilac">淡紫色</span>']],
      ['blue'          , ['<span class="blue">Blue</span>'                    , '<span class="blue">蓝色</span>']],
      ['lblue'         , ['<span class="lblue">Light Blue</span>'             , '<span class="lblue">浅蓝色</span>']],
      ['light-blue'    , ['<span class="light-blue">Bright Blue</span>'       , '<span class="light-blue">亮蓝色</span>']],
      ['teal'          , ['<span class="teal">Teal</span>'                    , '<span class="teal">青绿色</span>']],
      ['green'         , ['<span class="green">Green</span>'                  , '<span class="green">绿色</span>']],
      ['lime-green'    , ['<span class="lime-green">Lime Green</span>'        , '<span class="lime-green">酸橙绿</span>']],
      ['light-green'   , ['<span class="light-green">Light Green</span>'      , '<span class="light-green">浅绿色</span>']],
      ['brown'         , ['<span class="brown">Brown</span>'                  , '<span class="brown">棕色</span>']],
      ['gold'          , ['<span class="gold">Gold</span>'                    , '<span class="gold">金色</span>']],
      ['silver'        , ['<span class="silver">Silver</span>'                , '<span class="silver">银色</span>']],
      ['bronze'        , ['<span class="bronze">Bronze</span>'                , '<span class="bronze">青铜色</span>']],
      ['steel'         , ['<span class="steel">Steel</span>'                  , '<span class="steel">钢色</span>']],
      ['blue-steel'    , ['<span class="blue-steel">Blue Steel</span>'        , '<span class="blue-steel">蓝钢色</span>']],
      ['yellow'        , ['<span class="yellow">Yellow</span>'                , '<span class="yellow">黄色</span>']],
      ['pale-yellow'   , ['<span class="pale-yellow">Pale Yellow</span>'      , '<span class="pale-yellow">淡黄色</span>']],
      ['orange'        , ['<span class="orange">Orange</span>'                , '<span class="orange">橙色</span>']],
      ['tangerine'     , ['<span class="tangerine">Tangerine</span>'          , '<span class="tangerine">橘色</span>']],
      ['pale-tangerine', ['<span class="pale-tangerine">Pale Tangerine</span>', '<span class="pale-tangerine">淡橘色</span>']],
      ['black'         , ['<span class="black">Black</span>'                  , '<span class="black">黑色</span>']],
      ['softbrown'     , ['<span class="softbrown">Soft Brown</span>'         , '<span class="softbrown">软棕色</span>']],
      ['lightbrown'    , ['<span class="lightbrown">Light Brown</span>'       , '<span class="lightbrown">浅棕色</span>']],
      ['burntorange'   , ['<span class="burntorange">Burnt Orange</span>'     , '<span class="burntorange">焦橙色</span>']],
      ['bloodorange'   , ['<span class="bloodorange">Blood Orange</span>'     , '<span class="bloodorange">血橙色</span>']],
      ['bluehair'      , ['<span class="bluehair">Blue Hair</span>'           , '<span class="bluehair">蓝发色</span>']],
      ['deepblue'      , ['<span class="deepblue">Deep Blue</span>'           , '<span class="deepblue">深蓝色</span>']],
      ['neonblue'      , ['<span class="neonblue">Neon Blue</span>'           , '<span class="neonblue">霓虹蓝</span>']],
      ['greenhair'     , ['<span class="greenhair">Green Hair</span>'         , '<span class="greenhair">绿发色</span>']],
      ['darklime'      , ['<span class="darklime">Dark Lime</span>'           , '<span class="darklime">深柠檬绿</span>']],
      ['toxicgreen'    , ['<span class="toxicgreen">Toxic Green</span>'       , '<span class="toxicgreen">毒绿色</span>']],
      ['tealhair'      , ['<span class="tealhair">Teal Hair</span>'           , '<span class="tealhair">青绿发色</span>']],
      ['pinkhair'      , ['<span class="pinkhair">Pink Hair</span>'           , '<span class="pinkhair">粉发色</span>']],
      ['brightpink'    , ['<span class="brightpink">Bright Pink</span>'       , '<span class="brightpink">亮粉色</span>']],
      ['hotpink'       , ['<span class="hotpink">Hot Pink</span>'             , '<span class="hotpink">热粉色</span>']],
      ['softpink'      , ['<span class="softpink">Soft Pink</span>'           , '<span class="softpink">柔粉色</span>']],
      ['crimson'       , ['<span class="crimson">Crimson</span>'              , '<span class="crimson">深红色</span>']],
      ['purplehair'    , ['<span class="purplehair">Purple Hair</span>'       , '<span class="purplehair">紫发色</span>']],
      ['mediumpurple'  , ['<span class="mediumpurple">Medium Purple</span>'   , '<span class="mediumpurple">中紫色</span>']],
      ['brightpurple'  , ['<span class="brightpurple">Bright Purple</span>'   , '<span class="brightpurple">亮紫色</span>']],
      ['whitehair'     , ['<span class="whitehair">White Hair</span>'         , '<span class="whitehair">白发色</span>']],
      ['snowwhitehair' , ['<span class="snowwhitehair">Snow White</span>'     , '<span class="snowwhitehair">雪白色</span>']],
      ['softblond'     , ['<span class="softblond">Soft Blond</span>'         , '<span class="softblond">软金色</span>']],
      ['platinum'      , ['<span class="platinum">Platinum</span>'            , '<span class="platinum">铂金色</span>']],
      ['ashy'          , ['<span class="ashy">Ashy</span>'                    , '<span class="ashy">灰金色</span>']],
      ['strawberry'    , ['<span class="strawberry">Strawberry</span>'        , '<span class="strawberry">草莓色</span>']],
      ['lewd'          , ['<span class="lewd">Lewd</span>'                    , '<span class="lewd">淫荡色</span>']],
      ['grey'          , ['<span class="grey">Grey</span>'                    , '<span class="grey">灰色</span>']],
      ['light-grey'    , ['<span class="light-grey">Light Grey</span>'        , '<span class="light-grey">浅灰色</span>']],
      ['tan'           , ['<span class="tan">Tan</span>'                      , '<span class="tan">棕褐色</span>']],
      ['sand'          , ['<span class="sand">Sand</span>'                    , '<span class="sand">沙色</span>']],
      ['olive'         , ['<span class="olive">Olive</span>'                  , '<span class="olive">橄榄色</span>']],
      ['navy'          , ['<span class="navy">Navy Blue</span>'               , '<span class="navy">海军蓝</span>']],
      ['wine'          , ['<span class="wine">Wine Red</span>'                , '<span class="wine">酒红色</span>']],
      ['russet'        , ['<span class="russet">Russet</span>'                , '<span class="russet">赤褐色</span>']],
      ['fleshy'        , ['<span class="fleshy">Fleshy</span>'                , '<span class="fleshy">肉色</span>']],
      ['brat'          , ['<span class="brat">Brat</span>'                    , '<span class="brat">叛逆色</span>']],
      ['meek'          , ['<span class="meek">Meek</span>'                    , '<span class="meek">温顺色</span>']],
      ['def'           , ['<span class="def">Defiant</span>'                  , '<span class="def">反抗色</span>']],
      ['sub'           , ['<span class="sub">Submissive</span>'               , '<span class="sub">顺从色</span>']],
      ['relaxed'       , ['<span class="relaxed">Relaxed</span>'              , '<span class="relaxed">放松色</span>']],
      ['anxious'       , ['<span class="anxious">Anxious</span>'              , '<span class="anxious">焦虑色</span>']],
      ['veteran'       , ['<span class="veteran">Veteran</span>'              , '<span class="veteran">老兵色</span>']],
      ['methodical'    , ['<span class="methodical">Methodical</span>'        , '<span class="methodical">有条不紊色</span>']],
      ['scarred'       , ['<span class="scarred">Scarred</span>'              , '<span class="scarred">伤疤色</span>']],
      ['tattooed'      , ['<span class="tattooed">Tattooed</span>'            , '<span class="tattooed">纹身色</span>']],
      ['manager'       , ['<span class="manager">Manager</span>'              , '<span class="manager">经理色</span>']],
      ['lustful'       , ['<span class="lustful">Lustful</span>'              , '<span class="lustful">欲望色</span>']],
      ['wraith'        , ['<span class="wraith">Wraith</span>'                , '<span class="wraith">幽灵色</span>']],
      ['witch'         , ['<span class="witch">Witch</span>'                  , '<span class="witch">巫女色</span>']],
      ['custom'        , ['Custom'                                            , '自选']]
    ]>>
    <<language>>
      <<option 'CN'>>
        <<set _bodywritingSpecialNames to {}>>
        <<run _bodywritingSpecialList.forEach(
          special => _bodywritingSpecialNames[_bodywritingSpecialTranslations[special].cn] = special
        )>>
      <<option 'EN'>>
        <<set _bodywritingSpecialNames to {}>>
        <<run _bodywritingSpecialList.forEach(
          special => _bodywritingSpecialNames[_bodywritingSpecialTranslations[special].en] = special
        )>>
    <</language>>
    <span class="gold bold"><<lanSwitch 'Custom Bodywriting' '定制涂鸦'>></span><br>
    <<lanSwitch 'The characteristics of this bodywriting are' '这幅涂鸦的所具有的特定'>>：
    <br><<lanSwitch 'Color: ' '颜色：'>><br><<radiobuttonsfrom '_bodywriting.color' _textColorNames>><</radiobuttonsfrom>>
    <div id='DeadwoodRebloomsBodyWriting' style='display:inline'></div><br><<lanSwitch 'Gender: ' '性别：'>>
    <<lanListbox '_bodywriting.gender'>><<option 'asexual' 'n'>><<option 'male' 'm'>><<option 'famale' 'f'>><<option 'hermaphrodite' 'h'>><</lanListbox>>
    <br><<lanSwitch 'Category: ' '类别：'>><<lanListbox '_bodywriting.special' autoselect>><<optionsfrom _bodywritingSpecialNames>><</lanListbox>>
    <br><<lanSwitch 'Related to the Love Interest?' '与恋爱对象有关?'>>
    <<set $_bodywritingloveInterestNames = ['None', ...setup.loveInterestNpc.filter(name => isPossibleLoveInterest(name))]>>
    <<lanListbox '_bodywriting.loveInterest' autoselect>><<optionsfrom $_bodywritingloveInterestNames>><</lanListbox>>
    <span
      class='tooltip-anchor linkBlue'
      tooltip="<span class='teal'><<lanSwitch
        'This option will only take effect when the category is selected as &quot;Love Interest&quot;'
        '仅在类别选用&quot;恋爱对象&quot;时，此选项才会生效'
      >></span>"
    >(?)</span>
    <br><<lanSwitch 'A directional arrow?' '带有指向性的箭头?'>><br><<set _bodywriting.arrow to 0>>
    <label><<lanSwitch 'YES' '是'>> <<radiobutton '_bodywriting.arrow' 1 autocheck>></label>|
    <label><<lanSwitch 'NO' '否'>> <<radiobutton '_bodywriting.arrow' 0 autocheck>></label>
    <br><<lanSwitch 'Does it imply lewd?' '具有淫秽暗示?'>><br><<set _bodywriting.lewd to 0>>
    <label><<lanSwitch 'YES' '是'>> <<radiobutton '_bodywriting.lewd' 1 autocheck>></label>|
    <label><<lanSwitch 'NO' '否'>> <<radiobutton '_bodywriting.lewd' 0 autocheck>></label>
    <br><<set _bodywritingPenNames to maplebirch.Language is 'CN'
      ? { 普通笔: 'pen', 耐久笔: 'marker', 口红: 'lipstick', 泥巴: 'mud' }
      : { Pen: 'pen', Marker: 'marker', Lipstick: 'lipstick', Mud: 'mud' }
    >>
    <<language>>
      <<option 'CN'>>
        把 <<textbox '_bodywriting.text' ''>> 用
        <<lanListbox '_bodywriting.pen'>><<optionsfrom _bodywritingPenNames>><</lanListbox>> 写在你的
        <<listbox '_bodywriting.bodyPart'>><<optionsfrom _bodyPartOptions>><</listbox>> 上
      <<option 'EN'>>
        Write <<textbox '_bodywriting.text' ''>> on your
        <<listbox '_bodywriting.bodyPart'>><<optionsfrom _bodyPartOptions>><</listbox>> with a
        <<lanListbox '_bodywriting.pen'>><<optionsfrom _bodywritingPenNames>><</lanListbox>>
    <</language>>
    <<lanLink 'confirm' 'capitalize' 'class:no-numberify'>>
      <<set _bodywriting.skin to {
        writing: _bodywriting.color === 'custom'
          ? `<span style='color:${_bodywriting.custom}'>${_bodywriting.text}</span>`
          : `<span class='${_bodywriting.color}'>${_bodywriting.text}</span>`,
        writ_cn: _bodywriting.color === 'custom'
          ? `<span style='color:${_bodywriting.custom}'>${_bodywriting.text}</span>`
          : `<span class='${_bodywriting.color}'>${_bodywriting.text}</span>`,
        type   : 'text',
        arrow  : _bodywriting.arrow,
        lewd   : _bodywriting.lewd,
        special: _bodywriting.special === 'loveInterest' ? _bodywriting.loveInterest : _bodywriting.special,
        gender : _bodywriting.gender,
        degree : 0
      }>>
      <<add_bodywriting _bodywriting.bodyPart _bodywriting.skin _bodywriting.pen>>
    <</lanLink>>
  </div>
  <</if>>
<</widget>>

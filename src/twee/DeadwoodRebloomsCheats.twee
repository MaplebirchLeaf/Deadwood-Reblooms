:: Deadwood Reblooms Cheat Widgets [widget]

<<widget 'deadwood-reblooms-cheats'>>
  <<if (maplebirch.get('Finance') and $Finance?.bank) or (maplebirch.get('Transport') and $Transport) or (maplebirch.get('StreetLife') and $StreetLife) or (maplebirch.get('Orchard') and $Orchard) or (maplebirch.get('LifeSimulation') and $LifeSimulation) or (maplebirch.get('Psyche') and $Psyche) or (maplebirch.get('VanillaPlus') and $VanillaPlus)>>
    <div class='settingsGrid'>
      <div class='settingsHeader options'><<lanSwitch 'Deadwood Reblooms' '枯木逢春'>></div>
      <<if maplebirch.get('Psyche') and $Psyche>>
        <div class='settingsToggleItem'><<deadwood-psyche-cheats-content>></div>
      <</if>>
      <<if maplebirch.get('VanillaPlus') and $VanillaPlus>>
        <div class='settingsToggleItem'><div id='deadwood-breakthrough-cheats'><<deadwood-breakthrough-cheats>></div></div>
      <</if>>
      <<if maplebirch.get('Finance') and $Finance?.bank>>
        <div class='settingsToggleItemWide'><div id='deadwood-bank-cheats'><<deadwood-finance-cheats-content>></div></div>
      <</if>>
      <<if maplebirch.get('Transport') and $Transport>>
        <div class='settingsToggleItemWide'><<deadwood-transport-cheats>></div>
      <</if>>
      <<if maplebirch.get('StreetLife') and $StreetLife>>
        <div class='settingsToggleItem'><<deadwood-street-cheats>></div>
      <</if>>
      <<if maplebirch.get('Orchard') and $Orchard>>
        <div class='settingsToggleItemWide'><<deadwood-orchard-cheats>></div>
      <</if>>
      <<if maplebirch.get('LifeSimulation') and $LifeSimulation?.school>>
        <div class='settingsToggleItem'><<deadwood-school-cheats>></div>
      <</if>>
      <<if maplebirch.get('LifeSimulation') and $LifeSimulation?.medicine>>
        <div class='settingsToggleItem'><<deadwood-medicine-cheats>></div>
      <</if>>
    </div>
  <</if>>
<</widget>>

<<widget 'deadwood-transport-cheats'>>
  <<if !maplebirch.get('Transport') or !$Transport?.vehicles>><<exit>><</if>>
  <span class='gold'><<lanSwitch 'Transport' '交通'>></span><br>
  <<numberStepper `lanSwitch('Driving proficiency', '驾驶熟练度')` $Transport.driving {
    min:0, max:1000, step:10,
    callback:value => {
      if (maplebirch.get('Transport') && V.Transport && Number.isFinite(value)) V.Transport.driving = Math.clamp(value, 0, 1000);
    }
  }>>
  <<if $Transport.trip or $Transport.commute or $Transport.taxi?.job>>
    <span class='blue'><<lanSwitch 'Finish the journey or passenger arrangement before adjusting a vehicle.' '请先结束行程或载客安排，再调整车辆。'>></span><br>
  <<elseif !$Transport.vehicles.length>>
    <<lanSwitch 'You do not own a vehicle.' '你还没有车辆。'>><br>
  <<else>>
    <<for _cheatVehicle range $Transport.vehicles>>
      <<set _cheatModel to maplebirch.get('Transport').catalog.models.find(model => model.id is _cheatVehicle.model)>>
      <<if _cheatModel>>
        <b><<= maplebirch.t(_cheatModel.name)>> #<<= _cheatVehicle.id>></b><br>
        <<numberStepper `lanSwitch('Condition', '车况')` _cheatVehicle.condition {
          min:0, max:100, step:1, values:[_cheatVehicle.id],
          callback:(value, arr) => {
            if (!maplebirch.get('Transport') || !V.Transport || V.Transport.trip || V.Transport.commute || V.Transport.taxi?.job || !Number.isFinite(value)) return;
            const vehicle = V.Transport.vehicles.find(item => item.id === arr[0]);
            if (vehicle) vehicle.condition = Math.clamp(value, 0, 100);
          }
        }>>
        <<if _cheatModel.tank gt 0>>
          <<numberStepper `lanSwitch('Fuel (litres)', '燃油（升）')` _cheatVehicle.fuel {
            min:0, max:_cheatModel.tank, step:1, percentage:false, values:[_cheatVehicle.id],
            callback:(value, arr) => {
              if (!maplebirch.get('Transport') || !V.Transport || V.Transport.trip || V.Transport.commute || V.Transport.taxi?.job || !Number.isFinite(value)) return;
              const vehicle = V.Transport.vehicles.find(item => item.id === arr[0]);
              const model = vehicle && maplebirch.get('Transport').catalog.models.find(item => item.id === vehicle.model);
              if (model) vehicle.fuel = Math.clamp(value, 0, model.tank);
            }
          }>>
        <</if>>
      <</if>>
    <</for>>
  <</if>>
<</widget>>

<<widget 'deadwood-street-cheats'>>
  <<if !maplebirch.get('StreetLife') or !$StreetLife?.ammo>><<exit>><</if>>
  <span class='gold'><<lanSwitch 'Street life' '街头'>></span><br>
  <<numberStepper `lanSwitch('Street reputation', '街头声誉')` `maplebirch.get('StreetLife').reputation` {
    min:0, max:100, step:1,
    callback:value => {
      if (maplebirch.get('StreetLife') && V.StreetLife && Number.isFinite(value)) maplebirch.get('StreetLife').reputation = Math.clamp(value, 0, 100);
    }
  }>>
  <<for _cheatAmmoId, _cheatAmmo range maplebirch.get('StreetLife').ammunition>>
    <<numberStepper `lanSwitch(_cheatAmmo.name[0], _cheatAmmo.name[1])` $StreetLife.ammo[_cheatAmmoId] {
      min:0, max:Math.max(10000, $StreetLife.ammo[_cheatAmmoId]), step:1,
      activeButtons:['single', 'double', 'triple'], percentage:false, values:[_cheatAmmoId],
      callback:(value, arr) => {
        if (!maplebirch.get('StreetLife') || !V.StreetLife?.ammo || !Object.hasOwn(V.StreetLife.ammo, arr[0]) || !Number.isSafeInteger(value) || value < 0) return;
        V.StreetLife.ammo[arr[0]] = value;
      }
    }>>
  <</for>>
  <span class='blue'><<lanSwitch 'Changing reputation does not complete jobs.' '更改声誉不会完成委托。'>></span><br>
<</widget>>

<<widget 'deadwood-orchard-cheats'>>
  <<if !maplebirch.get('Orchard') or !$Orchard?.reserve or !$foodstuff>><<exit>><</if>>
  <span class='gold'><<lanSwitch 'Orchard supplies' '果园物资'>></span><br>
  <<for _cheatFruitId, _cheatFruit range maplebirch.get('Orchard').species>>
    <<if $foodstuff[_cheatFruitId]>>
      <<numberStepper `lanSwitch(_cheatFruit.name[0], _cheatFruit.name[1])` $foodstuff[_cheatFruitId].amount {
        min:Math.max(0, $Orchard.reserve[_cheatFruitId] ?? 0), max:Math.max(10000, $foodstuff[_cheatFruitId].amount, $Orchard.reserve[_cheatFruitId] ?? 0), step:1,
        activeButtons:['single', 'double', 'triple'], percentage:false, values:[_cheatFruitId],
        callback:(value, arr) => {
          if (!maplebirch.get('Orchard') || !V.Orchard?.reserve || !V.foodstuff?.[arr[0]] || !Number.isSafeInteger(value) || value < Math.max(0, V.Orchard.reserve[arr[0]] ?? 0)) return;
          V.foodstuff[arr[0]].amount = value;
        }
      }>>
    <</if>>
  <</for>>
  <<if $foodstuff.blood_lemon>>
    <<numberStepper `lanSwitch('Blood lemon', '血柠')` $foodstuff.blood_lemon.amount {
      min:Math.max(0, $Orchard.reserve.blood_lemon ?? 0), max:Math.max(10000, $foodstuff.blood_lemon.amount, $Orchard.reserve.blood_lemon ?? 0), step:1,
      activeButtons:['single', 'double', 'triple'], percentage:false,
      callback:value => {
        if (!maplebirch.get('Orchard') || !V.Orchard?.reserve || !V.foodstuff?.blood_lemon || !Number.isSafeInteger(value) || value < Math.max(0, V.Orchard.reserve.blood_lemon ?? 0)) return;
        V.foodstuff.blood_lemon.amount = value;
      }
    }>>
  <</if>>
  <<if $fertiliser>>
    <<numberStepper `lanSwitch('Fertiliser', '肥料')` $fertiliser.current {
      min:0, max:Math.max(10000, $fertiliser.current), step:1,
      activeButtons:['single', 'double', 'triple'], percentage:false,
      callback:value => {
        if (maplebirch.get('Orchard') && V.Orchard && V.fertiliser && Number.isSafeInteger(value) && value >= 0) V.fertiliser.current = value;
      }
    }>>
  <</if>>
  <<if $Orchard.winery?.installed>>
    <span class='gold'><<lanSwitch 'Bottled fruit wine' '瓶装果酒'>></span><br>
    <<for _cheatWine range maplebirch.get('Orchard').winery.terms.recipes>>
      <<numberStepper `lanSwitch(_cheatWine.name[0], _cheatWine.name[1])` $Orchard.winery.stock[_cheatWine.id] {
        min:0, max:Math.max(10000, $Orchard.winery.stock[_cheatWine.id]), step:1,
        activeButtons:['single', 'double', 'triple'], percentage:false, values:[_cheatWine.id],
        callback:(value, arr) => {
          const winery = V.Orchard?.winery;
          if (!winery?.installed || !Object.hasOwn(winery.stock, arr[0]) || !Number.isSafeInteger(value) || value < 0) return;
          winery.stock[arr[0]] = value;
        }
      }>>
    <</for>>
  <</if>>
  <span class='blue'><<lanSwitch 'Fruit reserved for orders cannot be removed.' '预留给订单的果实不能移除。'>></span><br>
<</widget>>

<<widget 'deadwood-school-cheats'>>
  <<if !maplebirch.get('LifeSimulation') or !$LifeSimulation?.school>><<exit>><</if>>
  <span class='gold'><<lanSwitch 'School affairs' '校园事务'>></span><br>
  <<for _cheatSchoolField range [
    {id:'studentSupport', name:['Student support', '学生声望']},
    {id:'staffSupport', name:['Staff support', '教职工信任']},
    {id:'corruption', name:['School corruption', '校内堕落']}
  ]>>
    <<numberStepper `lanSwitch(_cheatSchoolField.name[0], _cheatSchoolField.name[1])` $LifeSimulation.school[_cheatSchoolField.id] {
      min:0, max:100, step:1, values:[_cheatSchoolField.id],
      callback:(value, arr) => {
        if (!maplebirch.get('LifeSimulation') || !V.LifeSimulation?.school || !['studentSupport', 'staffSupport', 'corruption'].includes(arr[0]) || !Number.isFinite(value)) return;
        V.LifeSimulation.school[arr[0]] = Math.clamp(value, 0, 100);
      }
    }>>
  <</for>>
  <span class='blue'><<lanSwitch 'Appointments and school policies still need approval.' '职务与校规仍须取得批准。'>></span><br>
<</widget>>

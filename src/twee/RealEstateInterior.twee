:: Deadwood Reblooms Property Bedroom []
<<set _property to maplebirch.VP.realEstate.current>>
<<if !_property || !maplebirch.VP.realEstate.owns(_property.id) || maplebirch.VP.realEstate.managementFor(_property.id).rented>>
	<<lanLink '返回房产中介' 'Deadwood Reblooms Property Office'>><</lanLink>>
<<else>>
	<<run maplebirch.VP.realEstate.enter()>><<home_effects>><<effects>>
	<<= lanSwitch(_property.interior.bedroom.EN, _property.interior.bedroom.CN)>><br><br>
	<<set _bedroomCompanion to null>>
	<<if maplebirch.VP.realEstate.residentsHome(_property.id).length gt 0>>
		<<set _bedroomCompanion to maplebirch.VP.realEstate.residentsHome(_property.id)[0]>>
		<<npc _bedroomCompanion.id>><<person1>>
		<<switch _bedroomCompanion.id>>
			<<case 'Robin'>>
				<<language>>
					<<option 'EN'>>Robin has folded a spare blanket at the foot of the bed. <<He>> <span class='teal'>pats the space beside <<him>></span> when you come in.
					<<option 'CN'>>罗宾把备用毯子叠在床尾。见你进来，<<he>><span class='teal'>拍拍身旁的位置</span>。
				<</language>>
			<<case 'Whitney'>>
				<<language>>
					<<option 'EN'>>Whitney's bag lies where <<he>> dropped it. <<He>> has <span class='teal'>pulled the second pillow close to yours</span>.
					<<option 'CN'>>惠特尼的包还丢在原处。<<He>>倒是<span class='teal'>把第二只枕头挪到了你的枕边</span>。
				<</language>>
			<<case 'Kylar'>>
				<<language>>
					<<option 'EN'>>Kylar has stacked <<his>> things beside the wardrobe. <<He>> looks up from the bed when you enter.
					<<option 'CN'>>凯拉尔把东西叠在衣柜旁。你走进来时，<<he>>从床上抬起头。
				<</language>>
			<<case 'Sydney'>>
				<<language>>
					<<option 'EN'>>Sydney has hung <<his>> temple clothes apart from the rest, ready for the morning. <<He>> <span class='teal'>makes room for you on the bed</span>.
					<<option 'CN'>>悉尼把明早要穿的神殿衣服单独挂好，<span class='teal'>在床上给你让出位置</span>。
				<</language>>
		<</switch>><br><br>
	<</if>>
	<<set _bed to maplebirch.VP.realEstate.furniture(_property.id, 'bed')>>
	<<if $earSlime.event and $earSlime.noSleep>>
		<span class='red'><<lanSwitch 'The slime will not let you sleep yet.' '史莱姆现在不让你睡觉。'>></span><br>
	<<elseif _bed>>
		<<if maplebirch.VP.realEstate.canShareBed(_property.id)>>
			<<lanSwitch 'The bed is made up for two. There is room to turn over without disturbing the other side.' '双人床铺好了被褥。即使翻身，也不会碰到另一侧的人。'>>
		<<else>>
			<<lanSwitch 'You smooth the sheets across the narrow mattress. There is room for only one person.' '你抚平窄床垫上的被褥。这里仅够一个人睡下。'>>
		<</if>><br>
		<<furnitureicon _bed.iconFile>>
		<<lanLink '脱衣上床' 'Deadwood Reblooms Property Bed'>>
			<<undressSleep 'Deadwood Property Bed'>>
		<</lanLink>><br>
	<</if>>
	<<if !($earSlime.event and $earSlime.noSleep)>><<deadwood-reblooms-property-sleep-outfits>><</if>>
	<<if _bedroomCompanion && maplebirch.VP.realEstate.canShareBed(_property.id)>>
		<<loveicon 'kiss'>>
		<<lanLink '一起上床' 'Deadwood Reblooms Property Intimacy'>>
			<<run maplebirch.VP.realEstate.meetResident(_bedroomCompanion.id, _property.id)>>
			<<set $sexstart to 1>>
		<</lanLink>><<promiscuous1>><br>
	<</if>>
	<br>
	<<set _wardrobe to maplebirch.VP.realEstate.furniture(_property.id, 'wardrobe')>>
	<<if _wardrobe>>
		<<if _wardrobe.type.includes('organiser')>>
			<<lanSwitch 'The wardrobe has drawers for smaller things and a rail for your clothes.' '衣柜里有收纳小物的抽屉，也有挂衣服的横杆。'>>
		<<elseif _wardrobe.type.includes('spacious')>>
			<<lanSwitch 'Your clothes have room to hang without being pressed together.' '衣服能宽松地挂在衣柜里，不必挤作一团。'>>
		<<else>>
			<<lanSwitch 'The narrow wardrobe creaks when you open it. Your clothes just fit inside.' '打开狭窄的衣柜时，柜门吱呀作响。里面勉强放得下你的衣服。'>>
		<</if>><br>
		<<furnitureicon _wardrobe.iconFile>><<lanLink '衣柜' 'Deadwood Reblooms Property Wardrobe'>><</lanLink>><br>
	<</if>>
	<<mirroricon 'home'>><<lanLink '镜子' 'Deadwood Reblooms Property Mirror'>><<preMirror>><</lanLink>><br>
	<<roomoptions>>
	<<if playerHasSexToys()>>
		<<sextoysicon>><<lanLink '性玩具' 'Sextoys Inventory'>><<set $sextoyInvReturnLink to 'Deadwood Reblooms Property Bedroom'>><</lanLink>><br>
	<</if>>
	<<if _property.rooms.desk is _property.rooms.bedroom>>
		<<deskchairicon>><<lanLink '书桌' 'Deadwood Reblooms Property Desk'>><</lanLink>><br>
	<</if>>
	<br>
	<<if _property.rooms.bedroom is 1>>
		<<getouticon>><<lanLink '起居室 (0:01)' 'Deadwood Reblooms Property Home'>><<pass 1>><</lanLink>>
	<<else>>
		<<getouticon>><<lanLink '返回楼梯间 (0:01)' 'Deadwood Reblooms Property Landing'>><<pass 1>><</lanLink>>
	<</if>>
<</if>>

:: Deadwood Reblooms Property Desk []
<<set _property to maplebirch.VP.realEstate.current>>
<<if !_property || !maplebirch.VP.realEstate.owns(_property.id) || maplebirch.VP.realEstate.managementFor(_property.id).rented>>
	<<lanLink '返回房产中介' 'Deadwood Reblooms Property Office'>><</lanLink>>
<<else>>
	<<run maplebirch.VP.realEstate.enter()>><<effects>>
	<<language>>
		<<option 'EN'>>You sit at the desk. There is enough room to spread out a book beneath the lamp.
		<<option 'CN'>>你在书桌前坐下。灯下有足够的地方摊开一本书。
	<</language>><br><br>
	<<if $studyBooks is undefined>><<set $studyBooks to {rented: 'none', stolen: 'none'}>><</if>>
	<<homeStudyOptions>>
	<<if maplebirch.get('LS') and $LifeSimulation.school.role isnot 'student' and $LifeSimulation.school.study_session_day isnot Time.days>>
		<br><<schoolicon 'library'>><<lanLink '在家整理学生会的学习资料 (0:30)' 'Deadwood Reblooms Property School Study'>><<set $phase to 'solo'>><<pass 30>><</lanLink>><br>
		<<if maplebirch.VP.realEstate.residentsHome(_property.id).length gt 0>>
			<<socialiseicon>><<lanLink '请同住的恋人一起准备课后学习 (0:30)' 'Deadwood Reblooms Property School Study'>><<set $phase to 'together'>><<pass 30>><</lanLink>><br>
		<</if>>
	<</if>>
	<br>
	<<if _property.rooms.desk is _property.rooms.bedroom>>
		<<lanLink '起身' 'Deadwood Reblooms Property Bedroom'>><</lanLink>>
	<<elseif _property.rooms.desk is 1>>
		<<lanLink '起身' 'Deadwood Reblooms Property Home'>><</lanLink>>
	<<else>>
		<<lanLink '起身' 'Deadwood Reblooms Property Landing'>><</lanLink>>
	<</if>>
<</if>>

:: Deadwood Reblooms Property School Study []
<<set _property to maplebirch.VP.realEstate.current>>
<<if !_property or !maplebirch.VP.realEstate.owns(_property.id) or maplebirch.VP.realEstate.managementFor(_property.id).rented or !maplebirch.get('LS')>>
	<<lanSwitch 'The desk is unavailable.' '书桌暂时不能用。'>><br><br>
<<else>>
	<<run maplebirch.VP.realEstate.enter()>><<effects>>
	<<set _resident to maplebirch.VP.realEstate.residentsHome(_property.id)[0]>>
	<<set _prepared to currentSkillValue('maths') gte 500 or ($phase is 'together' and _resident)>>
	<<if maplebirch.LS.school.organiseStudySession(_prepared)>>
		<<language>>
			<<option 'EN'>>You spread lesson notes and the student council's plan across the desk. The lamp leaves enough room to sort each subject into a separate pile.
			<<option 'CN'>>你把课堂笔记与学生会的计划摊在书桌上。灯下的地方够大，每门课都能分成单独一叠。
		<</language>><br><br>
		<<if $phase is 'together' and _resident>>
			<<npc _resident.id>><<person1>>
			<<switch _resident.id>>
				<<case 'Robin'>><<lanSwitch 'Robin checks the sums against the shop ledger and spots the page you had skipped.' '罗宾拿店里的账本对照算式，找出你漏掉的一页。'>>
				<<case 'Whitney'>><<lanSwitch 'Whitney calls the plan dull, then draws a bold heading that the other students will actually notice.' '惠特尼嫌计划写得太闷，却替你画了个其他学生一定会注意的标题。'>>
				<<case 'Kylar'>><<lanSwitch 'Kylar reads each instruction twice and marks where a nervous student might need more time.' '凯拉尔把每条说明读了两遍，标出容易让紧张的学生跟不上的地方。'>>
				<<case 'Sydney'>><<lanSwitch 'Sydney compares the notes with the temple library copy and quietly corrects a citation.' '悉尼拿神殿图书馆的抄本对照笔记，悄悄改好一处引文。'>>
			<</switch>><br>
			<<npcincr _resident.id love 1>><<glove>>
		<<elseif currentSkillValue('maths') gte 500>>
			<<lanSwitch 'You catch a mistake in the figures before copying the plan for the other students.' '你在誊写给其他学生之前，发现一处算错的数字。'>><br>
		<<else>>
			<<lanSwitch 'The outline is usable, though you leave the difficult examples for a teacher to check.' '大纲已经能用，难题部分还要请老师核对。'>><br>
		<</if>>
		<<deadwood-reblooms-life-simulation-school-feedback>>
	<</if>>
<</if>>
<br><<deskchairicon>><<lanLink '返回书桌' 'Deadwood Reblooms Property Desk'>><</lanLink>>

:: Deadwood Reblooms Property Mirror []
<<set _property to maplebirch.VP.realEstate.current>>
<<if !_property || !maplebirch.VP.realEstate.owns(_property.id) || maplebirch.VP.realEstate.managementFor(_property.id).rented>>
	<<lanLink '返回房产中介' 'Deadwood Reblooms Property Office'>><</lanLink>>
<<else>>
	<<run maplebirch.VP.realEstate.enter()>><<effects>>
	<!-- 发现记录和通道来源都在当前存档的 $VanillaPlus 中。此处不借用孤儿院镜子的 home 标记。 -->
	<<run maplebirch.VP.deviancy.discover('property', _property.id)>>
	<<getouticon>><<lanLink '走开' 'Deadwood Reblooms Property Bedroom'>><<unset $mirrorMenu>><<unset $bodywritingSet>><<postMirror>><</lanLink>><br>
	<<deadwood-reblooms-deviancy-mirror-enter-link 'property'>>
	<<mirror>><br><br>
<</if>>

:: Deadwood Reblooms Property Bathroom []
<<set _property to maplebirch.VP.realEstate.current>>
<<if !_property || !maplebirch.VP.realEstate.owns(_property.id) || maplebirch.VP.realEstate.managementFor(_property.id).rented>>
	<<lanLink '返回房产中介' 'Deadwood Reblooms Property Office'>><</lanLink>>
<<else>>
	<<run maplebirch.VP.realEstate.enter()>><<effects>>
	<<= lanSwitch(_property.interior.bathroom.EN, _property.interior.bathroom.CN)>><br><br>
	<<bathroomicon 'bath'>><<lanLink '泡澡 (0:30)' 'Deadwood Reblooms Property Bath'>><<strip>><<pass 30>><<stress -6>><<set $hygiene to 0>><</lanLink>><<lstress>><br>
	<<personalUpkeep>>
	<<pregnancyTest 'Deadwood Reblooms Property Bathroom'>>
	<br>
	<<if _property.rooms.bathroom is 1>>
		<<getouticon>><<lanLink '起居室 (0:01)' 'Deadwood Reblooms Property Home'>><<pass 1>><</lanLink>>
	<<else>>
		<<getouticon>><<lanLink '返回楼梯间 (0:01)' 'Deadwood Reblooms Property Landing'>><<pass 1>><</lanLink>>
	<</if>>
<</if>>

:: Deadwood Reblooms Property Bath []
<<set _property to maplebirch.VP.realEstate.current>>
<<if !_property || !maplebirch.VP.realEstate.owns(_property.id) || maplebirch.VP.realEstate.managementFor(_property.id).rented>>
	<<lanLink '返回房产中介' 'Deadwood Reblooms Property Office'>><</lanLink>>
<<else>>
	<<run maplebirch.VP.realEstate.enter()>><<effects>><<wash>>
	<<language>>
		<<option 'EN'>>You wash in the privacy of your own bathroom. Warm water runs down the drain, <span class='teal'>taking the grime of the day with it</span>.
		<<option 'CN'>>你在自己的浴室里洗了个澡。温水流进下水道，<span class='teal'>也带走了身上的污垢</span>。
	<</language>><br><br>
	<<getouticon>><<lanLink '离开浴缸' 'Deadwood Reblooms Property Bathroom'>><</lanLink>>
<</if>>

:: Deadwood Reblooms Property Kitchen []
<<set _property to maplebirch.VP.realEstate.current>>
<<if !_property || !maplebirch.VP.realEstate.owns(_property.id) || maplebirch.VP.realEstate.managementFor(_property.id).rented>>
	<<lanLink '返回房产中介' 'Deadwood Reblooms Property Office'>><</lanLink>>
<<else>>
	<<run maplebirch.VP.realEstate.enter()>><<effects>>
	<<= lanSwitch(_property.interior.kitchen.EN, _property.interior.kitchen.CN)>><br><br>
	<<for _resident range maplebirch.VP.realEstate.residentsHome(_property.id)>>
		<<switch _resident.id>>
			<<case 'Robin'>>
				<<language>>
					<<option 'EN'>>
						Robin has put two plates on the table and <span class='teal'>left the second chair out for you</span>.
					<<option 'CN'>>
						罗宾在桌上摆了两只盘子，还<span class='teal'>给你留出了另一张椅子</span>。
				<</language>>
			<<case 'Whitney'>>
				<<language>>
					<<option 'EN'>>Whitney is looking through the cupboard. "What are you making?" <<He>> asks without turning around.
					<<option 'CN'>>惠特尼正在翻橱柜。“你要做什么？”<<He>>头也不回地问。
				<</language>>
			<<case 'Kylar'>>
				<<language>>
					<<option 'EN'>>Kylar stays close to the worktop, watching your hands. <<He>> offers to wash anything you use.
					<<option 'CN'>>凯拉尔靠在操作台旁，看着你的动作。<<He>>说用过的碗可以交给<<him>>洗。
				<</language>>
			<<case 'Sydney'>>
				<<language>>
					<<option 'EN'>>Sydney sets a clean cup beside yours, then <span class='teal'>rolls up <<his>> sleeves to help</span>.
					<<option 'CN'>>悉尼把一只干净的杯子放在你的杯子旁，随后<span class='teal'>卷起袖子准备帮忙</span>。
				<</language>>
		<</switch>><br><br>
	<</for>>
	<<if Time.dayState is 'night'>>
		<<lanSwitch 'The kitchen light falls across the worktop.' '厨房的灯光落在操作台上。'>><br><br>
	<<elseif Time.hour lt 11>>
		<<lanSwitch 'There is room to prepare breakfast.' '这里有地方准备早餐。'>><br><br>
	<<else>>
		<<lanSwitch 'The worktop is ready for whatever you have brought home.' '操作台空着，等你处理带回家的食材。'>><br><br>
	<</if>>
	<!-- 与原版厨房共用食材、菜谱和烹饪时间。房产不免费提供食材。 -->
	<<ingredientsSupplied>><<allowLewdIngredients>><<kitchenDisplay>>
	<<if _property.rooms.kitchen is 1>>
		<<getouticon>><<lanLink '起居室 (0:01)' 'Deadwood Reblooms Property Home'>><<kitchenExit>><<pass 1>><</lanLink>>
	<<else>>
		<<getouticon>><<lanLink '返回楼梯间 (0:01)' 'Deadwood Reblooms Property Landing'>><<kitchenExit>><<pass 1>><</lanLink>>
	<</if>>
<</if>>

:: Deadwood Reblooms Property Outdoor []
<<set _property to maplebirch.VP.realEstate.current>>
<<if !_property || !maplebirch.VP.realEstate.owns(_property.id) || maplebirch.VP.realEstate.managementFor(_property.id).rented>>
	<<lanLink '返回房产中介' 'Deadwood Reblooms Property Office'>><</lanLink>>
<<else>>
	<<run maplebirch.VP.realEstate.enter()>><<set $outside to 1>><<effects>>
	<<= lanSwitch(_property.interior.outdoor.EN, _property.interior.outdoor.CN)>><br><br>
	<<for _resident range maplebirch.VP.realEstate.residentsHome(_property.id)>>
		<<switch _resident.id>>
			<<case 'Robin'>>
				<<language>>
					<<option 'EN'>>
						Robin comes outside with you and stays close. <span class='teal'>For once, neither of you has to hurry back to the orphanage.</span>
					<<option 'CN'>>
						罗宾跟着你出来，站在你身旁。<span class='teal'>这一回，你们都不用急着赶回孤儿院。</span>
				<</language>>
			<<case 'Whitney'>>
				<<language>>
					<<option 'EN'>>Whitney leans beside you. <<He>> watches the view while pretending not to watch you.
					<<option 'CN'>>惠特尼靠在你身旁。<<He>>望着外面，装作没有留意你。
				<</language>>
			<<case 'Kylar'>>
				<<language>>
					<<option 'EN'>>
						Kylar steps outside after you and <span class='teal'>takes hold of your sleeve</span>.
					<<option 'CN'>>
						凯拉尔跟着你出来，<span class='teal'>轻轻攥住你的衣袖</span>。
				<</language>>
			<<case 'Sydney'>>
				<<language>>
					<<option 'EN'>>Sydney comes out for a breath of air. <span class='teal'><<His>> hand finds yours</span>.
					<<option 'CN'>>悉尼出来透了口气，随后<span class='teal'>握住你的手</span>。
				<</language>>
		<</switch>><br><br>
	<</for>>
	<<if Weather.precipitation is 'rain'>>
		<<if _property.id is 'domus' or _property.id is 'danube'>>
			<<lanSwitch 'Rain darkens the garden path.' '雨水浸湿了花园的小径。'>><br><br>
		<<else>>
			<<lanSwitch 'Rain patters against the railing and dampens the ground.' '雨滴敲在栏杆上，打湿了地面。'>><br><br>
		<</if>>
	<<elseif Weather.isSnow>>
		<<if _property.id is 'domus' or _property.id is 'danube'>>
			<<lanSwitch 'Snow settles along the garden path.' '花园小径上落了一层雪。'>><br><br>
		<<else>>
			<<lanSwitch 'Snow settles on the rail and the path below.' '雪落在栏杆和下方的小径上。'>><br><br>
		<</if>>
	<<elseif Time.dayState is 'night'>>
		<<lanSwitch 'The lights beyond your home stand out against the dark.' '夜色里，屋外的灯光格外显眼。'>><br><br>
	<<else>>
		<<lanSwitch 'The air is clear enough to linger outside.' '空气清朗，适合在外面待一会儿。'>><br><br>
	<</if>>
	<<if _property.id is 'domus'>>
		<!-- 原版所有苗圃都存于 $plots，时间事件会让这里的单块小苗圃正常生长。 -->
		<<if !$plots.domus>><<plots_init domus 1 earth 1 small>><</if>>
		<<plot_effects>>
		<<display_plot domus>>
	<<elseif _property.id is 'high'>>
		<!-- 店铺上方的浅木箱只容得下一块小苗圃，不与小屋或宅邸共用作物。 -->
		<<if !$plots.high>><<plots_init high 1 earth 2 small>><</if>>
		<<plot_effects>>
		<<display_plot high>>
	<<elseif _property.id is 'danube'>>
		<<gardenicon>><<lanLink '走进花园 (0:01)' 'Deadwood Reblooms Property Garden'>><<pass 1>><</lanLink>><br><br>
	<</if>>
	<<deadwood-reblooms-property-outdoor-icon _property.id>>
	<<lanLink '看看外面 (0:10)' 'Deadwood Reblooms Property Outdoor View'>><<pass 10>><</lanLink>><br><br>
	<<if _property.outdoor_access is 'sitting'>>
		<<getouticon>><<lanLink '起居室 (0:01)' 'Deadwood Reblooms Property Home'>><<pass 1>><</lanLink>>
	<<elseif _property.outdoor_access is 'retreat'>>
		<<getouticon>><<lanLink _property.interior.retreat_label.CN 'Deadwood Reblooms Property Retreat'>><<pass 1>><</lanLink>>
	<<else>>
		<<getouticon>><<lanLink '返回楼梯间 (0:01)' 'Deadwood Reblooms Property Landing'>><<pass 1>><</lanLink>>
	<</if>>
<</if>>

:: Deadwood Reblooms Property Garden []
<<set _property to maplebirch.VP.realEstate.current>>
<<if !_property || _property.id isnot 'danube' || !maplebirch.VP.realEstate.owns('danube') || maplebirch.VP.realEstate.managementFor('danube').rented>>
	<<lanLink '返回房产中介' 'Deadwood Reblooms Property Office'>><</lanLink>>
<<else>>
	<<run maplebirch.VP.realEstate.enter()>><<set $outside to 1>><<effects>>
	<<lanSwitch
		'The terrace lies behind you. Three planting beds run along the garden path, sheltered from the street by the high wall.'
		'花园露台在你身后。三块苗圃沿着小径排开，高墙挡住了街上的视线。'
	>><br><br>
	<!-- 与小屋使用不同的原版种植地点，跨日成长和收获互不覆盖。 -->
	<<if !$plots.danube>><<plots_init danube 3 earth 3 medium>><</if>>
	<<plot_effects>>
	<<display_plot danube>>
	<<getouticon>><<lanLink '返回花园露台 (0:01)' 'Deadwood Reblooms Property Outdoor'>><<pass 1>><</lanLink>>
<</if>>

:: Deadwood Reblooms Property Balcony []
<<set _property to maplebirch.VP.realEstate.current>>
<<if !_property || _property.id isnot 'danube' || !maplebirch.VP.realEstate.owns('danube') || maplebirch.VP.realEstate.managementFor('danube').rented>>
	<<lanLink '返回房产中介' 'Deadwood Reblooms Property Office'>><</lanLink>>
<<else>>
	<<run maplebirch.VP.realEstate.enter()>><<set $outside to 1>><<effects>>
	<<= lanSwitch(_property.interior.balcony.EN, _property.interior.balcony.CN)>><br><br>
	<<if Weather.precipitation is 'rain'>>
		<<lanSwitch 'Rain runs along the stone rail.' '雨水沿着石栏杆流下。'>><br><br>
	<<elseif Weather.isSnow>>
		<<lanSwitch 'Snow gathers on the rail and the garden below.' '栏杆和下方花园都覆着雪。'>><br><br>
	<<elseif Time.dayState is 'night'>>
		<<lanSwitch 'The garden paths are pale in the moonlight.' '花园的小径在月色里泛着微光。'>><br><br>
	<</if>>
	<<lanLink '俯瞰花园 (0:10)' 'Deadwood Reblooms Property Balcony View'>><<pass 10>><</lanLink>><br>
	<<if Weather.precipitation isnot 'rain' && !Weather.isSnow>>
		<<lanLink '在阳台坐一会儿 (0:15)' 'Deadwood Reblooms Property Balcony Rest'>><<pass 15>><<stress -2>><</lanLink>><<lstress>><br>
	<</if>>
	<!-- 原版翅膀特质本身就允许从高处下降。鸟翼即使被拔羽仍能滑翔。 -->
	<<if $harpy gte 6>>
		<<glideicon>><<lanLink '滑翔到花园 (0:02)' 'Deadwood Reblooms Property Balcony Glide'>><<bird_pass 2>><<endevent>><</lanLink>><br>
	<<elseif $angel gte 6 or $demon gte 6 or $fallenangel gte 2>>
		<<if $pain gte 21>>
			<span class='purple'><<lanSwitch 'Your wings could carry you down, but you are too injured to jump.' '翅膀本可以带你滑下去，但你伤得太重，不能冒险跃出阳台。'>></span><br>
		<<elseif $birdFly is 1 or $birdGlide is 1>>
			<<glideicon>><<lanLink '滑翔到花园 (0:02)' 'Deadwood Reblooms Property Balcony Glide'>><<bird_pass 2>><<endevent>><</lanLink>><br>
		<<elseif currentSkillValue('willpower') lt 250>>
			<span class='red'><<lanSwitch 'You cannot bring yourself to jump from the balcony.' '你鼓不起勇气从阳台跃下。'>></span><br>
		<<elseif $VanillaPlus.real_estate.glide_scared_day is Time.days>>
			<span class='red'><<lanSwitch 'You are still too frightened to try again today.' '今天你仍不敢再试一次。'>></span><br>
		<<else>>
			<<glideicon>>
			<<lanLink '尝试滑翔到花园 (0:02)' 'Deadwood Reblooms Property Balcony Glide Attempt'>>
				<<bird_pass 2>><<endevent>>
			<</lanLink>><<willpowerdifficulty 250 1100>><br>
		<</if>>
	<</if>>
	<br>
	<<getouticon>><<lanLink '返回楼梯间 (0:01)' 'Deadwood Reblooms Property Landing'>><<pass 1>><</lanLink>>
<</if>>

:: Deadwood Reblooms Property Balcony View []
<<set _property to maplebirch.VP.realEstate.current>>
<<if !_property || _property.id isnot 'danube' || !maplebirch.VP.realEstate.owns('danube') || maplebirch.VP.realEstate.managementFor('danube').rented>>
	<<lanLink '返回房产中介' 'Deadwood Reblooms Property Office'>><</lanLink>>
<<else>>
	<<run maplebirch.VP.realEstate.enter()>><<set $outside to 1>><<effects>>
	<<= lanSwitch(_property.interior.balcony_view.EN, _property.interior.balcony_view.CN)>><br><br>
	<<lanLink '返回二层阳台 (0:01)' 'Deadwood Reblooms Property Balcony'>><<pass 1>><</lanLink>>
<</if>>

:: Deadwood Reblooms Property Balcony Rest []
<<set _property to maplebirch.VP.realEstate.current>>
<<if !_property || _property.id isnot 'danube' || !maplebirch.VP.realEstate.owns('danube') || maplebirch.VP.realEstate.managementFor('danube').rented>>
	<<lanLink '返回房产中介' 'Deadwood Reblooms Property Office'>><</lanLink>>
<<else>>
	<<run maplebirch.VP.realEstate.enter()>><<set $outside to 1>><<effects>>
	<<lanSwitch 'You settle into a chair beneath the eaves. The walls keep out the street noise, and the garden is still.' '你坐进檐下的椅子。围墙挡住了街上的喧闹，花园里一片安静。'>><br><br>
	<<lanLink '返回二层阳台 (0:01)' 'Deadwood Reblooms Property Balcony'>><<pass 1>><</lanLink>>
<</if>>

:: Deadwood Reblooms Property Balcony Glide []
<<set _property to maplebirch.VP.realEstate.current>>
<<if !_property || _property.id isnot 'danube' || !maplebirch.VP.realEstate.owns('danube') || maplebirch.VP.realEstate.managementFor('danube').rented>>
	<<lanLink '返回房产中介' 'Deadwood Reblooms Property Office'>><</lanLink>>
<<else>>
	<<run maplebirch.VP.realEstate.setFloor(1)>><<run maplebirch.VP.realEstate.enter()>><<set $outside to 1>><<effects>>
	<<language>>
		<<option 'EN'>>
			You spread your wings and glide across the garden. <span class='green'>Your feet find the path between the planting beds.</span>
		<<option 'CN'>>
			你展开翅膀，从花园上方滑过，<span class='green'>落在苗圃之间的小径上。</span>
	<</language>>
	<br><br>
	<<gardenicon>><<lanLink '走进花园 (0:01)' 'Deadwood Reblooms Property Garden'>><<pass 1>><</lanLink>>
<</if>>

:: Deadwood Reblooms Property Balcony Glide Attempt []
<<set _property to maplebirch.VP.realEstate.current>>
<<if !_property || _property.id isnot 'danube' || !maplebirch.VP.realEstate.owns('danube') || maplebirch.VP.realEstate.managementFor('danube').rented>>
	<<lanLink '返回房产中介' 'Deadwood Reblooms Property Office'>><</lanLink>>
<<else>>
	<<run maplebirch.VP.realEstate.enter()>><<set $outside to 1>><<effects>>
	<<lanSwitch 'You step up to the stone rail and spread your wings.' '你走到石栏杆前，展开翅膀。'>><br><br>
	<<if $willpowerSuccess>>
		<<set $birdGlide to 1>>
		<span class='green'><<lanSwitch 'You steady yourself. The garden waits below.' '你稳住心神。花园就在下方。'>></span><<gwillpower>><<willpower 1>><br><br>
		<<glideicon>><<lanLink '滑翔到花园' 'Deadwood Reblooms Property Balcony Glide'>><<endevent>><</lanLink>><br>
	<<else>>
		<<set $VanillaPlus.real_estate.glide_scared_day to Time.days>>
		<span class='red'><<lanSwitch 'You draw back from the edge. You cannot make yourself jump.' '你从阳台边退开，终究没能跳下去。'>></span><br><br>
	<</if>>
	<<getouticon>><<lanLink '返回二层阳台 (0:01)' 'Deadwood Reblooms Property Balcony'>><<pass 1>><</lanLink>>
<</if>>

:: Deadwood Reblooms Property Outdoor View []
<<set _property to maplebirch.VP.realEstate.current>>
<<if !_property || !maplebirch.VP.realEstate.owns(_property.id) || maplebirch.VP.realEstate.managementFor(_property.id).rented>>
	<<lanLink '返回房产中介' 'Deadwood Reblooms Property Office'>><</lanLink>>
<<else>>
	<<run maplebirch.VP.realEstate.enter()>><<set $outside to 1>><<effects>>
	<<= lanSwitch(_property.interior.outdoor_view.EN, _property.interior.outdoor_view.CN)>><br><br>
	<<getouticon>><<lanLink _property.interior.outdoor_label.CN 'Deadwood Reblooms Property Outdoor'>><<pass 1>><</lanLink>>
<</if>>

:: Deadwood Reblooms Property Guest Bedroom []
<<set _property to maplebirch.VP.realEstate.current>>
<<if !_property || !maplebirch.VP.realEstate.owns(_property.id) || maplebirch.VP.realEstate.managementFor(_property.id).rented || !_property.interior.guest>>
	<<lanLink '返回房产中介' 'Deadwood Reblooms Property Office'>><</lanLink>>
<<else>>
	<<run maplebirch.VP.realEstate.enter()>><<effects>>
	<<= lanSwitch(_property.interior.guest.EN, _property.interior.guest.CN)>><br><br>
	<<if maplebirch.VP.realEstate.residentsAt(_property.id).length gt 1>>
		<<set _guestResident to maplebirch.VP.realEstate.residentsAt(_property.id)[1]>>
		<<= maplebirch.auto(_guestResident.id)>> <<lanSwitch 'keeps their things here.' '把自己的东西放在这里。'>><br><br>
	<</if>>
	<<getouticon>><<lanLink '返回楼梯间 (0:01)' 'Deadwood Reblooms Property Landing'>><<pass 1>><</lanLink>>
<</if>>

:: Deadwood Reblooms Property Retreat []
<<set _property to maplebirch.VP.realEstate.current>>
<<if !_property || !maplebirch.VP.realEstate.owns(_property.id) || maplebirch.VP.realEstate.managementFor(_property.id).rented || !_property.interior.retreat>>
	<<lanLink '返回房产中介' 'Deadwood Reblooms Property Office'>><</lanLink>>
<<else>>
	<<run maplebirch.VP.realEstate.enter()>><<effects>>
	<<= lanSwitch(_property.interior.retreat.EN, _property.interior.retreat.CN)>><br><br>
	<<couchicon>><<lanLink '休息片刻 (0:15)' 'Deadwood Reblooms Property Retreat Rest'>><<pass 15>><<stress -2>><<tiredness -4>><</lanLink>><<lstress>><<ltiredness>><br>
	<<if _property.outdoor_access is 'retreat'>>
		<<deadwood-reblooms-property-outdoor-icon _property.id>>
		<<lanLink _property.interior.outdoor_label.CN 'Deadwood Reblooms Property Outdoor'>><<pass 1>><</lanLink>><br>
	<</if>>
	<br>
	<<if _property.rooms.retreat is 1>>
		<<getouticon>><<lanLink '起居室 (0:01)' 'Deadwood Reblooms Property Home'>><<pass 1>><</lanLink>>
	<<else>>
		<<getouticon>><<lanLink '返回楼梯间 (0:01)' 'Deadwood Reblooms Property Landing'>><<pass 1>><</lanLink>>
	<</if>>
<</if>>

:: Deadwood Reblooms Property Retreat Rest []
<<set _property to maplebirch.VP.realEstate.current>>
<<if !_property || !maplebirch.VP.realEstate.owns(_property.id) || maplebirch.VP.realEstate.managementFor(_property.id).rented || !_property.interior.retreat_rest>>
	<<lanLink '返回房产中介' 'Deadwood Reblooms Property Office'>><</lanLink>>
<<else>>
	<<run maplebirch.VP.realEstate.enter()>><<effects>>
	<<= lanSwitch(_property.interior.retreat_rest.EN, _property.interior.retreat_rest.CN)>><br><br>
	<<lanLink '起身' 'Deadwood Reblooms Property Retreat'>><</lanLink>>
<</if>>

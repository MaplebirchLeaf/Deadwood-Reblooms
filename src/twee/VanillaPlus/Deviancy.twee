:: Deadwood Reblooms Deviancy Mirror Enter []
<<location 'tentworld'>><<set $outside to 0>><<effects>><<tentacleworldintro>><<set $tentacleEntrance to 'vanillaPlusMirror'>>
<<set _mirrorArrival to $VanillaPlus.deviancy.mirror_locations[$VanillaPlus.deviancy.mirrorOrigin]>>
<<if _mirrorArrival>>
  <<set $tentnorth to _mirrorArrival.north>>
  <<set $tenteast to _mirrorArrival.east>>
<</if>>
<<if $VanillaPlus.deviancy.mirror_day isnot Time.days>>
  <<set $VanillaPlus.deviancy.mirror_day to Time.days>><<deviancy6>>
<</if>>
<<language>>
  <<option 'EN'>>
    The glass clings to your skin like a <span class="purple">wet membrane</span>. You force your body through and spill out beneath the
    alien sky of the tentacle plains.
  <<option 'CN'>>
    镜面如<span class="purple">湿润的薄膜</span>般贴紧你的皮肤。你迫使身体穿过其中，跌入触手平原陌生的天空之下。
<</language>>
<br><br>
<<lanLink '继续' 'Tentacle Plains'>><</lanLink>>

:: Deadwood Reblooms Deviancy Mirror Home []
<<set $location to 'home'>><<set $outside to 0>><<deadwood-reblooms-mirror-exit 'home'>>
<<language>>
  <<option 'EN'>>
    You force yourself through the rippling surface and tumble <span class="green">back into your bedroom</span>.
  <<option 'CN'>>
    你挤过荡漾的镜面，<span class="green">跌回自己的卧室</span>。
<</language>>
<br><br>
<<lanLink '继续' 'Bedroom'>><</lanLink>>

:: Deadwood Reblooms Deviancy Mirror Property []
<<if $VanillaPlus.deviancy.mirror_property and maplebirch.get("VP").realEstate.visit($VanillaPlus.deviancy.mirror_property)>>
  <<run maplebirch.get("VP").realEstate.enter()>><<deadwood-reblooms-mirror-exit ('property:' + $VanillaPlus.deviancy.mirror_property)>>
  <<language>>
    <<option 'EN'>>
      You push through the glass and find <span class="green">your own bedroom</span> on the other side. The air smells of the house again.
    <<option 'CN'>>
      你挤过镜面，<span class="green">回到了自己的卧室</span>。房间熟悉的气息重新包围了你。
  <</language>>
  <br><br>
  <<lanLink '继续' 'Deadwood Reblooms Property Bedroom'>><</lanLink>>
<<else>>
  <<set $location to 'home'>><<set $outside to 0>><<deadwood-reblooms-mirror-exit>>
  <<lanLink '继续' 'Bedroom'>><</lanLink>>
<</if>>


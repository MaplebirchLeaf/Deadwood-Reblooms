:: Deadwood Ghostbrew Widgets [widget]

<!-- 检查结果供入口、点击回调与结果页共用，不改写原版委托、配方或材料来源。 -->
<<widget 'deadwood-ghostbrew-check'>>
  <<set _ghostbrewSafe to !!maplebirch.get('VanillaPlus') and !$combat and !$possessed
    and !$replayScene and !$statFreeze and !$frozenValues and !$eventforced
    and !$nextPassage and !$nextPassageCheck and !isPregnancyEnding()>>
  <<set _ghostbrewTeacher to _ghostbrewSafe and $location is 'forest_shop'
    and $forest_shop_intro is 1 and C.npc.Gwylan.init is 1 and C.npc.Gwylan.state is 'active'
    and $npc?.includes('Gwylan') and gwylanSchedule() is 'shop' and !isGwylanAbsent()
    and !$daily.gwylan.noTalk and !$robin_in_forest_shop and !$gwylan.punishment
    and !$gwylan.taken and !$gwylan.timer.wrap and !$gwylan.timer.eventShopEnd>>
<</widget>>

<<widget 'deadwood-ghostbrew-lesson-link'>>
  <<deadwood-ghostbrew-check>>
  <<if _ghostbrewTeacher and $foodstuff.ghostshroom?.amount gte 1 and !$foodstuff.ghostbrew?.knows_recipe>>
    <<foodstufficon 'ghostshroom'>><<lanLink ['Ask about the pale mushrooms (0:10)', '问问这些灰白色的蘑菇 (0:10)'] 'Deadwood Ghostbrew Lesson'>>
      <<deadwood-ghostbrew-check>>
      <<if _ghostbrewTeacher and $foodstuff.ghostshroom?.amount gte 1 and !$foodstuff.ghostbrew?.knows_recipe>>
        <<set $phase to 'deadwood-ghostbrew-lesson'>>
      <</if>>
    <</lanLink>><br>
  <<elseif _ghostbrewTeacher and $foodstuff.ghostbrew?.knows_recipe and $foodstuff.ghostbrew.amount gte 1>>
    <<foodstufficon 'ghostbrew'>><<lanLink ['Show Gwylan your ghostbrew (0:05)', '请格威岚看看幽灵菇酒 (0:05)'] 'Deadwood Ghostbrew Review'>>
      <<deadwood-ghostbrew-check>>
      <<if _ghostbrewTeacher and $foodstuff.ghostbrew?.knows_recipe and $foodstuff.ghostbrew.amount gte 1>>
        <<set $phase to 'deadwood-ghostbrew-review'>>
      <</if>>
    <</lanLink>><br>
  <</if>>
<</widget>>

:: Deadwood Ghostbrew Lesson
<<set _ghostbrewLesson to $phase is 'deadwood-ghostbrew-lesson'>>
<<if _ghostbrewLesson>><<unset $phase>><</if>>
<<effects>><<deadwood-ghostbrew-check>>
<<if $nextPassage or $nextPassageCheck>>
  <span id='next'><<lanLink ['Next', '继续'] $passage>><</lanLink>></span><<nexttext>><<exit>>
<</if>>
<<if _ghostbrewLesson and _ghostbrewTeacher
  and $foodstuff.ghostshroom?.amount gte 1 and !$foodstuff.ghostbrew?.knows_recipe>>
  <<pass 10>><<deadwood-ghostbrew-check>>
  <<if $passage isnot 'Deadwood Ghostbrew Lesson'>><<exit>><</if>>
  <<if $nextPassage or $nextPassageCheck>>
    <span id='next'><<lanLink ['Next', '继续'] $passage>><</lanLink>></span><<nexttext>><<exit>>
  <</if>>
  <<if _ghostbrewTeacher>>
    <<npc Gwylan>><<person1>>
    <<language>>
      <<option 'CN'>>
        你拿出一朵灰白色的蘑菇。格威岚托住你的手，翻过菌盖，看了看底下的褶皱。
        <br><br>
        “幽灵菇。摸起来凉凉的，对不对？”<<He>>把蘑菇放回你手里。“可别见到白蘑菇就往嘴里送。得认准了。”
        <br><br>
        <<He>>从柜台下找出纸笔，写下几行字。“用白葡萄酒和这种花来煮，味道会好一些。”<<He>>在花名下画了一道线。“这酒会让人看见些原本没有的东西。找个地方坐稳了再喝，亲爱的。”
        <br><br>
        你收好配方。纸上还注明了用量和火候，煮好一瓶大约要一个小时。
      <<option 'EN'>>
        You take out a pale mushroom. Gwylan steadies your hand and turns the cap over to inspect its gills.
        <br><br>
        "A ghostshroom. Cold to the touch, isn't it?" <<He>> puts it back in your hand. "Don't go eating every white mushroom you find, though. Make sure you know what you're picking."
        <br><br>
        <<He>> finds paper and a pen beneath the counter. "Simmer it with white wine and this flower. It tastes a little better that way." <<He>> underlines the flower's name. "It will make you see things that aren't there. Find somewhere to sit before you drink it, dear."
        <br><br>
        You put the recipe away. It includes quantities and cooking instructions. A bottle takes about an hour to prepare.
    <</language>><br><br>
    <<learn_recipe 'ghostbrew'>>
  <<else>>
    <<lanSwitch 'Gwylan has to leave before you can finish. You put the mushroom away.' '还没来得及问完，格威岚便要离开了。你把蘑菇收好。'>>
  <</if>>
<<else>>
  <<lanSwitch 'You put the mushroom away for now.' '你暂且把蘑菇收好。'>>
<</if>>
<br><br>
<<getouticon>><<lanLink [
  _ghostbrewTeacher ? 'Return to Gwylan' : 'Return to the shop entrance',
  _ghostbrewTeacher ? '回到格威岚身边' : '返回商店门口'
] `_ghostbrewTeacher ? 'Gwylan Talk Shop' : 'Forest Shop Entrance'`>><</lanLink>>

:: Deadwood Ghostbrew Review
<<set _ghostbrewReview to $phase is 'deadwood-ghostbrew-review'>>
<<if _ghostbrewReview>><<unset $phase>><</if>>
<<effects>><<deadwood-ghostbrew-check>>
<<if $nextPassage or $nextPassageCheck>>
  <span id='next'><<lanLink ['Next', '继续'] $passage>><</lanLink>></span><<nexttext>><<exit>>
<</if>>
<<if _ghostbrewReview and _ghostbrewTeacher
  and $foodstuff.ghostbrew?.knows_recipe and $foodstuff.ghostbrew.amount gte 1>>
  <<pass 5>><<deadwood-ghostbrew-check>>
  <<if $passage isnot 'Deadwood Ghostbrew Review'>><<exit>><</if>>
  <<if $nextPassage or $nextPassageCheck>>
    <span id='next'><<lanLink ['Next', '继续'] $passage>><</lanLink>></span><<nexttext>><<exit>>
  <</if>>
  <<if _ghostbrewTeacher and $foodstuff.ghostbrew?.amount gte 1>>
    <<npc Gwylan>><<person1>>
    <<language>>
      <<option 'CN'>>
        你把幽灵菇酒放到柜台上。格威岚将瓶子举到光下，轻轻晃了晃，拔开瓶塞闻了一下。
        <br><br>
        “看来你没把它煮干。”<<He>>笑了笑，将瓶子放回你面前。“颜色也对。花放得太多，就会盖住蘑菇的气味。”
        <br><br>
        <<He>>替你塞好瓶口。“别一口喝完，亲爱的。就算看见地板在动，也先别急着站起来。”
        <br><br>
        你收起酒瓶。隔着瓶身，指尖还能感觉到那股凉意。
      <<option 'EN'>>
        You set your ghostbrew on the counter. Gwylan holds the bottle up to the light, swirls it gently, and removes the cork for a sniff.
        <br><br>
        "Well, you haven't boiled it dry." <<He>> smiles and sets it back in front of you. "The colour looks right, too. Too much flower masks the smell of the mushrooms."
        <br><br>
        <<He>> replaces the cork. "Don't drink it all at once, dear. If the floor starts moving, give it a moment before you stand up."
        <br><br>
        You put the bottle away. You can still feel its chill through the glass.
    <</language>>
  <<elseif !_ghostbrewTeacher>>
    <<lanSwitch 'Gwylan has to leave before you can show the bottle. You put it away.' '还没来得及拿出酒瓶，格威岚便要离开了。你把瓶子收好。'>>
  <<else>>
    <<lanSwitch 'You have no bottle to show Gwylan.' '你没有能拿给格威岚看的酒瓶。'>>
  <</if>>
<<else>>
  <<lanSwitch 'You leave the bottle where it is for now.' '你暂且没有拿出酒瓶。'>>
<</if>>
<br><br>
<<getouticon>><<lanLink [
  _ghostbrewTeacher ? 'Return to Gwylan' : 'Return to the shop entrance',
  _ghostbrewTeacher ? '回到格威岚身边' : '返回商店门口'
] `_ghostbrewTeacher ? 'Gwylan Talk Shop' : 'Forest Shop Entrance'`>><</lanLink>>


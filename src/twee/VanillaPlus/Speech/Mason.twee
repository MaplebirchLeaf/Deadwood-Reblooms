:: Deadwood Reblooms Speech-MASON [widget]

<<widget "speech-mason">>
  <<set _npc_speech to true>>
  <<set $_mason to $NPCList.find(npc => npc.fullDescription === "Mason")>>
  <<set $_masonRomance to (C.npc.Mason.love gte 20) or (C.npc.Mason.lust gte 25)>>
  <<set $_masonInWater to ($location is "pool" or $location is "lake")>>

  <<capture $_mason $_masonInWater $_masonRomance>><<language>>
    <<option 'EN'>>
      <<if $speechkissvirgin>>
        <<if $_masonRomance>>
          Mason's lips tremble against yours with breathtaking tenderness. "Your first kiss? Don't be afraid... just close your eyes and let me lead."
        <<else>>
          Mason's face flushes scarlet as your lips touch. "W-wait... was that your first? I... take a slow breath..."
        <</if>>
      <<elseif $speechmouthvirgin>>
        <<if $_masonRomance>>
          "Breathe through your nose, steadily," Mason whispers, <<his>> hand gently smoothing your hair. "Don't rush... take your time."
        <<else>>
          Mason swallows dryly, face burning. "B-breathe through your nose... don't choke on it..."
        <</if>>
      <<elseif $speechvaginavirgin or $speechanusvirgin or $speechpenisvirgin>>
        <<if $_masonRomance>>
          Mason pauses, holding you steady with gentle strength as <<he>> waits for your trembling to ease. "I'm right here with you. Take a deep breath... like preparing to dive. We have all the time in the world."
        <<else>>
          Mason freezes, <<his>> knuckles white where <<he>> supports you. "Hold on... take a deep breath. Relax your muscles, don't tense up."
        <</if>>
      <<elseif $speechpenisbig and $player.penissize gte 7>>
        Mason stares down, eyes wide in disbelief as <<his>> face turns beet red. "That's... incredible... how do you even swim with something that size?"
      <<elseif $speechpenisbig and $player.penissize gte 4>>
        Mason glances down with an awkward blush, clearing <<his>> throat. "Well... you're certainly well-developed. Just... be careful with it."
      <<elseif playerChastity("hidden") or playerChastity("cage")>>
        <<if $_masonRomance>>
          Mason touches the cold metal lock, blushing softly. "That device... Winter's work, isn't it? Don't worry, I won't hurt you."
        <<else>>
          Mason notices the metal cage with an embarrassed start. "A-another one of Winter's locks? You really should be more careful around <<nnpc_him 'Winter'>>..."
        <</if>>
      <<elseif $speechhit or $speechstruggle>>
        <<if $_masonRomance>>
          "Careful!" Mason catches your flailing limbs with athletic ease, concerned rather than angry. "You'll slip and hurt yourself... please, tell me what's wrong."
        <<else>>
          "Steady!" Mason catches your wrists, <<his>> grip firm yet careful not to bruise. "Stop struggling, you'll lose your footing!"
        <</if>>
      <<elseif $speechcum>>
        <<if $_masonRomance>>
          Mason cradles your shuddering frame, murmuring soft words of comfort against your ear. "Let it out... you did so well. Just rest against me until your breath returns."
        <<else>>
          Mason supports your weight as you tremble, blushing intensely. "Catch your breath... don't hyperventilate. Deep, steady breaths."
        <</if>>
      <<elseif $_mason?.penis is 'mouth' or $_mason?.vagina is 'mouth'>>
        <<switch random(1, 2)>>
          <<case 1>>
            "Keep your breathing rhythmic," Mason gasps softly, <<his>> fingers curling into your hair with timid warmth. "You're... doing so well..."
          <<case 2>>
            Mason lets out a shuddering sigh, tilting <<his>> head back. "Ah... that feels... so good..."
        <</switch>>
      <<elseif $speechvaginapenetrated or $speechanuspenetrated or $speechpenispenetrated or $speechotheranuspenetrated>>
        <<switch random(1, 3)>>
          <<case 1>>
            "Match my rhythm," Mason whispers, <<his>> athletic hips setting a smooth, steady pace. "Deep breath in... and out. Perfect."
          <<case 2>>
            Mason's arms tighten around you, <<his>> chest slick with sweat and water. "You feel so warm... so tight around me..."
          <<case 3>>
            "Keep your hips steady," Mason murmurs with a flush, kissing your temple. "Just lean into me..."
        <</switch>>
      <<elseif $_masonInWater>>
        <<switch random(1, 3)>>
          <<case 1>>
            "The water supports our weight," Mason whispers, holding you aloft against the gentle currents. "Just relax and float with me."
          <<case 2>>
            Water sloshes against your bodies as Mason moves. "Are you warm enough? Tell me if you feel cold."
          <<case 3>>
            Mason kisses the water droplets from your shoulder, smiling softly. "I love being in the water with you."
        <</switch>>
      <<else>>
        <<switch random(1, 4)>>
          <<case 1>>
            Mason looks at you with pupils dark with affection, a tender blush dusting <<his>> cheeks. "You're wonderful... you know that?"
          <<case 2>>
            "Hold onto my shoulders," Mason whispers, <<his>> toned muscles flexing as <<he>> keeps you balanced.
          <<case 3>>
            Mason pauses for a heartbeat, brushing a damp curl away from your eyes with reverent care.
          <<case 4>>
            <<His>> athletic hands rest warmly against your hips, steady and reassuring.
        <</switch>>
      <</if>>

    <<option 'CN'>>
      <<if $speechkissvirgin>>
        <<if $_masonRomance>>
          梅森微凉的唇瓣贴着你的唇轻颤，带着难以置信的温柔：“这是你的初吻吗……别怕，闭上眼睛，跟着我的呼吸来……”
        <<else>>
          你的唇贴上来时，梅森整张脸瞬间涨红：“等、等等……这是你的第一次接吻吗？我……先慢慢吸气……”
        <</if>>
      <<elseif $speechmouthvirgin>>
        <<if $_masonRomance>>
          “用鼻子呼吸，节奏放平稳，”梅森轻柔地抚平你额前的发丝，贴近耳畔低语，“别急……慢慢来……”
        <<else>>
          梅森喉结剧烈滑动，面颊滚烫：“用、用鼻子吸气……千万别呛着了……”
        <</if>>
      <<elseif $speechvaginavirgin or $speechanusvirgin or $speechpenisvirgin>>
        <<if $_masonRomance>>
          梅森动作一顿，用结实有力的双臂平稳托住你，耐心等待你身体的战栗平息：“我在这陪着你。像准备下潜一样……深吸一口气，我们有的是时间。”
        <<else>>
          梅森猝然僵住，支撑着你的指节因用力而发白：“等等……先深呼吸。把核心肌肉放松，千万别太紧绷。”
        <</if>>
      <<elseif $speechpenisbig and $player.penissize gte 7>>
        梅森难以置信地低头注视，双眼圆睁，整张脸瞬间红透：“这可真是……太惊人了……带着这么大的尺寸，你平时到底怎么游泳的？”
      <<elseif $speechpenisbig and $player.penissize gte 4>>
        梅森尴尬地移开视线，清了清嗓子掩饰脸红：“咳……发育得很出色嘛。只是……动作小心点，别伤着自己。”
      <<elseif playerChastity("hidden") or playerChastity("cage")>>
        <<if $_masonRomance>>
          梅森指尖抚过冰冷的金属锁具，耳尖泛红：“这把锁……又是温特的杰作对吧？别怕，我绝不会弄疼你的。”
        <<else>>
          梅森看着那坚固的锁具，局促地移开视线：“又、又是温特的恶作剧？你在<<nnpc_him 'Winter'>>身边真的该多留点心眼……”
        <</if>>
      <<elseif $speechhit or $speechstruggle>>
        <<if $_masonRomance>>
          “当心！”梅森凭借敏捷的身手轻松接住你乱动的手脚，眼底满是关切而非恼怒，“地面滑，会摔伤自己的……告诉我，哪里不舒服？”
        <<else>>
          “站稳！”梅森稳稳扣住你的手腕，力道坚定却格外注意不弄痛你，“别乱挣扎，小心脚下打滑！”
        <</if>>
      <<elseif $speechcum>>
        <<if $_masonRomance>>
          梅森温柔地抱紧你脱力抽搐的身躯，贴在耳边轻声安抚：“全交给我吧……你做得很棒。靠在我怀里，慢慢把呼吸调匀。”
        <<else>>
          梅森满面通红地托住你的体重，任由你在怀中轻颤：“慢慢喘气……别过度换气。深吸气，慢慢吐出来。”
        <</if>>
      <<elseif $_mason?.penis is 'mouth' or $_mason?.vagina is 'mouth'>>
        <<switch random(1, 2)>>
          <<case 1>>
            “呼吸保持住节奏，”梅森喉间溢出一声微颤的急喘，手指带着羞赧的温存探入你的发间，“你做的……真的很棒……”
          <<case 2>>
            梅森仰起头，发出一声舒服至极的沉重喟叹：“啊……感觉……太舒服了……”
        <</switch>>
      <<elseif $speechvaginapenetrated or $speechanuspenetrated or $speechpenispenetrated or $speechotheranuspenetrated>>
        <<switch random(1, 3)>>
          <<case 1>>
            “跟着我的节奏来，”梅森低声呢喃，腰胯带动着沉稳而流畅的节奏，“深吸一口气……再慢慢呼出来。真棒。”
          <<case 2>>
            梅森双臂紧紧环抱住你，紧实滑腻的胸膛随着动作贴合在一起：“你好温暖……紧得让我快要克制不住了……”
          <<case 3>>
            “把腰放平稳，”梅森面泛红晕地亲吻你的额头，“安心靠在我身上就好……”
        <</switch>>
      <<elseif $_masonInWater>>
        <<switch random(1, 3)>>
          <<case 1>>
            “水流会托起我们的重量，”梅森在柔波中托着你的身躯耳语，“别用力，放松跟着我漂浮就好。”
          <<case 2>>
            清冽的水波随着动作拍打着肌肤。梅森关切地低声问：“水温还适应吗？觉得冷的话一定要告诉我。”
          <<case 3>>
            梅森吻去你肩头的晶莹水珠，眉眼间满是温柔：“能在水里这样和你依偎在一起，真的太好了。”
        <</switch>>
      <<else>>
        <<switch random(1, 4)>>
          <<case 1>>
            梅森深情注视着你，眼底泛着羞涩而炽热的依恋：“你真迷人……你知道吗？”
          <<case 2>>
            “扶稳我的肩膀，”梅森低声叮嘱，背部肌肉随着动作紧绷发力，始终稳稳护住你的重心。
          <<case 3>>
            梅森动作稍稍停顿半拍，充满爱惜地为你拨开贴在眼帘上的汗湿碎发。
          <<case 4>>
            <<His>>有力而温暖的大手稳稳按在你的腰侧，沉稳得令人心安。
        <</switch>>
      <</if>>
  <</language>><</capture>>
<</widget>>

:: Deadwood Reblooms Speech-REMY [widget]

<<widget "speech-remy">>
  <<set _npc_speech to true>>
  <<set _remy to $NPCList.find(npc => npc.fullDescription === "Remy")>>
  <<set $_remyRomance to $Orchard?.remy?.romance or (C.npc.Remy.love gte 40)>>
  <<set $_remyCaptive to $location is "orchard" or $location is "farm" or $livestock_cell>>

  <<language>>
    <<option 'EN'>>
      <<if $speechKissVirgin>>
        <<if $_remyRomance>>
          Remy pauses, a gloved thumb resting on your lip. "First time? Keep your eyes on me, then."
        <<else>>
          Remy holds your chin steady. "Keep your mouth still. You will learn to take it."
        <</if>>
      <<elseif $speechOralVirgin>>
        <<if $_remyRomance>>
          "Breathe through your nose," Remy murmurs, a hand resting in your hair. "I am in no hurry."
        <<else>>
          "Hold still," Remy tells you calmly. "Don't choke."
        <</if>>
      <<elseif $speechVaginaVirgin or $speechAnusVirgin or $speechPenisVirgin>>
        <<if $_remyRomance>>
          Remy waits until your trembling settles, speaking unusually softly. "I know. Breathe with me. We have time."
        <<else>>
          Remy keeps a firm hold on your hips. "Hold the boards. Tensing up only makes it harder on you."
        <</if>>
      <<elseif $speechPenisBig and $player.penissize gte 7>>
        Remy looks down at your size with a sharp intake of breath. "That is... an unreasonable sight. Keep it still before someone gets hurt."
      <<elseif $speechPenisBig and $player.penissize gte 4>>
        Remy glances down, speaking in a measured tone. "You carry more than your share. Try not to get in the way."
      <<elseif (_remy?.penissize gte 5 or C.npc.Remy.penissize gte 5) and ($speechVaginaPenetrated or $speechAnusPenetrated)>>
        <<if $_remyRomance>>
          "Easy," Remy murmurs, resting one broad palm flat on your back. "Give your body time to settle. I am right here."
        <<else>>
          "Hold the rails," Remy commands quietly. "You will learn to take the full measure. The livestock manage it."
        <</if>>
      <<elseif playerChastity("hidden") or playerChastity("cage")>>
        <<if $_remyRomance>>
          Remy touches the metal lock with a faint click of a fingernail. "Safe where it belongs. Let me handle the rest."
        <<else>>
          Remy tugs firmly at the lock. "Well fastened. Good. A restless worker needs firm reins."
        <</if>>
      <<elseif $speechPlayerHits or $speechStruggle>>
        <<if $_remyRomance>>
          "Steady," Remy says, effortlessly catching your movement. "No need to throw your weight around."
        <<else>>
          "Fidgeting only wastes daylight," Remy says coldly, gripping you harder. "Save your breath."
        <</if>>
      <<elseif $speechPlayerOrgasm>>
        <<if $_remyRomance>>
          Remy supports your shaking weight until your breath returns. "Done already? Good <<girl>>."
        <<else>>
          Remy keeps you pinned while your shivering subsides. "Catch your breath. We are not finished yet."
        <</if>>
      <<elseif $speechOral>>
        <<switch random(1, 2)>>
          <<case 1>>
            "Keep your eyes open," Remy says, glove creaking against the back of your head. "Watch what you are doing."
          <<case 2>>
            "Steady your rhythm. Don't rush it," Remy breathes.
        <</switch>>
      <<elseif $speechVaginaPenetrated or $speechAnusPenetrated or $speechNPCVaginaPenetrated or $speechNPCAnusPenetrated>>
        <<switch random(1, 3)>>
          <<case 1>>
            "Keep your hips level," Remy instructs in a low, steady voice. "That's it. Let me set the pace."
          <<case 2>>
            "Good," Remy exhales slowly. "Just like that. You are listening well."
          <<case 3>>
            "Don't lose your footing," Remy warns quietly, leather creaking against your skin.
        <</switch>>
      <<else>>
        <<switch random(1, 4)>>
          <<case 1>>
            Outside the stable wall, someone calls across the yard. Remy listens for a stride, then ignores it.
          <<case 2>>
            "Eyes forward," Remy says quietly. "Pay attention to where you are."
          <<case 3>>
            "Stay still," Remy commands, adjusting the hold without haste.
          <<case 4>>
            A leather glove flexes against your skin, deliberate and immovable.
        <</switch>>
      <</if>>

    <<option 'CN'>>
      <<if $speechKissVirgin>>
        <<if $_remyRomance>>
          雷米戴着手套的拇指轻轻抚过你的下唇。“第一次？那就看着我的眼睛。”
        <<else>>
          雷米稳稳扣住你的下巴。“别乱扭，慢慢学着受下。”
        <</if>>
      <<elseif $speechOralVirgin>>
        <<if $_remyRomance>>
          “用鼻子喘气，”雷米的手轻覆在你发间，低声说道，“我不急。”
        <<else>>
          “老实待着，”雷米语气平缓而严苛，“别呛着自己。”
        <</if>>
      <<elseif $speechVaginaVirgin or $speechAnusVirgin or $speechPenisVirgin>>
        <<if $_remyRomance>>
          雷米停下来等你平复战栗，嗓音比平日放得更低：“我知道。跟着我吸气，时间还很长。”
        <<else>>
          雷米牢牢按着你的髋部。“抓稳木板。身子绷得太紧，受苦的只会是你自己。”
        <</if>>
      <<elseif $speechPenisBig and $player.penissize gte 7>>
        雷米低头打量着你的尺寸，极轻地抽了一口凉气：“这可真是……没规矩的尺寸。放老实点，免得伤着人。”
      <<elseif $speechPenisBig and $player.penissize gte 4>>
        雷米沉稳地扫了一眼：“倒是一点没亏待自己。动作小心点，别碍事。”
      <<elseif (_remy?.penissize gte 5 or C.npc.Remy.penissize gte 5) and ($speechVaginaPenetrated or $speechAnusPenetrated)>>
        <<if $_remyRomance>>
          “放轻松，”雷米将宽厚的手掌平贴在你后背上低语，“给身子一点时间适应，我就在这。”
        <<else>>
          “抓稳栅栏，”雷米低沉地命令道，“你迟早得学会适应。牲口受得下，你也一样。”
        <</if>>
      <<elseif playerChastity("hidden") or playerChastity("cage")>>
        <<if $_remyRomance>>
          雷米的指甲在坚硬的锁扣上轻轻一扣：“锁在该锁的地方。剩下的交给我。”
        <<else>>
          雷米扯了扯坚实的金属锁扣：“扣得很紧，不错。不安分的劳力本就该套上牢笼。”
        <</if>>
      <<elseif $speechPlayerHits or $speechStruggle>>
        <<if $_remyRomance>>
          “老实点，”雷米从容地制住你的动作，“在我面前用不着使性子。”
        <<else>>
          “瞎折腾只会浪费白昼的工时，”雷米收紧了铁钳般的手指，神情冷硬，“省省力气。”
        <</if>>
      <<elseif $speechPlayerOrgasm>>
        <<if $_remyRomance>>
          雷米沉稳地托住你脱力战栗的身躯，直到你倒过气来：“这就受不住了？好孩子。”
        <<else>>
          雷米按着你，任由你抽搐战栗直至渐歇：“喘匀你的气。我们可还没完呢。”
        <</if>>
      <<elseif $speechOral>>
        <<switch random(1, 2)>>
          <<case 1>>
            “把眼睛睁开，”雷米皮手套紧扣着你的后脑，“看着你在做的事。”
          <<case 2>>
            “节奏放稳，别慌慌张张的，”雷米低沉地呼出一口气。
        <</switch>>
      <<elseif $speechVaginaPenetrated or $speechAnusPenetrated or $speechNPCVaginaPenetrated or $speechNPCAnusPenetrated>>
        <<switch random(1, 3)>>
          <<case 1>>
            “把腰放平，”雷米低沉而平稳地纠正道，“对，节奏由我来带。”
          <<case 2>>
            “很好，”雷米呼出一口热气，“就是这样，学会听话了。”
          <<case 3>>
            “脚下站稳，别打滑，”雷米低声提醒，皮革贴着肌肤发出微响。
        <</switch>>
      <<else>>
        <<switch random(1, 4)>>
          <<case 1>>
            马厩外有人隔着庭院呼喊。雷米侧耳听了半拍动静，随即全然不予理会。
          <<case 2>>
            “眼睛看前面，”雷米淡淡地吩咐，“专心做手头的事。”
          <<case 3>>
            “别乱动，”雷米沉声吩咐，手上的力道从容不迫地微调。
          <<case 4>>
            厚实的皮手套沉沉按在你身上，沉稳而不可撼动。
        <</switch>>
      <</if>>
  <</language>>
<</widget>>

:: Widgets Deadwood Ominous Mirror [widget]
<<widget "deadwood-ominous-mirror-entry">>
	<<if random(1, 100) lte 2>>
		<span class='purple'><<lanSwitch 'An unfamiliar light flickers beneath the reflection. Touching it may have lasting consequences.' '倒影深处闪过陌生的光。触碰它可能带来无法挽回的后果。'>></span><br>
		<<crimeicon 'mark'>><<lanLink ['Touch the strange reflection', '触碰异常的倒影']>>
			<<if passage() is 'Mirror' and !$replayScene and !$statFreeze and !$nextPassageCheck
				and $settings.tentaclesEnabled and $daily.mirrorTentacles isnot 1
				and !$VanillaPlus.orphanEvents.mirrorDone
				and $VanillaPlus.orphanEvents.mirrorDay is Math.floor(Time.days)>>
				<<set $VanillaPlus.orphanEvents.mirrorStage to 0>>
				<<set $daily.mirrorTentacles to 1>>
				<<goto 'Ominous Mirror'>>
			<</if>>
		<</lanLink>><br>
		<<getouticon>><<lanLink ['Leave the reflection alone', '不去触碰倒影'] 'Bedroom'>><<unset $mirrorMenu $bodywritingSet>><<postMirror>><</lanLink>><br><br>
	<</if>>
<</widget>>

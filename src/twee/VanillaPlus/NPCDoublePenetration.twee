:: Deadwood Reblooms NPC Double Penetration Widgets [widget]

<!-- 将原版双插状态中的泛称替换为当前两名 NPC；单插时保留原版措辞。 -->
<<widget 'deadwood-reblooms-double-penetration-status'>>
  <<set _NPCDoubleStatusMode to _args[0]>>
  <<if _NPCDoubleStatusMode.startsWith('player-')>>
    <<set _NPCDoubleStatusOrifice to _NPCDoubleStatusMode.includes('vagina') ? 'vagina' : 'anus'>>
    <<set _NPCDoubleStatusFirst to Number(_NPCDoubleStatusOrifice is 'vagina' ? $vaginatarget : $anustarget)>>
    <<set _NPCDoubleStatusSecond to Number(_NPCDoubleStatusOrifice is 'vagina' ? $vaginadoubletarget : $anusdoubletarget)>>
    <<language>>
      <<option 'EN'>>
        <<personselect _NPCDoubleStatusFirst>><<combatPersons>> and <<personselect _NPCDoubleStatusSecond>><<combatpersons>> penises penetrate your <<if _NPCDoubleStatusOrifice is 'vagina'>><<pussy>><<else>>anus<</if>>.
      <<option 'CN'>>
        <<personselect _NPCDoubleStatusFirst>><<combatperson>>与<<personselect _NPCDoubleStatusSecond>><<combatperson>>的阴茎插到你的<<if _NPCDoubleStatusOrifice is 'vagina'>><<pussy>><<else>>菊穴<</if>>里。
    <</language>>
    <<personselect _NPCDoubleStatusFirst>>
  <<else>>
    <<set _NPCDoubleStatus to maplebirch.get("VP").NPCDoublePenetration.state>>
    <<set _NPCDoubleStatusOrifice to _NPCDoubleStatusMode.includes('vagina') ? 'vagina' : 'anus'>>
    <<if maplebirch.get("VP").NPCDoublePenetration.visible and _NPCDoubleStatus and _NPCDoubleStatus.recipient is Number($penistarget) and _NPCDoubleStatus.orifice is _NPCDoubleStatusOrifice>>
      <<language>>
        <<option 'EN'>>
          <<personselect _NPCDoubleStatus.recipient>><<combatPersons>> <<if _NPCDoubleStatusOrifice is 'vagina'>>vagina<<else>>ass<</if>> envelops your penis alongside <<personselect _NPCDoubleStatus.partner>><<combatpersons>> penis.
        <<option 'CN'>>
          <<personselect _NPCDoubleStatus.recipient>><<combatperson>>的<<if _NPCDoubleStatusOrifice is 'vagina'>>小穴<<else>>屁股<</if>>包裹着你与<<personselect _NPCDoubleStatus.partner>><<combatperson>>的阴茎。
      <</language>>
      <<personselect _NPCDoubleStatus.recipient>>
    <<else>>
      <<language>>
        <<option 'EN'>><<combatPersons>> <<if _NPCDoubleStatusOrifice is 'vagina'>>vagina<<else>>ass<</if>> envelops your <<penis>>.
        <<option 'CN'>><<combatPersons>>的<<if _NPCDoubleStatusOrifice is 'vagina'>>小穴裹住了<<else>>屁股包裹着<</if>>你的<<penis>>。
      <</language>>
    <</if>>
  <</if>>
<</widget>>

<!-- 原版中英文使用相同状态入口；名单同时覆盖阴道与肛门双插。 -->
<<widget 'deadwood-reblooms-double-leglock-targets'>><<nobr>>
  <<set _NPCDoubleLegLockTargets to _args[0]>>
  <<for _NPCDoubleLegLockIndex = 0; _NPCDoubleLegLockIndex lt _NPCDoubleLegLockTargets.length; _NPCDoubleLegLockIndex++>>
    <<if _NPCDoubleLegLockIndex gt 0>>
      <<if _NPCDoubleLegLockIndex is _NPCDoubleLegLockTargets.length - 1>><<lanSwitch ' and ' '、'>><<else>><<lanSwitch ', ' '、'>><</if>>
    <</if>>
    <<personselect _NPCDoubleLegLockTargets[_NPCDoubleLegLockIndex]>><<combatperson>>
  <</for>>
<</nobr>><</widget>>


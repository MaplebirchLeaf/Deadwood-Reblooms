<!-- PC 主动控制双插同伴和自己一同享受；技能、淫乱与意识门槛显示在动作栏。 -->
<<widget 'deadwood-reblooms-npc-double-pleasure'>>
  <<set $_NPCDouble to $VanillaPlus.npcDoublePenetration>>
  <!-- 人类与非人战斗分别读取淫乱和异种癖等级，再组合意识及自愿条件。 -->
  <<set $_NPCDoublePleasureStat to $enemytype is 'man' ? 'promiscuity' : 'deviancy'>>
  <<set $_NPCDoublePleasureStatReady to hasSexStat($_NPCDoublePleasureStat, 5)>>
  <<set $_NPCDoublePleasureAware to $promiscuityIgnore or ($awareness gte 300 and $_NPCDoublePleasureStatReady)>>
  <<set $_NPCDoubleCanUsePleasure to $VanillaPlus.traits.promiscuity or ($consensual is 1 and $_NPCDoublePleasureAware)>>
  <<if maplebirch.get("VP").NPCDoublePenetration.visible and $_NPCDouble and $_NPCDoubleCanUsePleasure and ($VanillaPlus.traits.promiscuity or currentSkillValue('penileskill') gte 800)>>
    <<set $penisactiondefault to 'NPCDoublePleasure'>>
    <<combatpromiscuity5>>
    <<set $_NPCDoubleRecipient to $NPCList[$_NPCDouble.recipient]>>
    <<set $_NPCDoublePartner to $NPCList[$_NPCDouble.partner]>>
    <<set $_NPCDoubleRecipientName to lanSwitch( $_NPCDoubleRecipient.fullDescription, $_NPCDoubleRecipient.fullDescription_CN || $_NPCDoubleRecipient.fullDescription )>>
    <<set $_NPCDoublePartnerName to lanSwitch( $_NPCDoublePartner.fullDescription, $_NPCDoublePartner.fullDescription_CN || $_NPCDoublePartner.fullDescription )>>
    <<set $_NPCDoubleHole to $_NPCDouble.orifice is 'vagina' ? 'pussy' : 'anus'>>
    <<set $_NPCDoubleHoleCN to $_NPCDouble.orifice is 'vagina' ? '小穴' : '菊穴'>>
    <<personselect $_NPCDouble.recipient>>
    <<language>>
      <<option 'EN'>>
        You drive in time with <<print $_NPCDoublePartnerName>>, <span class="lewd">taking pleasure in the two shafts moving together</span> inside <<print $_NPCDoubleRecipientName+"'s "+$_NPCDoubleHole>>.
      <<option 'CN'>>
        你主动挺身，和<<print $_NPCDoublePartnerName>>一同抽插，<span class="lewd">享受两根肉棒在<<print $_NPCDoubleRecipientName>>的<<print $_NPCDoubleHoleCN>>里一同挤磨</span>。
    <</language>>
    <<submission 5>>
    <<sexControl 5 `currentSkillValue("penileskill")` $_NPCDouble.recipient $_NPCDouble.partner>>
    <<penileskilluse>>
  <<else>>
    <span class="red"><<lanSwitch 'The double penetration is no longer available.' '双插姿势已经无法继续。'>></span>
    <<set $penisactiondefault to 'cooperate'>>
  <</if>>
<</widget>>

<!-- PC 双插开始：指定当前 NPC 作为原版阴道或肛门的第二名插入者。 -->
<<widget 'deadwood-reblooms-player-double-begin'>>
  <<set $_NPCDoubleOrifice to _args[0]>>
  <<set $_NPCDoublePartner to _args[1]>>
  <<set $_NPCDoubleJoined to maplebirch.get("VP").NPCDoublePenetration.joinPlayer($_NPCDoublePartner, $_NPCDoubleOrifice)>>
  <<if $_NPCDoubleJoined>>
    <<set $_NPCDoublePrimary to $_NPCDoubleOrifice is 'vagina' ? $vaginatarget : $anustarget>>
    <<set $_NPCDoublePrimaryNPC to $NPCList[$_NPCDoublePrimary]>>
    <<set $_NPCDoublePrimaryName to lanSwitch( $_NPCDoublePrimaryNPC.fullDescription, $_NPCDoublePrimaryNPC.fullDescription_CN || $_NPCDoublePrimaryNPC.fullDescription )>>
    <<if $NPCList[$_NPCDoublePartner].condom and $NPCList[$_NPCDoublePartner].condom.willUse is true and $NPCList[$_NPCDoublePartner].condom.worn is false and !$NPCList[$_NPCDoublePartner].penisdesc.includes('strap-on')>>
      <<if $NPCList[$_NPCDoublePartner].chastity.penis.includes('chastity')>>
        <<language>>
          <<option 'EN'>>
            <<He>> tries to put a condom on, but cannot get it over <<his>> $NPCList[$_NPCDoublePartner].chastity.penis. <span class="red"><<He>> quickly gives up.</span>
          <<option 'CN'>>
            <<He>>试着戴上避孕套，却怎么也套不过<<his>>的<<= $NPCList[$_NPCDoublePartner].chastity.penis.replace("chastity belt","贞操带").replace("chastity cage","贞操笼").replace("anal shield","护肛板")>>。<span class="red"><<He>>很快放弃了。</span>
        <</language>>
        <<set $NPCList[$_NPCDoublePartner].condom.willUse to false>>
      <<else>>
        <span class="green">
          <<language>>
            <<option 'EN'>>
              <<He>> slips <<condomDesc $_NPCDoublePartner>> on <<his>> penis.
            <<option 'CN'>>
              <<He>>给<<his>>的肉棒戴上<<condomDesc $_NPCDoublePartner>>。
          <</language>>
        </span>
        <<equipNPCCondom $_NPCDoublePartner>>
      <</if>>
    <</if>>
    <<if $_NPCDoubleOrifice is 'vagina'>>
      <<language>>
        <<option 'EN'>>
          <<He>> moves beside <<print $_NPCDoublePrimaryName>> and <span class="blue">presses <<his>> penis against your <<pussy>></span>, crowding the other shaft at your entrance.
        <<option 'CN'>>
          <<He>>挤到<<print $_NPCDoublePrimaryName>>身旁，<span class="blue">将肉棒抵在你的<<pussy>>口</span>，与另一根肉棒一同堵住入口。

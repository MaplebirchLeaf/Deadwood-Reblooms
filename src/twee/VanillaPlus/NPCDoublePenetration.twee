      <<set _NPCDoubleLegLockTargets to maplebirch.get("VP").NPCDoublePenetration.playerPenetrators()>>
    <<elseif $VanillaPlus.npcDoublePenetration and $VanillaPlus.npcDoublePenetration.playerLegLock>>
      <<set _NPCDoubleLegLockTargets to $VanillaPlus.npcDoublePenetration.playerLegLock.targets>>
    <</if>>
    <<set _NPCDoubleLegLockSuccess to _NPCDoubleLegLockTargets.length gte 2 and ($VanillaPlus.traits.promiscuity or $gamemode is 'soft' or $gloryhole)>>
    <<if !_NPCDoubleLegLockSuccess and _NPCDoubleLegLockTargets.length gte 2>>

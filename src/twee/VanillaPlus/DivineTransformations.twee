:: Deadwood Reblooms Vanilla Plus Divine Transformation Widgets [widget]

<<widget 'deadwood-reblooms-divine-expunge'>>
  <<set _divineEncounter to _args[0]>>
  <<if maplebirch.get("VP").divineTransformations.expunge(_divineEncounter)>>
    <<switch _divineEncounter>>
      <<case 'Default'>>
        <<lanSwitch 'You open your mouth and draw on the emptiness behind your broken halo. ' '你张开嘴，牵动破碎光环之后的空洞。'>><span class="purple"><<lanSwitch 'The inhuman body buckles as part of it is erased.' '非人的躯体骤然扭曲，一部分存在被空洞抹去。'>></span>
      <<case 'Struggle'>>
        <<lanSwitch 'You breathe the emptiness within you over the creatures. ' '你向纠缠在身边的生物吐出体内的空洞。'>><span class="purple"><<lanSwitch 'Their bodies wither wherever it touches.' '空洞触及之处，它们的躯体随之枯萎。'>></span>
      <<case 'Tentacle'>>
        <<lanSwitch 'You open your mouth and let the tentacles glimpse the void within you. ' '你张开嘴，让触手窥见你体内的虚无。'>><span class="purple"><<lanSwitch 'They writhe as the emptiness tears pieces from every tendril.' '虚无从每根触手上撕去一部分存在，它们痛苦地扭动起来。'>></span>
    <</switch>>
  <<else>>
    <span class="red"><<lanSwitch 'The emptiness no longer answers.' '体内的空洞没有再次回应。'>></span>
  <</if>>
<</widget>>

:: Deadwood Sydney Transformation Widgets [widget]

<<widget 'deadwood-sydney-fall'>>
  <!-- 失誓当次切换形态，按日入口共用检查，不推进成长或日期。 -->
  <<if maplebirch.get('NPCTransformations') and $settings.transformDivineEnabled and !$statFreeze and !$frozenValues and !$replayScene and C.npc.Sydney?.init is 1 and C.npc.Sydney.state is 'active'>>
    <<set $_angel to maplebirch.npc.Transformation.get('Sydney', 'angel')>>
    <<if (_args[0] is true or $_angel.vow is true) and C.npc.Sydney.virginity.temple is false and $_angel.level gt 0>>
      <<if $_angel.level gte 6>><<run maplebirch.npc.Transformation.set('Sydney', 'fallen', 1)>><</if>>
      <<run maplebirch.npc.Transformation.set('Sydney', 'angel', 0)>>
    <</if>>
    <<set $_angel.vow to C.npc.Sydney.virginity.temple>>
  <</if>>
<</widget>>

<<widget 'deadwood-sydney-angelic'>>
  <<deadwood-sydney-fall>>
  <!-- 悉尼自身的天使能力，直接读取当前形态，不另存玩家特质或派生标记。 -->
  <<if maplebirch.get('NPCTransformations') and $settings.transformDivineEnabled and $combat is 1 and $consensual is 1 and $trauma gt 0 and C.npc.Sydney?.init is 1 and C.npc.Sydney.state is 'active' and maplebirch.npc.Transformation.level('Sydney', 'angel') gte 6>>
    <!-- 沿用原版创伤结算，保留下限、创伤状态和幻觉的更新。 -->
    <<trauma `-$trauma`>>
    <span class="green"><<language>>
      <<option 'EN'>>
        Sydney's warmth lingers. For a moment, the fear and pain seem far away.
      <<option 'CN'>>
        悉尼身上的暖意久久未散。那些恐惧与伤痛，仿佛已经离你很远。
    <</language>></span><<lltrauma>>
    <br><br>
  <</if>>
<</widget>>

<<widget 'deadwood-sydney-steadfast'>>
  <!-- 坚忍是悉尼自身的能力。共同祈祷和值勤共用现有转化记录，每日实际恢复一次。 -->
  <<if maplebirch.get('NPCTransformations') and $settings.transformDivineEnabled and !$statFreeze and !$replayScene and !$combat and !$possessed and !$nextPassage and !$nextPassageCheck and !$eventforced and $control lt $controlmax and C.npc.Sydney?.init is 1 and C.npc.Sydney.state is 'active'>>
    <<set $_fallen to maplebirch.npc.Transformation.get('Sydney', 'fallen')>>
    <<set $_day to Math.floor(Time.date.timeStamp / TimeConstants.secondsPerDay)>>
    <<if $_fallen.level gt 0 and (!Number.isInteger($_fallen.steadfastDay) or $_fallen.steadfastDay lt $_day)>>
      <<if _args[0] is 'hint'>>
        <<gcontrol>>
      <<else>>
        <!-- 原版非战斗自控收益会减半：三个宽恕阶段分别恢复 50、100、150 点。 -->
        <<control `$_fallen.level * 10`>>
        <<set $_fallen.steadfastDay to $_day>>
      <</if>>
    <</if>>
  <</if>>
<</widget>>

<<widget 'deadwood-sydney-divine'>>
  <<if maplebirch.get('NPCTransformations') and $settings.transformDivineEnabled and !$statFreeze and !$replayScene and C.npc.Sydney?.init is 1 and C.npc.Sydney.state is 'active' and Number.isInteger(_args[0]) and Number.isInteger(_args[1])>>
    <<deadwood-sydney-fall>>
    <<set $_tf to maplebirch.npc.Transformation>>
    <<set $_angel to $_tf.get('Sydney', 'angel')>>
    <!-- 不追补安装前或停用期间的天数，同一日范围重复执行也不会再加点。 -->
    <<for $_day to Math.max(_args[0], Number.isInteger($_angel.day) ? $_angel.day : _args[0]) + 1; $_day lte _args[1]; $_day++>>
      <<set $_sydney to C.npc.Sydney>>
      <<set $_fallen to $_tf.get('Sydney', 'fallen')>>
      <<set $_demon to $_tf.get('Sydney', 'demon')>>
      <<set $_pureMax to $_sydney.virginity.vaginal is true and $_sydney.virginity.penile is true ? 100 : 99>>
      <<if $_fallen.level gte 3>>
        <!-- 原版获得宽恕后的黑翼不会再因低纯洁直接降为恶魔。 -->
        <<if $_demon.build gt 0>><<run $_tf.set('Sydney', 'demon', 0)>><</if>>
      <<elseif $_fallen.level gt 0 or $_demon.build gt 0>>
        <!-- 只有堕天使或由其开始的恶魔进度能继续积累，普通腐化悉尼不能直接恶魔化。 -->
        <<run $_tf.build('Sydney', 'demon', $_sydney.corruption gte 100 ? 1 : -1)>>
        <<if $_demon.level gt 0>>
          <<if $_fallen.build gt 0>><<run $_tf.set('Sydney', 'fallen', 0)>><</if>>
        <<elseif $_fallen.level gt 0>>
          <<run $_tf.build('Sydney', 'fallen', $_sydney.purity gte 90 ? 1 : -1)>>
          <!-- 首点仅表示堕天使形态，额外积累 20、30 点才进入原版的宽恕阶段。 -->
          <<if $_fallen.build lt 1>><<run $_tf.set('Sydney', 'fallen', 1)>><</if>>
        <</if>>
      <<else>>
        <<run $_tf.build('Sydney', 'angel', $_sydney.purity gte $_pureMax ? 1 : -1)>>
      <</if>>
      <<set $_angel.day to $_day>>
    <</for>>
  <</if>>
<</widget>>

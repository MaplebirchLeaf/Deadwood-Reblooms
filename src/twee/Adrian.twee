:: Deadwood Reblooms Adrian Widgets [widget]

<<widget 'Adrianrelationshiptext'>>
	<<if C.npc.Adrian.rage gt 0 and $VanillaPlus.adrian.last_offence is 'pressure'>>
		<<language>>
			<<option 'EN'>> is <span class='purple'>unimpressed by your demands</span> for special treatment.
			<<option 'CN'>>对你要求违规优待的举动<span class='purple'>很不满</span>。
		<</language>>
	<<elseif C.npc.Adrian.rage gt 0 and $VanillaPlus.adrian.last_offence is 'insult'>>
		<<language>>
			<<option 'EN'>> <span class='purple'>remembers how you spoke</span> about the other customers.
			<<option 'CN'>>仍<span class='purple'>记着你贬低其他客户的话</span>。
		<</language>>
	<<elseif C.npc.Adrian.rage gt 0>>
		<<language>>
			<<option 'EN'>> <span class='blue'>keeps your conversations brief</span> after your attempt to jump the queue.
			<<option 'CN'>>你上次试图插队后，阿德里安<span class='blue'>不再与你多聊</span>。
		<</language>>
	<<elseif $VanillaPlus.adrian.career is 5 and C.npc.Adrian.love gte 35>>
		<<language>>
			<<option 'EN'>> is <span class='green'>grateful for your help</span> with the promotion.
			<<option 'CN'>>很<span class='green'>感激你在晋升时的帮助</span>。
		<</language>>
	<<elseif $VanillaPlus.adrian.career gte 2 and C.npc.Adrian.love gte 20>>
		<<language>>
			<<option 'EN'>> <span class='teal'>values your business</span> with the bank.
			<<option 'CN'>>很<span class='teal'>重视你交给银行的业务</span>。
		<</language>>
	<<elseif C.npc.Adrian.love gte 40>>
		<<language>>
			<<option 'EN'>> <span class='teal'>enjoys talking to you</span> once the paperwork is done.
			<<option 'CN'>>办完业务后，很<span class='teal'>乐意与你交谈</span>。
		<</language>>
	<<elseif C.npc.Adrian.love gte 20>>
		<<language>>
			<<option 'EN'>> is <span class='blue'>happy to explain</span> the small print to you.
			<<option 'CN'>>愿意<span class='blue'>耐心解释</span>合同里的细则。
		<</language>>
	<<elseif C.npc.Adrian.love gte 10>>
		<<language>>
			<<option 'EN'>> <span class='blue'>recognises you</span> before you reach the counter.
			<<option 'CN'>>在你走到柜台前就<span class='blue'>认出了你</span>。
		<</language>>
	<<else>>
		<<language>>
			<<option 'EN'>> waits to hear which banking service you need.
			<<option 'CN'>>等着你说明要办什么银行业务。
		<</language>>
	<</if>>
<</widget>>

<<widget 'deadwood-reblooms-adrian-context'>>
	<<set $_state to $VanillaPlus.adrian>>
	<<set $_bank to $VanillaPlus.finance.bank>>
	<<set $_location to maplebirch.npc.Schedule.get('Adrian').location>>
	<<set _adrianContext to {
		state: $_state,
		bank: $_bank,
		location: $_location,
		desk: {
			financial_centre: 'Deadwood Reblooms Financial Centre Bank',
			financial_centre_property: 'Deadwood Reblooms Property Office',
			financial_centre_securities: 'Deadwood Reblooms Financial Centre Securities'
		}[$_location] or '',
		netDeposit: Math.max(0, $_bank.balance - $_bank.credit_debt - $_bank.loan_debt),
		goodAccount: $_bank.opened and $_bank.debit_card and $_bank.credit_missed_payments is 0 and $_bank.loan_missed_payments is 0
	}>>
	<<set _adrianContext.present to Boolean(_adrianContext.desk) or $_location is 'financial_centre_break'>>
	<<set _adrianContext.canChat to _adrianContext.present and $_state.lastChat isnot Time.days>>
	<<set _adrianContext.careerAvailable to _adrianContext.present and ($_state.career gt 0 or ($_state.visits gte 3 and $_bank.opened))>>
	<<set _adrianContext.businessReady to _adrianContext.goodAccount and _adrianContext.netDeposit gte 2500000>>
<</widget>>

<<widget 'deadwood-reblooms-adrian-business-day'>>
	<<set $_state to $VanillaPlus.adrian>>
	<<set $_bank to $VanillaPlus.finance.bank>>
	<<set $_elapsed to Math.max(0, Time.days - $_state.businessDay)>>
	<<if $_elapsed gt 0>>
		<<set $_state.businessDay to Time.days>>
		<<set $_netDeposit to Math.max(0, $_bank.balance - $_bank.credit_debt - $_bank.loan_debt)>>
		<<set $_goodAccount to $_bank.opened and $_bank.debit_card and $_bank.credit_missed_payments is 0 and $_bank.loan_missed_payments is 0>>
		<<for $_day to 0; $_day lt Math.min(21, $_elapsed) and $_state.career lt 3; $_day++>>
			<<set $_target to $_state.career is 1 ? 500000 : 2500000>>
			<<set $_state.businessDays to $_goodAccount and $_netDeposit gte $_target ? $_state.businessDays + 1 : 0>>
			<<if $_state.businessDays gte ($_state.career is 1 ? 7 : 14)>>
				<<set $_state.career += 1>>
				<<set $_state.businessDays to 0>>
				<<set C.npc.Adrian.title to 'senior bank clerk'>>
				<<set C.npc.Adrian.description to 'senior bank clerk'>>
			<</if>>
		<</for>>
		<<if $_state.career is 4 and (!$_goodAccount or $_netDeposit lt 2500000)>>
			<<set $_state.careerReadyDay to Time.days + 7>>
		<</if>>
	<</if>>
<</widget>>

<<widget 'deadwood-reblooms-adrian-greeting'>>
	<<deadwood-reblooms-adrian-context>>
	<<if _adrianContext.location is (_args[0] or 'financial_centre')>>
		<<set $_new to C.npc.Adrian.init isnot 1>>
		<<if _adrianContext.state.lastVisit isnot Time.days>>
			<<set _adrianContext.state.lastVisit to Time.days>>
			<<set _adrianContext.state.visits += 1>>
		<</if>>
		<<npc 'Adrian'>><<person1>>
		<<if C.npc.Adrian.rage gte 5>>
			<<language>>
				<<option 'EN'>>Adrian places a form beside the card reader. The greeting is <span class='blue'>strictly professional</span>. "What service do you need today?"
				<<option 'CN'>>阿德里安把表格放到读卡器旁。招呼声<span class='blue'>公事公办</span>。“今天需要办理什么业务？”
			<</language>>
		<<elseif (_adrianContext.location is 'financial_centre_property')>>
			<<language>>
				<<option 'EN'>>Adrian has brought a folder from the bank counter. The estate agent passes over a property leaflet. "I'll go through the funding with you. The agent can arrange the viewing."
				<<option 'CN'>>阿德里安从银行柜台带来一个文件夹。中介递过房屋介绍。“我来和你核对购房资金。看房的事，中介会安排。”
			<</language>>
		<<elseif (_adrianContext.location is 'financial_centre_securities')>>
			<<language>>
				<<option 'EN'>>Adrian stands beside the securities clerk, pointing out the account-transfer forms. "Banking on this side. Trades on that one." The market board flickers behind them.
				<<option 'CN'>>阿德里安站在证券职员旁，指出账户转账的表格。“这一侧办理银行对接。交易在那边。”身后的行情板闪动着。
			<</language>>
		<<elseif _adrianContext.state.career is 5>>
			<<language>>
				<<option 'EN'>>Adrian stands beside the desk marked <span class='gold'>Branch Manager</span>. A member of staff brings over a form for approval. "I'll be with you in a moment."
				<<option 'CN'>>阿德里安站在标着<span class='gold'>分行经理</span>的办公桌旁。一名职员拿来表格，请经理批准。“稍等，我马上过来。”
			<</language>>
		<<elseif $_new>>
			<<language>>
				<<option 'EN'>>The clerk straightens a stack of forms before looking up. A small badge reads <span class='blue'>Adrian</span>. "Accounts and personal banking. What can I help you with?"
				<<option 'CN'>>柜员把一叠表格的边缘理齐，随后抬起头。小小的名牌上写着<span class='blue'>阿德里安</span>。“这里办理账户和个人银行业务。有什么能帮你的？”
			<</language>>
		<<elseif (C.npc.Adrian.love gte 20)>>
			<<language>>
				<<option 'EN'>>Adrian notices you waiting and puts the pen down. "Good to see you. Business first, I suppose?" The greeting is quieter than the one given to the previous customer.
				<<option 'CN'>>阿德里安注意到正在等候的你，放下了笔。“见到你真好。还是先办正事？”这声招呼比刚才接待上一位客户时轻了些。
			<</language>>
		<<elseif (_adrianContext.state.visits gte 3)>>
			<<language>>
				<<option 'EN'>>"Welcome back." Adrian recognises you before you reach the glass. A fresh form is placed beside the card reader.
				<<option 'CN'>>“欢迎回来。”你还没走到玻璃前，阿德里安就认出了你。一张新表格被放到读卡器旁边。
			<</language>>
		<<else>>
			<<language>>
				<<option 'EN'>>Adrian looks up from the paperwork and gestures towards the counter. "How can I help?"
				<<option 'CN'>>阿德里安从文书间抬起头，朝柜台示意。“需要办什么业务？”
			<</language>>
		<</if>>
		<br><br>
	<</if>>
<</widget>>

<<widget 'deadwood-reblooms-adrian-counter-link'>>
	<<deadwood-reblooms-adrian-context>>
	<<if _adrianContext.desk and passage() is _adrianContext.desk and _adrianContext.canChat>>
		<<socialiseicon 'ask'>><<lanLink ['Talk to Adrian (0:05)', '与阿德里安聊聊 (0:05)'] 'Deadwood Reblooms Adrian Conversation'>><</lanLink>><br>
	<</if>>
	<<if _adrianContext.desk and passage() is _adrianContext.desk>><<deadwood-reblooms-adrian-career-link>><</if>>
<</widget>>

<<widget 'deadwood-reblooms-adrian-break-link'>>
	<<deadwood-reblooms-adrian-context>>
	<<if (_adrianContext.location is 'financial_centre_break')>>
		<<language>>
			<<option 'EN'>>Adrian sits beside the entrance with a sandwich and a paper cup. The name badge has been turned face down on the table.
			<<option 'CN'>>阿德里安坐在入口旁，面前放着三明治和纸杯。名牌被翻过来，扣在桌面上。
		<</language>><br>
		<<if _adrianContext.canChat>>
			<<socialiseicon>><<lanLink ['Join Adrian for a moment (0:05)', '和阿德里安坐一会儿 (0:05)'] 'Deadwood Reblooms Adrian Conversation'>><</lanLink>><br>
		<</if>>
		<<deadwood-reblooms-adrian-career-link>>
	<</if>>
<</widget>>

<<widget 'deadwood-reblooms-adrian-career-link'>>
	<<deadwood-reblooms-adrian-context>>
	<<if _adrianContext.careerAvailable>>
		<<icon 'assignment.png'>><<lanLink ["Ask about Adrian's work", '询问阿德里安的工作近况'] 'Deadwood Reblooms Adrian Career'>><</lanLink>><br>
	<</if>>
<</widget>>

:: Deadwood Reblooms Adrian Conversation []
<<set $outside to 0>>
<<set $location to 'financial_centre'>>
<<effects>>
<<deadwood-reblooms-adrian-context>>
<<if _adrianContext.present>><<initnpc 'Adrian'>><</if>>
<<set _adrianConversation to { topic: '', ownsHome: false, responseUsed: false }>>
<<if _adrianContext.canChat>>
	<<set _adrianContext.state.lastChat to Time.days>>
	<<for _adrianProperty range maplebirch.get('VanillaPlus').realEstate.properties>>
		<<if maplebirch.get('VanillaPlus').realEstate.owns(_adrianProperty.id)>><<set _adrianConversation.ownsHome to true>><<break>><</if>>
	<</for>>
	<<if _adrianContext.bank.credit_missed_payments gt 0 or _adrianContext.bank.loan_missed_payments gt 0>>
		<<set _adrianConversation.topic to 'overdue'>>
	<<elseif $pain gte 50 or $stress gte 600>>
		<<set _adrianConversation.topic to 'concern'>>
	<<elseif (_adrianContext.location is 'financial_centre_property')>>
		<<set _adrianConversation.topic to 'property'>>
	<<elseif (_adrianContext.location is 'financial_centre_securities')>>
		<<set _adrianConversation.topic to 'securities'>>
	<<elseif !_adrianContext.state.homeDiscussed and _adrianConversation.ownsHome>>
		<<set _adrianConversation.topic to 'home'>><<set _adrianContext.state.homeDiscussed to true>>
	<<elseif _adrianContext.bank.opened and !_adrianContext.state.accountDiscussed>>
		<<set _adrianConversation.topic to 'account'>><<set _adrianContext.state.accountDiscussed to true>>
	<<else>>
		<<set _adrianConversation.topic to (_adrianContext.location is 'financial_centre_break') ? 'break' : 'work'>>
	<</if>>
<</if>>
<<if _adrianConversation.topic>>
	<<npc 'Adrian'>><<person1>>
	<<set C.npc.Adrian.intro to 1>>
	<<pass 5>>
	<<switch _adrianConversation.topic>>
		<<case 'overdue'>>
			<<language>>
				<<option 'EN'>>Adrian lowers the voice usually used for account enquiries. "There's a missed payment on your account. I can go through the statement with you, if you'd like." The paper stays on your side of the glass. "<span class='blue'>I can't remove it.</span> I can make sure you know what you're being asked to pay."
				<<option 'CN'>>阿德里安压低了平常办理业务时的声音。“你的账户有一笔逾期款。如果你愿意，我可以陪你看一遍账单。”纸张留在你这侧的玻璃前。“<span class='blue'>我不能替你免掉它。</span>但我可以让你弄清楚，他们要你付的究竟是什么。”
			<</language>>
		<<case 'concern'>>
			<<language>>
				<<option 'EN'>>Adrian looks up from the forms. "Are you feeling alright? There is a chair by the door." <<He>> waits while you catch your breath.
				<<option 'CN'>>阿德里安从表格上抬起头。“你还好吗？门边有椅子。”<<He>>等你缓过气来，才继续问话。
			<</language>>
		<<case 'home'>>
			<<language>>
				<<option 'EN'>>"I saw the paperwork. Congratulations on the house." Adrian smiles. "Moved in yet?" <<He>> listens while sorting the forms on the desk.
				<<option 'CN'>>“我看到手续了。恭喜买了房子。”阿德里安笑着问：“搬进去了吗？”<<He>>一边整理桌上的表格，一边听你回答。
			<</language>>
		<<case 'account'>>
			<<language>>
				<<option 'EN'>>"Your account is open now." Adrian points out the number on your paperwork. "<span class='blue'>Keep your card details safe.</span> If you borrow anything, <span class='blue'>check the payment dates</span> too."
				<<option 'CN'>>“账户已经开好了。”阿德里安指了指文书上的账号。“<span class='blue'>保管好卡片信息。</span>要是借了钱，也记得<span class='blue'>留意还款日期</span>。”
			<</language>>
		<<case 'property'>>
			<<if _adrianConversation.ownsHome>>
				<<language>>
					<<option 'EN'>>Adrian turns the leaflet over to the running costs. "The keys are only the first payment. Upkeep, furniture, the mortgage if you have one." A fingertip stops beside the account details. "Leave yourself enough for the next bill. I've seen people buy a house and then have nowhere comfortable to sit in it."
					<<option 'CN'>>阿德里安把介绍翻到日常开销那面。“拿到钥匙，只是第一笔支出。维护、家具，还有可能要还的房贷。”指尖停在账户资料旁。“给下一张账单留点余地。我见过有人买完房，里面却连个能舒服坐下的地方都没有。”
				<</language>>
			<<else>>
				<<language>>
					<<option 'EN'>>"Which one caught your eye?" Adrian waits while you look over the deeds. "I'll check the deposit and repayment terms with you before you sign anything. The agent will tell you about the rooms." The cheapest leaflet is placed where you can reach it too. "A bigger loan isn't always a better house."
					<<option 'CN'>>“看中哪一处了？”阿德里安等你看过契据。“签字前，我可以陪你核对首付和还款条件。房间的情况由中介介绍。”最便宜的那张资料也被放到你够得着的位置。“贷款借得更多，不一定住得更好。”
				<</language>>
			<</if>>
		<<case 'securities'>>
			<<if $VanillaPlus.finance.brokerage.opened>>
				<<language>>
					<<option 'EN'>>Adrian checks the transfer details with the securities clerk. "This money leaves your bank balance when it goes into the trading account. Don't count it twice when you're planning repayments." The clerk turns towards the market board. Adrian stays with your statement. "And don't mistake yesterday's price for tomorrow's."
					<<option 'CN'>>阿德里安和证券职员核对转账资料。“钱转进交易账户，就会从银行余额里扣走。安排还款时，别把它算上两遍。”职员转向行情板，阿德里安仍看着你的账单。“也别把昨天的价格，当成明天的保证。”
				<</language>>
			<<else>>
				<<language>>
					<<option 'EN'>>"Thinking about opening a trading account?" Adrian picks out the forms and introduces you to the securities clerk. "I can explain how money moves between the two accounts. Ask the clerk about orders and shares." The introduction ends with a quiet addition. "<span class='blue'>You don't have to buy anything today.</span>"
					<<option 'CN'>>“想开个交易账户？”阿德里安找出表格，把你介绍给证券职员。“两个账户之间怎么转钱，我可以解释。下单和股票的事，问这位职员。”介绍完，又轻轻补了一句。“<span class='blue'>今天不一定非得买点什么。</span>”
				<</language>>
			<</if>>
		<<case 'break'>>
			<<language>>
				<<option 'EN'>>Adrian moves the paper cup to make room for you. "I have five minutes before I need to get back." <<He>> folds the sandwich wrapper. "It has been busy today. I barely had time for lunch."
				<<option 'CN'>>阿德里安挪开纸杯，给你腾出位置。“还有五分钟，我就得回柜台了。”<<He>>折起三明治的包装纸。“今天人真多。午饭都差点没空吃。”
			<</language>>
		<<default>>
			<<if C.npc.Adrian.love gte 20 and (C.npc.Adrian.rage ?? 0) is 0>>
				<<language>>
					<<option 'EN'>>"You don't always need an account question to say hello." Adrian glances at the queue, then back at you. "Though if the manager asks, we were discussing your statement."
					<<option 'CN'>>“也不是非得有账户问题才能来打招呼。”阿德里安看看等候的队伍，又看回你。“不过经理要是问起，我们就是在讨论你的账单。”
				<</language>>
			<<else>>
				<<language>>
					<<option 'EN'>>"Busy morning?" Adrian listens to your answer while capping the pen. "Mine has mostly involved explaining that signing a form doesn't mean you've read it." A glance at the stack of paperwork follows. "I probably shouldn't say that too loudly."
					<<option 'CN'>>“今天忙吗？”阿德里安扣上笔帽，听你回答。“我今天主要忙着解释，签过字和读过表格是两回事。”目光随后落在那叠文书上。“这话大概不该说得太响。”
				<</language>>
			<</if>>
	<</switch>>
	<br><br>
	<div id='adrian-response'>
		<<lanLink ['Listen and thank Adrian', '认真听完，向阿德里安道谢']>>
			<<deadwood-reblooms-adrian-context>>
			<<if _adrianContext.present and _adrianContext.state.lastChat is Time.days and !_adrianConversation.responseUsed>>
				<<set _adrianConversation.responseUsed to true>>
				<<set C.npc.Adrian.love to Math.clamp((C.npc.Adrian.love ?? 0) + 2, 0, 50)>>
				<<set C.npc.Adrian.rage to Math.max(0, (C.npc.Adrian.rage ?? 0) - 1)>>
				<<if C.npc.Adrian.rage is 0>><<set _adrianContext.state.last_offence to ''>><</if>>
				<<replace '#adrian-response'>>
					<<language>>
						<<option 'EN'>>
							You listen without interrupting, then thank Adrian.
							<<if C.npc.Adrian.rage gt 0>><<He>> nods, <span class='blue'>still keeping the conversation to your paperwork</span>.
							<<elseif _adrianConversation.topic is 'overdue'>>"Ask if you need a charge explained." Adrian leaves the statement where you can read it.
							<<elseif _adrianConversation.topic is 'break'>>Adrian sets the cup down. "It's nice to finish a sentence without a number being called." <span class='teal'><<He>> seems glad of the company.</span>
							<<else>>Adrian gives you a small smile before setting the next form between you.<</if>> <<glove 'Adrian'>>
						<<option 'CN'>>
							你没有打断阿德里安，等<<him>>说完才道了谢。
							<<if C.npc.Adrian.rage gt 0>><<He>>点点头，<span class='blue'>仍只与你谈手上的业务</span>。
							<<elseif _adrianConversation.topic is 'overdue'>>“哪笔费用不明白，可以问。”阿德里安把账单留在你能看清的地方。
							<<elseif _adrianConversation.topic is 'break'>>阿德里安放下杯子。“能说完一句话，不用中途去叫号，倒是挺好。”<span class='teal'><<He>>似乎很乐意有人作伴。</span>
							<<else>>阿德里安朝你微微一笑，把下一张表格放到你们之间。<</if>> <<glove 'Adrian'>>
					<</language>>
				<</replace>>
			<</if>>
		<</lanLink>><br>
		<<switch _adrianConversation.topic>>
			<<case 'overdue'>><<set _adrianFollowup to ['Go through the statement together', '一起核对账单']>>
			<<case 'concern'>><<set _adrianFollowup to ['Sit down and catch your breath', '坐下缓口气']>>
			<<case 'home' 'property'>><<set _adrianFollowup to ['Tell Adrian about your plans for the house', '聊聊你对房子的打算']>>
			<<case 'account' 'securities'>><<set _adrianFollowup to ['Ask Adrian to explain the paperwork', '请阿德里安解释表格']>>
			<<default>><<set _adrianFollowup to ['Ask how the day has been', '问问今天工作怎么样']>>
		<</switch>>
		<<lanLink _adrianFollowup>>
			<<deadwood-reblooms-adrian-context>>
			<<if _adrianContext.present and _adrianContext.state.lastChat is Time.days and !_adrianConversation.responseUsed>>
				<<set _adrianConversation.responseUsed to true>>
				<<set C.npc.Adrian.love to Math.clamp((C.npc.Adrian.love ?? 0) + 2, 0, 50)>>
				<<set C.npc.Adrian.rage to Math.max(0, (C.npc.Adrian.rage ?? 0) - 1)>>
				<<if C.npc.Adrian.rage is 0>><<set _adrianContext.state.last_offence to ''>><</if>>
				<<replace '#adrian-response'>>
					<<switch _adrianConversation.topic>>
						<<case 'overdue'>>
							<<language>>
								<<option 'EN'>>Adrian puts the statement between you and points out the missed payment. "This one first. Then the next instalment is due here." <<He>> writes down the dates for you. <<glove 'Adrian'>>
								<<option 'CN'>>阿德里安把账单放到你们之间，指了指逾期的那笔款。“先还这一笔。下一期是这个日期。”<<He>>替你把日期写了下来。<<glove 'Adrian'>>
							<</language>>
						<<case 'concern'>>
							<<stress -3>>
							<<language>>
								<<option 'EN'>>You sit beside the door. Adrian keeps your forms behind the counter until you are ready. "Take your time." You let your shoulders relax. <<glove 'Adrian'>><<lstress>>
								<<option 'CN'>>你在门边坐下。阿德里安把你的表格留在柜台后，等你缓过来。“不着急。”你放松肩膀，慢慢吐出一口气。<<glove 'Adrian'>><<lstress>>
							<</language>>
						<<case 'home' 'property'>>
							<<if _adrianConversation.ownsHome>>
								<<language>>
									<<option 'EN'>>You tell Adrian which room you want to furnish first. "A proper bed would be my choice." <<He>> smiles. "Then curtains. You want to be able to sleep in on a day off." <<glove 'Adrian'>>
									<<option 'CN'>>你说起想先布置哪个房间。“换作我，会先买张舒服的床。”<<He>>笑了笑。“再装窗帘。休息日总得能睡个懒觉。”<<glove 'Adrian'>>
								<</language>>
							<<else>>
								<<language>>
									<<option 'EN'>>You describe the sort of place you would like. Adrian picks out two leaflets. "These might be worth a look." <<He>> leaves them with you. <<glove 'Adrian'>>
									<<option 'CN'>>你说起想住的房子。阿德里安挑出两张介绍。“可以看看这两处。”<<He>>把资料留给了你。<<glove 'Adrian'>>
								<</language>>
							<</if>>
						<<case 'account' 'securities'>>
							<<language>>
								<<option 'EN'>>Adrian turns the form towards you and goes through the boxes one at a time. You stop <<him>> at a line you do not understand. "That is the transfer amount. It is blank until you choose it." <<glove 'Adrian'>>
								<<option 'CN'>>阿德里安把表格转向你，逐栏解释。你指着不明白的一行问<<him>>。“这是转账金额。你决定好以后再填。”<<glove 'Adrian'>>
							<</language>>
						<<default>>
							<<if _adrianContext.state.career is 5>>
								<<language>>
									<<option 'EN'>>"Two staff off sick, and a drawer that would not balance." Adrian rubs the bridge of <<his>> nose. "I sorted it out. I could do with a quiet afternoon." <<glove 'Adrian'>>
									<<option 'CN'>>“两个人请病假，还有个钱箱对不上账。”阿德里安揉了揉鼻梁。“都处理好了。只希望下午能清静点。”<<glove 'Adrian'>>
								<</language>>
							<<elseif C.npc.Adrian.love gte 20 and (C.npc.Adrian.rage ?? 0) is 0>>
								<<language>>
									<<option 'EN'>>"Someone handed me a shopping list instead of the application form." Adrian laughs. "I nearly asked them to sign it. I needed lunch too." <<glove 'Adrian'>>
									<<option 'CN'>>“有人把购物清单当申请表递给我了。”阿德里安笑出了声。“我差点还让人签字。看来我也该吃午饭了。”<<glove 'Adrian'>>
								<</language>>
							<<else>>
								<<language>>
									<<option 'EN'>>"A long queue, mostly." Adrian glances at the clock. "It should ease off soon. How about you?" <<He>> listens to your answer. <<glove 'Adrian'>>
									<<option 'CN'>>“主要是排队的人多。”阿德里安看了眼时钟。“应该快忙完了。你呢？”<<He>>听着你的回答。<<glove 'Adrian'>>
								<</language>>
							<</if>>
					<</switch>>
				<</replace>>
			<</if>>
		<</lanLink>><br>
		<<if _adrianConversation.topic is 'break' and $money gte 200>>
			<<lanLink ['Buy Adrian a cup of tea (£2)', '请阿德里安喝杯茶 (£2)']>>
				<<deadwood-reblooms-adrian-context>>
				<<if _adrianContext.present and _adrianContext.state.lastChat is Time.days and !_adrianConversation.responseUsed and $money gte 200>>
					<<set _adrianConversation.responseUsed to true>><<money -200>><<stress -3>>
					<<set C.npc.Adrian.love to Math.clamp((C.npc.Adrian.love ?? 0) + 2, 0, 50)>>
					<<set C.npc.Adrian.rage to Math.max(0, (C.npc.Adrian.rage ?? 0) - 1)>>
					<<if C.npc.Adrian.rage is 0>><<set _adrianContext.state.last_offence to ''>><</if>>
					<<replace '#adrian-response'>>
						<<language>>
							<<option 'EN'>>You bring a hot cup back from the cafe. "Thank you. Mine had gone cold." Adrian makes room for you beside the table. You talk while <<he>> drinks. <<glove 'Adrian'>><<lstress>>
							<<option 'CN'>>你从咖啡馆带回一杯热茶。“谢谢。我这杯早就凉了。”阿德里安在桌旁给你让出位置。你陪<<him>>喝茶，聊了一会儿。<<glove 'Adrian'>><<lstress>>
						<</language>>
					<</replace>>
				<</if>>
			<</lanLink>><br>
		<</if>>
		<<if C.npc.Adrian.rage gt 0 and _adrianContext.state.last_offence>>
			<<lanLink ['Apologise for how you spoke last time', '为上次说的话道歉']>><<deadwood-adrian-boundary 'apologise'>><</lanLink>>
		<<else>>
			<<if _adrianConversation.topic is 'overdue'>>
				<<lanLink ['Demand that Adrian erase the missed payment', '要求阿德里安抹掉逾期记录']>><<deadwood-adrian-boundary 'pressure'>><</lanLink>><<llove 'Adrian'>>
			<<elseif _adrianContext.location is 'financial_centre_break'>>
				<<lanLink ['Call the other customers too stupid to fill in a form', '嘲笑其他客户连表格都不会填']>><<deadwood-adrian-boundary 'insult'>><</lanLink>><<llove 'Adrian'>>
			<<elseif ['account', 'securities', 'property', 'home'].includes(_adrianConversation.topic)>>
				<<lanLink ['Insist your money entitles you to special treatment', '声称自己的钱足够多，理应得到特殊优待']>><<deadwood-adrian-boundary 'pressure'>><</lanLink>><<llove 'Adrian'>>
			<<else>>
				<<lanLink ['Tell Adrian to serve you before the people waiting', '让阿德里安把排队的人晾着，先办你的业务']>><<deadwood-adrian-boundary 'queue'>><</lanLink>><<llove 'Adrian'>>
			<</if>>
		<</if>>
	</div>
	<br><br>
<<else>>
	<<language>>
		<<option 'EN'>>Adrian is occupied, or has already left the counter. You'll have to catch up another time.
		<<option 'CN'>>阿德里安正在忙，或已经离开了柜台。你得另找时间再聊。
	<</language>><br><br>
<</if>>
<<if _adrianContext.desk>>
	<<icon 'bank-counter.png'>><<lanLink ['Return to the desk', '返回柜台'] _adrianContext.desk>><</lanLink>><br>
<</if>>
<<getouticon>><<lanLink ['Return to the banking hall', '返回银行大厅'] 'Deadwood Reblooms Financial Centre'>><</lanLink>><br>

:: Deadwood Reblooms Adrian Career []
<<set $outside to 0>>
<<set $location to 'financial_centre'>>
<<effects>>
<<deadwood-reblooms-adrian-context>>
<<if _adrianContext.careerAvailable>>
	<<npc 'Adrian'>><<person1>>
	<<switch _adrianContext.state.career>>
		<<case 0>>
			<<language>>
				<<option 'EN'>>"They look at the customers you bring in, and whether those customers stay." Adrian slides an account leaflet across the desk. "I'd like to move beyond the counter. But I need a portfolio they can actually point to."<br><br>"You can name me as your regular contact. I'll handle your account enquiries. Only do it if you intend to bank here."
				<<option 'CN'>>“他们会看你带来了多少客户，以及这些客户会不会留下。”阿德里安把一张账户介绍推过桌面。“我想从柜台再往前走一步。但得拿出实实在在的业务。”<br><br>“你可以指定我负责你的账户服务。以后有账户问题，就来找我。前提是，你确实打算在这里办业务。”
			<</language>>
		<<case 1>>
			<<language>>
				<<option 'EN'>>Adrian finds your account in the customer file. "A card and a deposit that stays here. That's a customer relationship, rather than another withdrawal slip." The file is placed beside several others.<br><br><span class='blue'>Keep at least £5,000 in net deposits for a week of daily settlements, with a debit card and no overdue repayments.</span> Adrian's other customers will be included in the internal assessment too.
				<<option 'CN'>>阿德里安在客户档案里找到了你的账户。“办好卡，存款也留在这里。这才是客户业务，不是又一张取款单。”档案被放到另外几份旁边。<br><br><span class='blue'>办好借记卡，在每日结算时保持至少 £5,000 净存款，连续一周没有逾期还款。</span>内部考核也会计入阿德里安服务的其他客户。
			<</language>>
		<<case 2>>
			<<language>>
				<<option 'EN'>>A new badge lies beside Adrian's pen. <span class='gold'>Senior Clerk.</span> "Your account helped. So did the customers who came back rather than moving to another branch." Adrian straightens the badge.<br><br>"There's a management vacancy. They want to see that I can retain larger accounts as well." <span class='blue'>Keep at least £25,000 in net deposits for a fortnight of daily settlements, with your debit card and repayments in order.</span> You don't need to take out a loan to help.
				<<option 'CN'>>阿德里安的笔旁放着新的名牌。<span class='gold'>资深柜员。</span>“你的账户帮了忙。其他愿意回来，没有转去别的分行的客户也一样。”阿德里安把名牌摆正。<br><br>“现在有个经理职位空出来了。他们还想看看，我能不能留住更大的客户业务。”<span class='blue'>办好借记卡，在每日结算时保持至少 £25,000 净存款，连续两周没有逾期还款。</span>你不必为了帮忙去借贷款。
			<</language>>
		<<case 3>>
			<<language>>
				<<option 'EN'>>"The figures are there now." Adrian closes a folder of account reports. "If you're willing, I'll include your account in the portfolio for my application. They'll still interview me and check how I've handled the rest of the work."<br><br><span class='blue'>Confirm this at the counter while your qualifying deposit and payment record are still in place.</span>
				<<option 'CN'>>“现在业绩已经够了。”阿德里安合上装着账户报告的文件夹。“如果你同意，我会把你的账户业务列进竞聘材料。他们还会面试我，检查我处理其他工作的情况。”<br><br><span class='blue'>保持符合条件的存款和还款记录，在柜台确认授权。</span>
			<</language>>
		<<case 4>>
			<<language>>
				<<option 'EN'>>"The interview's arranged. They're checking the portfolio too." Adrian rests a hand on the closed folder. "That takes <span class='blue'>a week</span>. Don't move money around for my sake. A balance that vanishes before the review doesn't help either of us."
				<<option 'CN'>>“面试安排好了。他们也在核对客户业务。”阿德里安的手停在合起的文件夹上。“需要<span class='blue'>一周</span>。别为了我来回转钱。审核还没结束，存款就不见了，对我们都没帮助。”
			<</language>>
		<<case 5>>
			<<language>>
				<<option 'EN'>>"More forms. A different desk." Adrian shows you the appointment letter. <span class='gold'>Branch Manager.</span> "The accounts got me an interview. They liked my work at it too." The letter is folded away. "Thank you for trusting me with your business."<br><br><span class='green'>You qualify for the branch's preferred personal-loan rate.</span> With no missed-payment records, the weekly interest rate on new personal loans is reduced by <span class='green'>10%</span>. The rate is fixed when you borrow. Existing contracts, late charges and mortgage terms are unchanged.
				<<option 'CN'>>“更多表格。一张不同的桌子。”阿德里安拿出任命信。<span class='gold'>分行经理。</span>“这些客户业务让我拿到了面试机会。面试里，他们也认可了我的工作。”信被收好。“谢谢你愿意把业务交给我。”<br><br><span class='green'>你可以享受分行的个人贷款优惠利率。</span>没有漏还记录时，新个人贷款的<span class='green'>周利率降低 10%</span>，签约时确定合同利率。已有合同、逾期费用和房贷条款仍按原来的规定执行。
			<</language>>
	<</switch>>
	<br><br>
	<<if _adrianContext.state.career is 5>>
		<strong class='gold'><<lanSwitch 'Personal-loan weekly rates' '个人贷款周利率'>></strong><br>
		<<for _adrianLoan range maplebirch.get('VanillaPlus').finance.loanProducts>>
			<<= _adrianLoan.days>> <<lanSwitch 'days' '天'>>：
			<<= (_adrianLoan.baseWeeklyRate * 100).toFixed(3)>>% →
			<span class='blue'><<= (_adrianLoan.weeklyRate * 100).toFixed(3)>>%</span><br>
		<</for>>
		<<if _adrianContext.bank.credit_missed_payments gt 0 or _adrianContext.bank.loan_missed_payments gt 0>>
			<<language>>
				<<option 'EN'>><span class='red'>The discount is currently suspended because of missed repayments.</span> The rates above show your current quote. Clear the affected credit-card or personal-loan debt to reset its missed-payment record.
				<<option 'CN'>><span class='red'>当前有逾期记录，优惠已暂停。</span>上方显示的是当前报价。结清有逾期记录的信用卡或个人贷款欠款，才能清除对应的漏还记录。
			<</language>>
		<<else>>
			<<language>>
				<<option 'EN'>><span class='green'>The discount is active.</span> A ten-percent reduction means the original rate is multiplied by 0.9. Deposit interest, credit-card interest and mortgages are unaffected.
				<<option 'CN'>><span class='green'>优惠已生效。</span>降低一成是原利率乘以 0.9。存款利息、信用卡利息和房贷不受影响。
			<</language>>
		<</if>>
		<br><br>
	<</if>>
	<div id='adrian-career-actions'>
		<<if (_adrianContext.location is 'financial_centre') and _adrianContext.state.career is 0>>
			<<lanLink ['Choose Adrian as your account contact (0:05)', '指定阿德里安负责账户服务 (0:05)']>>
				<<if _adrianContext.state.career is 0>>
					<<set _adrianContext.state.career to 1>><<set _adrianContext.state.businessDay to Time.days>><<set _adrianContext.state.businessDays to 0>>
					<<pass 5>>
					<<replace '#adrian-career-actions'>>
						<<language>>
							<<option 'EN'>>Adrian records your request and gives you a card bearing the name from the badge. "Ask for me next time." <span class='blue'>Future daily account settlements will count towards the business record.</span>
							<<option 'CN'>>阿德里安记下你的请求，递来一张印着名牌上那个名字的卡片。“下次来找我就好。”<span class='blue'>从此后的每日账户结算开始记录业务。</span>
						<</language>>
					<</replace>>
				<</if>>
			<</lanLink>><br>
		<<elseif (_adrianContext.location is 'financial_centre') and _adrianContext.state.career is 3 and _adrianContext.businessReady>>
			<<lanLink ['Allow Adrian to include your account (0:05)', '同意阿德里安将账户业务列入竞聘材料 (0:05)']>>
				<<if _adrianContext.state.career is 3>>
					<<set _adrianContext.state.career to 4>><<set _adrianContext.state.careerReadyDay to Time.days + 7>>
					<<pass 5>>
					<<replace '#adrian-career-actions'>>
						<<language>>
							<<option 'EN'>>You sign the authorisation. Adrian puts it with the portfolio, ready for the internal review. "Now it's my turn. I'd better give them a good interview."
							<<option 'CN'>>你签好授权，阿德里安把它放进送交内部审核的材料里。“接下来就看我了。面试得好好表现。”
						<</language>>
					<</replace>>
				<</if>>
			<</lanLink>><br>
		<<elseif (_adrianContext.location is 'financial_centre') and _adrianContext.state.career is 4 and _adrianContext.businessReady and Time.days gte _adrianContext.state.careerReadyDay>>
			<<socialiseicon 'ask'>><<lanLink ['Ask how the interview went (0:05)', '询问面试结果 (0:05)']>>
				<<if _adrianContext.state.career is 4>>
					<<set _adrianContext.state.career to 5>>
					<<set C.npc.Adrian.title to 'bank manager'>><<set C.npc.Adrian.description to 'bank manager'>>
					<<pass 5>>
					<<replace '#adrian-career-actions'>>
						<<language>>
							<<option 'EN'>>Adrian opens the letter. <span class='gold'>The appointment is confirmed.</span> "They approved it. I'll be moving to the new desk." A smaller leaflet follows. "Your account qualifies for our preferred loan rate. That was approved too."
							<<option 'CN'>>阿德里安打开信。<span class='gold'>任命已经获批。</span>“通过了。以后我会在新的办公桌。”随后又递来一张小些的介绍单。“你的账户可以享受优惠贷款利率。这个也批下来了。”
						<</language>>
					<</replace>>
				<</if>>
			<</lanLink>><br>
		<<elseif _adrianContext.state.career is 1 or _adrianContext.state.career is 2>>
			<<language>>
				<<option 'EN'>>Qualifying daily settlements: <span class='blue'><<= _adrianContext.state.businessDays>> / <<= _adrianContext.state.career is 1 ? 7 : 14>></span>. Below the deposit requirement or behind on repayments, the current streak starts again.
				<<option 'CN'>>符合条件的连续日结：<span class='blue'><<= _adrianContext.state.businessDays>> / <<= _adrianContext.state.career is 1 ? 7 : 14>></span>。日结时存款不足或还款逾期，当前阶段重新累计。
			<</language>><br>
		<<elseif _adrianContext.state.career is 3 or _adrianContext.state.career is 4>>
			<<language>>
				<<option 'EN'>>Keep the qualifying deposit and payment record. Confirm the paperwork or collect the result during counter hours. If a daily settlement fails during review, the review week starts again.
				<<option 'CN'>>保持符合条件的存款与还款记录，在柜台办公时确认材料或领取结果。审核期间有一次日结不符合条件，审核周会重新计算。
			<</language>><br>
		<</if>>
	</div>
	<br>
	<<if _adrianContext.state.career gt 0 and _adrianContext.state.career lt 5>>
		<<language>>
			<<option 'EN'>><i>Net deposits are the balance left after credit-card and personal-loan debts. Repeated transfers do not add business days.</i>
			<<option 'CN'>><i>净存款按账户余额扣除信用卡和个人贷款欠款计算。反复存取不会增加业务天数。</i>
		<</language>><br>
	<</if>>
<<else>>
	<<language>>
		<<option 'EN'>>Adrian isn't available to discuss this now.
		<<option 'CN'>>阿德里安现在不方便谈这些。
	<</language>><br>
<</if>>
<br>
<<icon 'bank-counter.png'>><<lanLink ['Return to the counter', '返回银行柜台'] 'Deadwood Reblooms Financial Centre Bank'>><</lanLink>><br>
<<getouticon>><<lanLink ['Return to the banking hall', '返回银行大厅'] 'Deadwood Reblooms Financial Centre'>><</lanLink>><br>

:: Deadwood Reblooms Statistics [widget]

<!-- 模组统计只读取当前存档的 V。没有开启的模块不显示空栏目。 -->
<<widget 'deadwood-reblooms-statistics'>>
  <<if maplebirch.get('VanillaPlus') or maplebirch.get('MoreTransformations') or maplebirch.get('LifeSimulation')>>
  <<foldout false '_deadwoodProgressFoldout'>>
    <span class='gold'><<lanSwitch 'Deadwood Reblooms: progress' '枯木逢春：进度'>></span>
    <<if maplebirch.get('VanillaPlus') and $VanillaPlus>>
      <<lanSwitch 'Attribute breakthroughs:' '属性突破：'>>
      <span class='teal'><<= Object.values($VanillaPlus.lock ?? {}).filter(Boolean).length>> / 6</span><br>
      <<lanSwitch 'Breakthrough traits:' '突破特质：'>>
      <span class='green'><<= Object.values($VanillaPlus.traits ?? {}).filter(Boolean).length>> / 7</span><br>
    <</if>>
    <<if maplebirch.get('MoreTransformations')>>
      <<lanSwitch 'Horse transformation:' '马转化：'>>
      <span class='softbrown'><<= $maplebirch?.transformation?.horse?.level ?? 0>> / 6</span>
      (<span class='softbrown'><<= $maplebirch?.transformation?.horse?.build ?? 0>> / 30</span>)<br>
      <<lanSwitch 'Fish transformation:' '鱼转化：'>>
      <span class='lblue'><<= $maplebirch?.transformation?.fish?.level ?? 0>> / 6</span>
      (<span class='lblue'><<= $maplebirch?.transformation?.fish?.build ?? 0>> / 30</span>)<br>
    <</if>>
    <<if maplebirch.get('LifeSimulation') and $LifeSimulation>>
      <<lanSwitch 'Attendance pass:' '免听凭证：'>>
      <<if $LifeSimulation.school.attendanceExempt>><span class='green'><<lanSwitch 'Obtained' '已取得'>></span>
      <<else>><<lanSwitch 'Not obtained' '未取得'>><</if>><br>
      <<lanSwitch 'School role:' '校园身份：'>>
      <<switch $LifeSimulation.school.role>>
        <<case 'president'>><span class='gold'><<lanSwitch 'Student president' '学生会长'>></span>
        <<case 'prefect'>><span class='teal'><<lanSwitch 'Prefect' '风纪委员'>></span>
        <<default>><<lanSwitch 'Student' '学生'>>
      <</switch>><br>
      <<lanSwitch 'Morning duties:' '晨间值勤：'>>
      <span class='teal'><<= $LifeSimulation.school?.duties?.completed ?? 0>></span><br>
      <<lanSwitch 'History exhibition:' '历史展览：'>>
      <<switch $LifeSimulation.historyProject?.status>>
        <<case 'won'>><span class='green'><<lanSwitch 'Top evaluation' '最高评价'>></span>
        <<case 'done'>><<lanSwitch 'Completed' '已完成'>>
        <<case 'ongoing'>><<lanSwitch 'Ongoing' '进行中'>>
        <<default>><<lanSwitch 'Not started' '未开始'>>
      <</switch>><br>
    <</if>>
    <br>
  <</foldout>>
  <</if>>

  <<if maplebirch.get('LifeSimulation') and $LifeSimulation>>
    <<foldout false '_deadwoodSchoolFoldout'>>
      <span class='gold'><<lanSwitch 'School standing' '校园评价'>></span>
      <<lanSwitch 'Order:' '校内秩序：'>>
      <span @class="maplebirch.get('LifeSimulation').school.standingColour($LifeSimulation.school?.order ?? 0)"><<= $LifeSimulation.school?.order ?? 0>></span><br>
      <<lanSwitch 'Students:' '学生声望：'>>
      <span @class="maplebirch.get('LifeSimulation').school.standingColour($LifeSimulation.school?.studentSupport ?? 0)"><<= $LifeSimulation.school?.studentSupport ?? 0>></span><br>
      <<lanSwitch 'Staff:' '教职工信任：'>>
      <span @class="maplebirch.get('LifeSimulation').school.standingColour($LifeSimulation.school?.staffSupport ?? 0)"><<= $LifeSimulation.school?.staffSupport ?? 0>></span><br>
      <<lanSwitch 'Corruption:' '校内堕落：'>>
      <span @class="maplebirch.get('LifeSimulation').school.standingColour($LifeSimulation.school?.corruption ?? 0)"><<= $LifeSimulation.school?.corruption ?? 0>></span><br><br>
    <</foldout>>
  <</if>>

  <<if maplebirch.get('Finance') and $Finance>>
    <<foldout false '_deadwoodFinanceFoldout'>>
      <span class='gold'><<lanSwitch 'Finance and property' '金融与房产'>></span>
      <<if $Finance?.bank?.opened>>
        <<set _deadwoodBankBalance to $Finance.bank.balance ?? 0>>
        <<set _deadwoodCreditDebt to $Finance.bank.credit_debt ?? 0>>
        <<set _deadwoodLoanDebt to $Finance.bank.loan_debt ?? 0>>
        <<lanSwitch 'Bank balance:' '银行余额：'>><<printmoney _deadwoodBankBalance>><br>
        <<lanSwitch 'Credit card debt:' '信用卡欠款：'>><<printmoney _deadwoodCreditDebt>><br>
        <<lanSwitch 'Personal loan debt:' '个人贷款余额：'>><<printmoney _deadwoodLoanDebt>><br>
      <<else>>
        <<lanSwitch 'Bank account not opened' '尚未开立银行账户'>><br>
      <</if>>
      <<lanSwitch 'Owned properties:' '已持有房产：'>>
      <span class='teal'><<= Object.values($Finance.real_estate?.owned ?? {}).filter(Boolean).length>></span><br>
      <<lanSwitch 'Cohabitants:' '同住者：'>>
      <span class='teal'><<= Object.values($Finance.real_estate?.residents ?? {}).flat().length>></span><br>
      <<if $Finance.brokerage?.opened>>
        <<language>><<option 'EN'>>Realised share-trading profit / loss: <<option 'CN'>>普通股票已实现盈亏：<</language>>
        <span @class="$Finance.brokerage.realised < 0 ? 'red' : 'green'"><<printmoney $Finance.brokerage.realised>></span><br>
        <<language>><<option 'EN'>>Stock dividends: <<option 'CN'>>股票累计分红：<</language>><<printmoney $Finance.brokerage.dividends>><br>
        <<language>><<option 'EN'>>Settled margin trades: <<option 'CN'>>保证金交易累计平仓：<</language>><span class='teal'><<= $Finance.brokerage.margin.closed ?? 0>></span><br>
        <<language>><<option 'EN'>>Margin-trading profit / loss after fees: <<option 'CN'>>保证金交易累计扣费盈亏：<</language>><<printmoney `$Finance.brokerage.margin.realised ?? 0`>><br>
      <</if>>
      <<if maplebirch.get('Robin') and $RobinExpansion?.investment?.agreed>>
        <<language>><<option 'EN'>>Shop partnership contributions: <<option 'CN'>>店铺合伙累计出资：<</language>><<printmoney $RobinExpansion.investment.invested_total>><br>
        <<language>><<option 'EN'>>Partnership dividends / buybacks: <<option 'CN'>>合伙累计分红／回购所得：<</language>><<printmoney $RobinExpansion.investment.dividends_total>> / <<printmoney $RobinExpansion.investment.returned_total>><br>
      <</if>><br>
    <</foldout>>
  <</if>>

  <<if maplebirch.get('Finance') and $Finance.industry.factories.some(factory => factory.purchase_price > 0 || factory.earned > 0 || factory.spent > 0)>>
    <<foldout false '_deadwoodFactoryAccounts'>>
      <span class='gold'><<language>><<option 'EN'>>Factory accounts<<option 'CN'>>工厂账目<</language>></span>
      <<language>><<option 'EN'>>Receipts / operating costs: <<option 'CN'>>累计经营收入／支出：<</language>><<printmoney `$Finance.industry.factories.reduce((sum, factory) => sum + factory.earned, 0)`>> / <<printmoney `$Finance.industry.factories.reduce((sum, factory) => sum + factory.spent, 0)`>><br>
      <<language>><<option 'EN'>>Delivered orders / bad debts: <<option 'CN'>>交付订单／坏账：<</language>><span class='teal'><<= $Finance.industry.factories.reduce((sum, factory) => sum + factory.delivered, 0)>> / <<= $Finance.industry.factories.reduce((sum, factory) => sum + factory.defaults, 0)>></span><br>
      <span class='blue'><<language>><<option 'EN'>>Fund transfers and loans are not sales. Land and the initial factory purchase are outside operating costs.<<option 'CN'>>资金转入与贷款不算销售收入。土地与初次购厂款不计入经营支出。<</language>></span><br><br>
    <</foldout>>
  <</if>>

  <<if maplebirch.get('Orchard') and $Orchard>>
    <<foldout false '_deadwoodOrchardAccounts'>>
      <span class='gold'><<language>><<option 'EN'>>Orchard accounts<<option 'CN'>>果园账目<</language>></span>
      <<language>><<option 'EN'>>Sales income: <<option 'CN'>>累计销售收入：<</language>><<printmoney `$Orchard.sales_income ?? 0`>><br>
      <<language>><<option 'EN'>>Staff wages: <<option 'CN'>>累计雇工工资：<</language>><<printmoney `$Orchard.worker_expenses ?? 0`>><br>
      <<language>><<option 'EN'>>Seed purchases: <<option 'CN'>>累计种苗开销：<</language>><<printmoney `$Orchard.seed_expenses ?? 0`>><br>
      <<language>><<option 'EN'>>Carrier fees: <<option 'CN'>>累计运输费：<</language>><<printmoney `$Orchard.haul_expenses ?? 0`>><br><br>
    <</foldout>>
  <</if>>

  <<if maplebirch.get('LifeSimulation') and $LifeSimulation?.casino?.statistics>>
    <<set _casinoStats to $LifeSimulation.casino.statistics>>
    <<if _casinoStats.rounds or _casinoStats.exchanged>>
      <<foldout false '_deadwoodCasinoAccounts'>>
        <span class='gold'><<language>><<option 'EN'>>Gambling records<<option 'CN'>>赌馆输赢记录<</language>></span>
        <<language>><<option 'EN'>>Completed hands and spins: <<option 'CN'>>已结算牌局与转轮：<</language>><span class='teal'><<= _casinoStats.rounds>></span><br>
        <<language>><<option 'EN'>>Blackjack / three-card poker / hold'em / slots: <<option 'CN'>>二十一点／炸金花／德州扑克／老虎机：<</language>><span class='teal'><<= _casinoStats.games.blackjack ?? 0>> / <<= _casinoStats.games.three_card ?? 0>> / <<= _casinoStats.games.holdem ?? 0>> / <<= _casinoStats.games.slots ?? 0>></span><br>
        <<language>><<option 'EN'>>Total staked / total paid, including returned stakes: <<option 'CN'>>累计下注／累计派彩（含取回的赌注）：<</language>><<printmoney _casinoStats.staked>> / <<printmoney _casinoStats.paid>><br>
        <<language>><<option 'EN'>>Net profit / loss: <<option 'CN'>>累计净盈亏：<</language>><span @class="_casinoStats.paid < _casinoStats.staked ? 'red' : 'green'"><<printmoney `_casinoStats.paid - _casinoStats.staked`>></span><br>
        <<language>><<option 'EN'>>Largest net win / loss in a hand or spin: <<option 'CN'>>单局最大净赢／净亏：<</language>><<printmoney _casinoStats.biggest_win>> / <<printmoney _casinoStats.biggest_loss>><br>
        <<language>><<option 'EN'>>Longest winning streak in one night: <<option 'CN'>>一晚最长连胜：<</language>><span class='teal'><<= _casinoStats.best_streak>></span><br>
        <<language>><<option 'EN'>>Highest net profit reached in one night: <<option 'CN'>>一晚最高净赢：<</language>><<printmoney _casinoStats.best_night_profit>><br>
        <<language>><<option 'EN'>>Chips purchased / redeemed: <<option 'CN'>>累计换入／兑回筹码：<</language>><<printmoney _casinoStats.exchanged>> / <<printmoney _casinoStats.redeemed>><br>
        <span class='blue'><<language>><<option 'EN'>>Exchanging chips and buying into a table do not count as winning or losing a hand. Records begin when this accounting is enabled.<<option 'CN'>>兑换筹码和买入牌桌不计入牌局输赢。记录从启用这项记账后开始累计。<</language>></span><br><br>
      <</foldout>>
    <</if>>
  <</if>>

  <<if (maplebirch.get('Robin') and $RobinExpansion)
    or (maplebirch.get('Sydney') and $SydneyExpansion)
    or (maplebirch.get('Whitney') and $WhitneyExpansion)
    or (maplebirch.get('Kylar') and $KylarExpansion)>>
    <<foldout false '_deadwoodPeopleFoldout'>>
      <span class='gold'><<lanSwitch 'Character routes' '人物路线'>></span>
      <<if maplebirch.get('Robin') and $RobinExpansion>>
        <<lanSwitch "Robin's stall upgrades:" '罗宾摊位改造：'>>
        <span class='teal'><<= ($RobinExpansion.lemonade ?? 0) + ($RobinExpansion.chocolate ?? 0)>> / 4</span><br>
        <<lanSwitch "Robin's shop:" '罗宾的店：'>>
        <<if $RobinExpansion.shop>><span class='green'><<lanSwitch 'Open' '已开业'>></span>
        <<else>><<lanSwitch 'Not open' '未开业'>><</if>><br>
      <</if>>
      <<if maplebirch.get('Sydney') and $SydneyExpansion>>
        <<lanSwitch "Sydney's dorm bed:" '悉尼宿舍床位：'>>
        <<if $SydneyExpansion.dormInvited>><span class='green'><<lanSwitch 'Invited' '已获邀请'>></span>
        <<else>><<lanSwitch 'Not invited' '未获邀请'>><</if>><br>
        <<lanSwitch "Sirris's estate:" '西里斯庄园：'>>
        <<if $SydneyExpansion.estate?.invited>><span class='green'><<lanSwitch 'Address known' '已获得地址'>></span>
        <<else>><<lanSwitch 'Address unknown' '尚未知晓地址'>><</if>><br>
      <</if>>
      <<if maplebirch.get('Whitney') and $WhitneyExpansion>>
        <<lanSwitch 'Whitney rescued from the basement:' '地下妓院营救惠特尼：'>>
        <<if $WhitneyExpansion.rescued>><span class='green'><<lanSwitch 'Yes' '已完成'>></span>
        <<else>><<lanSwitch 'No' '未完成'>><</if>><br>
      <</if>>
      <<if maplebirch.get('Kylar') and $KylarExpansion>>
        <<lanSwitch "Kylar's manor stay:" '凯拉尔庄园留宿：'>>
        <<if $KylarExpansion.stay_invited>><span class='green'><<lanSwitch 'Invited' '已获邀请'>></span>
        <<else>><<lanSwitch 'Not invited' '未获邀请'>><</if>><br>
      <</if>>
      <br>
    <</foldout>>
  <</if>>
<</widget>>

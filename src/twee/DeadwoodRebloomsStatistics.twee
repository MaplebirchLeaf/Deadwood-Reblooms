:: Deadwood Reblooms Statistics [widget]

<!-- 统计只读累计记录和属性成长，当前约定与线索由日志显示。 -->
<<widget 'deadwood-reblooms-statistics'>>
  <<if maplebirch.get('VanillaPlus') and $VanillaPlus>>
    <<foldout false "_deadwoodAttributesFoldout">>
      <span class='gold'><<lanSwitch 'Attribute breakthroughs' '属性突破'>></span>
      <<lanSwitch 'Ceilings unlocked: ' '已突破属性：'>>
      <<= Object.values($VanillaPlus.lock ?? {}).filter(Boolean).length>> / 6<br>
      <<lanSwitch 'Breakthrough traits:' '突破特质：'>>
      <span class='green'><<= Object.values($VanillaPlus.traits ?? {}).filter(Boolean).length>> / 7</span><br>
      <<deadwood-reblooms-breakthrough-progress>>
    <</foldout>>
  <</if>>

  <<if maplebirch.get('MoreTransformations') and $maplebirch?.transformation>>
    <<foldout false "_deadwoodTransformationsFoldout">>
      <span class='gold'><<lanSwitch 'Transformations' '转化进度'>></span>
      <<lanSwitch 'Raven transformation:' '渡鸦转化：'>>
      <span class='purple'><<= $maplebirch.transformation.raven?.level ?? 0>> / 6</span>
      (<span class='purple'><<= $maplebirch.transformation.raven?.build ?? 0>> / 100</span>)<br>
      <<lanSwitch 'Horse transformation:' '马转化：'>>
      <span class='softbrown'><<= $maplebirch?.transformation?.horse?.level ?? 0>> / 6</span>
      (<span class='softbrown'><<= $maplebirch?.transformation?.horse?.build ?? 0>> / 100</span>)<br>
      <<lanSwitch 'Whale transformation:' '鲸转化：'>>
      <span class='lblue'><<= $maplebirch?.transformation?.whale?.level ?? 0>> / 6</span>
      (<span class='lblue'><<= $maplebirch?.transformation?.whale?.build ?? 0>> / 100</span>)<br>
      <<deadwood-reblooms-progress-check `($maplebirch.transformation.raven?.level ?? 0) >= 6` `["Complete the raven transformation", "完成渡鸦转化"]`>>
      <<deadwood-reblooms-progress-check `($maplebirch.transformation.horse?.level ?? 0) >= 6` `["Complete the horse transformation", "完成马转化"]`>>
      <<deadwood-reblooms-progress-check `($maplebirch.transformation.whale?.level ?? 0) >= 6` `["Complete the whale transformation", "完成鲸转化"]`>>
      <<if $MoreTransformations?.shrine>>
        <<deadwood-reblooms-progress-check `$MoreTransformations.shrine.stage >= 1` `["Receive the raven’s letter", "接过渡鸦衔来的信"]`>>
        <<deadwood-reblooms-progress-check `$MoreTransformations.shrine.stage >= 2` `["Take the letter to Gwylan", "把信交给格威岚"]`>>
        <<deadwood-reblooms-progress-check `$MoreTransformations.shrine.stage >= 3` `["Find Darkfeather Shrine", "找到黯羽神社"]`>>
        <<if $MoreTransformations.shrine.stage is 3>>
          <br><span class='gold'><<lanSwitch 'Darkfeather Shrine' '黯羽神社'>></span><br>
          <<lanSwitch 'Days helping at the shrine: ' '神社帮忙天数：'>><<= $MoreTransformations.shrine.helped>><br>
          <<lanSwitch 'Offerings left: ' '累计奉纳：'>><span class='gold'><<= formatMoney($MoreTransformations.shrine.donations)>></span><br>
          <<lanSwitch 'Walks with Tsukihan: ' '与月羽散步次数：'>><<= $MoreTransformations.shrine.walks ?? 0>><br>
          <<if ($MoreTransformations.shrine.sex_total ?? 0) gt 0>>
            <<lanSwitch 'Times intimate with Tsukihan: ' '与月羽温存次数：'>><<= $MoreTransformations.shrine.sex_total>><br>
          <</if>>
        <</if>>
      <</if>>
      <<if $MoreTransformations?.harbour?.raid?.encounters gt 0>>
        <br><span class='gold'><<lanSwitch 'Undead boarders' '亡灵船袭'>></span><br>
        <<lanSwitch 'Attacks witnessed: ' '遭遇袭击：'>><<= $MoreTransformations.harbour.raid.encounters>><br>
        <<lanSwitch 'Boarders repelled or ropes cut: ' '击退登船者或成功断绳：'>><<= $MoreTransformations.harbour.raid.victories>><br>
        <<lanSwitch 'Sailors rescued: ' '救起船员：'>><<= $MoreTransformations.harbour.raid.rescues>><br>
      <</if>>
      <<if $MoreTransformations?.treasure?.found>>
        <br><span class='gold'><<lanSwitch 'The island gold' '海岛藏金'>></span><br>
        <<deadwood-reblooms-progress-check `$MoreTransformations.treasure.visited.includes('vault')` `["Find the stone chest", "找到藏金石箱"]`>>
        <<deadwood-reblooms-progress-check `$MoreTransformations.treasure.appraised` `["Have the coins examined", "鉴定海岛金币"]`>>
        <<lanSwitch 'Cavern areas explored: ' '已探索的洞窟区域：'>><<= $MoreTransformations.treasure.visited.length>><br>
        <<lanSwitch 'Completed returns: ' '完整归还次数：'>><<= $MoreTransformations.treasure.returns>><br>
      <</if>>
      <br>
    <</foldout>>
  <</if>>

  <<if maplebirch.get('LifeSimulation') and $LifeSimulation?.school>>
    <<foldout false "_deadwoodSchoolFoldout">>
      <span class='gold'><<lanSwitch 'School life' '校园生活'>></span>
      <<deadwood-reblooms-progress-check `$LifeSimulation.school.attendanceExempt` `["Obtain an attendance pass", "取得免听凭证"]`>>
      <<deadwood-reblooms-progress-check `['prefect', 'president'].includes($LifeSimulation.school.role)` `["Become a prefect", "担任风纪委员"]`>>
      <<deadwood-reblooms-progress-check `$LifeSimulation.school.role === 'president'` `["Become student president", "担任学生会长"]`>>
      <<if ['won', 'done'].includes($LifeSimulation.historyProject?.status)>>
        <<lanSwitch 'History exhibition: ' '历史展览：'>>
        <<if $LifeSimulation.historyProject.status is 'won'>><span class='green'><<lanSwitch 'Top evaluation' '最高评价'>></span>
        <<else>><<lanSwitch 'Completed' '已完成'>><</if>><br>
      <</if>>
      <<lanSwitch 'Morning duties completed: ' '晨间值勤次数：'>><<= $LifeSimulation.school.duties.completed>><br><br>
    <</foldout>>
  <</if>>

  <<if maplebirch.get('Finance') and $Finance>>
    <<foldout false "_deadwoodFinanceFoldout">>
      <span class='gold'><<lanSwitch 'Finance and property' '金融与房产'>></span>
      <<deadwood-reblooms-progress-check `Boolean($Finance.bank?.opened)` `["Open a bank account", "开立银行账户"]`>>
      <<deadwood-reblooms-progress-check `Boolean($Finance.brokerage?.opened)` `["Open a share-trading account", "开立股票交易账户"]`>>
      <<lanSwitch 'Owned properties:' '已持有房产：'>>
      <<= Object.values($Finance.real_estate?.owned ?? {}).filter(Boolean).length>><br>
      <<lanSwitch 'Cohabitants:' '同住者：'>>
      <<= Object.values($Finance.real_estate?.residents ?? {}).flat().length>><br>
      <<if $Finance.brokerage?.opened>>
        <<lanSwitch "Realised share-trading profit / loss: " "普通股票已实现盈亏：">>
        <span class='gold'><<= formatMoney($Finance.brokerage.realised)>></span><br>
        <<lanSwitch "Stock dividends: " "股票累计分红：">><span class='gold'><<= formatMoney($Finance.brokerage.dividends)>></span><br>
        <<lanSwitch "Settled margin trades: " "保证金交易累计平仓：">><<= $Finance.brokerage.margin.closed ?? 0>><br>
        <<lanSwitch "Margin-trading profit / loss after fees: " "保证金交易累计扣费盈亏：">><span class='gold'><<= formatMoney($Finance.brokerage.margin.realised ?? 0)>></span><br>
      <</if>>
      <<if maplebirch.get('Robin') and $RobinExpansion?.investment?.agreed>>
        <<lanSwitch "Shop partnership contributions: " "店铺合伙累计出资：">><span class='gold'><<= formatMoney($RobinExpansion.investment.invested_total)>></span><br>
        <<lanSwitch "Partnership dividends / buybacks: " "合伙累计分红／回购所得：">><span class='gold'><<= formatMoney($RobinExpansion.investment.dividends_total)>></span> / <span class='gold'><<= formatMoney($RobinExpansion.investment.returned_total)>></span><br>
      <</if>><br>
    <</foldout>>
  <</if>>

  <<if maplebirch.get('Finance') and $Finance?.company and ($Finance.company.name or $Finance.company.completed or $Finance.company.shareholders?.board or $Finance.company.shareholders?.transferred or $Finance.company.shareholders?.funded_stages?.length)>>
    <<set _deadwoodCompany to $Finance.company, _deadwoodGovernance to _deadwoodCompany.shareholders>>
    <<foldout false "_deadwoodCompanyFoldout">>
      <span class='gold'><<lanSwitch 'Company and governance records' '企业与治理记录'>></span>
      <<deadwood-reblooms-progress-check `maplebirch.get('Finance').company.shareholders.director || maplebirch.get('Finance').company.shareholders.controller` `["Secure a board seat", "取得董事席位"]`>>
      <<deadwood-reblooms-progress-check `maplebirch.get('Finance').company.shareholders.controller` `["Become the controlling shareholder", "成为控股股东"]`>>
      <<lanSwitch 'Settled Avery company contracts: ' '已结清的艾弗里公司合同：'>><<= _deadwoodCompany.completed ?? 0>><br>
      <<if _deadwoodGovernance>>
        <<lanSwitch 'Unlisted shares acquired by negotiation: ' '议价受让的未上市股数：'>><<= _deadwoodGovernance.transferred ?? 0>><br>
        <<lanSwitch 'Tower construction stages funded: ' '已出资的高塔工程阶段：'>><<= _deadwoodGovernance.funded_stages?.length ?? 0>><br>
        <<lanSwitch 'Company funds spent on tower construction: ' '公司资金已支付的高塔工程款：'>><span class='gold'><<= formatMoney(_deadwoodGovernance.project_spent ?? 0)>></span><br>
      <</if>>
      <span class='small-description'><i><<lanSwitch 'Only construction costs already paid from company funds count here. Reserved funds are excluded.' '这里只计公司已经支付的工程款，不含尚未动用的预留款。'>></i></span><br><br>
    <</foldout>>
  <</if>>

  <<if maplebirch.get('Finance') and $Finance?.industry?.factories?.some(factory => factory.owned || factory.earned || factory.spent || factory.delivered || factory.defaults)>>
    <<set _deadwoodFactories to $Finance.industry.factories, _deadwoodDistribution to $Finance.industry.distribution>>
    <<foldout false "_deadwoodFactoriesFoldout">>
      <span class='gold'><<lanSwitch "Factory accounts" "工厂账目">></span>
      <<deadwood-reblooms-progress-check `_deadwoodFactories.some(factory => factory.owned)` `["Own a factory", "持有一间工厂"]`>>
      <<deadwood-reblooms-progress-check `_deadwoodFactories.some(factory => factory.delivered > 0)` `["Deliver a factory order", "交付一份工厂订单"]`>>
      <<lanSwitch 'Factories currently owned: ' '当前持有工厂：'>><<= _deadwoodFactories.filter(factory => factory.owned).length>><br>
      <<lanSwitch "Receipts / operating costs: " "累计经营收入／支出：">><span class='gold'><<= formatMoney(_deadwoodFactories.reduce((sum, factory) => sum + (factory.earned ?? 0), 0))>></span> / <span class='gold'><<= formatMoney(_deadwoodFactories.reduce((sum, factory) => sum + (factory.spent ?? 0), 0))>></span><br>
      <<lanSwitch "Delivered orders / bad debts: " "交付订单／坏账：">><<= _deadwoodFactories.reduce((sum, factory) => sum + (factory.delivered ?? 0), 0)>> / <<= _deadwoodFactories.reduce((sum, factory) => sum + (factory.defaults ?? 0), 0)>><br>
      <<if _deadwoodDistribution and (_deadwoodDistribution.compound_sales or _deadwoodDistribution.independent_sales or _deadwoodFactories.some(factory => factory.laboratory?.installed))>>
        <<lanSwitch 'Medicine bottles dispatched to the compound / independent buyers: ' '向大院／独立渠道累计发运的药品瓶数：'>><<= _deadwoodDistribution.compound_sales ?? 0>> / <<= _deadwoodDistribution.independent_sales ?? 0>><br>
        <span class='small-description'><i><<lanSwitch 'Dispatched bottles are recorded before invoice payment; their value is included in receipts only when paid.' '发运瓶数在账款支付前登记，收到货款后才计入经营收入。'>></i></span><br>
      <</if>>
      <span class='small-description'><i><<lanSwitch "Fund transfers and loans are not sales. Land and the initial factory purchase are outside operating costs." "资金转入与贷款不算销售收入。土地与初次购厂款不计入经营支出。">></i></span><br><br>
    <</foldout>>
  <</if>>

  <<if maplebirch.get('Orchard') and $Orchard>>
    <<foldout false "_deadwoodOrchardFoldout">>
      <span class='gold'><<lanSwitch "Orchard accounts" "果园账目">></span>
      <<deadwood-reblooms-progress-check `($Orchard.orders_completed ?? 0) > 0` `["Fulfil a shop supply order", "履行一份店铺供货单"]`>>
      <<deadwood-reblooms-progress-check `Boolean($Orchard.winery?.installed)` `["Install the winery equipment", "装设酿酒器具"]`>>
      <<lanSwitch "Fruit sales income: " "累计果品销售收入：">><span class='gold'><<= formatMoney($Orchard.sales_income ?? 0)>></span><br>
      <<lanSwitch "Orchard worker wages: " "累计果树雇工工资：">><span class='gold'><<= formatMoney($Orchard.worker_expenses ?? 0)>></span><br>
      <<lanSwitch "Seed purchases: " "累计种苗开销：">><span class='gold'><<= formatMoney($Orchard.seed_expenses ?? 0)>></span><br>
      <<lanSwitch "Carrier fees: " "累计运输费：">><span class='gold'><<= formatMoney($Orchard.haul_expenses ?? 0)>></span><br>
      <<lanSwitch "Shop supply orders fulfilled: " "已履行的店铺供货单：">><<= $Orchard.orders_completed ?? 0>><br>
      <<lanSwitch "Farm supply contracts fulfilled: " "已履行的农场供货合同：">><<= $Orchard.contracts_completed ?? 0>><br>
      <<lanSwitch "Regular-customer sales: " "熟客成交次数：">><<= $Orchard.regular_visits ?? 0>><br>
      <<if $Orchard.winery?.installed>>
        <<deadwood-reblooms-progress-check `maplebirch.get('Orchard').winery.skilled` `["Cellar Hand", "酿酒熟手"]`>>
        <<lanSwitch 'Wine bottled: ' '已装瓶果酒：'>><<= $Orchard.winery.produced>><br>
        <<lanSwitch 'Wine sold wholesale / supplied to Robin: ' '批发／供应罗宾的果酒：'>><<= $Orchard.winery.sold>> / <<= $Orchard.winery.supplied>><br>
        <<lanSwitch 'Wine sales income: ' '累计果酒销售收入：'>><span class='gold'><<= formatMoney($Orchard.winery.income)>></span><br>
        <<lanSwitch 'Winery equipment, processing, bottles and delivery costs: ' '酿酒器具、加工、酒瓶与配送开销：'>><span class='gold'><<= formatMoney($Orchard.winery.expenses)>></span><br>
        <<if $Orchard.winery.automation?.installed>>
          <<lanSwitch 'Production line: ' '自动生产线：'>><span class='green'><<lanSwitch 'Installed' '已装设'>></span><br>
          <<lanSwitch 'Automatic delivery fees: ' '累计自动配送费：'>><span class='gold'><<= formatMoney($Orchard.winery.automation.fees)>></span><br>
        <</if>>
      <</if>>
      <<if $Orchard.staff?.spent>>
        <<lanSwitch "Trapper recruitment, escort and search spending: " "捕手雇佣、护送与搜寻累计支出：">><span class='gold'><<= formatMoney($Orchard.staff.spent)>></span><br>
      <</if>>
      <span class='small-description'><i><<lanSwitch 'Sales income includes fruit supplied from your existing inventory. Returned farm-contract deposits are excluded.' '销售收入包含从现有库存交付的果品，不包含退还的农场合同保证金。'>></i></span><br><br>
    <</foldout>>
  <</if>>

  <<if maplebirch.get('LifeSimulation') and $LifeSimulation?.casino?.statistics>>
    <<set _casinoStats to $LifeSimulation.casino.statistics>>
    <<if _casinoStats.rounds or _casinoStats.exchanged or $LifeSimulation.casino.shifts or $LifeSimulation.casino.cheating_caught>>
      <<foldout false "_deadwoodCasinoFoldout">>
        <span class='gold'><<lanSwitch "Casino records" "赌馆记录">></span>
        <<deadwood-reblooms-progress-check `(_casinoStats.rounds ?? 0) > 0` `["Finish a casino game", "结算一局赌馆游戏"]`>>
        <<if $LifeSimulation.casino.shifts>>
          <<deadwood-reblooms-progress-check `$LifeSimulation.casino.trained and $LifeSimulation.casino.good_shifts gte 10` `["Practised Dealer", "熟练荷官"]`>>
          <<lanSwitch 'Work shifts completed / successful shifts: ' '已完成班次／表现良好的班次：'>><<= $LifeSimulation.casino.shifts>> / <<= $LifeSimulation.casino.good_shifts ?? 0>><br>
        <</if>>
        <<if $LifeSimulation.casino.cheating_caught>>
          <<lanSwitch 'Times caught cheating: ' '出千被发现次数：'>><span class='red'><<= $LifeSimulation.casino.cheating_caught>></span><br>
        <</if>>
        <<if _casinoStats.rounds or _casinoStats.exchanged>>
        <<lanSwitch "Completed hands and spins: " "已结算牌局与转轮：">><<= _casinoStats.rounds>><br>
        <<lanSwitch "Blackjack / Zha Jin Hua / hold'em / slots / Sic Bo: " "二十一点／炸金花／德州扑克／老虎机／骰宝：">><<= _casinoStats.games.blackjack ?? 0>> / <<= _casinoStats.games.three_card ?? 0>> / <<= _casinoStats.games.holdem ?? 0>> / <<= _casinoStats.games.slots ?? 0>> / <<= _casinoStats.games.sic_bo ?? 0>><br>
        <<lanSwitch "Total staked / total paid, including returned stakes: " "累计下注／累计派彩（含取回的赌注）：">><span class='gold'><<= formatMoney(_casinoStats.staked)>></span> / <span class='gold'><<= formatMoney(_casinoStats.paid)>></span><br>
        <<lanSwitch "Net profit / loss: " "累计净盈亏：">><span class='gold'><<= formatMoney(_casinoStats.paid - _casinoStats.staked)>></span><br>
        <<lanSwitch "Largest net win / loss in a hand or spin: " "单局最大净赢／净亏：">><span class='gold'><<= formatMoney(_casinoStats.biggest_win)>></span> / <span class='gold'><<= formatMoney(_casinoStats.biggest_loss)>></span><br>
        <<lanSwitch "Longest winning streak in one night: " "一晚最长连胜：">><<= _casinoStats.best_streak>><br>
        <<lanSwitch "Highest net profit reached in one night: " "一晚最高净赢：">><span class='gold'><<= formatMoney(_casinoStats.best_night_profit)>></span><br>
        <<lanSwitch "Chips purchased / redeemed: " "累计换入／兑回筹码：">><span class='gold'><<= formatMoney(_casinoStats.exchanged)>></span> / <span class='gold'><<= formatMoney(_casinoStats.redeemed)>></span><br>
        <span class='small-description'><i><<language>>
          <<option 'EN'>>
            Exchanging chips and buying into a table do not count as winning or losing a hand. Records begin when this accounting is enabled.
          <<option 'CN'>>
            兑换筹码和买入牌桌不计入牌局输赢。记录从启用这项记账后开始累计。
        <</language>></i></span><br><br>
        <</if>>
      <</foldout>>
    <</if>>
  <</if>>

  <<if maplebirch.get('Transport') and $Transport and ($Transport.vehicles?.length or $Transport.driving or $Transport.school?.motorcycle?.licensed or $Transport.school?.motor_vehicle?.licensed or $Transport.taxi?.registered or $Transport.taxi?.completed)>>
    <<foldout false "_deadwoodTransportFoldout">>
      <span class='gold'><<lanSwitch 'Transport records' '交通记录'>></span>
      <<deadwood-reblooms-progress-check `Boolean($Transport.school?.motorcycle?.licensed)` `["Obtain a motorcycle licence", "取得摩托车驾驶资格"]`>>
      <<deadwood-reblooms-progress-check `Boolean($Transport.school?.motor_vehicle?.licensed)` `["Obtain a car driving licence", "取得汽车驾驶资格"]`>>
      <<lanSwitch 'Vehicles currently owned: ' '当前持有车辆：'>><<= $Transport.vehicles?.length ?? 0>><br>
      <<lanSwitch 'Driving licences held: ' '已取得驾驶资格：'>><<= Number(Boolean($Transport.school?.motorcycle?.licensed)) + Number(Boolean($Transport.school?.motor_vehicle?.licensed))>> / 2<br>
      <<lanSwitch 'Driving experience: ' '驾驶经验：'>><<= $Transport.driving ?? 0>> / 1000<br>
      <<if $Transport.taxi?.registered or $Transport.taxi?.completed>>
        <<lanSwitch 'Taxi bookings completed: ' '已结算出租车订单：'>><<= $Transport.taxi.completed ?? 0>><br>
        <<lanSwitch 'Taxi earnings collected: ' '出租车累计实收：'>><span class='gold'><<= formatMoney($Transport.taxi.earnings ?? 0)>></span><br>
        <span class='small-description'><i><<lanSwitch 'Earnings include paid tips after commission and fleet recovery charges. Unpaid earnings from a fleet shift are excluded.' '实收包含已支付小费，并扣除分成与车队回收费。车队班次尚未支付的工资不计入。'>></i></span><br>
      <</if>><br>
    <</foldout>>
  <</if>>

  <<if maplebirch.get('StreetLife') and $StreetLife>>
    <<set _deadwoodJobs to $StreetLife.jobs, _deadwoodBounties to $StreetLife.bounties, _deadwoodHeist to $StreetLife.heist, _deadwoodRaces to $StreetLife.races>>
    <<if _deadwoodJobs?.completed or _deadwoodJobs?.losses or _deadwoodBounties?.completed or _deadwoodBounties?.leads or _deadwoodBounties?.arrested or _deadwoodRaces?.started or (_deadwoodHeist?.stage is 'closed' and _deadwoodHeist.settled) or $smuggler_pub_known is 1>>
      <<foldout false "_deadwoodStreetFoldout">>
        <span class='gold'><<lanSwitch 'Street work and cases' '街头差事与案件'>></span>
        <<deadwood-reblooms-progress-check `$smuggler_pub_known === 1` `["Find the smugglers’ pub", "找到走私者酒馆"]`>>
        <<deadwood-reblooms-progress-check `(_deadwoodJobs?.completed ?? 0) > 0` `["Collect payment for a street job", "领取一份街头委托的报酬"]`>>
        <<deadwood-street-story-statistics>>
        <<if _deadwoodRaces?.started>>
          <<lanSwitch 'Road races entered / finished / won: ' '公路赛报名／完赛／冠军：'>><<= _deadwoodRaces.started>> / <<= _deadwoodRaces.completed>> / <<= _deadwoodRaces.wins>><br>
          <<lanSwitch 'Race entry fees paid: ' '赛事报名累计支出：'>><span class='gold'><<= formatMoney(_deadwoodRaces.fees)>></span><br>
          <<lanSwitch 'Race prizes collected: ' '赛事奖金累计实收：'>><span class='gold'><<= formatMoney(_deadwoodRaces.earned)>></span><br>
          <span class='small-description'><i><<lanSwitch 'Prize income is before entry fees, fuel and repairs.' '奖金实收尚未扣除报名费、燃油和修车费用。'>></i></span><br>
        <</if>>
        <<if _deadwoodJobs>>
          <<lanSwitch 'Street jobs paid: ' '已领款的街头委托：'>><<= _deadwoodJobs.completed ?? 0>><br>
          <<lanSwitch 'Street job rewards collected: ' '街头委托累计实收：'>><span class='gold'><<= formatMoney(_deadwoodJobs.earned ?? 0)>></span><br>
          <<lanSwitch 'Cargo losses reported: ' '已结案的货物丢失：'>><span class='red'><<= _deadwoodJobs.losses ?? 0>></span><br>
          <<set _deadwoodCrewWork to Object.values($per_npc ?? {}).filter(npc => npc.heist?.businessCompleted gt 0)>>
          <<if _deadwoodCrewWork.length>>
            <<lanSwitch 'Colleague deliveries paid: ' '已结算的合作人委托：'>><<= _deadwoodCrewWork.reduce((sum, npc) => sum + npc.heist.businessCompleted, 0)>><br>
            <<lanSwitch 'Colleagues\' shares paid: ' '合作人累计实领：'>><span class='gold'><<= formatMoney(_deadwoodCrewWork.reduce((sum, npc) => sum + (npc.heist.businessEarned ?? 0), 0))>></span><br>
            <span class='small-description'><i><<lanSwitch 'Street job earnings show your share after colleagues are paid.' '街头委托累计实收统计你扣除合作人分成后的所得。'>></i></span><br>
          <</if>>
        <</if>>
        <<if _deadwoodBounties>>
          <<deadwood-reblooms-progress-check `maplebirch.get('StreetLife').bounties.bountyHunter` `["Obtain Bounty Hunter", "取得赏金猎人特质"]`>>
          <<lanSwitch 'Verified leads paid: ' '已领款的核实线索：'>><<= _deadwoodBounties.leads ?? 0>><br>
          <<lanSwitch 'Verified bounties paid: ' '已领款的核验悬赏：'>><<= _deadwoodBounties.completed ?? 0>><br>
          <<lanSwitch 'Bounty rewards collected: ' '悬赏累计实收：'>><span class='gold'><<= formatMoney(_deadwoodBounties.earned ?? 0)>></span><br>
          <<lanSwitch 'Bounty types paid: ' '已领款的悬赏类型：'>><<= maplebirch.get('StreetLife').bounties.terms.cases.length - maplebirch.get('StreetLife').bounties.remainingTypes.length>> / <<= maplebirch.get('StreetLife').bounties.terms.cases.length>><br>
          <<lanSwitch 'Arrests by bounty hunters: ' '被赏金猎人移交拘捕次数：'>><span class='red'><<= _deadwoodBounties.arrested ?? 0>></span><br>
        <</if>>
        <<if _deadwoodHeist?.stage is 'closed' and _deadwoodHeist.settled>>
          <<lanSwitch 'Bank operation outcome: ' '已结案的银行行动结果：'>>
          <<switch _deadwoodHeist.outcome>>
            <<case 'success'>><span class='green'><<lanSwitch 'Successful robbery' '豪劫成功'>></span>
            <<case 'reported'>><span class='green'><<lanSwitch 'Evidence submitted to police' '已向警方提交线索'>></span>
            <<case 'sting'>><span class='green'><<lanSwitch 'Police handover' '已完成警方交接'>></span>
            <<case 'withdrawn'>><<lanSwitch 'Withdrawn' '主动撤退'>>
            <<case 'arrested'>><span class='red'><<lanSwitch 'Arrested' '被捕'>></span>
            <<default>><span class='red'><<lanSwitch 'Failed' '行动失败'>></span>
          <</switch>><br>
          <<lanSwitch 'Recorded heist preparation expenses: ' '已记录的豪劫筹备支出：'>><span class='gold'><<= formatMoney(_deadwoodHeist.spent)>></span><br>
          <<if _deadwoodHeist.outcome is 'success' and _deadwoodHeist.shares>>
            <<lanSwitch 'Bank operation share collected: ' '本次银行行动分账实收：'>><span class='gold'><<= formatMoney(Math.floor(_deadwoodHeist.loot * _deadwoodHeist.shares.pc / 100))>></span><br>
            <<lanSwitch 'Share less recorded preparation expenses: ' '分账扣除已记录筹备支出后：'>><span class='gold'><<= formatMoney(Math.floor(_deadwoodHeist.loot * _deadwoodHeist.shares.pc / 100) - _deadwoodHeist.spent)>></span><br>
            <span class='small-description'><i><<lanSwitch 'Preparation expenses include recorded supplies, recruitment fees and Mickey\'s review. Fuel and vehicle repairs are separate.' '筹备支出包含已记录的用品、招募定金与米奇复核费用。燃油和修车开销另计。'>></i></span><br>
          <</if>>
        <</if>>
        <span class='small-description'><i><<lanSwitch 'Job rewards are recorded when paid. Bounty income includes capture rewards, paid bonuses and verified lead fees; bank-operation shares and police statement rewards are separate.' '委托报酬在领款时登记。悬赏实收包含抓捕报酬、已支付奖金与核实线索费。银行行动分账与警方笔录奖励另计。'>></i></span><br><br>
      <</foldout>>
    <</if>>
  <</if>>

  <<if (maplebirch.get('Robin') and C.npc.Robin.init is 1 and $RobinExpansion)
    or (maplebirch.get('Sydney') and C.npc.Sydney.init is 1 and $SydneyExpansion)
    or (maplebirch.get('Whitney') and C.npc.Whitney.init is 1 and $WhitneyExpansion)
    or (maplebirch.get('Kylar') and C.npc.Kylar.init is 1 and $KylarExpansion)>>
    <<foldout false "_deadwoodCharactersFoldout">>
      <span class='gold'><<lanSwitch 'Character routes' '人物路线'>></span>
      <<if maplebirch.get('Robin') and C.npc.Robin.init is 1 and $RobinExpansion>>
        <<lanSwitch 'Stall upgrades: ' '摊位改造次数：'>><<= ($RobinExpansion.lemonade ?? 0) + ($RobinExpansion.chocolate ?? 0)>> / 4<br>
        <<deadwood-reblooms-progress-check `Boolean($RobinExpansion.shop)` `["Open Robin’s shop", "罗宾的店开业"]`>>
      <</if>>
      <<if maplebirch.get('Sydney') and C.npc.Sydney.init is 1 and $SydneyExpansion>>
        <<deadwood-reblooms-progress-check `Boolean($SydneyExpansion.dormInvited)` `["Receive Sydney’s dorm invitation", "获得悉尼宿舍的邀请"]`>>
        <<deadwood-reblooms-progress-check `Boolean($SydneyExpansion.estate?.invited)` `["Learn the address of Sirris’s estate", "得知西里斯庄园地址"]`>>
      <</if>>
      <<if maplebirch.get('Whitney') and C.npc.Whitney.init is 1 and $WhitneyExpansion>>
        <<deadwood-reblooms-progress-check `Boolean($WhitneyExpansion.rescued)` `["Rescue Whitney from the basement", "从地下妓院救出惠特尼"]`>>
      <</if>>
      <<if maplebirch.get('Kylar') and C.npc.Kylar.init is 1 and $KylarExpansion>>
        <<deadwood-reblooms-progress-check `Boolean($KylarExpansion.stay_invited)` `["Receive Kylar’s invitation to stay at the manor", "获得凯拉尔庄园留宿的邀请"]`>>
      <</if>><br>
    <</foldout>>
  <</if>>
<</widget>>


<<widget 'deadwood-reblooms-breakthrough-progress'>>
  <<set $_progressModule to maplebirch.get('VanillaPlus')>>
  <<for $_attribute range $_progressModule.progress>>
    <<set $_requirements to $_progressModule[$_attribute.id].requirements>>
    <br><span class='gold'><<lanSwitch $_attribute.name>></span> —
    <<if $VanillaPlus.lock[$_attribute.id]>><span class='green'><<lanSwitch 'Ceiling unlocked' '已突破'>></span>
    <<else>>
      <<lanSwitch 'Requirements met: ' '已满足突破条件：'>><<= $_requirements.filter(Boolean).length>> / <<= $_requirements.length>>
    <</if>>
    <<if $VanillaPlus.traits[$_attribute.id]>> · <span class='green'><<lanSwitch 'Trait obtained' '已获得特质'>></span><</if>><br>
    <<lanSwitch 'Current / normal ceiling / new ceiling: ' '当前值／原版上限／突破上限：'>><<= V[$_attribute.id]>> / <<= $_progressModule.normalCeiling($_attribute.id)>> / <<= $_progressModule.ceiling($_attribute.id)>><br>
    <<for $_index, $_step range $_attribute.steps>>
      <<deadwood-reblooms-progress-check $_requirements[$_index] $_step.text>>
    <</for>>
    <<if $_attribute.id is 'exhibitionism'>>
      <<lanSwitch 'Nude swimming counter: ' '裸泳计数：'>><<= $swimnudecounter ?? 0>><br>
    <</if>>
  <</for>><br>
<</widget>>

<!-- 各模块与属性突破共用圈／勾样式，只读取调用处的条件。 -->
<<widget 'deadwood-reblooms-progress-check'>>
  <<if _args[0]>><span class='green'>✓ <<lanSwitch _args[1]>></span>
  <<else>><span class='red'>○ <<lanSwitch _args[1]>></span><</if>><br>
  <<if _args[2]>><span class='small-description'><i><<lanSwitch _args[2]>></i></span><br><</if>>
<</widget>>

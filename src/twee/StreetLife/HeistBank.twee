:: Deadwood Street Bank Campaign Widgets [widget]

<!-- 银行各阶段只由当页点击推进，额外骰点在出发时保存。 -->
<<widget 'deadwood-heist-bank-action'>>
  <<set _bank_work to maplebirch.get('StreetLife')?.heist, _bank_campaign to _bank_work?.state.campaign, _bank_action to _args[0]>>
  <<if !_bank_campaign or !_bank_work.available or !_bank_work.inAction or $passage isnot 'Deadwood Street Heist' or _bank_campaign.fight or !$StreetLife.heist.rolls>><<exit>><</if>>
  <<set _bank_step to _bank_campaign.bank_step, _bank_chance to 0, _bank_minutes to 5>>
  <<switch _bank_action>>
    <<case 'enter' 'warn' 'clear' 'loading'>>
      <<if _bank_step isnot 0 or _bank_work.state.entered>><<exit>><</if>>
      <<if _bank_action is 'loading' and !_bank_campaign.dock.steps.includes('loading_route')>><<exit>><</if>>
      <<if _bank_action is 'warn' and !(C.npc.Adrian?.init is 1 and C.npc.Adrian.state is 'active' and maplebirch.npc.Schedule.get('Adrian').location is 'financial_centre' and C.npc.Adrian.love gte 20 and $face isnot 'covered' and !$worn.face.type.includesAny('mask', 'gag'))>><<exit>><</if>>
      <<if _bank_action is 'clear' and $worn.face.type.includes('gag')>><<exit>><</if>>
      <<set _bank_campaign.clerk to _bank_action is 'enter' ? '' : _bank_action is 'warn' ? 'warned' : _bank_action is 'clear' ? 'cleared' : 'loading'>>
      <<if ['warn', 'clear'].includes(_bank_action)>><<set _bank_work.state.approach to 'loud', _bank_campaign.alarm += 1>><</if>>
      <<set _bank_work.state.entered to true, _bank_work.state.bankClosedUntil to Math.max(_bank_work.state.bankClosedUntil, Math.floor(Time.days) + _bank_work.terms.bankClosureDays)>>
      <<crimeUp _bank_work.terms.crime.entry 'trespassing'>>
      <<set _bank_campaign.bank_step to _bank_work.state.approach is 'quiet' and _bank_work.state.rolls.entry lte _bank_work.chances.entry ? 2 : 1>>
      <<if _bank_campaign.bank_step is 1>>
        <<set _bank_work.state.stage to 'challenge', _bank_work.state.raisedAlarm to true, _bank_campaign.alarm += 1>>
      <<else>><<set _bank_work.state.stage to 'vault'>><</if>>
      <<deadwood-street-heist-bank-incident>><<pass 5>>
    <<case 'answer'>>
      <<if _bank_step isnot 1 or _bank_work.state.talked or $worn.face.type.includes('gag')>><<exit>><</if>>
      <<pass 5>>
      <<if !_bank_work.available or $passage isnot 'Deadwood Street Heist' or _bank_campaign.bank_step isnot _bank_step>><<exit>><</if>>
      <<set _bank_work.state.talked to true>>
      <<if _bank_work.state.rolls.talk lte _bank_work.chances.talk>>
        <<set _bank_campaign.bank_step to 2, _bank_work.state.stage to 'vault'>><<englishskill 5 'no_star'>>
      <<else>><<set _bank_campaign.alarm += 1>><</if>>
    <<case 'fight'>>
      <<if ![1, 3, 6].includes(_bank_step)>><<exit>><</if>>
      <<set _bank_campaign.alarm += 1, _bank_work.state.raisedAlarm to true, _bank_work.state.approach to 'loud'>>
      <<crimeUp _bank_work.terms.crime.violence 'assault'>>
      <<deadwood-street-heist-bank-incident>>
      <<deadwood-heist-fight 'Deadwood Street Bank Fight Result' `_bank_step === 6 ? 3 : 2` `_bank_step === 6 ? 'town' : 'financial_centre'` `_bank_step === 6 ? 1 : 0` `_bank_step === 6 ? 3 : 2`>><<exit>>
    <<case 'figures' 'follow'>>
      <<if _bank_step isnot 2>><<exit>><</if>>
      <<set _bank_chance to _bank_action is 'figures' ? 35 + _bank_work.skills.maths * 0.045 : _bank_work.chances.entry>>
      <<pass 10>>
      <<if !_bank_work.available or $passage isnot 'Deadwood Street Heist' or _bank_campaign.bank_step isnot _bank_step>><<exit>><</if>>
      <<set _bank_campaign.bank_step to 3>>
      <<if _bank_campaign.bank_rolls[0] gt Math.clamp(_bank_chance - _bank_work.conditionPenalty, 5, 95)>>
        <<set _bank_campaign.alarm += 1, _bank_work.state.raisedAlarm to true>><<stress 4>>
      <</if>>
      <<if _bank_action is 'figures'>><<mathsskill 5 'no_star'>><<else>><<skulduggery 2>><</if>>
    <<case 'vault'>>
      <<if _bank_step isnot 3>><<exit>><</if>>
      <<set _bank_chance to 25 + _bank_work.skills.science * 0.025 + _bank_work.skills.skulduggery * 0.025 + (_bank_work.state.preparationChoices.equipment?.quality ?? 0) - _bank_work.conditionPenalty>>
      <<pass 10>>
      <<if !_bank_work.available or $passage isnot 'Deadwood Street Heist' or _bank_campaign.bank_step isnot _bank_step>><<exit>><</if>>
      <<scienceskill 5 'no_star'>>
      <<if _bank_campaign.bank_rolls[1] lte Math.clamp(_bank_chance, 5, 95)>>
        <<set _bank_campaign.bank_step to 4>>
      <<else>>
        <<set _bank_campaign.alarm += 1, _bank_work.state.raisedAlarm to true>>
        <<deadwood-heist-fight 'Deadwood Street Bank Fight Result' 2 'financial_centre' 0 2>><<exit>>
      <</if>>
    <<case 'help' 'press'>>
      <<deadwood-heist-regroup-action _bank_action>><<exit>>
    <<case 'slip' 'divert'>>
      <<if _bank_step isnot 6 or (_bank_action is 'divert' and $worn.face.type.includes('gag'))>><<exit>><</if>>
      <<set _bank_chance to _bank_action is 'slip' ? _bank_work.chances.entry : _bank_work.chances.talk>>
      <<pass 5>>
      <<if !_bank_work.available or $passage isnot 'Deadwood Street Heist' or _bank_campaign.bank_step isnot _bank_step>><<exit>><</if>>
      <<if _bank_campaign.bank_rolls[2] lte Math.clamp(_bank_chance - _bank_campaign.alarm * 4, 5, 95)>>
        <<set _bank_campaign.bank_step to 7>>
        <<if _bank_action is 'slip'>><<skulduggery 2>><<else>><<englishskill 5 'no_star'>><</if>>
      <<else>>
        <<set _bank_campaign.alarm += 1, _bank_work.state.raisedAlarm to true>>
        <<deadwood-heist-fight 'Deadwood Street Bank Fight Result' 3 'town' 1 3>><<exit>>
      <</if>>
    <<case 'wait' 'rush'>>
      <<if _bank_step isnot 7>><<exit>><</if>>
      <<set _bank_minutes to _bank_action is 'wait' ? 15 : 5>>
      <<pass _bank_minutes>>
      <<if !_bank_work.available or $passage isnot 'Deadwood Street Heist' or _bank_campaign.bank_step isnot _bank_step>><<exit>><</if>>
      <<set _bank_campaign.bank_step to 8>>
      <<if _bank_action is 'wait'>>
        <<set _bank_campaign.alarm to Math.max(0, _bank_campaign.alarm - 1)>><<stress -3>>
      <<elseif _bank_campaign.bank_rolls[3] gt Math.clamp(30 + _bank_work.skills.athletics * 0.05 - _bank_work.conditionPenalty, 5, 95)>>
        <<set _bank_campaign.alarm += 1, _bank_work.state.raisedAlarm to true>><<pain 5>><<tiredness 4>>
      <<else>><<athletics 1>><</if>>
  <</switch>>
  <<if _bank_work.available and $passage is 'Deadwood Street Heist'>><<goto 'Deadwood Street Heist'>><</if>>
<</widget>>

<<widget 'deadwood-heist-bank-scene'>>
  <<set _bank_work to maplebirch.get('StreetLife')?.heist, _bank_campaign to _bank_work?.state.campaign>>
  <<if !_bank_campaign>><<exit>><</if>>
  <<if _bank_campaign.fight>>
    <<lanLink ['Continue the confrontation', '继续应对冲突'] 'Deadwood Street Campaign Fight'>><</lanLink>><br><<exit>>
  <</if>>
  <<if !_bank_work.inAction>>
    <<getouticon>><<lanLink ['Review the outcome', '核对结果'] 'Deadwood Street Heist Debrief'>><</lanLink>><br><<exit>>
  <</if>>
  <<set $location to _bank_campaign.bank_step gte 6 ? 'town' : 'financial_centre', $outside to _bank_campaign.bank_step gte 6 ? 1 : 0, $bus to 'high'>>
  <<set _bank_wren_here to !_bank_campaign.team.separated.includes('Wren') or _bank_campaign.team.rejoined.includes('Wren')>>
  <<effects>>
  <<if $passage isnot 'Deadwood Street Heist'>><<exit>><</if>>
  <<if $nextPassage or $nextPassageCheck>>
    <span id='next'><<lanLink ['Next', '继续'] 'Deadwood Street Heist'>><</lanLink>></span><<nexttext>><<exit>>
  <</if>>
  <<if !_bank_work.available>>
    <<lanSwitch 'You cannot go on in this condition. The others look towards the exit.' '你现在的状态无法继续。同伙们看向出口。'>><br><br>
    <<highicon>><<lanLink ['Leave the scene', '离开现场'] 'High Street'>><</lanLink>><br><<exit>>
  <</if>>
  <<switch _bank_campaign.bank_step>>
    <<case 0>>
      <<language>>
        <<option 'EN'>>
          A customer counts notes at the counter. Another argues about a charge. <<if C.npc.Adrian?.init is 1 and C.npc.Adrian.state is 'active' and maplebirch.npc.Schedule.get('Adrian').location is 'financial_centre'>>Adrian looks up from a form as you pass. <<if C.npc.Adrian.love gte 20>>The clerk's brief smile makes you hesitate.<</if>><<else>>A clerk looks up from a form as you pass.<</if>> Wren waits beside the hired pair, watching you rather than the money.<br><br>
          "Last chance to call it an expensive afternoon," <<nnpc_he 'Wren'>> says. "After this, everyone will want an explanation."
        <<option 'CN'>>
          一位顾客正在柜台前数钱，另一位还在争论手续费。<<if C.npc.Adrian?.init is 1 and C.npc.Adrian.state is 'active' and maplebirch.npc.Schedule.get('Adrian').location is 'financial_centre'>>你经过时，阿德里安从表格上抬起头。<<if C.npc.Adrian.love gte 20>>柜员短暂的微笑让你迟疑了一下。<</if>><<else>>你经过时，一名柜员从表格上抬起头。<</if>>伦恩站在两名雇员旁边，看着你，没有看钱。<br><br>
          “现在反悔，还能当作是花钱买了个下午。”<<nnpc_he 'Wren'>>说，“再往后，谁都要问你讨个说法。”
      <</language>><br><br>
      <<lanLink ['Give the agreed signal (0:05)', '按约定示意行动 (0:05)']>><<deadwood-heist-bank-action 'enter'>><</lanLink>><<dangerousText>><br>
      <<if _bank_campaign.dock.steps.includes('loading_route')>>
        <<lanLink ['Use the delivery route found at the warehouse (0:05)', '沿仓库找到的交货路线入内 (0:05)']>><<deadwood-heist-bank-action 'loading'>><</lanLink>> · <<lanSwitch 'The scout can use the earlier delivery records.' '侦察员能用上先前查到的交货记录。'>><br>
      <</if>>
      <<if C.npc.Adrian?.init is 1 and C.npc.Adrian.state is 'active' and maplebirch.npc.Schedule.get('Adrian').location is 'financial_centre' and C.npc.Adrian.love gte 20 and $face isnot 'covered' and !$worn.face.type.includesAny('mask', 'gag')>>
        <<lanLink ['Warn Adrian to move away from the counter (0:05)', '先提醒阿德里安离开柜台 (0:05)']>><<deadwood-heist-bank-action 'warn'>><</lanLink>> · <span class='orange'><<lanSwitch 'The guards will notice.' '保安也会察觉。'>></span><br>
      <</if>>
      <<if !$worn.face.type.includes('gag')>>
        <<lanLink ['Tell the customers to step back (0:05)', '让顾客退后 (0:05)']>><<deadwood-heist-bank-action 'clear'>><</lanLink>> · <span class='orange'><<lanSwitch 'You give up the quiet approach.' '无法再悄悄行动。'>></span><br>
      <</if>>
    <<case 1>>
      <<if ['warned', 'cleared'].includes(_bank_campaign.clerk)>>
        <<language>><<option 'EN'>>The clerk calls the customers back from the queue. One clutches a handful of notes; another leaves a bag by the counter. A guard blocks your way while the clerk gets them behind the inner partition.<<option 'CN'>>柜员让排队的人退后。一个顾客攥紧了手里的钱，另一个连袋子也没顾上拿。柜员领着他们退到内侧的隔断后，一名保安横在你面前。<</language>><br><br>
      <</if>>
      <<language>>
        <<option 'EN'>>
          A guard puts an arm across your path. Behind you, a second leaves the wall. <<if _bank_campaign.clerk is 'loading'>>The delivery door closes behind you. The scout folds away the warehouse receipt.<<else>>Customers begin stepping away from your group.<</if>> Wren keeps the hired pair close.<br><br>
          <<if _bank_work.state.talked>>"I've heard enough. Stay where you are." The guard reaches for your wrist.<<else>>"Where do you think you're going?" You have a moment to answer.<</if>>
        <<option 'CN'>>
          一名保安伸手拦住你的去路。你身后，另一人也离开墙边。<<if _bank_campaign.clerk is 'loading'>>交货处的门在身后关上，侦察员收起了仓库收据。<<else>>顾客开始与你们拉开距离。<</if>>伦恩让两名雇员靠近一些。<br><br>
          <<if _bank_work.state.talked>>“够了，站着别动。”保安伸手抓向你的手腕。<<else>>“往哪儿去？”你还有片刻可以作答。<</if>>
      <</language>><br><br>
      <<if !_bank_work.state.talked and !$worn.face.type.includes('gag')>>
        <<lanLink ['Try to explain (0:05)', '试着解释 (0:05)']>><<deadwood-heist-bank-action 'answer'>><</lanLink>> · <<lanSwitch 'English' '英语'>><br>
      <</if>>
      <<lanLink ['Push past the guards', '反抗拦路的保安']>><<deadwood-heist-bank-action 'fight'>><</lanLink>><<dangerousText>><br>
    <<case 2>>
      <<language>>
        <<option 'EN'>>
          <<if _bank_campaign.clerk is 'loading'>>The scout points to the delivery number on the warehouse receipt. A worker opens the service door and wheels an empty trolley through. You follow it into the corridor, away from the public counter.<<else>>You leave the public counter behind. A worker wheels an empty trolley past, then stops to look at the bags.<</if>> The scout pauses beside a rack of withdrawal slips. <<if _bank_campaign.reception.method.includes('-verified')>>Several sums match the account copy you checked earlier.<<else>>The pages you brought back do not resolve every figure. You still have to judge which entries matter.<</if>><br><br>
          Wren lowers <<nnpc_his 'Wren'>> voice. "Anything useful in those papers? We can't stand here all day."
        <<option 'CN'>>
          <<if _bank_campaign.clerk is 'loading'>>侦察员指给职员看仓库收据上的交货编号。职员打开侧门，将一辆空推车送进走廊。你们跟着推车入内，绕过公共柜台。<<else>>你把公共柜台甩在身后。一名职员推着空车经过，看见袋子，又停下脚步。<</if>>侦察员在放着提取单的架子旁停住。<<if _bank_campaign.reception.method.includes('-verified')>>其中几笔数目，能与先前核对过的账户副本对上。<<else>>带回的那几页文件，还不足以核清所有数目。哪些记录有关，仍得由你来判断。<</if>><br><br>
          伦恩压低声音。“那些纸有用吗？总不能在这里站上一整天。”
      <</language>><br><br>
      <<lanLink ['Compare the records before continuing (0:10)', '对照记录后继续 (0:10)']>><<deadwood-heist-bank-action 'figures'>><</lanLink>> · <<lanSwitch 'Maths' '数学'>><br>
      <<lanLink ['Follow the scout (0:10)', '跟随侦察员 (0:10)']>><<deadwood-heist-bank-action 'follow'>><</lanLink>> · <<lanSwitch 'Skulduggery' '诡术'>><br>
    <<case 3>>
      <<language>>
        <<option 'EN'>>
          The last door is still shut. Beyond the glass partition, two guards have stopped talking. One looks towards the trolley, then at you. Your equipment lies open at your feet.<br><br>
          "This was the part worth practising," Wren murmurs. "Tell me before you make it everybody else's problem."
        <<option 'CN'>>
          最后一道门仍关着。玻璃隔断另一侧，两名保安停止交谈。一人先看了眼推车，又看向你。用品箱已经在你脚边打开。<br><br>
          “这就是该排演的部分了。”伦恩低声说，“真有问题，先开口，别等着所有人一起倒霉。”
      <</language>><br><br>
      <<lanLink ['Use the equipment to try the vault door (0:10)', '用准备的设备试着打开金库门 (0:10)']>><<deadwood-heist-bank-action 'vault'>><</lanLink>> · <<lanSwitch 'Science / Skulduggery' '科学／诡术'>><br>
      <<lanLink ['Face the guards', '迎上保安']>><<deadwood-heist-bank-action 'fight'>><</lanLink>><<dangerousText>><br>
    <<case 4>>
      <<language>>
        <<option 'EN'>>
          The carrier lifts the lid. Gold lies in fitted rows, far heavier than the notes you had imagined. Wren tries one bag, lowers it, and looks at the rest.<br><br>
          "Well. We can carry some of it, or we can find out how much we can carry while someone is chasing us." <<nnpc_He 'Wren'>> waits for your answer. The money from selling it is still a promise.
        <<option 'CN'>>
          搬运员打开箱盖。黄金整齐地嵌在里面，远比你想象中的纸钞沉重。伦恩试着提起一袋，放下，又看向剩余的部分。<br><br>
          “好了。可以先拿走一些，也可以等有人追着我们时，再试试究竟拿得动多少。”<<nnpc_he 'Wren'>>等你回答。至于卖出去的钱，现在还只是一个约定。
      <</language>><br><br>
      <<set _bank_loading_time to _bank_work.state.approach is 'loud' ? ' (0:05)' : ' (0:10)'>>
      <<lanLink `['Take a lighter load' + _bank_loading_time, '只带走较轻的一批' + _bank_loading_time]`>>
        <<if _bank_work.available and _bank_campaign.bank_step is 4>><<set _bank_campaign.bank_step to 5>><<deadwood-street-heist-action 'take-light'>><</if>>
      <</lanLink>><br>
      <<lanLink `['Try to take the full load' + _bank_loading_time, '试着全部带走' + _bank_loading_time]`>>
        <<if _bank_work.available and _bank_campaign.bank_step is 4>><<set _bank_campaign.bank_step to 5>><<deadwood-street-heist-action 'take-full'>><</if>>
      <</lanLink>> · <<lanSwitch 'Physique / crew' '体能／同伙'>><br>
    <<case 5>>
      <<deadwood-heist-regroup-scene>>
    <<case 6>>
      <<language>>
        <<option 'EN'>>
          You reach the street. A shout follows you out, and heads turn along the pavement. Three people in security uniforms close the gap between you and the corner. The others have a few steps' lead.<br><br>
          <<if _bank_campaign.team.injured.some(key => !_bank_campaign.team.aid.includes(key))>>The carrier falters beneath the weight.<<else>>The carrier shifts a bag to the other hand and keeps moving.<</if>> <<if _bank_wren_here>>Wren calls for everyone to follow.<<else>>Wren is still out of sight.<</if>>
        <<option 'CN'>>
          你来到街上，身后又传来一声喊叫。人行道上的路人纷纷转头，三名穿保安制服的人堵住你与拐角之间的空隙。同伙们只比你快了几步。<br><br>
          <<if _bank_campaign.team.injured.some(key => !_bank_campaign.team.aid.includes(key))>>搬运员被重量拖得一个踉跄。<<else>>搬运员把袋子换到另一只手，继续往前。<</if>><<if _bank_wren_here>>伦恩招呼所有人跟上。<<else>>你仍没看见伦恩。<</if>>
      <</language>><br><br>
      <<lanLink ['Try to get through unnoticed (0:05)', '试着混过去 (0:05)']>><<deadwood-heist-bank-action 'slip'>><</lanLink>> · <<lanSwitch 'Skulduggery' '诡术'>><br>
      <<if !$worn.face.type.includes('gag')>>
        <<lanLink ['Try to draw their attention elsewhere (0:05)', '试着把他们的注意引开 (0:05)']>><<deadwood-heist-bank-action 'divert'>><</lanLink>> · <<lanSwitch 'English' '英语'>><br>
      <</if>>
      <<lanLink ['Resist the people blocking you', '反抗堵住你的人']>><<deadwood-heist-bank-action 'fight'>><</lanLink>><<dangerousText>><br>
    <<case 7>>
      <<language>>
        <<option 'EN'>>
          You stop out of sight of the main road, listening to footsteps pass. Your arms ache. The carrier breathes through an open mouth. <<if _bank_wren_here>>Wren keeps glancing at the way out.<</if>><br><br>
          <<if _bank_wren_here>>"I can wait," <<nnpc_he 'Wren'>> whispers. "A little. I don't fancy being found here with you."<<else>>You look back at the empty corner, but Wren does not appear.<</if>> Every scrape from the street makes you hold your breath.
        <<option 'CN'>>
          你停在大路看不见的地方，听着脚步从外面经过。双臂酸痛，搬运员张着嘴喘气。<<if _bank_wren_here>>伦恩不断看向出口。<</if>><br><br>
          <<if _bank_wren_here>>“可以等。”<<nnpc_he 'Wren'>>低声说，“一小会儿。我可不想跟你一起在这里被找到。”<<else>>你回头看向空荡的拐角，伦恩仍没出现。<</if>>街上每响起一点动静，你便屏住呼吸。
      <</language>><br><br>
      <<lanLink ['Stay still until the footsteps recede (0:15)', '等脚步声远去 (0:15)']>><<deadwood-heist-bank-action 'wait'>><</lanLink>><br>
      <<lanLink ['Try to make up the distance now (0:05)', '趁现在拉开距离 (0:05)']>><<deadwood-heist-bank-action 'rush'>><</lanLink>> · <<lanSwitch 'Athletics' '运动'>><br>
    <<case 8>>
      <<language>>
        <<option 'EN'>>
          The bank is behind you. The way back is still ahead. You count the people who have made it this far. <<if _bank_wren_here>>Wren points to the bags. "Get those away from here. Landry can't pay us for what we leave on the pavement."<<else>>The carrier moves a bag towards the exit. There is no answer when you call Wren's name.<</if>>
        <<option 'CN'>>
          银行已经被甩在身后，回去的路却还没走完。你数了数跟到这里的人。<<if _bank_wren_here>>伦恩指向袋子。“先把这些带走。留在人行道上的东西，兰德里可没法给我们算钱。”<<else>>搬运员把袋子往出口挪。你喊了声伦恩，没有听见回答。<</if>>
      <</language>><br><br>
      <<if _bank_work.vehicleReady>>
        <<lanLink ['Leave in the agreed car (0:20)', '乘约定的车离开 (0:20)']>><<deadwood-street-heist-action 'drive'>><</lanLink>><br>
        <<set _bank_model to _bank_work.catalog.models.find(item => item.id === _bank_work.vehicle.model)>>
        <<if _bank_work.vehicle.fuel gte _bank_model.fuel_use * 30>>
          <<lanLink ['Take less gold and drive carefully (0:30)', '少带些黄金谨慎驾车 (0:30)']>><<deadwood-street-heist-action 'drive-careful'>><</lanLink>><br>
        <</if>>
      <</if>>
      <<if !$worn.feet.type.includes('shackle')>>
        <<lanLink ['Try to get clear on foot (0:20)', '试着步行脱身 (0:20)']>><<deadwood-street-heist-action 'run'>><</lanLink>><br>
        <<lanLink ['Take less gold and leave carefully on foot (0:30)', '少带些黄金谨慎步行 (0:30)']>><<deadwood-street-heist-action 'run-careful'>><</lanLink>><br>
      <</if>>
  <</switch>><br>
  <<if _bank_work.state.policePlan>>
    <<policeicon>><<lanLink ['Follow the agreed police handover (0:10)', '执行约定的警方交接 (0:10)']>><<deadwood-street-heist-action 'sting'>><</lanLink>><br>
  <<else>>
    <<policeicon>><<lanLink ['Stop and report to the police', '中止行动并报警']>><<deadwood-street-heist-action 'contact'>><</lanLink>><br>
  <</if>>
  <<refuseicon>><<lanLink ['Leave the haul and withdraw (0:20)', '放下财物并撤回 (0:20)']>><<deadwood-street-heist-action 'withdraw'>><</lanLink>><br>
<</widget>>

:: Deadwood Street Bank Fight Result
<<set _bank_work to maplebirch.get('StreetLife')?.heist, _bank_campaign to _bank_work?.state.campaign, _bank_fight to _bank_campaign?.fight>>
<<if !$nextPassage and !$nextPassageCheck and !$eventforced and !$possessed and !$replayScene and !$statFreeze and !$frozenValues and _bank_fight?.result and _bank_fight.return_passage is 'Deadwood Street Bank Fight Result'>>
  <<set _bank_won to _bank_fight.result is 'won', _bank_campaign.fight to null>>
  <<if _bank_won>>
    <<set _bank_campaign.bank_step to _bank_campaign.bank_step is 1 ? 2 : _bank_campaign.bank_step is 3 ? 4 : 7>>
    <<set _bank_work.state.stage to _bank_campaign.bank_step gte 5 ? 'escape' : 'vault'>>
    <<lanSwitch 'You pull free as the last guard backs away. The others are still within reach.' '最后一名保安退开时，你抽回胳膊。同伙们还没有走远。'>><br><br>
  <<else>>
    <<set _bank_work.state.stage to 'settlement', _bank_work.state.outcome to _bank_work.state.outcome is 'arrested' ? 'arrested' : 'failed', _bank_work.state.loot to 0>>
    <<lanSwitch 'You get away without the bags. There is no chance of going back for them.' '你脱身时没能带走袋子，已经没有回头去拿的机会了。'>><br><br>
  <</if>>
<</if>>
<<if _bank_campaign?.fight and !_bank_campaign.fight.result>>
  <<lanLink ['Continue the confrontation', '继续应对冲突'] 'Deadwood Street Campaign Fight'>><</lanLink>><br>
<<elseif _bank_work?.inAction>>
  <<lanLink ['Catch up with the others', '赶上同伙'] 'Deadwood Street Heist'>><</lanLink>><br>
<<else>>
  <<highicon>><<lanLink ['Return to High Street', '返回商业街'] 'High Street'>><</lanLink>><br>
<</if>>

:: Deadwood Street Gold Division Widgets [widget]

<!-- 黄金估值、实际销金款和个人份额分开，结清按钮仍复用原有一次结算。 -->
<<widget 'deadwood-heist-gold-debrief'>>
  <<set _gold_work to maplebirch.get('StreetLife')?.heist, _gold_campaign to _gold_work?.state.campaign>>
  <<if !_gold_campaign or !_gold_work.atMeeting or !_gold_work.meetingAvailable>><<deadwood-street-heist-meeting-required>><<exit>><</if>>
  <<set $location to 'underground', $outside to 0>><<effects>>
  <<if $passage isnot 'Deadwood Street Heist Debrief' or $nextPassage or $nextPassageCheck or $eventforced>><<exit>><</if>>
  <<if _gold_campaign.aftermath.stage lt 6 or _gold_campaign.gold.trade.stage isnot 5>>
    <<deadwood-heist-aftermath-plan>><<exit>>
  <</if>>
  <<language>>
    <<option 'EN'>>
      <<if _gold_campaign.gold.trade.handed_over>>The buyer's receipt lies beside the list of shares. The bags left dark marks on the table. The amount actually received is written beneath them.<<else>>You cross out the bars that never found a buyer. Only money actually received belongs on the list of shares.<</if>><br><br>
      <<if _gold_campaign.aftermath.landry isnot 'left' and C.npc.Landry.state is 'active'>>Landry checks the total. "That's what came back. Now we divide it."<<else>>Landry's share remains on the sheet. The disagreement has not changed the division you accepted before the job.<</if>>
      <<if _gold_campaign.aftermath.wren isnot 'left' and C.npc.Wren.state is 'active'>><br><br>Wren watches the count. "Good. I was beginning to think we'd be paid in stories."<</if>>
    <<option 'CN'>>
      <<if _gold_campaign.gold.trade.handed_over>>买家的收条压在分成单旁。装金条的袋子在桌面上留下几道污痕，下方写着实际收回的货款。<<else>>你划去了没能找到买家的那批金条。分成单上，只能列入真正收到的钱。<</if>><br><br>
      <<if _gold_campaign.aftermath.landry isnot 'left' and C.npc.Landry.state is 'active'>>兰德里核对总数。“带回来这些，就按这些分。”<<else>>纸上仍留着兰德里的份额。后来的分歧，没有改变你行动前接受的分成。<</if>>
      <<if _gold_campaign.aftermath.wren isnot 'left' and C.npc.Wren.state is 'active'>><br><br>伦恩看着清点。“不错。我都快以为，最后拿来付账的只有故事了。”<</if>>
  <</language>><br><br>
  <<lanSwitch 'Actual proceeds: ' '销金实收总款：'>><<printmoney _gold_campaign.gold.proceeds>><br>
  <<lanSwitch 'Your agreed share: ' '约定个人份额：'>><<print _gold_work.split.pc>>% · <<printmoney _gold_work.payout>><br>
  <<lanSwitch 'Recorded expenses, already paid: ' '已经支付的账面开销：'>><<printmoney _gold_work.state.spent>><br>
  <<lanSwitch 'Bank share less those expenses: ' '银行分账扣除上述开销后：'>><<printmoney `_gold_work.payout - _gold_work.state.spent`>><br><br>
  <<if _gold_work.state.settled>>
    <span class='green'><<lanSwitch 'The shares have been paid.' '份额已经结清。'>></span><br>
  <<elseif _gold_work.available>>
    <<icon 'street/job-payment.png'>><<lanLink ['Collect your agreed share', '领取约定的份额'] 'Deadwood Street Heist Debrief'>><<deadwood-street-heist-settle>><</lanLink>><br>
  <</if>>
  <<if _gold_work.businessCrew.length and maplebirch.get('StreetLife').jobs.available>>
    <<socialiseicon 'ask'>><<lanLink ['Ask the crew about further work', '向同伙打听往后的差事'] 'Deadwood Street Heist Contacts'>><</lanLink>><br>
  <</if>>
<</widget>>

    <<lanSwitch 'The exit is clear. The escort is not finished.' '出口已经让开，护送还没完成。'>><br><br>
  <<else>>
    <<lanSwitch 'The confrontation has ended. The other person had to make a separate agreement.' '冲突已经结束，对方不得不另作约定。'>><br><br>
  <</if>>
  <<if $location is 'docks'>><<lanLink ['Continue from the warehouse', '继续处理仓库这边的事'] `$_rescue_name === 'wren' ? 'Deadwood Street Heist Aftermath Wren' : 'Deadwood Street Heist Aftermath Landry'`>><<endevent>><</lanLink>><br><</if>>
  <<deadwood-heist-aftermath-leave>>
<</widget>>

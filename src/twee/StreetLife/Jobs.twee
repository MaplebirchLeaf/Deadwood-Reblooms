:: Deadwood Street Job Widgets [widget]

<<widget 'deadwood-street-landry-link'>>
  <<deadwood-street-bounty-link 'pub'>>
  <<if maplebirch.get('StreetLife')?.jobs.available>>
    <<socialiseicon 'ask'>><<lanLink ['Ask Landry about work', '向兰德里打听差事'] 'Deadwood Street Jobs'>><<endevent>><</lanLink>><br>
  <</if>>
  <<deadwood-street-bailey-landry-link>>
  <<deadwood-street-heist-invitation>>
<</widget>>

<<widget 'deadwood-street-cargo-link'>>
  <<deadwood-street-story-entry _args[0]>>
  <<deadwood-street-bounty-link _args[0]>>
  <<set _streetJobs to maplebirch.get('StreetLife')?.jobs>>
  <<if _streetJobs?.available and _streetJobs.receiving and _streetJobs.state.active and _streetJobs.state.active.stage isnot 'settlement'>>
    <<set _streetContract to _streetJobs.contract>>
    <<if _args[0] is _streetContract.source or _args[0] is _streetContract.target or (_args[0] is _streetContract.return_to and _streetJobs.state.active.stage is 'return')>>
      <<icon _streetContract.icon>><<lanLink ['Attend to your delivery (0:01)', '处理委托货物 (0:01)'] 'Deadwood Street Cargo'>>
        <<set $StreetLife.jobs.site to _args[0]>><<pass 1>>
      <</lanLink>><br>
    <</if>>
  <</if>>
<</widget>>

<<widget 'deadwood-street-unload'>>
  <<set _streetJobs to maplebirch.get('StreetLife')?.jobs>>
  <<if _streetJobs?.available and _streetJobs.state.active and _streetJobs.state.active.vehicle isnot null and _streetJobs.cargoHere and maplebirch.get('Transport')?.canApproach>>
    <<icon 'industry/dispatch.png'>><<lanLink ['Take the delivery out of your vehicle (0:05)', '从车上卸下委托货物 (0:05)'] $passage>>
      <<if _streetJobs.act('unload')>><<pass 5>><<tiredness 2>><</if>>
    <</lanLink>><br>
  <</if>>
<</widget>>

<<widget 'deadwood-street-job-status'>>
  <<set _streetJobs to maplebirch.get('StreetLife').jobs, _streetJob to _streetJobs.state.active, _streetContract to _streetJobs.contract>>
  <<if _streetJob>>
    <div class='gold bold'><<= lanSwitch(_streetContract.name[0], _streetContract.name[1])>></div>
    <ul class='journal'>
      <li><<= lanSwitch(_streetContract.goods[0], _streetContract.goods[1])>> · <<lanSwitch 'Cargo space: ' '载货容量：'>><span class='teal'><<= _streetContract.cargo>></span></li>
      <<if _streetJob.stage is 'return'>>
        <<set _streetReturn to _streetJobs.terms.sites[_streetContract.return_to].name>>
        <li class='blue'><<lanSwitch 'Take the goods back to: ' '将货物运回：'>><<= lanSwitch(_streetReturn[0], _streetReturn[1])>><<lanSwitch '. Hand them over there to finish returning the shipment.' '。抵达后交还货物，才算完成退货。'>></li>
      <<else>>
        <li><<set _streetFrom to _streetJobs.terms.sites[_streetContract.source].name, _streetTo to _streetJobs.terms.sites[_streetContract.target].name>><<= lanSwitch(_streetFrom[0], _streetFrom[1])>> → <<= lanSwitch(_streetTo[0], _streetTo[1])>></li>
      <</if>>
      <<if _streetJob.crew>>
        <li><<= _streetJob.crew.name>> · <<lanSwitch 'Agreed colleague’s share: ' '合作人约定分成：'>><span class='gold'><<= _streetJob.crew.share>>%</span> · <<lanSwitch 'Quoted total fee: ' '约定总报酬：'>><<printmoney _streetJob.crew.gross>></li>
      <</if>>
      <<if _streetJob.stage is 'settlement'>>
        <li class='green'><<lanSwitch 'Delivered. Return to Landry for payment.' '货物已交付。回丰收街酒馆找兰德里领报酬。'>></li>
        <li><<lanSwitch 'Payment due to you: ' '待领报酬：'>><<printmoney _streetJob.fee>></li>
      <<else>>
        <<if _streetJob.stage isnot 'return'>>
          <li><<lanSwitch 'Agreed fee: ' '约定报酬：'>><<printmoney `_streetJob.crew ? _streetJob.crew.gross - Math.floor(_streetJob.crew.gross * _streetJob.crew.share / 100) : _streetContract.fee`>> · <<lanSwitch 'Deliver by ' '交货期限：'>>
            <<set _streetDate to new DateTime(_streetJob.due)>><<= lanSwitch(getFormattedDate(_streetDate), _streetDate.month + '月' + _streetDate.day + '日')>> <<ampm _streetDate.hour _streetDate.minute>>
          </li>
          <<if _streetJobs.expired>>
            <li class='red'>
              <<if _streetJob.stage is 'pickup'>>
                <<lanSwitch 'The delivery window has closed before you collected the goods. Tell Landry you cannot finish.' '你还没取货，交货期限及宽限时间就已经结束。请向兰德里取消委托。'>>
              <<else>>
                <<lanSwitch 'The delivery window has closed. Return the goods to the sender.' '交货期限及宽限时间都已结束，请把货物退给发货人。'>>
              <</if>>
            </li>
          <<elseif Time.date.timeStamp gt _streetJob.due>>
            <li class='blue'><<lanSwitch 'The delivery is late. The fee will be reduced by a quarter; the buyer allows one further day.' '送货已迟到，报酬将减少四分之一。买家另给一天宽限。'>></li>
          <</if>>
        <</if>>
        <<if _streetJob.stage is 'pickup'>>
          <li><<lanSwitch 'Awaiting collection.' '尚未取货。'>></li>
        <<elseif _streetJobs.lost>>
          <li class='red'><<lanSwitch 'The vehicle carrying the goods is missing. Report the loss to Landry, or recover the vehicle first.' '载货车辆已失踪。可以先找回车辆，或向兰德里报告损失。'>></li>
        <<elseif _streetJob.vehicle isnot null>>
          <li><<lanSwitch 'The goods remain in your vehicle. Bring that vehicle to the destination, or unload at the street where it is parked.' '货物仍在载货车辆里。请把那辆车开到目的地，或在它停放的街道卸货。'>></li>
          <<if maplebirch.get('Transport')>>
            <<set _streetVehicle to _streetJobs.vehicle, _streetModel to maplebirch.get('Transport').catalog.models.find(item => item.id === _streetVehicle.model)>>
            <li><<lanSwitch 'Cargo vehicle: ' '载货车辆：'>><span class='teal'><<= maplebirch.t(_streetModel.name)>></span> · <<= maplebirch.get('Transport').catalog.name(_streetVehicle.point)>></li>
          <</if>>
        <<else>>
          <li><<lanSwitch 'You are carrying the goods.' '你正随身携带货物。'>></li>
        <</if>>
        <<if _streetJob.handled>>
          <li>
            <<switch _streetJob.handled>>
              <<case 'checked'>><<lanSwitch 'The sender checked the shipment against the paperwork.' '发货人已经核对货物与单据。'>>
              <<case 'waited'>><<lanSwitch 'The delay at collection or delivery has been cleared.' '取货或交接时的等待已经结束。'>>
              <<case 'negotiated'>><<lanSwitch 'The buyer agreed to honour the original fee.' '买家已同意按原定报酬结算。'>>
              <<case 'helped'>><<lanSwitch 'Staff helped clear the way to the receiving area.' '工作人员已替你解围，可以继续交接。'>>
              <<case 'avoided'>><<lanSwitch 'You slipped past the person blocking the receiving area.' '你已经绕开收货处纠缠的人。'>>
            <</switch>>
          </li>
        <</if>>
      <</if>>
    </ul>
  <</if>>
<</widget>>


:: Deadwood Street Jobs
<<set $location to 'pub'>><<set $outside to 0>><<effects>><<npc 'Landry'>><<person1>>
<<set _streetJobs to maplebirch.get('StreetLife')?.jobs>>
<<if !_streetJobs>><<lanSwitch 'No work is available.' '暂时没有差事。'>><br><<else>>
  <<if _streetJobs.available and _streetJobs.state.day isnot Math.floor(Time.days)>>
    <<set _streetJobs.state.day to Math.floor(Time.days)>>
    <<set _streetJobs.state.board to _streetJobs.terms.jobs.filter(item => item.requires !== 'bailey').map(item => item.id).shuffle()>>
  <</if>>
  <<language>>
    <<option 'EN'>>
      Talk from the bar carries between the tables. <<if Weather.isSnow>>People stamp the slush from their boots just inside the door.<<elseif Weather.precipitation is 'rain'>>Wet footprints cross the floor from the door to the bar.<<elseif Time.dayState is 'night'>>Each time the door opens, the sound of a passing lorry joins the voices inside.<<else>>A heavy vehicle passes outside, rattling the glasses behind the bar.<</if>><br><br>
      Landry moves a glass away from the edge of the table. "Looking for work? A few people have asked me to find someone. Pick something you can finish. I'll find someone else for the rest."
    <<option 'CN'>>
      吧台那边的谈笑声传到桌间。<<if Weather.isSnow>>进门的人跺跺靴子，把雪泥留在门边。<<elseif Weather.precipitation is 'rain'>>湿脚印从门口一路延伸到吧台。<<elseif Time.dayState is 'night'>>每当门打开，路上货车的声音便混进人声里。<<else>>一辆重型货车从外面驶过，吧台后的杯子跟着轻轻震响。<</if>><br><br>
      兰德里把桌沿的杯子往里挪了挪。“找活干？有几个人托我找人办事。挑你能做完的，剩下的我找别人。”
  <</language>><br><br>
  <<if _streetJobs.state.report and !_streetJobs.state.active>>
    <<set _streetReport to _streetJobs.state.report>>
    <<language>>
      <<option 'EN'>>
        <<if _streetReport.outcome is 'paid'>>
          Landry taps the receipt from your last job. "That's settled. <<if _streetReport.late>>Next time, mind the time.<<else>>Good to know you finish what you start.<</if>>" You have collected <<printmoney _streetReport.fee>>.
        <<elseif _streetReport.outcome is 'lost'>>
          Landry listens without interrupting. "I'll have to tell them." <<He>> folds the note before putting it away. "Find out what happened to your vehicle before you take anything else."
        <<else>>
          Landry puts the job aside. "Better to tell me than leave someone waiting. There's no fee for this one."
        <</if>>
      <<option 'CN'>>
        <<if _streetReport.outcome is 'paid'>>
          兰德里点了点上一份委托的收条。“这笔结清了。<<if _streetReport.late>>下次看着点时间。<<else>>看来，交给你的事能办妥。<</if>>”你已经领到<<printmoney _streetReport.fee>>。
        <<elseif _streetReport.outcome is 'lost'>>
          兰德里没有打断你的话。“我得去跟他们交代。”<<He>>把纸条折起来，收好。“再接货之前，先弄清楚你的车是怎么回事。”
        <<else>>
          兰德里把这份差事搁到一边。“总比让人干等着好。这份就没报酬了。”
        <</if>>
    <</language>>
    <<if _streetReport.outcome is 'paid' and _streetReport.crew>>
      <br><<lanSwitch 'Paid to your colleague ' '已付给合作人 '>><<= _streetReport.crew.name>>：<<printmoney _streetReport.crew.fee>> · <<lanSwitch 'Your payment above is after that share.' '以上领款已经扣除这笔分成。'>>
    <</if>><br><br>
  <</if>>
  <<deadwood-street-job-status>>
  <<deadwood-street-bailey-landry-response>>
  <<if _streetJobs.available>>
    <<if _streetJobs.state.active>>
      <<deadwood-street-cargo-link 'pub'>>
      <<if _streetJobs.state.active.stage is 'settlement'>>
        <<icon 'street/job-payment.png'>><<lanLink ['Hand over the receipt and collect your fee (0:05)', '交回凭据并领取报酬 (0:05)'] 'Deadwood Street Jobs'>>
          <<if _streetJobs.act('pay')>><<pass 5>><</if>>
        <</lanLink>><br>
      <<elseif _streetJobs.state.active.stage is 'pickup' or (_streetJobs.state.active.stage is 'return' and _streetJobs.contract.return_to is 'pub' and _streetJobs.cargoHere) or _streetJobs.lost>>
        <<refuseicon>><<lanLink ['Tell Landry you cannot finish the job (0:05)', '告诉兰德里无法完成委托 (0:05)'] 'Deadwood Street Jobs'>>
          <<if _streetJobs.act('cancel')>><<pass 5>><</if>>
        <</lanLink>><br>
      <</if>>
    <<else>>
      <span class='blue'><<lanSwitch 'The available work changes each day. New contacts and completed jobs can make room for another offer.' '差事每天轮换。结识新联系人或完成委托后，也可能有其它差事可接。'>></span><br><br>
      <<for _streetOffer range _streetJobs.offers>>
        <<capture _streetOffer>>
        <<icon _streetOffer.icon>><<lanLink _streetOffer.name 'Deadwood Street Job Offer'>>
          <<set $StreetLife.jobs.offer to _streetOffer.id>>
        <</lanLink>> · <<printmoney _streetOffer.fee>><<if _streetOffer.illegal>> <span class='red'><<lanSwitch '(illegal goods)' '（非法货物）'>></span><</if>><br>
        <</capture>>
      <</for>>
      <<if !_streetJobs.offers.length>>
        <<lanSwitch 'Landry has no suitable work for you just now. Check again another day.' '兰德里眼下没有适合你的差事，改天可以再来问问。'>><br>
      <</if>>
    <</if>>
  <</if>>
<</if>><br>
<<getouticon>><<lanLink ["Return to Landry's other business", '与兰德里聊别的'] 'Pub Landry'>><<endevent>><<set $phase to 1>><</lanLink>><br>

:: Deadwood Street Job Offer
<<set $location to 'pub'>><<set $outside to 0>><<effects>><<npc 'Landry'>><<person1>>
<<set _streetJobs to maplebirch.get('StreetLife')?.jobs, _streetOffer to _streetJobs?.offers.find(item => item.id === $StreetLife.jobs.offer)>>
<<if _streetOffer>>
  <<set _streetContract to _streetOffer>><<deadwood-street-job-pitch>>
  <<if _streetOffer.illegal>><span class='red'><<lanSwitch 'These are stolen or illicit goods. You can refuse the job or return the shipment; completing a witnessed handover leaves theft evidence.' '货物涉及盗窃或违禁交易。可以拒绝接单或退货。被认出仍继续交货，会留下经手赃物的证据。'>></span><br><br><</if>>
  <<lanSwitch 'Fee: ' '报酬：'>><<printmoney _streetOffer.fee>> · <<lanSwitch 'Delivery deadline: ' '交货时限：'>><span class='teal'><<= _streetOffer.deadline_hours>></span> <<lanSwitch 'hours' '小时'>><br>
  <span class='blue'>
    <<if _streetOffer.grace_hours>>
      <<lanSwitch 'Late deliveries lose a quarter of the fee. After a further 24 hours, return the goods.' '迟到交货扣四分之一报酬，再过 24 小时买家将不收货。'>>
    <<else>>
      <<lanSwitch 'This order has no grace period. After the deadline, return the shipment.' '本订单没有宽限时间，超时后请退回货物。'>>
    <</if>>
    <<set _streetReturn to _streetJobs.terms.sites[_streetOffer.return_to].name>>
    <<lanSwitch ' Return to: ' '退货地点：'>><<= lanSwitch(_streetReturn[0], _streetReturn[1])>><<lanSwitch '. ' '。'>>
    <<lanSwitch ' Bring the receipt to Landry for payment.' '拿签收凭据回兰德里这里结算。'>>
  </span><br><br>
  <<if _streetJobs.available>>
    <<icon _streetOffer.icon>><<lanLink ['Accept the job (0:05)', '接下这份差事 (0:05)'] 'Deadwood Street Jobs'>>
      <<if _streetJobs.act('accept', _streetOffer.id)>><<pass 5>><</if>>
    <</lanLink>><br>
  <</if>>
<<else>><<lanSwitch 'This job is no longer available.' '这份差事已经无法接受。'>><br><</if>>
<<refuseicon>><<lanLink ['Leave it for now', '暂时不接'] 'Deadwood Street Jobs'>><</lanLink>><br>

:: Deadwood Street Cargo
<<set _streetJobs to maplebirch.get('StreetLife')?.jobs>>
<<if !_streetJobs>><<lanLink ['Return to the pub', '返回酒馆'] 'Pub'>><</lanLink>><<exit>><</if>>
<<set _streetSite to _streetJobs.terms.sites[$StreetLife.jobs.site]>>
<<set $location to _streetSite.location, $outside to _streetSite.outside>><<effects>>
<<set _streetJob to _streetJobs.state.active, _streetContract to _streetJobs.contract>>
<<if _streetJob>>
  <<deadwood-street-job-status>>
  <<deadwood-street-job-environment>>
  <<if _streetJob.stage is 'settlement' and $StreetLife.jobs.site is _streetContract.target>><<deadwood-street-job-receipt>><</if>>
  <<if _streetJobs.available and _streetJobs.cargoHere>>
    <<if _streetJob.stage is 'pickup' and $StreetLife.jobs.site is _streetContract.source and !_streetJobs.expired and _streetJobs.receiving>>
      <<if _streetJob.id is 'bailey_cargo'>>
        <<deadwood-street-bailey-seizure>>
      <<else>>
        <<deadwood-street-job-pickup>>
        <<deadwood-street-job-resolution>>
      <</if>>
      <<if !['label', 'seized'].includes(_streetJob.issue) and (_streetContract.id isnot 'recovery' or _streetJob.issue isnot 'queue')>>
        <<icon _streetContract.icon>><<lanLink [_streetContract.id === 'recovery' ? 'Search for the case (0:15)' : 'Collect the goods (0:05)', _streetContract.id === 'recovery' ? '寻找手提箱 (0:15)' : '取走货物 (0:05)'] 'Deadwood Street Cargo'>>
          <<if _streetJobs.act('collect')>><<set _streetMinutes to _streetContract.id is 'recovery' ? 15 : 5>><<pass _streetMinutes>><<tiredness 2>><</if>>
        <</lanLink>><br>
      <</if>>
    <<elseif _streetJob.stage is 'carrying' and $StreetLife.jobs.site is _streetContract.target and !_streetJobs.expired>>
      <<if !_streetJobs.receiving>>
        <span class='blue'><<lanSwitch 'The receiving counter is unavailable. Return during opening hours with any ID required by this venue.' '收货柜台暂不可用。请在接待时间回来，并准备好场所要求的身份证明。'>></span><br>
      <<else>>
        <<deadwood-street-job-handover>>
        <<deadwood-street-job-resolution>>
        <<lanSwitch 'Fee if you complete this handover: ' '按当前条件交货的报酬：'>><<printmoney _streetJobs.fee>><br>
        <<if _streetJob.issue is 'recognised'>>
          <span class='red'><<lanSwitch 'Continuing will leave evidence linking you to the stolen goods.' '继续交易将留下你经手赃物的证据。'>></span><br>
        <</if>>
        <<if _streetJob.issue is 'queue'>>
          <span class='blue'><<lanSwitch 'The receiver cannot take the goods yet. Wait here, or return the shipment.' '收货人暂时无法接货。可以在这里等待，或退回货物。'>></span><br>
        <<elseif _streetJob.issue isnot 'hassle'>>
          <<icon 'street/cargo-handover.png'>><<lanLink ['Complete the handover (0:10)', '完成交接 (0:10)'] 'Deadwood Street Cargo'>>
            <<if _streetJobs.act('deliver')>><<pass 10>><<tiredness _streetContract.cargo>><</if>>
          <</lanLink>><br>
        <</if>>
      <</if>>
      <<icon 'street/cargo-return.png'>><<lanLink ['Decide to return the goods', '决定退回货物'] 'Deadwood Street Cargo'>>
        <<run _streetJobs.act('return')>>
      <</lanLink>><br>
    <</if>>
    <<if ['carrying', 'return'].includes(_streetJob.stage)>>
      <<if _streetJob.vehicle isnot null>>
        <<icon 'industry/dispatch.png'>><<lanLink ['Unload and carry the goods (0:05)', '卸货并随身携带 (0:05)'] 'Deadwood Street Cargo'>>
          <<if _streetJobs.act('unload')>><<pass 5>><<tiredness 2>><</if>>
        <</lanLink>><br>
      <<else>>
        <<for _streetVehicle range _streetJobs.vehicles>>
          <<capture _streetVehicle>>
          <<set _streetModel to maplebirch.get('Transport').catalog.models.find(item => item.id === _streetVehicle.model)>>
          <<icon 'industry/dispatch.png'>><<lanLink ['Load into ' + maplebirch.t(_streetModel.name) + ' (0:05)', '装入' + maplebirch.t(_streetModel.name) + ' (0:05)'] 'Deadwood Street Cargo'>>
            <<if _streetJobs.act('load', _streetVehicle.id)>><<pass 5>><<tiredness 2>><</if>>
          <</lanLink>><br>
          <</capture>>
        <</for>>
      <</if>>
      <<if _streetJobs.expired and _streetJob.stage is 'carrying'>>
        <<icon 'street/cargo-return.png'>><<lanLink ['Decide to return the goods', '决定退回货物'] 'Deadwood Street Cargo'>><<run _streetJobs.act('return')>><</lanLink>><br>
      <</if>>
    <</if>>
  <<elseif _streetJob.vehicle isnot null and !_streetJobs.lost>>
    <span class='blue'><<lanSwitch 'Bring the vehicle carrying this shipment here first. You have not brought the goods with you.' '请先把载货车辆开到这里。货物没有随你一起过来。'>></span><br>
  <</if>>
  <<if _streetJobs.available>>
    <<if $StreetLife.jobs.site is 'pub' and _streetJob.stage is 'settlement'>>
      <<icon 'street/job-payment.png'>><<lanLink ['Collect your fee (0:05)', '领取报酬 (0:05)'] 'Deadwood Street Jobs'>><<if _streetJobs.act('pay')>><<pass 5>><</if>><</lanLink>><br>
    <<elseif $StreetLife.jobs.site is _streetContract.return_to and _streetJob.stage is 'return' and _streetJobs.cargoHere and _streetJobs.receiving>>
      <<icon 'street/cargo-return.png'>><<lanLink ['Hand the goods back (0:05)', '归还这批货物 (0:05)'] 'Deadwood Street Cargo'>><<if _streetJobs.act('cancel')>><<pass 5>><</if>><</lanLink>><br>
    <<elseif $StreetLife.jobs.site is 'pub' and (_streetJob.stage is 'pickup' or _streetJobs.lost)>>
      <<refuseicon>><<lanLink ['Close the job with Landry (0:05)', '向兰德里交代并结束委托 (0:05)'] 'Deadwood Street Jobs'>><<if _streetJobs.act('cancel')>><<pass 5>><</if>><</lanLink>><br>
    <</if>>
  <</if>>
<<else>><<lanSwitch 'There are no goods left to handle.' '没有待处理的货物。'>><br><</if>><br>
<<getouticon>><<lanLink ['Return', '返回'] _streetSite.passage>><<if $StreetLife.jobs.site is 'pub'>><<endevent>><<set $phase to 1>><</if>><</lanLink>><br>

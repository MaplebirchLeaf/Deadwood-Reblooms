:: Deadwood Smuggler Pub Widgets [widget]

/* 菜单与点击共用判定，只有本页的小事才使用这份时长和价格。 */
<<widget 'deadwood-smuggler-pub-check'>>
  <<set _pub to maplebirch.get('StreetLife')?.smugglerPub>>
  <<set $_pubTerms to {
    tea: {minutes:5, cost:200},
    rest: {minutes:15, cost:0},
    board: {minutes:5, cost:0},
    listen: {minutes:10, cost:0},
    work: {minutes:15, cost:0}
  }>>
  <<set _pubTerm to Object.hasOwn($_pubTerms, _args[0]) ? $_pubTerms[_args[0]] : null>>
  <<set _pubCan to _pub?.available and !!_pubTerm and (_pubTerm.cost is 0 or $money gte _pubTerm.cost)>>
  <<if _pubCan>>
    <<switch _args[0]>>
      <<case 'tea'>>
        <<set _pubCan to !$worn.face.type.includes('gag') and (_pub.state.teaDay isnot Math.floor(Time.days) or _pub.state.teaCount lt 3) and !pcAreArmsBound('both')>>
      <<case 'rest'>>
        <<set _pubCan to Time.date.timeStamp gte _pub.state.restAt + 3600>>
      <<case 'listen'>>
        <<set _pubCan to _pub.state.listenDay isnot Math.floor(Time.days)>>
      <<case 'work'>>
        <<set _pubCan to _pub.state.workDay isnot Math.floor(Time.days) and !pcAreArmsBound('both') and $tiredness lt 1800>>
    <</switch>>
  <</if>>
<</widget>>

<<widget 'deadwood-smuggler-pub-action'>>
  <<deadwood-smuggler-pub-check _args[0]>>
  <<if !_pubCan or maplebirch.passage.title isnot 'Deadwood Smuggler Pub' or _args[1] isnot Time.date.timeStamp>><<exit>><</if>>
  <<set $_pubAt to Time.date.timeStamp, _pubDay to Math.floor(Time.days)>>
  /* 先登记限额与茶钱，推进时间中途离场，也不会重复接活或白拿茶。 */
  <<switch _args[0]>>
    <<case 'work'>><<set _pub.state.workDay to _pubDay>>
    <<case 'listen'>><<set _pub.state.listenDay to _pubDay>>
    <<case 'rest'>><<set _pub.state.restAt to $_pubAt>>
    <<case 'tea'>>
      <<if _pub.state.teaDay isnot _pubDay>><<set _pub.state.teaCount to 0>><</if>>
      <<set _pub.state.teaDay to _pubDay, _pub.state.teaCount += 1>>
      <<money `-_pubTerm.cost`>>
  <</switch>>
  <<set $_pubLast to {action:_args[0], at:$_pubAt, outcome:'interrupted'}>>
  <<set _pub.state.last to $_pubLast>>
  <<pass _pubTerm.minutes>>
  /* 重新确认页面、可停留状态和本次记录的引用，强制转场后不结算恢复、工资或技能。 */
  <<if !_pub?.available or maplebirch.passage.title isnot 'Deadwood Smuggler Pub' or _pub.state.last isnot $_pubLast>><<exit>><</if>>
  <<set $_pubLast.outcome to 'done'>>
  <<switch $_pubLast.action>>
    <<case 'tea'>><<deadwood-taste>><<stress -8>><</deadwood-taste>><<tiredness -10>>
    <<case 'rest'>><<stress -12>><<tiredness -30>>
    <<case 'work'>><<money 400>><<housekeeping 1>><<tiredness 2>>
  <</switch>>
<</widget>>

<<widget 'deadwood-smuggler-pub-environment'>>
  <<language>>
    <<option 'EN'>>
      You stand on a wooden platform inside the smugglers' pub. Chairs scrape across the boards and glasses clink. Someone laughs behind a wooden partition. Lanterns hang from thick wooden posts, lighting the bar at the back of the cave. Cups, folded papers and a cloth-covered case occupy the tables nearer the entrance.
    <<option 'CN'>>
      你站在走私者酒馆的木制平台上。椅子拖过木板，酒杯轻轻相碰，木隔墙后有人笑了起来。灯笼挂在粗木柱上，照亮洞穴后方的吧台。靠入口的桌上放着杯子、折好的纸，还有一只盖着布的箱子。
  <</language>><br><br>
  <<language>>
    <<option 'EN'>>
      <<if Weather.isSnow>>
        Wet bootprints cross the first few boards. Someone has left a damp coat near the entrance, well away from the lamps.
      <<elseif Weather.precipitation is 'rain'>>
        Water runs from a customer's sleeve into a saucer. The bartender slides a rag across the counter without looking up.
      <<elseif Time.dayState is 'night'>>
        A group at a table in the middle of the pub is laughing and talking loudly. Near the partitions, other customers lean closer to hear one another.
      <<else>>
        An empty barrel rolls slowly along the boards until a worker stops it with a foot. The bartender is turning washed glasses mouth-down on a towel.
      <</if>>
    <<option 'CN'>>
      <<if Weather.isSnow>>
        湿靴印越过入口的几块木板。有人把潮湿的外套留在那里，离灯笼远远的。
      <<elseif Weather.precipitation is 'rain'>>
        一位客人袖口的水滴进了碟子。酒保没有抬头，只把一块擦布推过柜面。
      <<elseif Time.dayState is 'night'>>
        酒馆中央的一桌客人正在大声谈笑。靠隔墙坐着的人凑近了些，才能听清彼此说的话。
      <<else>>
        一只空酒桶顺着木板缓缓滚动，被干活的人用脚挡住。酒保正把洗好的杯子倒扣在毛巾上。
      <</if>>
  <</language>><br><br>
<</widget>>

<<widget 'deadwood-smuggler-pub-menu'>>
  <<if maplebirch.get('StreetLife')?.smugglerPub.available>>
    <<icon 'smuggler.png'>><<lanLink ['Spend some time in the pub', '在酒馆里待一会儿'] 'Deadwood Smuggler Pub'>><<endevent>><</lanLink>><br>
  <</if>>
<</widget>>

<<widget 'deadwood-smuggler-pub-talk'>>
  <<switch _args[0]>>
    <<case 'bar'>>
      <<language>>
        <<option 'EN'>>
          "Mind the step." The bartender catches your eye as someone passes behind you with a tray. "We replaced that board this morning. Old one was starting to sag." The bartender points to a fresh plank beside the bar. "Barrels do more damage than boots. Let them past when they're bringing stock in." Someone calls for another round, and the bartender reaches for a glass.
        <<option 'CN'>>
          “留神台阶。”有人端着托盘从你身后经过，酒保朝你示意。“今早刚换了一块，原来那块都往下塌了。”酒保指了指吧台边的新木板。“酒桶可比靴子厉害。有人搬货进来的时候，给他们让条路。”有人喊着再来一轮，酒保便伸手拿杯子去了。
      <</language>>
    <<case 'work'>>
      <<language>>
        <<option 'EN'>>
          "Four pounds for clearing the tables. Fifteen minutes, if you keep moving." The bartender sets a cloth beside an empty tray. "Glasses back here. Papers stay where their owners left them. One shift a day; I've got someone else for the rest."
        <<option 'CN'>>
          “收桌四镑。手脚勤快些，十五分钟。”酒保把一块擦布放到空托盘旁。“杯子拿回这里，纸留在主人放下的位置。一天只缺这么一趟，其余活有人接了。”
      <</language>>
    <<case 'customers'>>
      <<language>>
        <<option 'EN'>>
          The bartender follows your glance towards the partitions. "Some come to drink. Some come to talk. Plenty do both." The bartender holds a glass up to the lantern to check for a crack. "An empty seat doesn't mean an invitation. Ask before taking it." A customer raises a hand, and the bartender sets the glass down to take their order.
        <<option 'CN'>>
          酒保顺着你的目光看向隔墙。“有人来喝酒，有人来谈事，不少人两样都做。”酒保把杯子举到灯旁，检查有没有裂口。“有空椅子，不等于邀请你坐。先问一声。”一名客人抬起手，酒保放下杯子，过去问对方要喝什么。
      <</language>>
  <</switch>><br><br>
<</widget>>

:: Deadwood Smuggler Pub
<<set _pub to maplebirch.get('StreetLife')?.smugglerPub>>
<<if $location isnot 'underground' or $smuggler_pub_known isnot 1>>
  <<lanSwitch 'You need to reach the smugglers\' pub before you can spend time there.' '你得先到走私者酒馆，才能在这里喝茶或歇脚。'>><br>
  <<getouticon>><<back `lanSwitch('Return', '返回')`>><<exit>>
<</if>>
<<set $outside to 0>><<unset $bus>><<effects>>
<<if !_pub?.available>>
  <<lanSwitch 'You cannot stop for a drink or a rest just now.' '你眼下无法留下喝茶或歇脚。'>><br>
  <<getouticon>><<lanLink ['Return to the pub', '返回酒馆'] 'Smuggler Pub'>><<endevent>><</lanLink>><<exit>>
<</if>>
<<deadwood-smuggler-pub-environment>>

<<if _pub.state.last and Time.date.timeStamp - _pub.state.last.at lte 3600>>
  <<if _pub.state.last.outcome is 'interrupted'>>
    <span class='blue'><<lanSwitch 'You had to stop before finishing.' '你没能做完刚才的事。'>><<if _pub.state.last.action is 'tea'>> <<lanSwitch 'The tea was paid for when you ordered it.' '点好的茶已经付过钱。'>><</if>></span><br><br>
  <<else>>
    <<switch _pub.state.last.action>>
      <<case 'tea'>>
        <<language>>
          <<option 'EN'>>
            <<if maplebirch.get('MoreTransformations')?.Undead.active>>
              The mug is warm against your palms. Sugar dissolves beneath your spoon, but the tea remains tasteless. You finish it slowly, resting your legs beneath the table.
            <<else>>
              The mug is thick enough to warm both hands. The tea has been steeped rather strongly, but the bartender brings the sugar over when you ask. You finish it slowly while someone clears a space for the next tray. <span class='green'>You feel a little less tense.</span><</if>>
          <<option 'CN'>>
            <<if maplebirch.get('MoreTransformations')?.Undead.active>>
              杯子捧着很暖。糖粒在勺下化开，茶水却依旧没有滋味。你在桌下放松双腿，慢慢把它喝完。
            <<else>>
              杯子很厚，捧着正好暖手。茶泡得有些浓，你开口要糖，酒保便把糖罐拿了过来。你慢慢喝完，旁边有人给下一只托盘腾出位置。<span class='green'>你稍微放松了一些。</span><</if>>
        <</language>><br><br>
      <<case 'rest'>>
        <<language>>
          <<option 'EN'>>
            You find a bench against one of the wooden walls. The seat is worn smooth. You choose a dry spot away from the damp stone, and nobody interrupts your rest. After a quarter of an hour, you rise and stretch your legs. <span class='green'>You feel less tense and tired.</span>
          <<option 'CN'>>
            你在木隔墙边找到一条长凳，凳面已经被坐得光滑。你挑了个干燥的位置坐下，避开潮湿的岩壁，也没人来打扰。一刻钟后，你起身伸了伸腿。<span class='green'>你放松了些，也没那么累了。</span>
        <</language>><br><br>
      <<case 'board'>>
        <<language>>
          <<option 'EN'>>
            The pinned scraps concern the pub itself: a board that needs replacing, a missing tray, a request to return borrowed mugs. An old barrel-moving notice has been crossed out. Today's small job is still written clearly: <span class='gold'>clearing the tables, £4</span>. The bartender can offer you one shift, if you have not already taken it.
          <<option 'CN'>>
            钉着的纸条写的都是酒馆自己的事：一块待换的木板、一只不见的托盘，还有请人把借走的杯子送回来。旧的搬桶告示已经划掉。今天的小活仍写得清楚：<span class='gold'>收桌，四镑</span>。如果你还没接过，酒保可以让你干一趟。
        <</language>><br><br>
      <<case 'listen'>>
        <<language>>
          <<option 'EN'>>
            You stay at your own table and let the talk drift over.
            <<if maplebirch.get('StreetLife').heist.state.stage is 'prep'>>
              Two customers argue over how much a delivery should have paid. They give different amounts, then each accuses the other of mishearing. Neither names the sender. You listen a while longer, but hear nothing that helps with your own preparations.
            <<elseif maplebirch.get('StreetLife').reputation gte 50>>
              You hear a familiar delivery mentioned, and then a different name attached to it. A customer notices you listening and drops the subject. The next round brings an argument about whose turn it is to pay.
            <<else>>
              Most of it is ordinary complaining: a late delivery, a lost game, a coat that never dried properly. One customer tries to turn a spilled drink into an impressive story. The others have heard it before.
            <</if>>
          <<option 'CN'>>
            你留在自己的桌边，听着零散的话声飘过来。
            <<if maplebirch.get('StreetLife').heist.state.stage is 'prep'>>
              两名客人为一趟送货的报酬争论起来。两人报出的数目不同，都说是对方听错了，却谁也没提发货人是谁。你又听了一会儿，没听到能帮上自己筹备的消息。
            <<elseif maplebirch.get('StreetLife').reputation gte 50>>
              一桩熟悉的送货差事被提了起来，接着却安上了另一个名字。有人发现你在听，便把话题岔开。下一轮酒送来时，他们又开始争该轮到谁付钱。
            <<else>>
              大多只是日常抱怨：送迟的货、输掉的牌局，还有总也晾不干的外套。一位客人试图把打翻酒杯的事讲得惊心动魄，其余人已经听过了。
            <</if>>
        <</language>><br><br>
      <<case 'work'>>
        <<language>>
          <<option 'EN'>>
            You collect the empty glasses, wipe the sticky rings from the tables and leave every folded note where it was. A customer lifts a drink out of your way; another forgets until you ask. At the counter, the bartender checks the tray and counts <span class='gold'>£4</span> into your hand. "That'll do for today."
          <<option 'CN'>>
            你收起空杯，擦掉桌上黏手的杯印，把每张折好的纸留在原处。有客人主动把酒拿开，也有人等你开口才腾地方。到了柜台，酒保检查过托盘，把<span class='gold'>四镑</span>数到你手里。“今天就这些了。”
        <</language>><br><br>
    <</switch>>
  <</if>>
<</if>>

<<set _pubOfferedAt to Time.date.timeStamp>>
<<for _pubOffer range [
  {id:'tea', name:['Buy a mug of tea', '买一杯热茶'], icon:'orchard/tea-tray.png'},
  {id:'rest', name:['Rest on the bench', '在长凳上歇脚'], icon:'actions/relax.png'},
  {id:'board', name:['Read the pinned notices', '查看钉着的告示'], icon:'street/case-board.png'},
  {id:'listen', name:['Listen to the room', '听听周围的闲谈'], icon:'socialise.png'},
  {id:'work', name:['Help clear the tables', '帮忙收拾桌子'], icon:'sponge.png'}
]>>
  <<capture _pub _pubOffer _pubOfferedAt>>
    <<deadwood-smuggler-pub-check _pubOffer.id>>
    <<icon _pubOffer.icon>>
    <<if _pubCan>>
      <<lanLink _pubOffer.name 'Deadwood Smuggler Pub'>><<deadwood-smuggler-pub-action _pubOffer.id _pubOfferedAt>><</lanLink>>
    <<else>>
      <span class='grey'><<= lanSwitch(_pubOffer.name[0], _pubOffer.name[1])>></span>
    <</if>>
    (0:<<= String(_pubTerm.minutes).padStart(2, '0')>>)
    <<if _pubTerm.cost gt 0>> · <<printmoney _pubTerm.cost>><</if>>
    <<if _pubOffer.id is 'work'>> · <<lanSwitch 'Pays ' '工钱 '>><<printmoney 400>><</if>>
    <<if _pubOffer.id is 'tea'>> · <<lanSwitch 'up to three mugs a day' '每天至多三杯'>>
    <<elseif _pubOffer.id is 'rest'>> · <<lanSwitch 'once an hour' '每小时一次'>>
    <<elseif ['listen', 'work'].includes(_pubOffer.id)>> · <<lanSwitch 'once a day' '每天一次'>><</if>><br>
  <</capture>>
<</for>><br>
<<if $worn.face.type.includes('gag')>>
  <span class='blue'><<lanSwitch 'You cannot drink tea or speak to the bartender while gagged.' '口塞妨碍了喝茶和与酒保交谈。'>></span><br>
<</if>>
<<if $tiredness gte 1800>>
  <span class='blue'><<lanSwitch 'You are too tired to take the table-clearing shift.' '你太累了，暂时无法接下收桌的活。'>></span><br>
<</if>><br>

<div id='deadwood-smuggler-pub-talk'></div>
<<if !$worn.face.type.includes('gag')>>
  <<for _pubTopic range [
    {id:'bar', name:['Ask about the wooden platforms', '问问这里的木平台']},
    {id:'work', name:['Ask what work needs doing', '问问有什么小活']},
    {id:'customers', name:['Ask about the regulars', '问问常来的客人']}
  ]>>
    <<capture _pubTopic>>
      <<socialiseicon 'ask'>><<lanLink _pubTopic.name>>
        <<if maplebirch.get('StreetLife')?.smugglerPub.available and !$worn.face.type.includes('gag')>>
          <<replace '#deadwood-smuggler-pub-talk'>><<deadwood-smuggler-pub-talk _pubTopic.id>><</replace>>
        <</if>>
      <</lanLink>><br>
    <</capture>>
  <</for>>
<</if>><br>
<<language>>
  <<option 'EN'>>
    At two small tables beyond the partition, a regular deals blackjack and a few customers play hold'em. Coins and notes sit beside the cards; they count each bet aloud before moving it into the middle.
  <<option 'CN'>>
    隔墙后的两张小桌边，一位熟客坐庄玩二十一点，几名客人围着另一桌打德州扑克。硬币和钞票就放在纸牌旁。每次下注，他们都先报清金额，再把钱推到桌子中间。
<</language>><br><br>
<<if _pub.gamblingAvailable>>
  <<icon 'casino/blackjack.png'>><<lanLink ['Join the cash blackjack table', '加入现金二十一点牌桌'] 'Deadwood Smuggler Pub Blackjack'>>
    <<run _pub.cards.enter('blackjack')>>
  <</lanLink>><br>
  <<icon 'casino/holdem.png'>><<lanLink ["Join the cash hold'em table", '加入现金德州扑克牌桌'] 'Deadwood Smuggler Pub Holdem'>>
    <<run _pub.cards.enter('holdem')>>
  <</lanLink>><br>
<<else>>
  <span class='grey'><<lanSwitch 'You cannot join the card tables while your arms are bound or you are too stressed to play.' '手臂受束缚或压力过高时，你无法加入牌桌。'>></span><br>
<</if>><br>
<<getouticon>><<lanLink ['Return to the pub', '返回酒馆'] 'Smuggler Pub'>><<endevent>><</lanLink>><br>

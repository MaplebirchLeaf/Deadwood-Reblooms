:: Deadwood Alex Break Widgets [widget]

<!-- 入口和点击回调共用本人在场检查。_alexFree 跨 widget 使用，不改为宏内变量。 -->
<<widget 'deadwood-alex-available'>><<silently>>
  <<farm_work_update>>
  <<set _alexFree to !!maplebirch.get('Orchard') and C.npc.Alex?.init is 1 and C.npc.Alex.state is 'active' and $farm_stage gte 7
    and ['alex_farm', 'alex_cottage'].includes($location) and ['admin', 'relax'].includes($farm_work.alex)
    and Time.hour gte 6 and Time.hour lt 21 and !$statFreeze and !$replayScene and !$frozenValues and $combat isnot 1
    and !$worn.face.type.includes('gag') and !$possessed and !$eventforced and !$nextPassage and !$nextPassageCheck and $exposed lte 0 and $stress lt $stressmax and !pcAreArmsBound('both')
    and !maplebirch.get('Orchard').farmInterrupted and !isPregnancyEnding() and !npcPregnancyEnding('Alex')
    and !(playerIsPregnant() and playerBellyVisible() and !talkedAboutPregnancy('pc', 'Alex'))
    and !(npcIsPregnant('Alex') and npcBellySize('Alex') gte 1 and !talkedAboutPregnancy('Alex', 'pc'))>>
<</silently>><</widget>>

<<widget 'deadwood-alex-break-link'>>
  <<set $_alexMenu to $passage is 'Farm Cottage'
    ? document.querySelector('#passage-content .macro-link[data-passage="Farm Bedroom"]')
    : document.querySelector('#passage-content .macro-link[data-passage="Farm Rest"]')
      and document.querySelector('#passage-content .macro-link[data-passage="Farm Work"]')>>
  <<if !$_alexMenu>><<exit>><</if>>
  <<deadwood-alex-available>>
  <<if _alexFree and ($Orchard.alex_talk_day isnot Time.days or canGiftFood('Alex'))>>
    <<if $farm_work.alex is 'relax'>><<farmicon 'relax'>><<else>><<icon 'orchard/alex-cottage-chat.png'>><</if>><<lanLink ['Spend some time with Alex', '陪艾利克斯待一会儿'] 'Deadwood Alex Break'>><</lanLink>><br>
  <</if>>
  <<if $passage is 'Farm Rest' and _alexFree>>
    <<deadwood-alex-ride-link>>
  <</if>>
<</widget>>

<<widget 'deadwood-alex-ride-link'>>
  <<if $farm_work.alex is 'relax' and $farm_work.alex_relax lt 3 and C.npc.Alex.love gte 60 and $phase isnot 5
    and Weather.precipitation isnot 'rain' and !$daily.alexMeadowDate>>
    <<lanSwitch 'Alex looks across the yard. "Want to go for a walk?"' '艾利克斯望向院子。“要不要出去走走？”'>><br><br>
    <<animalicon 'horse'>><<lanLink ['Go for a walk with Alex (0:20)', '和艾利克斯出去走走 (0:20)'] 'Farm Meadow Date'>>
      <<deadwood-alex-available>>
      <<if _alexFree and $farm_work.alex is 'relax' and $farm_work.alex_relax lt 3 and C.npc.Alex.love gte 60 and $phase isnot 5
        and Weather.precipitation isnot 'rain' and !$daily.alexMeadowDate>>
        <!-- 原版骑行结尾推进二十分钟，邀请不再重复耗时或重复结算休息奖励。 -->
        <<set $daily.alexMeadowDate to true>><<npcincr Alex love 1>><<npc Alex>><<person1>>
      <<elseif !$nextPassage>>
        <<set $nextPassage to $nextPassageCheck || 'Farm Work'>>
      <</if>>
    <</lanLink>><<glove 'Alex'>><br>
  <</if>>
<</widget>>

<<widget 'deadwood-alex-gift-response'>>
  <<if maplebirch.get('Orchard') and $farm_stage gte 7 and $daily.giftedFood.Alex is $gift>>
    <br><br>
    <<language>>
      <<option 'EN'>>
        <<if $farm_work.alex is 'relax'>>
          Alex rubs the back of <<his>> neck. "Good timing. Nearly spent the whole break flat on my back." <<He>> stretches, looking a little more inclined to get up.
        <<elseif $farm_work.alex is 'admin'>>
          "Nearly forgot to stop for food," Alex admits. "Easy enough to remember when it's the pigs squealing at you." <<He>> laughs.
        <<else>>
          Alex looks out towards the yard. "That'll keep me going. Something out there always needs feeding, too."
        <</if>>
        <<if isLoveInterest('Alex')>>
          "You can stay, you know." <<He>> nudges a chair towards you with <<his>> boot. <<if C.npc.Alex.dom lte -10>>"I'd like that."<<else>>"Haven't had a chance to ask what you've been up to."<</if>>
        <<elseif isPossibleLoveInterest('Alex')>>
          "Thanks, partner. Don't go hungry looking after me."
        <<else>>
          "Thanks for thinking of me."
        <</if>>
      <<option 'CN'>>
        <<if $farm_work.alex is 'relax'>>
          艾利克斯揉了揉后颈。“来得正好。差点就这么躺到该干活了。”<<He>>伸了个懒腰，看着比刚才愿意动弹一些了。
        <<elseif $farm_work.alex is 'admin'>>
          “差点忘了该吃东西了。”艾利克斯承认。“喂猪倒是忘不了，它们会叫唤。”<<He>>笑了。
        <<else>>
          艾利克斯望向院子。“吃了才有力气干活。外头那些也总等着喂呢。”
        <</if>>
        <<if isLoveInterest('Alex')>>
          “你也可以留下啊。”<<He>>用靴子将一张椅子推向你。<<if C.npc.Alex.dom lte -10>>“我挺想让你陪着的。”<<else>>“还没来得及问你，最近都忙些什么呢。”<</if>>
        <<elseif isPossibleLoveInterest('Alex')>>
          “谢了，搭档。别光顾着我，饿着自己。”
        <<else>>
          “谢谢你还想着我。”
        <</if>>
    <</language>>
  <</if>>
<</widget>>

:: Deadwood Alex Break
<<effects>><<deadwood-alex-available>>
<<if _alexFree>>
  <<npc Alex>><<person1>>
  <<set $outside to $farm_work.alex is 'relax' ? 1 : 0>>
  <<set $location to $outside ? 'alex_farm' : 'alex_cottage'>>
  <<language>>
    <<option 'EN'>>
      <<if $farm_work.alex is 'relax'>>
        Alex pushes <<his>> hat back when you approach. <<if C.npc.Alex.love lte -10>>"Something wrong?" <<he>> asks, staying where <<he>> is.<<else>>"Room here," <<he>> says, shifting against the trunk.<</if>> <<if Weather.precipitation is 'rain'>>The ground beyond the branches is dark with rain.<<else>>A hen scratches through the grass on the other side of the yard.<</if>>
      <<else>>
        You call through the open bedroom door. Alex looks up from <<his>> desk, then follows you downstairs. <<if C.npc.Alex.love lte -10>>"What is it?" <<he>> asks, pulling out a chair.<<else>>"Could use a break. You'd think all that writing would be easier on the hands than farm work." <<He>> flexes <<his>> fingers on the way to the table.<</if>>
      <</if>>
    <<option 'CN'>>
      <<if $farm_work.alex is 'relax'>>
        你走近时，艾利克斯抬起帽檐。<<if C.npc.Alex.love lte -10>>“有什么事吗？”<<he>>问，没有挪动。<<else>>“这里有地方。”<<He>>靠着树干挪了挪。<</if>><<if Weather.precipitation is 'rain'>>枝叶外的泥地被雨水浸成了深色。<<else>>院子另一头，一只母鸡正在草丛里刨食。<</if>>
      <<else>>
        你在敞开的卧室门口叫了一声。艾利克斯从书桌前抬起头，跟着你下楼。<<if C.npc.Alex.love lte -10>>“什么事？”<<he>>拉开椅子问。<<else>>“正好歇歇。写几个字，手倒不比干农活轻松。”走向餐桌时，<<he>>活动着手指。<</if>>
      <</if>>
  <</language>><br><br>
  <div id='deadwood-alex-break'>
    <<if canGiftFood('Alex')>>
      <<lanSwitch 'You have brought something to eat. What would you like to offer?' '你带了些吃的，想给艾利克斯尝尝什么？'>><br><br>
      <<set _food_gift_found to false>><<food_gift_list>>
      <<skinicon 'give'>><<lanLink ['Go upstairs with Alex and offer the food (0:05)', '和艾利克斯上楼，送上食物 (0:05)'] 'Alex Gifts'>>
        <<deadwood-alex-available>>
        <<if _alexFree and canGiftFood('Alex') and setup.foodstuff[$gift]?.category is 'dish' and ($foodstuff[$gift]?.amount ?? 0) gt 0>>
          <<pass 5>><<deadwood-alex-available>>
          <<if _alexFree and $passage is 'Deadwood Alex Break' and canGiftFood('Alex')
            and setup.foodstuff[$gift]?.category is 'dish' and ($foodstuff[$gift]?.amount ?? 0) gt 0>>
            <!-- 消耗和日限由原版宏记账，喜好、好感与成就由原版 Alex Gifts 结算一次。 -->
            <<give_gift 'Alex'>><<set $outside to 0, $location to 'alex_cottage'>><<endevent>><<set $phase to 1>>
          <<elseif !$nextPassage>>
            <<set $nextPassage to $nextPassageCheck || 'Farm Cottage'>>
          <</if>>
        <<elseif !$nextPassage>>
          <<set $nextPassage to $nextPassageCheck || 'Farm Cottage'>>
        <</if>>
      <</lanLink>><br><br>
    <</if>>
    <<if $Orchard.alex_talk_day isnot Time.days>>
      <<if $outside>><<farmicon 'relax'>><<else>><<icon 'orchard/alex-cottage-chat.png'>><</if>><<lanLink ['Keep Alex company (0:15)', '陪艾利克斯坐一会儿 (0:15)']>>
        <<deadwood-alex-available>>
        <<if _alexFree and $Orchard.alex_talk_day isnot Time.days>>
          <<set $Orchard.alex_talk_day to Time.days>><<pass 15>><<deadwood-alex-available>>
          <<if !$nextPassage and $nextPassageCheck>><<set $nextPassage to $nextPassageCheck>><</if>>
          <<replace '#deadwood-alex-break'>>
            <<if _alexFree>>
              <<npcincr Alex love 1>><<stress -2>>
              <<language>>
                <<option 'EN'>>
                  You sit with Alex while <<he>> works a stiff shoulder.
                  <<if C.npc.Alex.love lte -10>>
                    You ask about the farm. "Still plenty to do." <<He>> answers your questions, but offers little more.
                  <<elseif $farm.build is 'irrigation'>>
                    The scrape of a spade carries from the fields. Alex nods towards the sound. "Once that channel's finished, we can leave the buckets alone a bit more." <<He>> stretches <<his>> legs. "Not going to miss carrying those."
                  <<elseif $farm.build>>
                    You ask how the building work is going. "They've got everything they need," Alex says, settling back beside you. "We can leave them to it for a bit." <<He>> rubs the last of the stiffness from <<his>> shoulder.
                  <<elseif $farm.irrigation gte 9>>
                    "Funny what you get used to." Alex flexes <<his>> fingers. "Still keep thinking I've forgotten the watering." <<He>> laughs. "Should've had those channels dug years ago."
                  <<elseif $farm_stage lt 12>>
                    "Another field getting cleared, another reason to get out of bed." <<He>> laughs. "Sometimes I think the weeds grow back behind us."
                  <<else>>
                    "Takes a while to get used to seeing all the fields again." <<He>> smiles. "Worth the work, though."
                  <</if>>
                  <br><br>
                  <<if isLoveInterest('Alex')>>
                    <<if $outside>>Alex shifts closer against the trunk.<<else>>Alex moves <<his>> chair closer until your knees touch.<</if>> "Glad you stayed." <<if C.npc.Alex.dom lte -10>><<He>> rests <<his>> hand on yours and looks down with a smile.<<else>><<He>> takes your hand and grins. "Better than sitting here on my own."<</if>>
                  <<elseif C.npc.Alex.love gt -10>>
                    Alex asks what you have been doing in town, listening until you have finished before telling you what the animals have been up to. "At least you've had less mud to deal with. I hope."
                  <</if>>
                <<option 'CN'>>
                  你在艾利克斯身边坐下，<<he>>揉着发僵的肩膀。
                  <<if C.npc.Alex.love lte -10>>
                    你问起农场的事。“还有不少活。”<<He>>有问有答，却没再多说什么。
                  <<elseif $farm.build is 'irrigation'>>
                    田地里传来铲子刮过地面的声音。艾利克斯朝那边点点头。“等这段水渠挖好，水桶就能少提几趟了。”<<He>>伸了伸腿。“提水这活，少干点才好。”
                  <<elseif $farm.build>>
                    你问起工程做得怎么样。“该备的都备好了。”艾利克斯靠回你身旁。“让他们忙去吧，咱们歇一会儿。”<<He>>揉了揉肩膀，终于舒展开来。
                  <<elseif $farm.irrigation gte 9>>
                    “人还真是容易习惯。”艾利克斯活动着手指。“老觉得忘了浇水。”<<He>>笑了。“早几年就该把这些水渠挖好。”
                  <<elseif $farm_stage lt 12>>
                    “又有一块田等着清，又多一个起床的理由。”<<He>>笑了。“有时候都觉得，咱们前脚走，杂草后脚就长回来了。”
                  <<else>>
                    “这么多田都清出来了，反倒还没看惯。”<<He>>笑了笑。“不过，这些力气花得值。”
                  <</if>>
                  <br><br>
                  <<if isLoveInterest('Alex')>>
                    <<if $outside>>艾利克斯靠着树干，往你身旁挪了挪。<<else>>艾利克斯把椅子挪近，膝盖碰着你的。<</if>>“幸好你没急着走。”<<if C.npc.Alex.dom lte -10>><<He>>把手搭在你的手上，低头笑了笑。<<else>><<He>>握住你的手，咧嘴一笑。“比一个人坐着强多了。”<</if>>
                  <<elseif C.npc.Alex.love gt -10>>
                    艾利克斯问起你在镇上的事，等你说完，才讲起农场的牲口又闹了些什么。“至少，你那儿的泥巴没这么多吧。希望没有。”
                  <</if>>
              <</language>><<glove 'Alex'>><<lstress>>
            <<else>>
              <<lanSwitch 'Alex has to get back to work. You leave the rest for another time.' '艾利克斯得回去忙了。剩下的话，留到下次再聊。'>>
            <</if>>
          <</replace>>
        <</if>>
      <</lanLink>><<glove 'Alex'>><<lstress>><br>
    <</if>>
  </div>
<<else>>
  <<lanSwitch 'Alex cannot stop to spend time with you right now.' '艾利克斯现在没空陪你。'>>
<</if>>
<br><br><<getouticon>><<lanLink ['Return', '返回'] `$outside ? 'Farm Work' : 'Farm Cottage'`>>
  <<if $nextPassageCheck>>
    <<set $nextPassage to $nextPassageCheck>>
  <<elseif !$eventforced>>
    <<endevent>>
  <</if>>
<</lanLink>><br>

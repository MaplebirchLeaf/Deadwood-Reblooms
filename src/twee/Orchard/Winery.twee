:: Deadwood Orchard Winery Widgets [widget]

<<widget 'deadwood-orchard-wine-shop-entry'>>
  <<if maplebirch.get('Orchard')?.winery.available and maplebirch.get('Orchard').winery.state.installed and maplebirch.get('Orchard').canSupplyRobin and C.npc.Robin.trauma lt 80 and !$nextPassage and !$nextPassageCheck>>
    <br><<icon 'orchard/contract.png'>><<lanLink ['Discuss bottled orchard wine', '商量瓶装果酒供货'] 'Deadwood Orchard Robin Wine'>><</lanLink>><br>
  <</if>>
<</widget>>

<<widget 'deadwood-orchard-winery-automation-status'>>
  <<set _wineLineModule to maplebirch.get('Orchard')?.winery>>
  <<if !_wineLineModule?.state.automation.installed>><<exit>><</if>>
  <<set _wineLine to _wineLineModule.state.automation>>
  <<if _wineLine.ready_at gt Time.date.timeStamp>>
    <span class='blue'><<lanSwitch 'The bottling equipment is being fitted.' '封瓶设备正在安装。'>></span><br>
  <<elseif _wineLine.report.day gte 0>>
    <<set $_wineShift to _wineLine.report>>
    <<lanSwitch 'Last shift: ' '最近一班：'>><<lanSwitch 'bottled ' '装瓶'>><span class='teal'><<= $_wineShift.bottled>></span><<lanSwitch ', started ' '瓶，投料'>><span class='teal'><<= $_wineShift.started>></span><<lanSwitch ' batches, delivered ' '桶，配送'>><span class='teal'><<= $_wineShift.supplied>></span><<lanSwitch ' bottles.' '瓶。'>><br>
    <<for _wineStage range [['bottling', ['Bottling', '装瓶']], ['brewing', ['Fermentation', '投料']], ['delivery', ['Delivery', '配送']]]>>
      <<set $_wineReason to _wineLineModule.terms.automationStatus[$_wineShift[_wineStage[0]]]>>
      <<lanSwitch _wineStage[1][0] _wineStage[1][1]>><<lanSwitch ': ' '：'>><span @class="['bottled', 'started', 'delivered'].includes($_wineShift[_wineStage[0]]) ? 'green' : 'blue'"><<lanSwitch $_wineReason[0] $_wineReason[1]>></span><br>
    <</for>>
  <<else>>
    <span class='blue'><<lanSwitch 'Leave instructions at the winery. The equipment starts at 09:00; changing the instructions after that time waits until the next day.' '可在酿酒间安排要做的事。设备每天09:00开工，过了这个时间再改安排，就从明天开始。'>></span><br>
  <</if>>
<</widget>>

<<widget 'deadwood-orchard-winery-automation'>>
  <<set _wineLineModule to maplebirch.get('Orchard').winery>><<set _wineLine to _wineLineModule.state.automation>>
  <br><span class='gold'><<lanSwitch 'Bottling equipment and regular deliveries' '封瓶设备与定期配送'>></span><br>
  <<if !_wineLine.installed>>
    <<lanSwitch 'A small powered press and bottling bench would spare you the repeated filling and sealing. Leave a recipe by the vessels, and the next batch can follow when a barrel is free.' '添一台电动压榨机和封瓶台，就不用每批都守着灌酒、封口。在酒桶旁留好配方，腾出桶后，下一批也能照着做。'>><br><br>
    <<lanSwitch 'Equipment: ' '设备费用：'>><span class='gold'><<printmoney _wineLineModule.terms.automationCost>></span><br>
    <<if !_wineLineModule.skilled>>
      <span class='blue'><<lanSwitch 'Earn Cellar Hand by bottling 80 bottles and either selling 80 wholesale or supplying 24 to Robin\'s drinks shop.' '取得“酿酒熟手”需要累计装瓶80瓶，并完成80瓶批发或24瓶罗宾饮品店供货。'>></span><br>
    <<elseif _wineLineModule.canOperate and (maplebirch.get('Finance')?.canPay(_wineLineModule.terms.automationCost, 'orchard') ?? $money gte _wineLineModule.terms.automationCost)>>
      <<icon 'orchard/bottling-line.png'>><<lanLink ['Fit the press and bottling bench (1:00)', '安装压榨与封瓶设备 (1:00)']>>
        <<set _wineLineModule to maplebirch.get('Orchard').winery>><<set _wineLine to _wineLineModule.state.automation>>
        <<if _wineLineModule.canOperate and _wineLineModule.skilled and !_wineLine.installed
          and (maplebirch.get('Finance')?.canPay(_wineLineModule.terms.automationCost, 'orchard') ?? $money gte _wineLineModule.terms.automationCost)>>
          <<money `-_wineLineModule.terms.automationCost` 'orchard'>>
          <<set _wineLine.installed to true, _wineLine.ready_at to Time.date.timeStamp + _wineLineModule.terms.automationMinutes * 60>>
          <<set _winePlanDay to Math.floor(Time.date.timeStamp / 86400) - (Time.hour lt _wineLineModule.terms.automationHour ? 1 : 0)>>
          <<set _wineLine.day to _winePlanDay, _wineLine.supply_day to _winePlanDay>>
          <<set _wineLine.expenses += _wineLineModule.terms.automationCost, _wineLineModule.state.expenses += _wineLineModule.terms.automationCost>>
          <<pass _wineLineModule.terms.automationMinutes>><<updatesidebarmoney>>
          <<if maplebirch.passage.title is 'Deadwood Orchard Winery' and $location is 'alex_farm' and !$nextPassage and !$nextPassageCheck>><<run maplebirch.SugarCube.Engine.show()>><</if>>
        <</if>>
      <</lanLink>><br>
    <<else>>
      <span class='blue'><<lanSwitch 'You need enough money and a quiet spell to fit the equipment.' '得备好费用，也得有工夫把设备装起来。'>></span><br>
    <</if>>
  <<else>>
    <<deadwood-orchard-winery-automation-status>>
    <div id='deadwood-winery-instructions'>
      <<lanLink ['Read the equipment and delivery notes', '查看设备与配送说明']>>
        <<replace '#deadwood-winery-instructions'>>
          <<language>>
            <<option 'EN'>>
              Work starts at 09:00: mature batches are bottled first, then empty vessels are filled with your chosen recipe. Reserved fruit and outstanding orders are kept aside. Supplies and bottles still cost money; without enough fruit or funds, no new batch starts.
              <br><br>
              The carrier takes <<print _wineLineModule.terms.shopSupplyQuantity>> spare bottles per trip to Robin's shop, up to <<print _wineLineModule.terms.automationSupplyLimit>> a day. Each trip costs <span class='gold'><<printmoney _wineLineModule.terms.automationHaulFee>></span>, deducted from the delivery payment. Robin keeps enough money for rent, and the cabinet holds <<print _wineLineModule.terms.shopStockLimit>> bottles. Missed deliveries are not made up.
            <<option 'CN'>>
              每天09:00开工，先装瓶，再按你选的配方为闲置酒桶投料。保留水果和未完成订单会先留好，辅料与酒瓶照常付费。水果或钱不够，就不开始新的一批。
              <br><br>
              送货人每趟带<<print _wineLineModule.terms.shopSupplyQuantity>>瓶多余的酒去罗宾店里，当天最多<<print _wineLineModule.terms.automationSupplyLimit>>瓶。每趟运费<span class='gold'><<printmoney _wineLineModule.terms.automationHaulFee>></span>，从货款中扣除。罗宾会留够房租，酒柜最多放<<print _wineLineModule.terms.shopStockLimit>>瓶。错过的配送不补做。
          <</language>><br><br>
        <</replace>>
      <</lanLink>>
    </div>
    <<if _wineLineModule.canOperate and _wineLine.ready_at lte Time.date.timeStamp>>
      <<set _winePlan to {bottle: _wineLine.bottle, recipe: _wineLine.recipe ?? '', supply: _wineLine.supply}>>
      <br><label><<checkbox '_winePlan.bottle' false true autocheck>><<lanSwitch 'Bottle mature batches' '将成熟的果酒装瓶'>></label><br>
      <<set _winePlans to {}>><<set _winePlans[lanSwitch('Do not start new batches', '不再投料酿造')] to ''>>
      <<for _wineRecipe range _wineLineModule.terms.recipes>><<set _winePlans[lanSwitch(_wineRecipe.name[0], _wineRecipe.name[1])] to _wineRecipe.id>><</for>>
      <label><<lanSwitch 'Refill empty vessels with: ' '空桶继续酿：'>><<listbox '_winePlan.recipe' autoselect>><<optionsfrom _winePlans>><</listbox>></label><br>
      <label><<checkbox '_winePlan.supply' false true autocheck>><<lanSwitch 'Deliver spare bottles to Robin\'s shop' '将多余瓶装酒送到罗宾饮品店'>></label><br>
      <<icon 'orchard/contract.png'>><<lanLink ['Leave these instructions', '留下这份安排']>>
        <<set _wineLineModule to maplebirch.get('Orchard').winery>><<set _wineLine to _wineLineModule.state.automation>>
        <<if _wineLineModule.canOperate and _wineLine.installed and _wineLine.ready_at lte Time.date.timeStamp and typeof _winePlan.bottle is 'boolean' and typeof _winePlan.supply is 'boolean'
          and (_winePlan.recipe is '' or _wineLineModule.terms.recipes.some(recipe => recipe.id === _winePlan.recipe))>>
          <<set _wineLine.bottle to _winePlan.bottle, _wineLine.recipe to _winePlan.recipe || null, _wineLine.supply to _winePlan.supply>>
          <<set _winePlanDay to Math.floor(Time.date.timeStamp / 86400) - (Time.hour lt _wineLineModule.terms.automationHour ? 1 : 0)>>
          <<set _wineLine.day to Math.max(_wineLine.day, _winePlanDay), _wineLine.supply_day to Math.max(_wineLine.supply_day, _winePlanDay)>>
          <<run Dynamic.render('deadwood-orchard-winery')>>
        <</if>>
      <</lanLink>><br>
      <span class='grey'><<lanSwitch 'Changes after 09:00 apply to the next day. Turning work off stops it immediately.' '09:00后更改安排，从明天开始。取消的工作会立即停下。'>></span><br>
    <</if>>
    <<lanSwitch 'Equipment and automatic work so far: ' '设备与自动作业累计支出：'>><span class='gold'><<printmoney _wineLine.expenses>></span><<lanSwitch ', including delivery fees: ' '，其中配送运费：'>><span class='gold'><<printmoney _wineLine.fees>></span><br>
  <</if>>
<</widget>>

:: Deadwood Orchard Winery
<<set _winery to maplebirch.get('Orchard')?.winery>>
<<if _winery?.available>>
  <<set $Orchard.site to 'farm'>><<set $outside to 0>><<set $location to 'alex_farm'>><<farm_work_update>><<effects>>
  <h3><<icon 'orchard/winery.png'>><<lanSwitch 'Orchard winery' '果园酿酒间'>></h3>
  <<if maplebirch.get('Orchard').farmInterrupted or $farm_assault>>
    <<lanSwitch 'The trouble on the farm has stopped work here. Leave the bottles where they are for now.' '农场的乱子让这里停了工。先把酒瓶留在原处。'>><br>
  <<else>>
    <<deadwood-dynamicblock 'deadwood-orchard-winery'>>
      <<set _winery to maplebirch.get('Orchard').winery>>
      <<if !_winery.state.installed>>
        <<language>>
          <<option 'EN'>>
            A sheltered corner beside the fruit store has been left clear. Empty crates stand against the wall, leaving room for a press, clean bottles and three fermentation vessels. Some of the harvest could be made into bottled wine here.
          <<option 'CN'>>
            果料仓旁腾出了一处遮蔽好的空地。空果箱沿墙摞着，余下的地方能摆下压榨机、干净酒瓶和三个发酵桶。收成里可以留出一部分，在这里酿成瓶装果酒。
        <</language>><br><br>
        <<lanSwitch 'Equipment: ' '设备费用：'>><span class='gold'><<printmoney _winery.terms.equipmentCost>></span><br>
        <<if maplebirch.get('Orchard').canWork and !$nextPassage and !$nextPassageCheck>>
          <<if maplebirch.get('Finance')?.canPay(_winery.terms.equipmentCost, 'orchard') ?? $money gte _winery.terms.equipmentCost>>
            <<icon 'orchard/fruit-press.png'>><<lanLink ['Set up the winery (0:30)', '布置果园酿酒间 (0:30)']>>
              <<set _winery to maplebirch.get('Orchard').winery>>
              <<if maplebirch.passage.title is 'Deadwood Orchard Winery' and $location is 'alex_farm' and _winery.available and !_winery.state.installed
                and maplebirch.get('Orchard').canWork and !maplebirch.get('Orchard').farmInterrupted and !$farm_assault and !$nextPassage and !$nextPassageCheck
                and (maplebirch.get('Finance')?.canPay(_winery.terms.equipmentCost, 'orchard') ?? $money gte _winery.terms.equipmentCost)>>
                <<money `-_winery.terms.equipmentCost` 'orchard'>>
                <<set _winery.state.installed to true>><<set _winery.state.expenses += _winery.terms.equipmentCost>>
                <<pass 30>><<updatesidebarmoney>>
                <<if maplebirch.passage.title is 'Deadwood Orchard Winery' and $location is 'alex_farm' and !$nextPassage and !$nextPassageCheck>><<run maplebirch.SugarCube.Engine.show()>><</if>>
              <<else>>
                <<replace '#deadwood-orchard-winery-note'>><span class='blue'><<lanSwitch 'You cannot set up the equipment right now.' '现在无法布置设备。'>></span><br><</replace>>
              <</if>>
            <</lanLink>><br>
          <<else>>
            <span class='blue'><<lanSwitch 'You cannot afford the equipment yet.' '你还付不起设备费用。'>></span><br>
          <</if>>
        <<else>>
          <span class='blue'><<lanSwitch 'Come back when you can work on the farm.' '等你能在农场作业时再来。'>></span><br>
        <</if>>
      <<else>>
        <<language>>
          <<option 'EN'>>
            The press stands over a shallow catching tray, with a brush hung beside it. The fermentation vessels stand apart from the stored fruit.
            <<if _winery.ready.length>>A date on one of the vessels tells you the wine is ready. You leave a space on the bench for the bottles.
            <<elseif _winery.state.batches.length>>The smell of fruit lingers around the press. You check the dates on the lids; the wine still needs time.
            <<elseif Object.values(_winery.state.stock).some(amount => amount > 0)>>Crates of labelled bottles stand beneath the bench. The empty vessels have been washed for the next batch.
            <<else>>The vessels stand empty, their lids propped beside them. There is room on the rack for the next batch of bottles.<</if>>
            <<if Time.dayState is 'night'>>The work lamp lights the labels, leaving the corners of the room in shadow.<</if>>
          <<option 'CN'>>
            压榨机下接着浅盘，刷子挂在手边。发酵桶与储存的水果隔开摆放。
            <<if _winery.ready.length>>有只桶盖上写的日期已经到了，该装瓶了。你在台面上腾出一块地方，准备摆酒瓶。
            <<elseif _winery.state.batches.length>>压榨机旁仍有果香。你看看桶盖上的日期，还得再等一阵。
            <<elseif Object.values(_winery.state.stock).some(amount => amount > 0)>>贴好标签的酒瓶装在台下的果箱里。腾出来的发酵桶已经洗净，等着酿下一批。
            <<else>>发酵桶空着，桶盖立在旁边。瓶架上也留着位置，等下一批酒装瓶。<</if>>
            <<if Time.dayState is 'night'>>工作灯照着标签，屋子的角落隐在暗处。<</if>>
        <</language>><br><br>
        <<lanSwitch 'Vessels in use: ' '使用中的发酵桶：'>><span class='blue'><<= _winery.state.batches.length>> / <<= _winery.terms.barrelCapacity>></span><br>
        <<for _batch range _winery.state.batches>>
          <<set _recipe to _winery.terms.recipes.find(recipe => recipe.id === _batch.recipe)>>
          <<capture _batch _recipe>>
            <<icon _recipe.icon>><<= lanSwitch(_recipe.name[0], _recipe.name[1])>> × <<= _batch.bottles>>
            <<if _batch.ready_at lte Time.date.timeStamp>>
              — <span class='green'><<lanSwitch 'Ready to bottle' '可以装瓶'>></span><br>
              <<set _wineBottleFunds to maplebirch.get('Finance')?.canPay(_batch.bottles * _winery.terms.bottleCost, 'orchard') ?? $money gte _batch.bottles * _winery.terms.bottleCost>>
              <<lanSwitch 'Bottles and corks: ' '酒瓶与瓶塞：'>><span @class="_wineBottleFunds ? 'gold' : 'red'"><<printmoney `_batch.bottles * _winery.terms.bottleCost`>></span><br>
              <<if _winery.canOperate and _wineBottleFunds>>
                <<icon 'orchard/wine-bottling.png'>><<lanLink ['Bottle this batch (0:' + _winery.bottleMinutes + ')', '将这一批装瓶 (0:' + _winery.bottleMinutes + ')']>>
                  <<set _bottleMinutes to maplebirch.get('Orchard').winery.bottleMinutes>>
                  <<if maplebirch.get('Orchard').winery.bottle(_batch.id)>>
                    <<pass _bottleMinutes>><<updatesidebarmoney>>
                    <<if maplebirch.passage.title is 'Deadwood Orchard Winery' and $location is 'alex_farm' and !$nextPassage and !$nextPassageCheck>><<run maplebirch.SugarCube.Engine.show()>><</if>>
                  <<else>>
                    <<replace '#deadwood-orchard-winery-note'>><span class='blue'><<lanSwitch 'This batch cannot be bottled right now. Check the bottle cost and whether work is interrupted.' '现在无法装瓶。看看费用是否足够，作业是否中断。'>></span><br><</replace>>
                  <</if>>
                <</lanLink>><br>
              <</if>>
            <<else>>
              — <span class='blue'><<lanSwitch 'Still fermenting; ' '仍在发酵，'>><<= Math.ceil((_batch.ready_at - Time.date.timeStamp) / 86400)>><<lanSwitch ' day(s) remaining' '天后可以装瓶'>></span><br>
            <</if>>
          <</capture>>
        <</for>>
        <br><span class='gold'><<lanSwitch 'Start a batch' '开始酿制'>></span><br>
        <<set _wineBatchFunds to maplebirch.get('Finance')?.canPay(_winery.terms.batchCost, 'orchard') ?? $money gte _winery.terms.batchCost>>
        <<lanSwitch 'Each batch uses ' '每批消耗'>><<= _winery.terms.fruitPerBatch>><<lanSwitch ' fruit and yields ' '个水果，酿得'>><<= _winery.terms.bottlesPerBatch>><<lanSwitch ' bottles. Fermentation supplies cost ' '瓶酒。发酵辅料费用'>><span @class="_wineBatchFunds ? 'gold' : 'red'"><<printmoney _winery.terms.batchCost>></span><<lanSwitch '; bottles are paid for when you fill them.' '，装瓶时再支付酒瓶费用。'>><br>
        <<lanSwitch 'Reserved fruit and outstanding fruit deliveries are kept aside.' '保留水果和已答应交付的水果不会拿去酿酒。'>><br>
        <<for _recipe range _winery.terms.recipes>>
          <<capture _recipe>>
            <<foodstufficon _recipe.fruit>><<= lanSwitch(_recipe.name[0], _recipe.name[1])>> — <<= _winery.terms.fruitPerBatch>> <<= lanSwitch(maplebirch.get('Orchard').species[_recipe.fruit].name[0], maplebirch.get('Orchard').species[_recipe.fruit].name[1])>>
            / <<= _winery.terms.bottlesPerBatch>><<lanSwitch ' bottles / ' '瓶 / '>><<= _recipe.days>><<lanSwitch ' days' '天'>>
            <<set _wineFruit to _winery.spareFruit(_recipe.id, Math.floor(Time.days))>>
            (<span @class="_wineFruit gte _winery.terms.fruitPerBatch ? 'green' : 'red'"><<lanSwitch 'available: ' '可用：'>><<= _wineFruit>></span>)<br>
            <<if _winery.canOperate and _wineBatchFunds and _wineFruit gte _winery.terms.fruitPerBatch and _winery.state.batches.length lt _winery.terms.barrelCapacity>>
              <<icon 'orchard/fermentation.png'>><<lanLink ['Prepare ' + _recipe.name[0] + ' (0:' + _winery.terms.startMinutes + ')', '准备酿制' + _recipe.name[1] + ' (0:' + _winery.terms.startMinutes + ')']>>
                <<if maplebirch.get('Orchard').winery.begin(_recipe.id)>>
                  <<pass `maplebirch.get('Orchard').winery.terms.startMinutes`>><<updatesidebarmoney>>
                  <<if maplebirch.passage.title is 'Deadwood Orchard Winery' and $location is 'alex_farm' and !$nextPassage and !$nextPassageCheck>><<run maplebirch.SugarCube.Engine.show()>><</if>>
                <<else>>
                  <<replace '#deadwood-orchard-winery-note'>><span class='blue'><<lanSwitch 'You need enough spare fruit, supplies and an empty vessel to start this batch.' '开始这一批需要足够的多余水果、辅料费用与空发酵桶。'>></span><br><</replace>>
                <</if>>
              <</lanLink>><br>
            <</if>>
          <</capture>>
        <</for>>
        <<if _winery.state.batches.length gte _winery.terms.barrelCapacity>>
          <span class='blue'><<lanSwitch 'All the vessels are occupied. Bottle a finished batch to free one.' '发酵桶都占着。将酿好的酒装瓶，就能腾出一个。'>></span><br>
        <</if>>
        <br><span class='gold'><<lanSwitch 'Bottled stock' '瓶装库存'>></span><br>
        <<lanSwitch 'Wholesale capacity remaining today: ' '今天还能批发：'>><span class='blue'><<= _winery.saleRemaining>></span><<lanSwitch ' bottles' '瓶'>><br>
        <<if !_winery.canSell>>
          <span class='blue'><<lanSwitch 'Farm wholesale deliveries are taken during the daytime while Alex handles administration. You can still prepare and bottle wine after dark.' '农场在白天、艾利克斯处理行政事务时收取批发货物。夜里仍能准备发酵和装瓶。'>></span><br>
        <</if>>
        <<set _wineKeep to {}>>
        <<if !Object.values(_winery.state.stock).some(amount => amount > 0)>>
          <<lanSwitch 'The bottle crates are empty. A finished batch can be bottled here when it is ready.' '酒箱还是空的。等酒酿好，就能在这里装瓶入库。'>><br>
        <</if>>
        <<for _recipe range _winery.terms.recipes>>
          <<if _winery.state.stock[_recipe.id] gt 0 or _winery.state.reserve[_recipe.id] gt 0>><<capture _recipe>>
            <br><<icon _recipe.icon>><b><<= lanSwitch(_recipe.name[0], _recipe.name[1])>></b> × <<= _winery.state.stock[_recipe.id]>><br>
            <<lanSwitch 'Wholesale price per bottle: ' '每瓶批发价：'>><span class='gold'><<printmoney _recipe.wholesale>></span><br>
            <<set _wineKeep[_recipe.id] to _winery.state.reserve[_recipe.id]>>
            <<set _wineKeepVariable to '_wineKeep.' + _recipe.id>>
            <<lanSwitch 'Keep at least: ' '至少保留：'>><<numberbox _wineKeepVariable _winery.state.reserve[_recipe.id]>>
            <<lanLink ['Save', '保存']>>
              <<set _winery to maplebirch.get('Orchard').winery>><<set _wineKeepAmount to Number(_wineKeep[_recipe.id])>>
              <<if _winery.canOperate and Number.isSafeInteger(_wineKeepAmount) and _wineKeepAmount gte 0 and _wineKeepAmount lte _winery.state.stock[_recipe.id]>>
                <<set _winery.state.reserve[_recipe.id] to _wineKeepAmount>><<run Dynamic.render('deadwood-orchard-winery')>>
              <<else>>
                <<replace '#deadwood-orchard-winery-note'>><span class='blue'><<lanSwitch 'Choose a whole number between zero and your current stock.' '请填写零到现有库存之间的整数。'>></span><br><</replace>>
              <</if>>
            <</lanLink>><br>
            <<set _wineSaleAmount to Math.min(_winery.state.stock[_recipe.id] - _winery.state.reserve[_recipe.id], _winery.saleRemaining)>>
            <<capture _wineSaleAmount>>
              <<if _winery.canSell and _wineSaleAmount gt 0>>
                <<icon 'company/sales.png'>><<lanLink ['Sell the surplus (' + _wineSaleAmount + ' bottles, 0:' + _winery.terms.saleMinutes + ')', '批发多余库存（' + _wineSaleAmount + '瓶，0:' + _winery.terms.saleMinutes + '）']>>
                  <<if maplebirch.get('Orchard').winery.sell(_recipe.id, _wineSaleAmount)>>
                    <<pass `maplebirch.get('Orchard').winery.terms.saleMinutes`>><<updatesidebarmoney>>
                    <<if maplebirch.passage.title is 'Deadwood Orchard Winery' and $location is 'alex_farm' and !$nextPassage and !$nextPassageCheck>><<run maplebirch.SugarCube.Engine.show()>><</if>>
                  <<else>>
                    <<replace '#deadwood-orchard-winery-note'>><span class='blue'><<lanSwitch 'That delivery cannot be completed right now.' '现在无法完成这笔交货。'>></span><br><</replace>>
                  <</if>>
                <</lanLink>><br>
              <</if>>
            <</capture>>
          <</capture>><</if>>
        <</for>>
        <<deadwood-orchard-winery-automation>>
        <br><span class='gold'><<lanSwitch 'Winery accounts' '果酒账目'>></span><br>
        <<lanSwitch 'Bottles produced: ' '累计装瓶：'>><span class='blue'><<= _winery.state.produced>></span><br>
        <<lanSwitch 'Sales before delivery fees: ' '扣运费前的销售货款：'>><span class='gold'><<printmoney _winery.state.income>></span><br>
        <<lanSwitch 'Equipment, production and delivery expenses: ' '设备、生产与配送支出：'>><span class='gold'><<printmoney _winery.state.expenses>></span><br>
        <<lanSwitch 'Bring your saved bottles to your property to enjoy them.' '保留下来的酒，可以在自家房产里享用。'>><br>
      <</if>>
      <div id='deadwood-orchard-winery-note'></div>
    <</deadwood-dynamicblock>>
  <</if>>
  <br><<getouticon>><<lanLink ['Return to the orchard', '返回果园'] 'Deadwood Reblooms Orchard'>><</lanLink>>
<<else>>
  <<lanSwitch 'You need a working orchard at Alex\'s farm before setting up a winery.' '先在艾利克斯的农场经营果园，才能添置酿酒设备。'>><br><br>
  <<getouticon>><<lanLink ['Return to the fields', '返回田地'] 'Farm Fields'>><</lanLink>>
<</if>>

:: Deadwood Orchard Robin Wine
<<set $outside to 0>><<set $location to 'deadwood_robin_shop'>><<effects>>
<<deadwood-dynamicblock 'deadwood-orchard-robin-wine'>>
  <<set _winery to maplebirch.get('Orchard')?.winery>>
  <<if _winery?.available and _winery.state.installed and maplebirch.get('Orchard').canSupplyRobin and C.npc.Robin.trauma lt 80 and !$nextPassage and !$nextPassageCheck>>
    <<npc Robin>><<person1>>
    <<if !_winery.state.shop_enabled>>
      <<language>>
        <<option 'EN'>>
          You tell Robin about the orchard wine. <<He>> looks at the space beside the till. "Bottles, rather than another drink to make? I could try a few." <<He>> brings over the order pad. "They'd need their own cabinet. And dates on the labels. I don't want them mixed up with the lemonade."
        <<option 'CN'>>
          你向罗宾提起果园酿的酒。<<He>>看了看收银机旁的空处。“卖整瓶，不是多一杯要调的饮料？可以先试几瓶。”<<He>>拿来订单本。“得有单独的柜子，标签上也写好日期。我不想和柠檬水弄混。”
      <</language>><br><br>
      <<icon 'orchard/bottle-cabinet.png'>><<lanSwitch 'A cabinet for sealed bottles: ' '封瓶酒柜费用：'>><span class='gold'><<printmoney _winery.terms.shopSetupCost>></span><br>
      <<if maplebirch.get('Finance')?.canPay(_winery.terms.shopSetupCost, 'orchard') ?? $money gte _winery.terms.shopSetupCost>>
        <<icon 'orchard/bottle-cabinet.png'>><<lanLink ['Pay for the bottle cabinet (0:15)', '出钱添置瓶装酒柜 (0:15)']>>
          <<set _winery to maplebirch.get('Orchard').winery>>
          <<if maplebirch.passage.title is 'Deadwood Orchard Robin Wine' and _winery.available and _winery.state.installed and !_winery.state.shop_enabled
            and maplebirch.get('Orchard').canSupplyRobin and C.npc.Robin.trauma lt 80 and !$nextPassage and !$nextPassageCheck
            and (maplebirch.get('Finance')?.canPay(_winery.terms.shopSetupCost, 'orchard') ?? $money gte _winery.terms.shopSetupCost)>>
            <<money `-_winery.terms.shopSetupCost` 'orchard'>>
            <<set _winery.state.shop_enabled to true>><<set _winery.state.expenses += _winery.terms.shopSetupCost>>
            <<pass 15>><<updatesidebarmoney>>
            <<if maplebirch.passage.title is 'Deadwood Orchard Robin Wine' and $location is 'deadwood_robin_shop' and !$nextPassage and !$nextPassageCheck>><<run maplebirch.SugarCube.Engine.show()>><</if>>
          <<else>>
            <<replace '#deadwood-orchard-robin-wine-note'>><span class='blue'><<lanSwitch 'You cannot arrange the cabinet right now.' '现在无法添置酒柜。'>></span><br><</replace>>
          <</if>>
        <</lanLink>><br>
      <<else>>
        <span class='blue'><<lanSwitch 'You cannot afford the cabinet yet.' '你还付不起酒柜费用。'>></span><br>
      <</if>>
    <<else>>
      <<language>>
        <<option 'EN'>>
          <<if _winery.state.supplied is 0>>
            Robin opens the new cabinet and checks that the door clears the counter. "Six bottles to start with? Let's see how they go." <<He>> leaves a space for the delivery on the order pad.
          <<elseif _winery.shopStock is 0>>
            Robin slides open the empty cabinet. "That was the last of them. I've still got the labels here, so I won't forget which is which." <<He>> moves the bottle list beside the order pad.
          <<elseif _winery.state.supplied is _winery.terms.shopSupplyQuantity>>
            Robin straightens the first few bottles behind the glass. "There. Let's give these a chance before filling the whole cabinet." <<He>> checks the label once more before closing the door.
          <<elseif _winery.skilled>>
            Robin checks the cabinet list, then holds the door while you look inside. "I've kept the different ones apart. Much easier than taking them all out when someone asks." <<He>> runs a finger down the list. "I can see which ones need replacing, too."
          <<else>>
            Robin checks the bottle count against the cabinet list. "Six at a time should do. I'll write down what I take, and pay you before they go on the shelf." <<He>> keeps the bottled wine list beside the usual drink orders.
          <</if>>
        <<option 'CN'>>
          <<if _winery.state.supplied is 0>>
            罗宾打开新酒柜，试了试柜门会不会碰到柜台。“先来六瓶？看看卖得怎么样。”<<He>>在订单本上空出一行，等着记下这批货。
          <<elseif _winery.shopStock is 0>>
            罗宾拉开空酒柜。“最后几瓶也卖掉了。标签我还留着，不会把它们弄混。”<<He>>把果酒清单挪到订单本旁。
          <<elseif _winery.state.supplied is _winery.terms.shopSupplyQuantity>>
            罗宾把头一批酒瓶在玻璃后摆正。“好了。先看看这几瓶卖得怎么样，不急着把柜子塞满。”<<He>>又确认了一遍标签，才关好柜门。
          <<elseif _winery.skilled>>
            罗宾核对过清单，扶着柜门让你往里看。“不同的都分开放了。有人问，也不用全搬出来找。”<<He>>沿着清单往下看。“哪种该补了，也看得清楚。”
          <<else>>
            罗宾对照酒柜清单数了数瓶子。“一次六瓶就好。收多少我都记下来，上架之前先付你的货款。”<<He>>把瓶装果酒的清单放在日常饮品订单旁。
          <</if>>
      <</language>><br><br>
      <<set _wineDelivery to _winery.state.ledger.slice().reverse().find(sale => sale.source === 'robin')>>
      <<if _wineDelivery and _winery.state.shop_stock[_wineDelivery.recipe] gt 0>>
        <<set _shopWine to _winery.terms.recipes.find(recipe => recipe.id === _wineDelivery.recipe)>>
        <<language>>
          <<option 'EN'>>
            <<switch _shopWine.id>>
              <<case 'cider'>>Robin turns an apple cider label towards the glass. "That should save me explaining what's in it."
              <<case 'perry'>>Robin points at the pear cider label. "Pear cider. I'll make sure I say that when someone asks. The bottles all look alike."
              <<case 'plum_wine'>>Robin checks the plum wine label. "I've had to point out that it's wine. Better not put it beside the fruit juice."
              <<case 'cherry_wine'>>Robin moves a cherry wine bottle away from the edge. "The label caught my eye. I don't want it getting knocked off while I'm making drinks."
            <</switch>>
            <<if Time.season is 'winter'>>"Mostly hot drinks today. These can stay sealed until someone takes them home."<<elseif maplebirch.get('Orchard').species[_shopWine.fruit].fruitSeasons.includes(Time.season)>>"There's a lot more to keep track of when the fruit comes in, isn't there?"<</if>>
          <<option 'CN'>>
            <<switch _shopWine.id>>
              <<case 'cider'>>罗宾把一瓶苹果酒的标签转向玻璃。“这样就不用每次都解释是什么酿的了。”
              <<case 'perry'>>罗宾指指梨酒的标签。“梨酒。得记得说清楚，瓶子看着可都一样。”
              <<case 'plum_wine'>>罗宾看了看李子酒的标签。“还得提醒人这是酒。可不能放在果汁旁边。”
              <<case 'cherry_wine'>>罗宾把一瓶樱桃酒往里挪了挪。“刚才看标签才注意到。调饮料的时候，可别碰下去了。”
            <</switch>>
            <<if Time.season is 'winter'>>“今天大多是来买热饮的。这些封着口，等人买回家就好。”<<elseif maplebirch.get('Orchard').species[_shopWine.fruit].fruitSeasons.includes(Time.season)>>“到了收水果的时候，要操心的事也多起来了，是吧？”<</if>>
        <</language>><br><br>
      <</if>>
      <<lanSwitch 'Cabinet stock: ' '酒柜库存：'>><span class='blue'><<= _winery.shopStock>> / <<= _winery.terms.shopStockLimit>></span><<lanSwitch ' bottles' '瓶'>><br>
      <<lanSwitch 'Up to ' '每周最多售出'>><<= _winery.terms.shopWeeklyLimit>><<lanSwitch ' bottles are sold each week. Robin pays for supplies from the shop’s available funds.' '瓶。供货款由罗宾从店铺可用资金中支付。'>><br>
      <<if !_winery.terms.recipes.some(recipe => _winery.state.stock[recipe.id] - _winery.state.reserve[recipe.id] gte _winery.terms.shopSupplyQuantity)>>
        <span class='blue'><<lanSwitch 'You do not have six spare bottles of any one wine. Reserved bottles are kept aside.' '你没有哪种果酒能凑出六瓶余货。保留的瓶装果酒不会用于供货。'>></span><br>
      <</if>>
      <<for _recipe range _winery.terms.recipes>>
        <<capture _recipe>>
          <br><<icon _recipe.icon>><b><<= lanSwitch(_recipe.name[0], _recipe.name[1])>></b><br>
          <<lanSwitch 'Your spare bottles: ' '你可供货的瓶数：'>><span class='blue'><<= Math.max(0, _winery.state.stock[_recipe.id] - _winery.state.reserve[_recipe.id])>></span>
          <<lanSwitch ' / On the shelf: ' ' / 柜中：'>><span class='blue'><<= _winery.state.shop_stock[_recipe.id]>></span><br>
          <<lanSwitch 'Payment for ' '交付'>><<= _winery.terms.shopSupplyQuantity>><<lanSwitch ' bottles: ' '瓶的货款：'>><span class='gold'><<printmoney `_recipe.wholesale * _winery.terms.shopSupplyQuantity`>></span><br>
          <<if _winery.canSupply and _winery.state.stock[_recipe.id] - _winery.state.reserve[_recipe.id] gte _winery.terms.shopSupplyQuantity>>
            <<if maplebirch.get('Robin').shop.canSpend(_recipe.wholesale * _winery.terms.shopSupplyQuantity / 100)>>
              <<icon 'orchard/wine-delivery.png'>><<lanLink ['Deliver ' + _recipe.name[0] + ' (0:' + _winery.terms.supplyMinutes + ')', '交付' + _recipe.name[1] + ' (0:' + _winery.terms.supplyMinutes + ')']>>
                <<if maplebirch.get('Orchard').winery.supply(_recipe.id)>>
                  <<pass `maplebirch.get('Orchard').winery.terms.supplyMinutes`>><<updatesidebarmoney>>
                  <<if maplebirch.passage.title is 'Deadwood Orchard Robin Wine' and $location is 'deadwood_robin_shop' and !$nextPassage and !$nextPassageCheck>><<run maplebirch.SugarCube.Engine.show()>><</if>>
                <<else>>
                  <<replace '#deadwood-orchard-robin-wine-note'>><span class='blue'><<lanSwitch 'The stock, cabinet space or available payment has changed. Check the delivery again.' '库存、酒柜空位或可用货款发生了变化。请重新核对交货。'>></span><br><</replace>>
                <</if>>
              <</lanLink>><br>
            <<else>>
              <span class='blue'><<lanSwitch 'Robin needs to keep the remaining funds for the shop and rent.' '罗宾得把剩下的资金留给经营和房租。'>></span><br>
            <</if>>
          <</if>>
        <</capture>>
      <</for>>
      <<if _winery.shopStock + _winery.terms.shopSupplyQuantity gt _winery.terms.shopStockLimit>>
        <br><span class='blue'><<lanSwitch 'The cabinet has no room for another delivery yet.' '酒柜暂时放不下下一批货。'>></span><br>
      <</if>>
    <</if>>
    <div id='deadwood-orchard-robin-wine-note'></div>
  <<else>>
    <<lanSwitch 'Now is not a good time to discuss wine supplies.' '现在不方便商量果酒供货。'>>
  <</if>>
<</deadwood-dynamicblock>>
<br><br><<getouticon>><<lanLink ['Return to the drinks shop', '返回饮品店'] 'Deadwood Robin Shop'>><</lanLink>>

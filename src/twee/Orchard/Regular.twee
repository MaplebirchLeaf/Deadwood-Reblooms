:: Deadwood Orchard Regular Widgets [widget]
<<widget 'deadwood-orchard-regular-link'>>
  <<if maplebirch.get('Orchard')?.canMeetRegular and maplebirch.get('Orchard').regularStock.length>>
    <<socialiseicon>><<lanLink ['Attend to a fruit customer (0:20)', '招待买水果的客人 (0:20)'] 'Deadwood Orchard Regular'>><</lanLink>><br>
  <</if>>
<</widget>>

:: Deadwood Orchard Regular
<<set $location to 'market'>><<set $outside to 0>><<effects>><<endevent>>
<<set $_orchard to maplebirch.get('Orchard')>>
<<if $_orchard and $_orchard.canMeetRegular>>
  <<if !$per_npc.deadwood_orchard_regular>>
    <<generateNPC 1 a>><<saveNPC 0 'deadwood_orchard_regular'>>
  <<else>>
    <<loadNPC 0 'deadwood_orchard_regular'>>
  <</if>>
  <<person1>>
  <div id='orchard-customer'>
  <<if $NPCList[0].name_known isnot 1>>
    <<language>>
      <<option 'EN'>>
      A <<person>> stops at your stall and looks over the fruit. "Five, please," <<he>> says, holding out a cloth bag. "The paper ones always split on the way home." <<He>> asks which days you sell here, then introduces <<himself>> as <<personname>>.
      <<option 'CN'>>
      一个<<person>>在你的摊位前停下，打量着水果。“给我五个吧。”<<he>>说着，递来一只布袋。“纸袋总是在回家的路上破掉。”<<He>>问你哪几天来摆摊，又告诉你自己叫<<personname>>。
    <</language>>
  <<elseif $Orchard.regular_visits is 0>>
    <<language>>
      <<option 'EN'>>
      <<personname>> returns to the counter with the same cloth bag. "Found you again. What have you got?"
      <<option 'CN'>>
      <<personname>>又提着那只布袋来到柜台前。“又找到你了。今天卖些什么？”
    <</language>>
  <<elseif $Orchard.regular_visits lt 3>>
    <<language>>
      <<option 'EN'>>
      You recognise <<personname>>'s cloth bag before <<he>> speaks. "Those went quickly. What have you brought today?"
      <<option 'CN'>>
      <<personname>>还没开口，你就认出了那只布袋。“上次的很快就吃完了。今天带了些什么？”
    <</language>>
  <<else>>
    <<language>>
      <<option 'EN'>>
      <<personname>> waits while you straighten the display. "I thought I'd catch you here. Five again, if you have enough." The cloth bag is already open.
      <<option 'CN'>>
      <<personname>>等你整理好摊上的水果才开口。“想着在这儿能找到你。够的话，还是五个。”布袋已经撑开了。
    <</language>>
  <</if>>
  <<set $NPCList[0].name_known to 1>><<saveNPC 0 'deadwood_orchard_regular'>>
  <<if $Orchard.regular_visits gte 3 and $Orchard.regular_favourite>>
    <<language>>
      <<option 'EN'>>
        <<if $_orchard.regularStock.some(item => item.type is $Orchard.regular_favourite)>>
          <<personname>> spots the fruit <<he>> bought before. "The same as last time, please."
        <<else>>
          <<personname>> looks along the display. "None of the ones I usually buy? I'll try something else, then."
        <</if>>
      <<option 'CN'>>
        <<if $_orchard.regularStock.some(item => item.type is $Orchard.regular_favourite)>>
          <<personname>>找到了以前买过的水果。“还是上次那种吧。”
        <<else>>
          <<personname>>扫了一眼摊上的水果。“平时买的那种没有？那我尝尝别的。”
        <</if>>
    <</language>><br>
  <</if>></div><br><br>
  <div id='orchard-customer-choices'>
  <<for $_fruit range $_orchard.regularStock>>
    <<capture $_fruit>>
      <<foodstufficon $_fruit.type>><<lanLink ['Bag five of these', '装五个这种水果']>>
        <<if maplebirch.get('Orchard').sellRegular($_fruit.type)>>
          <<set _regularFruit to $_fruit.type>>
          <<pass 20>><<updatesidebarmoney>>
          <<replace '#orchard-customer'>>
            <<language>>
              <<option 'EN'>>
              <<if $Orchard.regular_visits is 1>>
                <<personname>> counts out the money while you fill the bag. "That'll do nicely. Much better than carrying them loose." <<He>> gathers the handles and steps away from the counter.
              <<elseif _regularFruit isnot $Orchard.regular_favourite>>
                <<personname>> holds the bag open for the different fruit. "A change won't hurt. I'll try these after dinner." <<He>> pays, gives the bag a gentle shake to settle its contents and makes room for the next customer.
              <<elseif Time.season is 'winter'>>
                <<personname>> tucks the bag beneath <<his>> coat while finding the money. "That's breakfast sorted. Now I'd better get out of this cold." <<He>> thanks you and heads along the market stalls.
              <<elseif maplebirch.get('Orchard').species[_regularFruit is 'blood_lemon' ? 'lemon' : _regularFruit].fruitSeasons.includes(Time.season)>>
                <<personname>> turns one of the fruit in <<his>> hand before putting it in the bag. "This is the time of year for them, isn't it?" <<He>> counts out the money, leaving the display as tidy as <<he>> found it.
              <<else>>
                <<personname>> pays and lifts the bag off the counter. "Still got them, then. I had a look before I came over." <<He>> gives you a nod before making room for the people behind.
              <</if>>
              <<option 'CN'>>
              <<if $Orchard.regular_visits is 1>>
                你装好水果，<<personname>>也数好了钱。“这样就好了，比抱着回去省事。”<<He>>拢起布袋的提手，从柜台前让开。
              <<elseif _regularFruit isnot $Orchard.regular_favourite>>
                <<personname>>撑开袋子，接住换来的水果。“换换口味也好，晚饭后尝尝。”<<He>>付过钱，轻轻晃了晃袋子，将水果放稳，给下一位客人让出位置。
              <<elseif Time.season is 'winter'>>
                <<personname>>将布袋拢在外套下，腾出手来数钱。“明天早饭有了，我也该找地方暖和暖和了。”<<He>>向你道谢，沿着摊位走去。
              <<elseif maplebirch.get('Orchard').species[_regularFruit is 'blood_lemon' ? 'lemon' : _regularFruit].fruitSeasons.includes(Time.season)>>
                <<personname>>拿起一个水果转了转，才放进袋里。“就是这时候吃这个，对吧？”<<He>>数好钱，把翻动过的水果也摆了回去。
              <<else>>
                <<personname>>付了钱，从柜台上提起袋子。“还有得卖啊，过来之前我还特意看了一眼。”<<He>>朝你点点头，给身后的人让开了位置。
              <</if>>
            <</language>><</replace>>
          <<replace '#orchard-customer-choices'>><</replace>>
        <</if>>
      <</lanLink>><br>
    <</capture>>
  <</for>></div>
<<else>>
  <<lanSwitch 'The customer has already moved on.' '客人已经离开了。'>>
<</if>>
<br><<getouticon>><<lanLink ['Return to your stall', '返回摊位'] 'Stall Manage'>><<endevent>><</lanLink>>

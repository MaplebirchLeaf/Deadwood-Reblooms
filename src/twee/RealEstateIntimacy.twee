:: Deadwood Reblooms Property Night Wake []
<<set _property to maplebirch.VP.realEstate.current>>
<<set _partner to maplebirch.VP.realEstate.currentCompanion>>
<<if !_property || !_partner || !maplebirch.VP.realEstate.residentsHome(_property.id).some(resident => resident.id === _partner.id)>>
	<<lanSwitch 'The other side of the bed is empty. You pull the covers close.' '床的另一侧空了。你把被子拉回身上。'>>
	<br><br>
	<<getouticon>><<lanLink '起床' 'Deadwood Reblooms Property Bedroom'>><<set $sleephour to 0>><<deadwood-reblooms-property-clothes-on>><</lanLink>>
<<else>>
	<<run maplebirch.VP.realEstate.enter()>>
	<<npc _partner.id>><<person1>><<run statusCheck(_partner.id)>>
	<<language>>
		<<option 'EN'>>
			<<switch _partner.id>>
				<<case 'Robin'>>
					<<if C.npc.Robin.trauma gte 50>>
						Robin wakes with a start, gripping the edge of the blanket. <<He>> lets go when <<he>> recognises you. You hold out your hand, and <<he>> takes it while <<his>> breathing slows.
						<br><br>
						"<span class='teal'>Stay until I fall asleep?</span>" <<he>> asks.
					<<else>>
						Robin has woken before you. <<He>> brushes your hair aside and leans in when you open your eyes. "<span class='lewd'>I was trying not to wake you.</span>"
					<</if>>
				<<case 'Whitney'>>
					Whitney's arm rests across your waist. <<He>> notices you're awake and draws you nearer. "<span class='lewd'>Couldn't sleep either?</span>" <<he>> murmurs, close enough to kiss.
				<<case 'Kylar'>>
					Kylar says your name in <<his>> sleep. When you touch <<his>> hand, <<he>> wakes and loosens <<his>> grip. "<span class='teal'>You're still here.</span>" <<He>> looks at you for an answer before moving closer.
				<<case 'Sydney'>>
					Sydney's temple pendant catches a little light on the bedside table. <<He>> has woken too and is watching you.
					<<if _sydneyStatus.includes('corruptLust')>>
						"<span class='lewd'>We don't have to go back to sleep yet,</span>" <<he>> whispers.
					<<elseif _sydneyStatus.includes('corrupt')>>
						"Go back to sleep," <<he>> says, and does not turn away. "I will be here in the morning."
					<<else>>
						"<span class='teal'>Would you like me to stay awake with you?</span>" <<he>> asks.
					<</if>>
			<</switch>>
		<<option 'CN'>>
			<<switch _partner.id>>
				<<case 'Robin'>>
					<<if C.npc.Robin.trauma gte 50>>
						罗宾猛地醒来，紧抓着被角。认出你后，<<he>>才松开手。你伸出手，<<he>>握住了，呼吸也渐渐平稳。
						<br><br>
						“<span class='teal'>等我睡着再松手，好吗？</span>”<<he>>问。
					<<else>>
						罗宾比你先醒。你睁开眼时，<<he>>拨开你脸旁的头发，靠近了些。“<span class='lewd'>我本来不想吵醒你的。</span>”
					<</if>>
				<<case 'Whitney'>>
					惠特尼的手臂搭在你腰上。见你醒来，<<he>>又把你拉近。“<span class='lewd'>你也睡不着？</span>”<<he>>轻声问，近得几乎要吻上来。
				<<case 'Kylar'>>
					凯拉尔在梦里叫了你的名字。你碰了碰<<his>>的手，<<he>>醒过来，松开攥着你的手。“<span class='teal'>你还在。</span>”<<He>>望着你，等你回应后才往你身边挪。
				<<case 'Sydney'>>
					床头的神殿吊坠映着一点微光。悉尼也醒了，正望着你。
					<<if _sydneyStatus.includes('corruptLust')>>
						“<span class='lewd'>我们不急着再睡。</span>”<<he>>贴近你，小声说。
					<<elseif _sydneyStatus.includes('corrupt')>>
						“继续睡吧。”<<he>>说，却没有翻过身去。“明早我还在。”
					<<else>>
						“<span class='teal'>要我陪你醒一会儿吗？</span>”<<he>>问。
					<</if>>
			<</switch>>
	<</language>>
	<br><br>
	<<if _partner.id isnot 'Robin' or C.npc.Robin.trauma lt 50>>
		<<loveicon>>
		<<lanLink '亲吻身边的恋人' 'Deadwood Reblooms Property Intimacy'>>
			<<set $sleephour to 0>><<set $sexstart to 1>>
		<</lanLink>><<promiscuous1>><<kissvirginitywarning>><<NPCvirginitywarning _partner.id 'kiss'>><br>
	<</if>>
	<<bedicon>>
	<<lanLink '继续睡觉' 'Deadwood Reblooms Property Sleep'>><</lanLink>><br>
	<<getouticon>>
	<<lanLink '起床' 'Deadwood Reblooms Property Bedroom'>>
		<<set $sleephour to 0>><<deadwood-reblooms-property-clothes-on>>
	<</lanLink>>
<</if>>

:: Deadwood Reblooms Property Intimacy []
<!-- 入口已从当晚在家的同住者中选人。战斗回合跨过起床时间后，继续使用当前存档里选中的同一人。 -->
<<set _property to maplebirch.VP.realEstate.current>>
<<set _partner to maplebirch.VP.realEstate.currentCompanion>>
<<if !_property || !_partner || !maplebirch.VP.realEstate.owns(_property.id) || maplebirch.VP.realEstate.managementFor(_property.id).rented>>
	<<set $sexstart to 0>>
	<<lanLink '返回卧室' 'Deadwood Reblooms Property Bedroom'>><</lanLink>>
<<else>>
	<<run maplebirch.VP.realEstate.enter()>>
	<<if $sexstart is 1>>
		<<set $sexstart to 0>>
		<<clearnpc>>
		<<npc _partner.id>><<person1>>
		<<run statusCheck(_partner.id)>>
		<<if _partner.id is 'Sydney'>>
			<<set $daily.sydney.sex to ($daily.sydney.sex || 0) + 1>>
			<<set $sydney.sexTotal += 1>>
		<</if>>
		<<consensual>>
		<<set $consensual to 1>>
		<<neutral 1>>
		<<if $exposed lt 2>>
			<span class='lewd'><<lanSwitch 'You slip out of your clothes.' '你脱下衣服。'>></span><<strip>><br><br>
		<</if>>
		<<maninit>>
		<<set $enemyarousalmax to 600>>
		<<if _partner.id is 'Sydney'>>
			<<if _sydneyStatus.includes('corrupt')>>
				<<npcexpose>>
				<<set $enemyarousalmax += 100>>
			<<else>>
				<<npcClothesType $NPCList[0] 'undies'>>
				<<if _sydneyStatus.includes('pure')>><<set $enemyarousalmax -= 100>><</if>>
			<</if>>
			<<if _sydneyChastity and C.npc.Sydney.chastity.anus.includes('shield')>>
				<<set $enemyarousalmax -= 100>>
			<</if>>
		<</if>>
		<<set $enemytrust += 500>>
		<<npckiss>>
		<<if $passagePrev is 'Deadwood Reblooms Property Night Wake'>>
			<<lanSwitch 'You turn toward your lover beneath the covers.' '你在被子下转过身，面向身边的恋人。'>>
		<<else>>
			<<lanSwitch 'You close the bedroom door and turn to them.' '你关上卧室门，转身看向对方。'>>
		<</if>>
		<br><br>
		<<switch _partner.id>>
			<<case 'Robin'>>
				<<if C.npc.Robin.trauma gte 20>>
					<<language>>
						<<option 'EN'>>"We can take our time," Robin says. <<He>> waits for you to come closer before <span class='lewd'>kissing you</span>.
						<<option 'CN'>>“我们可以慢慢来。”罗宾等你靠近，才<span class='lewd'>吻了你</span>。
					<</language>>
				<<else>>
					<<language>>
						<<option 'EN'>>Robin smiles and pulls you down beside <<him>>. "<span class='lewd'>I've been waiting for you.</span>"
						<<option 'CN'>>罗宾笑着把你拉到身边。“<span class='lewd'>我一直在等你。</span>”
					<</language>>
				<</if>>
			<<case 'Whitney'>>
				<<if C.npc.Whitney.dom gte 10>>
					<<language>>
						<<option 'EN'>>"About time," Whitney says, tugging you onto the bed. <<He>> <span class='lewd'>kisses you before you can reply</span>.
						<<option 'CN'>>“早该这样了。”惠特尼把你拉到床上，<span class='lewd'>没等你回答便吻了过来</span>。
					<</language>>
				<<else>>
					<<language>>
						<<option 'EN'>>Whitney drops onto the bed without asking and waits for you to follow. "<span class='teal'>Well?</span>" <<He>> does not reach for you first.
						<<option 'CN'>>惠特尼没问一声就坐到床上，等着你跟上来。“<span class='teal'>怎么？</span>”<<he>>没有先伸手碰你。
					<</language>>
				<</if>>
			<<case 'Kylar'>>
				<<if C.npc.Kylar.love gte 60>>
					<<language>>
						<<option 'EN'>>Kylar draws you close. "<span class='teal'>I want to stay like this,</span>" <<he>> says, pressing a kiss to your cheek.
						<<option 'CN'>>凯拉尔把你拉近。“<span class='teal'>我想一直这样待着。</span>”<<he>>说着吻了吻你的脸颊。
					<</language>>
				<<else>>
					<<language>>
						<<option 'EN'>>"<span class='teal'>With me?</span>" Kylar asks. You take <<his>> hand, and <<he>> follows you onto the bed.
						<<option 'CN'>>“<span class='teal'>和我一起？</span>”凯拉尔问。你握住<<his>>手，<<he>>才跟着你坐到床上。
					<</language>>
				<</if>>
			<<case 'Sydney'>>
				<<if _sydneyStatus.includes('corrupt')>>
					<<language>>
						<<option 'EN'>>Sydney sets <<his>> temple pendant aside. "<span class='lewd'>Now I can have you to myself,</span>" <<he>> murmurs, drawing you close.
						<<option 'CN'>>悉尼把神殿吊坠放到一旁。“<span class='lewd'>现在你可以只陪着我了。</span>”<<he>>低声说着，把你拉近。
					<</language>>
				<<else>>
					<<language>>
						<<option 'EN'>>Sydney sets <<his>> temple pendant aside. "<span class='teal'>Is this all right?</span>" <<he>> asks, waiting for your answer before kissing you.
						<<option 'CN'>>悉尼把神殿吊坠放到一旁。“<span class='teal'>这样可以吗？</span>”<<He>>等你回答，才吻了你。
					<</language>>
				<</if>>
		<</switch>>
		<<if _partner.id is 'Sydney'>>
			<<if _sydneyChastity and $sydneyChastityKnown>>
				<br><br><span class='teal'>
					<<lanSwitch "Your hand finds the familiar lock at Sydney's waist. Sydney leaves it there." '你的手碰到悉尼腰间熟悉的锁扣。悉尼没有移开你的手。'>>
				</span>
			<<elseif _sydneyChastity>>
				<br><br><span class='lewd'>
					<<lanSwitch "Your fingers brush a hard clasp beneath Sydney's clothes. Sydney catches your hand and waits for you to look up." '你的指尖隔着悉尼的衣服碰到一枚硬质搭扣。悉尼握住你的手，等你抬头看过来。'>>
				</span>
			<<elseif $sydneyChastityKnown>>
				<br><br><span class='teal'>
					<<lanSwitch "The lock you remember is gone. Sydney draws you closer." '你记得的锁扣已经不在了。悉尼把你拉近。'>>
				</span>
			<</if>>
		<</if>>
		<br><br>
	<</if>>
	<<effects>>
	<<effectsman>>
	<<man>>
	<<stateman>>
	<br><br>
	<<actionsman>>
	<<if _combatend or _controlRegain is 1>>
		<span id='next'><<lanLink '继续' 'Deadwood Reblooms Property Intimacy Finish'>><</lanLink>></span><<nexttext>>
	<<else>>
		<span id='next'><<lanLink '继续' 'Deadwood Reblooms Property Intimacy'>><</lanLink>></span><<nexttext>>
	<</if>>
<</if>>

:: Deadwood Reblooms Property Intimacy Finish []
<<set _partner to maplebirch.VP.realEstate.currentCompanion>>
<<run maplebirch.VP.realEstate.enter()>><<effects>>
<<if _partner>>
	<<if _partner.id is 'Sydney' and $enemyarousal gte $enemyarousalmax>>
		<<person1>><<run statusCheck('Sydney')>>
		<<ejaculation>>
		<<if _sydneyChastity and $sydneyChastityKnown>>
			<<sydneyChastityMessage>><<npcincr Sydney lust 3>><<ggslust>>
		<<else>>
			<<npcincr Sydney lust -20>><<lllslust>>
		<</if>>
		<<npcincr Sydney purity -2>><<lspurity>>
		<<npcincr Sydney love 1>><<glove>><<sydneyFinish>>
		<br><br>
		<<lanSwitch 'Sydney stays beside you and pulls the blanket back over the bed.' '悉尼仍挨着你，把毯子重新拉好。'>>
	<<else>>
		<<if $enemyarousal gte $enemyarousalmax>>
			<<ejaculation>>
			<<npcincr _partner.id lust -20>><<lllust>><br>
		<</if>>
		<<if $enemyhealth lte 0>>
			<<npcincr _partner.id love -1>><<llove>>
			<<language>>
				<<option 'EN'>>
					<<= _partner.id>> <span class='red'>pulls away</span>. You give <<him>> room to recover.
				<<option 'CN'>>
					<<= maplebirch.auto(_partner.id)>><span class='red'>躲开了</span>。你留出地方，让<<him>>缓一缓。
			<</language>>
		<<else>>
			<<npcincr _partner.id love 1>><<glove>>
			<<language>>
				<<option 'EN'>>
					<<switch _partner.id>>
						<<case 'Robin'>>
							Robin nestles against you beneath the covers. "<span class='green'>Can we stay here a little longer?</span>"
						<<case 'Whitney'>>
							Whitney catches your hand as you sit up. "Where are you going?" <<He>> <span class='green'>moves over to make room for you again</span>.
						<<case 'Kylar'>>
							Kylar stays close, <<his>> fingers curled around yours. "<span class='teal'>You really want me here?</span>"
						<<case 'Sydney'>>
							Sydney finds <<his>> pendant on the bedside table and leaves it there. "<span class='green'>The temple can wait until morning.</span>"
					<</switch>>
				<<option 'CN'>>
					<<switch _partner.id>>
						<<case 'Robin'>>
							罗宾缩进被窝，靠在你身边。“<span class='green'>我们能再躺一会儿吗？</span>”
						<<case 'Whitney'>>
							你坐起来时，惠特尼拉住你的手。“你要去哪儿？”<<He>><span class='green'>挪了挪，让你重新躺下</span>。
						<<case 'Kylar'>>
							凯拉尔挨着你，手指紧紧扣住你的手。“<span class='teal'>你真的愿意我住在这里？</span>”
						<<case 'Sydney'>>
							悉尼看了看床边的吊坠，没有去拿。“<span class='green'>神殿的事，明早再说吧。</span>”
					<</switch>>
			<</language>>
		<</if>>
	<</if>>
	<br><br>
<</if>>
<<clotheson>><<endcombat>>
<!-- 夜里从床上进入遭遇战时，脱下的睡前衣物仍留在这张床边。 -->
<<if Object.values($store).some(items => items.some(item => item.location === 'Deadwood Property Bed'))>>
	<<deadwood-reblooms-property-clothes-on>>
<</if>>
<<lanLink '返回卧室' 'Deadwood Reblooms Property Bedroom'>><</lanLink>>

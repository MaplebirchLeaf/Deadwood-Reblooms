:: Deadwood Coin Cave Combat Widgets [widget]

<<widget 'deadwood-coin-cave-combat-start'>>
  <<deadwood-coin-context>>
  <<if !_coinReady or $combat or $location isnot 'island' or _coinCave.room isnot 'writing' or _coinCave.guardian is 'cleared'>><<exit>><</if>>
  <<endevent>><<generateNPC 1 'a'>>
  <<set $NPCList[0].per to 'deadwood_coin_guard', $NPCList[0].skincolour to 'ghost', $NPCList[0].monster to 'monster', $NPCList[0].health to 250, $NPCList[0].healthmax to 250>>
  <<set $NPCList[0].role to lanSwitch('undead guard', '亡灵守卫'), $NPCList[0].fullDescription to lanSwitch('undead guard', '亡灵守卫')>>
  <<npcClothesType $NPCList[0] 'docker2'>>
  <<set $finish to 0, $consensual to 0>>
  <<person1>><<neutral 1>><<maninit>><<npcidlegenitals>>
  <<set $enemytrust to -30, $enemyanger to 40, $enemystrength to 16000, _coinCave.guardian to 'fight'>>
  <<if _coinCave.together and C.npc.Zephyr.init is 1 and C.npc.Zephyr.state is 'active'>><<companions-add `C.npc.Zephyr` 'deadwood-zephyr-support'>><</if>>
<</widget>>

<<widget 'deadwood-coin-cave-combat-end'>>
  <<deadwood-coin-context>>
  <<if !maplebirch.get('MoreTransformations') or !_coinCave or $possessed or $nextPassage or $nextPassageCheck or $location isnot 'island'
      or _coinCave.guardian isnot 'fight' or $combat isnot 1 or $NPCList[0]?.per isnot 'deadwood_coin_guard'>><<exit>><</if>>
  <<if $enemyhealth gt 0 and !maplebirch.combat.climax and !($alarm is 1 and $rescue gte 1) and $finish isnot 1 and !($pain gte 100 and $willpowerpain is 0)>><<exit>><</if>>
  <<if !$replayScene and !$statFreeze and !$frozenValues>>
    <<if $enemyhealth lte 0>>
      <<set _coinCave.guardian to 'cleared', _coinCave.room to 'vault', _coinCave.scene to 'won', _coinCave.shortcut to true>>
      <<set _coinCave.visited.pushUnique('vault')>>
    <<else>>
      <<set _coinCave.guardian to '', _coinCave.room to 'mouth', _coinCave.torch to 0, _coinCave.scene to 'retreated'>>
    <</if>>
  <</if>>
  <<clotheson>><<endcombat>>
<</widget>>

:: Deadwood Coin Cave Fight
<<deadwood-coin-context>>
<<if $nextPassage or $nextPassageCheck>>
  <span id='next'><<lanLink ['Next', '继续'] 'Deadwood Coin Cave Fight'>><</lanLink>></span><<nexttext>><<exit>>
<</if>>
<!-- 进行中的遭遇沿用原版附身与反抗流程，探索和开战仍检查 _coinReady。 -->
<<if !maplebirch.get('MoreTransformations') or !_coinCave or $location isnot 'island' or _coinCave.guardian isnot 'fight' or $combat isnot 1 or $NPCList[0]?.per isnot 'deadwood_coin_guard'>>
  <<lanSwitch 'The passage is out of reach just now.' '你现在无法进入那条通道。'>><br><br>
  <<getouticon>><<lanLink ['Return', '返回'] 'Deadwood Coin Cave'>><</lanLink>><<exit>>
<</if>>
<<set $outside to 0>>
<<lanSwitch 'The pale guard blocks the archway, staring at you. You plant your feet on the wet stone.' '苍白的守卫挡在拱门下，盯着你。你踩稳湿滑的石面，准备迎击。'>>
<br><br>
<<if _coinCave.together and maplebirch.combat.companions.get(C.npc.Zephyr)?.active>>
<<lanSwitch 'Zephyr draws a knife and moves beside you. "Watch its hands. We get past it together."' '泽菲尔拔出刀，挪到你身旁。“盯住它的手。咱们一起过去。”'>>
<br><br>
<<elseif _coinCave.together>>
<<lanSwitch 'Zephyr waits behind the broken pillar, keeping the way back in sight.' '泽菲尔留在断柱后，盯着来时的通道。'>>
<br><br><</if>>
<<effects>><<deadwood-coin-context>>
<<if $nextPassage or $nextPassageCheck>>
  <span id='next'><<lanLink ['Next', '继续'] 'Deadwood Coin Cave Fight'>><</lanLink>></span><<nexttext>><<exit>>
<</if>>
<<if _coinCave.guardian is 'fight' and $combat is 1 and $NPCList[0]?.per is 'deadwood_coin_guard'>>
  <<effectsman>><<alarmstate>><<man>><<stateman>><br><br><<actionsman>>
  <<if $nextPassage or $nextPassageCheck>>
    <span id='next'><<lanLink ['Next', '继续'] 'Deadwood Coin Cave Fight'>><</lanLink>></span><<nexttext>>
  <<elseif !$possessed and (_combatend or $enemyhealth lte 0 or maplebirch.combat.climax or ($alarm is 1 and $rescue gte 1) or $finish is 1 or ($pain gte 100 and $willpowerpain is 0))>>
    <span id='next'><<lanLink ['Next', '继续'] 'Deadwood Coin Cave'>><<deadwood-coin-cave-combat-end>><</lanLink>></span><<nexttext>>
  <<else>>
    <span id='next'><<lanLink ['Next', '继续'] 'Deadwood Coin Cave Fight'>><</lanLink>></span><<nexttext>>
  <</if>>
<</if>>

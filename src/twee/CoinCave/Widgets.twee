:: Deadwood Coin Cave Widgets [widget]

<<widget 'deadwood-coin-context'>>
  <<set _coinCave to $MoreTransformations?.treasure>>
  <<set _coinReady to !!maplebirch.get('MoreTransformations') and !!_coinCave and !$replayScene and !$statFreeze and !$frozenValues and !$possessed and !$nextPassage and !$nextPassageCheck>>
<</widget>>

<<widget 'deadwood-coin-cave-discover'>>
  <<deadwood-coin-context>><<set _coinDiscovered to false>>
  <<if !_coinReady or $combat or _coinCave.found or $location isnot 'island' or $island.explore_count lt 6 or !$island.explore_locations.includes('shore')>><<exit>><</if>>
  <<set _coinCave.found to true, _coinDiscovered to true>>
  <<language>>
    <<option 'EN'>>
      You follow the shore beneath the cliff and find steps cut into the rock. Roots and hanging moss cover the way down. You push them aside. An iron mooring ring, pitted with rust, is set into the wall. Boats must once have landed here.
      <br><br>
      Firelight flickers at the foot of the steps, but you hear no voices. You mark the rocks along the way back to camp.
    <<option 'CN'>>
      你沿着海崖下的岸边走，发现岩壁上凿着几级台阶。拨开垂下的藤蔓和树根，一段陡阶通向崖壁深处。墙上嵌着一只锈蚀的系船铁环，以前应该有船在这里靠岸。
      <br><br>
      石阶下方隐约有火光，却听不见人声。你在沿途岩石上刻下记号，标出回营地的路。
  <</language>><br><br>
  <span class='gold'><<lanSwitch 'You have found a secluded sea cavern.' '你发现了一处隐蔽的海蚀石窟。'>></span><br><br>
  <<deadwood-coin-cave-link>>
  <<getouticon>><<lanLink ['Return to camp', '回到营地'] 'Island'>><<island_explore_end>><</lanLink>><br>
<</widget>>

<<widget 'deadwood-coin-cave-link'>>
  <<deadwood-coin-context>>
  <<if !_coinReady or $combat or !_coinCave.found or $location isnot 'island' or $stress gte $stressmax or $hunger gte 2000>><<exit>><</if>>
  <<icon 'coin-cave/old-cavern.png'>><<lanLink ['Walk to the old cavern (0:20)', '前往旧洞窟 (0:20)'] 'Deadwood Coin Cave'>>
    <<deadwood-coin-context>>
    <<if _coinReady and !$combat and $location is 'island'>>
      <<set _coinCave.room to 'mouth', _coinCave.scene to '', _coinCave.voyage to false, _coinCave.together to false>>
      <<island_pass 20>>
    <</if>>
  <</lanLink>><br>
<</widget>>

<<widget 'deadwood-coin-cave-time'>>
  <<set $MoreTransformations.treasure.torch to Math.max(0, $MoreTransformations.treasure.torch - _args[0])>>
  <<island_pass _args[0]>>
<</widget>>

<<widget 'deadwood-coin-cave-move'>>
  <<deadwood-coin-context>>
  <<if !_coinReady or $combat or $location isnot 'island' or !_coinCave.found or !['mouth', 'passage', 'camp', 'water', 'writing', 'vault'].includes(_args[0])>><<exit>><</if>>
  <<set _coinCave.room to _args[0], _coinCave.scene to ''>>
  <<if !['mouth', 'vault'].includes(_args[0])>>
    <<set $_caveRoll to random(1, 8)>>
    <<if $_caveRoll is 1>>
      <<set _coinCave.torch to Math.max(0, _coinCave.torch - 10), _coinCave.scene to 'wind'>>
    <<elseif $_caveRoll is 2>>
      <<if random(1, 100) lte _coinCave.torch + currentSkillValue('skulduggery') / 25>>
        <<set _coinCave.scene to 'trap_seen'>>
      <<else>>
        <<set _coinCave.scene to 'trip'>><<pain 4>><<stress 6>>
      <</if>>
    <<elseif $_caveRoll is 3>>
      <<set _coinCave.scene to 'whispers'>><<stress 2>>
      <<run maplebirch.get('Psyche')?.change(0, _coinCave.torch lt 20 ? 80 : 40)>>
    <<elseif $_caveRoll is 4>>
      <<set _coinCave.scene to _coinCave.together ? 'captain' : 'tracks'>>
    <</if>>
  <</if>>
  <<set _coinCave.visited.pushUnique(_args[0])>>
  <<if _args[0] is 'vault' and _coinCave.guardian is 'cleared'>><<set _coinCave.shortcut to true>><</if>>
  <<deadwood-coin-cave-time _args[1]>>
<</widget>>

<<widget 'deadwood-coin-cave-route'>>
  <<set $_caveRoute to _args[1], $_caveMinutes to _args[2]>>
  <<capture $_caveRoute, $_caveMinutes>><<caveicon 'east'>><<lanLink `_args[0]` 'Deadwood Coin Cave'>><<deadwood-coin-cave-move $_caveRoute $_caveMinutes>><</lanLink>><</capture>><br>
<</widget>>

<<widget 'deadwood-coin-take'>>
  <<deadwood-coin-context>>
  <<if !_coinReady or $combat or $location isnot 'island' or _coinCave.room isnot 'vault' or _coinCave.guardian isnot 'cleared' or pcAreArmsBound('both')>><<exit>><</if>>
  <<if ![1, 3].includes(_args[0])>><<exit>><</if>>
  <<set $_coinShared to _coinCave.together and !_coinCave.bound and _coinCave.returns is 0 and !(_coinCave.journal or _coinCave.inscription or _coinCave.appraised)>>
  <<set $_coinAmount to Math.min(_args[0], 882 - _coinCave.coins - _coinCave.zephyrCoins - _coinCave.museumCoins - _coinCave.crewCoins - ($_coinShared ? 3 : 0))>>
  <<if $_coinAmount lte 0>><<exit>><</if>>
  <<if !_coinCave.bound and _coinCave.returns is 0>><<run maplebirch.get('Psyche')?.change(-150, 350)>><</if>>
  <<set _coinCave.coins += $_coinAmount, _coinCave.scene to _coinCave.bound ? 'more_gold' : 'first_gold', _coinCave.bound to true>>
  <<if $_coinShared>>
    <<set _coinCave.zephyrCoins to 3, _coinCave.agreed to false>>
    <<run maplebirch.npc.Transformation.set('Zephyr', 'undead', 1)>>
  <</if>>
  <<run maplebirch.char.transformation.setTransform('undead', 1)>>
<</widget>>

<<widget 'deadwood-coin-return'>>
  <<deadwood-coin-context>>
  <<if !_coinReady or $combat or $location isnot 'island' or _coinCave.room isnot 'vault' or _coinCave.guardian isnot 'cleared' or !_coinCave.bound or pcAreArmsBound('both')>><<exit>><</if>>
  <<set _coinCave.coins to 0, _coinCave.scene to 'part_returned'>>
  <<if _coinCave.together and _coinCave.agreed>><<set _coinCave.zephyrCoins to 0>><</if>>
  <<if _coinCave.coins + _coinCave.zephyrCoins + _coinCave.museumCoins + _coinCave.crewCoins is 0>>
    <<if _coinCave.returns is 0>><<stress -12>><<run maplebirch.get('Psyche')?.change(100, -350)>><</if>>
    <<set _coinCave.bound to false, _coinCave.agreed to false, _coinCave.returns += 1, _coinCave.scene to maplebirch.npc.Transformation.level('Zephyr', 'undead') gt 0 ? 'cured_together' : 'cured'>>
    <<run maplebirch.char.transformation.setTransform('undead', 0)>>
    <<run maplebirch.npc.Transformation.set('Zephyr', 'undead', 0)>>
  <</if>>
  <<deadwood-coin-cave-time 5>>
<</widget>>

<!-- 三种读法共用证据转换，完成用时后再结算，旧线索不因重新进洞重复生效。 -->
<<widget 'deadwood-coin-read'>>
  <<set $_coinEvidence to _args[0], $_coinReading to _args[1]>>
  <<deadwood-coin-context>>
  <<if !_coinReady or $combat or $location isnot 'island' or !['journal', 'inscription'].includes($_coinEvidence) or !['plain', 'careful', 'deep'].includes($_coinReading)
    or _coinCave[$_coinEvidence] or _coinCave.room isnot ($_coinEvidence is 'journal' ? 'camp' : 'writing') or _coinCave.torch lt 20>><<exit>><</if>>
  <<set $_coinPsyche to maplebirch.get('Psyche'), $_coinRoom to _coinCave.room>>
  <<if $_coinReading isnot 'plain' and !$_coinPsyche?.active>><<exit>><</if>>
  <<if $_coinReading is 'careful' and $_coinPsyche.state.sanity lt 600>><<exit>><</if>>
  <<set $_coinSanity to $_coinReading is 'deep' ? -100 : -30, $_coinFear to $_coinReading is 'deep' ? 150 : 60>>
  <<if $_coinReading is 'careful'>>
    <<if $_coinPsyche.state.sanity gte 900>>
      <<set $_coinSanity to -15, $_coinFear to 30>>
    <<else>>
      <<willpowerdifficulty 400 400 'silent'>>
      <<if $willpowerSuccess>><<set $_coinSanity to -15, $_coinFear to 30>><</if>>
    <</if>>
  <</if>>
  <<deadwood-coin-cave-time `$_coinReading is 'careful' ? 20 : 10`>>
  <<deadwood-coin-context>>
  <<if !_coinReady or $combat or $location isnot 'island' or _coinCave.room isnot $_coinRoom or _coinCave[$_coinEvidence]>><<exit>><</if>>
  <<set _coinCave[$_coinEvidence] to true, _coinCave.scene to ($_coinEvidence is 'journal' ? 'notes' : 'writing') + ($_coinReading is 'deep' ? '_deep' : $_coinSanity is -15 ? '_careful' : '')>>
  <!-- 异常读法的线索沿用探索记录，普通读法仍可完成整个调查。 -->
  <<if $_coinReading is 'deep'>>
    <<run _coinCave.visited.pushUnique($_coinEvidence + '_deep')>>
    <<if $_coinEvidence is 'journal'>><<set _coinCave.shortcut to true>><</if>>
  <</if>>
  <<if $_coinEvidence is 'inscription' and currentSkillValue('history') gte 500>><<set _coinCave.shortcut to true>><</if>>
  <<run maplebirch.get('Psyche')?.change($_coinSanity, $_coinFear)>>
  <<if _coinCave.journal and _coinCave.inscription and !_coinCave.visited.includes('understood')>>
    <<run _coinCave.visited.pushUnique('understood')>>
    <<run maplebirch.get('Psyche')?.change(40, -100)>>
  <</if>>
<</widget>>

<<widget 'deadwood-coin-journal'>>
  <<if !maplebirch.get('MoreTransformations') or !$MoreTransformations?.treasure?.found>><<exit>><</if>>
  <<set _coinCave to $MoreTransformations.treasure>>
  <<if _coinCave.returns gt 0 and !_coinCave.bound and !_coinCave.voyage>><<exit>><</if>>
  <div class='gold bold'><<lanSwitch 'The island gold' '海岛藏金'>></div>
  <ul class='journal'>
    <<if _coinCave.shortcut and !_coinCave.visited.includes('vault')>>
      <li><<lanSwitch 'You found a dry passage from the entrance to the carved arch. It avoids the flooded crossing.' '你找到了洞口通往石刻拱门的干路，可以绕过积水。'>></li>
    <</if>>
    <<if _coinCave.visited.includes('inscription_deep') and _coinCave.guardian isnot 'cleared'>>
      <li><<lanSwitch 'The carved figures approach with open hands. The guard may recognise the same gesture.' '石刻中的人影摊着双手走向石箱。守卫也许还认得这个手势。'>></li>
    <</if>>
    <<if !_coinCave.visited.includes('vault')>>
      <li><<lanSwitch 'You marked the way from camp to the cavern. Firelight flickers inside. Earlier visitors may have left clues among the passages and old bunks.' '你记下了营地通往石窟的路。里面有火光，可以沿通道和旧铺位找找前人留下的东西。'>></li>
    <<elseif !_coinCave.bound and !_coinCave.returns>>
      <li>
        <<if _coinCave.inscription or _coinCave.journal or _coinCave.appraised>>
          <<lanSwitch 'The stone chest is full of old gold coins. The accounts warn that every coin taken must be returned.' '石箱里装满了古金币。你查到的记载警告来者，取走的金币必须全数归还。'>>
        <<else>>
          <<lanSwitch 'You found a stone chest full of old gold coins. The old bunks and carvings nearby may tell you who left them here.' '你发现了一只装满古金币的石箱。附近的旧铺位和石刻，也许能说明是谁留下了它们。'>>
        <</if>>
      </li>
    <</if>>
    <<if _coinCave.voyage and !_coinCave.together>>
      <li><<lanSwitch 'You arranged an island expedition with Zephyr. Follow the voyage aboard ship; the captain will point out your landing on arrival.' '你与泽菲尔约好前往海岛。航程中先在船上等候，抵达时船长会指出留有记号的登陆点。'>></li>
    <</if>>
    <<if _coinCave.bound>>
      <li><<lanSwitch 'Coins in your possession: ' '你持有的金币：'>><span class='gold'><<= _coinCave.coins>></span>
        <<if _coinCave.museumCoins gt 0>><br><<lanSwitch 'On loan to Winter: ' '借展给温特的金币：'>><span class='gold'><<= _coinCave.museumCoins>></span><</if>>
        <<if _coinCave.zephyrCoins gt 0>><br><<lanSwitch 'Zephyr\'s share: ' '泽菲尔持有的金币：'>><span class='gold'><<= _coinCave.zephyrCoins>></span><</if>>
        <<if _coinCave.crewCoins gt 0>><br><<lanSwitch 'Distributed to crew: ' '分到船员手中的金币：'>><span class='gold'><<= _coinCave.crewCoins>></span><</if>>
      </li>
      <li>
        <<if _coinCave.inscription or _coinCave.journal or _coinCave.appraised>>
          <<lanSwitch 'Every coin taken from the vault must be returned to the stone coffer. Parting with them or leaving them elsewhere will not lift the curse.' '所有被带离石室的金币都必须全数放回石箱。遗落在外或转交他人，都无法破除亡灵诅咒。'>>
        <<else>>
          <<lanSwitch 'Your pulse ceased the moment you took the gold. Search the cavern for clues about the curse, or take a coin to Winter at the museum.' '取走金币后，你的心跳彻底止息了。可以返回石窟寻找碑记线索，或带一枚金币请温特鉴定。'>>
        <</if>>
      </li>
      <<if _coinCave.zephyrCoins gt 0>>
        <li><<if _coinCave.agreed>><<lanSwitch 'Zephyr has agreed to return the captain\'s entire share. Speak with the captain to arrange a voyage back to the cavern.' '泽菲尔已答应将金币全数带回。只要找船长安排航程，便可一同前往石窟了结此事。'>>
        <<else>><<lanSwitch 'Zephyr still retains <<his>> cut of the plunder. Speak with the captain aboard ship or at the smugglers\' pub to demand its return.' '泽菲尔手中仍留有分得的金币。必须在船上或走私者酒馆与船长商议归还。'>><</if>></li>
      <</if>>
      <<if _coinCave.museumCoins gt 0>><li><<lanSwitch 'Collect all loaned coins from Winter before making the voyage back to the cavern.' '返回石窟前，需要先向温特取回借展的那些金币。'>></li><</if>>
      <<if _coinCave.crewCoins gt 0>><li><<lanSwitch 'Zephyr gave two coins to the sailors who rowed the boat. Ask the captain to collect them before returning the gold.' '泽菲尔给划船的水手分了两枚金币。归还前，还得请船长将它们收回来。'>></li><</if>>
    <<elseif _coinCave.returns gt 0>>
      <li class='green'><<lanSwitch 'The stolen gold is back in its chest. The cold grip has faded, and your heartbeat has returned.' '所有取走的金币均已归位。石箱重阖，温热的心跳终于重新回到了你的胸膛。'>></li>
    <</if>>
  </ul><hr>
<</widget>>

<<widget 'deadwood-coin-voyage-cancel'>>
  <<deadwood-coin-context>>
  <<if _coinReady and !$combat and _coinCave.voyage and !_coinCave.together>>
    <<set _coinCave.voyage to false>>
  <</if>>
<</widget>>

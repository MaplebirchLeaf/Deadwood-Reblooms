:: Deadwood Reblooms Orchard Widgets [widget]
<<widget 'deadwood-orchard-entry'>>
  <<set _orchardSite to _args[0]>>
  <<capture _orchardSite>>
    <<if maplebirch.get('Orchard') and $stress lt $stressmax and (_orchardSite isnot 'farm' or !maplebirch.get('Orchard').farmInterrupted)>>
      <<if maplebirch.get('Orchard').ready(_orchardSite)>>
        <<set _orchardOpeningLabel to _orchardSite is 'farm' ? ['Find Alex to talk about fruit trees', '去找艾利克斯商量种果树'] : ['Follow the monk beyond the flower beds', '跟随神殿成员走到花圃后面']>>
        <<icon 'orchard/orchard.png'>><<lanLink _orchardOpeningLabel 'Deadwood Reblooms Orchard Opening'>>
          <<set $Orchard.site to _orchardSite>>
        <</lanLink>><br>
      <<elseif maplebirch.get('Orchard').available(_orchardSite) and $exposed lte 0>>
        <<icon 'orchard/orchard.png'>><<lanLink ['Orchard (0:02)', '果园 (0:02)'] 'Deadwood Reblooms Orchard'>>
          <<set $Orchard.site to _orchardSite>><<pass 2>>
        <</lanLink>><br>
      <</if>>
    <</if>>
  <</capture>>
<</widget>>

<<widget 'deadwood-orchard-event-return'>>
  <<set $_orchard to maplebirch.get('Orchard')>>
  <<set $_returnTo to $_orchard and $_orchard.available('farm') and !$_orchard.farmInterrupted ? 'Deadwood Reblooms Orchard' : 'Farm Fields'>>
  <<lanLink ['Next', '继续'] $_returnTo>>
    <<endevent>><<set $eventskip to 1>>
  <</lanLink>><br>
<</widget>>

<<widget 'deadwood-orchard-worker-recruitment'>>
  <<set $_pub_menu to document.querySelector('#passage-content .macro-link[data-passage="Harvest Street"]')>>
  <<if !$_pub_menu>>
    <<exit>>
  <</if>>
  <<deadwood-orchard-trapper-recruitment>>
  <<set $_orchard to maplebirch.get('Orchard')>>
  <!-- 普通酒馆菜单才招聘，先结束菜单里的随机 NPC，避免占用同一个人物槽。 -->
  <<if $_orchard and $_orchard.available('farm') and !$_orchard.state.worker.hired and $exposed lte 0 and $stress lt $stressmax and !pcAreArmsBound('both')>>
    <<icon 'orchard/worker.png'>><<lanLink ['Look for help for your orchard (0:30)', '寻找果园雇工 (0:30)'] 'Deadwood Reblooms Orchard Hire'>>
      <<endevent>><<pass 30>>
    <</lanLink>><br>
  <</if>>
<</widget>>

<<widget 'deadwood-orchard-worker-task'>>
  <<set $_orchard to maplebirch.get('Orchard')>>
  <<run $_orchard.advance()>>
  <<if !$_orchard.state.worker.hired or !$_orchard.available('farm') or !['auto_renew', 'haul', 'pick', 'fertilise'].includes(_args[0]) or typeof _args[1] isnot 'boolean'>>
    <<exit>>
  <</if>>
  <<if _args[1] and ['auto_renew', 'haul'].includes(_args[0]) and (!maplebirch.get('Finance') or !$Finance?.bank.debit_card)>>
    <<exit>>
  <</if>>
  <<if _args[0] is 'haul' and _args[1] and (maplebirch.passage.title isnot 'Deadwood Reblooms Orchard Delivery' or !$_orchard.carrier)>>
    <<exit>>
  <</if>>
  <<set $_orchard.state.worker[_args[0]] to _args[1]>>
<</widget>>

<<widget 'deadwood-orchard-worker'>>
  <<set $_orchard to maplebirch.get('Orchard')>>
  <<if !$_orchard or $Orchard.site isnot 'farm' or !$_orchard.available('farm')>>
    <<exit>>
  <</if>>
  <br>
  <<if $_orchard.irrigated>>
    <<gardenicon 'water'>><span class='green'><<lanSwitch 'The farm irrigation keeps the fruit trees watered.' '农场的灌溉系统为果树补足水分。'>></span><br>
  <</if>>
  <<if $_orchard.state.worker.quit_day gte 0>>
    <span class='red'>
      <<language>>
        <<option 'EN'>>
          <<print $_orchard.state.worker.quit_name>> left after a week without renewed wages. The trees need tending again.
        <<option 'CN'>>
          续薪中断一周后，<<print $_orchard.state.worker.quit_name>>已经辞职。果树又需要有人照料了。
      <</language>>
    </span><br>
  <</if>>
  <<if $_orchard.state.worker.hired>>
    <<set $_worker to $_orchard.state.worker>>
    <<if $per_npc.deadwood_orchard_worker>>
      <<print $per_npc.deadwood_orchard_worker.name>><<lanSwitch ' looks after your orchard.' '受雇照料你的果园。'>><br>
    <</if>>
    <<if $_orchard.workerActive>>
      <<set $_paidUntil to new DateTime($_worker.paid_until)>>
      <<lanSwitch 'Paid until ' '薪资已预付至 '>><span class='gold'><<print getFormattedDate($_paidUntil)>></span> <<ampm $_paidUntil.hour $_paidUntil.minute>><<lanSwitch '.' '。'>><br>
    <<else>>
      <span class='red'><<lanSwitch 'The paid week has ended. Your worker waits seven days for renewed wages, then leaves.' '预付的薪期已经结束。雇工暂停工作，七天内仍未续薪就会辞职。'>></span><br>
    <</if>>
    <<if $_worker.pick>>
      <<lanSwitch 'Waters trees when the soil dries and picks ripe fruit.' '土壤干燥时浇水，并采收成熟水果。'>><br>
      <<icon 'orchard/harvest.png'>><<lanLink ['Leave the picking to me', '让我自己采收']>>
        <<deadwood-orchard-worker-task 'pick' `false`>>
        <<replace '#deadwood-orchard-worker'>><<deadwood-orchard-worker>><</replace>>
      <</lanLink>><br>
    <<else>>
      <<lanSwitch 'Waters trees when the soil dries. Leaves the fruit for you.' '土壤干燥时浇水，把水果留给你采收。'>><br>
      <<icon 'orchard/harvest.png'>><<lanLink ['Ask the worker to pick ripe fruit too', '也让雇工采收成熟水果']>>
        <<deadwood-orchard-worker-task 'pick' `true`>>
        <<replace '#deadwood-orchard-worker'>><<deadwood-orchard-worker>><</replace>>
      <</lanLink>><br>
    <</if>>
    <<if $_worker.fertilise>>
      <<lanSwitch 'Uses your fertiliser when the previous application wears off.' '肥效耗尽后，使用你现有的肥料补肥。'>><br>
      <<gardenicon 'fertiliser'>><<lanLink ['Leave fertilising to me', '让我自己施肥']>>
        <<deadwood-orchard-worker-task 'fertilise' `false`>>
        <<replace '#deadwood-orchard-worker'>><<deadwood-orchard-worker>><</replace>>
      <</lanLink>><br>
    <<else>>
      <<gardenicon 'fertiliser'>><<lanLink ['Allow the worker to use your fertiliser', '允许雇工使用你的肥料']>>
        <<deadwood-orchard-worker-task 'fertilise' `true`>>
        <<replace '#deadwood-orchard-worker'>><<deadwood-orchard-worker>><</replace>>
      <</lanLink>><br>
    <</if>>
    <<if maplebirch.get('Finance') and $Finance.bank.debit_card>>
      <<language>>
        <<option 'EN'>>Your worker can collect <span class='gold'>another week's wages from your bank</span> when the paid period ends. You can also hire a delivery worker to take spare fruit with the morning load. Each load costs <<printmoney $_orchard.deliveryFee>>. Reserved fruit and pending orders stay here; attacks stop work and transport.
        <<option 'CN'>>薪期结束后，雇工可以<span class='gold'>从银行领取下一周的薪资</span>。你也可以另请送货工，把多余水果带上早班货车。每趟收<<printmoney $_orchard.deliveryFee>>运费，保留库存和已接订单的水果留下。农场遇袭时停止照料和运输。
      <</language>><br>
    <<elseif $_worker.auto_renew or $_worker.haul>>
      <span class='red'><<lanSwitch 'Bank instructions are suspended without a debit card.' '没有可用借记卡，银行续薪与运输安排暂停。'>></span><br>
    <</if>>
    <<if $_worker.auto_renew or (maplebirch.get('Finance') and $Finance.bank.debit_card)>>
      <<lanLink `$_worker.auto_renew ? ['Stop automatic wage renewal', '停止自动续薪'] : ['Renew wages automatically', '自动续付薪资']`>>
        <<deadwood-orchard-worker-task 'auto_renew' `!maplebirch.get('Orchard').state.worker.auto_renew`>>
        <<replace '#deadwood-orchard-worker'>><<deadwood-orchard-worker>><</replace>>
      <</lanLink>><br>
    <</if>>
    <<if $_worker.haul>>
      <<if $_orchard.carrier>>
        <span class='gold'><<print $_orchard.carrier.name>></span><<lanSwitch ' takes spare fruit with the morning load.' '负责早班运输多余水果。'>><br>
      <<else>>
        <span class='red'><<lanSwitch 'The delivery worker is unavailable. Fruit stays in storage.' '送货工不在，水果留在仓库。'>></span><br>
      <</if>>
      <<lanLink ['Stop morning deliveries', '停止早班运输']>>
        <<deadwood-orchard-worker-task 'haul' `false`>>
        <<replace '#deadwood-orchard-worker'>><<deadwood-orchard-worker>><</replace>>
      <</lanLink>><br>
    <</if>>
    <<if (maplebirch.get('Finance') and $Finance.bank.debit_card) and $_orchard.canWork and !$_orchard.farmInterrupted and !$farm_assault>>
      <<icon 'orchard/delivery.png'>><<lanLink `$_orchard.carrier ? ['Talk to the delivery worker', '与送货工谈谈'] : ['Look for a delivery worker', '找一位送货工']` 'Deadwood Reblooms Orchard Delivery'>><</lanLink>><br>
    <</if>>
    <<set $_report to $_orchard.workerReport>>
    <<if $_report>>
      <<set $_shiftDate to new DateTime($_report.day * 86400 + 8 * 3600)>>
      <<if $_report.day is Math.floor(Time.date.timeStamp / 86400)>>
        <<lanSwitch "Today's work: " '今日照料：'>>
      <<else>>
        <<lanSwitch 'Last shift: ' '最近一次照料：'>>
      <</if>>
      <<print getFormattedDate($_shiftDate)>><<lanSwitch '.' '。'>><<lanSwitch ' Trees watered: ' ' 浇灌果树：'>><span class='green'><<print $_report.watered>></span><<lanSwitch '.' '。'>><br>
      <<if $_report.renewal_failed>>
        <span class='red'><<lanSwitch 'Wages could not be renewed. No work was done.' '未能续付薪资，本次停工。'>></span><br>
      <</if>>
      <<if $_report.delivered gt 0>>
        <<lanSwitch 'Fruit sent / bank payment after transport: ' '运输水果／扣除运费后到账：'>><span class='green'><<= $_report.delivered>></span> / <span class='gold'><<printmoney $_report.income>></span><br>
      <</if>>
      <<if $_report.fertilised gt 0>>
        <<lanSwitch 'Bags of fertiliser used: ' '使用肥料：'>><span class='green'><<print $_report.fertilised>></span><<lanSwitch '.' ' 袋。'>><br>
      <</if>>
      <<if $_report.no_fertiliser>>
        <span class='gold'><<lanSwitch 'Fertiliser ran out before every tree could be tended.' '肥料已经用完，有些树还没补肥。'>></span><br>
      <</if>>
      <<if Object.values($_report.kept).some(amount => amount gt 0)>>
        <<lanSwitch 'Fruit put away: ' '收好的水果：'>><<deadwood-orchard-worker-harvest>><br>
      <<else>>
        <<lanSwitch 'No fruit picked.' '没有采收水果。'>><br>
      <</if>>
      <<if $_report.irrigation>>
        <<lanSwitch 'Irrigation supplied the fruit trees during that shift.' '这一班由灌溉系统为果树供水。'>><br>
      <<elseif $_report.rain>>
        <<lanSwitch 'Rain watered the fruit trees during that shift.' '这一班的雨水已经浇透果树。'>><br>
      <</if>>
    <</if>>
    <<if $_orchard.canTalkWorker>>
      <<socialiseicon 'ask'>><<lanLink ['Ask your worker about the orchard (0:05)', '问问雇工果园的情况 (0:05)'] 'Deadwood Reblooms Orchard Worker Report'>><</lanLink>><br>
    <</if>>
    <<if $_orchard.canPayWorker>>
      <<shopicon 'register'>><<lanLink ['Pay for another week', '预付下一周薪资']>>
        <<run maplebirch.get('Orchard').payWorker()>>
        <<updatesidebarmoney>>
        <<replace '#deadwood-orchard-worker'>><<deadwood-orchard-worker>><</replace>>
      <</lanLink>> (<<printmoney $_orchard.workerWage>>)<br>
    <<elseif $money lt $_orchard.workerWage>>
      <span class='red'><<lanSwitch 'You cannot afford another week.' '你付不起下一周的薪资。'>></span> (<<printmoney $_orchard.workerWage>>)<br>
    <</if>>
    <<icon 'orchard/worker.png'>><<lanLink ['Dismiss your orchard worker', '辞退果园雇工'] 'Deadwood Reblooms Orchard Dismiss'>><</lanLink>><br>
  <<else>>
    <<lanSwitch 'You could look for someone to help with the orchard at the pub.' '你可以去酒馆找人帮忙照料果园。'>><br>
  <</if>>
<</widget>>

:: Deadwood Reblooms Orchard Opening []
<<if !maplebirch.get('Orchard')>>
  <<getouticon>>
  <<if $Orchard.site is 'farm'>>
    <<lanLink ['Return to the fields', '返回田地'] 'Farm Fields'>><</lanLink>>
  <<else>>
    <<lanLink ['Return to the garden', '返回花园'] 'Temple Garden'>><</lanLink>>
  <</if>><<exit>>
<</if>>
<<set $outside to 1>>
<<if $Orchard.site is 'temple'>>
  <<set $location to 'temple'>><<temple_effects>>
<<else>>
  <<set $location to 'alex_farm'>><<set $bus to 'farm_fields'>><<farm_work_update>>
<</if>><<effects>>
<<if $stress gte $stressmax>>
  <<if $Orchard.site is 'farm'>>
    <<passoutfarmroad>>
  <<else>>
    <<passouttemple>>
  <</if>>
  <<exit>>
<<elseif $Orchard.site is 'farm' and maplebirch.get('Orchard').farmInterrupted>>
  <<getouticon>><<lanLink ['Return to the fields', '返回田地'] 'Farm Fields'>><</lanLink>><<exit>>
<</if>>
<<if maplebirch.get('Orchard').ready($Orchard.site)>>
  <<language>>
    <<option 'EN'>>
      <<if $Orchard.site is 'temple'>>
        A <<monk>> pauses by the last hedge you trimmed. "You have done well here. Come along. There is another part of the garden you should see."
        <br><br>
        You follow a narrow path behind the flower beds. A gap in the hedge reveals a sheltered strip of earth. The <<monk>> lifts a loose branch away from the path.
        <br><br>
        "We used to grow more fruit here. A plum tree still grows here, and the kitchen could use more. You may plant some trees, if you are willing to look after them. Leave a share of the harvest for the others."
        <br><br>
        The <<monk>> points to the ground beside the path. "We can prepare these plots first. You will have to work your way through the old roots beyond them. Take your time."
      <<else>>
        <<npc Alex>><<person1>>
        You find Alex in the farmhouse, sorting a stack of papers. <<He>> looks up when you mention the unused ground beside the fields. "All that ground, and we finally got it cleared." <<He>> sets the papers aside. "Might be nice to grow something we don't have to plant again after every harvest."
        <br><br>
        You head outside together. <<He>> leads you along the hedgerow and pushes a fallen branch aside with <<his>> boot. "Fruit trees would fit here. The hedge should keep the worst of the wind off. Takes longer than potatoes, though."
        <br><br>
        Alex looks back at you. "Want to give it a go? We could start by getting this patch ready." <<He>> nudges a clump of weeds with <<his>> boot. "Plenty of roots further along. Best do a bit at a time."
      <</if>>
    <<option 'CN'>>
      <<if $Orchard.site is 'temple'>>
        一位<<monk>>在你刚修整好的树篱旁停下。“这里做得不错。跟我来，花园还有一处地方，你也该看看。”
        <br><br>
        你沿着花圃后面的小路跟过去。树篱的缺口后露出一条避风的土地。<<monk>>把横在路上的枝条挪到一边。
        <br><br>
        “以前这里种过不少果树，现在还留着一棵李子树，厨房也用得上。你愿意照料的话，可以在这里再栽几棵。收成记得给其他人留一份。”
        <br><br>
        <<monk>>指向小路旁的土地。“我们先整理这几块。后面还有不少旧根，你得一点点清过去。不用着急。”
      <<else>>
        <<npc Alex>><<person1>>
        你在农舍里找到正在整理账单的艾利克斯。你提起田地边空着的土地，<<he>>抬起头。“这么多地，总算都清出来了。”<<He>>放下账单。“也许可以种点不用收一回就重种一回的东西。”
        <br><br>
        你们一起走出农舍。<<He>>带你沿着树篱走，用靴子拨开一根落枝。“这里能种果树。树篱挡着，风也不至于太大。不过，比土豆费时间。”
        <br><br>
        艾利克斯回头看你。“想试试吗？先把这块地方拾掇好。”<<He>>用靴子碰了碰一丛杂草。“后面草根多，一次弄一点就行。”
      <</if>>
  <</language>><br><br>
  <<icon 'dig.png'>><<lanLink ['Help prepare the ground (1:00)', '一起整理土地 (1:00)'] 'Deadwood Reblooms Orchard'>>
    <<if maplebirch.get('Orchard').unlock($Orchard.site)>>
      <<if $Orchard.site is 'farm'>>
        <<farm_count 60>>
      <</if>>
      <<physique 6>><<tiredness 6>><<pass 60>>
    <</if>>
  <</lanLink>><<ggtiredness>><br>
<</if>>
<<getouticon>>
<<if $Orchard.site is 'farm'>>
  <<lanLink ['Return to the fields', '返回田地'] 'Farm Fields'>><</lanLink>>
<<else>>
  <<lanLink ['Return to the garden', '返回花园'] 'Temple Garden'>><</lanLink>>
<</if>>

:: Deadwood Reblooms Orchard []
<<if !maplebirch.get('Orchard')>>
  <<getouticon>>
  <<if $Orchard.site is 'farm'>>
    <<lanLink ['Return to the fields', '返回田地'] 'Farm Fields'>><</lanLink>>
  <<else>>
    <<lanLink ['Return to the garden', '返回花园'] 'Temple Garden'>><</lanLink>>
  <</if>><<exit>>
<</if>>
<<set $outside to 1>>
<<if $Orchard.site is 'farm'>>
  <<set $location to 'alex_farm'>><<set $bus to 'farm_fields'>><<farm_work_update>>
<<else>>
  <<set $location to 'temple'>><<temple_effects>>
<</if>>
<<effects>>
<<if $stress gte $stressmax>>
  <<if $Orchard.site is 'farm'>>
    <<passoutfarmroad>>
  <<else>>
    <<passouttemple>>
  <</if>>
<<elseif $Orchard.site is 'farm' and maplebirch.get('Orchard').farmInterrupted>>
  <<lanSwitch 'Shouts carry from the fields. You need to return to the farm.' '田地那边传来喊声。你得先回去看看。'>><br><br>
  <<getouticon>><<lanLink ['Return to the fields', '返回田地'] 'Farm Fields'>><</lanLink>>
<<elseif $Orchard.site is 'farm' and dangerEvent() and $eventskip isnot 1>>
  <<set $bus to 'deadwood_orchard'>><<farm_tending_events>>
<<else>>
  <<language>>
    <<option 'EN'>>
      <<if $Orchard.site is 'temple'>>
        Beyond the flower beds, a narrow strip of earth runs beside the hedge. The temple keeps it for fruit trees. The harvest supplies the kitchen, though those who tend the trees may take a share.
      <<else>>
        At the edge of your fields, a sheltered strip of ground lies between the fence and the hedgerow. There is room for fruit trees without taking space from your crops.
      <</if>>
    <<option 'CN'>>
      <<if $Orchard.site is 'temple'>>
        花圃后面，一条狭长的土地沿着树篱延伸。神殿把这里留给果树。收成供厨房使用，照料果树的人也可以分到一份水果。
      <<else>>
        你的田地边缘，围栏与树篱之间留着一条避风的土地。这里容得下果树，也不会挤占种庄稼的地方。
      <</if>>
  <</language>><br><br>
  <<if maplebirch.get('Orchard').available($Orchard.site)>>
    <<deadwood-orchard-map>>
    <<icon 'orchard/sales.png'>><<lanLink ['Fruit inventory and sales', '水果库存与销售'] 'Deadwood Reblooms Orchard Trade'>><</lanLink>><br>
    <<if maplebirch.get('Orchard').canTalkAlex>>
      <<socialiseicon 'friendly'>><<lanLink ['Spend some time in the orchard with Alex', '邀艾利克斯在果园待一会儿'] 'Deadwood Orchard Alex'>><</lanLink>><br>
    <</if>>
    <<if $Orchard.site is 'farm'>>
      <div id='deadwood-orchard-worker'><<deadwood-orchard-worker>></div>
    <</if>>
    <<if Weather.dayState is 'night'>>
      <<lanSwitch 'It is too dark to work.' '天太黑了，无法干活。'>><br>
    <<elseif pcAreArmsBound('both')>>
      <span class='red'><<lanSwitch 'Your bound arms prevent you from working.' '你的双臂受缚，无法干活。'>></span><br>
    <<elseif $exposed gt 0>>
      <span class='red'><<lanSwitch 'You need to dress before working here.' '你得先穿好衣服才能在这里干活。'>></span><br>
    <</if>>
  <<else>>
    <span class='blue'><<lanSwitch 'You no longer have permission to tend this land.' '你现在没有照料这块土地的资格。'>></span><br>
  <</if>><br>
  <<getouticon>>
  <<if $Orchard.site is 'farm'>>
    <<lanLink ['Return to the fields (0:02)', '返回田地 (0:02)'] 'Farm Fields'>><<pass 2>><</lanLink>>
  <<else>>
    <<lanLink ['Return to the garden (0:02)', '返回花园 (0:02)'] 'Temple Garden'>><<pass 2>><</lanLink>>
  <</if>>
<</if>>
<<set $eventskip to 0>>

:: Deadwood Reblooms Orchard Worker Report []
<<set $outside to 1>><<set $location to 'alex_farm'>><<set $bus to 'farm_fields'>><<farm_work_update>><<effects>>
<<if $stress gte $stressmax>>
  <<passoutfarmroad>><<exit>>
<</if>>
<<run maplebirch.get('Orchard').advance()>>
<<if maplebirch.get('Orchard').canTalkWorker>>
  <<endevent>><<loadNPC 0 'deadwood_orchard_worker'>><<person1>>
  <<set _orchardReport to maplebirch.get('Orchard').workerReport>>
  <<language>>
    <<option 'EN'>>
      <<if $per_npc.deadwood_orchard_worker.orchard_shifts lt 3>><<person>> puts the watering can down when you approach. "I've been round the trees. Come and have a look."
      <<else>><<person>> greets you by name. "Come to check on the trees?" <<He>> tucks a pair of gloves into <<his>> pocket and walks along the row with you.<</if>>
      <br><br>
      <<if _orchardReport.irrigation>>"Water's reaching the trees fine. I checked the channels this morning."
      <<elseif _orchardReport.rain>>"The rain saved some work this morning. The soil's wet right through."
      <<elseif _orchardReport.watered gt 0>>"I've watered the trees that needed it. The soil should hold that for a week."
      <<else>>"Nothing needed watering this morning. I checked the soil by the roots."<</if>>
      <br><br>
      <<if Object.values(_orchardReport.kept).some(amount => amount gt 0)>>"I've put the ripe fruit away. You can check what came in." <<He>> points to the work record.
      <<elseif _orchardReport.left_fruit>>"Some fruit is ripe. I've left it on the trees for you, like you asked. Don't leave it too long."
      <<else>>"No fruit to bring in this morning. I'll keep an eye on it."<</if>>
      <<if _orchardReport.off_season>>
        <br><br>"Some of these trees are out of season. Don't expect as much from them until the weather turns."
      <</if>>
      <<if _orchardReport.fertilised gt 0>>
        <br><br>"I've spread the fertiliser where it was due. That should last about a month."
      <</if>>
      <<if _orchardReport.no_fertiliser>>
        <br><br><span class='gold'>"We're out of fertiliser. I couldn't finish all the trees, but I've kept them watered."</span>
      <</if>>
    <<option 'CN'>>
      <<if $per_npc.deadwood_orchard_worker.orchard_shifts lt 3>><<person>>见你走来，放下水壶。“树都看过一遍了。来看看吧。”
      <<else>><<person>>叫着你的名字打招呼。“来看看树？”<<he>>把手套塞进口袋，陪你沿着树行走过去。<</if>>
      <br><br>
      <<if _orchardReport.irrigation>>“水已经通到果树这边了，我早上检查过水道。”
      <<elseif _orchardReport.rain>>“早上的雨省了些事，土已经湿透了。”
      <<elseif _orchardReport.watered gt 0>>“需要水的树都浇过了，这次够维持一个星期。”
      <<else>>“早上没什么需要浇水的，我检查过树根旁的土。”<</if>>
      <br><br>
      <<if Object.values(_orchardReport.kept).some(amount => amount gt 0)>>“成熟的果子都收好了，你可以看看收了多少。”<<he>>指了指工作记录。
      <<elseif _orchardReport.left_fruit>>“树上有熟果子，按你说的给你留着了。别放太久。”
      <<else>>“早上还没果子可收，我再留意着。”<</if>>
      <<if _orchardReport.off_season>>
        <br><br>“有几种树现在不当季。等天气转过来之前，别指望它们结太多。”
      <</if>>
      <<if _orchardReport.fertilised gt 0>>
        <br><br>“该补肥的已经补上了，差不多能管一个月。”
      <</if>>
      <<if _orchardReport.no_fertiliser>>
        <br><br><span class='gold'>“肥料用完了，有几棵还没补上。水都浇过了，先不用担心。”</span>
      <</if>>
  <</language>><<pass 5>><br><br>
  <<if Object.values(_orchardReport.kept).some(amount => amount gt 0)>>
    <<lanSwitch 'Fruit put away: ' '收好的水果：'>><<deadwood-orchard-worker-harvest>><br><br>
  <</if>>
<<else>>
  <<lanSwitch "Your worker is not available to go over the morning's work now. The latest work record remains beside the orchard." '雇工现在没法陪你检查早上的工作。最近一次的工作记录仍留在果园旁。'>><br><br>
<</if>>
<<deadwood-orchard-event-return>>

:: Deadwood Reblooms Orchard Hire []
<<set $outside to 0>><<set $location to 'pub'>><<set $bus to 'harvest'>><<effects>>
<<endevent>>
<<if !maplebirch.get('Orchard') or !maplebirch.get('Orchard').available('farm') or $Orchard.worker.hired or $exposed gt 0 or $stress gte $stressmax or pcAreArmsBound('both')>>
  <<getouticon>><<lanLink ['Return to the pub', '返回酒馆'] 'Pub'>><</lanLink>><<exit>>
<</if>>
<!-- 首次生成后直接使用同一人物。重访时只载入保存的人物，不重复生成或占用姓名。 -->
<<if maplebirch.get('Orchard').candidate>>
  <<loadNPC 0 'deadwood_orchard_worker'>>
<<else>>
  <<generateNPC 1 a>><<npcClothesName $NPCList[0] 'wildsFlannel'>>
<</if>><<person1>>
<<set _orchardWorkerMet to $NPCList[0].name_known is 1>>
<<set $_worker_wage to maplebirch.get('Orchard').workerWage>>
<<language>>
  <<option 'EN'>>
    <<if _orchardWorkerMet>>You find <<print $NPCList[0].name>> at the same table by the window. <<He>> recognises you and moves a glass aside to make room.
    <<else>>You ask at the bar for someone who can help with fruit trees. The landlord points you towards a <<person>> by the window. You take the empty seat opposite <<him>>.<</if>>
    <br><br>
    "I can water the trees, and pick the fruit if you want," <<he>> says. "Leave me fertiliser and I can spread that too. But I won't be clearing new ground. You'll have to do that yourself."
    <br><br>
    <<if not _orchardWorkerMet>>
      <<He>> gives you <<his>> name: <<print $NPCList[0].name>>.
    <</if>>
    "A week's work costs <<printmoney $_worker_wage>>. Pay first, and I'll come by in the mornings."
  <<option 'CN'>>
    <<if _orchardWorkerMet>>你在窗边同一张桌子找到<<print $NPCList[0].name>>。<<He>>认出你，把杯子挪开，让你坐下。
    <<else>>你向酒馆老板打听有没有人能帮忙照料果树。老板指向窗边的一位<<person>>。你在<<him>>对面的空位坐下。<</if>>
    <br><br>
    “树我可以浇水，你需要的话，水果也能帮你摘，”<<he>>说。“肥料备好了，我也能帮你撒。不过，我不负责开荒。那得你自己来。”
    <br><br>
    <<if not _orchardWorkerMet>>
      <<He>>告诉你自己的名字：<<print $NPCList[0].name>>。
    <</if>>
    “干一周收<<printmoney $_worker_wage>>。先付钱，我每天早上过去。”
<</language>>
<<set $NPCList[0].name_known to 1>><<saveNPC 0 'deadwood_orchard_worker'>><br><br>
<<if $money gte maplebirch.get('Orchard').workerWage>>
  <<icon 'orchard/worker.png'>><<lanLink ['Hire for a week', '雇用一周'] 'Pub'>>
    <<run maplebirch.get('Orchard').hire()>><<endevent>>
  <</lanLink>> (<<printmoney $_worker_wage>>)<br>
<<else>>
  <span class='red'><<lanSwitch 'You cannot afford a week of work.' '你付不起一周的薪资。'>></span> (<<printmoney $_worker_wage>>)<br>
<</if>>
<<getouticon>><<lanLink ['Refuse', '拒绝'] 'Pub'>>
  <<endevent>>
  <<if maplebirch.get('Orchard').candidate>>
    <<clearNPC 'deadwood_orchard_worker'>>
  <</if>>
<</lanLink>>

:: Deadwood Reblooms Orchard Dismiss []
<<set $outside to 1>><<set $location to 'alex_farm'>><<set $bus to 'farm_fields'>><<farm_work_update>><<effects>>
<<endevent>>
<<if !maplebirch.get('Orchard') or !maplebirch.get('Orchard').available('farm') or !$Orchard.worker.hired>>
  <<getouticon>><<lanLink ['Return to the fields', '返回田地'] 'Farm Fields'>><</lanLink>><<exit>>
<<elseif $stress gte $stressmax>>
  <<passoutfarmroad>><<exit>>
<<elseif maplebirch.get('Orchard').farmInterrupted>>
  <<getouticon>><<lanLink ['Return to the fields', '返回田地'] 'Farm Fields'>><</lanLink>><<exit>>
<</if>>
<<if $per_npc.deadwood_orchard_worker>>
  <<loadNPC 0 'deadwood_orchard_worker'>><<person1>>
  <<language>>
    <<option 'EN'>>
      You find <<print $NPCList[0].name>> beside the orchard. <<He>> listens as you explain that you no longer need help.
    <<option 'CN'>>
      你在果园旁找到<<print $NPCList[0].name>>。你告诉<<him>>，自己已经不再需要帮手了。
  <</language>><br><br>
<</if>>
<<lanSwitch 'Dismiss your orchard worker? Any prepaid wages will not be returned.' '要辞退果园雇工吗？已经预付的薪资不会退还。'>><br><br>
<<refuseicon>><<lanLink ['Dismiss', '辞退'] 'Deadwood Reblooms Orchard'>>
  <<run maplebirch.get('Orchard').dismissWorker()>><<endevent>><<set $Orchard.site to 'farm'>><<set $eventskip to 1>>
<</lanLink>><br>
<<getouticon>><<lanLink ['Keep the worker', '继续雇用'] 'Deadwood Reblooms Orchard'>>
  <<endevent>><<set $Orchard.site to 'farm'>><<set $eventskip to 1>>
<</lanLink>>

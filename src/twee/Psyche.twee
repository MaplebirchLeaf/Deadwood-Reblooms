:: Deadwood Psyche Widgets [widget]

<!-- 镜室的原版进度在结局前已到第五档，只记录结局是否结算。 -->
<<widget 'psyche-mirror'>>
  <<if !maplebirch.get('Psyche')?.active or $Psyche.mirror or $asylum_mirror isnot 5 or $nextPassage or $nextPassageCheck>><<exit>><</if>>
  <<switch $passage>>
    <<case 'Asylum Depths Mirror 4 Willpower'>>
      <<if !$willpowerSuccess>><<exit>><</if>>
      <<set $Psyche.mirror to true>><<sanity 20>><<dread 150>>
    <<case 'Asylum Depths Mirror 4 Dance'>>
      <<set $Psyche.mirror to true>><<fascination 200>><<sanity -30>>
  <</switch>>
<</widget>>

<!-- 在返回商店的原版链接中结算，完成时刻去重，保留再次接受疗程的原版条件。 -->
<<widget 'psyche-insight'>>
  <<if !maplebirch.get('Psyche')?.active or $passage isnot 'Gwylan Hypnosis Insight Wake'
      or !Number.isFinite($hypnosis_potency) or !($hypnosisTimers.insight?.time gt 0)
      or $Psyche.insight is Time.date.timeStamp or $nextPassage or $nextPassageCheck>><<exit>><</if>>
  <<set $Psyche.insight to Time.date.timeStamp>><<psyche-rest 0 300>>
<</widget>>

<!-- 在原版睡满一小时的结算点调用，先处理入迷的浅眠，再平复心绪。 -->
<<widget 'psyche-sleep'>>
  <<if maplebirch.get('Psyche')?.active>>
    <<if $Psyche.mood lt -200>><<tiredness `Math.clamp((-$Psyche.mood - 200) / 800, 0, 1)`>><</if>>
    <<psyche-rest 5 80>>
  <</if>>
<</widget>>

<<widget 'psyche-attribute'>>
  <<set $_psyche to maplebirch.get('Psyche')>>
  <<if $_psyche?.active>>
    <<set $_psycheConfig to {
      name: lanSwitch('Sanity', '理智'), icon: 'ui/sym-sanity', displayType: 'level', currentValue: $Psyche.sanity,
      maxValue: 1000, modifier: 100, modTypes: { good: [], bad: [] },
      states: $_psyche.stages.map((stage, index) => ({
        requiredValue: stage.min, level: index, color: stage.colour,
        description: lanSwitch(stage.EN.description, stage.CN.description)
      }))
    }>>
    <<characteristic-box $_psycheConfig>>
  <</if>>
<</widget>>

<!-- 原版共享配置保留其它修正，恐惧与入迷只补当前有效意志倍率。 -->
<<widget 'psyche-willpower'>>
  <<set $_psycheWillpower to maplebirch.get('Psyche')?.willpower ?? 1>>
  <<if $_psycheWillpower lt 1 and _willpowerConfig>>
    <<set _willpowerConfig.modifier to Math.floor(_willpowerConfig.modifier * $_psycheWillpower)>>
    <<run _willpowerConfig.modTypes.bad.pushUnique($Psyche.mood lt 0 ? lanSwitch('Fascination', '入迷') : lanSwitch('Dread', '恐惧'))>>
  <</if>>
<</widget>>

<!-- 四科显示与有效技能共用同一倍率，保留原版的其它加成。 -->
<<widget 'psyche-subjects'>>
  <<set $_psyche to maplebirch.get('Psyche')>>
  <<if $_psyche?.active>>
    <<for $_subjectConfig range [_scienceConfig, _mathsConfig, _englishConfig, _historyConfig]>>
      <<if $_subjectConfig>>
        <<set $_subjectConfig.modifier to Math.floor($_subjectConfig.modifier * $_psyche.knowledge)>>
        <<if $_psyche.stage.judgement isnot 1>>
          <<run $_subjectConfig.modTypes[$_psyche.stage.judgement gt 1 ? 'good' : 'bad'].pushUnique(lanSwitch('Sanity', '理智'))>>
        <</if>>
      <</if>>
    <</for>>
  <</if>>
<</widget>>

<!-- 尾随中的藏身和逃跑沿用原版技能与动作限制。 -->
<<widget 'psyche-skills'>>
  <<set $_psyche to maplebirch.get('Psyche')>>
  <<if $_psyche?.active>>
    <<for $_skill, $_skillConfig range { skulduggery: _skulduggeryConfig, athletics: _athleticsConfig }>>
      <<set $_psycheBonus to $_psyche.skill($_skill)>>
      <<if $_skillConfig and $_psycheBonus gt 1>>
        <<set $_skillConfig.modifier to Math.floor($_skillConfig.modifier * $_psycheBonus)>>
        <<run $_skillConfig.modTypes.good.pushUnique(lanSwitch('Dread', '恐惧'))>>
      <</if>>
    <</for>>
  <</if>>
<</widget>>

<<widget 'psyche-status'>>
  <<set $_mood to Math.abs($Psyche?.mood ?? 0)>>
  <<if maplebirch.get('Psyche')?.active and $options.sidebarStats isnot 'disabled' and ($options.sidebarStats is 'all' or $_mood gte 400)>>
    <div id='psyche-moodcaption'>
      <div @class="$options.showCaptionText ? '' : 'rightMeterText'">
        <<lanSwitch `$Psyche.mood lt 0 ? 'Fascination: ' : 'Dread: '` `$Psyche.mood lt 0 ? '入迷：' : '恐惧：'`>>
        <<if $options.showCaptionText>>
          <<language>>
            <<option 'EN'>>
              <<if $Psyche.mood lt 0>>
                <<if $_mood gte 1000>><span class='red'>You can think of nothing else.</span>
                <<elseif $_mood gte 800>><span class='pink'>You struggle to tear yourself away.</span>
                <<elseif $_mood gte 600>><span class='purple'>Your thoughts keep returning to it.</span>
                <<elseif $_mood gte 400>><span class='blue'>You find it hard to look away.</span>
                <<elseif $_mood gte 200>><span class='lblue'>It lingers in your thoughts.</span>
                <<else>><span class='green'>Your attention drifts back to the world around you.</span><</if>>
              <<else>>
                <<if $_mood gte 1000>><span class='red'>You are terrified.</span>
                <<elseif $_mood gte 800>><span class='pink'>You can barely keep calm.</span>
                <<elseif $_mood gte 600>><span class='purple'>You feel frightened.</span>
                <<elseif $_mood gte 400>><span class='blue'>You feel afraid.</span>
                <<elseif $_mood gte 200>><span class='lblue'>You feel uneasy.</span>
                <<else>><span class='green'>You are calm.</span><</if>>
              <</if>>
            <<option 'CN'>>
              <<if $Psyche.mood lt 0>>
                <<if $_mood gte 1000>><span class='red'>你的脑中只剩下那些景象。</span>
                <<elseif $_mood gte 800>><span class='pink'>你几乎无法移开目光。</span>
                <<elseif $_mood gte 600>><span class='purple'>那些景象在你脑中挥之不去。</span>
                <<elseif $_mood gte 400>><span class='blue'>你难以转移注意。</span>
                <<elseif $_mood gte 200>><span class='lblue'>你仍有些出神。</span>
                <<else>><span class='green'>你渐渐留意起周围的事物。</span><</if>>
              <<else>>
                <<if $_mood gte 1000>><span class='red'>你惊恐万分。</span>
                <<elseif $_mood gte 800>><span class='pink'>你几乎无法保持镇定。</span>
                <<elseif $_mood gte 600>><span class='purple'>你惶恐不安。</span>
                <<elseif $_mood gte 400>><span class='blue'>你感到害怕。</span>
                <<elseif $_mood gte 200>><span class='lblue'>你感到不安。</span>
                <<else>><span class='green'>你很平静。</span><</if>>
              <</if>>
          <</language>>
        <</if>>
      </div>
      <<statbar 0 $_mood 1000 `!$options.showCaptionText`>>
    </div>
  <</if>>
<</widget>>

<<widget 'psyche-mobile-status'>>
  <<set $_mood to Math.abs($Psyche?.mood ?? 0)>>
  <<if maplebirch.get('Psyche')?.active and $options.sidebarStats isnot 'disabled' and ($options.sidebarStats is 'all' or $_mood gte 400)>>
    <<mobileStatsColorSet $_mood 1000>>
    <div @class="'stat ' + _mobileColor">
      <mouse class='tooltip-centertop' data-deadwood-stat='psyche-mood'><<lanSwitch `$Psyche.mood lt 0 ? 'Fa' : 'Dr'` `$Psyche.mood lt 0 ? '迷' : '惧'`>><span><<lanSwitch `$Psyche.mood lt 0 ? 'Fascination' : 'Dread'` `$Psyche.mood lt 0 ? '入迷' : '恐惧'`>><<if !$settings.blindStatsEnabled>>: <<= $_mood.toFixed(1)>><</if>></span></mouse>
    </div>
  <</if>>
<</widget>>

<<widget 'psyche-statistics'>>
  <<set $_mood to Math.abs($Psyche?.mood ?? 0)>>
  <<set $_psyche to maplebirch.get('Psyche')>>
  <<if $_psyche?.active>>
    <<foldout false '_psyche_foldout'>>
      <span class='gold'><<lanSwitch 'Psyche' '心智'>></span>
      <<lanSwitch 'State: ' '心绪：'>><span @class="$_psyche.stage.colour"><<print lanSwitch($_psyche.stage.EN.name, $_psyche.stage.CN.name)>></span><br>
      <<if !$settings.blindStatsEnabled>>
        <<lanSwitch 'Sanity: ' '理智：'>><span class='teal'><<= $Psyche.sanity.toFixed(1)>></span><br>
        <<lanSwitch `$Psyche.mood lt 0 ? 'Fascination: ' : 'Dread: '` `$Psyche.mood lt 0 ? '入迷：' : '恐惧：'`>><span class='purple'><<= $_mood.toFixed(1)>>/1000</span><br>
        <<lanSwitch 'Study efficiency: ' '学习效率：'>><span @class="$_psyche.learning gte 1 ? 'green' : 'red'"><<= Math.round($_psyche.learning * 100)>>%</span><br>
        <<lanSwitch 'Knowledge checks: ' '知识判定：'>><span @class="$_psyche.knowledge gte 1 ? 'green' : 'red'"><<= Math.round($_psyche.knowledge * 100)>>%</span><br>
        <<lanSwitch 'Dread and fascination gained: ' '恐惧与入迷增长：'>><span @class="$_psyche.modifier lte 1 ? 'green' : 'red'"><<= Math.round($_psyche.modifier * 100)>>%</span><br>
        <<lanSwitch 'Willpower while distracted: ' '心绪干扰下的意志：'>><span @class="$_psyche.willpower lt 1 ? 'red' : 'teal'"><<= Math.round($_psyche.willpower * 100)>>%</span><br>
        <<if $Psyche.mood gt 200>>
          <<lanSwitch 'Stress gained: ' '压力增长：'>><span class='red'><<= Math.round($_psyche.stressGain * 100)>>%</span><br>
          <<lanSwitch 'Control recovery: ' '自控恢复：'>><span class='red'><<= Math.round($_psyche.controlRecovery * 100)>>%</span><br>
          <<lanSwitch 'Athletics and skulduggery while stalked: ' '被尾随时的运动与诡术：'>><span class='green'><<= Math.round(100 / $_psyche.escape)>>%</span><br>
          <<lanSwitch 'Harbour retreat difficulty: ' '港湾撤退难度：'>><span class='green'><<= Math.round($_psyche.escape * 100)>>%</span><br>
        <<elseif $Psyche.mood lt -200>>
          <<lanSwitch 'Time spent on strange texts: ' '异常记载研读用时：'>><span class='green'><<= Math.round($_psyche.research * 100)>>%</span><br>
        <</if>>
      <</if>>
      <<language>>
        <<option 'EN'>>
          Sanity affects learning, knowledge checks and how strongly strange experiences affect you. Dread and fascination counteract each other. Both weaken your resolve. Dread makes stress harder to bear and slows control recovery, but sharpens your hearing while you keep control, and helps you run or hide when stalked. Fascination helps you follow strange clues, but leaves you sleeping lightly. Sleep, prayer and writing help you recover.
        <<option 'CN'>>
          理智影响四科学习、知识判定，也影响你有多容易受惊或入迷。恐惧与入迷互相抵消，都会削弱意志。恐惧让压力更难承受，自控也恢复得更慢，但保持自控时能让你留意周围的动静，被尾随时也更容易逃跑或藏身。入迷有助于追寻异常线索，却也让你睡得更浅。睡一觉、祈祷或写写东西，有助于恢复。
      <</language>><br>
    <</foldout>>
    <br>
  <</if>>
<</widget>>

<<widget 'psyche-journal'>>
  <<set $_mood to Math.abs($Psyche?.mood ?? 0)>>
  <<if maplebirch.get('Psyche')?.active and ($_mood gte 800 or $Psyche.sanity lt 150)>>
    <div class='gold bold'><<lanSwitch 'Peace of mind' '心神'>></div>
    <ul class='journal'><li>
      <<language>>
        <<option 'EN'>>
          You cannot stop thinking about what happened. Try getting some sleep, writing in the loft or praying at the temple. Find somewhere quiet to steady yourself if you cannot concentrate.
        <<option 'CN'>>
          你仍忘不了最近的遭遇。睡一觉、去阁楼写写东西，或到神殿祈祷，也许会好些。如果难以集中精神，就找个安静的地方，停下来定定神。
      <</language>>
    </li></ul>
    <hr>
  <</if>>
<</widget>>

<!-- 只在普通行动菜单中提供选择，不抢占原版事件，也不在重绘时结算。 -->
<<widget 'psyche-calm'>>
  <<set $_psycheExit to ({
    Bedroom: 'Kitchen', Temple: 'Wolf Street', 'Temple Garden': 'Forest', 'School Library': 'Hallways',
    'Lake Shore': 'Lake Waterfall', 'Pirate Deck': 'Pirate Cabin',
    'Deadwood Reblooms Property Home': 'Deadwood Reblooms Property Kitchen'
  })[$passage] || 'Storm Drain Entrance'>>
  <!-- 地点内的检查、靠岸与重逢分支也会生成链接，仅在真正的日常菜单出现。 -->
  <<set $_psycheMenu to document.querySelector('#passage-content .macro-link[data-passage="' + $_psycheExit + '"]')>>
  <<if maplebirch.get('Psyche')?.canCalm and $_psycheMenu>>
    <<language>>
      <<option 'EN'>>
        <<if $Psyche.mood lt 0>>Your thoughts keep wandering. You could stop and take in your surroundings.<<else>>You cannot seem to calm down. You could stop and catch your breath.<</if>>
      <<option 'CN'>>
        <<if $Psyche.mood lt 0>>你仍有些出神。停下来看看周围，也许能定下心。<<else>>你心神不宁。停下来缓口气，也许会好些。<</if>>
    <</language>><br>
    <<set _psycheOrigin to $passage, _psycheLocation to $location>>
    <<capture _psycheOrigin _psycheLocation>>
    <<icon 'actions/relax.png'>><<lanLink `$Psyche.mood lt 0 ? ['Take a moment to collect yourself (0:05)', '停下来定定神 (0:05)'] : ['Stop and steady your breathing (0:05)', '停下来调整呼吸 (0:05)']`>>
      <<if maplebirch.get('Psyche')?.canCalm and $passage is _psycheOrigin and $location is _psycheLocation>>
        <<pass 5>>
        <<if maplebirch.get('Psyche')?.free and $passage is _psycheOrigin and $location is _psycheLocation
            and maplebirch.get('Psyche').intensity gt 0 and Time.date.timeStamp gte $Psyche.cooldown_until>>
          <<set $Psyche.episode to { passage: _psycheOrigin, mood: $Psyche.mood, needsEffects: true }>>
          <<psyche-rest 0 200>><<stress -1>>
          <<set $Psyche.cooldown_until to Time.date.timeStamp + 1800>>
          <<goto 'Deadwood Psyche Recovery'>>
        <<elseif $nextPassage or $nextPassageCheck>>
          <<goto `_psycheOrigin`>>
        <</if>>
      <</if>>
    <</lanLink>><<if $Psyche.mood lt 0>><<llfascination>><<else>><<lldread>><</if>><<lstress>><br><br>
    <</capture>>
  <</if>>
<</widget>>

:: Deadwood Psyche Recovery
<!-- 恢复只在点击回调结算，结果页重绘不重复生效。 -->
<<set _psycheRecovered to false>>
<<if $Psyche?.episode?.needsEffects and !$statFreeze and !$replayScene and !$frozenValues>>
  <<set $Psyche.episode.needsEffects to false>><<set _psycheRecovered to true>><<effects>>
<</if>>
<<if $nextPassage>>
  <<lanLink ['Continue', '继续'] 'Deadwood Psyche Recovery'>><</lanLink>><br><<exit>>
<</if>>
<<if $Psyche?.episode and Story.has($Psyche.episode.passage)>>
  <<language>>
    <<option 'EN'>>
      <<if $Psyche.episode.mood lt 0>>You look away and take in your surroundings. After a while, the sounds around you seem clearer.<<else>>You relax your shoulders and take a few slow breaths. After a while, you are ready to carry on.<</if>>
    <<option 'CN'>>
      <<if $Psyche.episode.mood lt 0>>你移开目光，留意身边的事物。过了一会儿，周围的声音渐渐清晰起来。<<else>>你放松肩膀，慢慢吸气，再呼出来。过了一会儿，你准备继续刚才的事。<</if>>
  <</language>><<if _psycheRecovered>><<if maplebirch.get('Psyche')?.active>><<if $Psyche.episode.mood lt 0>><<llfascination>><<else>><<lldread>><</if>><</if>><<lstress>><</if>><br><br>
  <<getouticon>><<lanLink ['Continue', '继续'] `$Psyche.episode.passage`>><<if !$statFreeze and !$replayScene and !$frozenValues>><<set $Psyche.episode to null>><</if>><</lanLink>><br>
<<else>>
  <<language>><<option 'EN'>>You pause, then turn back.<<option 'CN'>>你停了一会儿，转身返回。<</language>><br><br>
  <<getouticon>><<lanLink ['Return', '返回'] `$safePassage || 'Bedroom'`>><<if $Psyche and !$statFreeze and !$replayScene and !$frozenValues>><<set $Psyche.episode to null>><</if>><</lanLink>><br>
<</if>>

:: Deadwood Robin Night Knock []
<<set $outside to 0>><<set $location to 'home'>><<effects>><<npc Robin>><<person1>>
<<if maplebirch.get('Robin').night.start()>>
  <<pass 5>>
  <<lanSwitch 'You knock softly. The note says Robin is sleeping, so you wait without touching the handle. After a moment Robin opens the door just enough to see you.' '你轻轻敲门。纸条上写着罗宾已经睡了，你便等在门外，没有碰门把手。片刻后，罗宾把门打开一条缝。'>>
  <br><br><span class='blue'><<lanSwitch '"Is something wrong?" Robin asks, then steps back to let you speak.' '“出什么事了吗？”罗宾问，然后退开一步，等你开口。'>></span>
  <<if C.npc.Robin.trauma gte 50>>
    <br><br><<lanSwitch 'A half finished page lies on the desk. Robin keeps glancing at the corridor and says the footsteps outside made it hard to sleep. Robin does not seem ready for a long conversation.' '桌上有张写了一半的纸。罗宾不时看向走廊，说外面的脚步声让自己睡不着。此刻罗宾似乎不想谈太久。'>>
  <<elseif $RobinExpansion.rebellion>>
    <br><br><<lanSwitch 'Robin has been thinking about Bailey and the other children. "I keep wondering if they know we meant what we said," Robin admits. The room is quiet enough to hear the clock in the hall.' '罗宾还在想着贝利与其他孩子。“我一直在想，他们知不知道我们说过的话是认真的。”罗宾坦白道。房间静得能听见走廊里的钟声。'>>
  <<elseif $RobinExpansion.tutor_day is Time.days>>
    <br><br><<lanSwitch 'A pupil’s exercise book lies beside Robin’s own homework. Robin taps a correction in the margin. "The pupil understood it after I changed the example," Robin says, sounding pleased and tired at once.' '学生的练习册放在罗宾自己的作业旁。罗宾点点边上的批注：“换个例子之后，那孩子就懂了。”语气既高兴又困倦。'>>
  <<elseif $RobinExpansion.shop_stage isnot 'none' or $RobinExpansion.shop>>
    <br><br><<lanSwitch 'Two stall ledgers and a list for tomorrow lie open on the desk. Robin rubs tired eyes. "I wanted to check one more sum before bed," Robin says, moving the papers aside to make room for you.' '桌上摊着两处摊位的账本和明天的清单。罗宾揉揉困倦的眼睛：“睡前想再核一道账。”说着把纸张挪开，给你腾出位置。'>>
  <<elseif $RobinExpansion.meteor_day is Time.days>>
    <br><br><<lanSwitch 'The blanket from the meteor shower is folded at the end of the bed. Robin points out the brightest streak again, tracing its path in the air before lowering a sleepy hand.' '看流星雨用的毯子叠在床尾。罗宾又比划了一遍最亮的那颗划过的方向，困倦地放下手。'>>
  <<else>>
    <br><br><<lanSwitch 'Robin puts a bookmark between two pages and sits up. "Is something wrong?" Robin asks at once, before <<he>> has properly looked at you. "You are not usually here this late."' '罗宾给书夹上书签，坐了起来。“出什么事了吗？”<<he>>还没看清你就先问出口，“你平时不会这么晚过来的。”'>>
  <</if>>
  <br><br>
  <<socialiseicon 'ask'>><<lanLink ['Listen to Robin', '听罗宾说说心事'] 'Deadwood Robin Night Listen'>><</lanLink>>
  <br><<socialiseicon>><<lanLink ['Plan tomorrow with Robin', '和罗宾商量明天'] 'Deadwood Robin Night Tomorrow'>><</lanLink>>
  <<if $robinromance is 1 and C.npc.Robin.love gte 50 and C.npc.Robin.trauma lt 50>>
    <br><<loveicon>><<lanLink ['Ask to sit with Robin for a while', '问罗宾能否陪坐一会'] 'Deadwood Robin Night Stay'>><</lanLink>>
  <</if>>
  <<if ($RobinExpansion.shop_stage isnot 'none' or $RobinExpansion.shop) and !$RobinExpansion.rebellion and C.npc.Robin.trauma lt 50>>
    <br><<shopicon 'register'>><<lanLink ['Press Robin to keep working', '催罗宾继续核账'] 'Deadwood Robin Night Push'>><</lanLink>>
  <</if>>
  <br><br><<getouticon>><<lanLink '道声晚安并离开' 'Orphanage'>><<endevent>><</lanLink>>
<<else>>
  <<lanSwitch 'Robin has already settled in for the night.' '罗宾今晚已经歇下了。'>>
  <br><br><<getouticon>><<lanLink '返回孤儿院' 'Orphanage'>><<endevent>><</lanLink>>
<</if>>

:: Deadwood Robin Night Listen []
<<set $outside to 0>><<set $location to 'home'>><<effects>><<npc Robin>><<person1>>
<<if maplebirch.get('Robin').night.finish()>>
  <<if C.npc.Robin.trauma gte 50>>
    <<lanSwitch 'You stay by the open door and listen. Robin speaks in short pieces about the day, then asks you to leave the hall light on. You agree.' '你留在敞开的门边听着。罗宾断断续续地讲起今天，随后请你把走廊灯留着。你答应了。'>>
    <br><br><span class='green'><<lanSwitch 'Robin checks the latch and says, "Thank you for asking first."' '罗宾确认门闩后说：“谢谢你先问我。”'>></span>
    <<npcincr Robin trauma -3>><<npcincr Robin love 2>><<stress -3>><<lrtrauma>><<glove>><<lstress>>
  <<elseif $RobinExpansion.tutor_day is Time.days>>
    <<lanSwitch 'Robin tells you the pupil finally tried an answer without looking up at the parent first. You listen while Robin works out what to ask next time. Neither of you needs to turn the lesson into another late-night task.' '罗宾说，学生终于没有先看家长的脸色，而是自己试着回答。你听罗宾慢慢想好下次该问什么，不再把这堂课变成深夜的另一份功课。'>>
    <<npcincr Robin love 2>><<stress -5>><<glove>><<lstress>>
  <<else>>
    <<lanSwitch 'Robin tells you about a small mistake at the stall and laughs at how enormous it felt at the time. You tell Robin about your day in turn. Neither of you needs to fix anything tonight.' '罗宾说起摊位上一个小差错，又笑自己当时把它看得天大。你也讲了今天的事。今晚你们不用急着解决什么。'>>
    <<npcincr Robin love 2>><<npcincr Robin trauma -1>><<stress -5>><<glove>><<lrtrauma>><<lstress>>
  <</if>>
<<else>>
  <<lanSwitch 'It is time to let Robin rest.' '该让罗宾休息了。'>>
<</if>>
<br><br><<getouticon>><<lanLink '道声晚安并离开' 'Orphanage'>><<endevent>><</lanLink>>

:: Deadwood Robin Night Tomorrow []
<<set $outside to 0>><<set $location to 'home'>><<effects>><<npc Robin>><<person1>>
<<if maplebirch.get('Robin').night.finish()>>
  <<if C.npc.Robin.trauma gte 50>>
    <<lanSwitch 'You ask what would make tomorrow easier. Robin thinks for a moment and chooses just one thing: to start with breakfast together. You write it down and leave the rest for daylight.' '你问明天怎样能轻松些。罗宾想了一会，只挑了一件事：一起吃早饭。你把它记下，其他事情留到天亮再说。'>>
    <<npcincr Robin dom 1>><<npcincr Robin trauma -2>><<npcincr Robin love 1>><<gdom>><<lrtrauma>><<glove>>
  <<elseif $RobinExpansion.rebellion>>
    <<lanSwitch 'You agree to speak to the other children after school, when everyone can leave if they wish. Robin decides what to say and asks you to stand nearby. The plan feels smaller and possible.' '你们约好放学后再与其他孩子谈，那时谁不想参与都能离开。罗宾自己决定要说的话，请你在旁边陪着。计划因此变得小些，也更做得到。'>>
    <<npcincr Robin dom 2>><<npcincr Robin love 1>><<gdom>><<glove>>
  <<elseif $RobinExpansion.tutor_day is Time.days>>
    <<lanSwitch 'Robin asks whether the pupil solved the final question after you left. You do not know yet, so you agree to ask next lesson. Robin puts the exercise book away and chooses to finish personal homework in the morning.' '罗宾问，你们走后学生有没有做出最后一题。你也不知道，于是约好下次上课再问。罗宾收起练习册，决定自己的作业明早再做。'>>
    <<npcincr Robin dom 1>><<npcincr Robin love 1>><<gdom>><<glove>>
  <<elseif $RobinExpansion.shop_stage isnot 'none' or $RobinExpansion.shop>>
    <<lanSwitch 'You ask which task Robin wants to take tomorrow. Robin chooses the stock list and gives you the receipts to sort. Once the work is divided, Robin closes the ledger without checking it again.' '你问明天罗宾想负责什么。罗宾选了存货清单，把收据交给你整理。分好工后，罗宾合上账本，没有再翻开。'>>
    <<npcincr Robin dom 2>><<npcincr Robin love 1>><<gdom>><<glove>>
  <<else>>
    <<lanSwitch 'Robin suggests a short walk after school if the weather holds. You agree to decide tomorrow. Robin smiles and finally puts the book away.' '罗宾提议放学后若天气好，就一起走一小段路。你们约好明天再决定。罗宾笑着把书收了起来。'>>
    <<npcincr Robin love 1>><<npcincr Robin dom 1>><<glove>><<gdom>>
  <</if>>
<<else>>
  <<lanSwitch 'It is time to let Robin rest.' '该让罗宾休息了。'>>
<</if>>
<br><br><<getouticon>><<lanLink '道声晚安并离开' 'Orphanage'>><<endevent>><</lanLink>>

:: Deadwood Robin Night Stay []
<<set $outside to 0>><<set $location to 'home'>><<effects>><<npc Robin>><<person1>>
<<if maplebirch.get('Robin').night.finish()>>
  <<lanSwitch '"A little while," Robin agrees. You sit beside the desk, close enough to share the quiet. Robin reaches for your hand, and lets go only when you both stand. "Good night," Robin says, sounding steadier.' '“坐一会就好。”罗宾答应了。你在桌旁坐下，一起安静地待着。罗宾伸手握住你的手，直到你们起身才松开。“晚安。”罗宾的声音平稳了些。'>>
  <<npcincr Robin love 2>><<npcincr Robin trauma -2>><<stress -8>><<glove>><<lrtrauma>><<lstress>>
<<else>>
  <<lanSwitch 'It is time to let Robin rest.' '该让罗宾休息了。'>>
<</if>>
<br><br><<getouticon>><<lanLink '道声晚安并离开' 'Orphanage'>><<endevent>><</lanLink>>

:: Deadwood Robin Night Push []
<<set $outside to 0>><<set $location to 'home'>><<effects>><<npc Robin>><<person1>>
<<if maplebirch.get('Robin').night.finish()>>
  <<lanSwitch 'You point to the unfinished figures. Robin tries to work through them, but writes the same number twice.' '你指着尚未算完的数字。罗宾试着继续，却把同一个数抄了两遍。'>>
  <br><br><span class='red'><<lanSwitch '"I can do it in the morning," Robin says, closing the ledger.' '“我早上能做。”罗宾合上账本。'>></span>
  <br><br><<lanSwitch 'The way Robin sets down the pen makes it clear you should go.' '放下笔的动作已经说明，你该离开了。'>>
  <<npcincr Robin dom -1>><<npcincr Robin love -1>><<npcincr Robin trauma 2>><<ldom 'Robin'>><<llove 'Robin'>><<grtrauma>>
<<else>>
  <<lanSwitch 'It is time to let Robin rest.' '该让罗宾休息了。'>>
<</if>>
<br><br><<getouticon>><<lanLink '道声晚安并离开' 'Orphanage'>><<endevent>><</lanLink>>
:: Deadwood Robin School Wake Widgets [widget]
<<widget 'deadwood-robin-school-wake'>>
  <<if $location is 'home' and Time.schoolDay and Time.hour gte 6 and Time.hour lt 9
    and $RobinExpansion.school_wake_day isnot Time.days and !$daily.motherWake
    and !_sleepinterrupt and !_wakingEffect and !$robinbed and $kylarbed isnot 1
    and C.npc.Robin.init is 1
    and (!maplebirch.get('VanillaPlus') or !maplebirch.get("VanillaPlus").realEstate.residenceOf('Robin'))
    and ($RobinExpansion.both_rent or $RobinExpansion.bailey_defeated)
    and $RobinExpansion.asylum.status isnot 'admitted' and !$robinmissing
    and $robin.timer.hurt is 0 and C.npc.Robin.trauma lt 80
    and ['sleep', 'orphanage', 'bath'].includes(getRobinLocation())>>
    <<set $RobinExpansion.school_wake_day to Time.days>>
    <br><br><<npc Robin>><<person1>>
    <<lanSwitch 'A light knock comes at your door. Robin waits for your answer before opening it.' '门上传来轻轻的敲击声。罗宾等你应声，才推开房门。'>>
    <<if $LifeSimulation?.school?.attendanceExempt>>
      <br><<lanSwitch '"I am leaving for school soon," Robin says, adjusting the strap of <<his>> bag. "You do not have to come to class, do you? Will I see you later?"' '“我快去学校了。”罗宾理了理书包带，“你不用来听课，对吧？晚点还能见到你吗？”'>>
    <<elseif C.npc.Robin.trauma gte 50>>
      <br><<lanSwitch 'Robin stays close to the doorway, <<his>> schoolbag held against <<his>> chest. "It is a school day," <<he>> says quietly. "I thought you might want to know before I go."' '罗宾站在门边，把书包抱在胸前。“今天要上学。”<<he>>轻声说，“我走之前，想先告诉你一声。”'>>
    <<elseif Time.hour lt 7>>
      <br><<lanSwitch '"There is still time to get ready," Robin says. <<He>> has <<his>> schoolbag over one shoulder. "I did not want you to sleep through the morning."' '“还有时间准备。”罗宾把书包搭在一边肩上，“我不想让你一觉睡过早上。”'>>
    <<elseif $RobinExpansion.bailey_defeated>>
      <br><<lanSwitch '"We should get ready for school," Robin says, checking <<his>> bag once more. "At least there is no rent book to check first." <<He>> smiles at you from the doorway.' '“我们该准备去学校了。”罗宾又检查了一遍书包，“至少不用先核房租账。”<<He>>站在门边朝你笑了笑。'>>
    <<else>>
      <br><<lanSwitch '"It is a school day. Do not forget your uniform," Robin says. A folded page from the shared ledger peeks out of <<his>> pocket. <<He>> tucks it away and checks that <<his>> books are in the bag.' '“今天要上学，别忘了换校服。”罗宾口袋边露出共同账本里折起的一页。<<He>>把它收好，确认课本都装进了书包。'>>
    <</if>>
    <<if !$LifeSimulation?.school?.attendanceExempt>>
      <br><br><<schoolicon 'building'>><span class='teal'><i><<lanSwitch 'Today is a school day. Get dressed and check the time before leaving.' '今天有课。换好衣服，出门前留意时间。'>></i></span>
    <</if>>
  <</if>>
<</widget>>

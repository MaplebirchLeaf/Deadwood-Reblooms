      <<set $NPCList[0].lefthand to 'none'>><<set $NPCList[0].righthand to 'none'>>
      <<set $speechdisable to 1>><<set $head to 'grappled'>>
      <<set $timer to random(5, 9)>>
    <<else>>
      <<npcexpose>><<npckiss>>
    <</if>>
    <<switch _site>>
      <<case 'shop'>>
        <<lanSwitch
          'Robin pulls you close in the quiet stockroom. <span class="lewd"><<His>> hands find the hem of your clothes and then stop, waiting for you to decide just how far this goes.</span>'
          '罗宾在安静的储藏室里把你拉近。<span class="lewd"><<His>>手摸到你的衣摆便停住，等你决定要做到哪一步。</span>'>>
      <<case 'lemonade'>>
        <<lanSwitch
          'Robin grips the edge of the cart as the next customer approaches.'
          '下一位客人走近时，罗宾抓紧了推车边缘。'>>
      <<case 'chocolate'>>
        <<lanSwitch
          'Robin keeps stirring the cocoa while footsteps pass the stand.'
          '脚步声从摊位前经过，罗宾继续搅着可可。'>>
      <<case 'meteor'>>
        <<lanSwitch 'You turn toward Robin beneath the blanket as another light crosses the sky. <span class="lewd"><<He>> is already warm against you, and <<he>> does not pull away when your hand finds <<his>> waist.</span>' '又一道光划过天空。你在毯子下面向罗宾转过身。<span class="lewd"><<He>>已经贴着你，暖得发烫，你的手摸上<<his>>腰时，<<he>>没有躲开。</span>'>>
      <<case 'swim'>>
        <<water>><<lanSwitch 'You stop together in the shallows, beside the rocks. Robin takes your hand and waits for you to come closer.' '你们在礁石旁的浅水里停下。罗宾牵住你的手，等你靠近。'>>
      <<case 'fishing'>>
        <<lanSwitch 'Out of sight of the stall, Robin stops pretending the walk is the point. <<He>> tucks the rod under one arm and gets <<his>> other hand on your waist, backing you into the rock until the stone is warm through your clothes and <<he>> is pressed the length of you.' '离开摊位的视线之后，罗宾不再装出只是散步的样子。<<he>>把鱼竿夹在腋下，另一只手按住你的腰，把你抵到礁石上，直到石头隔着衣服也焐热了，而<<he>>整个人贴着你。'>>
    <</switch>><br><br>
    <<if _site is 'lemonade' or _site is 'chocolate'>>
      <<promiscuity4>>
    <<else>>
      <<promiscuity1>>
    <</if>>
    <br><br>
  <</if>>
  <<set $enemyanger to 0>>
  <<effects>><<effectsman>><<man>><<stateman>>
  <<if _site is 'lemonade' or _site is 'chocolate'>>
    <<if $timer is 3>>
      <br><br><span class='lewd'><<lanSwitch 'Footsteps stop at the counter.' '脚步声停在柜台前。'>></span>
    <<elseif $timer is 2>>
      <br><br><<lanSwitch 'Robin takes an order and reaches for a clean cup.' '罗宾应了一声，伸手拿起干净的杯子。'>>
    <<elseif $timer is 1>>
      <br><br><<lanSwitch 'Robin hands over the drink. The customer hesitates, then walks away.' '罗宾递出饮料。客人停顿片刻，终于走开。'>>
    <<elseif $timer is 0>>
      <<set $timer to random(5, 9)>>
      <br><br><<lanSwitch 'Robin glances down to check on you before taking the next order.' '接待下一位客人前，罗宾低头看了你一眼。'>>
    <</if>>
  <</if>>
  <br><br><<actionsman>>
  <<if _combatend or $consensual isnot 1>>
    <span id='next'><<lanLink ["Next","继续"] 'Deadwood Robin Private Sex Finish'>><</lanLink>></span><<nexttext>>
  <<else>>
    <span id='next'><<lanLink ["Next","继续"] 'Deadwood Robin Private Sex'>><</lanLink>></span><<nexttext>>
  <</if>>
<</if>>


<!-- 原版罗宾的合意战斗初始化与结束流程。site 保存在当前 V 中，读档或跨回合后仍返回正确地点。 -->
<<set _site to $RobinExpansion.intimacy_site>>
<<if !['shop', 'lemonade', 'chocolate', 'meteor', 'swim', 'fishing'].includes(_site)
  or ($sexstart is 1 and (!isLoveInterest('Robin') or C.npc.Robin.trauma gte 50
    or $robinmissing or $robin.timer.hurt gt 0 or $RobinExpansion.asylum.status is 'admitted'
    or (!['meteor', 'swim', 'fishing'].includes(_site) and !maplebirch.get('Robin').canTease)))>>
  <<set $sexstart to 0>>
  <<getouticon>><<lanLink ['Leave', '离开'] 'Orphanage'>><<endevent>><</lanLink>>
<<else>>
  <<set $outside to ['meteor', 'swim', 'fishing'].includes(_site) ? 1 : 0>>
  <<set $location to _site is 'shop' ? 'deadwood_robin_shop' : _site is 'chocolate' ? 'park' : 'beach'>>
  <<if $sexstart is 1>>
    <<set $sexstart to 0>>
    <<clearnpc>><<npc Robin>><<person1>>
    <<run statusCheck('Robin')>>
    <<consensual>><<set $consensual to 1>><<neutral 1>>
    <<if !['lemonade', 'chocolate', 'swim', 'fishing'].includes(_site) and $exposed lt 2>>
      <<strip>>
    <</if>>
    <<maninit>><<set $enemytrust += 500>>

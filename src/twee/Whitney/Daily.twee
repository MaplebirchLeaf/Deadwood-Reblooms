:: Deadwood Whitney Aftercare Widgets [widget]
<!-- 营救后的课前、午休或放学时开放，原版强制事件先行，交谈留足十分钟。 -->
<<widget 'deadwood-whitney-aftercare-ready'>><<silently>>
  <<set _whitneyAftercareReady to !!$WhitneyExpansion?.rescued and $whitneyReunionScene is undefined
    and ['active', 'rescued'].includes(C.npc.Whitney.state) and Time.schoolDay and !isInPark('whitney')
    and ['morning', 'lunch', 'afternoon'].includes($schoolstate) and $location is 'school' and $outside is 1
    and Time.hour * 60 + Time.minute lt ($schoolstate is 'morning' ? 9 * 60 : $schoolstate is 'lunch' ? 13 * 60 : 17 * 60) - (_args[0] ? 0 : 10)
    and $exposed lte 0 and (_args[0] is 'answer' ? $WhitneyExpansion.aftercare_day is Time.days : $WhitneyExpansion.aftercare_day isnot Time.days)
    and !$nextPassage and !$nextPassageCheck and !$combat and !$statFreeze and !$replayScene and !$frozenValues and !$eventforced>>
<</silently>><</widget>>

<<widget 'deadwood-whitney-aftercare-link'>>
  <<deadwood-whitney-aftercare-ready>>
  <<if _whitneyAftercareReady>>
    <<socialiseicon>><<lanLink ['Talk to Whitney (0:10)', '去找惠特尼说话 (0:10)'] 'Deadwood Whitney Aftercare'>><</lanLink>><br><br>
  <</if>>
<</widget>>

<!-- 白天的码头：原版夜间关门并有保安巡逻，因此只在白天开放。 -->
<<widget 'deadwood-whitney-pier-link'>>
  <<if $whitneyromance is 1 and ['active', 'rescued'].includes(C.npc.Whitney.state)
    and Time.dayState isnot 'night' and !Time.schoolTime and !isInPark('whitney')
    and $daily?.fishing?.fishingPier?.whitney?.phase isnot 'bet'
    and !($daily?.fishing?.fishingPier?.whitney?.phase is 'idle' and !['dusk', 'night'].includes(Weather.dayState))
    and Time.hour gte 9 and Time.hour * 60 + Time.minute lte 17 * 60 - 10 and $location is 'docks'
    and $exposed lte 0 and $WhitneyExpansion.pier_day isnot Time.days>>
    <<socialiseicon>><<lanLink ['See what Whitney is doing (0:10)', '看看惠特尼在做什么 (0:10)'] 'Deadwood Whitney Pier'>><</lanLink>><br><br>
  <</if>>
<</widget>>

<!-- 接在原版敲门页面的开门对白之后，不重复倒钩街的公寓入口。 -->
<<widget 'deadwood-whitney-flats-link'>>
  <<if $whitneyromance is 1 and ['active', 'rescued'].includes(C.npc.Whitney.state)
    and C.npc.Whitney.love gte 20
    and (Time.dayState is 'dawn' or (Time.dayState is 'day' and Weather.precipitation is 'none' and !Time.schoolDay and ![3, 6, 7].includes(Time.weekDay)))
    and $whitney_home_stage gte 3 and $exposed lte 0
    and $WhitneyExpansion.flats_day isnot Time.days>>
    <<socialiseicon>><<lanLink ['Talk with Whitney at the door (0:05)', '与惠特尼在门口聊几句 (0:05)'] 'Deadwood Whitney Flats'>><</lanLink>><br>
  <<if isLoveInterest('Whitney') and C.npc.Whitney.love gte 25>>
    <<loveicon>><<lanLink ['Pull Whitney back inside', '把惠特尼拉回屋里'] 'Whitney Home Enter'>><</lanLink>><<promiscuous1>><br>
  <</if>>
  <</if>>
<</widget>>

<!-- 原版公寓聊天已确保惠特尼在场，这里只补一项每日互动。 -->
<<widget 'deadwood-whitney-music-link'>>
  <<if $WhitneyExpansion and $location is 'flats' and $whitneyromance is 1
    and ['active', 'rescued'].includes(C.npc.Whitney.state) and $WhitneyExpansion.music_day isnot Time.days>>
    <<icon 'whitney/music-player.png'>><<lanLink ["Listen to Whitney's music (0:10)", '听听惠特尼在放什么 (0:10)'] 'Deadwood Whitney Music'>><</lanLink>><br>
    <<if Time.dayState is 'dawn' and isLoveInterest('Whitney') and C.npc.Whitney.love gte 25 and $daily.whitney.shower_done isnot true>>
      <<bathroomicon 'bath'>><<lanLink ['Go to the bathroom with Whitney', '跟惠特尼去浴室'] 'Whitney Home Dawn Shower'>><<set $daily.whitney.shower_done to true>><</lanLink>><br>
    <</if>>
    <<if isLoveInterest('Whitney') and C.npc.Whitney.love gte 25 and $WhitneyExpansion.hang_day isnot Time.days>>
      <<loveicon>><<lanLink ['Lie down on the bed with Whitney', '和惠特尼一起躺到床上'] 'Whitney Home Hang Masturbation Sex'>>
        <<set $sexstart to 1>><<set $WhitneyExpansion.hang_day to Time.days>>
      <</lanLink>><<promiscuous3>><<NPCvirginitywarning 'Whitney' 'kiss'>><br>
    <</if>>
  <</if>>
<</widget>>

:: Deadwood Whitney Music
<<set $outside to 0>><<set $location to 'flats'>><<effects>>
<<if $nextPassage or $nextPassageCheck or $combat or $replayScene or $statFreeze>><<exit>><</if>>
<<if $whitneyromance isnot 1 or !['active', 'rescued'].includes(C.npc.Whitney.state) or $WhitneyExpansion.music_day is Time.days>>
  <<lanSwitch 'Whitney has gone out.' '惠特尼已经出门了。'>>
<<else>>
  <<pass 10>>
  <<if $nextPassage or $nextPassageCheck or $combat or $replayScene or $statFreeze or $location isnot 'flats' or $passage isnot 'Deadwood Whitney Music' or !['active', 'rescued'].includes(C.npc.Whitney.state)>><<exit>><</if>>
  <<set $WhitneyExpansion.music_day to Time.days>>
  <<npc Whitney>><<person1>>
  <<language>>
    <<option 'EN'>>
      Whitney sits with one earphone in, tapping <<his>> foot to the beat.
      When you glance at the player, <<he>> pulls the earphone out and winds its wire around a finger. "What, want a turn?"
    <<option 'CN'>>
      惠特尼戴着一只耳机，脚尖随着节拍轻点。
      你瞥向播放器时，<<he>>摘下耳机，把线绕在指头上。“怎么，也想听听？”
  <</language>><br><br>
  <<socialiseicon>><<lanLink ['Ask Whitney what song this is', '问惠特尼这是什么歌'] 'Deadwood Whitney Music Answer'>><<set $phase to 'whitney-music-ask'>><</lanLink>><br>
  <<loveicon>><<lanLink ['Wait for Whitney to offer the earphone', '等惠特尼把耳机递过来'] 'Deadwood Whitney Music Answer'>><<set $phase to 'whitney-music-wait'>><</lanLink>>
<</if>>
<br><br><<getouticon>><<lanLink ['End the conversation', '结束交谈'] 'Deadwood Whitney Room'>><</lanLink>>

:: Deadwood Whitney Music Answer
<<set $outside to 0>><<set $location to 'flats'>><<effects>>
<<if !['whitney-music-ask', 'whitney-music-wait'].includes($phase)
  or $whitneyromance isnot 1 or !['active', 'rescued'].includes(C.npc.Whitney.state)>>
  <span class='blue'><i><<lanSwitch 'There is nothing more to do here.' '这里已经没有别的事可做。'>></i></span>
<<else>>
  <<npc Whitney>><<person1>>
  <<if $phase is 'whitney-music-wait'>>
    <<language>>
      <<option 'EN'>>
        You sit beside Whitney without reaching for the earphone. After the next song starts, <<he>> pushes it into your hand and clicks the volume up. "Just this one," <<he>> says, watching you. "Well? Can you take it or not?"
      <<option 'CN'>>
        你在惠特尼身旁坐下，没有伸手去拿耳机。下一首歌响起时，<<he>>把耳机塞进你手里，顺手调高了音量。“就听这一首。”<<he>>盯着你。“怎么，扛不住？”
    <</language>>
    <<npcincr Whitney love 1>><<glove>><<stress -1>><<lstress>>
  <<else>>
    <<language>>
      <<option 'EN'>>
        "You would hate it," Whitney says. <<He>> names the band anyway and lets the next song play for a few seconds.
        <<if $whitney_home_invite gt 5 and C.npc.Whitney.love gte 30>>
          "You should know it by now. You're here enough." <<He>> nudges the player out of your reach. "Get your own copy."
        <<else>>
          "There. Now stop asking." <<He>> puts the earphone back in, still watching you.
        <</if>>
      <<option 'CN'>>
        “你肯定不喜欢。”惠特尼说着，却还是报出了乐队的名字，让下一首歌放了几秒。
        <<if $whitney_home_invite gt 5 and C.npc.Whitney.love gte 30>>
          “来得这么勤，还没听熟？”<<He>>把播放器拨远了些。“想听，自己弄一份。”
        <<else>>
          “行了，别再问了。”<<He>>重新戴上耳机，仍看着你。
        <</if>>
    <</language>>
  <</if>>
  <<unset $phase>>
<</if>>
<br><br><<getouticon>><<lanLink ['Return to the room', '返回房间'] 'Deadwood Whitney Room'>><</lanLink>>

:: Deadwood Whitney Room
<<set $outside to 0>><<set $location to 'flats'>><<effects>>
<<if $whitneyromance is 1 and ['active', 'rescued'].includes(C.npc.Whitney.state)>>
  <<npc Whitney>><<person1>>
  <<deadwood-whitney-pregnancy-link>>
  <<whitneyoptions>>
<<else>>
  <<lanSwitch 'Whitney has gone out.' '惠特尼已经出门了。'>><br><br>
  <<getouticon>><<lanLink ['Leave the flat', '离开公寓'] 'Barb Street'>><</lanLink>>
<</if>>

:: Deadwood Whitney Aftercare
<<set $outside to 1>><<set $location to 'school'>><<schooleffects>><<effects>>
<<if $nextPassage or $nextPassageCheck or $combat or $replayScene or $statFreeze>><<exit>><</if>>
<<deadwood-whitney-aftercare-ready>>
<<if !_whitneyAftercareReady>>
  <<lanSwitch 'You cannot stop to talk with Whitney now.' '你现在没法留下来和惠特尼说话。'>><br><br>
<<else>>
  <<set _aftercareReturning to $WhitneyExpansion.aftercare_day gte 0>>
  <<pass 10>><<schooleffects>>
  <<deadwood-whitney-aftercare-ready true>>
  <<if $passage isnot 'Deadwood Whitney Aftercare'>><<exit>><</if>>
  <<if !_whitneyAftercareReady>>
    <<lanSwitch 'Whitney heads off before you can finish talking.' '还没聊完，惠特尼便走开了。'>><br><br>
    <<getouticon>><<lanLink ['Return to the front courtyard', '返回前庭'] 'School Front Courtyard'>><</lanLink>><<exit>>
  <</if>>
  <<set $WhitneyExpansion.aftercare_day to Time.days>>
  <<set $phase to 'whitney-aftercare-open'>>
  <<npc Whitney>><<person1>>
  <<language>>
    <<option 'EN'>>
      <<if _aftercareReturning>>
        Whitney and <<his>> friends crowd around a phone by the gate. Someone laughs. Whitney pushes the phone away and looks at you.
      <<else>>
        Whitney stands by the gate with <<his>> friends. One of them asks about the days <<he>> disappeared. Whitney's smile vanishes. "Drop it." <<He>> spots you and waves the others away.
      <</if>>
      <<if $LifeSimulation?.school.role is 'president'>>
        <<He>> glances at your badge. "What now? The president come to question me?"
      <<elseif $LifeSimulation?.school.role is 'prefect'>>
        <<His>> eyes settle on your badge. "You writing me up, or what?"
      <<elseif isLoveInterest('Whitney')>>
        "Come here, <<bitch>>." <<He>> catches your sleeve before you have reached <<him>>.
      <<elseif C.npc.Whitney.love gte 20>>
        "You again?" <<He>> folds <<his>> arms, but stays where <<he>> is.
      <<else>>
        "What're you staring at?" <<He>> looks you up and down.
      <</if>>
      <<if $schoolstate is 'afternoon' and $daily.whitney.ball is 'play'>>
        <<He>> nudges your shoe with <<his>>. "You left before the good bit. We won, by the way."
      <<elseif $schoolstate is 'afternoon' and $daily.whitney.ball is 'score'>>
        "There's our fucking referee." Whitney grins. "Still owe me a point."
      <</if>>
    <<option 'CN'>>
      <<if _aftercareReturning>>
        惠特尼和朋友们站在校门边，挤在一部手机前。有人笑出声，<<he>>把手机推开，看向了你。
      <<else>>
        惠特尼和朋友们站在校门边。一人问起<<he>>失踪的几天，<<his>>脸上的笑容立刻没了。“别提了。”<<He>>看见你，挥手让其他人先走。
      <</if>>
      <<if $LifeSimulation?.school.role is 'president'>>
        <<He>>瞥了眼你的徽章。“怎么，会长也来审我了？”
      <<elseif $LifeSimulation?.school.role is 'prefect'>>
        <<His>>目光落在你的徽章上。“要记我的过，还是怎么着？”
      <<elseif isLoveInterest('Whitney')>>
        “过来，<<bitch>>。”你还没走到<<him>>面前，<<he>>就拽住了你的袖子。
      <<elseif C.npc.Whitney.love gte 20>>
        “又是你？”<<He>>抱起胳膊，倒没有走开。
      <<else>>
        “看什么看？”<<He>>把你从头到脚打量了一遍。
      <</if>>
      <<if $schoolstate is 'afternoon' and $daily.whitney.ball is 'play'>>
        <<He>>用鞋尖碰了碰你的鞋。“走那么早，后面的都没看见。我们赢了。”
      <<elseif $schoolstate is 'afternoon' and $daily.whitney.ball is 'score'>>
        “哟，我们的裁判来了。”惠特尼咧嘴笑了。“还欠我一分呢。”
      <</if>>
  <</language>><br><br>
  <<socialiseicon>><<lanLink ['Ask Whitney how their day is going', '问惠特尼今天怎么样'] 'Deadwood Whitney Aftercare Answer'>>
    <<if $passage is 'Deadwood Whitney Aftercare' and $phase is 'whitney-aftercare-open'>><<set $phase to 'whitney-aftercare-space'>><</if>>
  <</lanLink>><br>
  <<if isLoveInterest('Whitney')>>
    <<loveicon>><<lanLink ['Walk with Whitney for a while', '陪惠特尼走一段'] 'Deadwood Whitney Aftercare Answer'>>
      <<if $passage is 'Deadwood Whitney Aftercare' and $phase is 'whitney-aftercare-open'>><<set $phase to 'whitney-aftercare-walk'>><</if>>
    <</lanLink>><br>
  <</if>>
<</if>>
<br><br><<getouticon>><<lanLink ['Return to the front courtyard', '返回前庭'] 'School Front Courtyard'>><</lanLink>>

:: Deadwood Whitney Aftercare Answer
<<set $_aftercareChoice to ['whitney-aftercare-space', 'whitney-aftercare-walk'].includes($phase) ? $phase : null>>
<<if $_aftercareChoice>><<unset $phase>><</if>>
<<set $outside to 1>><<set $location to 'school'>><<schooleffects>><<effects>>
<<deadwood-whitney-aftercare-ready 'answer'>>
<<if !$_aftercareChoice or !_whitneyAftercareReady
  or ($_aftercareChoice is 'whitney-aftercare-walk' and !isLoveInterest('Whitney'))>>
  <span class='blue'><i><<lanSwitch 'There is nothing more to do here.' '这里已经没有别的事可做。'>></i></span>
<<else>>
  <<npc Whitney>><<person1>>
  <<if $_aftercareChoice is 'whitney-aftercare-walk' and isLoveInterest('Whitney')>>
    <<language>>
      <<option 'EN'>>
        You walk beside Whitney towards the doors. <<He>> hooks an arm around your shoulders, steering you past the other students. "Keep up, <<bitch>>." When someone steps into your path, <<he>> tells them to move.
      <<option 'CN'>>
        你陪惠特尼往教学楼走。<<He>>揽住你的肩膀，带着你穿过学生们。“跟上，<<bitch>>。”有人挡在前面，<<he>>便叫那人让路。
    <</language>>
    <<npcincr Whitney love 2>><<glove>><<stress -2>><<lstress>>
  <<else>>
    <<language>>
      <<option 'EN'>>
        <<if $schoolstate is 'afternoon' and $daily.whitney.ball is 'play'>>
          You ask how the game finished. "How d'you think? Guess who scored." Whitney taps <<his>> own chest, grinning. "Next time, try to keep up."
          <<if isLoveInterest('Whitney')>><<He>> hooks a finger into your sleeve as you turn towards the doors.<</if>>
        <<elseif $schoolstate is 'afternoon' and $daily.whitney.ball is 'score'>>
          You remind Whitney that the ball went outside the bags. "Thought you were on my side." <<He>> laughs when you refuse to change the score. "Fine. I'll make you play next time."
        <<elseif isLoveInterest('Whitney')>>
          "Same old shit." Whitney leans against the gate beside you. "You got somewhere to be?" <<He>> catches your sleeve again when you move.
        <<elseif C.npc.Whitney.love gte 20>>
          "I'm here, aren't I?" Whitney kicks a stone away from the gate. "Go on. Don't just stand there." <<He>> waits until you start towards the doors before following.
        <<else>>
          "None of your business, <<bitch>>." Whitney shoves your shoulder, then heads inside without looking back.
        <</if>>
      <<option 'CN'>>
        <<if $schoolstate is 'afternoon' and $daily.whitney.ball is 'play'>>
          你问球局后来怎么样了。“还能怎样？猜猜谁进的球？”惠特尼咧嘴笑着，拍了拍自己的胸口。“下次跟紧点。”
          <<if isLoveInterest('Whitney')>>你转向教学楼时，<<he>>用手指勾住了你的衣袖。<</if>>
        <<elseif $schoolstate is 'afternoon' and $daily.whitney.ball is 'score'>>
          你提醒惠特尼，那球是从书包外面滚过去的。“还以为你站我这边。”你不肯改分，<<he>>反倒笑了。“行。下次让你上场踢。”
        <<elseif isLoveInterest('Whitney')>>
          “还不是那些破事。”惠特尼靠在你身旁的校门上。“你急着去哪儿？”你一动，<<he>>又攥住了你的袖子。
        <<elseif C.npc.Whitney.love gte 20>>
          “这不是好好站着吗？”惠特尼踢开校门边的一颗石子。“走啊。站着干吗？”你开始往教学楼走，<<he>>才跟上。
        <<else>>
          “关你屁事，<<bitch>>。”惠特尼推了一把你的肩膀，随后头也不回地朝教学楼走去。
        <</if>>
    <</language>>
    <<npcincr Whitney love 1>><<glove>>
  <</if>>
<</if>>
<br><br>
<<getinicon>><<lanLink ['Enter the school', '进入学校'] 'Hallways'>><</lanLink>>

:: Deadwood Whitney Pier
<<set $outside to 1>><<set $location to 'docks'>><<effects>>
<<if $nextPassage or $nextPassageCheck or $combat or $replayScene or $statFreeze>><<exit>><</if>>
<<if $whitneyromance isnot 1 or !['active', 'rescued'].includes(C.npc.Whitney.state)
  or Time.dayState is 'night' or Time.schoolTime or isInPark('whitney')
  or $daily?.fishing?.fishingPier?.whitney?.phase is 'bet'
  or ($daily?.fishing?.fishingPier?.whitney?.phase is 'idle' and !['dusk', 'night'].includes(Weather.dayState))
  or Time.hour lt 9 or Time.hour * 60 + Time.minute gt 17 * 60 - 10 or $exposed gt 0 or $WhitneyExpansion.pier_day is Time.days>>
  <<lanSwitch 'Whitney is not around.' '惠特尼不在这附近。'>><br><br>
<<else>>
  <<pass 10>>
  <<if $nextPassage or $nextPassageCheck or $combat or $replayScene or $statFreeze or $location isnot 'docks' or $passage isnot 'Deadwood Whitney Pier'>><<exit>><</if>>
  <<if !['active', 'rescued'].includes(C.npc.Whitney.state) or Time.schoolTime or isInPark('whitney') or Time.dayState is 'night'
    or $daily?.fishing?.fishingPier?.whitney?.phase is 'bet'
    or ($daily?.fishing?.fishingPier?.whitney?.phase is 'idle' and !['dusk', 'night'].includes(Weather.dayState))
    or Time.hour * 60 + Time.minute gt 17 * 60>>
    <<lanSwitch 'Whitney is no longer around.' '惠特尼已经离开了。'>><br><br>
  <<else>>
  <<set $WhitneyExpansion.pier_day to Time.days>>
  <<npc Whitney>><<person1>>
  <<language>>
    <<option 'EN'>>
      <<if Weather.precipitation is 'rain'>>
        Whitney sits on a crate beneath a warehouse awning, rolling a stone between <<his>> fingers. Water drips just beyond <<his>> boots. "Took you long enough, <<bitch>>." <<He>> shifts along the wall, leaving a narrow dry space.
      <<elseif Time.season is 'winter'>>
        Whitney sits on a bollard with <<his>> coat collar turned up. <<He>> throws a stone hard enough to make it skip once, then rubs <<his>> hands together. "What're you staring at? Looking for trouble?"
      <<else>>
        Whitney is sitting on a bollard at the end of the pier, throwing stones into the water. <<He>> does not turn around. "You following me now, or what?"
      <</if>>
    <<option 'CN'>>
      <<if Weather.precipitation is 'rain'>>
        惠特尼坐在货仓雨棚下的木箱上，指间转着一颗石子。水滴落在<<his>>靴子前面。“磨蹭够久的，<<bitch>>。”<<He>>沿墙挪了挪，留出一块干燥的空位。
      <<elseif Time.season is 'winter'>>
        惠特尼坐在系缆桩上，竖起外套领子。<<He>>用力甩出一枚石子，在水面上打了个水漂，随后搓了搓手。“看什么看？皮痒了是吧？”
      <<else>>
        惠特尼坐在码头尽头的系缆桩上，一颗接一颗往水里扔石子。<<He>>头也没回。“怎么，现在学会像条尾巴一样跟着老子了？”
      <</if>>
  <</language>>
  <br><br>
  <<language>>
    <<option 'EN'>>
      You settle beside <<him>>. For a while <<he>> says nothing at all, and the two of you watch the water slide past the pilings. Then <<he>> nudges your leg with <<his>> boot. "Say something or piss off."
    <<option 'CN'>>
      你在<<him>>身旁坐下。有那么一阵子<<he>>什么话也没说，你们只是看着海水从木桩间缓缓流过。随后<<he>>用靴子碰了碰你的腿。“有话就放，没话就滚蛋。”
  <</language>>
  <br><br>
  <<socialiseicon>><<lanLink ['Ask Whitney what they are doing here', '问惠特尼在这儿做什么'] 'Deadwood Whitney Pier Talk'>><<set $phase to 'whitney-pier-talk'>><</lanLink>><br>
  <<if isLoveInterest('Whitney')>>
    <<loveicon>><<lanLink ['Sit close to Whitney for a while', '靠着惠特尼坐一会儿'] 'Deadwood Whitney Pier Lean'>><<set $phase to 'whitney-pier-lean'>><</lanLink>><br>
  <</if>>
  <</if>>
<</if>>
<br><br><<getouticon>><<lanLink ['Leave the pier', '离开码头'] 'Docks'>><</lanLink>>

:: Deadwood Whitney Pier Talk
<<set $outside to 1>><<set $location to 'docks'>><<effects>>
<<if $phase isnot 'whitney-pier-talk' or $whitneyromance isnot 1
  or !['active', 'rescued'].includes(C.npc.Whitney.state)>>
  <span class='blue'><i><<lanSwitch 'There is nothing more to do here.' '这里已经没有别的事可做。'>></i></span>
<<else>>
  <<npc Whitney>><<person1>>
  <<language>>
    <<option 'EN'>>
      <<if Weather.precipitation is 'rain'>>
        "Getting wet. What does it look like?" Whitney watches rain spill from the roof. A worker hurries past with a sack over their head. <<He>> snorts. "At least somebody had a plan." <<He>> flicks the stone out into the rain.
      <<elseif Time.season is 'winter'>>
        "Waiting for the sea to freeze. Then I can walk home." <<He>> looks at you until you realise <<hes>> taking the piss. "What? It's quieter than listening to that lot." <<He>> jerks a thumb towards the street, without saying who <<he>> means.
      <<else>>
        You ask what <<he>> comes here for. Whitney keeps throwing stones. "None of your business." A pause. "It's quiet. That's all." <<He>> throws another stone, harder. "Don't look at me like that."
      <</if>>
    <<option 'CN'>>
      <<if Weather.precipitation is 'rain'>>
        “淋雨啊，不然呢？”惠特尼看着雨水从棚顶泼下来。一个工人把麻袋顶在头上，匆匆跑过。<<He>>哼笑一声。“好歹有人动了脑子。”说完，<<he>>把石子弹进雨里。
      <<elseif Time.season is 'winter'>>
        “等海结冰，走回去。”<<He>>盯着你，直到你反应过来是在拿你寻开心。“怎么？总比听那帮人吵强。”<<He>>朝街上偏了偏拇指，没有说是谁。
      <<else>>
        你问<<he>>来这儿做什么。惠特尼继续扔石子。“关你屁事。”停了一下。“这儿安静。就这个。”<<He>>又扔了一颗，比刚才用力。“别用那种眼神看我。”
      <</if>>
  <</language>>
  <<npcincr Whitney love 1>><<glove>><<stress -1>><<lstress>>
  <<unset $phase>>
<</if>>
<br><br>
<<getinicon>><<lanLink ["Continue","继续"] 'Docks'>><</lanLink>>

:: Deadwood Whitney Pier Lean
<<set $outside to 1>><<set $location to 'docks'>><<effects>>
<<if $phase isnot 'whitney-pier-lean' or $whitneyromance isnot 1
  or !['active', 'rescued'].includes(C.npc.Whitney.state) or !isLoveInterest('Whitney')>>
  <span class='blue'><i><<lanSwitch 'There is nothing more to do here.' '这里已经没有别的事可做。'>></i></span>
<<else>>
  <<npc Whitney>><<person1>>
  <<language>>
    <<option 'EN'>>
      You lean against <<him>>. Whitney drapes an arm around your shoulders and pulls you closer. "Comfortable, <<bitch>>?" <<He>> grins at you. A passing dockworker glances your way. "What are you looking at?" Whitney calls, keeping <<his>> arm where it is. When <<he>> gets up, <<he>> catches your wrist and pulls you along. "Come on."
    <<option 'CN'>>
      你靠过去。惠特尼把手臂搭到你肩上，将你往怀里拉了拉。“舒服吗，<<bitch>>？”<<He>>冲你咧嘴笑了。一个路过的码头工人朝这边看了一眼。“看什么看？”惠特尼朝那人喊道，手臂仍搭在你肩上。起身时，<<he>>攥住你的手腕，将你一并拉了起来。“走了。”
  <</language>>
  <<npcincr Whitney love 2>><<glove>><<npcincr Whitney dom 1>><<gdom>><<stress -2>><<lstress>>
  <<unset $phase>>
<</if>>
<br><br>
<<getinicon>><<lanLink ["Continue","继续"] 'Docks'>><</lanLink>>

:: Deadwood Whitney Flats
<<set $outside to 0>><<set $location to 'flats'>><<effects>>
<<if $nextPassage or $nextPassageCheck or $combat or $replayScene or $statFreeze>><<exit>><</if>>
<<if $whitneyromance isnot 1 or !['active', 'rescued'].includes(C.npc.Whitney.state) or $whitney_home_stage lt 3 or $WhitneyExpansion.flats_day is Time.days
  or !(Time.dayState is 'dawn' or (Time.dayState is 'day' and Weather.precipitation is 'none' and !Time.schoolDay and ![3, 6, 7].includes(Time.weekDay)))>>
  <<lanSwitch 'Whitney has gone back inside.' '惠特尼已经回到屋里。'>><br><br>
<<else>>
  <<set _flatWasDawn to Time.dayState is 'dawn'>>
  <<pass 5>>
  <<if $nextPassage or $nextPassageCheck or $combat or $replayScene or $statFreeze or $location isnot 'flats' or $passage isnot 'Deadwood Whitney Flats' or !['active', 'rescued'].includes(C.npc.Whitney.state)>><<exit>><</if>>
  <<set $WhitneyExpansion.flats_day to Time.days>>
  <<npc Whitney>><<person1>>
  <<if $WhitneyExpansion.rescued>>
    <<language>>
      <<option 'EN'>>
        Whitney keeps a hand on the door. For a moment <<he>> does not say anything, and <<his>> grip on the frame loosens. Then <<he>> catches himself and pulls the door back to the width it was. "That business at the brothel," <<he>> says quietly, eyes narrowing. "Don't ever bring it up in here. Understood?"
      <<option 'CN'>>
        惠特尼一只手扶着门。有一瞬间<<he>>什么话也没说，扣着门框的手指微微松开。随即<<he>>像被烫到一样回过神，把门拉回原来的宽度。“妓院里的那档子事，”<<he>>压低声音，目光沉了下来，“进了这个门就别再提。听明白了没？”
    <</language>>
  <<else>>
    <<language>>
      <<option 'EN'>>
        Whitney stays in the doorway, looking you over. "You came all this way just to talk?" <<He>> leans on the frame and waits, letting you hear how stupid the excuse sounds.
      <<option 'CN'>>
        惠特尼倚在门口，把你从头看到脚。“跑这么远过来，就为了说几句话？”<<He>>靠着门框等你开口，摆明了在等你听出这借口有多站不住脚。
    <</language>>
  <</if>>
  <<npcincr Whitney love 1>><<glove>>
  <br><br>
  <<getinicon>>
  <<if _flatWasDawn>>
    <<lanLink ['Ask to come in', '请求进屋'] 'Whitney Home Knock Dawn'>><</lanLink>>
  <<else>>
    <<lanLink ['Enter the flat', '走进公寓'] 'Whitney Home Enter'>><</lanLink>>
  <</if>>
<</if>>
<br><br>
<<getouticon>><<lanLink ['Leave', '离开'] 'Barb Street'>><</lanLink>>

  <<if $RobinExpansion.selfRent and $RobinExpansion.asylum.status isnot 'admitted' and $robinmissing is 0 and $robinnote isnot 1 and $robinromance isnot 1 and C.npc.Robin.lust gte 10 and C.npc.Robin.love gte 60 and C.npc.Robin.trauma lt 10>>

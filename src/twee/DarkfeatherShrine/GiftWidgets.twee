:: Deadwood Raven Shrine Gift Widgets [widget]

<<widget 'deadwood-raven-gift-context'>>
  <<deadwood-raven-home-context>>
  <<set _shrineGiftPerson to _shrine?.stage is 3 and C.npc.Tsukihan?.init is 1
    and (($location is 'forest_raven_shrine' and _shrinePerson) or ($location is 'raven_shrine_house' and _shrineHome and _shrineHomeAwake))>>
  <<set _shrineGiftMinutes to $location is 'raven_shrine_house' ? _shrineHomeMinutes : _shrineMinutes>>
  <<set _shrineGiftReady to _shrineGiftPerson and !pcAreArmsBound('both') and _shrineGiftMinutes gt 5 and $daily.giftedFood.Tsukihan is undefined>>
<</widget>>

<<widget 'deadwood-raven-gift-link'>>
  <<deadwood-raven-gift-context>>
  <<if _shrineGiftPerson>>
    <<skinicon 'give'>><<lanLink ['Give Tsukihan something', '给月羽带点东西'] 'Deadwood Raven Shrine Gifts'>><</lanLink>><br>
  <</if>>
<</widget>>

<<widget 'deadwood-raven-gift-give'>>
  <<set $_shrineOffered to $gift, _shrineGiftSource to $passage, _shrineGiftLocation to $location>>
  <<deadwood-raven-gift-context>>
  <<if !_shrineGiftReady or $passage isnot 'Deadwood Raven Shrine Gifts'
    or !['dish', 'flower'].includes(setup.foodstuff[$_shrineOffered]?.category) or ($foodstuff[$_shrineOffered]?.amount ?? 0) lt 1>><<exit>><</if>>
  <<if setup.foodstuff[$_shrineOffered].category is 'dish' and !canGiftFood('Tsukihan')>><<exit>><</if>>
  <<pass 5>><<deadwood-raven-gift-context>>
  <!-- 点击时与耗时后均检查。赠礼日次、库存扣除和喜好记录沿用原版。 -->
  <<if !_shrineGiftPerson or pcAreArmsBound('both') or $daily.giftedFood.Tsukihan isnot undefined
    or $passage isnot _shrineGiftSource or $location isnot _shrineGiftLocation
    or !['dish', 'flower'].includes(setup.foodstuff[$_shrineOffered]?.category) or ($foodstuff[$_shrineOffered]?.amount ?? 0) lt 1>><<exit>><</if>>
  <<if setup.foodstuff[$_shrineOffered].category is 'dish' and !canGiftFood('Tsukihan')>><<exit>><</if>>
  <<set $gift to $_shrineOffered>><<give_gift 'Tsukihan'>>
  <<set $_shrineGiftLove to $_shrineOffered is 'shortbread' or ($_shrineOffered is 'valentines_chocolate' and $valentines) ? 3 : 1>>
  <<set C.npc.Tsukihan.love to Math.clamp(C.npc.Tsukihan.love + $_shrineGiftLove, 0, 100)>>
  <<if $_shrineOffered is 'shortbread'>><<saveFavoriteFood 'Tsukihan' $_shrineOffered>><</if>>
<</widget>>

<<widget 'deadwood-raven-gift-return'>>
  <<if $location is 'raven_shrine_house'>>
    <<getouticon>><<lanLink ['Return to the room', '回到房里'] 'Deadwood Raven Shrine Room'>>
      <<set $MoreTransformations.shrine.scene to '', $MoreTransformations.shrine.step to ''>>
    <</lanLink>><br>
  <<else>>
    <<deadwood-raven-shrine-return 'veranda'>>
  <</if>>
<</widget>>

<!-- 原版赠礼记录保存当天的物品名；这里只展示留下的东西，不再扣物或结算。 -->
<<widget 'deadwood-raven-gift-memory'>>
  <<set $_gift_memory to $daily.giftedFood.Tsukihan>>
  <<if setup.foodstuff[$_gift_memory]?.category is 'flower'>>
    <<capture $_gift_memory>><<language>>
      <<option 'EN'>>
        The <<recipe_name $_gift_memory>> you brought stands in a little glass jar beside the book. Its stem has been trimmed to fit.
        <<if _shrineHomeAwake>>Tsukihan catches you looking. "It stays there. I can see it while I read."<</if>>
      <<option 'CN'>>
        你带来的<<recipe_name $_gift_memory>>插在书边的小玻璃罐里，花茎已经剪到合适的长短。
        <<if _shrineHomeAwake>>月羽顺着你的目光看过去。“就放这里。看书时也能看见。”<</if>>
    <</language>><</capture>><br><br>
  <<elseif $_gift_memory is 'shortbread'>>
    <<language>>
      <<option 'EN'>>
        The shortbread you brought is covered beside the cups.
        <<if _shrineHomeAwake>>"I kept some," Tsukihan says. <<if ['talk', 'read'].includes(_shrine.home_action)>><<He>> moves the plate between you. "You can have a piece. Mind the crumbs on the book."<<else>><<He>> lifts the cover to show you, then puts it back. "For when we sit down."<</if>><</if>>
      <<option 'CN'>>
        你带来的酥饼盖着罩子，放在杯子旁。
        <<if _shrineHomeAwake>>“留了一些。”月羽说。<<if ['talk', 'read'].includes(_shrine.home_action)>><<He>>把盘子挪到你们中间。“分你一块。别把饼屑掉在书上。”<<else>><<He>>揭开罩子给你看，又盖了回去。“等坐下来再吃。”<</if>><</if>>
    <</language>><br><br>
  <<elseif $_gift_memory is 'valentines_chocolate' and $valentines>>
    <<language>>
      <<option 'EN'>>
        The heart-shaped box you gave Tsukihan has a place on the table, clear of the loose papers.
        <<if _shrineHomeAwake>>"I didn't forget," <<he>> says when you notice it. "I wanted you here too."<</if>>
      <<option 'CN'>>
        你送的心形盒子摆在桌上，零散的纸张已经挪开，给它留出了地方。
        <<if _shrineHomeAwake>>见你留意到盒子，月羽说：“没忘呢。想等你也在的时候。”<</if>>
    <</language>><br><br>
  <</if>>
<</widget>>

:: Deadwood Raven Shrine Widgets [widget]

<!-- 神社属于更多转化。原版地点只插入入口，自己的剧情、条件与结算留在 Twee。 -->
<<widget 'deadwood-raven-shrine-context'>>
  <<set _shrineModule to maplebirch.get('MoreTransformations')>>
  <<set _shrine to _shrineModule ? $MoreTransformations?.shrine : null>>
  <!-- 补入旧果树记录。独立保留已经采过的次数，换树不丢进度。 -->
  <<if _shrine and !$statFreeze and !$replayScene>>
    <<set _shrine.harvests to Math.max(_shrine.harvests, $Orchard?.shrine?.reduce((total, tree) => total + (tree?.harvests ?? 0), 0) ?? 0)>>
  <</if>>
  <<set _shrineTravel to !!_shrine and !$combat and !$replayScene and !$statFreeze and !$frozenValues and !$nextPassage and !$nextPassageCheck>>
  <<set _shrineSafe to _shrineTravel and !$possessed and $stress lt $stressmax and $foresthunt lt 1>>
  <<set _shrineTsukihanLocation to maplebirch.npc.Schedule.location.Tsukihan>>
  <<set _shrinePresent to !!_shrine and Time.hour gte 9 and Time.hour lt 18 and !Weather.bloodMoon
    and _shrineTsukihanLocation is 'forest_raven_shrine'
    and $location is 'forest_raven_shrine' and (C.npc.Tsukihan?.init is 0 or C.npc.Tsukihan?.state is 'active')>>
  <<set _shrinePerson to _shrineSafe and _shrinePresent>>
  <<set _shrineMinutes to (Time.hour lt 12 ? (Time.weekDay is 3 and Time.hour lt 10 ? 10 : 12) : Time.hour lt 16 ? 16 : 18) * 60 - Time.hour * 60 - Time.minute>>
  <<set _shrineConfessionReady to _shrinePerson and !_shrine.confessed and C.npc.Tsukihan?.love gte 100 and _shrine.feelings isnot Math.floor(Time.days)
    and _shrineMinutes gt 10 and !$daily.no_sing and !$worn.face.type.includes('gag')>>
  <<set _shrineGwylan to _shrineSafe and $location is 'forest_shop' and $forest_shop_intro is 1
    and C.npc.Gwylan.init is 1 and $npc?.includes('Gwylan')
    and ['Gwylan Talk Shop', 'Deadwood Raven Gwylan'].includes($passage) and C.npc.Gwylan.state is 'active' and gwylanSchedule() is 'shop' and !isGwylanAbsent()
    and !$daily.gwylan.noTalk and !$robin_in_forest_shop and !$gwylan.punishment and !$gwylan.taken and !$gwylan.timer.wrap and !$gwylan.timer.eventShopEnd>>
<</widget>>

<<widget 'deadwood-raven-shrine-presence'>>
  <<deadwood-raven-shrine-context>>
  <!-- 休息跨过接待时间后，只结束月羽的在场状态，保留强制场景中的演员。 -->
  <<if !_shrinePresent and !$combat and !$nextPassage and !$nextPassageCheck and !$replayScene and !$statFreeze and $npc?.includes('Tsukihan')>>
    <<endnpc 'Tsukihan'>>
  <</if>>
<</widget>>

<<widget 'deadwood-raven-shrine-action-check'>>
  <<set _shrineCanAct to true>>
  <<if ['walk', 'kiss', 'sex'].includes(_shrineChoice) and pcAreArmsBound('any')>><<set _shrineCanAct to false>><<exit>><</if>>
  <<if ['talk', 'tea', 'kiss', 'sex', 'feelings', 'close'].includes(_shrineChoice) and ($daily.no_sing or $worn.face.type.includes('gag'))>><<set _shrineCanAct to false>><<exit>><</if>>
  <<if _shrineChoice is 'tea' and (C.npc.Tsukihan.love lt 10 or pcAreArmsBound('both'))>><<set _shrineCanAct to false>><<exit>><</if>>
  <<if _shrineChoice is 'walk' and (C.npc.Tsukihan.love lt 20 or $leftleg is 'bound' or $rightleg is 'bound')>><<set _shrineCanAct to false>><<exit>><</if>>
  <<if _shrineChoice is 'kiss' and (!isLoveInterest('Tsukihan') or C.npc.Tsukihan.love lt 20)>><<set _shrineCanAct to false>><<exit>><</if>>
  <<if _shrineChoice is 'sex' and (!isLoveInterest('Tsukihan') or C.npc.Tsukihan.love lt 30)>><<set _shrineCanAct to false>><<exit>><</if>>
  <<if _shrineChoice is 'feelings' and (_shrine.confessed or C.npc.Tsukihan.love lt 100)>><<set _shrineCanAct to false>><<exit>><</if>>
  <<if _shrineChoice is 'close' and (!isLoveInterest('Tsukihan') or C.npc.Tsukihan.love lt 50 or pcAreArmsBound('both') or _shrine.scene isnot 'close' or _shrine.step isnot '')>><<set _shrineCanAct to false>><<exit>><</if>>
  <<if _shrineChoice is 'donate' and ($money lt 500 or pcAreArmsBound('both'))>><<set _shrineCanAct to false>><<exit>><</if>>
<</widget>>

<<widget 'deadwood-raven-shrine-act'>>
  <<set _shrineDone to false, _shrineChoice to _args[0]>>
  <<deadwood-raven-shrine-context>>
  <<if !_shrineSafe or _shrine.stage isnot 3 or $location isnot 'forest_raven_shrine'>><<exit>><</if>>
  <<set $_shrineKey to ['work', 'prayer', 'rest', 'talk', 'tea', 'walk', 'kiss', 'sex', 'feelings', 'close'].includes(_shrineChoice) ? _shrineChoice : _shrineChoice is 'donate' ? 'prayer' : ''>>
  <<if !$_shrineKey or _shrine[$_shrineKey] is Math.floor(Time.days)>><<exit>><</if>>
  <<set $_shrineCompany to ['work', 'talk', 'tea', 'walk', 'kiss', 'sex', 'feelings', 'close'].includes(_shrineChoice)>>
  <<if $_shrineCompany and !_shrinePerson>><<exit>><</if>>
  <<if $_shrineCompany and C.npc.Tsukihan.init isnot 1>><<exit>><</if>>
  <<deadwood-raven-shrine-action-check>>
  <<if !_shrineCanAct or (_shrineChoice is 'close' and $passage isnot 'Deadwood Raven Shrine Close')>><<exit>><</if>>
  <<set $_shrineDuration to _shrineChoice is 'sex' ? 30 : _shrineChoice is 'kiss' ? 5 : _shrineChoice is 'walk' ? 20 : ['talk', 'rest', 'feelings', 'close'].includes(_shrineChoice) ? 10 : 15>>
  <<if $_shrineCompany and _shrineMinutes lte $_shrineDuration>><<exit>><</if>>
  <<set $_shrineTopic to _args[1]>>
  <<if _shrineChoice is 'talk'>>
    <<if $_shrineTopic is undefined>>
      <<set $_shrineTopics to C.npc.Tsukihan.love gte 10 ? ['shrine', 'birds', 'town', 'personal'] : ['shrine', 'birds', 'town']>>
      <<set $_shrineTopic to $_shrineTopics[(Math.floor(Time.days) + _shrine.helped + _shrine.walks) % $_shrineTopics.length]>>
    <<elseif !['shrine', 'birds', 'town', 'personal'].includes($_shrineTopic)>><<exit>><</if>>
  <</if>>
  <<set _shrineSource to $passage>>
  <<pass $_shrineDuration>>
  <!-- 耗时后重查地点、营业时间和强制场景，再扣款、记次数并发放收益。 -->
  <<deadwood-raven-shrine-context>>
  <<if !_shrineSafe or _shrine.stage isnot 3 or $passage isnot _shrineSource or $location isnot 'forest_raven_shrine'>><<exit>><</if>>
  <<if $_shrineCompany and C.npc.Tsukihan.init isnot 1>><<exit>><</if>>
  <<if $_shrineCompany and !_shrinePerson>>
    <<set $nextPassage to 'Deadwood Raven Shrine'>><<exit>>
  <</if>>
  <<deadwood-raven-shrine-action-check>>
  <<if !_shrineCanAct>><<set $nextPassage to 'Deadwood Raven Shrine'>><<exit>><</if>>
  <<set _shrine[$_shrineKey] to Math.floor(Time.days), _shrine.action to _shrineChoice, _shrineDone to true>>
  <<set _shrine.scene to _shrineChoice, _shrine.step to ''>>
  <<switch _shrineChoice>>
    <<case 'prayer' 'donate'>>
      <<stress -6>><<trauma -1>><<run maplebirch.get('Psyche')?.rest(5, -100)>>
      <<if _shrineChoice is 'donate'>><<money -500>><<set _shrine.donations += 500>><</if>>
      <<if _shrine.donations gte 2500>><<stress -3>><</if>>
      <<if _shrine.wish.count gte 7>><<trauma -1>><</if>>
      <<if _shrine.donations gte 10000>><<tiredness -3>><</if>>
    <<case 'rest'>>
      <<stress -3>><<tiredness -6>><<run maplebirch.get('Psyche')?.change(0, -100)>>
      <<if _shrine.donations gte 5000>><<tiredness -3>><</if>>
    <<case 'talk'>>
      <<set _shrine.topic to $_shrineTopic>><<stress -2>><<set C.npc.Tsukihan.love to Math.clamp(C.npc.Tsukihan.love + 1, 0, 100)>>
    <<case 'tea'>>
      <<stress -2>><<deadwood-taste>><<stress -3>><</deadwood-taste>><<tiredness -3>><<set C.npc.Tsukihan.love to Math.clamp(C.npc.Tsukihan.love + 2, 0, 100)>>
    <<case 'walk'>>
      <<set _shrine.walks += 1>><<stress -4>><<trauma -1>><<set C.npc.Tsukihan.love to Math.clamp(C.npc.Tsukihan.love + 3, 0, 100)>>
    <<case 'sex'>>
      <<set $sexstart to 1, _shrine.sex to Math.floor(Time.days)>>
      <<stress -8>><<tiredness 10>>
      <<set C.npc.Tsukihan.love to Math.clamp(C.npc.Tsukihan.love + 2, 0, 100)>>
      <<set C.npc.Tsukihan.lust to Math.clamp((C.npc.Tsukihan.lust || 0) + 15, 0, 100)>>
    <<case 'close'>>
      <<stress -4>><<set C.npc.Tsukihan.love to Math.clamp(C.npc.Tsukihan.love + 2, 0, 100)>>
  <</switch>>
  <<if ['talk', 'tea', 'walk', 'close'].includes(_shrineChoice) and C.npc.Tsukihan.love gte 20>><<run maplebirch.get('Psyche')?.rest(5, -100)>><</if>>
<</widget>>

<<widget 'deadwood-raven-shrine-wish-progress'>>
  <<if !maplebirch.get('MoreTransformations') or $MoreTransformations?.shrine?.stage isnot 3 or $combat or $statFreeze or $replayScene or $nextPassage or $nextPassageCheck>><<exit>><</if>>
  <<if _args[0] is 'harvest'>>
    <<set $MoreTransformations.shrine.harvests to Math.max($MoreTransformations.shrine.harvests + 1, $Orchard?.shrine?.reduce((total, tree) => total + (tree?.harvests ?? 0), 0) ?? 0)>>
  <</if>>
  <<set $_wishProgress to $MoreTransformations?.shrine?.wish>>
  <<if $_wishProgress and !$_wishProgress.returned and $_wishProgress.kind is _args[0]
    and (_args[0] isnot 'peace' or Math.floor(Time.days) gt $_wishProgress.day)>>
    <<set $_wishProgress.ready to true>>
  <</if>>
<</widget>>

<<widget 'deadwood-raven-shrine-skill'>>
  <<if maplebirch.get('MoreTransformations') and ($MoreTransformations?.shrine?.harvests ?? 0) gte 3>>
    <<set _tendingConfig.modifier to Math.floor(_tendingConfig.modifier * 1.07)>>
    <<run _tendingConfig.modTypes.good.pushUnique(maplebirch.t('deadwood-reblooms:Traits:springglow:name'))>>
  <</if>>
<</widget>>

<<widget 'deadwood-raven-shrine-step'>>
  <<set $_shrineReply to _args[0], _shrineScene to _args[1], _shrineMemory to _args[2], _shrinePrevious to _args[3] ?? ''>>
  <<deadwood-raven-shrine-context>>
  <<if !_shrinePerson or _shrine.stage isnot 3 or C.npc.Tsukihan.init isnot 1 or _shrine.scene isnot _shrineScene or _shrine.step isnot _shrinePrevious>><<exit>><</if>>
  <<set $_shrinePages to { intro: 'Deadwood Raven Shrine Intro', work: 'Deadwood Raven Shrine Work', tea: 'Deadwood Raven Shrine Tea', walk: 'Deadwood Raven Shrine Walk', talk: 'Deadwood Raven Shrine Talk', kiss: 'Deadwood Raven Shrine Together', feelings: 'Deadwood Raven Shrine Feelings' }>>
  <<if $passage isnot $_shrinePages[_shrineScene] and !(_shrineScene is 'intro' and $passage is 'Deadwood Raven Shrine')>><<exit>><</if>>
  <<set $_shrineReplies to { intro: ['polite', 'birds', 'quiet'], work: ['tie', 'steps', 'offerings', 'company'], tea: ['learn', 'joke', 'watch'], walk: ['hand', 'along', 'shelter'], talk: ['ask', 'tell', 'listen', 'formal'], kiss: ['kiss', 'hug', 'stop'], feelings: ['accept', 'wait', 'friend'] }>>
  <<if _shrineScene is 'tea' and ['learn', 'joke', 'watch'].includes(_shrinePrevious)>>
    <<if !['keep', 'return_paper'].includes($_shrineReply)>><<exit>><</if>>
  <<elseif _shrinePrevious isnot '' or !$_shrineReplies[_shrineScene]?.includes($_shrineReply)>><<exit>>
  <</if>>
  <<if _shrineScene is 'work' and $_shrineReply isnot 'company' and pcAreArmsBound('any')>><<exit>><</if>>
  <<if _shrineScene is 'intro' and $_shrineReply isnot 'quiet' and ($daily.no_sing or $worn.face.type.includes('gag'))>><<exit>><</if>>
  <<if $_shrineReply is 'hand' and (!isLoveInterest('Tsukihan') or C.npc.Tsukihan.love lt 20 or pcAreArmsBound('any'))>><<exit>><</if>>
  <<if _shrineScene is 'kiss' and ['kiss', 'hug'].includes($_shrineReply) and (!isLoveInterest('Tsukihan') or C.npc.Tsukihan.love lt 20 or pcAreArmsBound('any'))>><<exit>><</if>>
  <<if _shrineScene is 'kiss' and $_shrineReply is 'kiss' and ($daily.no_sing or $worn.face.type.includes('gag'))>><<exit>><</if>>
  <<if _shrineScene is 'feelings' and (C.npc.Tsukihan.love lt 100 or $daily.no_sing or $worn.face.type.includes('gag') or $_shrineReply is 'friend' and isLoveInterest('Tsukihan'))>><<exit>><</if>>
  <<set _shrine.step to $_shrineReply>>
  <!-- 任性衡量是否惯着小脾气。亲密互动的好感与欲望单独结算。 -->
  <<if _shrineScene is 'talk' and $_shrineReply is 'formal'>>
    <<set C.npc.Tsukihan.dom to Math.clamp(C.npc.Tsukihan.dom - 2, 0, 100)>>
  <<elseif _shrineScene is 'tea' and $_shrineReply is 'joke'>>
    <<set C.npc.Tsukihan.dom to Math.clamp(C.npc.Tsukihan.dom + 1, 0, 100)>>
  <</if>>
  <<if ['bell', 'paper_raven'].includes(_shrineMemory)>><<set _shrine.memory to _shrineMemory>><</if>>
  <<if _shrineScene is 'intro' and $_shrineReply is 'polite'>>
    <<set C.npc.Tsukihan.love to Math.clamp(C.npc.Tsukihan.love + 1, 0, 100)>>
  <<elseif _shrineScene is 'work'>>
    <<stress -2>>
    <<if C.npc.Tsukihan.love gte 20>><<run maplebirch.get('Psyche')?.rest(5, -100)>><</if>>
    <<if $_shrineReply is 'company'>><<set C.npc.Tsukihan.love to Math.clamp(C.npc.Tsukihan.love + 1, 0, 100)>>
    <<else>><<set _shrine.helped += 1>><<housekeeping 2>><<set C.npc.Tsukihan.love to Math.clamp(C.npc.Tsukihan.love + 2, 0, 100)>><</if>>
  <<elseif $_shrineReply is 'hand'>>
    <<set C.npc.Tsukihan.lust to Math.clamp((C.npc.Tsukihan.lust || 0) + 2, 0, 100)>>
    <<takeHandholdingVirginity 'Tsukihan' 'romantic'>>
  <<elseif _shrineScene is 'kiss' and $_shrineReply is 'kiss'>>
    <<stress -3>><<set C.npc.Tsukihan.love to Math.clamp(C.npc.Tsukihan.love + 1, 0, 100), C.npc.Tsukihan.lust to Math.clamp((C.npc.Tsukihan.lust || 0) + 5, 0, 100)>><<takeKissVirginity 'Tsukihan' 'loveInterest'>>
  <<elseif _shrineScene is 'kiss' and $_shrineReply is 'hug'>>
    <<stress -3>><<set C.npc.Tsukihan.love to Math.clamp(C.npc.Tsukihan.love + 1, 0, 100)>>
  <<elseif _shrineScene is 'feelings' and $_shrineReply is 'accept'>>
    <<set _shrine.confessed to true>>
    <<if !isLoveInterest('Tsukihan')>><<silently>><<loveInterestAdd 'Tsukihan'>><</silently>><</if>>
  <</if>>
<</widget>>

<<widget 'deadwood-raven-shrine-favour'>>
  <<set $_shrineFavour to _args[0]>>
  <<deadwood-raven-shrine-context>>
  <<if !_shrinePerson or _shrine.stage isnot 3 or C.npc.Tsukihan.init isnot 1 or $passage isnot 'Deadwood Raven Shrine Favour'>><<exit>><</if>>
  <<set $_shrineFavourDay to Math.floor(Time.days), _shrinePromise to _shrine.promise>>
  <<if _shrinePromise gte 0>>
    <<if !['deliver', 'apology'].includes($_shrineFavour)>><<exit>><</if>>
  <<else>>
    <<if C.npc.Tsukihan.love lt 10 or _shrine.favour is $_shrineFavourDay>><<exit>><</if>>
    <<if !['stay', 'gift', 'promise', 'decline'].includes($_shrineFavour)>><<exit>><</if>>
    <<if $_shrineFavour is 'stay' and $_shrineFavourDay % 2 isnot 0>><<exit>><</if>>
    <<if ['gift', 'promise'].includes($_shrineFavour) and $_shrineFavourDay % 2 isnot 1>><<exit>><</if>>
  <</if>>
  <<set $_shrineFavourFruit to ['gift', 'deliver'].includes($_shrineFavour), _shrineFavourTimed to $_shrineFavour is 'stay' or $_shrineFavourFruit>>
  <<if $_shrineFavourFruit and (($foodstuff?.strawberry?.amount ?? 0) lt 1 or pcAreArmsBound('both'))>><<exit>><</if>>
  <<if _shrineFavourTimed>>
    <<if _shrineMinutes lte 5>><<exit>><</if>>
    <<pass 5>><<deadwood-raven-shrine-context>>
    <<if !_shrinePerson or _shrine.stage isnot 3 or C.npc.Tsukihan.init isnot 1 or $passage isnot 'Deadwood Raven Shrine Favour' or _shrine.promise isnot _shrinePromise>><<exit>><</if>>
    <<if _shrinePromise lt 0 and C.npc.Tsukihan.love lt 10>><<exit>><</if>>
    <<if _shrinePromise lt 0 and _shrine.favour is Math.floor(Time.days)>><<exit>><</if>>
    <<if $_shrineFavourFruit and (($foodstuff?.strawberry?.amount ?? 0) lt 1 or pcAreArmsBound('both'))>><<exit>><</if>>
  <</if>>
  <<set _shrine.favour to Math.floor(Time.days), _shrine.favour_result to $_shrineFavour, _shrine.favour_late to _shrinePromise gte 0 and Math.floor(Time.days) gt _shrinePromise>>
  <<set $_shrineFavourLove to 0, $_shrineFavourWill to 0>>
  <<switch $_shrineFavour>>
    <<case 'stay'>>
      <<set $_shrineFavourLove to 2, $_shrineFavourWill to 2>><<stress -2>>
    <<case 'gift'>>
      <<set $foodstuff.strawberry.amount -= 1, $_shrineFavourLove to 2, $_shrineFavourWill to 2>>
    <<case 'promise'>>
      <<set _shrine.promise to Math.floor(Time.days) + 1, $_shrineFavourWill to 1>>
    <<case 'decline'>>
      <<set $_shrineFavourWill to -2>>
    <<case 'deliver'>>
      <<set $foodstuff.strawberry.amount -= 1, $_shrineFavourLove to _shrine.favour_late ? 1 : 2, $_shrineFavourWill to -1, _shrine.promise to -1>>
      <<if _shrine.favour_late>><<set _shrine.favour_result to 'late'>><</if>>
    <<case 'apology'>>
      <<set $_shrineFavourLove to _shrine.favour_late ? -1 : 0, $_shrineFavourWill to -2, _shrine.promise to -1>>
  <</switch>>
  <<set C.npc.Tsukihan.love to Math.clamp(C.npc.Tsukihan.love + $_shrineFavourLove, 0, 100)>>
  <<set C.npc.Tsukihan.dom to Math.clamp(C.npc.Tsukihan.dom + $_shrineFavourWill, 0, 100)>>
<</widget>>

<<widget 'deadwood-tsukihan-wilfulness-hint'>>
  <<if $statFreeze isnot true and !$replayScene and !$settings.blindStatsEnabled>> | <span class='purple'><<= _args[0] lt 0 ? '− ' : '+ ' >><<lanSwitch 'Wilfulness' '任性'>></span><</if>>
<</widget>>

<<widget 'deadwood-raven-shrine-return'>>
  <<deadwood-raven-shrine-context>>
  <<if _shrine?.stage is 3 and $location is 'forest_raven_shrine'>>
    <<set _shrineReturn to ['veranda', 'pond'].includes(_args[0]) ? _args[0] : 'courtyard'>>
    <<capture _shrineReturn>>
      <<getouticon>><<lanLink [_shrineReturn is 'veranda' ? 'Return to the veranda' : _shrineReturn is 'pond' ? 'Return to the pond' : 'Return to the courtyard', _shrineReturn is 'veranda' ? '回到廊下' : _shrineReturn is 'pond' ? '回到池边' : '返回神社庭院'] `_shrineReturn is 'veranda' ? 'Deadwood Raven Shrine Veranda' : _shrineReturn is 'pond' ? 'Deadwood Raven Shrine Pond' : 'Deadwood Raven Shrine'`>>
        <<deadwood-raven-shrine-context>>
        <<if _shrineTravel and _shrine.stage is 3 and $location is 'forest_raven_shrine'>>
          <<set _shrine.scene to '', _shrine.step to '', _shrine.favour_result to ''>><<endevent>>
        <</if>>
      <</lanLink>><br>
    <</capture>>
  <<else>>
    <<getouticon>><<lanLink ['Return to the forest', '返回森林'] 'Forest'>>
      <<if !$combat and !$nextPassage and !$nextPassageCheck and !$replayScene and !$statFreeze>>
        <<set $location to 'forest', $outside to 1, $eventskip to 1>><<endevent>>
      <</if>>
    <</lanLink>><br>
  <</if>>
<</widget>>

<<widget 'Tsukihanrelationshiptext'>>
  <<if C.npc.Tsukihan.pronoun is 'm'>>
    <<lanSwitch 'serves as the shrine priest and ' '在神社担任神官，'>>
  <<else>>
    <<lanSwitch 'serves as the shrine maiden and ' '在神社担任巫女，'>>
  <</if>>
  <<if isLoveInterest('Tsukihan') and C.npc.Tsukihan.love gte 20>>
    <<if C.npc.Tsukihan.dom gte 70>>
      <<lanSwitch '<span class="pink">wants your time and little indulgences</span>, and sometimes sulks when you have other plans.' '<span class="pink">想让你多陪着、顺着自己的小心意</span>，你另有安排时，偶尔也会闹点别扭。'>>
    <<elseif C.npc.Tsukihan.dom gte 30>>
      <<lanSwitch '<span class="pink">finds little reasons to keep you nearby</span>, then tries to sound as though it hardly matters.' '<span class="pink">会找些小由头留你在身旁</span>，说完又装作没怎么在意。'>>
    <<else>>
      <<lanSwitch '<span class="pink">keeps a place for you</span>, though invitations still come wrapped in polite excuses.' '<span class="pink">总给你留着位置</span>，开口挽留时却还要找个客气的由头。'>>
    <</if>>
  <<elseif C.npc.Tsukihan.love gte 30>>
    <<if C.npc.Tsukihan.dom gte 70>>
      <<lanSwitch '<span class="green">is comfortable making little demands of you</span>, though your answer may earn a pout.' '<span class="green">熟到会向你提些小要求</span>，不合心意时，也会露出一点小脾气。'>>
    <<else>>
      <<lanSwitch '<span class="green">quietly makes room for your visits</span> in the shrine routine.' '<span class="green">会在神社的日常里，悄悄给你留出空闲</span>。'>>
    <</if>>
  <<elseif C.npc.Tsukihan.love gte 10>>
    <<lanSwitch '<span class="teal">welcomes your visits</span>, while keeping the conversation courteous.' '<span class="teal">欢迎你来作客</span>，交谈时仍很讲礼数。'>>
  <<else>>
    <<lanSwitch 'receives you with <span class="blue">formal courtesy</span>.' '对你<span class="blue">客气而疏淡</span>。'>>
  <</if>>
<</widget>>

<<widget 'deadwood-raven-shrine-journal'>>
  <<if maplebirch.get('MoreTransformations') and $MoreTransformations?.shrine>>
    <<set $_shrineNote to $MoreTransformations.shrine>>
    <<if $_shrineNote.stage gt 0 or $_shrineNote.feeds gt 0>>
      <div class='purple bold'><<lanSwitch 'The ravens’ letter' '渡鸦的来信'>></div>
      <ul class='journal'><li>
        <<switch $_shrineNote.stage>>
          <<case 0>>
            <<if $_shrineNote.feeds gte 3>>
              <<lanSwitch 'A familiar raven is carrying a letter. Look for it in the forest or old churchyard, or by the park bench in the morning or evening before dark.' '一只熟悉的渡鸦衔着信。去森林、老教堂墓地，或早晚天未黑时的公园长椅旁找找它。'>>
            <<else>>
              <<lanSwitch 'The birds are becoming used to you. Bring blackberries, strawberries or an apple on three separate days.' '鸟群渐渐熟悉了你。带上黑莓、草莓或苹果，分三天去喂喂它们吧。'>>
              <span class='teal'><<= $_shrineNote.feeds>> / 3</span>
            <</if>>
          <<case 1>>
            <<lanSwitch 'The letter is addressed to Gwylan at the forest shop.' '信是给森林商店的格威岚的。'>>
          <<case 2>>
            <<lanSwitch 'Gwylan marked a side path in the woods a little beyond the outskirts (forest depth 20–40). Follow it to Darkfeather Shrine. Tsukihan receives visitors at 09:00–12:00, 13:00–16:00 and 17:00–18:00; on Tuesdays, 10:00–12:00 is spent shopping in town.' '格威岚标出了外缘稍深处的岔路（森林深度20～40）。沿参道可到黯羽神社。月羽在9:00～12:00、13:00～16:00和17:00～18:00接待来客。周二10:00～12:00会进镇采购。'>>
          <<case 3>>
            <<lanSwitch 'The path to Darkfeather Shrine lies at forest depth 20–40. Tsukihan receives visitors at 09:00–12:00, 13:00–16:00 and 17:00–18:00; on Tuesdays, 10:00–12:00 is spent shopping in town.' '黯羽神社的参道在森林深度20～40。月羽在9:00～12:00、13:00～16:00和17:00～18:00接待来客。周二10:00～12:00会进镇采购。'>>
            <<if $_shrineNote.home_invited and C.npc.Tsukihan?.state is 'active' and isLoveInterest('Tsukihan') and C.npc.Tsukihan.love gte 30>>
              <br><<lanSwitch 'Tsukihan has invited you into the house behind the shrine, even while they work in the courtyard. You share the bedroom, and there is a small washroom inside.' '月羽请你到神社后侧的小屋歇脚，自己在庭院忙时，也允许你进屋。你们共用寝室里的床铺，屋里还有一间小浴室。'>>
            <<elseif C.npc.Tsukihan?.init is 1 and isLoveInterest('Tsukihan')>>
              <br><<lanSwitch 'Tsukihan lives in the little house behind the shrine. You can call at the door at 07:00–09:00, 12:00–13:00 or 18:00–22:00.' '月羽住在神社后侧的小屋。7:00～9:00、12:00～13:00或18:00～22:00，可以到门前拜访。'>>
            <</if>>
            <<if $_shrineNote.promise gte 0>>
              <br><<if Math.floor(Time.days) gt $_shrineNote.promise>>
                <span class='red'><<lanSwitch 'The day you promised to bring strawberries has passed. Speak with Tsukihan at the shrine.' '约好送草莓的日子已经过了。去神社和月羽说说吧。'>></span>
              <<else>>
                <<language>>
                  <<option 'EN'>>
                    You promised to bring Tsukihan a portion of strawberries by 18:00 on <span class='blue'><<deadwood-journal-date $_shrineNote.promise>></span>.
                  <<option 'CN'>>
                    你答应在<span class='blue'><<deadwood-journal-date $_shrineNote.promise>></span>18:00前给月羽带一份草莓。
                <</language>>
              <</if>>
            <</if>>
            <<if $_shrineNote.wish.ready and !$_shrineNote.wish.returned>>
              <br><<lanSwitch 'Your wish has come true. You can return to the shrine to give thanks.' '绘马上的心愿已实现，可以回神社还愿。'>>
            <</if>>
        <</switch>>
      </li></ul><hr>
    <</if>>
  <</if>>
<</widget>>

:: Deadwood Reblooms Finance News [widget]

<<widget 'deadwood-finance-news'>>
  <<set $_paper_news to _args[0] is undefined ? ($Finance.market.news or []) : _args[0]>>
  <<if $_paper_news.length>>
    <span class='gold'><<lanSwitch "Business notices" "业务消息">></span><br>
    <<for _news range $_paper_news.slice(-3).reverse()>>
      <<switch _news.event>>
        <<case 'farm'>>
          <<lanSwitch "New work at Alex's farm has attracted orders and competition among local suppliers." "艾利克斯农场的新工程带来了订单，本地供应商开始争夺生意。">>
        <<case 'raid'>>
          <span class='red'><<lanSwitch "Damage at Alex's farm has disrupted deliveries. Competing suppliers are taking orders." "艾利克斯的农场受损，交货受到影响。竞争对手正在接下订单。">></span>
        <<case 'cafe'>>
          <<language>>
            <<option 'EN'>>
              <<if _news.move lt 0>>
                Ocean Breeze has announced an expansion and a month-long closure. It is still trading ahead of the building work.
              <<elseif _news.move gte 10>>
                Ocean Breeze has reopened after its expansion.
              <<else>>
                Ocean Breeze has raised its prices.
              <</if>>
            <<option 'CN'>>
              <<if _news.move lt 0>>
                海风咖啡馆宣布扩建，并准备停业一个月。施工开始前仍在营业。
              <<elseif _news.move gte 10>>
                海风咖啡馆扩建后重新开业。
              <<else>>
                海风咖啡馆提高了价格。
              <</if>>
          <</language>>
        <<case 'avery'>>
          <<language>>
            <<option 'EN'>>
              <<if _news.move gt 0>>
                Avery's company has gained the support of influential backers.
              <<else>>
                Reports of damage and disruption have unsettled investors in Avery's company.
              <</if>>
            <<option 'CN'>>
              <<if _news.move gt 0>>
                艾弗里的公司得到了一批有权势的支持者。
              <<else>>
                有关损失与动荡的消息，让艾弗里公司的投资人不安。
              <</if>>
          <</language>>
        <<case 'shop'>>
          <span @class="_news.move < 0 ? 'red' : 'teal'">
            <<language>>
              <<option 'EN'>>
                <<if _news.move lt 0>>
                  Robin's drinks shop is no longer trading.
                <<else>>
                  Robin's drinks shop has opened on Cliff Street.
                <</if>>
              <<option 'CN'>>
                <<if _news.move lt 0>>
                  罗宾饮品店停止营业。
                <<else>>
                  罗宾饮品店在峭壁街开业了。
                <</if>>
            <</language>>
          </span>
        <<case 'shop_upgrade'>>
          <<language>>
            <<option 'EN'>>
              Robin's drinks shop has changed its equipment and menu.
            <<option 'CN'>>
              罗宾饮品店调整了设备与菜单。
          <</language>>
        <<case 'shop_staff'>>
          <<language>>
            <<option 'EN'>>
              <<if _news.move gt 0>>
                Robin's drinks shop has taken on staff to handle more customers.
              <<else>>
                Robin's drinks shop is working with fewer staff.
              <</if>>
            <<option 'CN'>>
              <<if _news.move gt 0>>
                罗宾饮品店聘了新店员，准备接待更多客人。
              <<else>>
                罗宾饮品店的店员减少了。
              <</if>>
          <</language>>
        <<case 'shop_supply'>>
          <<language>>
            <<option 'EN'>>
              Repeated orchard deliveries have helped Robin's drinks shop keep fruit in stock.
            <<option 'CN'>>
              果园接连交货，让罗宾饮品店有了更稳定的水果供应。
          <</language>>
        <<default>>
          <<= maplebirch.t(`deadwood-reblooms:finance:news:${_news.event}`)>>
      <</switch>>
      <<if _news.symbol>> <span class='blue'>(<<= _news.symbol>>)</span><</if>>
      <span @class="_news.move < 0 ? 'red' : 'green'">
        <<lanSwitch ' Event effect: ' ' 消息影响：'>><<if _news.move gt 0>>+<</if>><<= _news.move>>%
      </span>
      <<if _news.applied_day is null>>
        <span class='blue'><<lanSwitch ' · Awaiting a trading day' ' · 待交易日计入报价'>></span>
      <</if>>
      <<if Number.isInteger(_news.share_change)>>
        <span class='blue'>
          <<lanSwitch ' Listed shares: ' ' 挂牌股份：'>>
          <<if _news.share_change gt 0>>+<</if>><<= _news.share_change.toLocaleString('en-GB')>>
        </span>
      <</if>><br>
    <</for>><br>
  <</if>>
<</widget>>

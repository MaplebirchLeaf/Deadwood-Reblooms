:: Deadwood Reblooms Property Daily Widgets [widget]

<<widget 'deadwood-home-daily-link'>>
  <<set _day_life to maplebirch.get('Finance').realEstate.life>>
  <<if _day_life.pending>>
    <<socialiseicon>><<lanLink `_day_life.daily.kind === 'resident' ? ['See what ' + maplebirch.auto(_day_life.daily.partner) + ' wants', '听听' + maplebirch.auto(_day_life.daily.partner) + '想说什么'] : _day_life.daily.kind === 'staff' ? ['Go over the household handover', '看看雇员的交接记录'] : ['Attend to a small matter at home', '处理家里的一件小事']` 'Deadwood Reblooms Property Daily'>><</lanLink>><br>
  <<elseif _day_life.daily?.kind is 'resident' and ['join', 'leave'].includes(_day_life.daily.choice)
      and _day_life.daily.day is Math.floor(Time.days) and _day_life.daily.property is maplebirch.get('Finance').realEstate.current?.id
      and maplebirch.get('Finance').realEstate.household.common.some(resident => resident.id === _day_life.daily.partner)>>
    <<socialiseicon>><<lanLink ['Mention your earlier conversation', '提起刚才的事'] 'Deadwood Reblooms Property Daily Recall'>><</lanLink>><br>
  <</if>>
<</widget>>

<<widget 'deadwood-home-daily-act'>>
  <<set $_day_estate to maplebirch.get('Finance').realEstate>>
  <<set $_day_event to $_day_estate.life.daily, $_day_action to _args[0], $_day_origin to $passage, $_day_location to $location>>
  <<if !$_day_estate.life.pending or $passage isnot 'Deadwood Reblooms Property Daily'>><<exit>><</if>>
  <<if _args[0] is 'read' and $NPCList[0]?.per isnot $_day_estate.staff.key($_day_estate.life.daily?.role)>><<exit>><</if>>
  <<if !['join', 'help', 'read', 'leave'].includes($_day_action)
      or ($_day_action isnot 'leave' and $_day_action isnot ({ resident: 'join', staff: 'read', house: 'help' })[$_day_event.kind])
      or ($_day_action is 'help' and pcAreArmsBound('both'))>><<exit>><</if>>
  <!-- 耗时后才登记完成和发放收益。强制转场或日程变化保留已耗时间，不算做完。 -->
  <<if $_day_action isnot 'leave'>><<pass `$_day_action is 'read' ? 5 : 10`>><</if>>
  <<if $_day_estate.life.daily isnot $_day_event or $passage isnot $_day_origin or $location isnot $_day_location
      or ($_day_action is 'read' and $NPCList[0]?.per isnot $_day_estate.staff.key($_day_event.role))
      or !$_day_estate.life.finish($_day_action)>><<exit>><</if>>
  <<switch $_day_event.choice>>
    <<case 'join'>>
      <<npcincr $_day_event.partner love 1>><<stress -2>><<run maplebirch.get('Psyche')?.rest(2, -60)>>
    <<case 'help'>>
      <<housekeeping 1 600>><<tiredness 1>>
    <<case 'read'>>
      <<set $_day_key to $_day_estate.staff.key($_day_event.role)>>
      <<set $NPCList[0].deadwood_work to $NPCList[0].deadwood_work ?? { chats: 0, last: null, day: -1 }>>
      <<set $NPCList[0].deadwood_work.last to 'handover', $NPCList[0].deadwood_work.day to $_day_event.day>>
      <<set $NPCList[0].deadwood_work.chats += 1>><<saveNPC 0 $_day_key>>
  <</switch>>
<</widget>>

:: Deadwood Reblooms Property Daily
<<set _estate to maplebirch.get('Finance').realEstate>>
<<set _day_event to _estate.life.daily>>
<<if !_estate.life.pending>>
  <<getouticon>><<lanLink ['Return to the sitting room', '返回起居室'] 'Deadwood Reblooms Property Home'>><</lanLink>><<exit>>
<</if>>
<<run _estate.setFloor(1)>><<run _estate.enter()>><<effects>>
<<if $nextPassage or $nextPassageCheck>>
  <span id='next'><<lanLink ['Continue', '继续'] 'Deadwood Reblooms Property Daily'>><</lanLink>></span><<nexttext>><<exit>>
<</if>>
<<switch _day_event.kind>>
  <<case 'staff'>>
    <<endevent>><<loadNPC 0 `_estate.staff.key(_day_event.role)`>><<person1>>
    <<language>>
      <<option 'EN'>>
        <<print $NPCList[0].name>> brings the duty book over. <<if $NPCList[0].deadwood_work?.private>>"I've marked the things you asked me to leave alone."<<else>>"A few things for you to check before I hand over."<</if>> <<He>> opens it at today's page.
      <<option 'CN'>>
        <<print $NPCList[0].name>>把值班簿拿了过来。<<if $NPCList[0].deadwood_work?.private>>“您上次说别动的东西，我都标好了。”<<else>>“交班之前，有几件事请您过目。”<</if>><<He>>翻到今天那页。
    <</language>><br><br>
    <<language>>
      <<option 'EN'>>
        <<switch _day_event.role>>
          <<case 'housekeeper'>>A mark beside the linen cupboard shows where the clean covers were put. Your papers and the things left by the other residents are listed as untouched. "Shall I keep doing it this way?"
          <<case 'cook'>>The page lists the dishes already in your pantry and the utensils waiting to be washed. "I can get these ready when you want them. Tell me before anyone's food needs changing."
          <<case 'steward'>>The book separates your visitors from business callers. <<if $Finance.company.name>>A space beside the company papers is left for your signature.<<else>>Unsigned correspondence lies in a separate tray.<</if>> "These stay with you until you decide."
          <<case 'guard'>><<if _estate.current.id is 'penthouse'>>The guard has noted the service entrance checks separately from the building security log.<<else>>Times are written beside the front and side door checks.<</if>> "If somebody isn't expected, I'll bring the name to you first."
        <</switch>>
      <<option 'CN'>>
        <<switch _day_event.role>>
          <<case 'housekeeper'>>布草柜旁的记号写明干净罩子放在哪里。你的文件和其他住户留下的物品，都列在未动的清单里。“以后也照这样做吗？”
          <<case 'cook'>>这一页列着储藏室已有的餐点和等待清洗的器具。“您想吃的时候，我再准备。谁的餐点要改，先告诉我一声。”
          <<case 'steward'>>记录把私人访客和谈生意的来客分开。<<if $Finance.company.name>>公司文件旁留着你签字的位置。<<else>>尚未签字的信件放在另一只托盘里。<</if>>“这些由您过目后再定。”
          <<case 'guard'>><<if _estate.current.id is 'penthouse'>>门卫把服务入口的检查另记一页，没有与大楼保安的登记混在一起。<<else>>前门与侧门的检查旁都写着时间。<</if>>“有人没预约，我先把名字报给您。”
        <</switch>>
    <</language>><br><br>
    <<icon 'library.png'>><<lanLink ['Read the handover notes (0:05)', '核对交接记录 (0:05)'] 'Deadwood Reblooms Property Daily Finish'>><<deadwood-home-daily-act 'read'>><</lanLink>><br>
  <<case 'resident'>>
    <<language>>
      <<option 'EN'>>
        <<switch _day_event.partner>>
          <<case 'Robin'>><<if C.npc.Robin.trauma gte 20>>Robin waits near the doorway, twisting a sleeve. "Can you stay here for a little? I heard something outside."<<elseif _day_event.variant is 2>>Robin squares a little stack of playing cards. "Found these in a drawer. Want to try a hand? Nothing riding on it."<<elseif _day_event.variant is 0>>Robin has set a second cup beside <<nnpc_his 'Robin'>> own. "I saved you a seat."<<else>>Robin catches your eye and smiles. "I've got a bit of time <<if Time.hour gte 21>>before I turn in<<else>>before I need to go<</if>>. Want some company?"<</if>>
          <<case 'Whitney'>><<if _day_event.variant is 2>>Whitney is watching the street from the window. "Come look at this fucking idiot." <<nnpc_He 'Whitney'>> shifts aside enough for you to see.<<else>>Whitney has one boot on and the other lying beside the chair. <<if _day_event.variant is 0>>"Come here. Tell me what you've been up to."<<else>>"You got ten minutes for me, slut?"<</if>> <<nnpc_He 'Whitney'>> nudges the other chair with a foot.<</if>>
          <<case 'Kylar'>>Kylar comes out when <<nnpc_he 'Kylar'>> hears you. <<if C.npc.Kylar.rage gte 60>>"Who were you talking to? I wanted to see you." <<nnpc_He 'Kylar'>> looks past your shoulder before asking whether you can sit together.<<elseif _day_event.variant is 2>>"Could you sit still for a few minutes?" <<nnpc_He 'Kylar'>> holds a half-finished drawing against <<nnpc_his 'Kylar'>> chest. "I haven't got your hands right."<<else>>"I was hoping you'd be here." <<nnpc_He 'Kylar'>> moves a book from the seat nearest <<nnpc_him 'Kylar'>>.<</if>>
          <<case 'Sydney'>>Sydney leaves a bookmark between the pages. "I have a little time <<if Time.hour gte 21>>before bed<<else>>before I go<</if>>." <<if _day_event.variant is 2>>"How would you read this?" <<nnpc_He 'Sydney'>> points to a sentence, leaving the space beside the book clear for you.<<elseif _day_event.variant is 0>><<nnpc_He 'Sydney'>> asks what you have been reading.<<else>>"Tell me something about your day?" <<nnpc_He 'Sydney'>> glances at the clock, then gives you <<nnpc_his 'Sydney'>> attention.<</if>>
        <</switch>>
      <<option 'CN'>>
        <<switch _day_event.partner>>
          <<case 'Robin'>><<if C.npc.Robin.trauma gte 20>>罗宾站在门边，拧着衣袖。“你能在这儿待一会儿吗？我听见外面有声音。”<<elseif _day_event.variant is 2>>罗宾将一小叠纸牌理齐。“在抽屉里找到的。要不要玩一局？不赌钱。”<<elseif _day_event.variant is 0>>罗宾在自己的杯子旁又放了一只。“给你留了座位。”<<else>>罗宾与你对上目光，笑了。“<<if Time.hour gte 21>>睡前<<else>>出门前<</if>>还有一点时间。要不要陪你坐坐？”<</if>>
          <<case 'Whitney'>><<if _day_event.variant is 2>>惠特尼正站在窗边看街上。“过来看看这个傻子。”<<nnpc_he 'Whitney'>>往旁边挪了一点，让你看清。<<else>>惠特尼穿好一只靴子，另一只还丢在椅子旁。<<if _day_event.variant is 0>>“过来。说说你都干什么了。”<<else>>“有十分钟陪我吗，骚货？”<</if>><<nnpc_he 'Whitney'>>用脚推了推另一把椅子。<</if>>
          <<case 'Kylar'>>凯拉尔听见你的声音便走了出来。<<if C.npc.Kylar.rage gte 60>>“你刚才在和谁说话？我一直想见你。”<<nnpc_he 'Kylar'>>朝你身后望了一眼，才问能不能一起坐坐。<<elseif _day_event.variant is 2>>“你能坐着别动几分钟吗？”<<nnpc_he 'Kylar'>>抱着一张没画完的素描。“手还没画好。”<<else>>“我还盼着你在这里。”<<nnpc_he 'Kylar'>>挪开最近的座位上的书。<</if>>
          <<case 'Sydney'>>悉尼把书签夹进书页。“<<if Time.hour gte 21>>睡前<<else>>出门前<</if>>还有一点时间。”<<if _day_event.variant is 2>>“你觉得这句话该怎么读？”<<nnpc_he 'Sydney'>>指着书上一行字，给你留出一起看的位置。<<elseif _day_event.variant is 0>><<nnpc_he 'Sydney'>>问起你最近在读什么。<<else>>“跟我说说今天的事？”<<nnpc_he 'Sydney'>>看了眼钟，随即认真望向你。<</if>>
        <</switch>>
    <</language>><br><br>
    <<socialiseicon>><<lanLink ['Sit together for a little while (0:10)', '一起坐一会儿 (0:10)'] 'Deadwood Reblooms Property Daily Finish'>><<deadwood-home-daily-act 'join'>><</lanLink>><<glove _day_event.partner>><<lstress>><br>
  <<case 'house'>>
    <<language>>
      <<option 'EN'>>
        <<if _day_event.variant is 0>>The window catch has not seated properly. The curtain keeps lifting, and a little dust has gathered on the sill.
        <<elseif _day_event.variant is 1>>A pile of blankets and spare covers has slipped from the cupboard. The door catches on the lowest corner whenever you walk past.
        <<else>>Receipts are scattered across the sitting room table. <<if $Finance.company.name>>The company papers need their own pile.<<else>>The household bills have become mixed with your other notes.<</if>><</if>>
      <<option 'CN'>>
        <<if _day_event.variant is 0>>窗扣没合紧，窗帘一阵阵扬起，窗台上也积了一点灰。
        <<elseif _day_event.variant is 1>>毯子与备用罩子从柜里滑了下来。每次走过，柜门都卡在最底下的一角。
        <<else>>收据散在起居室的桌上。<<if $Finance.company.name>>公司的文件得另放一叠。<<else>>家里的账单已经和其他笔记混在一起。<</if>><</if>>
    <</language>><br><br>
    <<if !pcAreArmsBound('both')>>
      <<icon 'broom-dustpan.png'>><<lanLink ['Put it in order (0:10)', '动手整理 (0:10)'] 'Deadwood Reblooms Property Daily Finish'>><<deadwood-home-daily-act 'help'>><</lanLink>><<ghousekeeping>><<gtiredness>><br>
    <</if>>
<</switch>>
<<if _day_event.kind is 'resident'>>
  <<refuseicon>><<lanLink ['Decline the invitation', '婉拒邀请'] 'Deadwood Reblooms Property Daily Finish'>><<deadwood-home-daily-act 'leave'>><</lanLink>><br>
<</if>>
<<getouticon>><<lanLink ['Leave it for now', '稍后再来'] 'Deadwood Reblooms Property Home'>><</lanLink>>

:: Deadwood Reblooms Property Daily Finish
<<set _estate to maplebirch.get('Finance').realEstate>>
<<set _day_event to _estate.life.daily>>
<<if !_estate.current or !_day_event?.choice or _day_event.property isnot _estate.current.id>>
  <<lanSwitch 'You were unable to finish before you had to stop.' '你还没处理完，就不得不停了下来。'>><br><br>
  <<getouticon>><<lanLink `_estate.current ? ['Return to the sitting room', '返回起居室'] : ['Return to the agency', '返回房产中介']` `_estate.current ? 'Deadwood Reblooms Property Home' : 'Deadwood Reblooms Property Office'`>><</lanLink>><<exit>>
<</if>>
<<run _estate.enter()>><<effects>>
<<if $nextPassage or $nextPassageCheck>>
  <span id='next'><<lanLink ['Continue', '继续'] 'Deadwood Reblooms Property Daily Finish'>><</lanLink>></span><<nexttext>><<exit>>
<</if>>
<<language>>
  <<option 'EN'>>
    <<if _day_event.choice is 'leave'>>
      <<if _day_event.kind is 'resident'>>
        You say you cannot stay just now.
        <<switch _day_event.partner>>
          <<case 'Robin'>><<if C.npc.Robin.trauma gte 20>>Robin nods without looking up, still twisting <<nnpc_his 'Robin'>> sleeve.<<else>>"Oh. All right." Robin gives you a small wave.<</if>>
          <<case 'Whitney'>>Whitney snorts. "Your loss." <<nnpc_He 'Whitney'>> turns away.
          <<case 'Kylar'>>"You'll come back, won't you?" Kylar follows you to the doorway.
          <<case 'Sydney'>>"Another time, then." Sydney opens the book again.
        <</switch>>
      <<else>>You leave the matter for another time.<</if>>
    <<elseif _day_event.choice is 'read'>>You check the entry and confirm which rooms may be used. The handover is left in the duty book for the next shift.
    <<elseif _day_event.choice is 'help'>>
      <<if _day_event.variant is 0>>You wipe the sill and pull the window closed. <<if currentSkillValue('housekeeping') gte 500>>One firm push seats the catch.<<else>>It takes a second try to get the catch into place.<</if>> The curtain settles.
      <<elseif _day_event.variant is 1>><<if currentSkillValue('housekeeping') gte 500>>You fold the covers into neat stacks, leaving room for the cupboard door to close.<<else>>You try the folded covers in a few different piles before the cupboard door closes.<</if>>
      <<else>><<if currentSkillValue('housekeeping') gte 500>>You sort the receipts by date and put the papers in separate piles. <<if currentSkillValue('maths') gte 400>>You check the totals before filing them.<</if>><<else>>You have to spread the papers out before you can see which ones belong together.<</if>> The table is clear again.<</if>>
    <<elseif _day_event.partner is 'Robin'>>Robin sits beside you. <<if C.npc.Robin.trauma gte 20>>You stay while the noises outside pass. <<nnpc_He 'Robin'>> eventually lets the sleeve fall from <<nnpc_his 'Robin'>> fingers.<<elseif _day_event.variant is 2>>Robin deals the cards and explains the rules as you go. When you both reach for the same pile, <<nnpc_he 'Robin'>> laughs. You finish the hand before putting the cards away.<<else>>You trade the little things that happened today. Robin leaves the seat close to yours when you finish.<</if>>
    <<elseif _day_event.partner is 'Whitney' and _day_event.variant is 2>>You watch somebody struggle with a stubborn bicycle lock. Whitney keeps up a running commentary until the cyclist finally rides off. "There. Free entertainment." <<nnpc_He 'Whitney'>> grins at you.
    <<elseif _day_event.partner is 'Whitney'>>Whitney tells you something that happened on the way home, laughing at the least flattering part. "There. Wasn't hard, was it?" <<nnpc_He 'Whitney'>> gets the other boot on before leaving the chair.
    <<elseif _day_event.partner is 'Kylar'>>Kylar keeps your attention on the conversation. <<if C.npc.Kylar.rage gte 60>>"Next time, tell me when you're coming back." You return to the things that happened today. <<nnpc_He 'Kylar'>> listens, still waiting for you to mention a time.<<elseif _day_event.variant is 2>>You rest your hands on your knees while Kylar draws. <<nnpc_He 'Kylar'>> keeps glancing up, then adjusting a line. "Better." <<nnpc_He 'Kylar'>> shows you before carefully folding the paper away.<<else>><<nnpc_He 'Kylar'>> listens closely, then remembers something <<nnpc_he 'Kylar'>> wanted to tell you too.<</if>>
    <<elseif _day_event.variant is 2>>You read the sentence together. <<if currentSkillValue('english') gte 500>>You suggest another way to phrase it. Sydney tries both aloud, then laughs at how different they sound.<<else>>Sydney goes back a few lines, and you work out the meaning together.<</if>> <<nnpc_He 'Sydney'>> marks the page before closing the book.
    <<else>>Sydney listens, sometimes adding a question. When the clock catches <<nnpc_his 'Sydney'>> eye again, <<nnpc_he 'Sydney'>> gathers the book. "I'd better get ready. Thank you." You let <<nnpc_him 'Sydney'>> go.<</if>>
  <<option 'CN'>>
    <<if _day_event.choice is 'leave'>>
      <<if _day_event.kind is 'resident'>>
        你说自己现在没法留下。
        <<switch _day_event.partner>>
          <<case 'Robin'>><<if C.npc.Robin.trauma gte 20>>罗宾没有抬头，仍拧着衣袖，轻轻点了一下。<<else>>“哦，好吧。”罗宾向你轻轻挥了挥手。<</if>>
          <<case 'Whitney'>>惠特尼哼了一声。“你的损失。”<<nnpc_He 'Whitney'>>转过身去。
          <<case 'Kylar'>>“你还会回来吧？”凯拉尔跟着你走到门边。
          <<case 'Sydney'>>“那就改天吧。”悉尼重新翻开书。
        <</switch>>
      <<else>>你把这件事留到稍后。<</if>>
    <<elseif _day_event.choice is 'read'>>你核对了记录，确认哪些房间可以使用。交接内容留在值班簿里，下一班也能看见。
    <<elseif _day_event.choice is 'help'>>
      <<if _day_event.variant is 0>>你擦过窗台，将窗扇拉紧。<<if currentSkillValue('housekeeping') gte 500>>稍微用力一推，窗扣就合上了。<<else>>试了两次，窗扣才对准位置。<</if>>窗帘不再扬动。
      <<elseif _day_event.variant is 1>><<if currentSkillValue('housekeeping') gte 500>>你把罩子叠成整齐的几摞，给柜门留出空间。<<else>>你调整了几次叠好的罩子，柜门终于能够合上。<</if>>
      <<else>><<if currentSkillValue('housekeeping') gte 500>>你按日期整理收据，把几类文件分别放好。<<if currentSkillValue('maths') gte 400>>归档前，你又核对了一遍合计。<</if>><<else>>你先把文件铺开，才看清哪些该放在一起。<</if>>桌面又清爽了。<</if>>
    <<elseif _day_event.partner is 'Robin'>>罗宾在你身旁坐下。<<if C.npc.Robin.trauma gte 20>>你陪着<<nnpc_him 'Robin'>>，等屋外的声响过去。过了一会儿，<<nnpc_he 'Robin'>>终于松开揉着衣袖的手。<<elseif _day_event.variant is 2>>罗宾一边发牌，一边给你讲规则。你们同时伸手去拿同一叠牌时，<<nnpc_he 'Robin'>>笑了起来。玩完这一局，你们才将纸牌收好。<<else>>你们说起今天的小事，聊完了，罗宾的椅子仍留在你的椅子旁。<</if>>
    <<elseif _day_event.partner is 'Whitney' and _day_event.variant is 2>>街上的人正和一把打不开的车锁较劲。惠特尼一直在旁边评头论足，直到对方终于骑车离开。“看，免费的乐子。”<<nnpc_he 'Whitney'>>冲你咧嘴笑。
    <<elseif _day_event.partner is 'Whitney'>>惠特尼说起回家路上发生的事，说到最损人的一段便笑了。“看吧。又不难。”离开椅子前，<<nnpc_he 'Whitney'>>才穿好另一只靴子。
    <<elseif _day_event.partner is 'Kylar'>>凯拉尔将你的注意力留在谈话里。<<if C.npc.Kylar.rage gte 60>>“下次，告诉我什么时候回来。”你接着说起今天的事。<<nnpc_he 'Kylar'>>听着，仍在等你提到回来的时间。<<elseif _day_event.variant is 2>>你将双手放在膝上，让凯拉尔接着画。<<nnpc_he 'Kylar'>>不时抬头看你，再改动一条线。“这样好多了。”<<nnpc_he 'Kylar'>>先给你看过，才仔细收好那张纸。<<else>><<nnpc_he 'Kylar'>>听得很认真，随后又想起自己也有件事要告诉你。<</if>>
    <<elseif _day_event.variant is 2>>你们一起读了那句话。<<if currentSkillValue('english') gte 500>>你提议换个说法。悉尼把两种句子都念了一遍，听见其中的差别，忍不住笑了。<<else>>悉尼往前翻了几行，你们一起理清其中的意思。<</if>><<nnpc_he 'Sydney'>>在那页夹好书签，才合上书。
    <<else>>悉尼听着，偶尔追问一句。再次看见钟时，<<nnpc_he 'Sydney'>>收起书。“得去准备了。谢谢。”你让<<nnpc_him 'Sydney'>>先走。<</if>>
<</language>><br><br>
<<getouticon>><<lanLink ['Return to the sitting room', '返回起居室'] 'Deadwood Reblooms Property Home'>><<endevent>><</lanLink>>

:: Deadwood Reblooms Property Daily Recall
<<set _estate to maplebirch.get('Finance').realEstate, _day_event to _estate.life.daily>>
<<if $location isnot 'deadwood_home' or !_estate.current or _day_event?.kind isnot 'resident'
    or !['join', 'leave'].includes(_day_event.choice) or _day_event.day isnot Math.floor(Time.days)
    or _day_event.property isnot _estate.current.id
    or !_estate.household.common.some(resident => resident.id === _day_event.partner)>>
  <<lanSwitch 'There is no one here to continue that conversation.' '这里没有能接着刚才的话说下去的人。'>><br><br>
<<else>>
  <<effects>>
  <<if $nextPassage or $nextPassageCheck>>
    <span id='next'><<lanLink ['Continue', '继续'] 'Deadwood Reblooms Property Daily Recall'>><</lanLink>></span><<nexttext>><<exit>>
  <</if>>
  <!-- 只回顾当天实际做过或拒绝的事，读档与重复交谈不再结算陪伴收益。 -->
  <<language>>
    <<option 'EN'>>
      <<switch _day_event.partner>>
        <<case 'Robin'>>
          Robin looks up when you mention earlier.
          <<if _day_event.choice is 'leave'>>"Finished what you needed to do?" <<nnpc_He 'Robin'>> moves a sleeve out of the way of the other chair.
          <<elseif C.npc.Robin.trauma gte 20>>"It stopped after you sat down," <<nnpc_he 'Robin'>> says quietly. "The noise outside. I know you probably heard it too."
          <<elseif _day_event.variant is 2>>"I nearly had you on that last hand." Robin smiles, then straightens the little stack of cards. "Next time."
          <<elseif _day_event.variant is 0>>"I've put the cups away." Robin hesitates. "It's nice, having someone to leave one out for."
          <<else>>"I liked hearing about your day." Robin smiles. "Sometimes I forget how much happens while we're out."<</if>>
        <<case 'Whitney'>>
          <<if _day_event.choice is 'leave'>>"Back already?" Whitney looks you up and down. "Run out of better things to do?" <<nnpc_His 'Whitney'>> grin takes some of the edge off it.
          <<elseif _day_event.variant is 2>>"That lock cost more than the fucking bike." Whitney laughs again when you mention the cyclist. "Should've left it there."
          <<else>>Whitney catches you looking at the chair. "You can sit down without an invitation, you know." <<nnpc_He 'Whitney'>> nudges it towards you. "Don't get used to being waited on."<</if>>
        <<case 'Kylar'>>
          <<if _day_event.choice is 'leave'>>Kylar turns towards you at once. "You're staying this time?" <<nnpc_He 'Kylar'>> leaves the question hanging, watching your face.
          <<elseif C.npc.Kylar.rage gte 60>>"You still haven't said when you'll be back next time." Kylar remembers exactly where you left the conversation.
          <<elseif _day_event.variant is 2>>Kylar keeps a hand over the folded drawing. "I might work on it a little more. Your hands looked different when you started talking."
          <<else>>"I kept thinking about what you said." Kylar smiles. "I like knowing the little things too."<</if>>
        <<case 'Sydney'>>
          <<if _day_event.choice is 'leave'>>Sydney looks up from the book. "Did you get everything done?" <<nnpc_He 'Sydney'>> slips a finger between the pages, keeping the place.
          <<elseif _day_event.variant is 2>>"I read that sentence again." Sydney shows you the bookmark. "It's much clearer the second time. I'm glad we looked at it together."
          <<else>>"I didn't mean to keep looking at the clock." Sydney closes the book halfway. "I wanted to finish listening before I had to go."<</if>>
      <</switch>>
    <<option 'CN'>>
      <<switch _day_event.partner>>
        <<case 'Robin'>>
          你提起刚才的事，罗宾抬起头。
          <<if _day_event.choice is 'leave'>>“事情忙完了吗？”<<nnpc_He 'Robin'>>把搭在另一把椅子上的衣袖挪开。
          <<elseif C.npc.Robin.trauma gte 20>>“你坐下来以后，就没声音了。”<<nnpc_he 'Robin'>>轻声说。“外面那个。你应该也听见了吧。”
          <<elseif _day_event.variant is 2>>“最后一局，我差点就赢了。”罗宾笑着理齐那一小叠牌。“下次再来。”
          <<elseif _day_event.variant is 0>>“杯子已经收好了。”罗宾迟疑了一下。“能给人留一只，感觉挺好的。”
          <<else>>“刚才听你说今天的事，我很高兴。”罗宾笑了。“各自出门以后，原来还能碰上那么多事。”<</if>>
        <<case 'Whitney'>>
          <<if _day_event.choice is 'leave'>>“这就回来了？”惠特尼上下打量你。“没更有意思的事干了？”<<nnpc_He 'Whitney'>>咧嘴一笑，听起来也没那么刻薄了。
          <<elseif _day_event.variant is 2>>你提起那个骑车的人，惠特尼又笑起来。“那把破锁比车还贵吧。干脆扔那儿得了。”
          <<else>>惠特尼发现你在看椅子。“坐下还要我请？”<<nnpc_He 'Whitney'>>用脚将椅子推近了一点。“别习惯了让人伺候。”<</if>>
        <<case 'Kylar'>>
          <<if _day_event.choice is 'leave'>>凯拉尔立刻转向你。“这次会留下吗？”<<nnpc_He 'Kylar'>>望着你的脸，等着回答。
          <<elseif C.npc.Kylar.rage gte 60>>“你还没说，下次什么时候回来。”凯拉尔记得谈话停在了哪里。
          <<elseif _day_event.variant is 2>>凯拉尔将手按在折好的素描上。“我可能还要改一改。你开始说话的时候，手又不一样了。”
          <<else>>“刚才你说的那些，我一直记着。”凯拉尔笑了。“小事我也想知道。”<</if>>
        <<case 'Sydney'>>
          <<if _day_event.choice is 'leave'>>悉尼从书里抬起头。“都忙完了吗？”<<nnpc_He 'Sydney'>>把一根手指夹进书页，留住刚才读到的位置。
          <<elseif _day_event.variant is 2>>“那句话，我又读了一遍。”悉尼给你看夹着书签的那页。“再看就明白多了。还好刚才和你一起读过。”
          <<else>>“刚才不是故意一直看钟的。”悉尼将书半合起来。“我想走之前，把你的话听完。”<</if>>
      <</switch>>
  <</language>><br><br>
<</if>>
<<getouticon>><<lanLink ['Return to the sitting room', '返回起居室'] 'Deadwood Reblooms Property Home'>><</lanLink>><br>

:: Deadwood Reblooms Property Pair Intimacy []

<<set _estate to maplebirch.get("Finance").realEstate>>
<<set _property to _estate.current>>
<<set _place to _estate.pairRequest ? _estate.pairRequest.place : 'bedroom'>>
<<if $sexstart is 1>>
	<<set _request to _estate.takePairRequest()>>
	<<set _pair to _request ? _request.names : null>>
	<<set _place to _request ? _request.place : 'bedroom'>>
	<<if !_property or !Array.isArray(_pair) or _pair.length isnot 2 or _pair[0] is _pair[1]
	  or _estate.householdRefusal(_pair)
	  or !_estate.placeOpen(_place)
	  or !_pair.every(name => _estate.canIntimate(name, _property.id, _place))>>
		<<set $sexstart to 0>>
		<<run _estate.clearPairRequest()>>
		<<run _estate.enter()>><<effects>>
		<span class='blue'><<lanSwitch 'They have already gone their own way.' '两人已经各自离开了。'>></span><br><br>
		<<lanLink ["Return to the bedroom", "返回卧室"] 'Deadwood Reblooms Property Bedroom'>><</lanLink>>
	<<else>>
		<<set $sexstart to 0>>
		<<run _estate.enter(_place is 'bath' ? 'bathroom' : _place)>><<set $outside to _estate.intimacyOutside(_place) ? 1 : 0>>
		<<clearnpc>>
		<<npc _pair[0]>><<npc _pair[1] 2>>
		<<run _pair.forEach(name => statusCheck(name))>>
		<<if _pair.includes('Sydney')>>
			<<set $corruptionEvent to 1>>
			<<set $daily.sydney.sex to ($daily.sydney.sex || 0) + 1>>
			<<set $sydney.sexTotal += 1>>
		<</if>>
		<<person1>>
		<<consensual>><<set $consensual to 1>><<neutral 1>>
		<<if _place is 'pool'>>
			<<if $Finance.real_estate.pool_clothing is 'nude'>><<strip>><</if>>
		<<elseif _place is 'bath'>>
			<span class='lewd'><<lanSwitch 'The three of you get out of what is left of your clothes and into the water.' '你们三个把剩下的衣服脱在缸边，一起沉进水里。'>></span><<strip>><br><br>
		<<elseif $exposed lt 2>>
			<span class='lewd'><<lanSwitch 'You slip out of your clothes.' '你脱下衣服。'>></span><<strip>><br><br>
		<</if>>
		<<maninit>>
		<<set $enemyarousalmax to 1500>>
		<<if _pair.includes('Sydney')>>
			<<set _sydneyIndex to _pair.indexOf('Sydney')>>
			<<if _sydneyStatus.includes('corrupt') and !_sydneyChastity>>
				<<npcexpose>>
				<<set $enemyarousalmax += 100>>
			<<else>>
				<<npcClothesType $NPCList[_sydneyIndex] 'undies'>>
				<<if _sydneyStatus.includes('corrupt')>>
				  <<set $enemyarousalmax += 100>>
				<</if>>
				<<if _sydneyStatus.includes('pure')>>
				  <<set $enemyarousalmax -= 100>>
				<</if>>
			<</if>>
			<<if _sydneyChastity and C.npc.Sydney.chastity.anus.includes('shield')>>
				<<set $enemyarousalmax -= 100>>
			<</if>>
		<</if>>
		<<set $enemytrust += 500>>
		<<npckiss>>
		<<if _place is 'pool' or _place is 'bath'>><<water>><br><</if>>
		<<language>>
			<<option 'EN'>>
				<<if _place is 'bath'>>
					Nobody bothers looking for a towel. The three of you get into the tub in whatever order fits, and it does not fit. Robin ends up against the taps, Sydney against the sloping end, and you between them with nowhere to put your legs.
					<br><br>
					<span class='lewd'>Water spills over the rim every time one of them moves. Somebody's knee is pressed against the inside of your thigh and somebody else's hand is already under the surface, and neither of them is pretending it is an accident.</span>
				<<elseif _place is 'pool'>>
					Nobody reaches for a towel or for the clothes left on the deck. The three of you step down into the water together. Robin keeps one hand on the tiled edge, and Sydney waits until you are between them before <<he>> moves.
					<br><br>
					<<if _sydneyStatus.includes('pure')>>Sydney keeps <<his>> robe on, lets the water take it dark and heavy, and says, quietly, "Tell me if this becomes something I should not be doing." <<elseif _sydneyStatus.includes('corrupt')>>Sydney has already loosened <<his>> robe and does not bother to pretend otherwise. <<else>>The water takes the weight off your legs.<<endif>> Robin watches Sydney over your shoulder until Sydney tilts <<his>> head and holds the look, and neither of them steps back from what they agreed to.
					<br><br>
					<span class='lewd'>Somebody's hand finds the inside of your thigh under the water and stays there, and somebody else's mouth closes on the side of your neck and stays there longer. You are held up between the two of them with your hips barely touching the tiles, and every shift of the water drags one of them against you in a way neither of them admits to.</span>
				<<else>>
					You close the bedroom door behind the three of you. Robin sits on the edge of the bed with <<his>> hands folded, glancing at Sydney until Sydney sits down first. "I said I would stay," Robin says quietly. "I meant it."
					<br><br>
					Sydney sets <<his>> temple pendant on the bedside table and keeps one hand on it. <<if _sydneyStatus.includes('pure')>>
					<<He>> looks from you to Robin and back, and the words come out much slower than usual. "I want to be clear about what I am agreeing to. Not everything. Tonight — only what I can still say at morning prayer." <<He>> makes you look at <<him>> before <<he>> moves. "And if I ask you to stop, we stop, whatever Robin is doing." Only then does <<he>> reach for you, and <<his>> hands are shaking until the third touch.
					<<else>>
					"Then neither of us has to guess," <<he>> says. <<He>> waits for you to sit between them before reaching for you.
					<</if>>
					<br><br>
					<span class='lewd'>Their hands meet on you at the same time and neither pulls back. Robin's mouth is careful and wet at your throat while Sydney's fingers work the fastenings of your clothes open one by one, and when Robin turns to look, Sydney holds <<his>> gaze and keeps going. You end up with your back against Robin's chest and your thighs pushed apart by a knee that is not <<his>>, and both of them go quiet to hear the first sound you make.</span>
				<</if>>
			<<option 'CN'>>
				<<if _place is 'bath'>>
					谁也没想起来拿毛巾。三个人往缸里挤，谁先谁后都没讲究，反正挤不下。罗宾被挤到水龙头那头，悉尼靠在斜面一侧，你被夹在中间，两条腿没处放。
					<br><br>
					<span class='lewd'>谁一动，水就往缸沿外面漫。有人的膝盖顶着你的大腿内侧，另一个人的手已经伸进水面之下，两个人都没打算装成是意外。</span>
				<<elseif _place is 'pool'>>
					谁也没有去拿毛巾，也没有去碰平台上叠着的衣服。你们三人一起踏进水里。罗宾一只手扶着瓷砖池沿，悉尼等你站到两人中间，才伸手过来。
					<br><br>
					<<if _sydneyStatus.includes('pure')>>悉尼没有脱修道袍，任水把它浸得又沉又暗，才低声说：“要是这事变成我不该做的，就告诉我。”<<elseif _sydneyStatus.includes('corrupt')>>悉尼的修道袍早已松开，也懒得再装。<<else>>水的浮力托起你的腿。<<endif>>罗宾越过你的肩看向悉尼，直到悉尼偏过头迎上目光，两人谁也没有从答应过的事情上退开。
					<br><br>
					<span class='lewd'>水底下有人的手找到你大腿内侧，停住不动；另一个人的嘴则贴上你颈侧，停了更久。你被两个人夹在中间托着，胯几乎没离开瓷砖，水每晃一下，就有一个人的身体顺着水势贴上你，谁都不承认那是故意的。</span>
				<<else>>
					你关上卧室门。罗宾坐到床边，两手拢在一起，先看了看悉尼，直到悉尼先坐下。“我说过会留下。”罗宾轻声说，“我是认真的。”
					<br><br>
					悉尼把神殿吊坠放到床头柜上，一只手仍按着它。<<if _sydneyStatus.includes('pure')>>
					<<He>>把目光在你和罗宾之间来回移了两次，开口比平时慢得多。“我想先把话说清楚。不是全部。今晚只做我明天早祷时还说得出口的事。”<<He>>让你看着<<him>>的眼睛，才继续往下说。“还有，只要我说停，就停，不管罗宾在做什么。”说到这儿，<<He>>才伸手碰你，指尖一直到第三次触碰时还在抖。
					<<else>>
					“那就不用猜了。”<<he>>说。<<He>>等你坐到两人中间，才伸手碰你。
					<</if>>
					<br><br>
					<span class='lewd'>两人的手同时落到你身上，谁也没收回去。罗宾的嘴小心又湿，在你喉咙上啃着；悉尼的手指一颗一颗解开你的衣扣，罗宾转头看过来时，悉尼迎上目光，手上并没有停。最后你背贴着罗宾的胸口，被一条不属于<<his>>的膝盖顶开两腿，两个人都屏住呼吸，等你发出第一声。</span>
				<</if>>
		<</language>>
		<br><br>
	<</if>>
<</if>>
<<if $combat is 1>>
	<<set _estate to maplebirch.get("Finance").realEstate>>
	<<run _estate.enter(_place is 'bath' ? 'bathroom' : _place)>>
	<<set $outside to _estate.intimacyOutside(_place) ? 1 : 0>>
	<<set $enemyanger to -10>>
	<<effects>>
	<<effectsman>>
	<<man>>
	<<stateman>>
	<br><br>
	<<actionsman>>
	<<if _combatend or _controlRegain is 1>>
		<span id='next'><<lanLink ["Next","继续"] 'Deadwood Reblooms Property Pair Intimacy Finish'>><</lanLink>></span><<nexttext>>
	<<else>>
		<span id='next'><<lanLink ["Next","继续"] 'Deadwood Reblooms Property Pair Intimacy'>><</lanLink>></span><<nexttext>>
	<</if>>
<</if>>

:: Deadwood Reblooms Property Pair Intimacy Finish []
<<set _estate to maplebirch.get("Finance").realEstate>>
<<set _request to _estate.pairRequest>>
<<set _place to _request ? _request.place : 'bedroom'>>
<<set _placeBack to _estate.intimacyReturn(_place)>>
<<set _placeExit to _estate.intimacyExitLabel(_place)>>
<<run _estate.enter(_place is 'bath' ? 'bathroom' : _place)>>
<<set $outside to _estate.intimacyOutside(_place) ? 1 : 0>>
<<effects>>
<<if $combat is 1>>
	<<person1>>
	<<if $enemyarousal gte $enemyarousalmax>>
		<<ejaculation>>
		<<for _name range $npc>>
			<<npcincr _name lust -20>><<npcincr _name love 1>>
		<</for>>
		<<llust>>
		<br>
		<<language>>
			<<option 'EN'>>
				<<if _place is 'bath'>>Robin recovers first, jammed against the taps and too embarrassed to look at either of you. "That was... all right," Robin says, testing the words. Sydney does not mock <<him>>, and there is no room left in the tub for anyone to move away.
				<<elseif _place is 'pool'>>Robin recovers first, still holding the edge of the pool, then looks at Sydney. "That was... all right," Robin says, testing the words. Sydney answers without mocking <<him>>, and the two of them leave room for you between them.
				<<else>>Robin recovers first, then notices how quiet <<he>> has been and looks at Sydney. "That was... all right," Robin says, testing the words. Sydney answers without mocking <<him>>, and the two of them leave room for you between them.<</if>>
			<<option 'CN'>>
				<<if _place is 'bath'>>罗宾先缓过来，被挤在水龙头那头，尴尬得不敢看你们谁。“刚才……还可以。”罗宾试着说出口。悉尼没有取笑<<him>>——缸里也没地方让人躲开。
				<<elseif _place is 'pool'>>罗宾先缓过来，手还扶着池沿，随即看向悉尼。“刚才……还可以。”罗宾试着说出口。悉尼没有取笑<<him>>，两人把中间的位置留给你。
				<<else>>罗宾先缓过来，随即意识到自己一直太安静，便看向悉尼。“刚才……还可以。”罗宾试着说出口。悉尼没有取笑<<him>>，两人把中间的位置留给你。<</if>>
		<</language>>
	<<elseif $enemyarousal lt $enemyarousalmax and $enemyhealth gt 0>>
		<<llust>>
		<br>
		<<language>>
			<<option 'EN'>>
				You stop before either of them has to ask. Robin loosens <<his>> grip, and Sydney <<if _place is 'bath'>>sinks back against the sloping end of the tub<<elseif _place is 'pool'>>floats back to the rail<<else>>sits back against the headboard<</if>> to catch <<his>> breath.
			<<option 'CN'>>
				不必等谁开口，你先停了下来。罗宾松开手，悉尼<<if _place is 'bath'>>靠回浴缸的斜面一侧<<elseif _place is 'pool'>>退到池边扶着栏杆<<else>>靠回床头<</if>>缓气。
		<</language>>
	<<else>>
		<<if $enemyarousal gte $enemyarousalmax>>
		  <<ejaculation>>
		<</if>>
		<<language>>
			<<option 'EN'>>
				They are both past the point of continuing. <<if _place is 'bath'>>Robin keeps you from slipping under the water while Sydney catches <<his>> breath.<</if>><<if _place is 'pool'>>Robin steadies you against the edge of the pool while Sydney catches <<his>> breath.<</if>><<if _place is 'bedroom'>>Robin pulls the blanket up over the three of you while Sydney catches <<his>> breath.<</if>>
			<<option 'CN'>>
				两人都没法继续了。<<if _place is 'bath'>>罗宾扶住你，没让你滑进水里，悉尼还在缓气。<</if>><<if _place is 'pool'>>罗宾把你扶在池边，悉尼还在缓气。<</if>><<if _place is 'bedroom'>>罗宾把毯子拉过你们三个人，悉尼还在缓气。<</if>>
		<</language>>
	<</if>>
	<<if $npc.includes('Robin')>>
		<<if C.npc.Robin.trauma gte 20>>
		  <<npcincr Robin trauma -1>><<lrtrauma>>
		<</if>>
	<</if>>
	<<if $npc.includes('Sydney')>>
		<<run statusCheck('Sydney')>>
		<<set $corruptionEvent to 1>>
		<<npcincr Sydney purity -2>><<lspurity>>
	<</if>>
	<br><br>
<</if>>
<<if _place is 'pool'>>
	<<dry>>
	<<if $Finance.real_estate.pool_clothing is 'nude'>><<clotheson>>
	<<elseif $Finance.real_estate.pool_clothing is 'swimwear'>><<run maplebirch.get("Finance").realEstate.openWardrobe()>><<storeon 'Deadwood Property Pool'>><<set $wear_outfit to 'none'>><</if>>
<<elseif _place is 'bath'>>
	<<dry>><<clotheson>>
<<else>>
	<<clotheson>>
<</if>>
<<run _estate.clearPairRequest()>>
<<endcombat>>
<<if setup.clothingLayer.all.some(slot => $store[slot]?.some(item => item.location === 'Deadwood Property Bed'))>>
	<<deadwood-reblooms-property-clothes-on>>
<</if>>
<<getouticon>><<lanLink _placeExit _placeBack>><</lanLink>>

:: Deadwood Reblooms Household Agreement Widgets [widget]
<!-- 面谈前后复用原版地点，不把十分钟讨论延伸到下一堂课或下一项职责。 -->
<<widget 'deadwood-home-sharing-ready'>><<silently>>
  <<set $_name to _args[0], $_origin to _args[2]>>
  <<set _homeSharingReady to maplebirch.get('Finance').realEstate.sharingReady($_name, _args[1])>>
  <<if _homeSharingReady>>
    <<schooleffects>>
    <<if $_name is 'Sydney'>>
      <<sydneySchedule>>
      <<set _homeSharingReady to ($_origin is 'Temple Sydney' and _sydney_location is 'temple' and ['pray', 'quarters'].includes($sydney_templeWork))
        or ($_origin is 'Library Rental Counter' and _sydney_location is 'library')
        or ($_origin is 'English Classroom' and _sydney_location is 'rehearsal' and !$englishPlayLate)>>
    <<else>>
      <<set $_area to getKylarLocation().area>>
      <<set _homeSharingReady to ({'Kylar Library': 'library', 'Kylar Courtyard': 'rear_courtyard', 'Kylar Park': 'park', 'English Classroom': 'english'})[$_origin] is $_area>>
    <</if>>
  <</if>>
<</silently>><</widget>>

<!-- 特殊同住路线分别与本人面谈。原版特质不替另一位恋人作决定，也不开放三人亲密。 -->
<<widget 'deadwood-home-sharing'>>
  <<set $_estate to maplebirch.get('Finance').realEstate, $_name to _args[0], $_home to _args[1], $_return to _args[2], $_origin to _args[3]>>
  <<deadwood-home-sharing-ready $_name $_home $_origin>>
  <<if !_homeSharingReady>><<exit>><</if>>
  <<set $_living to $_estate.residentsAt($_home).some(profile => profile.id === $_name)>>
  <<if $_estate.managementFor($_home).sharing?.includes($_name)>>
    <<language>>
      <<option 'EN'>>
        <<if $_name is 'Kylar'>>You have explained which rooms you would each use. "All right. But you still come back to me." Kylar watches your face until you answer.<<else>>You have explained the separate rooms and the morning routine to Sydney. "Then that should work. Just don't let Kylar scribble in my books." <<nnpc_He 'Sydney'>> smiles, but checks that you heard the last part.<</if>>
      <<option 'CN'>>
        <<if $_name is 'Kylar'>>你已经向凯拉尔说明各自住哪间房。“好吧。可你还是要回来陪我。”凯拉尔看着你的脸，等你回答。<<else>>你已经向悉尼说明各自的房间和清晨的安排。“那就这样。可别让凯拉尔在我的书上乱画。”<<nnpc_He 'Sydney'>>笑了笑，又确认你听见了最后一句。<</if>>
    <</language>><br><br>
  <<else>>
    <<language>>
      <<option 'EN'>>
        <<if $_name is 'Kylar'>>
          <<if $_living>>"Sydney too? You aren't asking me to leave, are you?"<<else>>"Sydney lives there? I thought it would be just us."<</if>> Kylar looks at you, waiting for an answer.
        <<else>>
          <<if $_living>>"Kylar wants to move in?" Sydney asks. "I'll still have my own room, won't I?"<<else>>"Has Kylar agreed to this?" Sydney asks. "I don't want to turn up with my things and find out otherwise. And I'll need a room of my own."<</if>>
        <</if>>
      <<option 'CN'>>
        <<if $_name is 'Kylar'>>
          <<if $_living>>“悉尼也来？你不是想让我走吧？”<<else>>“悉尼住在那里？我还以为只有我们。”<</if>>凯拉尔看着你，等你回答。
        <<else>>
          <<if $_living>>“凯拉尔也想搬来？”悉尼问。“我还是住自己的房间，对吧？”<<else>>“凯拉尔答应了吗？”悉尼问。“我可不想提着东西到了门口，才知道没这回事。还有，我得有自己的房间。”<</if>>
        <</if>>
    <</language>><br><br>
    <<capture $_name $_home $_return $_origin>>
      <<socialiseicon>><<lanLink ['Discuss the rooms and daily routine (0:10)', '说清房间与平日的安排 (0:10)'] $_return>>
        <<deadwood-home-sharing-ready $_name $_home $_origin>>
        <<if _homeSharingReady and !maplebirch.get('Finance').realEstate.managementFor($_home).sharing?.includes($_name)>>
          <<pass 10>><<deadwood-home-sharing-ready $_name $_home $_origin>>
          <<if _homeSharingReady>><<run maplebirch.get('Finance').realEstate.agreeSharing($_name, $_home)>><</if>>
        <</if>>
      <</lanLink>><br><br>
    <</capture>>
  <</if>>
<</widget>>

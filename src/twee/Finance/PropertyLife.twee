:: Deadwood Reblooms Property Life Widgets [widget]

<<widget 'deadwood-home-life-menu'>>
  <<set _life_estate to maplebirch.get('Finance').realEstate>>
  <<set _home_life to _life_estate.life>>
  <<if !_life_estate.current>><<exit>><</if>>
  <<if _args[0] is 'kitchen'>>
    <<set _life_cook to $per_npc[_life_estate.staff.key('cook')]>>
    <<if _life_estate.staff.active('cook') and _life_cook>>
      <<language>>
        <<option 'EN'>>
          <<print _life_cook.name>> clears a place beside the hob and sets out clean dishes for you. "Let me know when you're ready to serve."
        <<option 'CN'>>
          厨师<<print _life_cook.name>>在灶旁清出一块地方，替你备好干净的餐具。“准备上桌的时候，叫我一声。”
      <</language>><br><br>
    <</if>>
    <<deadwood-home-company>>
    <<set _home_dishes to Object.keys(setup.foodstuff).filter(key => setup.foodstuff[key].category === 'dish' && !setup.foodstuff[key].food?.tags?.includes('drink') && !setup.foodstuff[key].food?.tags?.includes('tainted') && ($foodstuff[key]?.amount ?? 0) >= 2)>>
    <<set _home_drinks to Object.keys(setup.foodstuff).filter(key => setup.foodstuff[key].category === 'dish' && setup.foodstuff[key].food?.tags?.includes('drink') && !setup.foodstuff[key].food?.tags?.some(tag => ['tainted', 'alcohol'].includes(tag)) && ($foodstuff[key]?.amount ?? 0) >= 2)>>
    <<if _home_life.ready('meal') and _home_dishes.length>>
      <<deadwood-home-meal-invitation>>
      <<set _home_meal_options to {}>>
      <<for _food range _home_dishes>>
        <<set _home_meal_options[setup.foodstuff[_food].name] to _food>>
      <</for>>
      <label><<lanSwitch 'Meal: ' '餐点：'>><<listbox '_home_meal' autoselect>><<optionsfrom _home_meal_options>><</listbox>></label><br>
      <<icon 'property/shared-meal.png'>><<lanLink ['Share a homemade meal (0:20)', '一起吃做好的餐点 (0:20)'] 'Deadwood Reblooms Property Life Finish'>>
        <<deadwood-home-life-act 'meal' _home_meal>>
      <</lanLink>><<lstress>><span class='blue'> | <<lanSwitch 'Two portions' '两份餐点'>></span><br>
      <<if $Finance.real_estate.room_companion is 'Robin'
          and !($Finance.real_estate.life.recollections.Robin?.day is Math.floor(Time.days)
            and $Finance.real_estate.life.recollections.Robin.property_id is _life_estate.current.id)>>
        <<refuseicon>><<lanLink ['Not just now', '现在先不吃'] 'Deadwood Reblooms Property Kitchen'>><<deadwood-home-meal-decline>><</lanLink>><br>
      <</if>>
    <</if>>
    <<if _home_life.ready('tea') and _home_drinks.length>>
      <<set _home_drink_options to {}>>
      <<for _food range _home_drinks>>
        <<set _home_drink_options[setup.foodstuff[_food].name] to _food>>
      <</for>>
      <label><<lanSwitch 'Drink: ' '饮品：'>><<listbox '_home_drink' autoselect>><<optionsfrom _home_drink_options>><</listbox>></label><br>
      <<icon 'property/shared-drinks.png'>><<lanLink ['Sit together over a drink (0:15)', '喝点东西，坐一会儿 (0:15)'] 'Deadwood Reblooms Property Life Finish'>>
        <<deadwood-home-life-act 'tea' _home_drink>>
      <</lanLink>><<lstress>><span class='blue'> | <<lanSwitch 'Two portions' '两份饮品'>></span><br>
    <</if>>
    <<if $Finance.real_estate.room_companion and !_home_dishes.length and !_home_drinks.length>>
      <span class='blue'><<lanSwitch 'You can prepare two portions in the kitchen to share.' '在厨房准备两份餐点或饮品，就能一起享用。'>></span><br>
    <</if>>
  <<else>>
    <<set _life_housekeeper to $per_npc[_life_estate.staff.key('housekeeper')]>>
    <<if _life_estate.staff.active('housekeeper') and _life_housekeeper>>
      <<language>>
        <<option 'EN'>>
          <<print _life_housekeeper.name>> has put the clean cups back and folded the spare blanket. A cloth waits beside the table for anything you spill.
        <<option 'CN'>>
          保洁员<<print _life_housekeeper.name>>已经收好洗净的杯子，叠起备用毯子。桌边留着一块抹布，洒了东西随时可以擦。
      <</language>><br><br>
    <</if>>
    <<if !_args[1]>><<deadwood-home-company>><</if>>
    <<if _home_life.ready('music')>>
      <<icon 'radio.png'>><<lanLink ['Listen to music (0:20)', '听会儿音乐 (0:20)'] 'Deadwood Reblooms Property Life Finish'>>
        <<deadwood-home-life-act 'music'>>
      <</lanLink>><<lstress>><br>
    <</if>>
    <<if _home_life.ready('tidy')>>
      <<icon 'broom-dustpan.png'>><<lanLink ['Put the room in order (0:20)', '收拾房间 (0:20)'] 'Deadwood Reblooms Property Life Finish'>>
        <<deadwood-home-life-act 'tidy'>>
      <</lanLink>><<ghousekeeping 600>><<gtiredness>><br>
    <</if>>
  <</if>>
  <<deadwood-home-wine-menu>>
<</widget>>

<!-- 开始时消耗食物与酒；完成活动后才结算陪伴收益。 -->
<<widget 'deadwood-home-life-act'>>
  <<set $_life_estate to maplebirch.get('Finance').realEstate>>
  <<if (_args[0] isnot 'wine' or !(playerIsPregnant() and playerAwareTheyArePregnant())) and $_life_estate.life.begin(_args[0], _args[1])>>
    <<set $_life_scene to $_life_estate.life.scene, $_life_day to Time.days, $_life_origin to $passage, $_life_location to $location>>
    <<set $_life_duration to 20>>
    <<switch $_life_scene.action>>
      <<case 'meal' 'tea'>>
        <<tending_give $_life_scene.item -2>>
        <<if $_life_scene.action is 'tea'>><<set $_life_duration to 15>><</if>>
      <<case 'film'>>
        <<set $_life_duration to 45>>
      <<case 'wine'>>
        <<if ['red_wine', 'white_wine', 'ghostbrew'].includes($_life_scene.item)>><<tending_give $_life_scene.item -1>><</if>>
        <<drunk 60>>
        <<if $_life_scene.item is 'ghostbrew'>><<hallucinogen 120>><</if>>
    <</switch>>
    <<pass $_life_duration>>
    <<if $_life_estate.life.scene isnot $_life_scene or $_life_estate.current?.id isnot $_life_scene.property_id
        or $passage isnot $_life_origin or maplebirch.passage.title isnot $_life_scene.origin or $location isnot $_life_location
        or $Finance.real_estate.room_companion isnot $_life_scene.partner or !$_life_estate.life.ready($_life_scene.action, 0)>>
      <<if $_life_estate.life.scene is $_life_scene>><<set $Finance.real_estate.life.scene to null>><</if>>
      <<exit>>
    <</if>>
    <<set $Finance.real_estate.life.days[($_life_scene.partner ?? 'pc') + ':' + $_life_scene.action] to $_life_day>>
    <<switch $_life_scene.action>>
      <<case 'meal' 'tea'>>
        <<stress `$_life_scene.action is 'meal' ? -3 : -2`>>
        <<if $_life_scene.first and $_life_scene.quality gte 2>><<stress -1>><</if>>
      <<case 'tidy'>>
        <<housekeeping 1 600>><<tiredness `$_life_scene.quality >= 2 || currentSkillValue('housekeeping') >= 500 ? 1 : 2`>>
      <<case 'music'>>
        <<stress -2>>
      <<case 'film'>>
        <<stress -4>>
        <<if $_life_scene.item is 'erotic'>>
          <<promiscuity1>>
          <<arousal 1000>>
        <</if>>
      <<case 'wine'>>
        <<stress -3>>
    <</switch>>
    <<if $_life_scene.partner and $_life_scene.first>>
      <<npcincr $_life_scene.partner love 1>>
      <<if $_life_scene.partner is 'Robin'>>
        <<npcincr Robin trauma -1>>
      <</if>>
      <<if $_life_scene.partner is 'Kylar'>>
        <<npcincr Kylar rage -1>>
      <</if>>
    <</if>>
    <<if $_life_scene.action is 'film' and $_life_scene.item is 'erotic' and $_life_scene.partner>>
      <<npcincr $_life_scene.partner lust 5>>
      <<if $_life_scene.partner is 'Sydney' and C.npc.Sydney.purity gte 1>>
        <<npcincr Sydney purity -1>>
      <</if>>
    <</if>>
    <<if $_life_scene.first and ['meal', 'tea', 'music', 'film'].includes($_life_scene.action)>>
      <<psyche-rest 2 `$_life_scene.action is 'film' ? 60 : 40`>>
    <</if>>
    <<if $_life_scene.action is 'meal' and $_life_scene.partner is 'Robin'>>
      <<deadwood-home-moment 'Robin' 'join'>>
    <</if>>
    <<if $_life_scene.action is 'wine'>>
      <<goto 'Deadwood Reblooms Property Life Finish'>>
    <</if>>
  <<elseif _args[0] is 'wine'>>
    <<replace '#deadwood-home-wine-message'>>
      <span class='blue'><<lanSwitch 'You cannot open that bottle right now.' '现在没法打开这瓶酒。'>></span>
    <</replace>>
  <<elseif !$nextPassage and !$nextPassageCheck>>
    <<set $nextPassage to maplebirch.passage.title>>
  <</if>>
<</widget>>

<<widget 'deadwood-home-life-reaction'>>
  <<set _life_scene to maplebirch.get('Finance').realEstate.life.scene>>
  <<if !_life_scene?.partner>><<exit>><</if>>
  <<npc _life_scene.partner>><<person1>>
  <!-- 特殊酒只给 PC 结算，陪伴者复用已有的饮水反应。 -->
  <<if _life_scene.action is 'wine' and (_life_scene.item is 'ghostbrew' or knowsAboutPregnancy(_life_scene.partner, 'pc'))>>
    <<language>>
      <<option 'EN'>>
        <<if _life_scene.item is 'ghostbrew'>>You explain which mushrooms went into the wine and keep the bottle on your side of the table.<</if>>
        You leave a glass of water beside yours.
        <<switch _life_scene.partner>>
          <<case 'Robin'>>Robin takes the water, holding the glass in both hands. "I'll keep you company." <<He>> smiles when you sit down.
          <<case 'Whitney'>>"That bottle's yours, then." Whitney takes the water and settles back. "Don't finish the whole fucking thing just to impress me."
          <<case 'Kylar'>>Kylar chooses the water. "I'm still staying here with you." <<He>> puts <<his>> glass beside yours and asks what the drink tastes like.
          <<case 'Sydney'>>"Water will do for me." Sydney sets the bottle within your reach and keeps the second chair. <<if _life_wine_recipe>>"You can still tell me how you made it."<</if>>
        <</switch>>
      <<option 'CN'>>
        <<if _life_scene.item is 'ghostbrew'>>你说起酿酒用的蘑菇，把瓶子留在自己这边。<</if>>
        你在自己的酒杯旁放了一杯水。
        <<switch _life_scene.partner>>
          <<case 'Robin'>>罗宾选了水，两手捧着杯子。“我陪你就好。”你坐下时，<<he>>朝你笑了笑。
          <<case 'Whitney'>>“那瓶就留给你了。”惠特尼拿起水，往椅背上一靠。“别为了逞能，把整瓶都他妈喝了。”
          <<case 'Kylar'>>凯拉尔选了水。“我还是会陪着你。”<<He>>把杯子放在你的杯旁，问起酒的味道。
          <<case 'Sydney'>>“我喝水就好。”悉尼把酒瓶放在你手边，仍坐在旁边的椅子上。<<if _life_wine_recipe>>“你还是可以给我讲讲怎么酿的。”<</if>>
        <</switch>>
    <</language>>
  <<else>>
  <<switch _life_scene.partner>>
    <<case 'Robin'>>
      <<if C.npc.Robin.trauma gte 20>>
        <<language>>
          <<option 'EN'>>
            <<if _life_scene.action is 'meal' or _life_scene.action is 'tea'>>Robin cups <<his>> hands around the dish, taking small tastes while you talk. <<He>> glances towards the hallway when the house creaks, then listens to you again. "Can we take our time?" You leave your seat where it is.
            <<elseif _life_scene.action is 'film'>><<if _life_scene.item is 'erotic'>>Robin gasps softly as the tape begins, pulling a cushion up to hide <<his>> face. <<He>> peeks out between parted fingers with burning red cheeks, staying tucked close against your side.<<else>>Robin asks you to turn the sound down. You leave a small light on beside the seats. <<He>> follows the story in silence, gradually letting go of the cushion.<</if>>
            <<elseif _life_scene.action is 'tidy'>>Robin folds the same blanket twice. You take the next one, leaving <<him>> to finish at <<his>> own pace. "This is all right, isn't it?" <<He>> asks, showing you the folds.
            <<elseif _life_scene.action is 'wine'>>Robin leaves most of <<his>> drink in the glass. <<if _life_wine_recipe>>"You made this?" <<He>> takes a small taste when you explain which fruit you used.<</if>> You talk for a while, and <<he>> draws <<his>> chair closer when you ask whether <<he>> would like to stay.
            <<else>>Robin asks for something quiet. You lower the volume, and <<he>> settles back beside you. Neither of you has to fill the silence.<</if>>
          <<option 'CN'>>
            <<if _life_scene.action is 'meal' or _life_scene.action is 'tea'>>罗宾用双手拢着餐具，一边听你说话，一边小口品尝。房子发出轻响时，<<he>>望向走廊，随后又转回来。“我们可以慢慢来吗？”你没有离开座位。
            <<elseif _life_scene.action is 'film'>><<if _life_scene.item is 'erotic'>>录像一开始，罗宾便轻吸了一口气，抱起靠垫挡在脸前。<<He>>从指缝间偷偷望向屏幕，脸颊红得发烫，整个人缩在你的身旁。<<else>>罗宾请你把声音调低。你留着座椅旁的一盏小灯。<<He>>静静看着故事，抓着靠垫的手渐渐松了些。<</if>>
            <<elseif _life_scene.action is 'tidy'>>罗宾把同一条毯子叠了两遍。你拿起下一条，让<<he>>慢慢整理。“这样可以吧？”<<He>>展开叠好的边角给你看。
            <<elseif _life_scene.action is 'wine'>>罗宾的酒几乎没动。<<if _life_wine_recipe>>“这是你酿的？”听你说起用了什么水果，<<he>>才又尝了一小口。<</if>>你们聊了一会儿，你问<<he>>要不要再坐坐，<<he>>便把椅子往近处挪了些。
            <<else>>罗宾想听些轻柔的音乐。你调低音量，<<he>>在你身旁坐稳。谁也不用急着找话说。<</if>>
        <</language>>
      <<elseif _life_scene.action is 'meal' or _life_scene.action is 'tea'>>
        <<language>>
          <<option 'EN'>>
            Robin pulls the second chair out before sitting down. <<if C.npc.Robin.dom gte 40>>"You've been on your feet enough. Sit." <<He>> pushes your portion within reach, then starts telling you about the day.<<else>>"I like doing this," <<he>> says, smiling over the table. "Just the two of us." <<He>> pauses to ask how your day went.<</if>>
          <<option 'CN'>>
            罗宾先替你拉开椅子，才坐了下来。<<if C.npc.Robin.dom gte 40>>“你站得够久了。坐吧。”<<He>>把你那份推到手边，开始说起今天的事。<<else>>“我喜欢这样。”<<He>>隔着桌子朝你笑。“就我们两个。”<<He>>停下来，问你今天过得怎么样。<</if>>
        <</language>>
      <<elseif _life_scene.action is 'film'>>
        <<language>>
          <<option 'EN'>>
            <<if _life_scene.item is 'comedy'>>Robin laughs at a joke just after you do, then explains the part that made <<him>> laugh.<<elseif _life_scene.item is 'erotic'>>Robin's eyes widen as <<he>> realizes what is playing. <<His>> face turns bright pink and <<he>> nervously clutches your sleeve, resting <<his>> warm forehead against your shoulder. "I didn't know you had a tape like this..." <<he>> stammers, unable to look away from the screen for long.<<else>>Robin shifts forward whenever the hero gets into trouble. "That was obviously a trap," <<he>> whispers, then laughs when you remind <<him>> to keep watching.<</if>> When the credits start, <<he>> asks which one you would like to watch next time.
          <<option 'CN'>>
            <<if _life_scene.item is 'comedy'>>你刚笑出声，罗宾便也跟着笑了起来，又和你说起是哪一段让<<he>>觉得好笑。<<elseif _life_scene.item is 'erotic'>>罗宾看清屏幕上的画面，眼睛微微睁大，脸蛋一下子通红。<<He>>局促地抓紧你的衣袖，把发烫的额头抵在你的肩上。“我不知道……你还有这种录像……”<<He>>结结巴巴地说着，目光却忍不住又悄悄瞟向屏幕。<<else>>主角遇到麻烦时，罗宾便往前凑。“明显是陷阱嘛。”<<He>>小声说。你叫<<he>>接着看，<<he>>便笑了。<</if>>字幕滚动时，<<he>>问你下次想看什么。
        <</language>>
      <<elseif _life_scene.action is 'tidy'>>
        <<language>>
          <<option 'EN'>>
            Robin collects the cups while you clear the table. "There's less to wash than at the orphanage," <<he>> says. You take half the stack before <<he>> can carry it all away. <<He>> gives you a small, grateful smile.
          <<option 'CN'>>
            你擦桌子，罗宾收杯子。“比孤儿院要洗的少多了。”<<He>>说。你在<<he>>全部端走之前分过一半，<<he>>便朝你露出感激的笑容。
        <</language>>
      <<else>>
        <<language>>
          <<option 'EN'>>
            <<if _life_scene.action is 'wine'>><<if _life_wine_recipe>>"From your orchard?" Robin turns the bottle to look at it. "You should show me how you made it."<<else>>"People do this in films," Robin says, looking at the bottle.<</if>> "Do we have to talk about something important?" <<He>> smiles when you bring up something that happened today.
            <<else>>Robin taps out the rhythm with a finger. "I know this one." <<He>> hums a few notes, then laughs at <<himself>>. You stay until the music ends.<</if>>
          <<option 'CN'>>
            <<if _life_scene.action is 'wine'>><<if _life_wine_recipe>>“你果园里的？”罗宾转着酒瓶，仔细看了看。“下次给我看看是怎么酿的吧。”<<else>>“电影里的人会这样。”罗宾看着酒瓶说。<</if>>“我们是不是该聊些重要的事？”你说起今天的一件小事，<<he>>便笑了。
            <<else>>罗宾用手指轻轻打着节拍。“这首我听过。”<<He>>哼了几句，自己先笑了起来。你们一直坐到音乐结束。<</if>>
        <</language>>
      <</if>>
    <<case 'Whitney'>>
      <<language>>
        <<option 'EN'>>
          <<if _life_scene.action is 'meal'>>Whitney takes a taste before you finish setting the table. <<if _life_scene.item is 'pizza'>>"Now that's what I'm talking about." <<He>> puts a slice on your plate, then takes a larger one for <<himself>>.<<elseif setup.foodstuff[_life_scene.item].food?.tags?.includes('spicy')>>"Smells like you know what you're doing, slut." <<He>> reaches for the sauce, eyeing your portion with a grin.<<else>>"You made all this?" <<He>> takes another bite. "It's good. Don't let it go to your head."<</if>>
          <<elseif _life_scene.action is 'tea' or _life_scene.action is 'wine'>>Whitney raises <<if _life_scene.action is 'wine'>>the glass<<else>>the cup<</if>> in a mocking toast. "To my talented slut." <<He>> takes a drink, then notices you looking. "What? I'm being nice." <<if _life_scene.action is 'wine'>><<if _life_wine_recipe>>"Your own stuff, huh? Not bad." <<He>> examines the bottle before putting it between you.<<else>><<He>> leaves the bottle between you.<</if>><<else>><<He>> sets the cup down and leans back in the chair.<</if>>
          <<elseif _life_scene.action is 'film'>>Whitney sprawls in the next seat. <<if _life_scene.item is 'comedy'>>"Fucking idiot." <<He>> points at the screen, laughing loudly.<<elseif _life_scene.item is 'erotic'>>Whitney gives a low whistle as the lovers embrace on screen. A smirk spreads across <<his>> face as <<he>> leans across the armrest, resting a warm hand firmly on your thigh. "Didn't know you were in this kind of mood, <<bitch>>... Getting turned on just watching, huh?"<<else>>"That idiot's going to get killed," <<he>> says, pointing at the screen.<</if>> <<if _life_scene.item isnot 'erotic'>><<if C.npc.Whitney.dom gte 10>><<He>> claims the armrest, then makes space when you ask.<<else>><<He>> shifts <<his>> elbow aside before yours touches it.<</if>> <<He>> stops talking long enough to see whether <<he>> was right.<</if>>
          <<elseif _life_scene.action is 'tidy'>>"I've seen worse," Whitney says, looking at the room. You hand <<him>> the pile <<he>> left beside the chair. <<He>> complains, but puts it away while you finish the table.
          <<else>>Whitney turns the volume up, then watches your hand reach for the control. "Fine. Don't want to wake the whole fucking street." <<He>> leaves it lower, tapping <<his>> heel against the chair.<</if>>
        <<option 'CN'>>
          <<if _life_scene.action is 'meal'>>你还没摆好桌子，惠特尼已经尝了一口。<<if _life_scene.item is 'pizza'>>“这才像样。”<<He>>在你的盘子里放了一片，又给自己拿了块更大的。<<elseif setup.foodstuff[_life_scene.item].food?.tags?.includes('spicy')>>“闻着不错，你挺会嘛，骚货。”<<He>>伸手去拿酱汁，笑着瞟了一眼你那份。<<else>>“都是你做的？”<<He>>又咬了一口。“不错。别得意。”<</if>>
          <<elseif _life_scene.action is 'tea' or _life_scene.action is 'wine'>>惠特尼举杯，装模作样地敬了敬你。“敬我能干的小骚货。”<<He>>喝了一口，发现你在看<<him>>。“干什么？我在夸你。”<<if _life_scene.action is 'wine'>><<if _life_wine_recipe>>“自己酿的？还不错。”<<He>>看了看酒瓶，才把它放在你们之间。<<else>><<He>>把酒瓶留在你们之间。<</if>><<else>><<He>>放下杯子，往椅背上一靠。<</if>>
          <<elseif _life_scene.action is 'film'>>惠特尼摊在旁边的座位里。<<if _life_scene.item is 'comedy'>>“真他妈蠢。”<<He>>指着屏幕，大声笑了起来。<<elseif _life_scene.item is 'erotic'>>屏幕中两人相拥时，惠特尼吹了声口哨，嘴角勾起坏笑。<<He>>越过座椅扶手倾身靠近，温热的手掌按在你的大腿上。“没想到你还有这兴致，骚货……光是看着就受不了了？”<<else>>“那傻子肯定要死。”<<He>>指着屏幕说。<</if>><<if _life_scene.item isnot 'erotic'>><<if C.npc.Whitney.dom gte 10>><<He>>占了扶手，听见你叫<<he>>让一点，才腾出地方。<<else>>你的手肘还没碰过来，<<he>>便挪开了胳膊。<</if>><<He>>总算安静了会儿，要看看自己说得对不对。<</if>>
          <<elseif _life_scene.action is 'tidy'>>“我见过更乱的。”惠特尼看着房间说。你把<<he>>丢在椅子旁的一叠东西递过去。<<He>>嘴上抱怨，还是在你擦完桌子时收好了东西。
          <<else>>惠特尼调高音量，随后看着你的手伸向开关。“行吧。省得把整条街都他妈吵醒。”<<He>>没有再调回去，脚跟轻轻敲着椅子。<</if>>
      <</language>>
    <<case 'Kylar'>>
      <<language>>
        <<option 'EN'>>
          <<if _life_scene.action is 'meal'>>Kylar waits for you to sit before touching <<his>> portion. <<if _life_scene.item is 'chilli_con_carne'>>"You remembered." <<He>> takes the first spoonful too quickly, then slows down to keep pace with you.<<else>>"You kept some for me?" <<He>> looks from the plate to you, then takes a bite. "Thank you."<</if>>
          <<elseif _life_scene.action is 'tea'>>Kylar holds the cup in both hands. <<He>> watches you over the rim. "We could do this again," <<he>> says quietly, waiting to see whether you agree.
          <<elseif _life_scene.action is 'film'>>Kylar chooses the seat nearest you, though the rest of the room is empty. <<if _life_scene.item is 'erotic'>><<if C.npc.Kylar.rage gte 60>>Kylar's breath hitches. <<He>> shivers, pressing tight against your side, fingers trembling against your palm. "Are you watching them, or thinking of me? Only look at me, <<kylar_pet_name>>..."<<else>>Kylar's breath catches in <<his>> throat as the scene unfolds. Blushing crimson, <<he>> leans against you, whispering into your ear, "Is this... what you like? We can... do whatever you want..."<</if>><<elseif C.npc.Kylar.rage gte 60>>Whenever the lead kisses someone on screen, <<he>> looks at you. "You aren't thinking about anyone else, are you?"<<else>>"You can choose next time too." <<He>> smiles, looking at you when the screen lights up.<</if>>
          <<elseif _life_scene.action is 'wine'>>Kylar turns the label towards the light, checking it before tasting. <<if _life_wine_recipe>>"You made it yourself?" <<He>> asks how long you had to wait.<<else>>"This one's from a shop?"<</if>> <<He>> sets the bottle back carefully. <<if C.npc.Kylar.rage gte 60>><<if _life_scene.origin is 'Deadwood Reblooms Property Wine Cellar'>>"Who else have you brought down here?"<<else>>"Who else have you brought here?"<</if>> <<He>> studies your face while you answer.<<else>><<if _life_scene.origin is 'Deadwood Reblooms Property Wine Cellar'>>"It's nice down here."<<else>>"It's nice here."<</if>> <<He>> leaves <<his>> chair close to yours.<</if>>
          <<elseif _life_scene.action is 'tidy'>>Kylar puts your things aside carefully, lining up the edges. <<He>> pauses over a scrap of paper. "Do you still want this?" <<He>> waits for your answer before putting it in the bin.
          <<else>>Kylar recognises the melody halfway through. <<if C.npc.Kylar.rage gte 60>>"Does this remind you of someone?" <<He>> falls quiet when you tell <<him>> why you chose it.<<else>><<He>> hums beneath <<his>> breath, only loud enough for you to hear.<</if>><</if>>
        <<option 'CN'>>
          <<if _life_scene.action is 'meal'>>凯拉尔等你坐下，才碰了自己的餐点。<<if _life_scene.item is 'chilli_con_carne'>>“你记得。”<<He>>第一勺吃得太快，又慢下来，跟着你的速度吃。<<else>>“你给我留了？”<<He>>从盘子望向你，尝了一口。“谢谢。”<</if>>
          <<elseif _life_scene.action is 'tea'>>凯拉尔两手捧着杯子，从杯沿上方看着你。“下次还能这样。”<<He>>轻声说，等你答应。
          <<elseif _life_scene.action is 'film'>>放映室里的其他座位全空着，凯拉尔仍挑了最靠近你的那个。<<if _life_scene.item is 'erotic'>><<if C.npc.Kylar.rage gte 60>>凯拉尔呼吸一滞，身体轻颤着紧贴住你的身侧，微抖的手指扣进你的掌心。“你在看他们，还是在想我？只能看我，<<kylar_pet_name>>……”<<else>>画面流转间，凯拉尔喉间微哽，整张脸瞬间涨得通红。<<He>>靠在你的肩窝，贴在你耳边轻颤着低语：“你……喜欢这种吗？你想怎么做……我都陪你……”<</if>><<elseif C.npc.Kylar.rage gte 60>>屏幕上的主角吻上谁，<<he>>便转过来看你。“你没在想别人吧？”<<else>>“下次也让你挑。”<<He>>笑着说。屏幕亮起时，<<he>>仍在看你。<</if>>
          <<elseif _life_scene.action is 'wine'>>凯拉尔将标签转向灯光，确认过才尝了一口。<<if _life_wine_recipe>>“你自己酿的？”<<He>>问你等了多久。<<else>>“这瓶是店里买的？”<</if>><<He>>小心放回瓶子。<<if C.npc.Kylar.rage gte 60>><<if _life_scene.origin is 'Deadwood Reblooms Property Wine Cellar'>>“你还带谁下来过？”<<else>>“你还带谁来过这里？”<</if>><<He>>盯着你的脸，听你回答。<<else>>“这里挺好。”<<He>>把椅子留在你的椅子旁。<</if>>
          <<elseif _life_scene.action is 'tidy'>>凯拉尔仔细收好你的东西，将边角排整齐。<<He>>拿起一张碎纸，却没急着扔。“这个你还要吗？”等你回答，<<he>>才把它放进垃圾桶。
          <<else>>曲子播到一半，凯拉尔认出了旋律。<<if C.npc.Kylar.rage gte 60>>“你听这个，会想起谁？”你解释为什么挑这首，<<he>>便安静下来。<<else>><<He>>轻轻哼着，只够你一个人听见。<</if>><</if>>
      <</language>>
    <<case 'Sydney'>>
      <<run statusCheck('Sydney')>>
      <<language>>
        <<option 'EN'>>
          <<if _life_scene.action is 'meal'>>Sydney sets <<his>> napkin neatly beside the plate. <<if _life_scene.item is 'apple_crumble'>>"Oh, you made crumble!" <<He>> catches <<himself>> saying it too loudly, then digs in. Before long, <<he>> has to brush crumbs from <<his>> sleeve.<<elseif setup.foodstuff[_life_scene.item].food?.tags?.includes('spicy')>>Sydney takes a careful bite, then reaches for <<his>> drink with watering eyes. "It's good. I just wasn't ready for that."<<else>>Sydney thanks you before tasting, then asks how you made it. <<He>> listens closely enough to forget the last mouthful on <<his>> fork.<</if>>
          <<elseif _life_scene.action is 'tea'>>Sydney moves the cups away from the books. <<if _sydneyStatus.includes('corrupt')>>"There. Now I can give you all my attention." <<He>> grins, letting the book stay shut.<<else>>"Thank you. I needed a break." <<He>> puts the bookmark in and closes the book.<</if>>
          <<elseif _life_scene.action is 'film'>>Sydney checks the running time before sitting down. <<if _life_scene.item is 'erotic'>><<if _sydneyStatus.includes('corrupt')>>Sydney doesn't look away from the screen, leaning in close until <<his>> warm breath brushes your neck. "Did you pick this just to test me? They aren't doing it very well... I could show you better."<<else>>Sydney lets out a soft gasp, blushing deep crimson all the way to <<his>> ears. "Th-this is against all modesty!" <<He>> quickly shields <<his>> eyes with both hands, yet <<his>> fingers slowly part, peeking through with a dry swallow.<</if>><<elseif _sydneyStatus.includes('corrupt')>>"If I fall asleep, you can tell me the ending." <<He>> smiles, then spends the next scene pointing out what the characters have missed.<<else>>"Just this one." <<He>> follows the story closely, whispering a question when a familiar line comes up.<</if>>
          <<elseif _life_scene.action is 'wine'>>Sydney turns the glass by its stem. <<if _life_wine_recipe>>"Does the flavour change while it ferments?" <<He>> listens while you explain.<</if>> <<if _sydneyStatus.includes('corrupt')>>"Am I meant to say something about the bouquet?" <<He>> tries a solemn expression, but cannot keep it.<<else>>Sydney takes a small taste and sets the glass down again. "That's enough for me." <<He>> stays to talk, keeping <<his>> hands folded beside the glass.<</if>>
          <<elseif _life_scene.action is 'tidy'>>Sydney sorts the books while you clear the cups. "This one belongs in the library," <<he>> says, setting it apart for the morning. <<if _sydneyStatus.includes('corrupt')>>"I'll spare you the fine. This time." <<He>> smiles at you.<<else>><<He>> checks that the bookmark is still in place before stacking the others.<</if>>
          <<else>>Sydney recognises a phrase in the song and quietly follows the next line. <<if _sydneyStatus.includes('corrupt')>>"You heard that?" <<He>> laughs, and sings the next bit more clearly.<<else>><<He>> lowers <<his>> eyes when you notice, but keeps the rhythm with a fingertip.<</if>><</if>>
        <<option 'CN'>>
          <<if _life_scene.action is 'meal'>>悉尼将餐巾整齐放在盘子旁。<<if _life_scene.item is 'apple_crumble'>>“啊，你做了苹果酥！”<<He>>发现自己喊得太大声，随后便埋头吃起来。没过多久，<<he>>又得去拍掉袖上的碎屑。<<elseif setup.foodstuff[_life_scene.item].food?.tags?.includes('spicy')>>悉尼小心尝了一口，眼睛一下子湿了，伸手去拿饮品。“很好吃。只是没想到这么辣。”<<else>>悉尼先道谢，再尝了一口，问起你怎么做的。<<He>>听得太认真，忘了叉子上还留着最后一口。<</if>>
          <<elseif _life_scene.action is 'tea'>>悉尼把杯子移到远离书本的地方。<<if _sydneyStatus.includes('corrupt')>>“好了。现在可以好好看着你了。”<<He>>笑着说，没有重新打开书。<<else>>“谢谢。正好想歇一会儿。”<<He>>放好书签，合上了书。<</if>>
          <<elseif _life_scene.action is 'film'>>悉尼先看了时长，才坐下来。<<if _life_scene.item is 'erotic'>><<if _sydneyStatus.includes('corrupt')>>悉尼没有移开目光，反而凑近到你耳边，温热的气息拂过你的脖颈：“特意选这部来考验我吗？他们做得可不够好……我可以教你更好的。”<<else>>悉尼发出一声短促而羞赧的惊呼，整张脸红到了耳根。“这、这太不知羞耻了！”<<He>>慌忙用双手捂住眼睛，指缝却慢慢张开一条缝，喉咙轻轻吞咽着悄悄张望。<</if>><<elseif _sydneyStatus.includes('corrupt')>>“我要是睡着了，你得告诉我结局。”<<He>>笑着说，下一幕又指出了角色漏掉的线索。<<else>>“就这一部。”<<He>>认真看着故事，听到熟悉的台词时，小声向你问了一句。<</if>>
          <<elseif _life_scene.action is 'wine'>>悉尼捏着杯脚，轻轻转动酒杯。<<if _life_wine_recipe>>“发酵时，味道会慢慢变吗？”<<He>>听你解释其中的过程。<</if>><<if _sydneyStatus.includes('corrupt')>>“是不是该说说酒香？”<<He>>试着摆出一本正经的样子，却没能保持下去。<<else>>悉尼只尝了一小口，便放回杯子。“我这样就够了。”<<He>>留下来聊天，两手叠放在杯旁。<</if>>
          <<elseif _life_scene.action is 'tidy'>>你收杯子，悉尼整理书本。“这本得带回图书馆。”<<He>>把它放到一旁，留着明早拿。<<if _sydneyStatus.includes('corrupt')>>“这次就不罚你了。”<<He>>朝你笑了笑。<<else>><<He>>确认书签还在原处，才叠好其他书。<</if>>
          <<else>>悉尼认出歌里的一句，轻轻跟着哼了下一行。<<if _sydneyStatus.includes('corrupt')>>“你听见了？”<<He>>笑起来，将下一句唱得更清楚。<<else>>见你发现了，<<he>>便垂下目光，指尖却仍跟着节拍轻敲。<</if>><</if>>
      <</language>>
  <</switch>>
  <</if>>
<</widget>>

<!-- 复用本次活动的时间与回应记录，不延长人物在家日程。 -->
<<widget 'deadwood-home-life-followup-ready'>>
  <<set _home_estate to maplebirch.get('Finance').realEstate, _home_scene to _home_estate.life.scene>>
  <<set $_followup_duration to _args[0] ?? 10>>
  <<set _home_followup_ready to maplebirch.passage.title is 'Deadwood Reblooms Property Life Finish'
    and _home_scene?.action isnot 'wine' and _home_scene?.first and !_home_scene.followup
    and _home_estate.current?.id is _home_scene.property_id and _home_scene.partner
    and Number.isFinite(_home_scene.at) and Time.date.timeStamp gte _home_scene.at
    and ($_followup_duration is 0 or Time.date.timeStamp lte _home_scene.at + 3600)
    and isLoveInterest(_home_scene.partner) and _home_estate.life.bathing?.partner isnot _home_scene.partner
    and _home_estate.residentsHome(_home_scene.property_id).some(resident => resident.id === _home_scene.partner)
    and _home_estate.life.free(_home_scene.partner, $_followup_duration)
    and !$combat and !$replayScene and !$statFreeze and !$frozenValues and !$possessed and !$eventforced
    and !$nextPassage and !$nextPassageCheck and $stress lt $stressmax>>
<</widget>>

<<widget 'deadwood-home-life-followup-act'>>
  <<deadwood-home-life-followup-ready>>
  <<if !_home_followup_ready or _home_scene isnot _args[1] or !['talk', 'close'].includes(_args[0])>><<exit>><</if>>
  <<if _args[0] is 'talk' and $worn.face.type.includes('gag')>><<exit>><</if>>
  <<set $_followup_scene to _home_scene, $_followup_choice to _args[0], $_followup_origin to $passage, $_followup_location to $location>>
  <<pass 10>>
  <!-- 完成后不再预留十分钟，只确认这次交谈仍在原处、对方仍在。 -->
  <<deadwood-home-life-followup-ready 0>>
  <<if !_home_followup_ready or _home_scene isnot $_followup_scene or $passage isnot $_followup_origin or $location isnot $_followup_location
      or ($_followup_choice is 'talk' and $worn.face.type.includes('gag'))>><<exit>><</if>>
  <<set $_followup_scene.followup to $_followup_choice>>
  <<if $_followup_scene.partner>>
    <<npcincr $_followup_scene.partner love 1>>
    <<if $_followup_scene.partner is 'Robin'>>
      <<npcincr Robin trauma -1>>
    <</if>>
    <<if $_followup_scene.partner is 'Kylar'>>
      <<npcincr Kylar rage -1>>
    <</if>>
  <</if>>
  <<if $_followup_choice is 'talk'>>
    <<stress -2>><<psyche-rest 2 40>>
  <<else>>
    <<stress -1>><<tiredness -1>><<psyche-rest 0 80>>
  <</if>>
<</widget>>

<<widget 'deadwood-home-life-followup'>>
  <<deadwood-home-life-followup-ready>>
  <<if _home_scene.followup>>
    <<language>>
      <<option 'EN'>>
        <<if _home_scene.followup is 'talk'>>
          <<if $flashbacks gte 1 and $controlled is 0>>You try to explain how things that have already happened keep coming back when you do not want them to.
          <<elseif $anxiety gte 1 and $controlled is 0>>You talk about the small things you cannot stop worrying about, even after coming home.
          <<elseif $sleeptrouble is 1 and $controlled is 0 and !$hypnosis_traits.slumber>>You talk about lying awake when all you want is to sleep.
          <<elseif currentSkillValue('english') gte 500>>You find the words for something that has been bothering you.<<else>>You pause a few times, trying to explain the part that has stayed with you.<</if>>
          <<switch _home_scene.partner>>
            <<case 'Robin'>><<if C.npc.Robin.trauma gte 20>>Robin listens with both feet tucked beneath the chair. "I'm glad you told me." <<nnpc_He 'Robin'>> asks you to stay a little longer.<<elseif C.npc.Robin.dom gte 40>>"You could have told me sooner." Robin moves the cups aside and waits for you to finish.<<else>>Robin listens without interrupting. "Want to hear about mine?" <<nnpc_He 'Robin'>> smiles when you nod.<</if>>
            <<case 'Whitney'>>"What a fucking day." Whitney leans back, then looks at you when you stop talking. "Go on. I'm listening." <<nnpc_He 'Whitney'>> lets you finish before telling you about the walk home.
            <<case 'Kylar'>><<if C.npc.Kylar.rage gte 60>>Kylar wants to know who was there. You finish explaining what happened before answering. <<nnpc_He 'Kylar'>> listens, though <<nnpc_his 'Kylar'>> fingers keep turning against the edge of the seat.<<else>>Kylar remembers a detail you mentioned earlier and asks about it. "You can tell me these things." <<nnpc_He 'Kylar'>> sounds pleased that you did.<</if>>
            <<case 'Sydney'>>Sydney puts the book out of reach. "Which part is still bothering you?" <<nnpc_He 'Sydney'>> leaves you time to answer, then tells you about something that went wrong at the library.
          <</switch>>
        <<else>>
          <<if $flashbacks gte 1 and $controlled is 0>>You leave the story untold. The seat beneath you and the familiar voice beside you help you keep your attention on this room.
          <<elseif $anxiety gte 1 and $controlled is 0>>You still glance towards the door now and then, but leave the conversation for another time. There is someone sitting beside you.
          <<elseif $sleeptrouble is 1 and $controlled is 0 and !$hypnosis_traits.slumber>>You settle back without trying to make yourself sleep. Sitting together will do for now.
          <<else>>You stay where you are, leaving the conversation for another time.<</if>>
          <<switch _home_scene.partner>>
            <<case 'Robin'>>Robin draws the other chair nearer. <<if C.npc.Robin.trauma gte 20>><<nnpc_His 'Robin'>> eyes follow a sound in the hallway, then return to you.<<else>><<nnpc_He 'Robin'>> smiles when you glance over.<</if>> Neither of you gets up yet.
            <<case 'Whitney'>>"Tired?" Whitney moves <<nnpc_his 'Whitney'>> feet off the spare seat. "Sit, then." <<nnpc_He 'Whitney'>> leans back beside you, letting the conversation drop.
            <<case 'Kylar'>>Kylar watches you settle back. <<if C.npc.Kylar.rage gte 60>>"You're staying?" <<nnpc_He 'Kylar'>> waits for your nod before sitting still.<<else>><<nnpc_He 'Kylar'>> sits close enough for your sleeves to touch, smiling to <<nnpc_himself 'Kylar'>>.<</if>>
            <<case 'Sydney'>>Sydney leaves the bookmark in place. "We don't have to talk." <<nnpc_He 'Sydney'>> settles into the next chair, letting <<nnpc_his 'Sydney'>> shoulders drop.
          <</switch>>
        <</if>>
      <<option 'CN'>>
        <<if _home_scene.followup is 'talk'>>
          <<if $flashbacks gte 1 and $controlled is 0>>你试着说清，为什么那些已经过去的事，总会在你不愿想起时闯回脑海。
          <<elseif $anxiety gte 1 and $controlled is 0>>你说起那些放不下的小事。即使回到家，它们也还在脑海里打转。
          <<elseif $sleeptrouble is 1 and $controlled is 0 and !$hypnosis_traits.slumber>>你说起那些睡不着的时候。明明只想睡一觉，却只能睁着眼睛。
          <<elseif currentSkillValue('english') gte 500>>你总算想好该怎么说起那件烦心事。<<else>>你停顿了几次，试着说清心里一直惦记的那一段。<</if>>
          <<switch _home_scene.partner>>
            <<case 'Robin'>><<if C.npc.Robin.trauma gte 20>>罗宾将双脚收在椅子底下，听着你说。“谢谢你愿意告诉我。”<<nnpc_he 'Robin'>>问你能不能再待一会儿。<<elseif C.npc.Robin.dom gte 40>>“早些告诉我就好了。”罗宾把杯子挪开，等你说完。<<else>>罗宾没有打断你。“想听听我今天的事吗？”你点头时，<<nnpc_he 'Robin'>>便笑了。<</if>>
            <<case 'Whitney'>>“真他妈够呛。”惠特尼往后一靠，见你不说了，又望过来。“接着说。我听着呢。”等你说完，<<nnpc_he 'Whitney'>>才讲起回家路上的事。
            <<case 'Kylar'>><<if C.npc.Kylar.rage gte 60>>凯拉尔想知道当时还有谁。你先讲清事情的经过，再回答这个问题。<<nnpc_he 'Kylar'>>听着，手指仍不住地拧着椅子边缘。<<else>>凯拉尔记得你先前提过的细节，又追问了一句。“这些事，你可以告诉我。”你肯说给<<nnpc_him 'Kylar'>>听，似乎让<<nnpc_him 'Kylar'>>很高兴。<</if>>
            <<case 'Sydney'>>悉尼把书放到一旁。“哪一件事还让你放不下？”<<nnpc_he 'Sydney'>>等你慢慢说完，随后也提起今天在图书馆犯的一点小错。
          <</switch>>
        <<else>>
          <<if $flashbacks gte 1 and $controlled is 0>>你没有说起那些事。身下的椅子，身旁熟悉的声音，让你能将注意力留在这间屋里。
          <<elseif $anxiety gte 1 and $controlled is 0>>你仍不时望向门口，把想说的话留到稍后。至少，现在有人坐在你身旁。
          <<elseif $sleeptrouble is 1 and $controlled is 0 and !$hypnosis_traits.slumber>>你靠回椅背，没有勉强自己睡着。先一起坐着就好。
          <<else>>你没有起身，把想说的话留到稍后。<</if>>
          <<switch _home_scene.partner>>
            <<case 'Robin'>>罗宾将另一把椅子挪近了些。<<if C.npc.Robin.trauma gte 20>><<nnpc_his 'Robin'>>视线跟着走廊里的声响转了转，又回到你身上。<<else>>你望过去时，<<nnpc_he 'Robin'>>便朝你笑。<</if>>谁也没有急着离开。
            <<case 'Whitney'>>“累了？”惠特尼把脚从空座上挪开。“那就坐着。”<<nnpc_he 'Whitney'>>在你身旁靠回椅背，没有再催你说话。
            <<case 'Kylar'>>凯拉尔看着你靠回椅背。<<if C.npc.Kylar.rage gte 60>>“你不走了？”等你点头，<<nnpc_he 'Kylar'>>才坐稳。<<else>><<nnpc_he 'Kylar'>>挨着你坐下，衣袖贴在一起，嘴角带着笑。<</if>>
            <<case 'Sydney'>>悉尼没有抽出书签。“不说话也可以。”<<nnpc_he 'Sydney'>>在旁边的椅子里坐稳，放松了肩膀。
          <</switch>>
        <</if>>
    <</language>>
    <<if _home_scene.partner>>
      <br><br><<glove _home_scene.partner>>
      <<if _home_scene.partner is 'Robin'>><<lrtrauma>><</if>>
      <<if _home_scene.partner is 'Kylar'>><<lksuspicion>><</if>>
    <</if>><br><br>
  <<elseif _home_followup_ready>>
    <<capture _home_scene>>
      <<if !$worn.face.type.includes('gag')>>
        <<socialiseicon>><<lanLink ['Talk about your day (0:10)', '聊聊今天的事 (0:10)'] 'Deadwood Reblooms Property Life Finish'>><<deadwood-home-life-followup-act 'talk' _home_scene>><</lanLink>><<lstress>><br>
      <</if>>
      <<relaxicon>><<lanLink ['Sit quietly together (0:10)', '安静坐一会儿 (0:10)'] 'Deadwood Reblooms Property Life Finish'>><<deadwood-home-life-followup-act 'close' _home_scene>><</lanLink>><<lstress>><<ltiredness>><br>
    <</capture>>
    <br>
  <</if>>
<</widget>>

:: Deadwood Reblooms Property Life Finish
<<set _estate to maplebirch.get('Finance').realEstate>>
<<set _life_scene to _estate.life.scene>>
<<if !_estate.current or !_life_scene or _life_scene.property_id isnot _estate.current.id>>
  <<lanSwitch 'You had to stop before you could finish.' '还没来得及做完，你就不得不停了下来。'>><br><br>
  <<getouticon>><<lanLink `_estate.current ? ['Return to the sitting room', '返回起居室'] : ['Return to the agency', '返回房产中介']` `_estate.current ? 'Deadwood Reblooms Property Home' : 'Deadwood Reblooms Property Office'`>><</lanLink>><<exit>>
<</if>>
<<effects>>
<<if $nextPassage or $nextPassageCheck>>
  <span id='next'><<lanLink ['Continue', '继续'] 'Deadwood Reblooms Property Life Finish'>><</lanLink>></span><<nexttext>><<exit>>
<</if>>
<<set _life_wine_recipe to maplebirch.get('Orchard')?.winery.terms.recipes.find(recipe => recipe.id === _life_scene.item)>>
<<if _life_scene.action is 'wine' and _life_scene.followup>>
  <<deadwood-home-wine-aftermath>>
<<else>>
<<language>>
  <<option 'EN'>>
    <<switch _life_scene.action>>
      <<case 'meal'>>You set two portions of <<recipe_name _life_scene.item>> on the table. <<if Time.hour lt 11>>The meal gives you a little time together before the day's errands.<<elseif Time.hour gte 21>>You sit down for a late supper, keeping your voices low in the quiet house.<<else>>The kitchen smells of the food you prepared. For a while, the conversation follows the small things that happened today.<</if>><<if _life_scene.quality gte 2>> The cook has cleared the worktop and left you space at the table.<</if>>
      <<case 'tea'>>You bring two servings of <<recipe_name _life_scene.item>> to the table. You leave the washing-up until later and sit down together.
      <<case 'tidy'>>You gather the cups, clear the table and shake the folds from the blanket. <<if currentSkillValue('housekeeping') gte 500>>You work from one side of the room to the other, leaving nothing to move twice.<<else>>You have to clear a place before putting the next pile away.<</if>><<if _life_scene.quality gte 2>> The housekeeper takes the cleared cups through to the kitchen while you finish the last pile.<</if>> The room feels easier to move through when you finish.
      <<case 'music'>>You find something to listen to and settle into the seat. <<if ['rain', 'snow'].includes(Weather.precipitation)>>The weather taps against the windows beneath the tune.<<else>>The tune fills the pauses between the sounds of the house.<</if>> <span class='teal'>You have a little less on your mind.</span>
      <<case 'film'>>The lights dim and the film fills the screen. <<if _life_scene.item is 'comedy'>>A misplaced suitcase starts an argument which follows the characters from one room to the next. By the time the owner arrives, nobody will admit who opened it.<<elseif _life_scene.item is 'erotic'>>Two figures embrace in the warm, low light on screen, whispering softly as clothes are cast aside. The hushed sighs and murmurs echo gently off the padded walls, casting warm amber shadows across the darkened room. Your pulse picks up as the intimate scene unfolds until the tape ends with a fading glow.<<else>>A visitor arrives at a house which ought to be empty. You follow the clues until a familiar detail finally gives the ending away.<</if>> <<if $drunk gte 20>>The warmth of the wine lingers in your veins, softening the edges of the dark room and making every breath beside you feel intoxicatingly close.<</if>> <<if _estate.current.id is 'cliff'>>Beyond the curtains, the sea keeps moving.<<else>>The town remains beyond the soundproofed window.<</if>> You let the story carry you through to the credits.
      <<case 'wine'>>You open <<if _life_wine_recipe>><<print _life_wine_recipe.name[0]>><<else>><<recipe_name _life_scene.item>><</if>> and pour a little into the glass.
        <<if _life_scene.origin is 'Deadwood Reblooms Property Wine Cellar'>>The cellar is cool enough that the bottle feels cold against your fingers.
        <<elseif _life_scene.origin is 'Deadwood Reblooms Property Kitchen'>>You make room on the kitchen table and move the cups away from the edge.
        <<else>>The chairs are close enough that you do not have to raise your voice. <<if ['rain', 'snow'].includes(Weather.precipitation)>>The weather taps against the window.<<else>>The quiet sounds of the house carry through the room.<</if>><</if>>
        <<if _life_wine_recipe>>The fruit you used has changed since it went into the barrel. You taste it slowly, noticing the familiar flavour beneath the sharper one.
        <<elseif _life_scene.item is 'ghostbrew'>>Your tongue stays cold after you swallow. The grain of the table seems to flow beneath your glass. You blink, but it keeps moving.<</if>>
    <</switch>>
  <<option 'CN'>>
    <<switch _life_scene.action>>
      <<case 'meal'>>你在桌上摆了两份<<recipe_name _life_scene.item>>。<<if Time.hour lt 11>>这顿饭让你们在各自出门忙碌之前，还能一起坐会儿。<<elseif Time.hour gte 21>>夜已经深了，你们放低声音，安静吃着这顿夜宵。<<else>>厨房里仍留着烹调后的香气。你们边吃边聊，说起今天发生的小事。<</if>><<if _life_scene.quality gte 2>>厨师已经收好操作台，把餐桌旁的地方留给你们。<</if>>
      <<case 'tea'>>你把两份<<recipe_name _life_scene.item>>端到桌上，将洗餐具的事留到稍后，一起坐了下来。
      <<case 'tidy'>>你收起杯子，擦干桌子，抖开毯子上的折痕。<<if currentSkillValue('housekeeping') gte 500>>你从房间一边收拾到另一边，不用把同一叠东西搬两遍。<<else>>你得先清出一块地方，才能放好下一叠东西。<</if>><<if _life_scene.quality gte 2>>你整理最后一叠东西时，保洁员将收好的杯子端去了厨房。<</if>>收拾完后，走动也方便多了。
      <<case 'music'>>你选好音乐，在座位里坐稳。<<if ['rain', 'snow'].includes(Weather.precipitation)>>窗外的雨雪伴着旋律轻敲玻璃。<<else>>曲调填满了屋里声响之间的空隙。<</if>><span class='teal'>心里的杂念少了些。</span>
      <<case 'film'>>灯光暗下来，影片铺满屏幕。<<if _life_scene.item is 'comedy'>>一只放错地方的箱子，让片中人从这间房吵到那间房。等箱子的主人找过来，谁也不肯承认是自己打开的。<<elseif _life_scene.item is 'erotic'>>屏幕在柔和昏暗的暖光中亮起，两道身影在榻间低语拥缠，衣衫渐褪。细碎温存的呢喃在隔音软垫墙板间轻轻回荡，屏幕的微光在幽暗中投下朦胧的剪影。随着亲昵画面渐深，你的脉搏不由自主地加快，直到片尾微弱的光晕渐渐隐去。<<else>>访客走进一幢本该空着的房子。你跟着线索往下看，终于从熟悉的细节里猜中了结局。<</if>><<if $drunk gte 20>>先前的酒意在温暖幽暗的放映室中缓缓发散开来，微醺的晕眩让周遭的一切变得朦胧，身旁伴侣的每一次轻微触碰与呼吸都显得格外灼人。<</if>><<if _estate.current.id is 'cliff'>>窗帘之外，海水仍在流动。<<else>>小镇留在隔音窗外。<</if>>你一直看到片尾字幕。
      <<case 'wine'>>你打开<<if _life_wine_recipe>><<print _life_wine_recipe.name[1]>><<else>><<recipe_name _life_scene.item>><</if>>，在杯中倒了些。
        <<if _life_scene.origin is 'Deadwood Reblooms Property Wine Cellar'>>酒窖里很凉，指尖碰着瓶壁，也觉出一丝冷意。
        <<elseif _life_scene.origin is 'Deadwood Reblooms Property Kitchen'>>你在厨房桌上清出地方，把杯子挪到离桌沿远些的地方。
        <<else>>椅子靠得近，说话不用提高声音。<<if ['rain', 'snow'].includes(Weather.precipitation)>>窗外的雨雪轻敲玻璃。<<else>>屋里静静传来些细小的声响。<</if>><</if>>
        <<if _life_wine_recipe>>拿来酿酒的水果，进桶后已经变了味道。你慢慢品尝，略带酸涩的酒味底下，仍能尝出熟悉的果香。
        <<elseif _life_scene.item is 'ghostbrew'>>咽下酒后，凉意仍留在舌头上。杯底下的桌纹似乎缓缓流动。你眨了眨眼，它们却还在动。<</if>>
    <</switch>>
<</language>><<if _life_scene.action is 'wine' and _life_scene.item is 'ghostbrew'>><<ghallucinogens>><</if>><<if _life_scene.action is 'film' and _life_scene.item is 'erotic'>><<garousal>><</if>><br><br>
<<if _life_scene.partner>>
  <<deadwood-home-life-reaction>>
  <<if _life_scene.first and !_life_scene.followup>>
    <<glove _life_scene.partner>>
    <<if _life_scene.partner is 'Robin'>><<lrtrauma>><</if>>
    <<if _life_scene.partner is 'Kylar'>><<lksuspicion>><</if>>
  <</if>>
  <<if _life_scene.action is 'film' and _life_scene.item is 'erotic'>>
    <<glust _life_scene.partner>>
    <<if _life_scene.partner is 'Sydney' and !_sydneyStatus.includes('corrupt')>>
      <<lspurity>>
    <</if>>
  <</if>><br><br>
<</if>>
<</if>>
<<if _life_scene.partner and _life_scene.action isnot 'wine'>><<deadwood-home-life-followup>><</if>>
<<switch _life_scene.action>>
  <<case 'meal' 'tea'>>
    <<getouticon>><<lanLink ['Clear the table', '收好餐桌'] 'Deadwood Reblooms Property Kitchen'>><</lanLink>><br>
  <<case 'film'>>
    <<if _life_scene.partner and (_life_scene.item is 'erotic' or $drunk gte 20) and _estate.canIntimate(_life_scene.partner, _estate.current.id, 'cinema')>>
      <<if hasSexStat('promiscuity', 2)>>
        <<loveicon 'kiss'>>
        <<lanLink ['Pull them onto the sofa for intimacy', '把恋人拉到放映室沙发上亲热'] 'Deadwood Reblooms Property Intimacy'>>
          <<run _estate.requestIntimacy(_life_scene.partner, 'cinema')>>
          <<set $sexstart to 1>>
          <<set $Finance.real_estate.life.scene to null>>
        <</lanLink>><<promiscuous2>><<kissvirginitywarning>><<NPCvirginitywarning _life_scene.partner 'kiss'>><br>
      <</if>>
      <<if hasSexStat('promiscuity', 1) and _estate.canIntimate(_life_scene.partner, _estate.current.id, 'bedroom')>>
        <<bedicon>>
        <<lanLink ['Lead them back to the bedroom for intimacy', '把恋人带回卧室亲密'] 'Deadwood Reblooms Property Intimacy'>>
          <<run _estate.requestIntimacy(_life_scene.partner, 'bedroom')>>
          <<set $sexstart to 1>>
          <<set $Finance.real_estate.life.scene to null>>
        <</lanLink>><<promiscuous1>><<kissvirginitywarning>><<NPCvirginitywarning _life_scene.partner 'kiss'>><br>
      <</if>>
      <<if !hasSexStat('promiscuity', 1)>>
        <span class="blue"><<lanSwitch 'The lingering heat in the dark room makes your pulse race, but you lack the promiscuity to take things further.' '昏暗放映室里的燥热气氛让你心跳加速，但你的淫乱度不足以主动挑起亲密。'>></span><br>
      <<elseif !hasSexStat('promiscuity', 2)>>
        <span class="blue"><<lanSwitch 'You lack the promiscuity to initiate intimacy right here on the sofa.' '你的淫乱度不足以直接在放映室沙发上亲热。'>></span><br>
      <</if>>
    <</if>>
    <<getouticon>><<lanLink ['Turn the lights up', '开灯'] 'Deadwood Reblooms Property Screening Room'>><<set $Finance.real_estate.life.scene to null>><</lanLink>><br>
  <<case 'wine'>>
    <<deadwood-home-wine-followups>>
  <<default>>
    <<getouticon>><<lanLink ['Stand up', '起身'] _life_scene.origin>><<run _estate.setFloor(_life_scene.floor)>><</lanLink>><br>
<</switch>>

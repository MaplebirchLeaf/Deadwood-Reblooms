:: Deadwood Reblooms Property Bedroom []
<<set _property to maplebirch.get("Finance").realEstate.current>>
<<if !_property || !maplebirch.get("Finance").realEstate.owns(_property.id) || maplebirch.get("Finance").realEstate.managementFor(_property.id).rented>>
	<<lanLink ["Return to the agency", "返回房产中介"] 'Deadwood Reblooms Property Office'>><</lanLink>>
<<else>>
	<<run maplebirch.get("Finance").realEstate.enter()>><<home_effects>><<effects>>
	<<= lanSwitch(_property.interior.bedroom.EN, _property.interior.bedroom.CN)>><br><br>
	<<for _paperKind range ['wallpaper', 'poster']>>
		<<set _hanging to maplebirch.get("Finance").realEstate.furniture(_property.id, _paperKind)>>
		<<if _hanging>>
			<<furnitureicon _hanging.iconFile>>
			<<if _paperKind is 'poster'>>
			  <<lanSwitch 'A poster hangs on the wall:' '墙上挂着一张海报：'>>
			<<else>>
			  <<lanSwitch 'The walls are covered with wallpaper:' '墙上贴着壁纸：'>>
			<</if>>
			<<= _hanging.nameCap>><<lanSwitch '.' '。'>><br>
		<</if>>
	<</for>>
	<<if maplebirch.get("Finance").realEstate.managementFor(_property.id).paperhangings>>
	  <br>
	<</if>>
	<<set _bedroomCompanion to null>>
	<<if maplebirch.get("Finance").realEstate.residentsInBedroom(_property.id).length gt 0>>
		<<set _bedroomCompanion to maplebirch.get("Finance").realEstate.residentsInBedroom(_property.id)[0]>>
		<<npc _bedroomCompanion.id>><<person1>>
		<<switch _bedroomCompanion.id>>
			<<case 'Robin'>>
				<<language>>
					<<option 'EN'>>Robin has folded a spare blanket at the foot of the bed. <<He>> <span class='teal'>pats the space beside <<him>></span> when you come in.
					<<option 'CN'>>罗宾把备用毯子叠在床尾。见你进来，<<he>><span class='teal'>拍拍身旁的位置</span>。
				<</language>>
			<<case 'Whitney'>>
				<<language>>
					<<option 'EN'>>Whitney's bag lies where <<he>> dropped it. <<He>> has <span class='teal'>pulled the second pillow close to yours</span>.
					<<option 'CN'>>惠特尼的包还丢在原处。<<He>>倒是<span class='teal'>把第二只枕头挪到了你的枕边</span>。
				<</language>>
			<<case 'Kylar'>>
				<<language>>
					<<option 'EN'>>Kylar has stacked <<his>> things beside the wardrobe. <<He>> looks up from the bed when you enter.
					<<option 'CN'>>凯拉尔把东西叠在衣柜旁。你走进来时，<<he>>从床上抬起头。
				<</language>>
			<<case 'Sydney'>>
				<<language>>
					<<option 'EN'>>Sydney has hung <<his>> temple clothes apart from the rest, ready for the morning. <<He>> <span class='teal'>makes room for you on the bed</span>.
					<<option 'CN'>>悉尼把明早要穿的神殿衣服单独挂好，<span class='teal'>在床上给你让出位置</span>。
				<</language>>
		<</switch>><br><br>
	<</if>>
	<<set _bed to maplebirch.get("Finance").realEstate.furniture(_property.id, 'bed')>>
	<<if $earSlime.event and $earSlime.noSleep>>
		<span class='red'><<lanSwitch 'The slime will not let you sleep yet.' '史莱姆现在不让你睡觉。'>></span><br>
	<<elseif _bed>>
		<<if maplebirch.get("Finance").realEstate.canShareBed(_property.id)>>
			<<lanSwitch 'The bed is made up for two. There is room to turn over without disturbing the other side.' '双人床铺好了被褥。即使翻身，也不会碰到另一侧的人。'>>
		<<else>>
			<<lanSwitch 'You smooth the sheets across the narrow mattress. There is room for only one person.' '你抚平窄床垫上的被褥。这里仅够一个人睡下。'>>
		<</if>><br>
		<<furnitureicon _bed.iconFile>>
		<<lanLink ["Undress and get into bed", "脱衣上床"] 'Deadwood Reblooms Property Bed'>>
			<<undressSleep 'Deadwood Property Bed'>>
		<</lanLink>><br>
	<</if>>
	<<if !($earSlime.event and $earSlime.noSleep)>>
	  <<deadwood-reblooms-property-sleep-outfits>>
	<</if>>
	<<if _bedroomCompanion && maplebirch.get("Finance").realEstate.canIntimate(_bedroomCompanion.id, _property.id)>>
		<<loveicon 'kiss'>>
		<<lanLink ['Invite your lover into bed for intimacy', '邀恋人上床亲密'] 'Deadwood Reblooms Property Intimacy'>>
			<<run maplebirch.get("Finance").realEstate.meetResident(_bedroomCompanion.id, _property.id)>>
			<<set $sexstart to 1>>
		<</lanLink>><<promiscuous1>><<kissvirginitywarning>><<NPCvirginitywarning _bedroomCompanion.id 'kiss'>><br>
	<</if>>
	<br>
	<<set _wardrobe to maplebirch.get("Finance").realEstate.furniture(_property.id, 'wardrobe')>>
	<<if _wardrobe>>
		<<if _wardrobe.type.includes('organiser')>>
			<<lanSwitch 'The wardrobe has drawers for smaller things and a rail for your clothes.' '衣柜里有收纳小物的抽屉，也有挂衣服的横杆。'>>
		<<elseif _wardrobe.type.includes('spacious')>>
			<<lanSwitch 'Your clothes have room to hang without being pressed together.' '衣服能宽松地挂在衣柜里，不必挤作一团。'>>
		<<else>>
			<<lanSwitch 'The narrow wardrobe creaks when you open it. Your clothes just fit inside.' '打开狭窄的衣柜时，柜门吱呀作响。里面勉强放得下你的衣服。'>>
		<</if>><br>
		<<furnitureicon _wardrobe.iconFile>><<lanLink ["Wardrobe", "衣柜"] 'Deadwood Reblooms Property Wardrobe'>><</lanLink>><br>
	<</if>>
	<<deadwood-blackjack-home-entry 'Deadwood Reblooms Property Bedroom'>>
	<<set _roomFurnishings to ['table', 'chair', 'desk', 'decoration', 'windowsill']>>
	<<for _kind range _roomFurnishings>>
		<<set _furnishing to maplebirch.get("Finance").realEstate.furniture(_property.id, _kind)>>
		<<if _furnishing and (_kind isnot 'desk' or _property.rooms.desk)>>
			<<furnitureicon _furnishing.iconFile>><<= _furnishing.nameCap>><br>
		<</if>>
	<</for>>
	<<mirroricon 'home'>><<lanLink ["Mirror", "镜子"] 'Deadwood Reblooms Property Mirror'>><<preMirror>><</lanLink>><br>
	<<roomoptions>>
	<<if playerHasSexToys()>>
		<<sextoysicon>><<lanLink ["Sex toys", "性玩具"] 'Sextoys Inventory'>><<set $sextoyInvReturnLink to 'Deadwood Reblooms Property Bedroom'>><</lanLink>><br>
	<</if>>
	<<if _property.rooms.desk is _property.rooms.bedroom>>
		<<deskchairicon>><<lanLink ["Writing desk", "书桌"] 'Deadwood Reblooms Property Desk'>><</lanLink>><br>
	<</if>>
	<br>
	<<if _property.rooms.bedroom is 1>>
		<<getouticon>><<lanLink ["Sitting room (0:01)", "起居室 (0:01)"] 'Deadwood Reblooms Property Home'>><<pass 1>><</lanLink>>
	<<else>>
		<<getouticon>><<lanLink ["Return to the landing (0:01)", "返回楼梯间 (0:01)"] 'Deadwood Reblooms Property Landing'>><<pass 1>><</lanLink>>
	<</if>>
	<br><br>
	<<lanLink ['Gameplay Settings', '游戏设置'] 'Settings'>><<set $settingsExitPassage to 'Deadwood Reblooms Property Bedroom'>><</lanLink>><br>
	<<attitudesControlCheck>>
	<<if $attitudesControl.showGoldLink is true>>
		<span class='goldLink'><<lanLink ["Attitudes", "态度"] 'Attitudes'>><<set $attitudesExitPassage to 'Deadwood Reblooms Property Bedroom'>><</lanLink>></span> <span class='red'>!!</span><br>
	<<else>>
		<<lanLink ["Attitudes", "态度"] 'Attitudes'>><<set $attitudesExitPassage to 'Deadwood Reblooms Property Bedroom'>><</lanLink>><br>
	<</if>>
<</if>>

:: Deadwood Reblooms Property Desk []
<<set _property to maplebirch.get("Finance").realEstate.current>>
<<if !_property || !maplebirch.get("Finance").realEstate.owns(_property.id) || maplebirch.get("Finance").realEstate.managementFor(_property.id).rented>>
	<<lanLink ["Return to the agency", "返回房产中介"] 'Deadwood Reblooms Property Office'>><</lanLink>>
<<else>>
	<<run maplebirch.get("Finance").realEstate.enter()>><<effects>>
	<<set _deskFurniture to maplebirch.get("Finance").realEstate.furniture(_property.id, 'desk')>>
	<<set _deskChair to maplebirch.get("Finance").realEstate.furniture(_property.id, 'chair')>>
	<<language>>
		<<option 'EN'>>You sit at the desk. There is enough room to spread out a book beneath the lamp.
		<<option 'CN'>>你在书桌前坐下。灯下有足够的地方摊开一本书。
	<</language>><br><br>
	<<if _deskFurniture>>
	  <<furnitureicon _deskFurniture.iconFile>><<= _deskFurniture.nameCap>><br>
	<</if>>
	<<if _deskChair>>
	  <<furnitureicon _deskChair.iconFile>><<= _deskChair.nameCap>><br>
	<</if>>
	<br>
	<<if $studyBooks is undefined>>
	  <<set $studyBooks to {rented: 'none', stolen: 'none'}>>
	<</if>>
	<<homeStudyOptions>>
	<<if maplebirch.get('LifeSimulation') and $LifeSimulation.school.role isnot 'student' and $LifeSimulation.school.study_session_day isnot Time.days>>
		<br><<schoolicon 'library'>><<lanLink ['Prepare student council study notes at home (0:30)', '在家整理学生会的学习资料 (0:30)'] 'Deadwood Reblooms Property School Study'>><<set $phase to 'solo'>><<pass 30>><</lanLink>><br>
		<<if maplebirch.get("Finance").realEstate.residentsHome(_property.id).length gt 0>>
			<<socialiseicon>><<lanLink ['Prepare an after-school session with your resident lover (0:30)', '请同住的恋人一起准备课后学习 (0:30)'] 'Deadwood Reblooms Property School Study'>><<set $phase to 'together'>><<pass 30>><</lanLink>><br>
		<</if>>
	<</if>>
	<br>
	<<if _property.rooms.desk is _property.rooms.bedroom>>
		<<lanLink ["Stand up", "起身"] 'Deadwood Reblooms Property Bedroom'>><</lanLink>>
	<<elseif _property.rooms.desk is 1>>
		<<lanLink ["Stand up", "起身"] 'Deadwood Reblooms Property Home'>><</lanLink>>
	<<else>>
		<<lanLink ["Stand up", "起身"] 'Deadwood Reblooms Property Landing'>><</lanLink>>
	<</if>>
<</if>>

:: Deadwood Reblooms Property School Study []
<<set _property to maplebirch.get("Finance").realEstate.current>>
<<if !_property or !maplebirch.get("Finance").realEstate.owns(_property.id) or maplebirch.get("Finance").realEstate.managementFor(_property.id).rented or !maplebirch.get('LifeSimulation')>>
	<span class='blue'><i><<lanSwitch 'The desk is unavailable.' '书桌暂时不能用。'>></i></span><br><br>
<<else>>
	<<run maplebirch.get("Finance").realEstate.enter()>><<effects>>
	<<set _resident to maplebirch.get("Finance").realEstate.residentsHome(_property.id)[0]>>
	<<set _prepared to currentSkillValue('maths') gte 500 or ($phase is 'together' and _resident)>>
	<<if maplebirch.get("LifeSimulation").school.organiseStudySession(_prepared)>>
		<<language>>
			<<option 'EN'>>You spread lesson notes and the student council's plan across the desk. The lamp leaves enough room to sort each subject into a separate pile.
			<<option 'CN'>>你把课堂笔记与学生会的计划摊在书桌上。灯下的地方够大，每门课都能分成单独一叠。
		<</language>><br><br>
		<<if $phase is 'together' and _resident>>
			<<npc _resident.id>><<person1>>
			<<switch _resident.id>>
				<<case 'Robin'>><<lanSwitch 'Robin checks the sums against the shop ledger and spots the page you had skipped.' '罗宾拿店里的账本对照算式，找出你漏掉的一页。'>>
				<<case 'Whitney'>><<lanSwitch 'Whitney calls the plan dull, then draws a bold heading that the other students will actually notice.' '惠特尼嫌计划写得太闷，却替你画了个其他学生一定会注意的标题。'>>
				<<case 'Kylar'>><<lanSwitch 'Kylar reads each instruction twice and marks where a nervous student might need more time.' '凯拉尔把每条说明读了两遍，标出容易让紧张的学生跟不上的地方。'>>
				<<case 'Sydney'>><<lanSwitch 'Sydney compares the notes with the temple library copy and quietly corrects a citation.' '悉尼拿神殿图书馆的抄本对照笔记，悄悄改好一处引文。'>>
			<</switch>>
			<<npcincr _resident.id love 1>><<glove>><br>
		<<elseif currentSkillValue('maths') gte 500>>
			<<lanSwitch 'You catch a mistake in the figures before copying the plan for the other students.' '你在誊写给其他学生之前，发现一处算错的数字。'>><br>
		<<else>>
			<<lanSwitch 'The outline is usable, though you leave the difficult examples for a teacher to check.' '大纲已经能用，难题部分还要请老师核对。'>><br>
		<</if>>
		<<deadwood-reblooms-life-simulation-school-feedback>>
	<</if>>
<</if>>
<br><<deskchairicon>><<lanLink ['Return to the desk', '返回书桌'] 'Deadwood Reblooms Property Desk'>><</lanLink>>

:: Deadwood Reblooms Property Mirror []
<<set _property to maplebirch.get("Finance").realEstate.current>>
<<if !_property || !maplebirch.get("Finance").realEstate.owns(_property.id) || maplebirch.get("Finance").realEstate.managementFor(_property.id).rented>>
	<<lanLink ["Return to the agency", "返回房产中介"] 'Deadwood Reblooms Property Office'>><</lanLink>>
<<else>>
	<<run maplebirch.get("Finance").realEstate.enter()>><<effects>>
	<!-- 发现记录和通道来源都在当前存档的 $VanillaPlus 中。此处不借用孤儿院镜子的 home 标记。 -->
	<<if maplebirch.get("VanillaPlus")>>
		<<run maplebirch.get("VanillaPlus").deviancy.discover('property', _property.id)>>
	<</if>>
	<<getouticon>><<lanLink ["Step away", "走开"] 'Deadwood Reblooms Property Bedroom'>><<unset $mirrorMenu>><<unset $bodywritingSet>><<postMirror>><</lanLink>><br>
	<<if maplebirch.get("VanillaPlus")>>
		<<deadwood-reblooms-deviancy-mirror-enter-link 'property'>>
	<</if>>
	<<mirror>><br><br>
<</if>>

:: Deadwood Reblooms Property Bathroom []
<<set _property to maplebirch.get("Finance").realEstate.current>>
<<if !_property || !maplebirch.get("Finance").realEstate.owns(_property.id) || maplebirch.get("Finance").realEstate.managementFor(_property.id).rented>>
	<<lanLink ["Return to the agency", "返回房产中介"] 'Deadwood Reblooms Property Office'>><</lanLink>>
<<else>>
	<<run maplebirch.get("Finance").realEstate.enter()>><<effects>>
	<<= lanSwitch(_property.interior.bathroom.EN, _property.interior.bathroom.CN)>><br><br>
	<<if pcAreArmsBound('both')>>
		<<bathroomicon 'bath'>><<lanLink ["Have a bath (0:30)", "泡澡 (0:30)"] 'Deadwood Reblooms Property Bath'>><<water>><<pass 30>><<stress -6>><<set $hygiene to 0>><</lanLink>><<lstress>>
	<<else>>
		<<bathroomicon 'bath'>><<lanLink ["Have a bath (0:30)", "泡澡 (0:30)"] 'Deadwood Reblooms Property Bath'>><<strip>><<pass 30>><<stress -6>><<set $hygiene to 0>><</lanLink>><<lstress>>
	<</if>><br>
	<<personalUpkeep>>
	<<pregnancyTest 'Deadwood Reblooms Property Bathroom'>>
	<br>
	<<if _property.rooms.bathroom is 1>>
		<<getouticon>><<lanLink ["Sitting room (0:01)", "起居室 (0:01)"] 'Deadwood Reblooms Property Home'>><<pass 1>><</lanLink>>
	<<else>>
		<<getouticon>><<lanLink ["Return to the landing (0:01)", "返回楼梯间 (0:01)"] 'Deadwood Reblooms Property Landing'>><<pass 1>><</lanLink>>
	<</if>>
<</if>>

:: Deadwood Reblooms Property Bath []
<<set _property to maplebirch.get("Finance").realEstate.current>>
<<if !_property || !maplebirch.get("Finance").realEstate.owns(_property.id) || maplebirch.get("Finance").realEstate.managementFor(_property.id).rented>>
	<<lanLink ["Return to the agency", "返回房产中介"] 'Deadwood Reblooms Property Office'>><</lanLink>>
<<else>>
	<<run maplebirch.get("Finance").realEstate.enter()>><<effects>><<wash>>
	<<language>>
		<<option 'EN'>>You wash in the privacy of your own bathroom. Warm water runs down the drain, <span class='teal'>taking the grime of the day with it</span>.
		<<option 'CN'>>你在自己的浴室里洗了个澡。温水流进下水道，<span class='teal'>也带走了身上的污垢</span>。
	<</language>><br><br>
	<<getouticon>><<lanLink ['Get out of the bath', '离开浴缸'] 'Deadwood Reblooms Property Bath Finish'>><</lanLink>>
<</if>>

:: Deadwood Reblooms Property Bath Finish []
<<set _property to maplebirch.get("Finance").realEstate.current>>
<<if !_property || !maplebirch.get("Finance").realEstate.owns(_property.id) || maplebirch.get("Finance").realEstate.managementFor(_property.id).rented>>
	<<lanLink ["Return to the agency", "返回房产中介"] 'Deadwood Reblooms Property Office'>><</lanLink>>
<<else>>
	<<run maplebirch.get("Finance").realEstate.enter()>><<effects>>
	<<run maplebirch.get("Finance").realEstate.openWardrobe()>>
	<<language>>
		<<option 'EN'>>Your skin is still damp.
		<<option 'CN'>>你的皮肤仍有些湿润。
	<</language>><br><br>
	<<if pcAreArmsBound('both')>>
		<<getouticon>><<lanLink ['Return to the bathroom', '返回浴室'] 'Deadwood Reblooms Property Bathroom'>><</lanLink>>
	<<else>>
		<<dressasyouwereicon>><<lanLink ['Dress as you were', '穿回原来的衣服'] 'Deadwood Reblooms Property Bathroom'>><<clotheson>><</lanLink>><br>
		<<towelicon>><<lanLink ['Wrap yourself in a towel', '裹上浴巾'] 'Deadwood Reblooms Property Bathroom'>>
			<<if $player.gender == 'f' or $player.breastsize > 0>>
				<<set $wear_upper = 'large_towel'>>
			<<else>>
				<<set $wear_lower = 'towel'>>
			<</if>>
			<<returnCarried>><<set $wardrobeOption to 'wear'>><<wardrobewear>>
			<<for _bathSlot range ['upper', 'lower']>>
				<<if ['towel top', 'towel skirt', 'large towel', 'large towel bottom'].includes($worn[_bathSlot].name)>>
				  <<set $worn[_bathSlot].lastTaken to $wardrobe_location>>
				<</if>>
			<</for>>
		<</lanLink>>
		<<if selectWardrobe().upper.some(item => item.name === 'bathrobe') or $carried.upper.name is 'bathrobe'>>
			<br><<bathroomicon 'robe'>><<lanLink ['Put on a bathrobe', '穿上浴袍'] 'Deadwood Reblooms Property Bathroom'>>
				<<if $carried.upper.name is 'bathrobe'>>
				  <<set $carried.upper.lastTaken to $wardrobe_location>>
				<</if>>
				<<returnCarried>><<set $wardrobeOption to 'wear'>>
				<<set $wear_upper to selectWardrobe().upper.findIndex(item => item.name === 'bathrobe')>><<wardrobewear>>
			<</lanLink>>
		<</if>>
	<</if>>
<</if>>

:: Deadwood Reblooms Property Kitchen []
<<set _property to maplebirch.get("Finance").realEstate.current>>
<<if !_property || !maplebirch.get("Finance").realEstate.owns(_property.id) || maplebirch.get("Finance").realEstate.managementFor(_property.id).rented>>
	<<lanLink ["Return to the agency", "返回房产中介"] 'Deadwood Reblooms Property Office'>><</lanLink>>
<<else>>
	<<run maplebirch.get("Finance").realEstate.enter()>><<effects>>
	<<= lanSwitch(_property.interior.kitchen.EN, _property.interior.kitchen.CN)>><br><br>
	<<for _resident range maplebirch.get("Finance").realEstate.residentsInCommonRooms(_property.id)>>
		<<switch _resident.id>>
			<<case 'Robin'>>
				<<language>>
					<<option 'EN'>>
						Robin has put two plates on the table and <span class='teal'>left the second chair out for you</span>.
					<<option 'CN'>>
						罗宾在桌上摆了两只盘子，还<span class='teal'>给你留出了另一张椅子</span>。
				<</language>>
			<<case 'Whitney'>>
				<<language>>
					<<option 'EN'>>Whitney is looking through the cupboard. "What are you making?" <<He>> asks without turning around.
					<<option 'CN'>>惠特尼正在翻橱柜。“你要做什么？”<<He>>头也不回地问。
				<</language>>
			<<case 'Kylar'>>
				<<language>>
					<<option 'EN'>>Kylar stays close to the worktop, watching your hands. <<He>> offers to wash anything you use.
					<<option 'CN'>>凯拉尔靠在操作台旁，看着你的动作。<<He>>说，你用过的任何东西都可以交给<<him>>洗。
				<</language>>
			<<case 'Sydney'>>
				<<language>>
					<<option 'EN'>>Sydney sets a clean cup beside yours, then <span class='teal'>rolls up <<his>> sleeves to help</span>.
					<<option 'CN'>>悉尼把一只干净的杯子放在你的杯子旁，随后<span class='teal'>卷起袖子准备帮忙</span>。
				<</language>>
		<</switch>><br><br>
	<</for>>
	<<if Time.dayState is 'night'>>
		<<lanSwitch 'The kitchen light falls across the worktop.' '厨房的灯光落在操作台上。'>><br><br>
	<<elseif Time.hour lt 11>>
		<<lanSwitch 'There is room to prepare breakfast.' '这里有地方准备早餐。'>><br><br>
	<<else>>
		<<lanSwitch 'The worktop is ready for whatever you have brought home.' '操作台空着，等你处理带回家的食材。'>><br><br>
	<</if>>
	<!-- 与原版厨房共用食材、菜谱和烹饪时间。房产不免费提供食材。 -->
	<<ingredientsSupplied>><<allowLewdIngredients>><<kitchenDisplay>>
	<<if _property.rooms.kitchen is 1>>
		<<getouticon>><<lanLink ["Sitting room (0:01)", "起居室 (0:01)"] 'Deadwood Reblooms Property Home'>><<kitchenExit>><<pass 1>><</lanLink>>
	<<else>>
		<<getouticon>><<lanLink ["Return to the landing (0:01)", "返回楼梯间 (0:01)"] 'Deadwood Reblooms Property Landing'>><<kitchenExit>><<pass 1>><</lanLink>>
	<</if>>
<</if>>

:: Deadwood Reblooms Property Outdoor []
<<set _property to maplebirch.get("Finance").realEstate.current>>
<<if !_property || !maplebirch.get("Finance").realEstate.owns(_property.id) || maplebirch.get("Finance").realEstate.managementFor(_property.id).rented>>
	<<lanLink ["Return to the agency", "返回房产中介"] 'Deadwood Reblooms Property Office'>><</lanLink>>
<<else>>
	<<run maplebirch.get("Finance").realEstate.enter()>><<set $outside to 1>><<effects>>
	<<if _property.outdoor_access is 'retreat'>>
		<<= lanSwitch(_property.interior.retreat.EN, _property.interior.retreat.CN)>><br><br>
	<</if>>
	<<= lanSwitch(_property.interior.outdoor.EN, _property.interior.outdoor.CN)>><br><br>
	<<for _resident range maplebirch.get("Finance").realEstate.residentsInCommonRooms(_property.id)>>
		<<switch _resident.id>>
			<<case 'Robin'>>
				<<language>>
					<<option 'EN'>>
						Robin comes outside with you and stays close. <span class='teal'>For once, neither of you has to hurry back to the orphanage.</span>
					<<option 'CN'>>
						罗宾跟着你出来，站在你身旁。<span class='teal'>这一回，你们都不用急着赶回孤儿院。</span>
				<</language>>
			<<case 'Whitney'>>
				<<language>>
					<<option 'EN'>>Whitney leans beside you. <<He>> watches the view while pretending not to watch you.
					<<option 'CN'>>惠特尼靠在你身旁。<<He>>望着外面，装作没有留意你。
				<</language>>
			<<case 'Kylar'>>
				<<language>>
					<<option 'EN'>>
						Kylar steps outside after you and <span class='teal'>takes hold of your sleeve</span>.
					<<option 'CN'>>
						凯拉尔跟着你出来，<span class='teal'>轻轻攥住你的衣袖</span>。
				<</language>>
			<<case 'Sydney'>>
				<<language>>
					<<option 'EN'>>Sydney comes out for a breath of air. <span class='teal'><<His>> hand finds yours</span>.
					<<option 'CN'>>悉尼出来透了口气，随后<span class='teal'>握住你的手</span>。
				<</language>>
		<</switch>><br><br>
	<</for>>
	<<if Weather.precipitation is 'rain'>>
		<<if _property.id is 'domus' or _property.id is 'danube'>>
			<<lanSwitch 'Rain darkens the garden path.' '雨水浸湿了花园的小径。'>><br><br>
		<<else>>
			<<lanSwitch 'Rain patters against the railing and dampens the ground.' '雨滴敲在栏杆上，打湿了地面。'>><br><br>
		<</if>>
	<<elseif Weather.isSnow>>
		<<if _property.id is 'domus' or _property.id is 'danube'>>
			<<lanSwitch 'Snow settles along the garden path.' '花园小径上落了一层雪。'>><br><br>
		<<else>>
			<<lanSwitch 'Snow settles on the rail and the path below.' '雪落在栏杆和下方的小径上。'>><br><br>
		<</if>>
	<<elseif Time.dayState is 'night'>>
		<<lanSwitch 'The lights beyond your home stand out against the dark.' '夜色里，屋外的灯光格外显眼。'>><br><br>
	<<else>>
		<<lanSwitch 'The air is clear enough to linger outside.' '空气清朗，适合在外面待一会儿。'>><br><br>
	<</if>>
	<<if _property.id is 'domus'>>
		<!-- 原版所有苗圃都存于 $plots，时间事件会让这里的单块小苗圃正常生长。 -->
		<<if !$plots.domus>>
		  <<plots_init domus 1 earth 1 small>>
		<</if>>
		<<plot_effects>>
		<<display_plot domus>>
	<<elseif _property.id is 'high'>>
		<!-- 店铺上方的浅木箱只容得下一块小苗圃，不与小屋或宅邸共用作物。 -->
		<<if !$plots.high>>
		  <<plots_init high 1 earth 2 small>>
		<</if>>
		<<plot_effects>>
		<<display_plot high>>
	<<elseif _property.id is 'danube'>>
		<<gardenicon>><<lanLink ["Go into the garden (0:01)", "走进花园 (0:01)"] 'Deadwood Reblooms Property Garden'>><<pass 1>><</lanLink>><br><br>
	<</if>>
	<<if _property.outdoor_access is 'retreat'>>
		<<couchicon>><<lanLink ["Rest a while (0:15)", "休息片刻 (0:15)"] 'Deadwood Reblooms Property Retreat Rest'>><<pass 15>><<stress -2>><<tiredness -4>><</lanLink>><<lstress>><<ltiredness>><br>
	<</if>>
	<<deadwood-reblooms-property-outdoor-icon _property.id>>
	<<lanLink ['Look outside (0:10)', '看看外面 (0:10)'] 'Deadwood Reblooms Property Outdoor View'>><<pass 10>><</lanLink>><br><br>
	<<if _property.outdoor_access is 'sitting'>>
		<<getouticon>><<lanLink ["Sitting room (0:01)", "起居室 (0:01)"] 'Deadwood Reblooms Property Home'>><<pass 1>><</lanLink>>
	<<else>>
		<<getouticon>><<lanLink ["Return to the landing (0:01)", "返回楼梯间 (0:01)"] 'Deadwood Reblooms Property Landing'>><<pass 1>><</lanLink>>
	<</if>>
<</if>>

:: Deadwood Reblooms Property Garden []
<<set _property to maplebirch.get("Finance").realEstate.current>>
<<if !_property || _property.id isnot 'danube' || !maplebirch.get("Finance").realEstate.owns('danube') || maplebirch.get("Finance").realEstate.managementFor('danube').rented>>
	<<lanLink ["Return to the agency", "返回房产中介"] 'Deadwood Reblooms Property Office'>><</lanLink>>
<<else>>
	<<run maplebirch.get("Finance").realEstate.enter()>><<set $outside to 1>><<effects>>
	<<lanSwitch
		'The terrace lies behind you. Three planting beds run along the garden path, sheltered from the street by the high wall.'
		'花园露台在你身后。三块苗圃沿着小径排开，高墙挡住了街上的视线。'
	>><br><br>
	<!-- 与小屋使用不同的原版种植地点，跨日成长和收获互不覆盖。 -->
	<<if !$plots.danube>>
	  <<plots_init danube 3 earth 3 medium>>
	<</if>>
	<<plot_effects>>
	<<display_plot danube>>
	<<getouticon>><<lanLink ['Return to the garden terrace (0:01)', '返回花园露台 (0:01)'] 'Deadwood Reblooms Property Outdoor'>><<pass 1>><</lanLink>>
<</if>>

:: Deadwood Reblooms Property Balcony []
<<set _property to maplebirch.get("Finance").realEstate.current>>
<<if !_property || _property.id isnot 'danube' || !maplebirch.get("Finance").realEstate.owns('danube') || maplebirch.get("Finance").realEstate.managementFor('danube').rented>>
	<<lanLink ["Return to the agency", "返回房产中介"] 'Deadwood Reblooms Property Office'>><</lanLink>>
<<else>>
	<<run maplebirch.get("Finance").realEstate.enter()>><<set $outside to 1>><<effects>>
	<<= lanSwitch(_property.interior.balcony.EN, _property.interior.balcony.CN)>><br><br>
	<<if Weather.precipitation is 'rain'>>
		<<lanSwitch 'Rain runs along the stone rail.' '雨水沿着石栏杆流下。'>><br><br>
	<<elseif Weather.isSnow>>
		<<lanSwitch 'Snow gathers on the rail and the garden below.' '栏杆和下方花园都覆着雪。'>><br><br>
	<<elseif Time.dayState is 'night'>>
		<<lanSwitch 'The garden paths are pale in the moonlight.' '花园的小径在月色里泛着微光。'>><br><br>
	<</if>>
	<<gardenicon>><<lanLink ['Look down on the garden (0:10)', '俯瞰花园 (0:10)'] 'Deadwood Reblooms Property Balcony View'>><<pass 10>><</lanLink>><br>
	<<if Weather.precipitation isnot 'rain' && !Weather.isSnow>>
		<<couchicon>><<lanLink ['Sit on the balcony (0:15)', '在阳台坐一会儿 (0:15)'] 'Deadwood Reblooms Property Balcony Rest'>><<pass 15>><<stress -2>><</lanLink>><<lstress>><br>
	<</if>>
	<!-- 原版翅膀特质本身就允许从高处下降。鸟翼即使被拔羽仍能滑翔。 -->
	<<if $harpy gte 6>>
		<<glideicon>><<lanLink ["Glide into the garden (0:02)", "滑翔到花园 (0:02)"] 'Deadwood Reblooms Property Balcony Glide'>><<bird_pass 2>><<endevent>><</lanLink>><br>
	<<elseif $angel gte 6 or $demon gte 6 or $fallenangel gte 2>>
		<<if $pain gte 21>>
			<span class='purple'><<lanSwitch 'Your wings could carry you down, but you are too injured to jump.' '翅膀本可以带你滑下去，但你伤得太重，不能冒险跃出阳台。'>></span><br>
		<<elseif $birdFly is 1 or $birdGlide is 1>>
			<<glideicon>><<lanLink ["Glide into the garden (0:02)", "滑翔到花园 (0:02)"] 'Deadwood Reblooms Property Balcony Glide'>><<bird_pass 2>><<endevent>><</lanLink>><br>
		<<elseif currentSkillValue('willpower') lt 250>>
			<span class='red'><<lanSwitch 'You cannot bring yourself to jump from the balcony.' '你鼓不起勇气从阳台跃下。'>></span><br>
		<<elseif $Finance.real_estate.glide_scared_day is Time.days>>
			<span class='red'><<lanSwitch 'You are still too frightened to try again today.' '今天你仍不敢再试一次。'>></span><br>
		<<else>>
			<<glideicon>>
			<<lanLink ['Attempt to glide into the garden (0:02)', '尝试滑翔到花园 (0:02)'] 'Deadwood Reblooms Property Balcony Glide Attempt'>>
				<<bird_pass 2>><<endevent>>
			<</lanLink>><<willpowerdifficulty 250 1100>><br>
		<</if>>
	<</if>>
	<<if $harpy gte 6 or (($angel gte 6 or $demon gte 6 or $fallenangel gte 2) and $pain lt 21 and ($birdFly is 1 or $birdGlide is 1))>>
		<<glideicon>><<lanLink '滑翔到小镇其他街道' 'Deadwood Reblooms Property Flight'>><</lanLink>><br>
	<</if>>
	<br>
	<<getouticon>><<lanLink ["Return to the landing (0:01)", "返回楼梯间 (0:01)"] 'Deadwood Reblooms Property Landing'>><<pass 1>><</lanLink>>
<</if>>

:: Deadwood Reblooms Property Balcony View []
<<set _property to maplebirch.get("Finance").realEstate.current>>
<<if !_property || _property.id isnot 'danube' || !maplebirch.get("Finance").realEstate.owns('danube') || maplebirch.get("Finance").realEstate.managementFor('danube').rented>>
	<<lanLink ["Return to the agency", "返回房产中介"] 'Deadwood Reblooms Property Office'>><</lanLink>>
<<else>>
	<<run maplebirch.get("Finance").realEstate.enter()>><<set $outside to 1>><<effects>>
	<<= lanSwitch(_property.interior.balcony_view.EN, _property.interior.balcony_view.CN)>><br><br>
	<<lanSwitch 'The wall hides the street, but not its faint noise. From this height the conservatory glass catches the light while the paths below meet at the garden gate.' '围墙遮住街道，却挡不住隐约传来的声音。这个高度看去，温室的玻璃映着天光，下面的小径在花园门边汇合。'>><br><br>
	<<if Weather.precipitation is 'rain'>>
		<span class='blue'><<lanSwitch 'Rain stipples the conservatory roof and darkens the paths between the beds.' '雨点敲着温室屋顶，苗圃间的小径也渐渐变深。'>></span><br><br>
	<<elseif Time.dayState is 'night'>>
		<<lanSwitch 'A few lit windows mark the edge of the garden. Beyond the wall, the rest of the town is mostly shadow.' '几扇亮着灯的窗标出花园的边界。围墙之外，小镇的大半景物隐入夜色。'>><br><br>
	<</if>>
	<<getouticon>><<lanLink '返回二层阳台' 'Deadwood Reblooms Property Balcony'>><</lanLink>>
<</if>>

:: Deadwood Reblooms Property Balcony Rest []
<<set _property to maplebirch.get("Finance").realEstate.current>>
<<if !_property || _property.id isnot 'danube' || !maplebirch.get("Finance").realEstate.owns('danube') || maplebirch.get("Finance").realEstate.managementFor('danube').rented>>
	<<lanLink ["Return to the agency", "返回房产中介"] 'Deadwood Reblooms Property Office'>><</lanLink>>
<<else>>
	<<run maplebirch.get("Finance").realEstate.enter()>><<set $outside to 1>><<effects>>
	<<lanSwitch 'You settle into a chair beneath the eaves. The walls keep out the street noise, and the garden is still.' '你坐进檐下的椅子。围墙挡住了街上的喧闹，花园里一片安静。'>><br><br>
	<<lanLink '返回二层阳台' 'Deadwood Reblooms Property Balcony'>><</lanLink>>
<</if>>

:: Deadwood Reblooms Property Balcony Glide []
<<set _property to maplebirch.get("Finance").realEstate.current>>
<<if !_property || _property.id isnot 'danube' || !maplebirch.get("Finance").realEstate.owns('danube') || maplebirch.get("Finance").realEstate.managementFor('danube').rented>>
	<<lanLink ["Return to the agency", "返回房产中介"] 'Deadwood Reblooms Property Office'>><</lanLink>>
<<else>>
	<<run maplebirch.get("Finance").realEstate.setFloor(1)>><<run maplebirch.get("Finance").realEstate.enter()>><<set $outside to 1>><<effects>>
	<<language>>
		<<option 'EN'>>
			You spread your wings and glide across the garden. <span class='green'>Your feet find the path between the planting beds.</span>
		<<option 'CN'>>
			你展开翅膀，从花园上方滑过，<span class='green'>落在苗圃之间的小径上。</span>
	<</language>>
	<br><br>
	<<gardenicon>><<lanLink ["Go into the garden (0:01)", "走进花园 (0:01)"] 'Deadwood Reblooms Property Garden'>><<pass 1>><</lanLink>>
<</if>>

:: Deadwood Reblooms Property Balcony Glide Attempt []
<<set _property to maplebirch.get("Finance").realEstate.current>>
<<if !_property || _property.id isnot 'danube' || !maplebirch.get("Finance").realEstate.owns('danube') || maplebirch.get("Finance").realEstate.managementFor('danube').rented>>
	<<lanLink ["Return to the agency", "返回房产中介"] 'Deadwood Reblooms Property Office'>><</lanLink>>
<<else>>
	<<run maplebirch.get("Finance").realEstate.enter()>><<set $outside to 1>><<effects>>
	<<lanSwitch 'You step up to the stone rail and spread your wings.' '你走到石栏杆前，展开翅膀。'>><br><br>
	<<if $willpowerSuccess>>
		<<set $birdGlide to 1>>
		<span class='green'><<lanSwitch 'You steady yourself. The garden waits below.' '你稳住心神。花园就在下方。'>></span><<gwillpower>><<willpower 1>><br><br>
		<<glideicon>><<lanLink ["Glide into the garden", "滑翔到花园"] 'Deadwood Reblooms Property Balcony Glide'>><<endevent>><</lanLink>><br>
	<<else>>
		<<set $Finance.real_estate.glide_scared_day to Time.days>>
		<span class='red'><<lanSwitch 'You draw back from the edge. You cannot make yourself jump.' '你从阳台边退开，终究没能跳下去。'>></span><br><br>
	<</if>>
	<<getouticon>><<lanLink '返回二层阳台' 'Deadwood Reblooms Property Balcony'>><</lanLink>>
<</if>>

:: Deadwood Reblooms Property Flight Widgets [widget]
<<widget 'deadwood-reblooms-property-flight'>>
	<!-- 原版高处下降条件，从这些屋顶也可滑翔到小镇的其他街道。 -->
	<<if $harpy gte 6>>
		<<glideicon>><<lanLink '滑翔到楼下 (0:02)' 'Deadwood Reblooms Property Street Glide'>><<bird_pass 2>><<endevent>><</lanLink>><br>
	<<elseif $angel gte 6 or $demon gte 6 or $fallenangel gte 2>>
		<<if $pain gte 21>>
			<span class='purple'><<lanSwitch 'You are too injured to jump from here.' '你伤得太重，不能从这里跃下。'>></span><br>
		<<elseif $birdFly is 1 or $birdGlide is 1>>
			<<glideicon>><<lanLink '滑翔到楼下 (0:02)' 'Deadwood Reblooms Property Street Glide'>><<bird_pass 2>><<endevent>><</lanLink>><br>
		<<elseif currentSkillValue('willpower') gte 250 and $Finance.real_estate.glide_scared_day isnot Time.days>>
			<<glideicon>><<lanLink '尝试滑翔到楼下 (0:02)' 'Deadwood Reblooms Property Street Glide Attempt'>><<bird_pass 2>><<endevent>><</lanLink>><<willpowerdifficulty 250 1100>><br>
		<</if>>
	<</if>>
	<<if $harpy gte 6 or (($angel gte 6 or $demon gte 6 or $fallenangel gte 2) and $pain lt 21 and ($birdFly is 1 or $birdGlide is 1))>>
		<<glideicon>><<lanLink '滑翔到小镇其他街道' 'Deadwood Reblooms Property Flight'>><</lanLink>><br>
	<</if>>
<</widget>>

:: Deadwood Reblooms Property Street Glide Attempt []
<<set _property to maplebirch.get("Finance").realEstate.current>>
<<if !_property || !['barb', 'high', 'cliff'].includes(_property.id) || !maplebirch.get("Finance").realEstate.owns(_property.id) || maplebirch.get("Finance").realEstate.managementFor(_property.id).rented || maplebirch.get("Finance").realEstate.isFrozen(_property.id)>>
	<<getouticon>><<lanLink ["Return to the agency", "返回房产中介"] 'Deadwood Reblooms Property Office'>><</lanLink>>
<<else>>
	<<run maplebirch.get("Finance").realEstate.enter()>><<set $outside to 1>><<effects>>
	<<if $willpowerSuccess>>
		<<set $birdGlide to 1>>
		<span class='green'><<lanSwitch 'The wind catches your wings as you step over the rail.' '你越过栏杆，风托住了展开的翅膀。'>></span><<gwillpower>><<willpower 1>><br><br>
		<<glideicon>><<lanLink '滑翔到楼下' 'Deadwood Reblooms Property Street Glide'>><<endevent>><</lanLink>><br>
	<<else>>
		<<set $Finance.real_estate.glide_scared_day to Time.days>>
		<span class='red'><<lanSwitch 'You step back from the edge.' '你从边缘退了回来。'>></span><br><br>
	<</if>>
	<<getouticon>><<lanLink '返回露台或阳台' 'Deadwood Reblooms Property Outdoor'>><</lanLink>>
<</if>>

:: Deadwood Reblooms Property Street Glide []
<<set _property to maplebirch.get("Finance").realEstate.current>>
<<if !_property || !['barb', 'high', 'cliff'].includes(_property.id) || !maplebirch.get("Finance").realEstate.owns(_property.id) || maplebirch.get("Finance").realEstate.managementFor(_property.id).rented || maplebirch.get("Finance").realEstate.isFrozen(_property.id)>>
	<<getouticon>><<lanLink ["Return to the agency", "返回房产中介"] 'Deadwood Reblooms Property Office'>><</lanLink>>
<<else>>
	<<set $outside to 1>><<effects>>
	<<lanSwitch 'You spread your wings, cross the short distance from the roof and land on a clear stretch of pavement.' '你展开翅膀，从屋顶滑过一小段距离，落在街边一处空地上。'>><br><br>
	<<getouticon>><<lanLink _property.street_name.CN _property.street>><</lanLink>>
<</if>>

:: Deadwood Reblooms Property Flight []
<<set _property to maplebirch.get("Finance").realEstate.current>>
<<if !_property || !maplebirch.get("Finance").realEstate.owns(_property.id) || maplebirch.get("Finance").realEstate.managementFor(_property.id).rented || maplebirch.get("Finance").realEstate.isFrozen(_property.id) || !(($harpy gte 6) or (($angel gte 6 or $demon gte 6 or $fallenangel gte 2) and $pain lt 21 and ($birdFly is 1 or $birdGlide is 1)))>>
	<<getouticon>><<lanLink ["Return to the agency", "返回房产中介"] 'Deadwood Reblooms Property Office'>><</lanLink>>
<<else>>
	<<run maplebirch.get("Finance").realEstate.enter()>><<set $outside to 1>><<effects>>
	<<lanSwitch 'The rooftops and the slope of the streets leave room for a long glide. Where will you land?' '屋顶与街道的落差足以让你滑翔一程。你要落在哪里？'>><br><br>
	<<if $exposed gte 2 and !hasSexStat('exhibitionism', 4)>>
		<span class='red'><<lanSwitch 'You cannot bring yourself to glide exposed above town.' '你不敢赤裸着滑翔过小镇上空。'>></span><br>
	<<else>>
		<<set _destinations to [
			{ passage: 'Domus Street', EN: 'Domus Street', CN: '宅邸街' },
			{ passage: 'Barb Street', EN: 'Barb Street', CN: '倒钩街' },
			{ passage: 'High Street', EN: 'High Street', CN: '商业街' },
			{ passage: 'Cliff Street', EN: 'Cliff Street', CN: '峭壁街' },
			{ passage: 'Danube Street', EN: 'Danube Street', CN: '多瑙河街' }
		]>>
		<<for _destination range _destinations>>
			<<capture _destination>>
				<<glideicon>><<lanLink _destination.CN 'Deadwood Reblooms Property Flight Land'>><<set $Finance.real_estate.flight_street to _destination.passage>><<bird_pass 10>><<endevent>><</lanLink>> <span class='blue'>(0:10)</span><br>
			<</capture>>
		<</for>>
	<</if>>
	<<set _returnPassage to _property.id is 'danube' ? 'Deadwood Reblooms Property Balcony' : 'Deadwood Reblooms Property Outdoor View'>>
	<br><<getouticon>><<lanLink '返回住处' _returnPassage>><</lanLink>>
<</if>>

:: Deadwood Reblooms Property Flight Land []
<<set $outside to 1>><<effects>>
<<if !['Domus Street', 'Barb Street', 'High Street', 'Cliff Street', 'Danube Street'].includes($Finance.real_estate.flight_street)>>
  <<set $Finance.real_estate.flight_street to 'High Street'>>
<</if>>
<<lanSwitch 'You hold your wings open, ride the air over the roofs and descend toward a clear place on the street.' '你展开翅膀，乘着气流滑过屋顶，朝街上一处空地降下。'>><br><br>
<<switch $Finance.real_estate.flight_street>>
	<<case 'Domus Street'>><<lanSwitch 'The orphanage roof comes into view beyond the garden fences.' '花园围栏后，孤儿院的屋顶映入眼帘。'>><br>
	<<case 'Barb Street'>><<lanSwitch 'The dry canal and the passing traffic guide you down.' '干涸的运河和往来的车流为你指明了落点。'>><br>
	<<case 'High Street'>><<lanSwitch 'Shop signs and the moving crowd spread beneath you.' '店铺招牌与往来的人群在你脚下铺开。'>><br>
	<<case 'Cliff Street'>><<lanSwitch 'The sea wind follows you as you turn back toward the street.' '你转向街道时，海风仍追在身后。'>><br>
	<<case 'Danube Street'>><<lanSwitch 'You keep clear of the garden walls and land by the road.' '你避开花园的围墙，落在路边。'>><br>
<</switch>>
<br><<getouticon>><<lanLink '落到街上' $Finance.real_estate.flight_street>>
	<<if maplebirch.get("Finance").realEstate.current and $Finance.real_estate.flight_street isnot maplebirch.get("Finance").realEstate.current.street>>
		<<earnFeat 'Ride the Wind'>>
	<</if>>
<</lanLink>>

:: Deadwood Reblooms Property Outdoor View []
<<set _property to maplebirch.get("Finance").realEstate.current>>
<<if !_property || !maplebirch.get("Finance").realEstate.owns(_property.id) || maplebirch.get("Finance").realEstate.managementFor(_property.id).rented>>
	<<lanLink ["Return to the agency", "返回房产中介"] 'Deadwood Reblooms Property Office'>><</lanLink>>
<<else>>
	<<run maplebirch.get("Finance").realEstate.enter()>><<set $outside to 1>><<effects>>
	<<= lanSwitch(_property.interior.outdoor_view.EN, _property.interior.outdoor_view.CN)>><br><br>
	<<switch _property.id>>
		<<case 'domus'>><<lanSwitch 'Beyond the fence, footsteps pass the orphanage road. You can hear its gate open and close, but the little garden stays out of sight.' '围栏外的脚步声沿着孤儿院那条路渐近又远去。大门开了又关，这片小庭院仍藏在路人视线之外。'>><br><br>
		<<case 'barb'>><<lanSwitch 'The canal bed draws a long pale line between the buildings. A vehicle crosses the bridge, its sound briefly filling the space below your balcony.' '干涸的河床在楼宇之间划出一道浅色的长线。一辆车驶过桥面，声响短暂地填满阳台下的空间。'>><br><br>
		<<case 'high'>><<lanSwitch 'The shop fronts hide part of the pavement, but you can follow the crowd by its shifting voices. A stallholder folds away a sign when trade slows.' '店面的檐篷遮住部分人行道，你仍能循着起伏的人声辨认人群的去向。生意渐淡时，一名摊主收起了招牌。'>><br><br>
		<<case 'cliff'>><<lanSwitch 'A gust carries salt spray up from the rocks. Farther along the street, people keep close to the buildings to avoid the exposed edge.' '一阵风把礁石间的盐雾送了上来。街道另一头，行人贴着房屋走，避开无遮拦的崖边。'>><br><br>
		<<case 'danube'>><<lanSwitch 'The high wall muffles the road. You can make out the paths between the beds and the upper balcony looking down on them.' '高墙隔远了马路的声音。你能看清苗圃之间的小径，以及俯瞰这片花园的二层阳台。'>><br><br>
	<</switch>>
	<<if Weather.precipitation is 'rain'>>
		<span class='blue'><<lanSwitch 'Rain softens the distant sounds and beads along the edge beside you.' '雨声压低了远处的动静，也在你身旁的边沿聚成水珠。'>></span><br><br>
	<<elseif Weather.isSnow>>
		<span class='blue'><<lanSwitch 'Snow makes the familiar view quieter; fresh tracks show where someone passed recently.' '雪让熟悉的景象安静下来。新留下的脚印说明不久前还有人经过。'>></span><br><br>
	<<elseif Time.dayState is 'night'>>
		<<lanSwitch 'One light goes out, then another. You stay a little longer before turning back inside.' '一盏灯熄了，又有一盏暗下去。你多待了一会儿，才转身回屋。'>><br><br>
	<<else>>
		<<lanSwitch 'The air changes as you stand still. You take one last look before heading back.' '站得久了，风向也有了变化。你又看了一眼，才准备回去。'>><br><br>
	<</if>>
	<<if ['barb', 'high', 'cliff'].includes(_property.id)>>
		<<deadwood-reblooms-property-flight>>
	<</if>>
	<<getouticon>><<lanLink '收回视线' 'Deadwood Reblooms Property Outdoor'>><</lanLink>>
<</if>>

:: Deadwood Reblooms Property Guest Bedroom []
<<set _property to maplebirch.get("Finance").realEstate.current>>
<<if !_property || !maplebirch.get("Finance").realEstate.owns(_property.id) || maplebirch.get("Finance").realEstate.managementFor(_property.id).rented || !_property.interior.guest>>
	<<lanLink ["Return to the agency", "返回房产中介"] 'Deadwood Reblooms Property Office'>><</lanLink>>
<<else>>
	<<run maplebirch.get("Finance").realEstate.enter()>><<effects>>
	<<= lanSwitch(_property.interior.guest.EN, _property.interior.guest.CN)>><br><br>
	<<set _guests to maplebirch.get("Finance").realEstate.residentsInGuestRoom(_property.id)>>
	<<if _guests.length gt 0>>
		<<for _guestResident range _guests>>
			<<capture _guestResident>>
				<<npc _guestResident.id>><<person1>>
				<<= maplebirch.auto(_guestResident.id)>> <<lanSwitch 'looks up from the guest bed as you enter.' '见你进来，从客房的床上抬起头。'>><br><br>
				<<socialiseicon>><<lanLink ["Spend time together (0:20)", "一起待一会儿 (0:20)"] 'Deadwood Reblooms Property Evening Together'>>
					<<run maplebirch.get("Finance").realEstate.meetResident(_guestResident.id, _property.id)>><<pass 20>>
				<</lanLink>><br>
				<<loveicon 'kiss'>><<lanLink '请恋人到主卧陪你' 'Deadwood Reblooms Property Bedroom'>>
					<<run maplebirch.get("Finance").realEstate.meetResident(_guestResident.id, _property.id)>>
				<</lanLink>><br><br>
			<</capture>>
		<</for>>
	<<elseif maplebirch.get("Finance").realEstate.residentsAt(_property.id).length gt 1>>
		<<set _guestResident to maplebirch.get("Finance").realEstate.residentsAt(_property.id)[1]>>
		<<= maplebirch.auto(_guestResident.id)>> <<lanSwitch 'keeps their things here, but is not in the guest room now.' '把自己的东西放在这里，但现在不在客房。'>><br><br>
	<</if>>
	<<getouticon>><<lanLink ["Return to the landing (0:01)", "返回楼梯间 (0:01)"] 'Deadwood Reblooms Property Landing'>><<pass 1>><</lanLink>>
<</if>>

:: Deadwood Reblooms Property Retreat []
<<set _property to maplebirch.get("Finance").realEstate.current>>
<<if !_property || !maplebirch.get("Finance").realEstate.owns(_property.id) || maplebirch.get("Finance").realEstate.managementFor(_property.id).rented || !_property.interior.retreat>>
	<<lanLink ["Return to the agency", "返回房产中介"] 'Deadwood Reblooms Property Office'>><</lanLink>>
<<elseif _property.outdoor_access is 'retreat'>>
	<<include 'Deadwood Reblooms Property Outdoor'>>
<<else>>
	<<run maplebirch.get("Finance").realEstate.enter()>><<effects>>
	<<= lanSwitch(_property.interior.retreat.EN, _property.interior.retreat.CN)>><br><br>
	<<couchicon>><<lanLink ["Rest a while (0:15)", "休息片刻 (0:15)"] 'Deadwood Reblooms Property Retreat Rest'>><<pass 15>><<stress -2>><<tiredness -4>><</lanLink>><<lstress>><<ltiredness>><br>
	<br>
	<<if _property.rooms.retreat is 1>>
		<<getouticon>><<lanLink ["Sitting room (0:01)", "起居室 (0:01)"] 'Deadwood Reblooms Property Home'>><<pass 1>><</lanLink>>
	<<else>>
		<<getouticon>><<lanLink ["Return to the landing (0:01)", "返回楼梯间 (0:01)"] 'Deadwood Reblooms Property Landing'>><<pass 1>><</lanLink>>
	<</if>>
<</if>>

:: Deadwood Reblooms Property Retreat Rest []
<<set _property to maplebirch.get("Finance").realEstate.current>>
<<if !_property || !maplebirch.get("Finance").realEstate.owns(_property.id) || maplebirch.get("Finance").realEstate.managementFor(_property.id).rented || !_property.interior.retreat_rest>>
	<<lanLink ["Return to the agency", "返回房产中介"] 'Deadwood Reblooms Property Office'>><</lanLink>>
<<else>>
	<<run maplebirch.get("Finance").realEstate.enter()>><<effects>>
	<<= lanSwitch(_property.interior.retreat_rest.EN, _property.interior.retreat_rest.CN)>><br><br>
	<<if _property.outdoor_access is 'retreat'>>
		<<lanLink ["Stand up", "起身"] 'Deadwood Reblooms Property Outdoor'>><</lanLink>>
	<<else>>
		<<lanLink ["Stand up", "起身"] 'Deadwood Reblooms Property Retreat'>><</lanLink>>
	<</if>>
<</if>>

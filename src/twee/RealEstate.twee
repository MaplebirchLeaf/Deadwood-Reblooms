:: Deadwood Reblooms Real Estate Widgets [widget]
<!-- 住宅选择沿用原版街道图标，不为五处房产另造一套近似的房屋图标。 -->
<<widget 'deadwood-reblooms-property-street-icon'>>
	<<switch _args[0]>>
		<<case 'domus'>><<domusicon>>
		<<case 'barb'>><<barbicon>>
		<<case 'high'>><<highicon>>
		<<case 'cliff'>><<clifficon>>
		<<case 'danube'>><<danubeicon>>
	<</switch>>
<</widget>>

<<widget 'deadwood-reblooms-property-outdoor-icon'>>
	<<switch _args[0]>>
		<<case 'domus' 'danube'>><<gardenicon>>
		<<case 'barb'>><<icon 'barb-balcony.png'>>
		<<case 'high'>><<icon 'high-roof-terrace.png'>>
		<<case 'cliff'>><<icon 'cliff-sea-balcony.png'>>
	<</switch>>
<</widget>>

<<widget 'deadwood-reblooms-property-street'>>
	<<set _property to maplebirch.get("VanillaPlus").realEstate.properties.find(item => item.street === $passage)>>
	<<if _property
		and maplebirch.get("VanillaPlus").realEstate.owns(_property.id)
		and !maplebirch.get("VanillaPlus").realEstate.managementFor(_property.id).rented
		and !maplebirch.get("VanillaPlus").realEstate.isFrozen(_property.id)>>
		<<deadwood-reblooms-property-street-icon _property.id>><<lanLink _property.entry_label.CN 'Deadwood Reblooms Property Home'>><<run maplebirch.get("VanillaPlus").realEstate.visit(_property.id)>><<pass 2>><</lanLink>><br><br>
	<</if>>
<</widget>>

<<widget 'deadwood-reblooms-property-furnishings-link'>>
	<<if $exposed lte 0 and Time.dayState isnot 'night' and Time.hour isnot 21 and $stress lt $stressmax
		and maplebirch.get("VanillaPlus").realEstate.properties.some(property => maplebirch.get("VanillaPlus").realEstate.owns(property.id))>>
		<<furnitureicon 'catalogue'>><<lanLink ['Shop for furniture for your homes', '为自住房选购家具'] 'Deadwood Reblooms Property Furnishings'>><</lanLink>><br><br>
	<</if>>
<</widget>>

<!-- 邀请和分开居住都从与 NPC 面对面交谈的原版 Passage 进入。 -->
<<widget 'deadwood-reblooms-property-invitation-link'>>
	<<set _name to _args[0]>>
	<<set _invitePassage to _args[1]>>
	<!-- 是否能当面邀请由原版日程决定，关闭立绘后也照常显示。 -->
	<<if _name is 'Sydney' and ['Library Rental Counter', 'Science Lesson'].includes($passage)>>
		<<silently>><<sydneySchedule>><</silently>>
	<</if>>
	<!-- Science Lesson 在特殊检查分支先将事件计数加一，并把计时器设为 14，然后才执行 BeforeLinkZone。 -->
	<<if window.isLoveInterest(_name)
		and maplebirch.get("VanillaPlus").realEstate.properties.some(property => maplebirch.get("VanillaPlus").realEstate.owns(property.id) && !maplebirch.get("VanillaPlus").realEstate.managementFor(property.id).rented)
		and ($passage isnot 'Library Rental Counter' or _sydney_location is 'library')
		and ($passage isnot 'Maths Lesson' or ($schoolstate is 'second' and $whitneymaths is 'seat'
			and Time.minute lt 59 and (Time.weekDay isnot 6 or Time.minute lt 37)))
		and ($passage isnot 'English Lesson' or ($schoolstate is 'third' and $kylarenglishstate is 'active'
			and Time.minute lt 59 and (Time.weekDay isnot 6 or Time.minute lt 37)))
		and ($passage isnot 'Science Lesson' or ($schoolstate is 'first' and $sydneyScience is 1
			and _sydney_location is 'science'
			and Time.minute lt 59 and (Time.weekDay isnot 6 or Time.minute lt 37)
			and !($schooleventtimer is 14 and [1, 2, 3].includes($schoolevent))
			and !($stress gte $stressmax and isPregnancyEnding())))
		and ($passage isnot 'History Lesson' or ($schoolstate is 'fourth' and $robinhistory is 'seat'
			and Time.minute lt 59 and (Time.weekDay isnot 6 or Time.minute lt 37)))
		and ($passage isnot 'History Classroom' or ($schoolstate is 'lunch' and $robinhistory is 'seat'))
		and ($passage isnot 'English Classroom' or ($schoolstate is 'afternoon' and $englishPlay is 'ongoing' and !$englishPlayLate
			and (_name is 'Sydney' or (getKylarLocation().area is 'english' and ['rehearsal', 'dual_rehearsal'].includes(getKylarLocation().state)))))>>
		<<loveicon>><<lanLink ['Talk about living together', '谈谈同住的事'] _invitePassage>><</lanLink>><br>
	<</if>>
<</widget>>

<<widget 'deadwood-reblooms-property-invitation'>>
	<<set _name to _args[0]>>
	<<set _return to _args[1]>>
	<<set _invitePassage to _args[2]>>
	<<set _inLesson to ['Maths Lesson', 'English Lesson', 'Science Lesson', 'History Lesson'].includes(_return)>>
	<<set _profile to maplebirch.get("VanillaPlus").realEstate.residentProfiles.find(profile => profile.id === _name)>>
	<<set _message to maplebirch.get("VanillaPlus").realEstate.takeHouseholdMessage()>>
	<<if _message && _message.name is _name>>
		<<switch _message.result>>
			<<case 'joined'>><span class='green'><<= lanSwitch(_profile.welcome.EN, _profile.welcome.CN)>></span><br><br>
				<<set _joinedHome to maplebirch.get("VanillaPlus").realEstate.residenceOf(_name)>>
				<<if _joinedHome>>
					<<set _otherResidents to maplebirch.get("VanillaPlus").realEstate.residentsAt(_joinedHome.id).filter(profile => profile.id !== _name)>>
					<<if _otherResidents.length gt 0>>
						<<language>>
							<<option 'EN'>>
								You explain who else lives there and show which room is available. Living under the same roof does not mean sharing a bed or entering someone else’s room without asking.
							<<option 'CN'>>
								你说明还有谁住在这里，以及哪间房可以使用。同住不等于同床，进别人的房间之前，也要先问一声。
						<</language>><br><br>
						<<switch _name>>
							<<case 'Robin'>>
								<<language>>
									<<option 'EN'>>
										Robin asks whether there will still be somewhere to sit with you alone. You point out the guest room and promise to knock.
									<<option 'CN'>>
										罗宾问，还能不能找个地方单独和你坐一会儿。你指出客房的位置，答应进门前会敲门。
								<</language>><br>
							<<case 'Whitney'>>
								<<language>>
									<<option 'EN'>>
										“Keep them out of my things,” Whitney says. Whitney checks the room before putting the key away.
									<<option 'CN'>>
										“别让人乱翻我的东西。”惠特尼说。惠特尼确认了房间的位置，才收起钥匙。
								<</language>><br>
							<<case 'Kylar'>>
								<<language>>
									<<option 'EN'>>
										Kylar’s smile falters at the other name. “I thought this was for us.” You explain the arrangement again, without calling the guest room a promise of anything more. Kylar checks which room is available, without taking the arrangement as a promise that you belong only to Kylar.
									<<option 'CN'>>
										听到另一个名字，凯拉尔的笑容僵了一下。“我以为这是给我们的。”你又解释了一遍安排，没有把客房说成更多的承诺。凯拉尔确认了能用哪间房，却没有把这份安排当成你只属于凯拉尔的承诺。
								<</language>><br>
							<<case 'Sydney'>>
								<<language>>
									<<option 'EN'>>
										Sydney asks about privacy and the early morning routine. “Please tell me before changing the arrangement,” Sydney says, looking at you rather than the spare key.
									<<option 'CN'>>
										悉尼问起私人空间和清晨的作息。“以后要改安排，先告诉我，好吗？”悉尼看着你，没有去看那把备用钥匙。
								<</language>><br>
						<</switch>><br>
					<</if>>
				<</if>>
			<<case 'full'>><span class='red'><<lanSwitch 'There is no room for another person to live there.' '那处房子住不下更多人了。'>></span><br><br>
			<<case 'bed'>><span class='red'><<language>>
				<<option 'EN'>>
					You need a double bed before you can live together there.
				<<option 'CN'>>
					你们需要一张双人床，才能住在一起。
			<</language>></span><br><br>
			<<case 'conflict'>>
				<<if _message.refused_by isnot _name>>
					<<if _message.refused_by is 'Robin'>>
						<<language>>
							<<option 'EN'>>
								You think of Robin returning home to find Whitney there. You put the spare key away rather than offer Robin’s home without agreement.
							<<option 'CN'>>
								你想到罗宾回家后发现惠特尼也住在那里。你收起备用钥匙，没有替罗宾答应这项安排。
						<</language>><br>
					<<elseif C.npc.Kylar.rage gte 60>>
						<<language>>
							<<option 'EN'>>
								You know how Kylar reacts when someone else gets close to you. You withdraw this offer rather than promise a shared address Kylar will refuse.
							<<option 'CN'>>
								你知道凯拉尔看见别人靠近你时会有什么反应。你收回这次提议，没有许下凯拉尔不会接受的共同住址。
						<</language>><br>
					<<else>>
						<<language>>
							<<option 'EN'>>
								You cannot offer Whitney a place in Kylar’s home as though their hostility ended at the door. You put the spare key away.
							<<option 'CN'>>
								你没法把凯拉尔的住处也交给惠特尼，装作两人的敌意到了门口就会消失。你收起备用钥匙。
						<</language>><br>
					<</if>>
					<<if _name is 'Whitney'>>
						<<language>>
							<<option 'EN'>>
								Whitney laughs through the nose. “So find me somewhere better.” You leave the occupied house out of the offer.
							<<option 'CN'>>
								惠特尼从鼻子里笑了一声。“那就给我找个更好的。”你没有把已经有人住的房子重新提出。
						<</language>><br><br>
					<</if>>
				<<elseif _message.refused_by is 'Robin'>>
					<<if C.npc.Robin.dom gte 80 and C.npc.Robin.trauma lt 20>>
						<<language>>
							<<option 'EN'>>
								Robin puts the key down. “I’m not living with Whitney. Find somewhere else.” The answer is directed at you, and Robin waits until you acknowledge it.
							<<option 'CN'>>
								罗宾把钥匙放下。“我不和惠特尼住。换个地方吧。”这句话是对你说的，罗宾等着你回应，没有让你略过。
						<</language>><br><br>
					<<else>>
						<<language>>
							<<option 'EN'>>
								Robin stops smiling when you mention Whitney. “Will Whitney be there too? Then I don’t want to.” You put the spare key away.
							<<option 'CN'>>
								听见惠特尼的名字，罗宾脸上的笑容消失了。“惠特尼也住在那里？那我不想去。”你收起了备用钥匙。
						<</language>><br><br>
					<</if>>
				<<elseif _message.refused_by is 'Kylar'>>
					<<if C.npc.Kylar.rage gte 60>>
						<<language>>
							<<option 'EN'>>
								Kylar grips the key until the knuckles whiten. “So this isn’t just for us.” You start to answer, but Kylar turns away and ends the conversation.
							<<option 'CN'>>
								凯拉尔攥着钥匙，指节渐渐发白。“所以，这里不只是给我们的。”你刚要回答，凯拉尔便转身离开，结束了这场谈话。
						<</language>><br><br>
					<<else>>
						<<language>>
							<<option 'EN'>>
								“Whitney?” Kylar pulls back before taking the spare key. “No. Somewhere else.” The suggestion of a separate room does not change the answer.
							<<option 'CN'>>
								“惠特尼？”凯拉尔在接过备用钥匙前退了一步。“不要。换个地方。”你提到还有单独的房间，也没有改变这个回答。
						<</language>><br><br>
					<</if>>
				<</if>>
				<span class='red'><i><<language>>
					<<option 'EN'>>
						The shared arrangement was refused. You can offer a separate home.
					<<option 'CN'>>
						共同入住的安排被拒绝了，你可以另找一处住所。
				<</language>></i></span><br><br>
			<<case 'left'>><<lanSwitch 'You agree to live apart again.' '你们说好重新分开居住。'>><br><br>
		<</switch>>
	<</if>>
	<<if !window.isLoveInterest(_name)>>
		<span class='blue'><i><<language>>
			<<option 'EN'>>
				You need to speak as lovers before making such a promise.
			<<option 'CN'>>
				你们还不是恋人，没法谈这件事。
		<</language>></i></span><br><br>
	<<else>>
		<<if _inLesson>>
			<<language>>
				<<option 'EN'>>
					You lean close and keep your voice low so the teacher cannot hear.
				<<option 'CN'>>
					你凑近对方，压低声音，免得被老师听见。
			<</language>><br><br>
		<</if>>
		<<set _currentHome to maplebirch.get("VanillaPlus").realEstate.properties.find(property => maplebirch.get("VanillaPlus").realEstate.residentsAt(property.id).some(resident => resident.id === _name))>>
		<<if _currentHome>>
			<<language>>
				<<option 'EN'>>
				You mention the keys to <<= _currentHome.name.EN>>. <<= _name>> already has one, tucked safely away.
				<br><br>
				<span class='blue'><i>You can ask <<= _name>> to live separately again, or offer a different home.</i></span>
				<<option 'CN'>>
				你提起<<= _currentHome.name.CN>>的钥匙。<<= maplebirch.auto(_name)>>已经收好了一把。
				<br><br>
				<span class='blue'><i>你可以和<<= maplebirch.auto(_name)>>商量重新分开住，或是搬去另一处房子。</i></span>
			<</language>><br><br>
			<<lanLink ['Discuss living separately', '商量分开居住'] _invitePassage>>
				<<run maplebirch.get("VanillaPlus").realEstate.endCohabitation(_name, _currentHome.id)>>
			<</lanLink>><br>
		<<else>>
			<<switch _name>>
				<<case 'Robin'>>
					<<language>>
						<<option 'EN'>>
							You ask Robin whether they would like a key of their own, while still helping at the orphanage.
						<<option 'CN'>>
							你问罗宾，愿不愿意收下一把钥匙。白天还可以照常照顾孤儿院。
					<</language>><br><br>
				<<case 'Whitney'>>
					<<language>>
						<<option 'EN'>>
							You suggest sharing a place. Whitney folds their arms, waiting for you to say where.
						<<option 'CN'>>
							你提出一起住。惠特尼抱起胳膊，等你说出住处。
					<</language>><br><br>
				<<case 'Kylar'>>
					<<language>>
						<<option 'EN'>>
							You ask Kylar whether they would like somewhere to come home to with you.
						<<option 'CN'>>
							你问凯拉尔，愿不愿意和你一起有个回去的地方。
					<</language>><br><br>
				<<case 'Sydney'>>
					<<language>>
						<<option 'EN'>>
							You ask Sydney whether they could come home to you after their temple duties.
						<<option 'CN'>>
							你问悉尼，忙完神殿的事后，愿不愿意回到你们共同的家。
					<</language>><br><br>
			<</switch>>
		<</if>>
		<<for _property range maplebirch.get("VanillaPlus").realEstate.properties>>
			<<capture _property>>
				<<if maplebirch.get("VanillaPlus").realEstate.owns(_property.id)
					and !maplebirch.get("VanillaPlus").realEstate.managementFor(_property.id).rented
					and !maplebirch.get("VanillaPlus").realEstate.isFrozen(_property.id)
					and _currentHome?.id isnot _property.id>>
					<<set _occupants to maplebirch.get("VanillaPlus").realEstate.residentsAt(_property.id).length>>
					<<if _occupants gte _property.resident_capacity>>
						<<deadwood-reblooms-property-street-icon _property.id>><span class='red'><<= lanSwitch(_property.name.EN, _property.name.CN)>> · <<lanSwitch 'No room for another resident' '住不下更多人'>></span><br>
					<<elseif !maplebirch.get("VanillaPlus").realEstate.canShareBed(_property.id)>>
						<<deadwood-reblooms-property-street-icon _property.id>><span class='red'><<= lanSwitch(_property.name.EN, _property.name.CN)>> · <<lanSwitch 'Needs a double bed' '需要双人床'>></span><br>
					<<else>>
						<<if _occupants gt 0 and maplebirch.get("VanillaPlus").realEstate.householdRefusal([...maplebirch.get("VanillaPlus").realEstate.residentsAt(_property.id).map(profile => profile.id), _name])>>
							<span class='red'><i><<language>>
								<<option 'EN'>>
									You cannot assume these two will agree to live together. They can stay in separate homes.
								<<option 'CN'>>
									你不能指望这两个人会同意一起住。可以让他们分别住在不同的房子里。
							<</language>></i></span><br>
						<</if>>
						<<if _occupants gt 0>>
							<span class='blue'><i><<lanSwitch 'Already living here: ' '这里已有同住者：'>><<= maplebirch.get("VanillaPlus").realEstate.residentsAt(_property.id).map(profile => maplebirch.auto(profile.id)).join(lanSwitch(', ', '、'))>><<lanSwitch '. ' '。'>><<lanSwitch 'You explain this before offering the spare key.' '你先说明这一点，再提出交付备用钥匙。'>></i></span><br>
						<</if>>
						<<deadwood-reblooms-property-street-icon _property.id>><<language>>
							<<option 'EN'>>
								<<link _property.name.EN _invitePassage>>
									<<if _inLesson>>
									  <<pass 1>>
									<<else>>
									  <<pass 30>>
									<</if>>
									<<run maplebirch.get("VanillaPlus").realEstate.inviteResident(_name, _property.id)>>
								<</link>>
							<<option 'CN'>>
								<<link _property.name.CN _invitePassage>>
									<<if _inLesson>>
									  <<pass 1>>
									<<else>>
									  <<pass 30>>
									<</if>>
									<<run maplebirch.get("VanillaPlus").realEstate.inviteResident(_name, _property.id)>>
								<</link>>
						<</language>><br>
					<</if>>
				<</if>>
			<</capture>>
		<</for>>
	<</if>>
	<br><<lanLink ['Continue talking', '继续交谈'] _return>><</lanLink>>
<</widget>>

<!-- 功能房间的位置由房产配置决定。一层和楼梯间共用这一组入口。 -->
<<widget 'deadwood-reblooms-property-floor-rooms'>>
	<<set _roomProperty to maplebirch.get("VanillaPlus").realEstate.current>>
	<<if maplebirch.get("VanillaPlus").realEstate.floorOf('bedroom') is _args[0]>>
		<<bedicon>><<lanLink _roomProperty.interior.bedroom_label.CN 'Deadwood Reblooms Property Bedroom'>><<pass 1>><</lanLink>><br>
	<</if>>
	<<if maplebirch.get("VanillaPlus").realEstate.floorOf('bathroom') is _args[0]>>
		<<bathroomicon 'bath'>><<lanLink '浴室 (0:01)' 'Deadwood Reblooms Property Bathroom'>><<pass 1>><</lanLink>><br>
	<</if>>
	<<if maplebirch.get("VanillaPlus").realEstate.floorOf('kitchen') is _args[0]>>
		<<kitchenicon 'stove'>><<lanLink _roomProperty.interior.kitchen_label.CN 'Deadwood Reblooms Property Kitchen'>><<pass 1>><</lanLink>><br>
	<</if>>
	<!-- 同层书桌摆在卧室里时，只从卧室进入。 -->
	<<if maplebirch.get("VanillaPlus").realEstate.floorOf('desk') is _args[0]
		and _roomProperty.rooms.desk isnot _roomProperty.rooms.bedroom>>
		<<deskchairicon>><<lanLink '书桌' 'Deadwood Reblooms Property Desk'>><</lanLink>><br>
	<</if>>
	<<if maplebirch.get("VanillaPlus").realEstate.floorOf('guest') is _args[0]>>
		<<bedicon>><<lanLink ['Guest bedroom (0:01)', '客房 (0:01)'] 'Deadwood Reblooms Property Guest Bedroom'>><<pass 1>><</lanLink>><br>
	<</if>>
	<<if maplebirch.get("VanillaPlus").realEstate.floorOf('retreat') is _args[0]>>
		<<if _roomProperty.id is 'danube'>>
		  <<icon 'danube-conservatory.png'>>
		<<else>>
		  <<couchicon>>
		<</if>>
		<<if _roomProperty.outdoor_access is 'retreat'>>
			<<lanLink `lanSwitch('Sea-view alcove and balcony (0:01)', '观海角与阳台 (0:01)')` 'Deadwood Reblooms Property Outdoor'>><<pass 1>><</lanLink>><br>
		<<else>>
			<<lanLink _roomProperty.interior.retreat_label.CN 'Deadwood Reblooms Property Retreat'>><<pass 1>><</lanLink>><br>
		<</if>>
	<</if>>
	<<if maplebirch.get("VanillaPlus").realEstate.floorOf('outdoor') is _args[0]
		and (_roomProperty.outdoor_access is 'landing' or (_roomProperty.outdoor_access is 'sitting' and _args[0] is 1))>>
		<<deadwood-reblooms-property-outdoor-icon _roomProperty.id>>
		<<lanLink _roomProperty.interior.outdoor_label.CN 'Deadwood Reblooms Property Outdoor'>><<pass 1>><</lanLink>><br>
	<</if>>
	<<if maplebirch.get("VanillaPlus").realEstate.floorOf('balcony') is _args[0]>>
		<<icon 'danube-balcony.png'>><<lanLink _roomProperty.interior.balcony_label.CN 'Deadwood Reblooms Property Balcony'>><<pass 1>><</lanLink>><br>
	<</if>>
<</widget>>

<<widget 'deadwood-reblooms-property-wardrobe-exit'>>
	<<lanLink '关上衣柜' 'Deadwood Reblooms Property Bedroom'>><<cleanupOnWardrobeExit>><</lanLink>>
<</widget>>

<<widget 'deadwood-reblooms-property-sleep-outfits'>>
	<<run maplebirch.get("VanillaPlus").realEstate.openWardrobe()>><<wardrobeSelection true>>
	<<set $storeLocation to 'Deadwood Property Bed'>>
	<<set _sleepBed to maplebirch.get("VanillaPlus").realEstate.furniture(maplebirch.get("VanillaPlus").realEstate.current.id, 'bed')>>
	<<if !$earSlime.alwaysSleepNaked or $hypnosis_traits.silence>>
		<<for _index, _outfit range $outfit>>
			<<if _outfit.type.includes('sleep')>>
				<<capture _index _outfit>>
					<<set _outfitname to _outfit.name + (_outfit.colors is false ? '' : ' [C]')>>
					<<furnitureicon _sleepBed.iconFile>><<lanLink `['Wear ' + _outfitname + ' and climb in bed', '穿上' + _outfitname + '并爬到床上']` 'Deadwood Reblooms Property Bed'>><<set $wear_outfit to _index>><<saveTempHairStyle>><</lanLink>><br>
				<</capture>>
			<</if>>
		<</for>>
	<</if>>
<</widget>>

<<widget 'deadwood-reblooms-property-clothes-on'>>
	<<run maplebirch.get("VanillaPlus").realEstate.openWardrobe()>>
	<<storeon 'Deadwood Property Bed'>><<loadTempHairStyle>>
	<<updateWornClothingLocation $wardrobe_location>>
	<<set $wear_outfit to 'none'>>
<</widget>>

:: Deadwood Reblooms Property Office []
<<set $outside to 0>><<set $location to 'financial_centre'>><<effects>>
<<deadwood-reblooms-adrian-greeting 'financial_centre_property'>>
<label><<lanSwitch 'Loan term (days): ' '贷款期限（天）：'>><<listbox '$VanillaPlus.real_estate.mortgage_term' autoselect>><<optionsfrom maplebirch.get('VanillaPlus').realEstate.mortgage.terms.available_terms>><</listbox>></label>
<<lanLink ['Update quotes', '更新报价'] 'Deadwood Reblooms Property Office'>><</lanLink>><br><br>
<<language>>
	<<option 'EN'>>
	Behind the property desk at the financial centre, <span class='gold'>five deeds</span> stand in a glass display. The agent spreads out the keys and lets you look over the particulars.
	<<option 'CN'>>
	金融中心的房产柜台后，玻璃橱窗里摆着<span class='gold'>五处房产的契据</span>。中介摊开钥匙，让你逐项查看房屋资料。
<</language>><br><br>
<<if $VanillaPlus.real_estate.last_auction>>
	<<set _sale to $VanillaPlus.real_estate.last_auction>>
	<<set _soldProperty to maplebirch.get("VanillaPlus").realEstate.properties.find(item => item.id === _sale.property_id)>>
	<<if _soldProperty>>
		<strong class='gold'><<lanSwitch 'Last auction' '最近一次拍卖'>></strong><br>
		<<= lanSwitch(_soldProperty.name.EN, _soldProperty.name.CN)>> · <<deadwood-reblooms-finance-money _sale.proceeds>><br>
		<<if _sale.kind is 'foreclosure'>>
			<<lanSwitch 'Mortgage debt settled from proceeds' '拍卖款抵偿房贷'>>：
			<<deadwood-reblooms-finance-money _sale.debt>><br>
		<</if>>
		<<if _sale.shortfall gt 0>>
		  <span class='red'><<lanSwitch 'Debt remaining after auction: ' '拍卖后仍欠：'>><<deadwood-reblooms-finance-money _sale.shortfall>></span><br>
		<</if>>
		<<lanSwitch 'Balance returned to your bank account' '返还银行账户'>>：
		<<deadwood-reblooms-finance-money _sale.surplus>><br><br>
	<</if>>
<</if>>
<div class='settingsGrid'>
<<for _property range maplebirch.get("VanillaPlus").realEstate.properties>>
	<<capture _property>>
		<<set _askingPrice to maplebirch.get("VanillaPlus").realEstate.askingPrice(_property.id)>>
		<<set _baseWeeklyRent to maplebirch.get("VanillaPlus").realEstate.baseWeeklyRent(_property.id)>>
		<div class='settingsToggleItem'>
			<strong class='gold'><<= lanSwitch(_property.name.EN, _property.name.CN)>></strong><br>
			<<deadwood-reblooms-finance-money _askingPrice>><br><br>
			<<= lanSwitch(_property.description.EN, _property.description.CN)>><br><br>
			<<lanSwitch 'Floors' '楼层数'>>：<<= _property.floors.length>> ·
			<<lanSwitch 'Base weekly rent' '基础周租金'>>：<<deadwood-reblooms-finance-money _baseWeeklyRent>><br><br>
			<<if maplebirch.get("VanillaPlus").realEstate.owns(_property.id)>>
				<<set _management to maplebirch.get("VanillaPlus").realEstate.managementFor(_property.id)>>
				<span class='green'><<lanSwitch 'Owned' '已持有'>></span>
				<<if !_management.rented>>
				  · <<lanSwitch 'Your home' '你的住所'>>
				<</if>>
				<br>
				<<set _upkeep to maplebirch.get("VanillaPlus").realEstate.maintenanceCost(_property.id)>>
				<<if maplebirch.get('VanillaPlus').realEstate.collateralLimit(_property.id) gt 0>>
				  <<lanLink ['Borrow against this property', '以这处房产抵押借款'] 'Deadwood Reblooms Property Collateral'>><<set $VanillaPlus.real_estate.collateral_property to _property.id>><</lanLink>><br>
				<</if>>
				<<lanSwitch 'Condition' '房屋状况'>>：<<= _management.condition>>/100 · <<lanSwitch 'Renovation' '装修等级'>>：<<= _management.renovation>>/<<= maplebirch.get("VanillaPlus").realEstate.mortgage.terms.rental.max_renovation_level>><br>
				<<lanSwitch 'Weekly upkeep' '每周维护费'>>：<<deadwood-reblooms-finance-money _upkeep>><br>
				<<if _management.rented>>
					<<if Time.days lt _management.vacancy_until>>
					  <span class='blue'><<lanSwitch 'Finding a tenant until day ' '寻找租客，预计入住日：'>><<= _management.vacancy_until>></span><br>
					<</if>>
					<<if _management.rental_issue>>
					  <span class='red'><<lanSwitch 'The tenant has left a message.' '租客留下了消息。'>></span> · <<lanLink ['Contact the tenant', '联系租客'] 'Deadwood Reblooms Property Tenant'>><<set $VanillaPlus.real_estate.tenant_property to _property.id>><</lanLink>><br>
					<</if>>
					<<set _weeklyRent to maplebirch.get("VanillaPlus").realEstate.weeklyRent(_property.id)>>
					<<lanSwitch 'Rented out; weekly rent before upkeep' '已出租。未扣维护费的周租金'>>：<<deadwood-reblooms-finance-money _weeklyRent>><br>
					<<if _management.lease_end_day is null>>
					  <<lanLink ['Give tenant seven days notice', '通知租客七天后退租'] 'Deadwood Reblooms Property Office'>><<run maplebirch.get("VanillaPlus").realEstate.endLease(_property.id)>><</lanLink>><br>
					<</if>>
				<<elseif _management.auction_day isnot null>>
					<<lanSwitch 'Auction closes on day' '拍卖结束日'>> <<=_management.auction_day>> · <<lanLink ['Withdraw listing', '撤回拍卖委托'] 'Deadwood Reblooms Property Office'>><<run maplebirch.get("VanillaPlus").realEstate.cancelAuction(_property.id)>><</lanLink>><br>
				<<else>>
					<<if _management.renovation lt maplebirch.get("VanillaPlus").realEstate.mortgage.terms.rental.max_renovation_level && !maplebirch.get("VanillaPlus").realEstate.isFrozen(_property.id)>>
						<<set _renovationCost to maplebirch.get("VanillaPlus").realEstate.renovationCost(_property.id)>>
						<<if $VanillaPlus.finance.bank.balance gte _renovationCost>>
						  <<lanLink '装修' 'Deadwood Reblooms Property Office'>><<run maplebirch.get("VanillaPlus").realEstate.renovate(_property.id)>><</lanLink>>
						<<else>>
						  <<lanSwitch 'Renovate' '装修'>>
						<</if>>
						：<<deadwood-reblooms-finance-money _renovationCost>><br>
					<</if>>
					<<if _management.condition lt 100 && !maplebirch.get("VanillaPlus").realEstate.isFrozen(_property.id)>>
						<<set _repairCost to maplebirch.get("VanillaPlus").realEstate.repairCost(_property.id)>>
						<<if $VanillaPlus.finance.bank.balance gte _repairCost>>
						  <<lanLink '维修' 'Deadwood Reblooms Property Office'>><<run maplebirch.get("VanillaPlus").realEstate.repair(_property.id)>><</lanLink>>
						<<else>>
						  <<lanSwitch 'Repair' '维修'>>
						<</if>>
						：<<deadwood-reblooms-finance-money _repairCost>><br>
					<</if>>
					<<if maplebirch.get("VanillaPlus").realEstate.residentsAt(_property.id).length is 0 && !maplebirch.get("VanillaPlus").realEstate.isFrozen(_property.id)>>
						<<if _management.condition gte maplebirch.get("VanillaPlus").realEstate.mortgage.terms.rental.minimum_condition>>
						  <<lanLink '出租' 'Deadwood Reblooms Property Office'>><<run maplebirch.get("VanillaPlus").realEstate.rentOut(_property.id)>><</lanLink>><br>
						<</if>>
						<<if !$VanillaPlus.real_estate.mortgage || $VanillaPlus.real_estate.mortgage.property_id isnot _property.id>>
							<<lanLink ['List for auction (7 days)', '委托拍卖（七天）'] 'Deadwood Reblooms Property Office'>><<run maplebirch.get("VanillaPlus").realEstate.listAuction(_property.id)>><</lanLink>><br>
						<</if>>
					<</if>>
				<</if>>
			<<elseif !$VanillaPlus.finance.bank.opened>>
				<span class='blue'><i><<lanSwitch 'Open a bank account before buying.' '购买前需要开立银行账户。'>></i></span><br>
			<<else>>
				<<if $VanillaPlus.finance.bank.balance gte _askingPrice>>
					<<lanLink ['Buy outright', '全款购买'] 'Deadwood Reblooms Property Office'>><<run maplebirch.get("VanillaPlus").realEstate.buy(_property.id)>><</lanLink>><br>
				<</if>>
				<<if !$VanillaPlus.real_estate.mortgage>>
					<<set _mortgageCosts to maplebirch.get("VanillaPlus").realEstate.mortgage.purchaseCosts(_askingPrice, $VanillaPlus.real_estate.mortgage_term)>>
					<<set _downPayment to _mortgageCosts.deposit>>
					<<set _closingFee to _mortgageCosts.fee>>
					<<set _reserve to _mortgageCosts.reserve>>
					<<lanSwitch 'Mortgage down payment' '房贷首付'>>：<<deadwood-reblooms-finance-money _downPayment>><br>
					<<lanSwitch 'Bank-paid fee' '银行账户支付的手续费'>>：<<deadwood-reblooms-finance-money _closingFee>><br>
					<<lanSwitch 'One weekly payment kept in the bank' '银行预留的一期周供'>>：<<deadwood-reblooms-finance-money _reserve>><br>
					<<if maplebirch.get("VanillaPlus").realEstate.mortgage.canStart(_askingPrice, false, $VanillaPlus.real_estate.mortgage_term)>>
						<<lanLink ['Buy with mortgage', '申请房贷购买'] 'Deadwood Reblooms Property Office'>><<run maplebirch.get("VanillaPlus").realEstate.buyWithMortgage(_property.id, false, $VanillaPlus.real_estate.mortgage_term)>><</lanLink>><br>
					<<elseif maplebirch.get("VanillaPlus").realEstate.mortgage.canStart(_askingPrice, true, $VanillaPlus.real_estate.mortgage_term)>>
						<<lanLink ['Mortgage with credit card advance for down payment', '用信用卡补足首付并申请房贷'] 'Deadwood Reblooms Property Office'>><<run maplebirch.get("VanillaPlus").realEstate.buyWithMortgage(_property.id, true, $VanillaPlus.real_estate.mortgage_term)>><</lanLink>><br>
					<<elseif $VanillaPlus.finance.bank.balance lt _closingFee + _reserve>>
						<span class='red'><<lanSwitch 'The bank balance must cover the fee and one weekly payment.' '银行余额不足以支付手续费并预留一期周供。'>></span><br>
					<<else>>
						<span class='red'><<lanSwitch 'The down payment or available credit is insufficient.' '首付或可用信用额度不足。'>></span><br>
					<</if>>
				<</if>>
			<</if>>
		</div>
	<</capture>>
<</for>>
</div>
<<if $VanillaPlus.real_estate.mortgage>>
	<<set _loan to maplebirch.get("VanillaPlus").realEstate.mortgage.current>>
	<strong><<lanSwitch 'Your mortgage' '你的房贷'>></strong>：<<deadwood-reblooms-finance-money _loan.outstanding>><br>
	<<lanSwitch 'Weekly instalment' '每周应还'>>：<<deadwood-reblooms-finance-money _loan.weekly_payment>> · <<lanSwitch 'Weekly interest' '周利率'>>：<<= (maplebirch.get("VanillaPlus").realEstate.mortgage.terms.weekly_interest_rate * 100).toFixed(2)>>%<br>
	<<lanSwitch 'Next payment on day' '下次还款日'>> <<=_loan.next_payment_day>> · <<lanSwitch 'Final payment on day' '最终还款日'>> <<=_loan.maturity_day>><br>
	<<lanSwitch 'Overdue balance' '逾期金额'>>：<<deadwood-reblooms-finance-money _loan.arrears>> · <<lanSwitch 'Status' '状态'>>：<<switch _loan.stage>><<case 'notice'>><span class='red'><<lanSwitch 'Payment notice' '催缴中'>></span><<case 'frozen'>><span class='red'><<lanSwitch 'Frozen' '已冻结'>></span><<default>><span class='green'><<lanSwitch 'Current' '正常'>></span><</switch>><br>
	<<if _loan.stage is 'notice' && _loan.bailey_pending>>
		<span class='red'><<lanSwitch 'Bailey is waiting outside the financial centre with the bank notice.' '贝利拿着银行的催缴通知，守在金融中心门外。'>></span><br>
		<<lanLink ['Confront Bailey', '与贝利对峙'] 'Deadwood Reblooms Mortgage Bailey'>><</lanLink>><br>
	<</if>>
	<<if _loan.stage is 'frozen'>>
	  <span class='red'><<lanSwitch 'The property is frozen; auction follows in seven days unless the debt is cleared.' '房产已被冻结。若不清偿债务，七天后就会拍卖。'>></span><br>
	<</if>>
	<<if _loan.arrears gt 0>>
	  <<lanLink '补缴逾期款' 'Deadwood Reblooms Property Office'>><<run maplebirch.get("VanillaPlus").realEstate.mortgage.repay('arrears')>><</lanLink>><br>
	<</if>>
	<<if $VanillaPlus.finance.bank.balance gte _loan.outstanding>>
	  <<lanLink ['Pay off mortgage', '还清房贷'] 'Deadwood Reblooms Property Office'>><<run maplebirch.get("VanillaPlus").realEstate.mortgage.repay('all')>><</lanLink>><br>
	<</if>>
<</if>>
<br>
<<deadwood-finance-risk-summary>><br>
<<getouticon>><<lanLink ['Return to the financial centre', '返回金融中心'] 'Deadwood Reblooms Financial Centre'>><</lanLink>>

:: Deadwood Reblooms Property Furnishings []
<<set $outside to 0>><<set $location to 'shopping_centre'>><<effects>>
<<lanSwitch 'Choose the home to which the furniture should be delivered.' '选择要配送家具的住处。'>><br><br>
<<for _property range maplebirch.get("VanillaPlus").realEstate.properties>>
	<<capture _property>>
		<<if maplebirch.get("VanillaPlus").realEstate.owns(_property.id)>>
			<<deadwood-reblooms-property-street-icon _property.id>>
			<<lanLink _property.name.CN 'Deadwood Reblooms Property Furniture Catalogue'>>
				<<set $VanillaPlus.real_estate.furniture_property to _property.id>>
				<<set $VanillaPlus.real_estate.furniture_category to 'bed'>>
			<</lanLink>><br>
		<</if>>
	<</capture>>
<</for>>
<br><<getouticon>><<lanLink '返回家具店' 'Furniture Shop'>><</lanLink>>

:: Deadwood Reblooms Property Furniture Catalogue []
<<set $outside to 0>><<set $location to 'shopping_centre'>><<effects>>
<<set _property to maplebirch.get("VanillaPlus").realEstate.properties.find(item => item.id === $VanillaPlus.real_estate.furniture_property && maplebirch.get("VanillaPlus").realEstate.owns(item.id))>>
<<if !_property>>
	<<lanSwitch 'Choose a home first.' '请先选择住处。'>><br><br>
	<<getouticon>><<lanLink '返回' 'Deadwood Reblooms Property Furnishings'>><</lanLink>>
<<else>>
	<strong class='gold'><<= lanSwitch(_property.name.EN, _property.name.CN)>></strong><br><br>
	<<if maplebirch.get("VanillaPlus").realEstate.managementFor(_property.id).rented or maplebirch.get("VanillaPlus").realEstate.isFrozen(_property.id)>>
		<span class='red'><<lanSwitch 'Furniture cannot be delivered while this home is rented out or frozen.' '房屋出租或冻结期间，无法配送家具。'>></span><br><br>
	<<else>>
		<<lanSwitch 'You browse the furniture catalogue. "No Refunds!" is printed along the top.' '你浏览着家具目录。顶部印着“不退款！”的字样。'>><br><br>
		<hr>
		<div class='settingsHeader'><<lanSwitch 'Furniture' '家具'>></div>
		<div id='furnitureContainer'>
			<<dynamic 'deadwood-reblooms-property-furniture-links' 'furnitureContainerHeader'>>
			<<dynamic 'deadwood-reblooms-property-furniture-list' 'furniture-menu-container'>>
		</div>
	<</if>>
	<br><br><<getouticon>><<lanLink '返回住处列表' 'Deadwood Reblooms Property Furnishings'>><</lanLink>>
<</if>>

:: Deadwood Reblooms Property Furniture Links [widget]
<<widget 'deadwood-reblooms-property-furniture-links'>>
	<<set _categories to [
		{ id: 'bed', EN: 'Bed', CN: '床' },
		{ id: 'table', EN: 'Table', CN: '茶几' },
		{ id: 'chair', EN: 'Chairs', CN: '椅子' },
		{ id: 'desk', EN: 'Desks', CN: '书桌' },
		{ id: 'wardrobe', EN: 'Wardrobe', CN: '衣橱' },
		{ id: 'decoration', EN: 'Decorations', CN: '饰品' },
		{ id: 'windowsill', EN: 'Miscellaneous', CN: '杂项' },
		{ id: 'poster', EN: 'Posters', CN: '海报' },
		{ id: 'wallpaper', EN: 'Wallpaper', CN: '壁纸' }
	]>>
	<<run _categories.forEach(item => item.label = lanSwitch(item.EN, item.CN))>>
	<<for _category range _categories>>
		<<capture _category>>
			<div @class="$VanillaPlus.real_estate.furniture_category is _category.id ? 'shopTabSelected' : 'shopTab'">
				<button
					@class="($VanillaPlus.real_estate.furniture_category is _category.id ? 'selected' : '')"
					@id="Dynamic.eventBinder(_category.id)"
					onclick="(id) => $VanillaPlus.real_estate.furniture_category = id"
				>_category.label
				</button>
			</div>
		<</capture>>
	<</for>>
<</widget>>

:: Deadwood Reblooms Property Furniture List [widget]
<<widget 'deadwood-reblooms-property-furniture-list'>>
<<set _property to maplebirch.get("VanillaPlus").realEstate.properties.find(item => item.id === $VanillaPlus.real_estate.furniture_property && maplebirch.get("VanillaPlus").realEstate.owns(item.id))>>
	<<set _current to maplebirch.get("VanillaPlus").realEstate.furniture(_property.id, $VanillaPlus.real_estate.furniture_category)>>
	<<if ['poster', 'wallpaper'].includes($VanillaPlus.real_estate.furniture_category)>>
		<<lanSwitch 'You browse the samples of pre-made designs. A custom design costs twice as much.' '你翻看着预制图案的样品。支付双倍价格，可以定制图案。'>><br><br>
	<</if>>
	<<lanSwitch 'Currently installed in this home:' '这处住处当前布置的是：'>>
	<<if _current>>
		<<furnitureicon _current.iconFile>> <<= _current.nameCap>><br>
		<<if _current.description>>
			<span class='description'><<= _current.description>>
				<<if $VanillaPlus.real_estate.furniture_category is 'wardrobe' and _current.type.includes('organiser')>>
				  <<lanSwitch 'Can hold 40 of each item type.' '每种物品类别可容纳 40 个。'>>
				<</if>>
				<<if $VanillaPlus.real_estate.furniture_category is 'wardrobe' and _current.type.includes('spacious')>>
				  <<lanSwitch 'Can hold 30 of each item type.' '每种物品类别可容纳 30 个。'>>
				<</if>>
				<<if $VanillaPlus.real_estate.furniture_category is 'wardrobe' and _current.type.includes('starter')>>
				  <<lanSwitch 'Can hold 20 of each item type.' '每种物品类别可容纳 20 个。'>>
				<</if>>
				<<if _current.type.includes('comfy')>>
				  <<if $VanillaPlus.real_estate.furniture_category is 'bed'>>
				    <<lanSwitch 'Improves sleep quality.' '提高睡眠质量。'>>
				  <<else>>
				    <<lanSwitch 'Makes working at your desk more effective.' '提高你在书桌前学习的效率。'>>
				  <</if>>
				<</if>>
				<<if _current.type.includes('double')>>
				  <<lanSwitch 'Has enough space for a proper sleepover.' '有足够的空间容纳两个人过夜。'>>
				<</if>>
			</span>
		<</if>>
	<<else>>
		<<lanSwitch 'Nothing.' '暂无。'>>
	<</if>>
	<hr>
	<div id='furnitureContainer'>
		<<set _offers to maplebirch.get("VanillaPlus").realEstate.furnitureOffers(_property.id, $VanillaPlus.real_estate.furniture_category)>>
		<<for _offer range _offers>>
			<<capture _offer>>
				<<set _priceLabel to '£' + _offer.cost / 100>>
				<div class='shopBlock no-numberify'>
					<<furnitureicon _offer.item.iconFile>> <<= _offer.item.nameCap>> |
					<<if _offer.id is 'custom'>>
					  <<textbox '_customHanging' ''>> |
					<</if>>
					<<if _offer.item.type.includes('comfy')>>
					  <<lanSwitch 'Comfortable' '舒适'>> |
					<</if>>
					<<if _offer.item.type.includes('single')>>
					  <<lanSwitch 'Single' '单人'>> |
					<</if>>
					<<if _offer.item.type.includes('double')>>
					  <<lanSwitch 'Double' '双人'>> |
					<</if>>
					<<if _offer.item.type.includes('spacious')>>
					  <<lanSwitch 'Spacious' '宽敞'>> |
					<</if>>
					<<if _offer.item.type.includes('organiser')>>
					  <<lanSwitch 'Organiser' '收纳'>> |
					<</if>>
					<<if _offer.item.description>>
						<mouse class='tooltip linkBlue'>(?)<span><<= _offer.item.description>>
							<<if _offer.item.type.includes('comfy')>>
							  <br>
							  <<if $VanillaPlus.real_estate.furniture_category is 'bed'>>
							    <<lanSwitch 'Improves sleep quality.' '提高睡眠质量。'>>
							  <<else>>
							    <<lanSwitch 'Makes working at your desk more effective.' '提高你在书桌前学习的效率。'>>
							  <</if>>
							<</if>>
							<<if _offer.item.type.includes('double')>>
							  <br><<lanSwitch 'Has enough space for a proper sleepover.' '有足够的空间容纳两个人过夜。'>>
							<</if>>
							<<if _offer.item.type.includes('spacious')>>
							  <br><<lanSwitch 'Can hold 30 of each item type.' '每种物品类别可容纳 30 个。'>>
							<</if>>
							<<if _offer.item.type.includes('organiser')>>
							  <br><<lanSwitch 'Can hold 40 of each item type.' '每种物品类别可容纳 40 个。'>>
							<</if>>
						</span></mouse> |
					<</if>>
					<<if maplebirch.get("VanillaPlus").finance.canPay(_offer.cost, 'furniture')>>
						<<link _priceLabel 'Deadwood Reblooms Property Furniture Catalogue'>>
							<<if maplebirch.get("VanillaPlus").realEstate.installFurniture(_property.id, $VanillaPlus.real_estate.furniture_category, _offer.id, _offer.id is 'custom' ? _customHanging : undefined)>>
								<<money `-_offer.cost` 'furniture'>>
								<<run Furniture.log(['poster', 'wallpaper'].includes($VanillaPlus.real_estate.furniture_category) ? $VanillaPlus.real_estate.furniture_category : _offer.id)>>
							<</if>>
						<</link>>
					<<else>>
						<span class='red'><<= _priceLabel>></span>
					<</if>>
				</div>
			<</capture>>
		<</for>>
	</div>
<</widget>>

:: Deadwood Reblooms Property Home []
<<set _property to maplebirch.get("VanillaPlus").realEstate.current>>
<<if !_property || !maplebirch.get("VanillaPlus").realEstate.owns(_property.id) || maplebirch.get("VanillaPlus").realEstate.managementFor(_property.id).rented>>
	<<lanLink '返回商业街' 'High Street'>><</lanLink>>
<<elseif maplebirch.get("VanillaPlus").realEstate.mortgage.baileyAtDoor(_property.id)>>
	<<run maplebirch.get("VanillaPlus").realEstate.enter()>><<effects>>
	<<language>>
		<<option 'EN'>>Bailey waits on your doorstep with a bank notice in hand. "Your mortgage is overdue. <span class='red'>Pay what you owe, or I'll see this place taken from you.</span>"
		<<option 'CN'>>贝利拿着银行的催缴通知，堵在你家门前。“房贷逾期了。<span class='red'>把欠款交出来，不然我就看着他们收走这房子。</span>”
	<</language>><br><br>
	<<lanLink ['Speak to Bailey', '与贝利交涉'] 'Deadwood Reblooms Mortgage Bailey'>><</lanLink>><br>
<<else>>
	<<run maplebirch.get("VanillaPlus").realEstate.setFloor(1)>><<run maplebirch.get("VanillaPlus").realEstate.enter()>><<home_effects>><<effects>>
	<<= lanSwitch(_property.floors[0].description.EN, _property.floors[0].description.CN)>><br><br>
	<<if maplebirch.get("VanillaPlus").realEstate.managementFor(_property.id).renovation gt 0>>
		<<= lanSwitch(_property.interior.renovated.EN, _property.interior.renovated.CN)>><br><br>
	<</if>>
	<<if maplebirch.get("VanillaPlus").realEstate.isFrozen(_property.id)>>
	  <span class='red'><<lanSwitch 'The bank has frozen this property.' '银行已经冻结这处房产。'>></span><br>
	<</if>>
	<span class='green'><<lanSwitch 'This is one of your homes.' '这里也是你的住所。'>></span><br><br>
	<<for _resident range maplebirch.get("VanillaPlus").realEstate.residentsInCommonRooms(_property.id)>>
		<<capture _resident>>
			<<npc _resident.id>><<person1>>
			<<= lanSwitch(_resident.evening.EN, _resident.evening.CN)>><br><br>
			<<switch _resident.id>>
				<<case 'Robin'>>
					<<if C.npc.Robin.trauma gte 20>>
						<<language>>
							<<option 'EN'>>Robin keeps the hall lamp on and <span class='red'>glances at the door</span> whenever a sound carries in from the street.
							<<option 'CN'>>罗宾留着门厅的灯。街上传来一点动静，便<span class='red'>朝门口望去</span>。
						<</language>>
					<<else>>
						<<language>>
							<<option 'EN'>>Robin pours you a cup of tea. "<span class='teal'>We can worry about the orphanage tomorrow</span>," <<he>> says.
							<<option 'CN'>>罗宾给你倒了杯茶。“<span class='teal'>孤儿院的事，明天再操心吧。</span>”<<he>>说。
						<</language>>
					<</if>><br><br>
				<<case 'Whitney'>>
					<<if C.npc.Whitney.dom gte 10>>
						<<language>>
							<<option 'EN'>>Whitney has taken the best chair. "What?" <<He>> <span class='teal'>moves over</span> when you come closer.
							<<option 'CN'>>惠特尼占了最舒服的椅子。“干嘛？”你走近时，<<he>>还是<span class='teal'>挪出一块地方</span>。
						<</language>>
					<<else>>
						<<language>>
							<<option 'EN'>>Whitney looks up when you come in. "You're late," <<he>> mutters, shifting aside and nodding at the empty coat hook beside the door.
							<<option 'CN'>>你进门时，惠特尼抬头看了你一眼。“回来晚了。”<<he>>小声说着，侧身让开，朝门边空着的衣帽钩点了点头。
						<</language>>
					<</if>><br><br>
				<<case 'Kylar'>>
					<<if C.npc.Kylar.love gte 60>>
						<<language>>
							<<option 'EN'>>Kylar looks up from the window when you come in. "<span class='teal'>There you are.</span>" <<He>> hurries over to meet you.
							<<option 'CN'>>你一进门，凯拉尔便从窗边抬起头。“<span class='teal'>你回来啦。</span>”<<He>>连忙迎上来。
						<</language>>
					<<else>>
						<<language>>
							<<option 'EN'>>Kylar sits near the door, turning the spare key over in <<his>> hands. <<He>> <span class='teal'>lets out a breath</span> when <<he>> sees you.
							<<option 'CN'>>凯拉尔坐在门边，攥着备用钥匙翻来覆去。见你进来，<<he>>才<span class='teal'>松了口气</span>。
						<</language>>
					<</if>><br><br>
				<<case 'Sydney'>>
					<<run statusCheck('Sydney')>>
					<<if _sydneyStatus.includes('corrupt')>>
						<<language>>
							<<option 'EN'>>Sydney puts the temple robes aside and draws you close by the wrist. "<span class='lewd'>Come sit here.</span>"
							<<option 'CN'>>悉尼把神殿长袍搁到一旁，握住你的手腕拉你靠近。“<span class='lewd'>过来坐。</span>”
						<</language>>
					<<else>>
						<<language>>
							<<option 'EN'>>Sydney folds the temple robes before sitting beside you. "<span class='teal'>It's good to be home</span>," <<he>> says quietly.
							<<option 'CN'>>悉尼叠好神殿长袍，在你身边坐下。“<span class='teal'>回到家真好。</span>”<<he>>轻声说。
						<</language>>
					<</if>><br><br>
			<</switch>>
			<<lanLink '一起待一会儿 (0:20)' 'Deadwood Reblooms Property Evening Together'>>
				<<run maplebirch.get("VanillaPlus").realEstate.meetResident(_resident.id, _property.id)>>
				<<pass 20>>
			<</lanLink>><br><br>
		<</capture>>
	<</for>>
	<<if maplebirch.get("VanillaPlus").realEstate.residentsHome(_property.id).length is 2>>
		<<socialiseicon>><<link `lanSwitch('Invite both lovers to talk (0:20)', '请两位恋人一起聊聊 (0:20)')` 'Deadwood Reblooms Property Household'>><<pass 20>><</link>><br><br>
	<</if>>
	<<if !_property.rooms.retreat>>
		<<couchicon>><<lanLink ['Rest in the sitting room (0:20)', '在起居室休息 (0:20)'] 'Deadwood Reblooms Property Sitting Rest'>><<pass 20>><<tiredness -4>><</lanLink>><<ltiredness>><br>
	<</if>>
	<<deadwood-blackjack-home-entry 'Deadwood Reblooms Property Home'>>
	<<deadwood-reblooms-property-floor-rooms 1>>
	<<if _property.floors.length gt 1>>
		<<stairsicon 'up'>><<lanLink '上楼 (0:01)' 'Deadwood Reblooms Property Landing'>><<run maplebirch.get("VanillaPlus").realEstate.setFloor(2)>><<pass 1>><</lanLink>><br>
	<</if>>
	<br>
	<<deadwood-reblooms-property-street-icon _property.id>><<lanLink '离开' _property.street>><<pass 2>><</lanLink>>
<</if>>

:: Deadwood Reblooms Property Sitting Rest []
<<set _property to maplebirch.get("VanillaPlus").realEstate.current>>
<<if !_property || !_property.interior.sitting_rest || !maplebirch.get("VanillaPlus").realEstate.owns(_property.id) || maplebirch.get("VanillaPlus").realEstate.managementFor(_property.id).rented>>
	<<lanLink '返回商业街' 'High Street'>><</lanLink>>
<<else>>
	<<run maplebirch.get("VanillaPlus").realEstate.enter()>><<effects>>
	<<= lanSwitch(_property.interior.sitting_rest.EN, _property.interior.sitting_rest.CN)>><br><br>
	<<getouticon>><<lanLink '返回起居室' 'Deadwood Reblooms Property Home'>><</lanLink>>
<</if>>


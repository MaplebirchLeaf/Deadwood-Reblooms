:: Deadwood Reblooms Property Evening Together []
<<set _property to maplebirch.get("VanillaPlus").realEstate.current>>
<<set _companion to maplebirch.get("VanillaPlus").realEstate.currentCompanion>>
<<if !_property || !_companion>>
	<<lanLink '返回起居室' 'Deadwood Reblooms Property Home'>><</lanLink>>
<<else>>
	<<run maplebirch.get("VanillaPlus").realEstate.enter()>><<effects>>
	<<npc _companion.id>><<person1>>
	<<if maplebirch.get("VanillaPlus").realEstate.residentsAt(_property.id).length gt 1>>
		<<lanSwitch 'You find a quiet place to talk. The other resident’s room stays undisturbed.' '你们找了一处安静的地方说话，没有去打扰另一位住户的房间。'>><br><br>
	<</if>>
	<<= lanSwitch(_companion.together.EN, _companion.together.CN)>><br><br>
	<<switch _companion.id>>
		<<case 'Robin'>>
			<<if C.npc.Robin.trauma gte 20>>
				<<language>>
					<<option 'EN'>>Robin's hand <span class='red'>trembles around the cup</span>. You sit beside <<him>> until <<he>> puts it down and begins telling you about the orphanage.
					<<option 'CN'>>罗宾捧着杯子的手<span class='red'>微微发抖</span>。你在<<him>>身旁坐了一会儿，直到<<he>>放下杯子，说起孤儿院的事。
				<</language>>
			<<else>>
				<<language>>
					<<option 'EN'>>Robin lists tomorrow's chores. When you offer to take the earliest one, <<he>> laughs and <span class='teal'>rests <<his>> head on your shoulder</span>.
					<<option 'CN'>>罗宾数着明天要做的杂事。你主动揽下最早的一项，<<he>>笑着<span class='teal'>把头靠在你肩上</span>。
				<</language>>
			<</if>>
			<<if maplebirch.get('Robin') and $RobinExpansion.shop and C.npc.Robin.trauma lt 20>>
				<br><br>
				<<language>>
					<<option 'EN'>>Robin sets a paper bag from the shop on the table. "I saved the last one for you." <<He>> waits while you try it, watching your face more closely than the food.
					<<option 'CN'>>罗宾把从店里带回的纸袋放在桌上。“最后一份给你留着。”<<He>>等你尝了一口，看你的脸比看食物还仔细。
				<</language>>
			<</if>><br><br>
		<<case 'Whitney'>>
			<<if C.npc.Whitney.dom gte 10>>
				<<language>>
					<<option 'EN'>>Whitney makes fun of your furniture. "You could do better." <<He>> pulls you into the chair anyway, <span class='lewd'>keeping an arm around your waist</span>.
					<<option 'CN'>>惠特尼拿你的家具打趣。“你还能挑得更好点。”<<He>>却把你拉进椅子里，<span class='lewd'>胳膊搭在你的腰上</span>。
				<</language>>
			<<else>>
				<<language>>
					<<option 'EN'>>Whitney complains about school while you sit together, keeping half a cushion between you. <<He>> does not look at you while <<he>> talks, and does not leave either.
					<<option 'CN'>>惠特尼挨着你抱怨学校的事，中间却隔着半个坐垫。<<he>>说话时不看你，但也没有走开。
				<</language>>
			<</if>>
			<<if maplebirch.get('Whitney') and $WhitneyExpansion.rescued>>
				<br><br>
				<<language>>
					<<option 'EN'>>A noise outside makes Whitney look toward the door. <<He>> sees that you have noticed, then <span class='teal'>pulls you closer</span> without a word.
					<<option 'CN'>>门外有些动静，惠特尼转头看去。<<He>>发觉你注意到了，便一言不发地<span class='teal'>把你拉近</span>。
				<</language>>
			<</if>><br><br>
		<<case 'Kylar'>>
			<<if C.npc.Kylar.love gte 60>>
				<<language>>
					<<option 'EN'>>Kylar shows you the spare key. "I kept it safe." When you say <<he>> can keep it, <<he>> <span class='teal'>presses it against <<his>> chest</span>.
					<<option 'CN'>>凯拉尔把备用钥匙拿给你看。“我保管得好好的。”你说<<he>>可以留着，<<he>>便<span class='teal'>把钥匙贴在胸前</span>。
				<</language>>
			<<else>>
				<<language>>
					<<option 'EN'>>"I can stay, can't I?" Kylar asks, holding your sleeve. You tell <<him>> yes. <<He>> <span class='green'>smiles and lets go</span>.
					<<option 'CN'>>“我能留下来，对吧？”凯拉尔攥着你的衣袖问。你答应了，<<he>>才<span class='green'>松开手笑起来</span>。
				<</language>>
			<</if>>
			<<if maplebirch.get('Kylar') and $KylarExpansion.stay_invited>>
				<br><br>
				<<language>>
					<<option 'EN'>>Kylar lays <<his>> manor key beside the key to this house. <<He>> picks up the second one before you can say anything and <span class='teal'>holds it tightly</span>.
					<<option 'CN'>>凯拉尔把庄园的钥匙放在这间房的钥匙旁。你还没开口，<<he>>便拿起后者，<span class='teal'>紧紧攥在手里</span>。
				<</language>>
			<</if>><br><br>
		<<case 'Sydney'>>
			<<run statusCheck('Sydney')>>
			<<if _sydneyStatus.includes('corruptLust')>>
				<<language>>
					<<option 'EN'>>Sydney tells you about an errand at the temple, then leans close. "<span class='lewd'>I've been thinking about you all day.</span>" <<His>> fingers brush your wrist.
					<<option 'CN'>>悉尼说起神殿里的差事，又靠近你。“<span class='lewd'>我一整天都在想你。</span>”<<His>>手指轻轻擦过你的手腕。
				<</language>>
			<<else>>
				<<language>>
					<<option 'EN'>>Sydney tells you about someone <<he>> helped at the temple. You tell <<him>> about your day. <<He>> listens, <span class='teal'>still holding your hand</span>.
					<<option 'CN'>>悉尼说起今天在神殿帮过的人。你也讲了自己的一天，<<he>><span class='teal'>一直握着你的手听</span>。
				<</language>>
			<</if>>
			<<if maplebirch.get('Sydney') and $SydneyExpansion.estate.visited>>
				<br><br>
				<<language>>
					<<option 'EN'>>Sydney unfolds a recipe <<nnpc_Mum 'Sirris'>> wrote out at the estate. "We could make this here," <<he>> says, looking toward the kitchen.
					<<option 'CN'>>悉尼摊开一张从庄园带来的食谱，上面是<<nnpc_Mum 'Sirris'>>的字迹。“我们可以在这里试试。”<<he>>望向厨房。
				<</language>>
			<</if>><br><br>
	<</switch>>
	<!-- 这段对白可重看，陪伴带来的压力收益每人每处住所每天只结算一次。 -->
	<<if maplebirch.get("VanillaPlus").realEstate.residentsHome(_property.id).some(profile => profile.id === _companion.id)>>
		<<earnFeat 'Leave a Light On'>>
	<</if>>
	<<set _eveningKey to _property.id + ':' + _companion.id>>
	<<if !$VanillaPlus.real_estate.daily_evening.includes(_eveningKey)>>
		<<set $VanillaPlus.real_estate.daily_evening.push(_eveningKey)>>
		<<stress -2>><<lstress>><br>
	<</if>>
	<<if maplebirch.get("VanillaPlus").realEstate.canIntimate(_companion.id, _property.id)>>
		<<loveicon 'kiss'>>
		<<lanLink ['Go to the bedroom for intimacy with your lover', '与恋人回卧室亲密'] 'Deadwood Reblooms Property Intimacy'>>
			<<set $sexstart to 1>>
		<</lanLink>><<promiscuous1>><<kissvirginitywarning>><<NPCvirginitywarning _companion.id 'kiss'>><br>
	<</if>>
	<br>
	<<lanLink '返回起居室' 'Deadwood Reblooms Property Home'>><</lanLink>>
<</if>>

:: Deadwood Reblooms Property Landing []
<<set _property to maplebirch.get("VanillaPlus").realEstate.current>>
<<set _floor to maplebirch.get("VanillaPlus").realEstate.currentFloor>>
<<if !_property || !maplebirch.get("VanillaPlus").realEstate.owns(_property.id) || maplebirch.get("VanillaPlus").realEstate.managementFor(_property.id).rented || _floor lte 1 || _floor gt _property.floors.length>>
	<<lanLink '返回起居室' 'Deadwood Reblooms Property Home'>><</lanLink>>
<<else>>
	<<run maplebirch.get("VanillaPlus").realEstate.enter()>><<effects>>
	<strong><<= lanSwitch(_property.floors[_floor - 1].name.EN, _property.floors[_floor - 1].name.CN)>></strong><br>
	<<= lanSwitch(_property.floors[_floor - 1].description.EN, _property.floors[_floor - 1].description.CN)>><br><br>
	<<deadwood-reblooms-property-floor-rooms _floor>>
	<br>
	<<if _floor lt _property.floors.length>>
		<<stairsicon 'up'>><<lanLink '上楼 (0:01)' 'Deadwood Reblooms Property Landing'>><<run maplebirch.get("VanillaPlus").realEstate.setFloor(maplebirch.get("VanillaPlus").realEstate.currentFloor + 1)>><<pass 1>><</lanLink>><br>
	<</if>>
	<<if _floor is 2>>
		<<stairsicon 'down'>><<lanLink '下楼 (0:01)' 'Deadwood Reblooms Property Home'>><<run maplebirch.get("VanillaPlus").realEstate.setFloor(1)>><<pass 1>><</lanLink>>
	<<else>>
		<<stairsicon 'down'>><<lanLink '下楼 (0:01)' 'Deadwood Reblooms Property Landing'>><<run maplebirch.get("VanillaPlus").realEstate.setFloor(maplebirch.get("VanillaPlus").realEstate.currentFloor - 1)>><<pass 1>><</lanLink>>
	<</if>>
<</if>>

:: Deadwood Reblooms Mortgage Bailey []
<<set _loan to $VanillaPlus.real_estate.mortgage>>
<<if !_loan || _loan.stage isnot 'notice' || !_loan.bailey_pending>>
	<<lanLink '返回房产中介' 'Deadwood Reblooms Property Office'>><</lanLink>>
<<else>>
	<<effects>><<npc Bailey>>
	<<language>>
		<<option 'EN'>>Bailey taps the notice against the doorframe. "I'll give you a chance to settle the arrears. <span class='red'>Make me drag you out and the bank will freeze the deed.</span>"
		<<option 'CN'>>贝利用催缴单拍了拍门框。“给你一个补缴的机会。<span class='red'>非要我动手赶人，银行就会冻结房契。</span>”
	<</language>><br><br>
	<<if $VanillaPlus.finance.bank.balance gte $VanillaPlus.real_estate.mortgage.arrears>>
		<<lanLink '补缴逾期款' 'Deadwood Reblooms Property Office'>><<run maplebirch.get("VanillaPlus").realEstate.mortgage.repay('arrears')>><</lanLink>><br>
	<</if>>
	<<lanLink '反抗贝利' 'Deadwood Reblooms Mortgage Fight'>><<set $fightstart to 1>><</lanLink>><br>
	<<lanLink ['Refuse to pay', '拒绝缴款'] 'Deadwood Reblooms Property Office'>><<run maplebirch.get("VanillaPlus").realEstate.mortgage.refuseBailey()>><</lanLink>><br>
<</if>>

:: Deadwood Reblooms Mortgage Fight []
<<if $fightstart is 1>>
	<<set $fightstart to 0>><<neutral 1>><<maninit>><<set $enemyanger += 200>><<npcidlegenitals>>
	<<language>>
		<<option 'EN'>>"<span class='red'>Then I'll take the deed myself</span>," Bailey snarls.
		<<option 'CN'>>“<span class='red'>那我就亲手把房契拿走。</span>”贝利怒吼道。
	<</language>>
	<br><br>
<</if>>
<<effects>><<effectsman>><<man>><<stateman>>
<br><br>
<<actionsman>>
<<if _combatend or ($pain gte 100 and $willpowerpain is 0)>>
	<span id='next'><<lanLink '继续' 'Deadwood Reblooms Mortgage Fight Finish'>><</lanLink>></span><<nexttext>>
<<else>>
	<span id='next'><<lanLink '继续' 'Deadwood Reblooms Mortgage Fight'>><</lanLink>></span><<nexttext>>
<</if>>

:: Deadwood Reblooms Mortgage Fight Finish []
<<effects>>
<<if $enemyarousal gte $enemyarousalmax or $enemyhealth lte 0>>
	<<run maplebirch.get("VanillaPlus").realEstate.mortgage.fightBailey(true)>>
	<<language>>
		<<option 'EN'>>
			Bailey retreats, furious. <span class='teal'>You have seven more days to clear the arrears</span> before the bank freezes the property.
		<<option 'CN'>>
			贝利愤愤退走。<span class='teal'>你又争取到七天补缴欠款</span>，否则银行就会冻结房产。
		<</language>>
<<else>>
	<<run maplebirch.get("VanillaPlus").realEstate.mortgage.fightBailey(false)>>
	<<language>>
		<<option 'EN'>>Bailey pins you down and takes the notice to the bank. <span class='red'>Your property is frozen.</span>
		<<option 'CN'>>贝利制服了你，拿着催缴通知回了银行。<span class='red'>你的房产已被冻结。</span>
	<</language>>
<</if>>
<<endcombat>><br><br>
<<lanLink '继续' 'Deadwood Reblooms Property Office'>><</lanLink>>

:: Deadwood Reblooms Property Bed []
<<set _bedProperty to maplebirch.get("VanillaPlus").realEstate.current>>
<<if !_bedProperty || !maplebirch.get("VanillaPlus").realEstate.owns(_bedProperty.id) || maplebirch.get("VanillaPlus").realEstate.managementFor(_bedProperty.id).rented>>
	<<lanLink '返回房产中介' 'Deadwood Reblooms Property Office'>><</lanLink>>
<<else>>
	<<run maplebirch.get("VanillaPlus").realEstate.enter()>><<effects>><<wearoutfit>>
	<<lanSwitch 'You settle beneath your own sheets.' '你躺进属于自己的被褥里。'>><br><br>
	<<unset $bedGuest>>
	<<if maplebirch.get("VanillaPlus").realEstate.canShareBed(_bedProperty.id) && maplebirch.get("VanillaPlus").realEstate.residentsInBedroom(_bedProperty.id).length gt 0>>
		<<set _bedCompanion to maplebirch.get("VanillaPlus").realEstate.residentsInBedroom(_bedProperty.id)[0]>>
		<<set $bedGuest to _bedCompanion.id>>
		<<run maplebirch.get("VanillaPlus").realEstate.meetResident(_bedCompanion.id, _bedProperty.id)>>
		<<npc _bedCompanion.id>><<person1>>
		<<switch _bedCompanion.id>>
			<<case 'Robin'>>
				<<if C.npc.Robin.trauma gte 20>>
					<<language>>
						<<option 'EN'>>"Can we leave the lamp on?" Robin asks. You do, and <<he>> settles beside you.
						<<option 'CN'>>“能留着灯吗？”罗宾问。你点亮床边的灯，<<he>>在你身旁躺下。
					<</language>>
				<<else>>
					<<language>>
						<<option 'EN'>>Robin slips under the covers and takes your hand. <<He>> closes <<his>> eyes with a smile.
						<<option 'CN'>>罗宾钻进被窝，握住你的手，笑着闭上眼睛。
					<</language>>
				<</if>>
			<<case 'Whitney'>>
				<<language>>
					<<option 'EN'>>"You're taking up the whole bed," Whitney mutters. <<He>> pulls you closer anyway.
					<<option 'CN'>>“你把整张床都占了。”惠特尼嘟囔着，却把你拉得更近。
				<</language>>
			<<case 'Kylar'>>
				<<language>>
					<<option 'EN'>>"Are you comfortable?" Kylar asks. When you nod, <<he>> curls up beside you.
					<<option 'CN'>>“你睡得舒服吗？”凯拉尔问。你点点头，<<he>>便蜷在你身旁。
				<</language>>
			<<case 'Sydney'>>
				<<language>>
					<<option 'EN'>>Sydney sets <<his>> temple pendant on the bedside table and lies down beside you.
					<<option 'CN'>>悉尼把神殿吊坠放在床边，在你身旁躺下。
				<</language>>
		<</switch>><br><br>
	<</if>>
	<<generateSleepLinks 'Deadwood Reblooms Property Sleep'>>
	<<lanLink '起床' 'Deadwood Reblooms Property Bedroom'>><<deadwood-reblooms-property-clothes-on>><</lanLink>>
<</if>>

:: Deadwood Reblooms Property Sleep []
<<set _sleepProperty to maplebirch.get("VanillaPlus").realEstate.current>>
<<if !_sleepProperty || !maplebirch.get("VanillaPlus").realEstate.owns(_sleepProperty.id) || maplebirch.get("VanillaPlus").realEstate.managementFor(_sleepProperty.id).rented>>
	<<lanLink '返回房产中介' 'Deadwood Reblooms Property Office'>><</lanLink>>
<<else>>
	<<set _autosavehere to true>>
	<<run maplebirch.get("VanillaPlus").realEstate.enter()>>
	<<set _sleepPartner to maplebirch.get("VanillaPlus").realEstate.currentCompanion>>
	<<if _sleepPartner
		and maplebirch.get("VanillaPlus").realEstate.residentsHome(_sleepProperty.id).some(resident => resident.id === _sleepPartner.id)>>
		<<set $bedGuest to _sleepPartner.id>>
	<</if>>
	<!-- 原版按小时睡眠。这里预先选出一个较早的醒来小时，不改动原版 sleephour。 -->
	<<set _requestedHours to $sleephour>>
	<<set _nightWake to _sleepPartner
		and maplebirch.get("VanillaPlus").realEstate.residentsHome(_sleepProperty.id).some(resident => resident.id === _sleepPartner.id)
		and _requestedHours gte 3
		and (Time.hour gte 23 or Time.hour lt 3)
		and !$VanillaPlus.real_estate.daily_night_wake
		and $nightmares lte 0
		and random(1, 8) is 1>>
	<<if _nightWake>>
		<<set $sleephour to random(1, Math.min(2, _requestedHours - 1))>>
	<</if>>
	<<sleep>>
	<!-- 原版只在 $location 为 home 时读取孤儿院的床，自购房在此补上同等的每小时床铺收益。 -->
	<<set _sleepBed to maplebirch.get("VanillaPlus").realEstate.furniture(_sleepProperty.id, 'bed')>>
	<<if _sleepBed and _sleepBed.type.includes('comfy')>>
		<<set $tiredness to Math.max(0, $tiredness - 10 * $sleepHoursTotal)>>
	<<elseif _sleepBed and _sleepBed.type.includes('starter')>>
		<<set $tiredness += 10 * $sleepHoursTotal>>
	<</if>>
	<<if !_dreaming>>
		<<effects>><<wakingEffects $sleepHoursTotal>>
		<<set _nightWake to _nightWake
			and !_wakingEffect
			and $sleepHoursTotal gte 1
			and (Time.hour gte 23 or Time.hour lt 6)
			and maplebirch.get("VanillaPlus").realEstate.residentsHome(_sleepProperty.id).some(resident => resident.id === _sleepPartner.id)>>
		<<sleepeffects>>
		<<if $nightmares gte 1 and $controlled is 0>>
			<<nightmareWake>>
		<</if>>
		<<if _nightWake and !($nightmares gte 1 and $controlled is 0)>>
			<<set $VanillaPlus.real_estate.daily_night_wake to true>>
			<<set $sleephour to Math.max(1, _requestedHours - $sleepHoursTotal)>>
			<<lanSwitch 'Something shifts beside you in the dark. You wake before the night is over.' '黑暗中，身旁的人动了动。夜还没过去，你已经醒了。'>>
			<br><br>
			<<bedicon>><<lanLink '睁开眼' 'Deadwood Reblooms Property Night Wake'>><</lanLink>>
		<<else>>
			<<if !_wakingEffect and !($nightmares gte 1 and $controlled is 0)>>
			  <<lanSwitch 'You wake in your own bed.' '你在自己的床上醒来。'>>
			<</if>>
			<<if !_wakingEffect and Time.schoolDay and Time.hour gte 6 and Time.hour lt 9
				and (!$LifeSimulation?.school or ($LifeSimulation.school.role is 'student' and !$LifeSimulation.school.attendanceExempt))>>
				<br><br><<schoolicon 'building'>><span class='teal'><<lanSwitch 'Today is a school day. Remember your uniform and books before heading out.' '今天有课。出门前记得换好校服，带上课本。'>></span>
			<</if>>
			<<set _wakingCompanion to maplebirch.get("VanillaPlus").realEstate.currentCompanion>>
			<<if _wakingCompanion>>
				<br><br>
				<<if maplebirch.get("VanillaPlus").realEstate.residentsHome(_sleepProperty.id).some(resident => resident.id === _wakingCompanion.id)>>
					<<switch _wakingCompanion.id>>
						<<case 'Robin'>>
							<<lanSwitch 'Robin is still beside you, one hand curled around yours.' '罗宾仍睡在你身边，一只手还握着你的手。'>>
						<<case 'Whitney'>>
							<<lanSwitch 'Whitney is still asleep, an arm draped over you.' '惠特尼还睡着，一只胳膊搭在你身上。'>>
						<<case 'Kylar'>>
							<<lanSwitch 'Kylar shifts closer in their sleep when you stir.' '你一动，凯拉尔就在睡梦中往你身边靠了靠。'>>
						<<case 'Sydney'>>
							<<lanSwitch 'Sydney is still beside you. The temple pendant rests on the bedside table.' '悉尼仍在你身旁。神殿吊坠还放在床头。'>>
					<</switch>>
				<<else>>
					<<switch _wakingCompanion.id>>
						<<case 'Robin'>>
							<<lanSwitch 'Robin has gone out. The spare blanket is folded at the foot of the bed.' '罗宾已经出门了，备用毯子叠在床尾。'>>
						<<case 'Whitney'>>
							<<lanSwitch 'Whitney has gone out. The second pillow is still pressed against yours.' '惠特尼出门了，第二只枕头还挨着你的枕头。'>>
						<<case 'Kylar'>>
							<<lanSwitch 'Kylar has gone out. Their side of the bed is still warm.' '凯拉尔出门了，那侧被窝里还留着一点暖意。'>>
						<<case 'Sydney'>>
							<<lanSwitch 'Sydney has left for the temple. The pendant is gone from the bedside table.' '悉尼去神殿了，床头的吊坠也不见了。'>>
					<</switch>>
				<</if>>
			<</if>>
			<br><br>
			<<lanLink '起床' 'Deadwood Reblooms Property Bedroom'>><<deadwood-reblooms-property-clothes-on>><</lanLink>><br>
			<<lanLink '继续睡觉' 'Deadwood Reblooms Property Bed'>><</lanLink>>
	<</if>>
	<</if>>
<</if>>

:: Deadwood Reblooms Property Wardrobe [exitCheckBypass]
<<set _wardrobeProperty to maplebirch.get("VanillaPlus").realEstate.current>>
<<if !_wardrobeProperty || !maplebirch.get("VanillaPlus").realEstate.owns(_wardrobeProperty.id) || maplebirch.get("VanillaPlus").realEstate.managementFor(_wardrobeProperty.id).rented>>
	<<lanLink '返回房产中介' 'Deadwood Reblooms Property Office'>><</lanLink>>
<<else>>
	<<run maplebirch.get("VanillaPlus").realEstate.enter()>><<effects>><<run maplebirch.get("VanillaPlus").realEstate.openWardrobe()>>
	<<lanSwitch 'You open the wardrobe in your home.' '你打开了家里的衣柜。'>><br><br>
	<<wardrobeSelection>>
	<div id='wardrobewear'><<wardrobewear>></div>
	<div id='wardrobeExits'><<wardrobeExits>></div>
	<<wardrobe>>
<</if>>

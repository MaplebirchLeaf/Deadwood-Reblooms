:: Deadwood Transport Menu
<<deadwood-dynamicblock 'deadwood-transport-menu'>>
<<set _transport to maplebirch.get('Transport')>>
<<deadwood-transport-notice>>
<<if !_transport.point or !_transport.vehicle or !_transport.nearby.includes(_transport.vehicle)>>
  <<lanSwitch 'Your vehicles are parked elsewhere.' '你的载具停在别处。'>><br><br>
  <<deadwood-transport-return>>
<<else>>
  <<icon `'transport/' + _transport.model.id + '.png'`>><b><<print maplebirch.t(_transport.model.name)>></b> — <<print _transport.catalog.name(_transport.point)>><<deadwood-street-bounty-transit _transport.vehicle.id>><br><br>
  <<deadwood-taxi-menu>>
  <<if !_transport.taxi.active>>
    <<if (_transport.vehicle.arrears ?? 0) gt 0>>
      <span class='red'><<lanSwitch 'Unpaid upkeep: ' '保养欠费：'>></span><<deadwood-transport-money _transport.vehicle.arrears>><br>
      <<if $money gte _transport.vehicle.arrears>>
        <<shopicon 'register'>><<lanLink ['Pay cash', '用现金补缴']>>
          <<if maplebirch.get('Transport').maintenance.pay('cash')>><<updatesidebarmoney>><<run Dynamic.render('deadwood-transport-menu')>><</if>>
        <</lanLink>><br>
      <<else>>
        <span class='grey'><<lanSwitch 'You do not have enough cash to clear the upkeep.' '随身现金不足以结清保养欠费。'>></span><br>
      <</if>>
      <<if maplebirch.get('Finance')?.state.bank.opened and maplebirch.get('Finance').state.bank.balance gte _transport.vehicle.arrears>>
        <<icon 'finance/bank-withdraw.png'>><<lanLink ['Pay from your bank account', '从银行账户补缴']>>
          <<if maplebirch.get('Transport').maintenance.pay('bank')>><<updatesidebarmoney>><<run Dynamic.render('deadwood-transport-menu')>><</if>>
        <</lanLink>><br>
      <</if>><br>
    <</if>>
    <<if _transport.vehicle.condition lt _transport.repairs.terms.condition_limit>>
      <<if _transport.repairs.amount gt 0>>
        <<icon `'transport/' + _transport.repairs.kind + '-repair-kit.png'`>><<lanLink `lanSwitch('Make roadside repairs', '应急维修') + ' (0:' + _transport.repairs.terms[_transport.repairs.kind].minutes + ')'`>>
          <<if maplebirch.get('Transport').repairs.use() and $passage is 'Deadwood Transport Menu'>>
            <<goto 'Deadwood Transport Repair'>>
          <</if>>
        <</lanLink>> | <span class='green'><<lanSwitch 'Condition +' '车况 +'>><<print Math.floor(_transport.repairs.amount)>>%</span><br>
      <<else>>
        <i><<lanSwitch 'A repair kit and supplies would help you get moving again.' '备好维修工具和耗材，就能在途中应急修复。'>></i><br>
      <</if>><br>
    <</if>>
    <<if _transport.companions.available.length and !$Transport.commute and !maplebirch.get('Finance')?.realEstate.outings.travelling>>
      <<lanSwitch 'Invite someone along' '邀请同住恋人同行'>><br>
      <<for _passenger range _transport.companions.available>>
        <<capture _passenger>>
          <<socialiseicon 'ask'>><<lanLink `lanSwitch(_passenger, {Robin: '罗宾', Whitney: '惠特尼', Kylar: '凯拉尔', Sydney: '悉尼'}[_passenger])`>>
            <<run maplebirch.get('Transport').companions.invite(_passenger)>><<run Dynamic.render('deadwood-transport-menu')>>
          <</lanLink>><<if $Transport.passengers.includes(_passenger)>> <span class='green'><<lanSwitch '(coming along)' '（一同出发）'>></span><</if>><br>
        <</capture>>
      <</for>><br>
    <</if>>
    <<deadwood-home-outing-departure>>
    <<deadwood-outing-weather-link>>
    <<deadwood-outing-arrival>>
    <<deadwood-home-rides>>
    <<if _transport.garage>>
      <<lanSwitch 'Occupied spaces of this type: ' '此类车位已占用：'>><<print _transport.garage.used>> / <<print _transport.garage.capacity>><br>
      <<if _transport.vehicle.garage>>
        <<icon `'transport/' + _transport.model.id + '.png'`>><<lanLink ['Move it out of the garage', '移出车库']>>
          <<run maplebirch.get('Transport').park(false)>>
          <<run Dynamic.render('deadwood-transport-menu')>>
        <</lanLink>><br>
      <<elseif _transport.garage.used lt _transport.garage.capacity>>
        <<icon 'property/garage.png'>><<lanLink ['Put it in the garage', '存入车库']>>
          <<run maplebirch.get('Transport').park(true)>>
          <<run Dynamic.render('deadwood-transport-menu')>>
        <</lanLink>><br>
      <<else>>
        <span class='purple'><<lanSwitch 'These spaces are full.' '此类车位已经停满了。'>></span><br>
      <</if>><br>
    <</if>>
    <<if _transport.fuel.current>>
      <<lanSwitch 'Stored fuel: ' '储备燃油：'>><span class='teal'><<print _transport.fuel.store.litres.toFixed(1)>> L</span><br>
      <<if _transport.fuel.refillAmount gt 0>>
        <<icon 'transport/fuel-can.png'>><<lanLink `lanSwitch('Refuel from a can', '用油桶补油') + ' (' + Math.floor(_transport.fuel.terms.refill_minutes / 60) + ':' + String(_transport.fuel.terms.refill_minutes % 60).padStart(2, '0') + ')'`>>
          <<if maplebirch.get('Transport').fuel.refill() and $passage is 'Deadwood Transport Menu'>>
            <<run Dynamic.render('deadwood-transport-status')>><<run Dynamic.render('deadwood-transport-menu')>>
          <</if>>
        <</lanLink>><br>
      <</if>><br>
    <</if>>
    <<if !_transport.canDepart>>
      <<if _transport.vehicle.condition lte 0>>
        <span class='red'><<lanSwitch 'It needs repairs before you can use it.' '修好之前，它没法上路。'>></span>
      <<elseif (_transport.vehicle.arrears ?? 0) gt 0>>
        <span class='red'><<lanSwitch 'Pay the outstanding upkeep before setting off.' '补缴保养费用后才能上路。'>></span>
      <<elseif _transport.vehicle.garage>>
        <<lanSwitch 'It is parked in the garage.' '它停在车库里。'>>
      <<elseif !_transport.qualified>>
        <span class='purple'><<lanSwitch 'You need a licence for this vehicle.' '你需要相应的驾驶资格。'>></span>
      <<elseif _transport.model.kind is 'motorcycle' and !$Transport.helmet>>
        <span class='purple'><<lanSwitch 'You need a motorcycle helmet.' '你需要摩托车头盔。'>></span>
      <<else>>
        <span class='purple'><<lanSwitch 'You cannot use it in your current condition.' '你现在的状况不适合出行。'>></span>
      <</if>><br><br>
    <<else>>
      <<if _transport.model.kind isnot 'bicycle' and $drunk gt 0>>
        <span @class="'purple ' + basicDrunkCss()"><<lanSwitch 'The smell of alcohol still clings to you. Driving now makes the vehicle harder to control, and a police check could stop your journey.' '你身上的酒气还没散。酒后驾驶更难控制载具，警方临检也可能让行程中断。'>></span><br><br>
      <</if>>
      <<if _transport.point.startsWith('forest:')>>
        <<language>>
          <<option 'EN'>>
            Roots break through the path. You look for a way between the trees where the wheels can still pass.
          <<option 'CN'>>
            树根拱出了路面。你在树木间寻找仍能让车轮通过的小径。
        <</language>><br><br>
      <<elseif _transport.point.startsWith('moor:')>>
        <<language>>
          <<option 'EN'>>
            Wheel ruts run through the heather. Beyond them, rocks and wet ground would force you to continue on foot.
          <<option 'CN'>>
            石楠间留下了几道车辙。再往前，岩石和湿地会挡住车轮，只能步行过去。
        <</language>><br><br>
      <</if>>
      <<if $Transport.commute>>
        <<npc $Transport.commute.npc>><<person1>>
        <<lanSwitch 'You agreed to give <<him>> a lift.' '你答应了送<<him>>一程。'>><br><br>
      <</if>>
      <<for _destination range _transport.destinations.filter(destination => (!$Transport.commute || destination.id === $Transport.commute.to) && (!maplebirch.get('Finance')?.realEstate.outings.travelling || destination.id === maplebirch.get('Finance').realEstate.outings.target))>>
        <<capture _destination>>
          <<switch _destination.id.startsWith('farmroad') ? 'road' : _destination.id.split(':')[0]>>
            <<case 'road'>><<roadicon>>
            <<case 'farmland'>><<farmicon>>
            <<case 'forest'>><<foresticon>>
            <<case 'moor'>><<mooricon>>
            <<case 'home'>><<homeicon>>
            <<default>><<print '<<' + _destination.id + 'icon>>'>>
          <</switch>>
          <<if _destination.affordable>>
            <<lanLink `_destination.name + ' (' + Math.floor(_destination.minutes / 60) + ':' + String(_destination.minutes % 60).padStart(2, '0') + ')'`>>
              <<if maplebirch.get('Transport').startTrip(_destination.id)>>
                <<goto 'Deadwood Transport Travel'>>
              <</if>>
            <</lanLink>>
            <<if _destination.id.includes(':') and _transport.point.includes(':')>>
              <i>
                <<if Number(_destination.id.split(':')[1]) gt Number(_transport.point.split(':')[1])>>
                  <<lanSwitch '(further in)' '（向深处）'>>
                <<else>>
                  <<lanSwitch '(towards the edge)' '（返回边缘）'>>
                <</if>>
              </i>
            <</if>>
          <<else>>
            <span class='purple'><<print _destination.name>> — <<lanSwitch 'not enough fuel' '油量不足'>></span>
          <</if>><br>
        <</capture>>
      <</for>><br>
    <</if>>
  <</if>>
  <<deadwood-transport-return>>
<</if>>

<</deadwood-dynamicblock>>

:: Deadwood Transport Travel
<<deadwood-dynamicblock 'deadwood-transport-travel'>>
<<set _transport to maplebirch.get('Transport')>>
<<if $Transport.trip and !$Transport.trip.settled>>
  <<run _transport.completeTrip()>>
  <<if $passage is 'Deadwood Transport Travel'>><<run Dynamic.render('deadwood-transport-status')>><</if>>
<</if>>
<<if $passage is 'Deadwood Transport Travel'>>
  <<if _transport.events.policeArrested>>
    <<deadwood-transport-hazard-result>>
    <<skinicon 'manacles'>><<lanLink ['Be taken to the station', '被带往警局'] 'Deadwood Transport Police Handover'>><</lanLink>><br>
  <<elseif _transport.events.combatPending or _transport.events.inCombat>>
    <<icon 'alert.png'>><<lanLink ['Continue', '继续'] 'Deadwood Transport Road Fight'>><</lanLink>>
  <<elseif _transport.events.atHazard>>
    <<deadwood-street-cargo-travel>>
    <<deadwood-transport-hazard>>
  <<elseif !$Transport.trip or !$Transport.trip.settled or $Transport.trip.interrupted>>
    <<deadwood-transport-hazard-result>>
    <<lanSwitch 'You cannot complete the journey.' '你没能完成这次行程。'>><br><br>
    <<if _transport.taxi.active>>
      <<icon 'transport/dispatch-radio.png'>><<lanLink ['Contact dispatch', '联系调度'] 'Deadwood Transport Taxi Dispatch'>><</lanLink>><br>
    <</if>>
    <<getouticon>><<lanLink ['Return', '返回'] $Transport.return_passage>>
      <<run maplebirch.get('Finance')?.realEstate.outings.abandon()>>
      <<set $Transport.trip to null>>
    <</lanLink>>
  <<else>>
    <<deadwood-transport-hazard-result>>
    <<language>>
      <<option 'EN'>>
        <<if _transport.model.kind is 'bicycle'>>
          <<if $Transport.trip.event?.point>>You grip the handlebars and set off again.<<else>>You grip the handlebars and pedal away.<</if>>
          <<if $Transport.trip.to.startsWith('forest:')>>
            You duck under a low branch. The tyres bump over roots before finding a clear stretch of path.
          <<elseif $Transport.trip.to.startsWith('moor:')>>
            You follow the wheel ruts through the heather, easing around stones that jut from the ground.
          <<elseif $Transport.trip.to is 'farmland'>>
            Houses give way to trees, then open fields. The wind catches your clothes as you crest a hill.
          <<elseif $Transport.trip.from is 'farmland'>>
            The fields fall behind you. You climb the hill, then follow the road down towards the town.
          <<else>>
            You keep close to the kerb, slowing where pedestrians cross.
          <</if>>
        <<elseif _transport.model.kind is 'motorcycle'>>
          <<if $Transport.trip.event?.point>>You check your helmet strap and pull away again.<<else>>You fasten your helmet and start the engine.<</if>>
          <<if $Transport.trip.to.startsWith('moor:')>>
            The tyres follow the ruts through the heather. You ease off the throttle where stones break through the track.
          <<else>>
            You pull into the road. The engine hums beneath you, rising as the traffic thins.
          <</if>>
        <<else>>
          <<if $Transport.trip.event?.point>>You check the road and pull away again.<<else>>You buckle your seat belt and pull away from the kerb.<</if>>
          <<if $Transport.trip.to is 'farmland'>>
            You leave the houses behind. The road climbs between the trees before dropping towards the fields.
          <<elseif $Transport.trip.from is 'farmland'>>
            You leave the fields behind. Beyond the hill, the first houses appear between the trees.
          <<else>>
            You wait at a crossing, then join the traffic on the other side.
          <</if>>
        <</if>>
        <<if Weather.isSnow>>
          Snow clings to the road. You take the bends slowly.
        <<elseif Weather.precipitation is 'rain'>>
          The wet surface gleams beneath you. You leave extra room to brake.
        <</if>>
        <<deadwood-transport-road-scene>>
        You stop at <<print _transport.catalog.name($Transport.trip.to)>> and leave your vehicle at the side.
      <<option 'CN'>>
        <<if _transport.model.kind is 'bicycle'>>
          <<if $Transport.trip.event?.point>>你握紧车把，重新出发。<<else>>你握住车把，踩着脚踏板出发。<</if>>
          <<if $Transport.trip.to.startsWith('forest:')>>
            你低头躲过垂下的树枝。车轮颠过几段树根，才重新找到平整的小径。
          <<elseif $Transport.trip.to.startsWith('moor:')>>
            你沿着石楠间的车辙前行，绕开凸出地面的石块。
          <<elseif $Transport.trip.to is 'farmland'>>
            房屋渐渐被树林和田野取代。越过山丘时，风吹得你的衣服贴在身上。
          <<elseif $Transport.trip.from is 'farmland'>>
            田野渐渐落在身后。你爬上山丘，再沿公路向小镇骑去。
          <<else>>
            你贴着路边骑行，在行人过街时放慢速度。
          <</if>>
        <<elseif _transport.model.kind is 'motorcycle'>>
          <<if $Transport.trip.event?.point>>你检查头盔的系带，重新上路。<<else>>你扣好头盔，发动了车。<</if>>
          <<if $Transport.trip.to.startsWith('moor:')>>
            轮胎压着石楠间的车辙前行。碰上露出地面的石块，你松开油门，慢慢绕过。
          <<else>>
            你驶入道路。发动机在身下嗡嗡作响，等车流稀疏下来，声音才逐渐变高。
          <</if>>
        <<else>>
          <<if $Transport.trip.event?.point>>你看了看路面，重新驶上公路。<<else>>你系上安全带，把车驶离路边。<</if>>
          <<if $Transport.trip.to is 'farmland'>>
            房屋被甩在身后。公路穿过树林，爬上山丘，又向田野延伸。
          <<elseif $Transport.trip.from is 'farmland'>>
            田野被甩在身后。越过山丘，最先一排房屋从树木间露了出来。
          <<else>>
            你在路口等了一会儿，随后汇入对面的车流。
          <</if>>
        <</if>>
        <<if Weather.isSnow>>
          路面上积着雪。你放慢速度，小心转过弯道。
        <<elseif Weather.precipitation is 'rain'>>
          湿漉漉的路面泛着光。你留出更长的距离，免得来不及刹车。
        <</if>>
        <<deadwood-transport-road-scene>>
        到了<<print _transport.catalog.name($Transport.trip.to)>>，你停下车，把它留在路边。
    <</language>><<deadwood-street-bounty-transit _transport.vehicle.id>><br><br>
    <<deadwood-street-cargo-travel>>
    <<if $Transport.trip.taxi>>
      <<deadwood-taxi-arrival>>
    <<else>>
      <<deadwood-transport-passenger-reaction>>
      <<deadwood-transport-ride-arrival>>
      <<deadwood-transport-roadside-event>>
      <<if $Transport.trip.to.startsWith('forest:') and !$nextPassageCheck>>
        <<if $stress gte $stressmax and !$possessed>><<passoutforest>>
        <<elseif $foresthunt gte 10 and !$possessed>><<foresthunt>>
        <<elseif _transport.forestRoad>><<deadwood-transport-ride-options>>
        <<else>>
          <<rng>>
          <<if $rng gte 81>><<eventforestitem>>
          <<elseif dangerEvent($forestmod)>>
            <<if $forest lte 20>><<eventforestoutskirts>><<else>><<eventforest>><</if>>
          <<else>><<deadwood-transport-ride-options>><</if>>
        <</if>>
      <<else>>
        <<if maplebirch.get('Finance')?.realEstate.outings.travelling>>
          <<if maplebirch.get('Finance').realEstate.outings.plan.stage is 'visit'>>
            <<deadwood-outing-arrival>>
          <<else>>
            <<getouticon>><<lanLink ['Continue', '继续'] _transport.arrival>><</lanLink>><br>
          <</if>>
        <<else>>
          <<if _transport.companions.canFoolAround>>
            <<loveicon>><<lanLink ['Pull over somewhere quiet', '把车停到僻静处']>>
              <<if maplebirch.get('Transport').companions.foolAround()>>
                <<set $Transport.trip.pullstart to true>><<goto 'Deadwood Transport Pull Over'>>
              <</if>>
            <</lanLink>><<promiscuous2>><br>
          <</if>>
          <<if _transport.companions.canDate>>
            <<lanLink ['Spend some time together', '一起逛逛']>>
              <<if maplebirch.get('Transport').companions.canDate>><<goto 'Deadwood Transport Date'>><</if>>
            <</lanLink>><<lstress>><<for $_date_hint_name range _transport.companions.aboard>><<if $Transport.affection_days[$_date_hint_name + ':date'] isnot Time.days>><<glove $_date_hint_name>><</if>><</for>><br>
          <</if>>
          <<getouticon>><<lanLink ['Continue', '继续'] _transport.arrival>>
            <<if $Transport.trip.event>><<set $Transport.trip.event.resolved to true>><</if>>
            <<if $Transport.trip.commute>><<endevent>><<set $eventskip to 1>><<set $Transport.avery_reply to null>><</if>>
            <<set $phase to 0>>
          <</lanLink>><br>
        <</if>>
      <</if>>
    <</if>>
  <</if>>
<</if>>
<</deadwood-dynamicblock>>

:: Deadwood Transport Repair
<<deadwood-transport-notice>><br><br>
<<getouticon>><<lanLink ['Return to your vehicle', '返回载具旁'] 'Deadwood Transport Menu'>><</lanLink>><br>

:: Deadwood Transport Pull Over
<<set _transport to maplebirch.get('Transport')>>
<<set _pull_name to $Transport.trip?.passengers?.[0]>>
<<set _pull_start to $Transport.trip?.pullstart ? 1 : 0>>
<<if !$Transport.trip?.fooled or !_pull_name>>
  <span class='blue'><i><<lanSwitch 'There is nowhere to stop.' '这里没有能停车的地方。'>></i></span><br><br>
  <<getouticon>><<lanLink ['Continue', '继续'] _transport.arrival>><</lanLink>>
<<else>>
  <<if _pull_start is 1>>
    <<set $Transport.trip.pullstart to false>>
    <<clearnpc>><<npc _pull_name>><<person1>>
    <<if _pull_name is 'Sydney'>><<run statusCheck('Sydney')>><<set $corruptionEvent to 1>><</if>>
    <<consensual>><<set $consensual to 1>><<neutral 1>><<maninit>>
    <<set $enemytrust += 300>>
    <<set $enemyarousalmax to 600>>
    <<if _pull_name is 'Sydney'>>
      <<if _sydneyStatus.includes('corrupt') and !_sydneyChastity>><<npcexpose>><<set $enemyarousalmax += 100>>
      <<else>><<npcClothesType $NPCList[0] 'undies'>>
        <<if _sydneyStatus.includes('corrupt')>><<set $enemyarousalmax += 100>><</if>>
        <<if _sydneyStatus.includes('pure')>><<set $enemyarousalmax -= 100>><</if>>
      <</if>>
    <</if>>
    <span class='lewd'><<lanSwitch 'You pull off where the trees close over the track and kill the engine. Nobody passes. <<He>> reaches for you before you have finished taking the key out.' '你把车拐进树冠遮住车辙的路肩，熄了火。这段路没人经过。你还没来得及拔钥匙，<<He>>就已经伸手过来了。'>></span><br><br>
  <</if>>
  <<effects>><<effectsman>><<man>><<stateman>>
  <br><br><<actionsman>>
  <<if _combatend or _controlRegain is 1>>
    <span id='next'><<lanLink ["Next", '继续'] 'Deadwood Transport Pull Over Finish'>><</lanLink>></span><<nexttext>>
  <<else>>
    <span id='next'><<lanLink ["Next", '继续'] 'Deadwood Transport Pull Over'>><</lanLink>></span><<nexttext>>
  <</if>>
<</if>>

:: Deadwood Transport Pull Over Finish
<<effects>>
<<set _pull_name to $Transport.trip?.passengers?.[0]>>
<<if _pull_name>>
  <<person1>><<npc _pull_name>>
  <<if maplebirch.combat.climax>>
    <<ejaculation>><<npcincr _pull_name lust -20>><<npcincr _pull_name love 1>><<llust _pull_name>><<glove _pull_name>>
    <<lanSwitch 'The windscreen has fogged over on the inside. <<He>> draws a line through it with one finger and leaves it there, still catching <<his>> breath, and neither of you reaches for the ignition yet.' '挡风玻璃内侧蒙了一层雾。<<He>>用一根手指在上面划开一道，手就停在那儿，呼吸还没平下来，你们谁也没去碰钥匙。'>>
  <<elseif $enemyhealth lte 0 and !maplebirch.combat.climax>>
    <<npcincr _pull_name love -1>><<llove _pull_name>>
    <<lanSwitch '<<He>> straightens <<his>> clothes and looks out of the side window. You give <<him>> room until <<he>> is ready to be looked at again.' '<<He>>理好衣服，转头看向侧窗。你留出空间，等<<he>>愿意再对上目光。'>>
  <<else>>
    <<lanSwitch 'You stop and sit back in the driver seat. For a while the only sound is the engine ticking as it cools.' '你停下来，靠回驾驶座。有一阵子，只剩发动机冷却时的轻响。'>>
  <</if>>
  <br><br>
<</if>>
<<clotheson>>
<<endcombat>>
<<getouticon>><<lanLink ['Continue', '继续'] _transport.arrival>><</lanLink>>

:: Deadwood Transport Date
<<set _transport to maplebirch.get('Transport'), _date_trip to $Transport.trip>>
<<if !_date_trip?.settled or _date_trip.interrupted or _date_trip.commute or _date_trip.taxi or _transport.vehicle?.id isnot _date_trip.vehicle or _transport.vehicle?.point isnot _date_trip.to>>
  <<lanSwitch 'You can no longer spend time here together.' '你们现在没法一起在这里停留。'>><br><br>
  <<getouticon>><<lanLink ['Return to your vehicle', '返回载具旁'] 'Deadwood Transport Travel'>><</lanLink>><br><<exit>>
<</if>>
<<set $location to _date_trip.date_choice is 'arcade' ? 'arcade' : 'town', $outside to _date_trip.date_choice is 'arcade' ? 0 : 1>><<effects>>
<<if $nextPassage or $nextPassageCheck>>
  <span id='next'><<lanLink ['Next', '继续'] 'Deadwood Transport Date'>><</lanLink>></span><<nexttext>><<exit>>
<</if>>
<<if _date_trip.date_choice>>
  <<deadwood-transport-date-scene>>
  <<deadwood-transport-date-replies>>
  <<if _transport.companions.canFoolAround>>
    <<loveicon>><<lanLink ['Find somewhere quiet before going home', '回家前找个没人的地方亲热']>>
      <<if maplebirch.get('Transport').companions.foolAround()>><<set $Transport.trip.pullstart to true>><<goto 'Deadwood Transport Pull Over'>><</if>>
    <</lanLink>><<promiscuous2>><br><br>
  <</if>>
  <<lanSwitch 'You return to the vehicle together and decide where to go next.' '你们一起回到车旁，商量接下来去哪儿。'>><br><br>
  <<if _date_trip.event?.outcome and ['scraped', 'limped', 'escape', 'evaded'].includes(_date_trip.event.outcome)>>
    <<deadwood-transport-hazard-companion>>
  <</if>>
<<elseif _transport.companions.canDate>>
  <<language>>
    <<option 'EN'>>
      <<switch _date_trip.to>>
        <<case 'cliff'>>You park near the cliff. A path follows the railings above the sea; a bench stands back from the wind.
        <<case 'starfish'>>You leave the car near the promenade. Music spills from the arcade, and the paving beside the beach is clear enough for a walk.
        <<case 'danube'>>You stop on Danube Street. Stately houses stand back from the pavement, behind their garden walls. The far side of the street is quiet enough to talk.
        <<case 'high'>>You park off High Street. A bright advertisement fills one shop window; farther along, the furniture display is arranged like a little sitting room.
      <</switch>> What would you like to do together?
    <<option 'CN'>>
      <<switch _date_trip.to>>
        <<case 'cliff'>>你在峭壁附近停好车。一条小路沿海上方的栏杆伸过去，背风处放着长凳。
        <<case 'starfish'>>你把车停在海滨栈道附近。游戏厅里传来音乐，海滩旁的步道也适合走走。
        <<case 'danube'>>你在多瑙河街停下。宽敞的住宅退在围墙后面，隔着花园正对街道。另一侧人行道比较清静，适合说会儿话。
        <<case 'high'>>你把车停在商业街旁。一扇橱窗里贴着鲜亮的广告，再往前，家具陈列被布置成小起居室的样子。
      <</switch>> 接下来，想一起做点什么？
  <</language>><br><br>
  <<set _date_choices to {
    cliff: [['bench', 'Sit on the bench and watch the sea', '坐在长凳上看海'], ['path', 'Follow the path along the cliff', '沿峭壁的小路走一段']],
    starfish: [['promenade', 'Walk along the promenade', '沿海滨栈道散步'], ['arcade', 'Take turns at an arcade game (£5)', '轮流玩一台街机 (£5)']],
    danube: [['stonework', 'Compare the old houses from the pavement', '沿街看看旧宅的建筑细节'], ['quiet', 'Talk on the quieter side of the street', '到清静些的街边说说话']],
    high: [['advert', 'Read the shop-window advertisement together', '一起读读橱窗里的广告'], ['furniture', 'Compare the furniture and prices', '比较家具和价钱']]
  }[_date_trip.to]>>
  <div id='deadwood-transport-date-options'>
  <<for _date_option range _date_choices>><<capture _date_option _date_trip>>
    <<if _date_option[0] isnot 'arcade' or ($money gte 500 and $exposed lte 0 and !pcAreArmsBound('any') and ['day', 'dusk'].includes(Time.dayState) and Time.hour gte 9 and Time.hour * 60 + Time.minute + 20 lt 21 * 60)>>
      <<lanLink [_date_option[1] + ' (0:20)', _date_option[2] + ' (0:20)']>><<deadwood-transport-date-action _date_option[0] _date_trip>><</lanLink>>
      <<switch _date_option[0]>>
        <<case 'bench'>><<ltiredness>>
        <<case 'path'>> | <span class='teal'><<lanSwitch 'Athletics' '运动'>></span><<gtiredness>>
        <<case 'stonework'>> | <span class='teal'><<lanSwitch 'History' '历史'>></span>
        <<case 'quiet'>><<gwillpower>>
        <<case 'advert'>> | <span class='teal'><<lanSwitch 'English' '语文'>></span>
        <<case 'furniture'>> | <span class='teal'><<lanSwitch 'Maths' '数学'>></span>
      <</switch>><<lstress>><br>
    <<elseif _date_option[0] is 'arcade'>>
      <span class='purple'><<lanSwitch 'The game needs £5, free hands and time before the arcade closes.' '玩街机需要£5、双手自由，还得赶在游戏厅关门前。'>></span><br>
    <</if>>
  <</capture>><</for>><br>
  </div>
<<elseif _date_trip.dated>>
  <<lanSwitch 'The outing was interrupted before you could finish. You can head back to the vehicle.' '你们还没来得及尽兴，这次相处便被打断了。先回载具旁吧。'>><br><br>
<<else>>
  <<lanSwitch 'Your companion is no longer free to stay. You can return to the vehicle.' '同行的人已经没法继续在这里停留。先回载具旁吧。'>><br><br>
<</if>>
<<getouticon>><<lanLink ['Return to your vehicle', '返回载具旁'] 'Deadwood Transport Travel'>><<set $location to 'town', $outside to 1>><</lanLink>><br>

:: Deadwood Transport Date Widgets [widget]

<!-- 每次行程只选一项；原有耗时与每日好感仍由 companions.date 结算，正文只读结果。 -->
<<widget 'deadwood-transport-date-action'>>
  <<set $_date_transport to maplebirch.get('Transport'), $_date_choice to _args[0], $_date_trip to $Transport.trip>>
  <<if $passage isnot 'Deadwood Transport Date' or !$_date_transport?.companions.canDate or $_date_trip isnot _args[1] or !{
    cliff: ['bench', 'path'], starfish: ['promenade', 'arcade'], danube: ['stonework', 'quiet'], high: ['advert', 'furniture']
  }[$_date_trip.to]?.includes($_date_choice)>><<exit>><</if>>
  <<if $_date_choice is 'arcade'>>
    <<if $money lt 500 or $exposed gt 0 or pcAreArmsBound('any') or !['day', 'dusk'].includes(Time.dayState) or Time.hour lt 9 or Time.hour * 60 + Time.minute + 20 gte 21 * 60>><<exit>><</if>>
    <!-- 与原版街机同价，先投币再游玩；原版中断不退已经投入的游戏费。 -->
    <<money -500 'arcade'>><<set $location to 'arcade', $outside to 0>>
  <</if>>
  <<if $_date_transport.companions.date()>>
    <<set $_date_trip.date_choice to $_date_choice>>
    <<switch $_date_choice>>
      <<case 'bench'>><<tiredness -2>>
      <<case 'path'>><<athletics 1>><<tiredness 2>>
      <<case 'promenade'>><<stress -1>>
      <<case 'arcade'>><<stress -2>>
      <<case 'stonework'>><<historyskill 1 'no_star'>>
      <<case 'quiet'>><<willpower 1>>
      <<case 'advert'>><<englishskill 1 'no_star'>>
      <<case 'furniture'>><<mathsskill 1 'no_star'>>
    <</switch>>
  <</if>>
  <<deadwood-transport-next '#deadwood-transport-date-options'>>
  <<if $passage is 'Deadwood Transport Date' and !$statFreeze and !$replayScene and !$frozenValues>><<run updateMoment()>><</if>>
  <<if $passage is 'Deadwood Transport Date' and maplebirch.get('Transport') and !$statFreeze and !$replayScene and !$frozenValues and !$eventforced and !$nextPassage and !$nextPassageCheck>><<goto 'Deadwood Transport Date'>><</if>>
<</widget>>

<<widget 'deadwood-transport-date-scene'>>
  <<language>>
    <<option 'EN'>>
      <<switch $Transport.trip.date_choice>>
        <<case 'bench'>>You find a dry patch of the bench and sit down together. <<if Time.dayState is 'night'>>Lights along the shore break across the dark water.<<else>>The sea shifts from grey to silver where the light reaches it.<</if>> For once, neither of you needs to get up as soon as your feet stop aching.
        <<case 'path'>>You follow the path beside the railings. <<if currentSkillValue('athletics') gte 400>>You keep an easy pace on the rise, leaving enough breath to point out the view.<<else>>The rise leaves you short of breath. You stop at the next flat stretch, and everyone has a chance to look out over the water.<</if>> You turn back before the path takes you out of sight of the houses.
        <<case 'promenade'>>You walk beside the beach, slowing where sand has drifted across the paving. A gull lands by the railing and watches your empty hands. You leave it disappointed and turn back towards the car.
        <<case 'arcade'>>You put the coins in and make room at the controls. When one round ends, you change places rather than paying to continue. There is plenty of advice from behind the next player's shoulder, and very little agreement about whose turn went better.
        <<case 'stonework'>>You compare the gateposts and the houses beyond them, keeping to the public pavement. <<if currentSkillValue('history') gte 400>>You recognise an older style in a doorway, partly hidden by newer stonework, and point out the details left from before the alterations.<<else>>You cannot date the houses, but you can compare the worn gateposts with the newer walls built around them.<</if>> You move on when a car turns towards the next gate.
        <<case 'quiet'>>You cross to the quieter pavement and stop beyond the garden gates. There is no window display to look at, and neither of you has anything to buy. You leave a little room for people to pass, letting the pauses in your conversation last as long as they need to.
        <<case 'advert'>>You read the advertisement in the shop window together. <<if currentSkillValue('english') gte 400>>You pick out the small qualification beneath the bold promise. The sentence is doing rather less than the large type suggests.<<else>>You point to the smaller print, then compare it with the promise at the top.<</if>> You cover the large slogan and look at what is left. It makes a rather less impressive advertisement.
        <<case 'furniture'>>You compare the chairs in the window, then find the small price cards beneath them. <<if currentSkillValue('maths') gte 400>>You work out what the advertised instalments add up to. It is rather more than the number in the largest print.<<else>>You add the smaller figures on a scrap of paper until the real price becomes clear.<</if>> You leave the furniture where it is, having agreed which pieces you would never pay that much for.
      <</switch>>
    <<option 'CN'>>
      <<switch $Transport.trip.date_choice>>
        <<case 'bench'>>你们找了长凳上干燥的一块坐下。<<if Time.dayState is 'night'>>沿岸的灯光落在黑暗的水面上，一晃一晃的。<<else>>天光照到的地方，灰色海水泛起银光。<</if>>这回，就算脚不酸了，也不用立刻站起来赶路。
        <<case 'path'>>你们沿栏杆旁的小路走去。<<if currentSkillValue('athletics') gte 400>>走上坡时，你仍能轻松地开口，指给身边的人看远处的景色。<<else>>上坡让你有些气喘。走到下一段平路，你停了停，大家也正好看看下面的海。<</if>>趁小路还没绕出房屋的遮挡，你们便折返了。
        <<case 'promenade'>>你们沿海边走着，在沙子漫上铺路石的地方放慢脚步。一只海鸥落在栏杆边，盯住你们空着的手。回到车旁之前，你们没有满足它的期待。
        <<case 'arcade'>>你投下硬币，在操纵杆旁让出位置。一轮结束，你们便换个人玩，没有再往里续钱。下一人肩膀后面一直有人出主意，至于到底是谁玩得好，始终没争出个结果。
        <<case 'stonework'>>你们沿人行道比较门柱与后方的房屋，没有走进私人院子。<<if currentSkillValue('history') gte 400>>你认出一处被新石料遮住的旧式门楣，指给身边的人看，后来改建时留下了哪些细节。<<else>>你说不准房屋的年代，但磨损的门柱与周围新砌的墙，看着确实不一样。<</if>>有汽车准备驶进下一处大门时，你们便让开了路。
        <<case 'quiet'>>你们走到清静些的那侧人行道，在远离花园大门的地方停下。这里没有橱窗可看，也没什么急着要买的。你们让出行人经过的位置，慢慢说话，停下来时，也不急着把空当填满。
        <<case 'advert'>>你们一起读起橱窗里的广告。<<if currentSkillValue('english') gte 400>>你挑出醒目承诺下方的一小句限定词。仔细读来，答应的事可比大字让人以为的少些。<<else>>你指着小字读了一遍，又与最上面的承诺比较。<</if>>你用手挡住那行醒目的大字，再看看剩下的内容，可就没那么吸引人了。
        <<case 'furniture'>>你们比较过橱窗里的几把椅子，又找到下面小小的价签。<<if currentSkillValue('maths') gte 400>>你算了算广告上的分期付款，加起来可比最大那行数字贵得多。<<else>>你在一小片纸上把数字相加，才弄清到底要付多少。<</if>>最后，家具仍留在橱窗里。倒是哪几件绝不值得花这么多钱，你们意见一致。
      <</switch>>
  <</language>><<lstress>><br><br>
  <<switch $Transport.trip.date_choice>>
    <<case 'bench'>><<ltiredness>>
    <<case 'path'>> <span class='teal'><<lanSwitch 'Athletics' '运动'>></span><<gtiredness>>
    <<case 'stonework'>><<ghistory>>
    <<case 'quiet'>><<gwillpower>>
    <<case 'advert'>><<genglish>>
    <<case 'furniture'>><<gmaths>>
  <</switch>>
<</widget>>

<<widget 'deadwood-transport-date-replies'>>
  <<for $_date_name range $Transport.trip.passengers>>
    <<npc $_date_name>><<person1>><<if $_date_name is 'Sydney'>><<run statusCheck('Sydney')>><</if>>
    <<capture $_date_name>><<language>>
      <<option 'EN'>>
        <<switch $_date_name>>
          <<case 'Robin'>>
            <<if $Transport.trip.date_choice is 'arcade'>>"Wait, I know this one." Robin leans forward, then catches <<himself>> reaching past your arm. "Sorry. Your turn. I'll tell you afterwards."
            <<elseif ['bench', 'quiet'].includes($Transport.trip.date_choice)>>Robin stays beside you, <<his>> hand brushing yours. <<if C.npc.Robin.trauma gte 40>>"Can we stay a little away from the road?" <<He>> settles when you make room.<<else>>"This is nice. We don't always have to find something to do."<</if>>
            <<elseif $Transport.trip.date_choice is 'furniture'>>"That one's too easy to spill a drink on." Robin points to the pale chair, then checks the price. "I'd be frightened to sit in it."
            <<else>>Robin keeps close enough that your hands brush. "Next time, you can pick again. I like coming out with you."<</if>>
          <<case 'Whitney'>>
            <<if $Transport.trip.date_choice is 'arcade'>>"Move over. I'll show you." Whitney takes the controls, then swears when the screen flashes game over. "Machine's fucked."
            <<elseif $Transport.trip.date_choice is 'bench'>>Whitney takes most of the bench, then shifts enough to let you sit. "What? I can sit still. Stop looking surprised."
            <<elseif $Transport.trip.date_choice is 'quiet'>>Whitney stays close, shouldering into your space. "What? I can stand still. Stop looking surprised."
            <<elseif $Transport.trip.date_choice is 'advert'>>Whitney reads the small print over your shoulder. "All that shit just to get your money." <<He>> waits while you point out the rest.
            <<else>>Whitney hooks <<his>> fingers through yours. <<if C.npc.Whitney.dom gte 10>>"Keep up, slut."<<else>>"Come on. We've got time."<</if>> <<He>> does not let go.<</if>>
          <<case 'Kylar'>>
            <<if $Transport.trip.date_choice is 'arcade'>>Kylar loses a life while watching your hands. "I wasn't ready." When you trade places, <<he>> stands close, watching you rather than the score.
            <<elseif ['advert', 'stonework'].includes($Transport.trip.date_choice)>>Kylar listens until you pause. "I like hearing you explain things." <<He>> flushes when you ask what <<he>> thinks, then points out a detail you missed.
            <<elseif $Transport.trip.passengers.length gt 1>>Kylar finds a place beside you. <<if C.npc.Kylar.rage gte 40>>"Next time, could it just be us?" <<He>> keeps <<his>> voice low.<<else>>"Can I sit beside you on the way back?"<</if>>
            <<else>>Kylar offers you <<his>> hand. "We could stay a little longer." <<He>> squeezes your fingers, but follows when it is time to go.<</if>>
          <<case 'Sydney'>>
            <<if $Transport.trip.date_choice is 'arcade'>>Sydney checks the controls. <<if _sydneyStatus.includes('corrupt')>>"No helping until I've lost." <<He>> grins. "Then you can tell me everything I did wrong."<<else>>"One game. Then we should get back." After the first round, <<he>> admits that <<he>> would like a turn too.<</if>>
            <<elseif ['stonework', 'advert', 'furniture'].includes($Transport.trip.date_choice)>>Sydney bends closer to see what you mean. <<if _sydneyStatus.includes('corrupt')>>"You do know how to keep my attention." <<He>> gives you a sidelong smile before adding <<his>> own opinion.<<else>>"I hadn't noticed that." <<He>> checks it again, smiling when the details fit.<</if>>
            <<elseif ['bench', 'quiet'].includes($Transport.trip.date_choice)>>Sydney stays beside you, keeping <<his>> hand within reach. <<if _sydneyStatus.includes('corrupt')>>"We could come here again. Somewhere away from everyone else." <<He>> looks towards you rather than the view.<<else>>"I should put my book away more often." <<He>> leaves it in <<his>> bag.<</if>>
            <<else>>Sydney walks beside you, then stops when you do. <<if _sydneyStatus.includes('corrupt')>>"A little longer won't hurt." <<He>> catches your hand.<<else>>"I'm glad we had time for this." <<He>> offers <<his>> hand, glancing at the time before you leave.<</if>><</if>>
        <</switch>>
      <<option 'CN'>>
        <<switch $_date_name>>
          <<case 'Robin'>>
            <<if $Transport.trip.date_choice is 'arcade'>>“等等，这个我玩过。”罗宾往前凑，手伸到你胳膊旁，才又收了回去。“对不起。该你玩，等会儿再说。”
            <<elseif ['bench', 'quiet'].includes($Transport.trip.date_choice)>>罗宾留在你身旁，手背轻轻擦过你的手。<<if C.npc.Robin.trauma gte 40>>“能不能离公路远一点？”你挪出位置后，<<he>>才渐渐放松下来。<<else>>“这样也挺好。不用每次都找事情做。”<</if>>
            <<elseif $Transport.trip.date_choice is 'furniture'>>“这把可不能洒饮料。”罗宾指了指浅色椅子，又看了一眼价签。“坐上去都害怕。”
            <<else>>罗宾留在你身旁，手背偶尔擦过你的手。“下回还让你选。我喜欢和你出来。”<</if>>
          <<case 'Whitney'>>
            <<if $Transport.trip.date_choice is 'arcade'>>“让开。我教你。”惠特尼接过操纵杆，屏幕一闪，游戏结束。<<He>>骂了一声。“破机器。”
            <<elseif $Transport.trip.date_choice is 'bench'>>惠特尼占了大半张长凳，才挪出够你坐的位置。“怎么？我又不是坐不住。别大惊小怪。”
            <<elseif $Transport.trip.date_choice is 'quiet'>>惠特尼留在你身旁，肩膀挤进你的位置。“怎么？我又不是站不住。别大惊小怪。”
            <<elseif $Transport.trip.date_choice is 'advert'>>惠特尼从你肩后读完小字。“一堆废话，就是想让你掏钱。”你接着指给<<him>>看，<<he>>倒也等着。
            <<else>>惠特尼勾住你的手指。<<if C.npc.Whitney.dom gte 10>>“跟上，骚货。”<<else>>“走吧。还有时间。”<</if>><<He>>没有松手。<</if>>
          <<case 'Kylar'>>
            <<if $Transport.trip.date_choice is 'arcade'>>凯拉尔盯着你的手，丢了一条命。“还没准备好。”轮到你玩，<<he>>便贴在旁边，看你多过看分数。
            <<elseif ['advert', 'stonework'].includes($Transport.trip.date_choice)>>凯拉尔一直听到你停下来。“喜欢听你讲这些。”你反问<<him>>怎么想，<<he>>红了脸，随后指出你漏过的一处细节。
            <<elseif $Transport.trip.passengers.length gt 1>>凯拉尔在你身边找了个位置。<<if C.npc.Kylar.rage gte 40>>“下回，能不能只有我们？”<<He>>压低了声音。<<else>>“回去时，我还坐你旁边，好吗？”<</if>>
            <<else>>凯拉尔把手递给你。“还可以多待会儿。”<<He>>握紧你的手指，不过该走时，还是跟了上来。<</if>>
          <<case 'Sydney'>>
            <<if $Transport.trip.date_choice is 'arcade'>>悉尼看了看操纵杆。<<if _sydneyStatus.includes('corrupt')>>“输了之前，不许帮忙。”<<He>>笑了，“等我输完，再说哪里做错了。”<<else>>“就玩一次。然后该回去了。”头一轮结束后，<<he>>承认，也想轮到自己试试。<</if>>
            <<elseif ['stonework', 'advert', 'furniture'].includes($Transport.trip.date_choice)>>悉尼凑过来，看清你指的地方。<<if _sydneyStatus.includes('corrupt')>>“倒挺会让我专心听。”<<He>>斜眼朝你笑笑，才接着说起自己的看法。<<else>>“先前没注意到。”<<He>>又核对了一遍，发现细节确实对得上，便笑了。<</if>>
            <<elseif ['bench', 'quiet'].includes($Transport.trip.date_choice)>>悉尼留在你身边，把手放在你够得到的地方。<<if _sydneyStatus.includes('corrupt')>>“下回还来吧。离别人远些的地方。”<<He>>看向你，没有看景色。<<else>>“应该多把书放下一会儿。”这回，<<he>>让它留在了包里。<</if>>
            <<else>>悉尼陪你走着，也随着你的脚步停下。<<if _sydneyStatus.includes('corrupt')>>“多待一会儿也没什么。”<<He>>牵住你的手。<<else>>“幸好，今天有空一起出来。”<<He>>把手递给你，离开前还是看了一眼时间。<</if>><</if>>
        <</switch>>
    <</language>><</capture>><<glove $_date_name>><br><br>
  <</for>>
<</widget>>

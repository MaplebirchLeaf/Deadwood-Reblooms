:: Deadwood Transport Event Widgets [widget]

<!-- 耗时后用原版有目标链接接续事件，保留检查状态和返回目的地。 -->
<<widget 'deadwood-transport-next'>>
  <<if ['Deadwood Transport Travel', 'Deadwood Transport Date'].includes($passage) and maplebirch.passage.title is $passage
      and !$statFreeze and !$replayScene and !$frozenValues and ($nextPassage or $nextPassageCheck or $eventforced)>>
    <<replace `_args[0]`>><span id='next'><<lanLink ['Next', '继续'] $passage>><</lanLink>></span><<nexttext>><</replace>>
  <</if>>
<</widget>>

<<widget 'deadwood-transport-hazard'>>
  <<set $_hazard to $Transport.trip.event, _road_events to maplebirch.get('Transport').events>>
  <<set $_road_bicycle to maplebirch.get('Transport').model.kind is 'bicycle'>>
  <<if $_hazard.kind is 'molestation'>><<run maplebirch.get('Transport').taxi.passengerNPC()>><</if>>
  <<capture $_hazard $_road_bicycle>><<language>>
    <<option 'EN'>>
      You reach <<print maplebirch.get('Transport').catalog.name($_hazard.point)>>.
      <<switch $_hazard.kind>>
        <<case 'police'>>
          <<if $_hazard.checked>>
            <<if crimeSumCurrent() gte 1000>>
              The officer checks your name again, then signals to a colleague. "There's a warrant for you. Switch off the engine and step away from the vehicle."
            <<else>>
              The officer reads the breath test, then looks back at you. "You've been drinking. You're not driving any farther. Pay the fine, or come to the station."
            <</if>>
          <<else>>
            A police car stands beside the road. An officer raises a hand, directing you into a space by the kerb. "Routine check. Your licence, please."
          <</if>>
        <<case 'skid'>>
          You turn too sharply, and the tyres begin to slide. You ease off, looking for room to straighten up.
        <<case 'roadblock'>>
          Someone waves beside a vehicle stopped across part of the road. As you slow, another figure steps out behind it, watching your <<if $_road_bicycle>>bicycle<<else>>vehicle<</if>> rather than the traffic.
          "Stop there. <<if $_road_bicycle>>Off the bike.<<else>>Hand over the keys.<</if>>"
          There is still room to turn back. A narrow gap remains beside the stopped vehicle.
        <<case 'traffic'>>
          A lorry bears down behind you, its horn drowning out everything else. Its mirror swings close as it tries to squeeze past. Ahead, the road widens beside a gate.
          <<if Weather.precipitation is 'rain' or Weather.isSnow>>The verge is slippery. A sudden turn could put you in the ditch.<</if>>
        <<case 'load'>>
          A van turns the bend ahead. Its back door swings open, spilling crates across your lane. The driver stops farther up the road and runs back. There is a gap between the crates, but little room to brake once you enter it.
        <<case 'puncture'>>
          <<icon 'transport/flat-tyre.png'>><<if $_road_bicycle>>The rear tyre starts to drag. You stop and find a piece of wire embedded in it.<<else>>A tyre begins to thump. You pull over and find a screw sunk through the tread.<</if>>
          <<if $Transport.trip.event.point.startsWith('farmroad')>>Beyond the hedge, the fields are empty. The next passing vehicle takes several minutes to appear.<</if>>
        <<case 'molestation'>>
          A hand slides between the front seats, brushing your side. You pull away, but it follows. In the mirror, the passenger meets your eyes and smiles. "Keep driving."
          You slow down, looking for a place to pull over.
      <</switch>>
      <<if $Transport.trip.taxi is 'dropoff' and $_hazard.kind isnot 'molestation'>>Your passenger falls quiet, waiting for you to decide what to do.
      <<elseif $Transport.trip.passengers.length>>Your companion looks from the road to you.<</if>>
    <<option 'CN'>>
      你来到<<print maplebirch.get('Transport').catalog.name($_hazard.point)>>。
      <<switch $_hazard.kind>>
        <<case 'police'>>
          <<if $_hazard.checked>>
            <<if crimeSumCurrent() gte 1000>>
              警员又核对了一遍你的名字，随后向同事打了个手势。“你有拘捕令在身。熄火，下车。”
            <<else>>
              警员看了看酒精检测仪，又看向你。“你喝过酒。不能再开了。交罚款，或者跟我们回警局。”
            <</if>>
          <<else>>
            一辆警车停在路旁。警员抬起手，示意你驶向路边的空位。“例行检查。请出示驾驶执照。”
          <</if>>
        <<case 'skid'>>
          你转弯太急，轮胎开始打滑。你放慢速度，寻找能让车身摆正的空隙。
        <<case 'roadblock'>>
          一辆车横在部分路面上，旁边的人挥手示意。你刚减速，车后又走出一个人。对方盯着你的<<if $_road_bicycle>>自行车<<else>>载具<</if>>，没有看往来的车流。
          “停这儿。<<if $_road_bicycle>>从车上下来。<<else>>把钥匙交出来。<</if>>”
          后方还有掉头的空间。横着的车辆旁边，也留着一道狭窄的空隙。
        <<case 'traffic'>>
          一辆卡车从身后追上来，喇叭声盖过了别的声音。司机硬挤着超车，后视镜离你越来越近。前面一处大门旁，道路稍微宽了一些。
          <<if Weather.precipitation is 'rain' or Weather.isSnow>>路肩很滑。猛地转向，可能会让你滑进沟里。<</if>>
        <<case 'load'>>
          前方一辆货车转过弯，后门突然敞开，几只货箱滚进你的车道。司机停在远处，跑了回来。箱子之间有一道空隙，但进去后就没多少刹车的余地了。
        <<case 'puncture'>>
          <<icon 'transport/flat-tyre.png'>><<if $_road_bicycle>>后轮突然变得沉重。你停下车，发现一截铁丝扎进了轮胎。<<else>>轮胎开始一下一下地震动。你靠边停下，发现胎面上扎着一枚螺丝。<</if>>
          <<if $Transport.trip.event.point.startsWith('farmroad')>>树篱外的田野空荡荡的。过了好几分钟，才有另一辆车经过。<</if>>
        <<case 'molestation'>>
          一只手从前座之间伸来，摸向你的腰侧。你往旁边避开，那只手却跟了过来。后视镜里，乘客对上你的目光，笑了一下。“继续开。”
          你放慢车速，寻找能靠边停车的地方。
      <</switch>>
      <<if $Transport.trip.taxi is 'dropoff' and $_hazard.kind isnot 'molestation'>>乘客安静下来，等着你决定怎么办。
      <<elseif $Transport.trip.passengers.length>>同行的人看了看路面，又看向你。<</if>>
  <</language>><</capture>><br><br>
  <<deadwood-transport-hazard-advice>>
  <<if $_hazard.kind is 'police'>>
    <<if !$_hazard.checked>>
      <<deadwood-transport-road-action 'check'>>
    <<else>>
      <<if _road_events.can('fine')>>
        <<deadwood-transport-road-action 'fine'>>
      <<elseif _road_events.policeFine gt 0>>
        <<lanSwitch 'Fine: ' '罚款：'>><<deadwood-transport-money _road_events.policeFine>> · <span class='purple'><<lanSwitch 'Not enough cash' '现金不足'>></span><br>
      <</if>>
      <<deadwood-transport-road-action 'surrender'>>
    <</if>>
    <<deadwood-transport-road-action 'escape'>>
    <<if _road_events.can('fight')>><<deadwood-transport-road-action 'fight'>><</if>>
  <<elseif $_hazard.kind is 'skid'>>
    <<deadwood-transport-road-action 'wait'>>
    <<deadwood-transport-road-action 'escape'>>
  <<elseif $_hazard.kind is 'molestation'>>
    <<deadwood-transport-road-action 'warn'>>
    <<if _road_events.can('eject')>><<deadwood-transport-road-action 'eject'>><</if>>
    <<deadwood-transport-road-action 'fight'>>
  <<elseif $_hazard.kind is 'puncture'>>
    <<if _road_events.can('fix')>>
      <<deadwood-transport-road-action 'fix'>>
    <</if>>
    <<if _road_events.can('fix_together')>><<deadwood-transport-road-action 'fix_together'>><</if>>
    <<if _road_events.can('wait')>>
      <<deadwood-transport-road-action 'wait'>>
    <</if>>
    <<deadwood-transport-road-action 'limp'>>
    <<deadwood-transport-road-action 'walk'>>
  <<else>>
    <<deadwood-transport-road-action 'wait'>>
    <<if _road_events.can('observe')>><<deadwood-transport-road-action 'observe'>><</if>>
    <<if _road_events.can('force')>><<deadwood-transport-road-action 'force'>><</if>>
    <<if _road_events.can('force_together')>><<deadwood-transport-road-action 'force_together'>><</if>>
    <<deadwood-transport-road-action 'escape'>>
    <<if $_hazard.kind is 'roadblock'>>
      <<if _road_events.can('pay')>><<deadwood-transport-road-action 'pay'>><</if>>
      <<deadwood-transport-road-action 'fight'>>
      <<deadwood-transport-road-action 'yield'>>
    <</if>>
  <</if>>
<</widget>>

<<widget 'deadwood-transport-road-action'>>
  <<set _road_events to maplebirch.get('Transport').events, _road_action to _args[0], _road_trip to $Transport.trip, _road_event to $Transport.trip.event, _road_kind to $Transport.trip.event.kind, _road_bike to maplebirch.get('Transport').model.kind is 'bicycle'>>
  <<capture _road_action _road_trip _road_event>>
    <<switch _road_action>>
      <<case 'check'>>
        <<policeicon>><<set _road_label to ['Cooperate with the check (0:03)', '配合检查 (0:03)']>>
      <<case 'fine'>>
        <<icon 'pound.png'>><<set _road_label to ['Pay the fine and stop driving', '缴纳罚款，停止驾驶']>>
      <<case 'surrender'>>
        <<skinicon 'manacles'>><<set _road_label to ['Go to the station quietly', '配合前往警局']>>
      <<case 'wait'>>
        <<icon `_road_kind is 'roadblock' ? 'transport/detour.png' : _road_kind is 'puncture' ? 'hitchhike-car.png' : 'bird-tower/watch.png'`>>
        <<set _road_label to _road_kind is 'skid' ? ['Slow down and steady the vehicle (0:03)', '减速稳住载具 (0:03)'] : _road_kind is 'roadblock' ? ['Turn back and take another road (0:10)', '退回岔口绕路 (0:10)'] : _road_kind is 'load' ? ['Wait for the crates to be cleared (0:08)', '等货箱清走 (0:08)'] : _road_kind is 'puncture' ? ['Flag down help for the tyre (0:30)', '拦下过路车，请人修补轮胎 (0:30)'] : ['Give the lorry room (0:04)', '靠边让卡车过去 (0:04)']>>
      <<case 'escape'>>
        <<icon `'transport/' + maplebirch.get('Transport').model.id + '.png'`>>
        <<set _road_label to _road_kind is 'police' ? ['Drive away from the officers', '开车逃离警员'] : _road_kind is 'skid' ? ['Try to regain control without slowing', '保持车速，尝试控制方向'] : _road_kind is 'roadblock' ? ['Make for the gap', '从空隙抢过去'] : ['Pass through before the road closes', '赶在道路被堵住前穿过去']>>
      <<case 'observe'>>
        <<icon 'transport/traffic-check.png'>><<set _road_label to ['Watch their movements and slip past (0:03)', '看清对方的动作，趁隙绕过去 (0:03)']>>
      <<case 'force'>>
        <<icon `_road_kind is 'load' ? 'cargo-stack.png' : 'give-hand.png'`>>
        <<set _road_label to _road_kind is 'load' ? ['Move the crates aside (0:04)', '把货箱搬开 (0:04)'] : ['Shove the grabbing hand away (0:01)', '推开伸来的手，冲过去 (0:01)']>>
      <<case 'force_together'>>
        <<icon 'give-hand.png'>><<set _road_label to ['Move the crates with your companion (0:03)', '和同行的人一起搬开货箱 (0:03)']>>
      <<case 'pay'>>
        <<icon 'pound.png'>>
        <<set _road_label to ['Offer £50 for passage (0:02)', '交出 £50，让对方放行 (0:02)']>>
      <<case 'yield'>>
        <<icon `_road_bike ? 'transport/' + maplebirch.get('Transport').model.id + '.png' : 'transport/vehicle-keys.png'`>><<set _road_label to _road_bike ? ['Let them take the bicycle', '放弃自行车'] : ['Hand over the keys', '交出钥匙']>>
      <<case 'fight'>>
        <<icon 'alert.png'>><<set _road_label to _road_kind is 'police' ? ['Get out and fight the officers', '下车反抗警员'] : _road_kind is 'molestation' ? ['Stop and resist', '停车反抗'] : ['Fight back', '反抗']>>
      <<case 'warn'>>
        <<socialiseicon 'ask'>><<set _road_label to ['Tell the passenger to stop (0:01)', '严词制止乘客 (0:01)']>>
      <<case 'eject'>>
        <<getouticon>><<set _road_label to ['Pull over and force the passenger out (0:03)', '靠边停车，把乘客赶下车 (0:03)']>>
      <<case 'fix'>>
        <<icon `'transport/' + (_road_bike ? 'bicycle' : 'motor') + '-repair-kit.png'`>>
        <<set _road_label to _road_bike ? ['Patch the tyre with your tools (0:15)', '用工具修补轮胎 (0:15)'] : ['Repair the tyre with your tools (0:30)', '用工具修补轮胎 (0:30)']>>
      <<case 'fix_together'>>
        <<icon 'transport/motor-repair-kit.png'>><<set _road_label to ['Share the work of repairing the tyre (0:20)', '和同行的人分工修补轮胎 (0:20)']>>
      <<case 'limp'>>
        <<icon 'transport/flat-tyre.png'>>
        <<set _road_label to ['Continue slowly (+0:15)', '慢慢挪到目的地 (+0:15)']>>
      <<case 'walk'>>
        <<getouticon>><<set _road_label to ['Leave the vehicle and continue on foot', '留下载具，改为步行']>>
    <</switch>>
    <<lanLink `_road_label`>>
      <<if maplebirch.get('Transport') and $Transport.trip is _road_trip and $Transport.trip.event is _road_event>>
        <<set _road_resolved to maplebirch.get('Transport').events.resolve(_road_action)>>
        <<deadwood-transport-next '#deadwood-transport-travel'>>
        <<if maplebirch.get('Transport') and $Transport.trip is _road_trip and $Transport.trip.event is _road_event and $passage is 'Deadwood Transport Travel' and !$statFreeze and !$replayScene and !$eventforced and !$frozenValues and !$nextPassage and !$nextPassageCheck and (_road_resolved or _road_event.resolved)>>
          <<if maplebirch.get('Transport').events.combatPending>>
            <<goto 'Deadwood Transport Road Fight'>>
          <<else>>
            <<updatesidebarmoney>><<run Dynamic.render('deadwood-transport-travel')>>
          <</if>>
        <</if>>
        <<if $passage is 'Deadwood Transport Travel' and !$statFreeze and !$replayScene and !$frozenValues>><<run updateMoment()>><</if>>
      <</if>>
    <</lanLink>>
    <<switch _road_action>>
      <<case 'escape'>>
        <<difficulty _road_events.escapeChance>>
        <<if _road_kind is 'police'>><<crime 'resisting'>> | <span class='red'><<lanSwitch 'Failure starts a fight' '失手会被拦下，进入战斗'>></span>
        <<elseif _road_kind is 'roadblock'>> | <span class='red'><<lanSwitch 'Failure starts a fight' '失手会被拦下，进入战斗'>></span><<else>> | <span class='red'><<lanSwitch 'Risk of damage' '可能损伤车况'>></span><</if>>
      <<case 'observe'>> | <span class='teal'><<lanSwitch 'Skulduggery' '诡术'>></span>
      <<case 'force' 'force_together'>> | <span class='teal'><<lanSwitch 'Physique' '体能'>></span><<gtiredness>>
      <<case 'fix' 'fix_together'>> | <span class='teal'><<lanSwitch 'Housekeeping' '家务'>></span> | <span class='teal'><<lanSwitch 'Repair supplies −1' '维修耗材 −1'>></span>
      <<case 'limp'>> | <span class='red'><<lanSwitch 'Condition −6%' '车况 −6%'>></span>
      <<case 'yield'>> | <span class='red'><<lanSwitch 'Lose the vehicle' '丢失载具'>></span>
      <<case 'fight'>> | <span class='red'><<lanSwitch 'Combat' '战斗'>></span><<if _road_kind is 'police'>><<crime 'assault'>><</if>>
      <<case 'fine'>> — <<deadwood-transport-money _road_events.policeFine>>
      <<case 'surrender'>> | <span class='red'><<lanSwitch 'The offence will be processed at the station' '前往警局接受处理'>></span>
      <<case 'warn'>>
        <<difficulty _road_events.boundaryChance>> | <span class='red'><<lanSwitch 'Refusal starts an encounter' '对方拒绝会进入遭遇战'>></span>
      <<case 'eject'>> | <span class='teal'><<lanSwitch 'Physique' '体能'>></span> | <span class='red'><<lanSwitch 'Cancel the booking' '取消订单'>></span>
      <<case 'wait'>>
        <<if _road_kind is 'puncture'>> — <<deadwood-transport-money `_road_bike ? 2000 : 5000`>><</if>>
    <</switch>><br>
  <</capture>>
<</widget>>

<<widget 'deadwood-transport-hazard-result'>>
  <<set $_road_result to $Transport.trip?.event>>
  <<if $_road_result?.outcome and (!$_road_result.combat or $passage is 'Deadwood Transport Road Fight Finish')>>
    <<capture $_road_result>><<language>>
      <<option 'EN'>>
        <<switch $_road_result.outcome>>
          <<case 'wait'>>
            <<if $_road_result.kind is 'skid'>>You slow down and bring the wheels back into line. You wait until your hands are steady before setting off again.
            <<elseif $_road_result.kind is 'roadblock'>>You turn back before they can reach you, following a side road until it joins your route again. The delay costs you ten minutes.
            <<elseif $_road_result.kind is 'load'>>You wait while the driver hauls the crates off the road. When the lane clears, you set off again.
            <<else>>You ease into the wider stretch and let the lorry pass. Its horn fades ahead of you.<</if>>
          <<case 'escape'>>
            <<if $_road_result.kind is 'skid'>>You ease the wheel back into line, keeping the vehicle clear of the verge. The road straightens ahead.
            <<else>>You keep your eyes on the gap and judge the distance. You pass through before it closes, leaving the obstruction behind you.<</if>>
          <<case 'cleared'>>The officer returns your licence and steps away. "All clear. On your way."
          <<case 'fined'>>The officer takes your payment and hands you a receipt. You leave the vehicle parked beside the road. You will have to return when you are fit to drive.
          <<case 'evaded'>>
            <<if $_road_result.combat>>The officers can no longer keep you there. You pull free and return to your vehicle, still parked beside the road.
            <<else>>You turn off at the next junction, leaving the police car out of sight.<</if>>
            Escaping has not removed the evidence against you.
          <<case 'arrested'>>The officers take hold of your arms. "You're coming with us." Your vehicle stays beside the road.
          <<case 'scraped'>>You misjudge the gap. <<if maplebirch.get('Transport').model.kind is 'motor_vehicle'>>Metal scrapes against your bodywork.<<else>>You skid against the verge, catching yourself painfully before the vehicle can topple.<</if>> You stop to check the damage.
          <<case 'observe'>>A glance at the figure behind the vehicle tells you where the trap closes. You wait for their attention to shift, then take the other side before they can reach it.
          <<case 'force'>>
            <<if $_road_result.kind is 'load'>>You haul the crates clear one at a time. The driver catches up, breathless, and helps with the last one.
            <<else>>You knock the hand away from your handlebars. The figure stumbles, giving you room to push off and leave.<</if>>
          <<case 'force_together'>>You take one end of a crate and your companion takes the other. Together, you shift it onto the verge rather than dragging it along the road. By the time the driver reaches you, there is room to pass.
          <<case 'paid'>>You hold out the notes. One of them counts the money while the other moves aside. You keep watching them until they fall behind you.
          <<case 'defended'>>They can no longer keep you away from your vehicle. You pull free and reach it before either can stop you.
          <<case 'rescued'>>Your alarm draws attention from the road. <<if $_road_result.kind is 'molestation'>>The passenger lets go and scrambles out. You keep watching until the passenger is out of reach.<<else>>The two figures retreat behind their vehicle, then drive off. Yours is still where you left it.<</if>>
          <<case 'warned'>>You tell the passenger to keep their hands to themselves. Your voice leaves no room for another joke. The hand withdraws. You watch the rear-view mirror until the journey ends.
          <<case 'dismissed'>>You pull over and open the door. When the passenger tries to stay put, you take their arm and force them out. You lock the doors before reaching for the radio.
          <<case 'repelled'>>The passenger backs away from you. You force them out of the car and lock the doors. The keys are still in the ignition; you take them out with an unsteady hand.
          <<case 'assaulted'>>At last, the passenger releases you and gets out. You pull your clothes into place, then sit for a while with both hands gripping the wheel. The engine stays off. You reach for the radio to cancel the journey.
          <<case 'stolen'>>
            <<if $_road_result.combat>>You cannot keep them away from your vehicle. <</if>>
            <<if maplebirch.get('Transport').model.kind is 'bicycle'>>They wrench the bicycle from you and ride off.<<else>>One takes the keys while the other watches you. Your vehicle disappears around the bend.<</if>>
            <<if $Transport.trip.passengers.length>>You and your companion are left beside the road.<</if>>
            <<if $Transport.trip.taxi is 'dropoff'>>Your passenger gets out with you and asks dispatch for another car.<</if>>
            <span class='red'>Your vehicle has been stolen.</span> The workshop may be able to trace it through its local contacts.
          <<case 'fixed'>>You find the hole, prepare a patch and work it into place. You test the tyre before packing away the tools.
          <<case 'fixed_together'>>You lay out your tools and prepare the patch. With someone keeping the wheel steady and passing you what you need, you can work without getting up after every step. You check that the tyre holds before packing away your remaining supplies.
          <<case 'collected'>>A passing driver stops to help. After a call to the workshop, someone arrives with tyre repair equipment. You pay once the tyre holds its pressure.
          <<case 'limped'>>You crawl along, stopping whenever the wheel starts to wobble. Every bump travels through the damaged tyre and into the rim.
          <<case 'walk'>>You leave the vehicle off the road and note the nearest landmark. You will have to come back for it, or arrange collection at the workshop.
        <</switch>>
        <<if $Transport.trip.taxi and $Transport.trip.interrupted>>Dispatch takes down your position and cancels the booking. <<if maplebirch.get('Transport').taxi.fleet?.stolen>>The dispatcher tells you to stay clear. The company will deal with its missing car.<</if>><</if>>
      <<option 'CN'>>
        <<switch $_road_result.outcome>>
          <<case 'wait'>>
            <<if $_road_result.kind is 'skid'>>你放慢速度，让车轮重新摆正。等双手不再发抖，你才继续上路。
            <<elseif $_road_result.kind is 'roadblock'>>你赶在对方靠近前退回岔口，沿支路绕回原来的方向。前后耽搁了十分钟。
            <<elseif $_road_result.kind is 'load'>>你等司机把货箱拖离路面。车道腾出来后，你才重新出发。
            <<else>>你慢慢靠向较宽的路段，让卡车先过。喇叭声渐渐消失在前方。<</if>>
          <<case 'escape'>>
            <<if $_road_result.kind is 'skid'>>你慢慢修正方向，让载具避开路肩。前方的道路终于平直起来。
            <<else>>你盯着空隙，估好距离，赶在它被堵住之前穿了过去。障碍被留在了身后。<</if>>
          <<case 'cleared'>>警员把驾驶执照还给你，退开一步。“没问题了。走吧。”
          <<case 'fined'>>警员收下罚款，把收据递给你。你把载具留在路旁，等能正常驾驶了再回来取。
          <<case 'evaded'>>
            <<if $_road_result.combat>>警员暂时拦不住你。你挣脱束缚，回到仍停在路边的载具旁。
            <<else>>你在下一个路口转弯，把警车甩出了视线。<</if>>
            逃脱追捕并没有消除警方掌握的罪证。
          <<case 'arrested'>>警员扣住你的胳膊。“跟我们走。”你的载具留在路旁。
          <<case 'scraped'>>你估错了距离。<<if maplebirch.get('Transport').model.kind is 'motor_vehicle'>>金属刮过车身，发出刺耳的声音。<<else>>车轮滑向路肩。你撑住身体，疼得倒吸一口气，好歹没让车翻倒。<</if>>你停下来检查损伤。
          <<case 'observe'>>你瞥见车后那个人的动作，看清了对方打算在哪边围上来。等他们分神，你从另一侧绕过去，没给他们赶上的机会。
          <<case 'force'>>
            <<if $_road_result.kind is 'load'>>你把货箱一只只搬离车道。司机气喘吁吁地赶来，和你一起挪开最后一只。
            <<else>>你推开伸向车把的手。对方踉跄了一下，你趁机蹬地出发，冲出了包围。<</if>>
          <<case 'force_together'>>你抬起货箱的一头，同行的人扶住另一头。两人把箱子挪到路肩上，不必再沿着路面拖动。司机赶过来时，车道已经腾出了足够的空隙。
          <<case 'paid'>>你递出钞票。一个人数钱，另一个让开了路。直到把他们甩在身后，你才移开视线。
          <<case 'defended'>>他们已经拦不住你。你挣开束缚，赶在对方再次伸手前回到载具旁。
          <<case 'rescued'>>警报引来了路上的注意。<<if $_road_result.kind is 'molestation'>>乘客松开手，慌忙钻出车门。你一直盯着，直到对方走远。<<else>>那两个人退回横着的车后，很快开走了。你的载具还停在原处。<</if>>
          <<case 'warned'>>你让乘客把手收回去。语气让对方没法再拿玩笑搪塞，那只手终于退开了。余下的行程里，你始终留意着后视镜。
          <<case 'dismissed'>>你靠边停下，打开车门。乘客赖着不动，你就攥住对方的胳膊，把人赶了下去。关门落锁后，你才拿起无线电。
          <<case 'repelled'>>乘客往后退去。你把对方赶出车外，锁好车门。钥匙还插在点火孔里，你伸手拔下，手指有些发抖。
          <<case 'assaulted'>>乘客终于松开你，下了车。你拉好衣服，双手攥着方向盘，坐了好一会儿。发动机一直没开。你伸手拿起无线电，取消了这次行程。
          <<case 'stolen'>>
            <<if $_road_result.combat>>你没能阻止他们靠近载具。<</if>>
            <<if maplebirch.get('Transport').model.kind is 'bicycle'>>他们从你手里夺过自行车，骑着它跑了。<<else>>一个人拿走钥匙，另一个盯着你。你的载具消失在弯道后。<</if>>
            <<if $Transport.trip.passengers.length>>你和同行的人被留在路旁。<</if>>
            <<if $Transport.trip.taxi is 'dropoff'>>乘客和你一起下车，请调度另派一辆车。<</if>>
            <span class='red'>载具被抢走了。</span>修车厂或许能通过当地的门路帮你找回来。
          <<case 'fixed'>>你找到破口，处理好补片，把它压实。确认轮胎撑得住后，你才收起工具。
          <<case 'fixed_together'>>你摊开自带的工具，处理好补片。有人帮忙扶稳车轮、递来需要的东西，你不用做一步就站起来拿一次。确认轮胎不再漏气后，你收好剩下的耗材。
          <<case 'collected'>>一名过路司机停下帮忙。联系修车厂后，有人带着修补轮胎的工具赶来。确认轮胎不再漏气，你付了钱。
          <<case 'limped'>>你缓慢挪动，车轮开始摇晃就停一下。每次颠簸都透过坏轮胎，撞在轮圈上。
          <<case 'walk'>>你把载具留在路外，记下附近的地标。之后得回来取，或者去修车厂请人运回。<</switch>>
        <<if $Transport.trip.taxi and $Transport.trip.interrupted>>调度记下你的位置，取消了订单。<<if maplebirch.get('Transport').taxi.fleet?.stolen>>对方让你先顾好自己，丢失的营运车由车行处理。<</if>><</if>>
    <</language>><</capture>>
    <<if ['scraped', 'paid', 'limped', 'stolen'].includes($_road_result.outcome)>><<gstress>><</if>>
    <<if ['fixed_together', 'force_together'].includes($_road_result.outcome)>>
      <<deadwood-transport-work-companion>>
    <<elseif $Transport.trip.passengers.length>>
      <<deadwood-transport-hazard-companion>>
    <</if>><br><br>
  <</if>>
<</widget>>

<<widget 'deadwood-transport-hazard-advice'>>
  <<set $_hazard_event to $Transport.trip.event>>
  <<if $Transport.trip.taxi>><<exit>><</if>>
  <<for $_hazard_npc range maplebirch.get('Transport').companions.aboard>>
    <<npc $_hazard_npc>><<person1>><<if $_hazard_npc is 'Sydney'>><<run statusCheck('Sydney')>><</if>>
    <<capture $_hazard_event $_hazard_npc>><<language>>
      <<option 'EN'>>
        <<switch $_hazard_npc>>
          <<case 'Robin'>>
            <<if $_hazard_event.kind is 'police'>>Robin checks the seat belt, then stays quiet while you reach for your licence.
            <<elseif $_hazard_event.kind is 'puncture'>><<if C.npc.Robin.trauma gte 40>>Robin looks at the passing traffic, keeping <<his>> bag on <<his>> knees. "I'll wait here, if that's okay."<<else>>"If you fix it, I can hold the tools." Robin waits until you have stopped, then checks the traffic before opening the door.<</if>>
            <<elseif $_hazard_event.kind is 'load'>><<if C.npc.Robin.trauma gte 40>>Robin stays in the car, hands tight around <<his>> bag. "I'll wait here."<<else>>"We could lift one together." Robin checks the road before reaching for the door.<</if>>
            <<elseif $_hazard_event.kind is 'roadblock'>>"The one behind the car keeps looking at us." Robin lowers <<his>> voice. "We can still turn back."
            <<else>><<if C.npc.Robin.trauma gte 40>>Robin pulls <<his>> bag closer. "Can we slow down?"<<else>>Robin checks the mirror on <<his>> side. "There's room behind us, if we need to stop."<</if>><</if>>
          <<case 'Whitney'>>
            <<if $_hazard_event.kind is 'police'>>"Get your licence out." Whitney pushes <<his>> bag into the footwell. "And don't start telling them your fucking life story."
            <<elseif $_hazard_event.kind is 'puncture'>>Whitney looks at the tyre. "Tell me what you need. I'm not standing here all day."
            <<elseif $_hazard_event.kind is 'load'>>"That one's blocking us." Whitney points at the nearest crate. "Take the other end."
            <<elseif $_hazard_event.kind is 'roadblock'>>"Don't open the fucking door." Whitney watches the figure behind the car. "I can see them."
            <<else>>"Hold up." Whitney points towards the edge of the road. "Let that idiot get out of the way first."<</if>>
          <<case 'Kylar'>>
            <<if $_hazard_event.kind is 'police'>>Kylar lets go of your sleeve before the officer reaches the window. <<He>> watches without speaking.
            <<elseif $_hazard_event.kind is 'puncture'>>"I'll stay with you." Kylar watches for traffic while you look over the tyre.
            <<elseif $_hazard_event.kind is 'load'>>Kylar looks from the crates to you. "I'll take the other end. Stay beside me."
            <<elseif $_hazard_event.kind is 'roadblock'>>Kylar looks back the way you came. "Can we go back? We don't need to talk to them."
            <<else>>Kylar braces one hand against the seat. "I'm here. Just watch the road."<</if>>
          <<case 'Sydney'>>
            <<if $_hazard_event.kind is 'police'>><<if _sydneyStatus.includes('corrupt')>>"Let them finish checking." Sydney folds <<his>> hands where the officer can see them.<<else>>"We should do as they ask." Sydney gets <<his>> bag out of the way.<</if>>
            <<elseif !['glasses', 'playerbought', 'contacts'].includes($sydney.glasses)>>Sydney stays close rather than trying to make out the traffic. "Tell me when it's safe to get out. I can hold something for you."
            <<elseif $_hazard_event.kind is 'puncture'>>Sydney checks for traffic before opening the door. "I'll watch the road. Decide what you want to do first."
            <<elseif $_hazard_event.kind is 'load'>>"We shouldn't stand in the road." Sydney looks towards the verge. <<if _sydneyStatus.includes('corrupt')>>"Let's shift those before the idiot drops any more."<<else>>"We could move the nearest ones together."<</if>>
            <<elseif $_hazard_event.kind is 'roadblock'>><<if _sydneyStatus.includes('corrupt')>>"They're waiting for us to open the doors." Sydney looks towards the road behind. "Let's disappoint them."<<else>>"There's still room to go back." Sydney keeps <<his>> voice low.<</if>>
            <<else>>Sydney looks ahead rather than at you. "There's a wider place just there. We can wait."<</if>>
        <</switch>>
      <<option 'CN'>>
        <<switch $_hazard_npc>>
          <<case 'Robin'>>
            <<if $_hazard_event.kind is 'police'>>罗宾检查了一下安全带，见你伸手取驾驶执照，便安静地等着。
            <<elseif $_hazard_event.kind is 'puncture'>><<if C.npc.Robin.trauma gte 40>>罗宾望着过路的车辆，把包留在膝上。“我在这里等，好吗？”<<else>>“你要修的话，我帮你拿工具。”等车停稳，罗宾才留意着来车，准备开门。<</if>>
            <<elseif $_hazard_event.kind is 'load'>><<if C.npc.Robin.trauma gte 40>>罗宾留在车里，双手紧紧攥着包。“我在这里等。”<<else>>“两个人，应该抬得动吧。”罗宾看清路上的车，才伸手去开门。<</if>>
            <<elseif $_hazard_event.kind is 'roadblock'>>“车后那个人，一直盯着我们。”罗宾压低声音。“还来得及退回去。”
            <<else>><<if C.npc.Robin.trauma gte 40>>罗宾把包抱近了些。“能开慢一点吗？”<<else>>罗宾看了看自己那边的后视镜。“后面有空位，要停也来得及。”<</if>><</if>>
          <<case 'Whitney'>>
            <<if $_hazard_event.kind is 'police'>>“把驾驶执照拿出来。”惠特尼把包塞进脚边。“别他妈的连自己有几根毛都告诉他们。”
            <<elseif $_hazard_event.kind is 'puncture'>>惠特尼看看轮胎。“要什么就说。我可不想在这儿站一天。”
            <<elseif $_hazard_event.kind is 'load'>>“就那只挡着路。”惠特尼指向最近的货箱。“你抬另一头。”
            <<elseif $_hazard_event.kind is 'roadblock'>>“别他妈开门。”惠特尼盯着车后的身影。“我看见了。”
            <<else>>“先等等。”惠特尼指向路边。“让那个蠢货先滚过去。”<</if>>
          <<case 'Kylar'>>
            <<if $_hazard_event.kind is 'police'>>警员走到车窗旁之前，凯拉尔松开了你的袖子，一声不吭地看着。
            <<elseif $_hazard_event.kind is 'puncture'>>“我陪你。”你检查轮胎时，凯拉尔一直留意着过路的车辆。
            <<elseif $_hazard_event.kind is 'load'>>凯拉尔看看货箱，又看看你。“我抬另一头。别走远。”
            <<elseif $_hazard_event.kind is 'roadblock'>>凯拉尔望向来时的路。“回去，好吗？没必要和他们说话。”
            <<else>>凯拉尔用一只手撑住座位。“我在呢。你看路就好。”<</if>>
          <<case 'Sydney'>>
            <<if $_hazard_event.kind is 'police'>><<if _sydneyStatus.includes('corrupt')>>“让他们查完吧。”悉尼把手放在警员看得见的地方。<<else>>“先照他们说的做吧。”悉尼把挡路的包收好。<</if>>
            <<elseif !['glasses', 'playerbought', 'contacts'].includes($sydney.glasses)>>悉尼留在你身旁，没有勉强去看远处的车辆。“能下车的时候告诉我。我可以帮你扶着东西。”
            <<elseif $_hazard_event.kind is 'puncture'>>悉尼看清车流才打开门。“我看着路。你先想想怎么办。”
            <<elseif $_hazard_event.kind is 'load'>>“别一直站在车道上。”悉尼望向路肩。<<if _sydneyStatus.includes('corrupt')>>“趁那蠢货还没掉更多，先挪开吧。”<<else>>“最近的几只，我们可以一起搬。”<</if>>
            <<elseif $_hazard_event.kind is 'roadblock'>><<if _sydneyStatus.includes('corrupt')>>“他们正等着我们开门。”悉尼望向后方的路。“别让他们如愿。”<<else>>“后面还够退。”悉尼压低了声音。<</if>>
            <<else>>悉尼看着前面的路。“那边宽些。我们可以等等。”<</if>>
        <</switch>>
    <</language>><</capture>><br><br>
  <</for>>
<</widget>>

<<widget 'deadwood-transport-work-companion'>>
  <<for $_work_name range maplebirch.get('Transport').companions.aboard>>
    <<if $_work_name is 'Robin' and C.npc.Robin.trauma gte 40>><<continue>><</if>>
    <<npc $_work_name>><<person1>><<if $_work_name is 'Sydney'>><<run statusCheck('Sydney')>><</if>>
    <<capture $_work_name>><<language>>
      <<option 'EN'>>
        <<switch $_work_name>>
          <<case 'Robin'>>Robin brushes <<his>> hands together. "That was easier with some help." <<He>> waits until you have checked the road before getting back in.
          <<case 'Whitney'>>"About fucking time." Whitney rubs <<his>> hands on <<his>> trousers. "You're buying me a drink for that."
          <<case 'Kylar'>>Kylar stays close while you finish checking. "You didn't hurt your hands?" <<He>> looks pleased when you thank <<him>>.
          <<case 'Sydney'>>Sydney <<if ['glasses', 'playerbought', 'contacts'].includes($sydney.glasses)>>checks that nothing has been left in the road<<else>>waits while you check the road, keeping a hand against your arm<</if>>. <<if _sydneyStatus.includes('corrupt')>>"Next time, somewhere that doesn't get our hands dirty." <<He>> looks at <<his>> hands and laughs.<<else>>"There. We can go now." <<He>> waits for you before returning to the car.<</if>>
        <</switch>>
      <<option 'CN'>>
        <<switch $_work_name>>
          <<case 'Robin'>>罗宾拍了拍手上的灰。“有人搭手，果然容易些。”等你检查完路上的车，<<he>>才回到车里。
          <<case 'Whitney'>>“可他妈算完了。”惠特尼把手在裤子上擦了擦。“回头请我喝一杯。”
          <<case 'Kylar'>>你做最后的检查时，凯拉尔一直留在旁边。“手没伤着吧？”听见你道谢，<<he>>才露出笑容。
          <<case 'Sydney'>>悉尼<<if ['glasses', 'playerbought', 'contacts'].includes($sydney.glasses)>>确认没有东西留在车道上<<else>>扶着你的胳膊，等你检查路上的车<</if>>。<<if _sydneyStatus.includes('corrupt')>>“下回找个不用弄脏手的地方吧。”<<He>>低头看看手，笑了起来。<<else>>“好了，可以走了。”<<He>>等着你，才一起回到车里。<</if>>
        <</switch>>
    <</language>><</capture>><br><br>
  <</for>>
<</widget>>

<<widget 'deadwood-transport-hazard-companion'>>
  <<if $Transport.trip.taxi>><<exit>><</if>>
  <<for $_hazard_npc range $Transport.trip.passengers>>
    <<if C.npc[$_hazard_npc]?.init isnot 1 or !['active', 'rescued'].includes(C.npc[$_hazard_npc].state)>><<continue>><</if>>
    <<npc $_hazard_npc>><<person1>><<if $_hazard_npc is 'Sydney'>><<run statusCheck('Sydney')>><</if>>
    <<set $_hazard_bad to ['scraped', 'limped', 'evaded', 'fined', 'arrested'].includes($Transport.trip.event.outcome)>>
    <<capture $_hazard_bad $_hazard_npc>><<language>>
      <<option 'EN'>>
        <<switch $_hazard_npc>>
          <<case 'Robin'>>
            <<if $Transport.trip.interrupted or $_hazard_bad>>Robin keeps close while you check what to do next. <<if C.npc.Robin.trauma gte 40>>"Could we go home now? Somewhere quiet."<<else>>"You're not hurt? We can take our time getting back."<</if>>
            <<else>>Robin lets go of the seat belt. "I'm glad we didn't stay there." <<He>> watches the road until it is clear behind you.<</if>>
          <<case 'Whitney'>>
            <<if $Transport.trip.event.outcome is 'evaded'>>"Watch the fucking road." Whitney looks back, then forward again. "They're not worth wrapping us round a lamp post."
            <<elseif $Transport.trip.interrupted or $_hazard_bad>>"That's enough of that shit." Whitney checks the road. "Get us somewhere we can stop."
            <<else>>"Better." Whitney shifts <<his>> bag out of your way. "Keep going."<</if>>
          <<case 'Kylar'>>
            <<if $Transport.trip.interrupted or $_hazard_bad>>Kylar reaches for your hand once you have stopped. "We don't have to go anywhere else." <<He>> checks your face before letting you move.
            <<else>>Kylar looks back once. "They're gone." <<He>> keeps <<his>> hands away from yours until you stop.<</if>>
          <<case 'Sydney'>>
            <<if $Transport.trip.event.kind is 'police' and $Transport.trip.event.outcome is 'cleared'>>Sydney puts <<his>> bag back on <<his>> knees. <<if _sydneyStatus.includes('corrupt')>>"There. Nothing else to give them."<<else>>"Thank you for stopping."<</if>>
            <<elseif $Transport.trip.interrupted or $_hazard_bad>>Sydney takes a slow breath. <<if _sydneyStatus.includes('corrupt')>>"You can take me home without doing that again." <<He>> waits until you look at <<him>>.<<else>>"Let's get somewhere safe. We can decide the rest there."<</if>>
            <<elseif !['glasses', 'playerbought', 'contacts'].includes($sydney.glasses)>>Sydney waits for you to get back in. "We can go now?" <<He>> settles back when you start the engine.
            <<else>>Sydney checks the road beside you. "There's nothing coming on this side." <<He>> settles back when you pull away.<</if>>
          <<case 'Alex'>>Alex checks the road behind you. "There's a field gate just ahead. Let's keep away from the bend."
        <</switch>>
      <<option 'CN'>>
        <<switch $_hazard_npc>>
          <<case 'Robin'>>
            <<if $Transport.trip.interrupted or $_hazard_bad>>你查看接下来怎么办，罗宾一直留在你身旁。<<if C.npc.Robin.trauma gte 40>>“现在能回家了吗？找个安静点的地方。”<<else>>“你没伤着吧？回去可以慢慢走。”<</if>>
            <<else>>罗宾松开攥着安全带的手。“幸好，没继续待在那里。”<<He>>一直留意着身后的路，等那边彻底空下来。<</if>>
          <<case 'Whitney'>>
            <<if $Transport.trip.event.outcome is 'evaded'>>“看他妈的路。”惠特尼往后看了看，又转回前面。“不值得为了他们，把咱们撞到灯柱上。”
            <<elseif $Transport.trip.interrupted or $_hazard_bad>>“折腾够了吧。”惠特尼看看公路。“先找个能停的地方。”
            <<else>>“这还差不多。”惠特尼把包往边上挪。“走吧。”<</if>>
          <<case 'Kylar'>>
            <<if $Transport.trip.interrupted or $_hazard_bad>>等你停下，凯拉尔才来握你的手。“哪儿也不去，也可以。”<<He>>看看你的脸，才让开一点。<<else>>凯拉尔往后看了一眼。“他们走了。”等你停车之前，<<he>>没有再来牵你的手。<</if>>
          <<case 'Sydney'>>
            <<if $Transport.trip.event.kind is 'police' and $Transport.trip.event.outcome is 'cleared'>>悉尼把包重新放到膝上。<<if _sydneyStatus.includes('corrupt')>>“好了。没有别的要交代。”<<else>>“谢谢你停了车。”<</if>>
            <<elseif $Transport.trip.interrupted or $_hazard_bad>>悉尼慢慢呼出一口气。<<if _sydneyStatus.includes('corrupt')>>“回去路上，不用再来一次了吧。”<<He>>等你看向<<him>>。<<else>>“先去安全的地方。其他事，到了再说。”<</if>>
            <<elseif !['glasses', 'playerbought', 'contacts'].includes($sydney.glasses)>>悉尼等着你回到车里。“可以走了吗？”听见发动机响起，<<he>>才重新靠回座位。
            <<else>>悉尼看着你身旁的公路。“这边没有来车。”等你出发，<<he>>才重新靠回座位。<</if>>
          <<case 'Alex'>>艾利克斯检查着身后的公路。“前面有个田地入口。先离开弯道附近。”
        <</switch>>
    <</language>><</capture>><br><br>
  <</for>>
<</widget>>

<<widget 'deadwood-transport-road-scene'>>
  <<set $_road_scene to $Transport.trip.scene ?? 0>>
  <<capture $_road_scene>><<language>>
    <<option 'EN'>>
      <<if [$Transport.trip.from, $Transport.trip.to].includes('farmland')>>
        <<switch $_road_scene>>
          <<case 0>>A lorry loaded with crates passes on the other side. Beyond it, rows of crops run down towards a hedgerow.
          <<case 1>>A tractor waits at a field entrance. You give it room as it turns onto the road, leaving clods of mud behind its tyres.
          <<case 2>>The hedges rise above the road for a stretch, then fall away to reveal the fields. A farm gate rattles as you pass.
        <</switch>>
      <<elseif $Transport.trip.to.startsWith('forest:')>>
        <<switch $_road_scene>>
          <<case 0>>A bird bursts from a bush beside the path. You steady the handlebars as it vanishes between the trunks.
          <<case 1>>Fallen leaves hide a shallow rut. You ease over it, feeling the bump through the saddle.
          <<case 2>>The trees close over the path. For a while, the tyres and your breathing are the only sounds nearby.
        <</switch>>
      <<elseif $Transport.trip.to.startsWith('moor:')>>
        The track bends around a patch of dark, wet ground. You follow the older wheel marks where the earth is firmer.
      <<elseif ['cliff', 'starfish'].includes($Transport.trip.to)>>
        <<if Time.dayState is 'night'>>The seafront lights pass one by one. Between the buildings, the sea is a dark gap beyond the railings.
        <<else>>A gap between the buildings reveals the sea. A gull rides the wind above the promenade, keeping pace with you for a moment.<</if>>
      <<elseif [$Transport.trip.from, $Transport.trip.to].includes('harvest')>>
        <<switch $_road_scene>>
          <<case 0>>A delivery lorry takes a wide turn across the junction. You wait for its trailer to clear before moving on.
          <<case 1>>A worker wheels a stack of produce crates towards a waiting van. You slow as the trolley bumps over the kerb.
          <<case 2>>Two lorries squeeze past each other. You keep back from their mirrors until the road opens again.
        <</switch>>
      <<else>>
        <<switch $_road_scene>>
          <<case 0>>A delivery van has stopped beside the kerb. Its driver waves you past while carrying a stack of boxes towards a doorway.
          <<case 1>>Cones narrow one lane. You leave space for the traffic coming the other way, then pass the repair crew.
          <<case 2>>A pedestrian hesitates at a crossing. You slow down, and they give you a small nod before crossing.
        <</switch>>
      <</if>>
    <<option 'CN'>>
      <<if [$Transport.trip.from, $Transport.trip.to].includes('farmland')>>
        <<switch $_road_scene>>
          <<case 0>>一辆装着货箱的卡车从对面驶过。车身后，一排排作物延伸到田边的树篱。
          <<case 1>>田地入口停着一辆拖拉机。你让出位置，等它拐上公路。轮胎在身后留下几块泥土。
          <<case 2>>有一段路的两旁都是高高的树篱，接着田野又露了出来。经过农场大门时，门闩被风吹得轻响。
        <</switch>>
      <<elseif $Transport.trip.to.startsWith('forest:')>>
        <<switch $_road_scene>>
          <<case 0>>路旁的灌木里突然飞出一只鸟。你稳住车把，看着它消失在树干之间。
          <<case 1>>落叶遮住了一道浅沟。你放慢速度越过去，坐垫还是颠了一下。
          <<case 2>>树冠在小径上方合拢。有一阵，附近只听得见车轮和你的呼吸声。
        <</switch>>
      <<elseif $Transport.trip.to.startsWith('moor:')>>
        车辙绕过一片发黑的湿地。你沿着旧轮印走，挑着较硬的地面前进。
      <<elseif ['cliff', 'starfish'].includes($Transport.trip.to)>>
        <<if Time.dayState is 'night'>>海滨的灯一盏盏从身边过去。楼房之间，栏杆外的海面只剩下一片深黑。
        <<else>>楼房间的空隙露出海面。一只海鸥乘着风掠过栈道，在你身旁跟了一小段。<</if>>
      <<elseif [$Transport.trip.from, $Transport.trip.to].includes('harvest')>>
        <<switch $_road_scene>>
          <<case 0>>一辆送货卡车在路口拐了个大弯。你等拖车尾部完全过去，才继续前进。
          <<case 1>>工人推着一摞农产品货箱走向面包车。小推车颠下路缘，你也跟着放慢了速度。
          <<case 2>>两辆卡车贴着身挤过去。你避开它们伸出的后视镜，等道路重新腾出空位。
        <</switch>>
      <<else>>
        <<switch $_road_scene>>
          <<case 0>>一辆送货面包车停在路边。司机抱着一摞纸箱走向店门，腾出一只手示意你先走。
          <<case 1>>锥桶围窄了一条车道。你给对面的车辆留出位置，随后从维修工人身旁驶过。
          <<case 2>>有人在人行横道旁犹豫着。你放慢速度，对方朝你点点头，走过了马路。
        <</switch>>
      <</if>>
  <</language>><</capture>>
<</widget>>

<<widget 'deadwood-transport-roadside-event'>>
  <<deadwood-dynamicblock 'deadwood-transport-roadside-event'>>
    <<set _roadside_trip to $Transport.trip, _roadside to $Transport.trip.event>>
    <<if _roadside and !$Transport.trip.interrupted and (!_roadside.resolved or _roadside.action)>>
      <<if _roadside.action>>
        <<language>>
          <<option 'EN'>>
            <<if _roadside.action is 'tools'>>You fetch your tools, tighten the loose terminal and cover the damaged insulation with tape from your kit. The engine catches on the next attempt. The driver thanks you while you put your things away.
            <<elseif _roadside.kind is 'breakdown'>>The driver lends you a phone. You describe the nearest junction to the workshop and arrange for someone to come out. The driver relaxes a little and thanks you.
            <<else>>You gather the spilled shopping while the passer-by holds the torn bag together. They find a spare bag for the last few things and thank you before heading off.<</if>>
          <<option 'CN'>>
            <<if _roadside.action is 'tools'>>你取出工具，拧紧松脱的接线端，再用工具包里的胶带裹住破损的绝缘层。司机再试了一次，发动机终于响了。你收好东西时，对方连声道谢。
            <<elseif _roadside.kind is 'breakdown'>>司机借给你一部手机。你向修车厂说清最近的路口，约好让人过来看看。对方松了口气，向你道谢。
            <<else>>你捡起散落的东西，路人则扶住破了的袋子。对方找出一个备用袋子，装好最后几样，向你道谢后离开了。<</if>>
        <</language>>
        <<deadwood-transport-roadside-companion>>
      <<else>>
        <<language>>
          <<option 'EN'>>
            <<if _roadside.kind is 'breakdown'>>Near where you stop, a car sits with its bonnet open. The starter clicks once, then falls silent. Its driver looks up as you step away from your vehicle. "You know this area? I'm trying to explain where I am to a garage."
            <<else>>As you stop, a shopping bag splits beside the pavement. A passer-by bends to catch a rolling tin, leaving the rest scattered by their feet.<</if>>
          <<option 'CN'>>
            <<if _roadside.kind is 'breakdown'>>停车处附近，一辆汽车敞着引擎盖。启动机响了一下，便没了动静。你走下车时，司机抬起头。“你熟悉这附近吗？修车厂的人问我在哪儿，我说不清。”
            <<else>>你刚停下，路旁一个购物袋就裂开了。路人弯腰去追滚走的罐头，剩下的东西散了一地。<</if>>
        <</language>><br><br>
        <<if maplebirch.get('Transport').events.available>>
          <<capture _roadside_trip _roadside>>
            <<icon `_roadside.kind is 'breakdown' ? 'transport/service.png' : 'give-hand.png'`>><<lanLink `_roadside.kind is 'breakdown' ? ['Help arrange repairs (0:05)', '帮忙联系修车厂 (0:05)'] : ['Help pick things up (0:02)', '帮忙捡起来 (0:02)']`>>
              <<if maplebirch.get('Transport') and $Transport.trip is _roadside_trip and $Transport.trip.event is _roadside>>
                <<set _road_helped to maplebirch.get('Transport').events.help()>>
                <<deadwood-transport-next '#deadwood-transport-travel'>>
                <<if maplebirch.get('Transport') and $Transport.trip is _roadside_trip and $Transport.trip.event is _roadside and $passage is 'Deadwood Transport Travel' and !$statFreeze and !$replayScene and !$eventforced and !$frozenValues and !$nextPassage and !$nextPassageCheck and (_road_helped or _roadside.resolved)>>
                  <<run Dynamic.render('deadwood-transport-roadside-event')>>
                <</if>>
                <<if $passage is 'Deadwood Transport Travel' and !$statFreeze and !$replayScene and !$frozenValues>><<run updateMoment()>><</if>>
              <</if>>
            <</lanLink>><<lstress>>
            <<if maplebirch.get('Transport').events.canUseTools>>
              <br>
              <<icon 'transport/motor-repair-kit.png'>><<lanLink [currentSkillValue('housekeeping') gte 600 ? 'Secure the loose connection (0:03)' : 'Secure the loose connection (0:05)', currentSkillValue('housekeeping') gte 600 ? '用工具固定接头 (0:03)' : '用工具固定接头 (0:05)']>>
                <<if maplebirch.get('Transport') and $Transport.trip is _roadside_trip and $Transport.trip.event is _roadside>>
                  <<set _road_helped to maplebirch.get('Transport').events.help(true)>>
                  <<deadwood-transport-next '#deadwood-transport-travel'>>
                  <<if maplebirch.get('Transport') and $Transport.trip is _roadside_trip and $Transport.trip.event is _roadside and $passage is 'Deadwood Transport Travel' and !$statFreeze and !$replayScene and !$eventforced and !$frozenValues and !$nextPassage and !$nextPassageCheck and (_road_helped or _roadside.resolved)>>
                    <<run Dynamic.render('deadwood-transport-roadside-event')>>
                  <</if>>
                  <<if $passage is 'Deadwood Transport Travel' and !$statFreeze and !$replayScene and !$frozenValues>><<run updateMoment()>><</if>>
                <</if>>
              <</lanLink>> | <span class='teal'><<lanSwitch 'Housekeeping' '家务'>></span> | <span class='teal'><<lanSwitch 'Repair supplies −1' '维修耗材 −1'>></span>
            <</if>>
          <</capture>>
        <</if>>
      <</if>><br><br>
    <</if>>
  <</deadwood-dynamicblock>>
<</widget>>

<<widget 'deadwood-transport-roadside-companion'>>
  <<for $_roadside_name range maplebirch.get('Transport').companions.aboard>>
    <<npc $_roadside_name>><<person1>><<if $_roadside_name is 'Sydney'>><<run statusCheck('Sydney')>><</if>>
    <<capture $_roadside_name>><<language>>
      <<option 'EN'>>
        <<switch $_roadside_name>>
          <<case 'Robin'>> <<if C.npc.Robin.trauma gte 40>>Robin waits in the car until you return. "Everything okay?"<<else>>Robin smiles when you come back. "That was kind of you."<</if>>
          <<case 'Whitney'>> "Done playing hero?" Whitney asks. <<He>> shifts <<his>> bag out of your way. "Come on, then."
          <<case 'Kylar'>> Kylar has stayed beside your vehicle. "You know them?" <<He>> seems relieved when you shake your head.
          <<case 'Sydney'>> Sydney watches you put things away. <<if _sydneyStatus.includes('corrupt')>>"Come on. Someone else can help the next one."<<else>>"I'm glad we stopped."<</if>>
        <</switch>>
      <<option 'CN'>>
        <<switch $_roadside_name>>
          <<case 'Robin'>><<if C.npc.Robin.trauma gte 40>>罗宾待在车里，直到你回来。“都没事吧？”<<else>>你回来时，罗宾笑了笑。“你人真好。”<</if>>
          <<case 'Whitney'>>“英雄当够了？”惠特尼问。<<He>>把挡着你的包挪开。“那就走吧。”
          <<case 'Kylar'>>凯拉尔一直待在你的车旁。“你认识那个人？”你摇头后，<<he>>像是松了口气。
          <<case 'Sydney'>>悉尼看着你收好东西。<<if _sydneyStatus.includes('corrupt')>>“走吧。下一个留给别人帮忙。”<<else>>“还好我们停下了。”<</if>>
        <</switch>>
    <</language>><</capture>><br><br>
  <</for>>
<</widget>>

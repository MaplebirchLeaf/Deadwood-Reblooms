:: Deadwood Street Heist Planning Widgets [widget]

<!-- 约谈与筹备只在明确点击时结算；日志不生成、加载或修改 NPC。 -->
<!-- 丰收街只约时间；按原版路线到地下酒馆，不能从邀请直接传送。 -->
<<widget 'deadwood-street-heist-invitation'>>
  <<set _streetHeist to maplebirch.get('StreetLife')?.heist>>
  <<if _streetHeist?.available and (_streetHeist.unlocked or _streetHeist.state.appointment)>>
    <<if _streetHeist.state.stage is 'idle' and !_streetHeist.state.appointment and _streetHeist.meetingAvailable and 18 * 60 - Time.hour * 60 - Time.minute gt 30>>
      <<icon 'street/heist-plan.png'>><<lanLink ['Arrange a private meeting at the smugglers’ pub (0:30)', '约在走私者酒馆私下碰面 (0:30)'] $passage>>
        <<if _streetHeist.available and _streetHeist.unlocked and _streetHeist.meetingAvailable and _streetHeist.state.stage is 'idle' and !_streetHeist.state.appointment>>
          <<deadwood-street-heist-arrange>>
        <</if>>
      <</lanLink>><br>
    <<elseif _streetHeist.state.stage is 'idle' and !_streetHeist.state.appointment and _streetHeist.meetingAvailable>>
      <span class='blue'><<lanSwitch 'Not enough opening time left to arrange the meeting.' '剩余营业时间不足，无法谈完会面安排。'>></span><br>
    <<elseif !_streetHeist.inAction and _streetHeist.state.stage isnot 'closed'>>
      <span class='blue'><<lanSwitch 'Landry keeps the details for the private meeting at the smugglers’ pub. Go there by the usual route between 9 a.m. and 6 p.m.' '兰德里把具体的事留到走私者酒馆私下谈。请沿熟悉的路线过去，在上午九点至下午六点之间碰面。'>></span><br>
    <</if>>
  <</if>>
<</widget>>

<<widget 'deadwood-street-heist-meeting-required'>>
  <<lanSwitch 'Private meetings take place at the smugglers’ pub between 9 a.m. and 6 p.m. Come to the meeting there during those hours.' '私下会面在走私者酒馆，上午九点至下午六点进行。请到现场，并在约定时段回来继续。'>><br>
  <<getouticon>><<back `lanSwitch('Return', '返回')`>><br>
<</widget>>

<<widget 'deadwood-street-heist-link'>>
  <<set _streetHeist to maplebirch.get('StreetLife')?.heist>>
  <<if $passage is 'Smuggler Pub' and _streetHeist?.atMeeting and _streetHeist.businessCrew.length and _streetHeist.meetingAvailable and maplebirch.get('StreetLife').jobs.available>>
    <<socialiseicon 'ask'>><<lanLink ['Ask your former crew about ordinary work', '向原班雇员打听普通差事'] 'Deadwood Street Heist Contacts'>><<endevent>><</lanLink>><br>
  <</if>>
  <<if $passage is 'Smuggler Pub' and _streetHeist?.atMeeting and _streetHeist.available and (_streetHeist.unlocked or _streetHeist.state.stage isnot 'idle')>>
    <<if _streetHeist.state.stage is 'idle' and !_streetHeist.state.appointment>>
      <<if _streetHeist.meetingAvailable and 18 * 60 - Time.hour * 60 - Time.minute gt 30>>
        <<socialiseicon 'ask'>><<lanLink ['Arrange a meeting about a larger job (0:30)', '约好谈一桩大买卖 (0:30)'] 'Deadwood Street Heist Plan'>>
          <<if _streetHeist.available and _streetHeist.unlocked and _streetHeist.meetingAvailable and _streetHeist.state.stage is 'idle' and !_streetHeist.state.appointment>>
            <<deadwood-street-heist-arrange>>
          <</if>>
        <</lanLink>><br>
      <<else>>
        <span class='blue'><<= _streetHeist.meetingAvailable ? lanSwitch('Not enough opening time left to arrange the meeting.', '剩余营业时间不足，无法谈完会面安排。') : lanSwitch('Come back between 9 a.m. and 6 p.m. to arrange the meeting.', '请在上午九点至下午六点之间回来约谈。')>></span><br>
      <</if>>
    <<else>>
      <<socialiseicon 'ask'>><<lanLink ['Ask about the bank job', '谈谈银行那桩买卖'] 'Deadwood Street Heist Plan'>><<endevent>><</lanLink>><br>
    <</if>>
  <</if>>
<</widget>>

<!-- 金融中心的柜台是行动入口；约谈页面不能把 PC 直接传送到银行。 -->
<<widget 'deadwood-street-heist-bank'>>
  <<set _streetHeist to maplebirch.get('StreetLife')?.heist>>
  <<if $passage is 'Deadwood Reblooms Financial Centre Bank' and _streetHeist?.available>>
    <<if _streetHeist.inAction>>
      <<icon 'street/heist-plan.png'>><<lanLink ['Continue the bank job', '继续银行的行动'] 'Deadwood Street Heist'>><<endevent>><</lanLink>><br>
    <<elseif !_streetHeist.bankClosed and Time.weekDay gte 2 and Time.weekDay lte 6 and Time.hour gte 9 and Time.hour lt 17>>
      <<deadwood-street-heist-briefing-link>>
      <<if _streetHeist.ready>>
        <<icon 'street/heist-plan.png'>><<lanLink ['Begin the bank job', '按计划行动'] 'Deadwood Street Heist Start'>><<endevent>><</lanLink>><br>
      <</if>>
    <</if>>
  <</if>>
<</widget>>

<<widget 'deadwood-street-contact-status'>>
  <<set _streetHeist to maplebirch.get('StreetLife')?.heist>>
  <<if _streetHeist>>
    <<set _streetContacts to _streetHeist.contacts>>
    <div class='gold bold'><<lanSwitch 'Street contacts' '街头往来'>></div>
    <ul class='journal'>
      <<if C.npc.Landry?.init is 1>>
        <li><<= maplebirch.auto('Landry')>>：
          <<if _streetHeist.state.betrayed>><span class='red'><<lanSwitch 'knows you betrayed this venture, and withholds further arrangements.' '已经知道你出卖了这次合作，不肯再透露安排。'>></span>
          <<elseif _streetContacts.landryTier is 2>><span class='green'><<lanSwitch 'has seen you finish worthwhile work.' '已经见识过你办事的本事。'>></span>
          <<elseif _streetContacts.landryTier is 1>><span class='teal'><<lanSwitch 'sees a reason to keep doing business with you.' '觉得与你继续做生意有利可图。'>></span>
          <<else>><<lanSwitch 'is still weighing what you can bring to the table.' '仍在掂量你能带来什么。'>><</if>>
        </li>
      <</if>>
      <<if C.npc.Wren?.init is 1>>
        <li><<= maplebirch.auto('Wren')>>：
          <<if _streetHeist.state.betrayed>><span class='red'><<lanSwitch 'knows you betrayed this venture, and no longer trusts your part in it.' '已经知道你出卖了这次合作，不再相信你的承诺。'>></span>
          <<elseif _streetContacts.wrenTier is 2>><span class='green'><<lanSwitch 'is willing to hear out another joint venture.' '愿意认真听听下一桩合作。'>></span>
          <<elseif _streetContacts.wrenTier is 1>><span class='teal'><<lanSwitch 'finds the prospect of working with you interesting.' '觉得与你搭伙有些意思。'>></span>
          <<else>><<lanSwitch 'keeps a little distance when business comes up.' '谈到生意时，仍与你保持着些距离。'>><</if>>
        </li>
      <</if>>
      <<if $mickeyPub gte 2>>
        <li><<lanSwitch 'Mickey' '米奇'>>：
          <<if ['hiding', 'hidingKnown'].includes($pubfame?.status)>><span class='orange'><<lanSwitch 'is lying low and cannot meet you at the pub.' '正在避风头，暂时无法在酒馆见你。'>></span>
          <<elseif _streetHeist.state.betrayed>><<lanSwitch 'will not review another bank arrangement with you.' '不肯再替你复核银行的安排。'>>
          <<else>><<lanSwitch 'can check information and agreed plans behind the scenes.' '可以在幕后核对消息与谈妥的安排。'>><</if>>
        </li>
      <</if>>
      <<if C.npc.Grant?.init is 1>>
        <li><<= maplebirch.auto('Grant')>>：
          <<if _streetHeist.state.settled and _streetHeist.state.policePlan and _streetHeist.state.entered and !['reported', 'sting'].includes(_streetHeist.state.outcome)>><span class='red'><<lanSwitch 'knows you did not honour the agreed handover.' '知道你没有按约完成交接。'>></span>
          <<elseif _streetContacts.grantTier is 2>><span class='green'><<lanSwitch 'takes your reports seriously, and checks them.' '认真对待你的线索，也会核实。'>></span>
          <<elseif _streetContacts.grantTier is 1>><span class='teal'><<lanSwitch 'recognises your ability to follow a lead.' '认可你追查线索的本事。'>></span>
          <<else>><<lanSwitch 'expects you to give an accurate account.' '等着你把事情如实说清。'>><</if>>
        </li>
      <</if>>
    </ul>
  <</if>>
<</widget>>

<<widget 'deadwood-street-heist-status'>>
  <<set _streetHeist to maplebirch.get('StreetLife')?.heist>>
  <<if _streetHeist and _streetHeist.state.stage isnot 'idle'>>
    <div class='gold bold'><<lanSwitch 'The bank job' '银行豪劫'>></div>
    <div><<lanSwitch 'Private meetings and settlement: smugglers’ pub, 9 a.m.–6 p.m.' '私下会面与分账：走私者酒馆，上午九点至下午六点。'>></div>
    <ul class='journal'>
      <li>
        <<switch _streetHeist.state.stage>>
          <<case 'prep'>><<lanSwitch 'Preparing the job.' '正在筹备。'>>
          <<case 'entry'>><<lanSwitch 'The crew is ready to enter the bank.' '同伙已就位，正在接近银行。'>>
          <<case 'challenge'>><<lanSwitch 'An unexpected problem needs your decision.' '行动中出现了变故，等待你作出决定。'>>
          <<case 'vault'>><<lanSwitch 'The job is under way inside the bank.' '银行内的行动正在进行。'>>
          <<case 'escape'>><<lanSwitch 'The crew must get clear of the bank.' '需要离开银行并脱身。'>>
          <<case 'settlement'>><<lanSwitch 'The outcome is ready to settle.' '行动结束，尚待结算。'>>
          <<case 'closed'>>
            <<switch _streetHeist.state.outcome>>
              <<case 'success'>><span class='green'><<lanSwitch 'The job is finished and the shares are settled.' '行动已经结束，所得也已分清。'>></span>
              <<case 'withdrawn'>><<lanSwitch 'You withdrew from the job.' '你已经退出这桩买卖。'>>
              <<case 'reported'>><<lanSwitch 'You handed the information to Grant.' '你把消息交给了格兰特。'>>
              <<case 'sting'>><<lanSwitch 'The operation ended with the police involved.' '行动最终由警方接手。'>>
              <<case 'arrested'>><span class='red'><<lanSwitch 'The operation ended with your arrest.' '行动以你被捕告终。'>></span>
              <<default>><span class='red'><<lanSwitch 'The job failed.' '行动失败了。'>></span>
            <</switch>>
        <</switch>>
      </li>
      <<if _streetHeist.state.approach>>
        <li><<lanSwitch 'Approach: ' '方式：'>><<= _streetHeist.state.approach is 'quiet' ? lanSwitch('Quiet', '隐蔽行事') : lanSwitch('Forceful', '强行闯入')>></li>
      <</if>>
      <<if _streetHeist.state.mickeyReview>>
        <<set _streetReview to _streetHeist.terms.mickey.reviews.find(item => item.id === _streetHeist.state.mickeyReview)>>
        <li><<lanSwitch "Mickey's review: " '米奇复核：'>><span class='green'><<= lanSwitch(_streetReview.name[0], _streetReview.name[1])>></span></li>
      <</if>>
      <<if _streetHeist.state.stage is 'prep'>>
        <li><<lanSwitch 'Preparations: ' '准备事项：'>><span class='teal'><<= _streetHeist.state.preparations.length>></span> / <<= _streetHeist.terms.preparations.length>></li>
        <<for _streetPrep range _streetHeist.terms.preparations>>
          <<if _streetHeist.state.preparations.includes(_streetPrep.id)>>
            <<set _streetChoice to _streetHeist.state.preparationChoices[_streetPrep.id]>>
            <<set _streetMethod to _streetPrep.options.find(item => item.id === _streetChoice?.method)>>
            <li><span class='green'><<= lanSwitch(_streetPrep.name[0], _streetPrep.name[1])>></span><<if _streetMethod>> · <<= lanSwitch(_streetMethod.name[0], _streetMethod.name[1])>><</if>></li>
          <</if>>
        <</for>>

      <</if>>
      <<for _streetCrew range _streetHeist.crew>>
        <li><<icon `'street/' + _streetCrew.heist.role + '.png'`>><<= _streetCrew.heist.role is 'scout' ? lanSwitch('Scout: ', '侦察员：') : lanSwitch('Carrier: ', '搬运员：')>><<= _streetCrew.name>> · <<lanSwitch 'Skill: ' '熟练：'>><span class='teal'><<= _streetCrew.heist.skill>></span> / 1000 · <<lanSwitch 'Share: ' '抽成：'>><span class='gold'><<= _streetCrew.heist.cut>>%</span><<if _streetCrew.heist.status is 'arrested'>> · <span class='red'><<lanSwitch 'in custody' '已被扣留'>></span><</if>></li>
      <</for>>
      <<if _streetHeist.state.vehicle is null>>
        <li><<lanSwitch 'Departure: on foot.' '撤离方式：徒步。'>></li>
      <<elseif _streetHeist.vehicle>>
        <<set _streetModel to _streetHeist.catalog.models.find(item => item.id === _streetHeist.vehicle.model)>>
        <li><<lanSwitch 'Vehicle: ' '接应车辆：'>><<= maplebirch.t(_streetModel.name)>><<if _streetHeist.state.stage is 'prep' and !_streetHeist.vehicleReady>> · <span class='red'><<lanSwitch 'not ready at High Street.' '尚未在商业街就绪。'>></span><</if>></li>
      <<elseif _streetHeist.state.stage is 'prep'>>
        <li class='red'><<lanSwitch 'The selected vehicle is missing. Choose another vehicle or leave on foot.' '选定的车辆已经不在了。请另选车辆，或改为徒步。'>></li>
      <</if>>
    </ul>
  <</if>>
<</widget>>


<<widget 'deadwood-street-heist-arrange'>>
  <<set _streetHeist to maplebirch.get('StreetLife')?.heist>>
  <<if !_streetHeist>><<exit>><</if>>
  <<set _streetHeist.state.feedback to {action:'meeting', outcome:'unavailable', minutes:0, cost:0}>>
  <<if !_streetHeist.available or !_streetHeist.unlocked or !_streetHeist.meetingAvailable or _streetHeist.state.stage isnot 'idle' or _streetHeist.state.appointment>><<exit>><</if>>
  <<set _streetStarted to Time.date.timeStamp, _streetClosing to Time.date.timeStamp + (18 * 60 - Time.hour * 60 - Time.minute) * 60>>
  <<if _streetStarted + 30 * 60 gte _streetClosing>><<set _streetHeist.state.feedback.outcome to 'too_late'>><<exit>><</if>>
  <<endevent>><<pass 30>>
  <<set _streetHeist.state.feedback to {action:'meeting', outcome:'interrupted', minutes:Math.max(0, Math.round((Time.date.timeStamp - _streetStarted) / 60)), cost:0}>>
  <<if _streetHeist.available and _streetHeist.unlocked and _streetHeist.state.stage is 'idle' and !_streetHeist.state.appointment and Time.date.timeStamp lt _streetClosing>>
    <<set _streetHeist.state.appointment to true, _streetHeist.state.feedback.outcome to 'completed'>>
  <</if>>
<</widget>>

<<widget 'deadwood-street-heist-find-crew'>>
  <<set _streetHeist to maplebirch.get('StreetLife')?.heist>>
  <<if !_streetHeist>><<exit>><</if>>
  <<set _streetHeist.state.feedback to {action:'recruitment', outcome:'unavailable', minutes:0, cost:0}>>
  <<if !_streetHeist.available or !_streetHeist.atMeeting or !_streetHeist.meetingAvailable or _streetHeist.state.stage isnot 'prep' or _streetHeist.state.candidates.length or _streetHeist.state.crew.length>><<exit>><</if>>
  <<set _streetStarted to Time.date.timeStamp, _streetClosing to Time.date.timeStamp + (18 * 60 - Time.hour * 60 - Time.minute) * 60>>
  <<if _streetStarted + 15 * 60 gte _streetClosing>><<set _streetHeist.state.feedback.outcome to 'too_late'>><<exit>><</if>>
  <<endevent>><<pass 15>>
  <<set _streetHeist.state.feedback to {action:'recruitment', outcome:'interrupted', minutes:Math.max(0, Math.round((Time.date.timeStamp - _streetStarted) / 60)), cost:0}>>
  <<if !_streetHeist.available or !_streetHeist.atMeeting or _streetHeist.state.stage isnot 'prep' or _streetHeist.state.candidates.length or _streetHeist.state.crew.length or Time.date.timeStamp gte _streetClosing>><<exit>><</if>>
  <<for _streetRecruit range _streetHeist.terms.recruits>>
    <<set _streetKey to 'deadwood_street_heist_' + _streetRecruit.id>>
    <<generateNPC 1 'a'>>
    <<set $NPCList[0].per to _streetKey, $NPCList[0].heist to {role: '', skill: _streetRecruit.skill, cut: _streetRecruit.cut, fee: _streetRecruit.fee}>>
    <<set $NPCList[0].skills.security to _streetRecruit.skill, $NPCList[0].skills.athletics to _streetRecruit.skill>>
    <<saveNPC 0 _streetKey>><<set _streetHeist.state.candidates.push(_streetKey)>><<endevent>>
  <</for>>
  <<set _streetHeist.state.feedback.outcome to 'completed'>>
<</widget>>

:: Deadwood Street Heist Plan
<<set _streetHeist to maplebirch.get('StreetLife')?.heist>>
<<if !_streetHeist?.atMeeting>><<deadwood-street-heist-meeting-required>><<exit>><</if>>
<<set $location to 'underground', $outside to 0>><<unset $bus>><<effects>>
<<deadwood-street-heist-feedback>>
<<if !_streetHeist or !_streetHeist.state.appointment>>
  <<if _streetHeist and !_streetHeist.meetingAvailable>>
    <<lanSwitch 'It is too late or too early to arrange this meeting. Speak to Landry between 9 a.m. and 6 p.m.' '现在太晚或太早，无法安排这次会面。请在上午九点至下午六点之间找兰德里谈。'>><br>
  <<else>>
    <<lanSwitch 'Landry has not arranged this meeting. Agree on a time before discussing the job here.' '兰德里还没有安排这次会面。先约好时间，再在这里谈这桩买卖。'>><br>
  <</if>>

<<elseif ['idle', 'prep'].includes(_streetHeist.state.stage) and !_streetHeist.meetingAvailable>>
  <<language>>
    <<option 'EN'>>
      The arrangements are for daytime. Wren has other business this evening, and there is no joint meeting at Landry's table now. Return between nine in the morning and six in the evening to continue.
    <<option 'CN'>>
      约好的会面是在白天。伦恩今晚另有自己的事，兰德里的桌边现在没有安排三人碰面。请在上午九点至下午六点之间回来继续。
  <</language>><br><br>
  <<deadwood-street-heist-status>>
<<elseif _streetHeist.state.stage is 'idle'>>
  <<language>>
    <<option 'EN'>>
      A wooden partition separates the table from the cavern bar. Landry has come for the agreed meeting and waits until the next table has emptied before setting a folded note in front of you. "You've handled enough work to know when something costs more than it pays. This one might pay rather well. It might also cost you everything."
    <<option 'CN'>>
      木隔墙把桌子与洞穴里的吧台隔开。兰德里按约来到这里，等旁边那桌客人散了，才把一张折好的纸推到你面前。“接过这么多差事，你也该知道，有些钱挣起来未必划算。这笔也许很划算。也许会让你把一切赔进去。”
  <</language>><br><br>
  <<language>>
    <<option 'EN'>>
      Wren arrives for the meeting with a drink already in hand. "Don't look at me. I didn't come to take orders." A chair scrapes across the floor. "I came to hear an offer." Landry does not argue. The three of you discuss a bank inside the financial centre on High Street. Landry would handle the arrangements from this underground pub; Wren would join you for the job. Two more people would be needed, and none of them would work for free.
    <<option 'CN'>>
      伦恩赴约时，手里已经端着一杯酒。“别看我，我可不是来听人差遣的。”椅子划过地面。“我是来听听开价的。”兰德里没有反驳。你们三人谈起商业街金融中心里的银行。兰德里留在地下酒馆安排接应，伦恩与你一起行动，还需要再找两个人。没人会白干。
  <</language>><br><br>
  <<language>>
    <<option 'EN'>>
      "Nothing has happened yet," Landry says, taking the note back. "Say no, and we leave it there." Wren raises the glass a little. "Say yes, and we agree on our shares before anyone gets brave."
    <<option 'CN'>>
      “现在还什么都没做。”兰德里把纸收回手边。“不想接，就到此为止。”伦恩稍稍举起酒杯。“要接，就先把分成谈清楚，别急着逞能。”
  <</language>><br><br>
  <span class='red'><<lanSwitch 'This is a robbery. Accepting starts preparations; entering the bank for the job creates evidence against you. Violence can create further evidence, and you can be arrested.' '这是一起抢劫。接下后开始筹备，正式进入银行实施行动会留下犯罪证据。暴力行为可能留下更多罪证，也可能导致被捕。'>></span><br><br>
  <<if _streetHeist.available and _streetHeist.unlocked and _streetHeist.meetingAvailable>>
    <<icon 'street/heist-plan.png'>><<lanLink ['Agree to prepare the job', '同意筹备这桩买卖'] 'Deadwood Street Heist Plan'>>
      <<if _streetHeist.available and _streetHeist.unlocked and _streetHeist.meetingAvailable and _streetHeist.state.appointment and _streetHeist.state.stage is 'idle'>>
        <<endevent>><<set _streetHeist.state.stage to 'prep'>>
      <</if>>
    <</lanLink>><br>
  <<else>>
    <span class='blue'><<lanSwitch 'You cannot make this commitment just now. Finish your current work and return when the others are ready to work with you.' '你眼下无法接下这桩买卖。先处理手头的差事，等双方都有意合作时再谈。'>></span><br>
  <</if>>
  <<refuseicon>><<lanLink ['Decline the offer', '拒绝这份提议'] 'Smuggler Pub'>><<endevent>><<if _streetHeist>><<set _streetHeist.state.activity to '', _streetHeist.state.candidate to ''>><</if>><</lanLink>><br>
<<elseif _streetHeist.state.stage is 'prep'>>
  <<language>>
    <<option 'EN'>>
      The folded notes are still at Landry's table. Wren has left a few additions, and a separate figure beside the proposed share. "Everyone gets paid for their part," Landry says. "You decide how to proceed. I'll arrange what we've agreed to."
    <<option 'CN'>>
      折好的笔记还放在兰德里的桌上。伦恩补了几条意见，也在分成旁另写了一个数字。“各拿各的那一份。”兰德里说。“你决定怎么做，我安排谈好的事。”
  <</language>><br><br>
  <<deadwood-street-heist-status>>
  <<if _streetHeist.available>>
    <div class='gold bold'><<lanSwitch 'Approach' '行动方式'>></div>
    <<language>>
      <<option 'EN'>>
        A quiet approach gives the crew a chance to avoid a confrontation. A forceful approach means resistance from the start. Neither makes the job lawful.
      <<option 'CN'>>
        隐蔽行事有机会避开正面冲突，强行闯入则一开始就会遭到抵抗。无论哪一种，都不是合法差事。
    <</language>><br>
    <<for _streetApproach range ['quiet', 'loud']>>
      <<capture _streetHeist _streetApproach>>
        <<if _streetHeist.state.approach is _streetApproach>>
          <span class='gold'><<= _streetApproach is 'quiet' ? lanSwitch('Quiet', '隐蔽行事') : lanSwitch('Forceful', '强行闯入')>></span>
        <<else>>
          <<lanLink `_streetApproach === 'quiet' ? ['Choose a quiet approach', '选择隐蔽行事'] : ['Choose a forceful approach', '选择强行闯入']` 'Deadwood Street Heist Plan'>>
            <<if _streetHeist.available and _streetHeist.state.stage is 'prep'>><<set _streetHeist.state.approach to _streetApproach>><</if>>
          <</lanLink>>
        <</if>><<if _streetApproach is 'quiet'>> | <</if>>
      <</capture>>
    <</for>><br><br>

    <div class='gold bold'><<lanSwitch 'Preparations' '准备事项'>></div>
    <<language>>
      <<option 'EN'>>
        Landry leaves the papers within reach. "Paying for a box doesn't mean you know what's in it. Make sure you do." Wren taps the empty places beside the names. "And find the other two before asking me to rehearse with ghosts."
      <<option 'CN'>>
        兰德里把纸留在你伸手可及的地方。“花钱买来一箱东西，不等于你知道里面有什么。最好弄清楚。”伦恩点了点名字旁边的空白。“还有，先把另外两个人找来。别让我跟空气排演。”
    <</language>><br><br>
    <<for _streetPrep range _streetHeist.preparations>>
      <<capture _streetHeist _streetPrep>>
        <<icon _streetPrep.icon>><<= lanSwitch(_streetPrep.name[0], _streetPrep.name[1])>>：
        <<if _streetHeist.state.preparations.includes(_streetPrep.id)>>
          <<set _streetChoice to _streetHeist.state.preparationChoices[_streetPrep.id]>>
          <<set _streetMethod to _streetPrep.options.find(item => item.id === _streetChoice?.method)>>
          <span class='green'><<lanSwitch 'completed' '已完成'>></span><<if _streetMethod>> · <<= lanSwitch(_streetMethod.name[0], _streetMethod.name[1])>><</if>>
        <<elseif _streetPrep.place is 'bank'>>
          <span class='blue'><<lanSwitch 'Visit the financial centre bank counter on High Street during its opening hours.' '营业时到商业街金融中心的银行柜台查看。'>></span>
        <<elseif _streetPrep.id is 'rehearsal' and !_streetHeist.crewReady>>
          <span class='grey'><<lanSwitch 'Hire one person for each role first, and make sure both are fit to take part.' '先分别聘好两种角色，并确认两人都能够参加。'>></span>
        <<else>>
          <<lanLink ['Work through this with the crew', '与同伙一起落实这项准备'] 'Deadwood Street Heist Preparation'>>
            <<if _streetHeist.available and _streetHeist.state.stage is 'prep' and _streetHeist.meetingAvailable and !_streetHeist.state.preparations.includes(_streetPrep.id) and (_streetPrep.id isnot 'rehearsal' or _streetHeist.crewReady)>>
              <<endevent>><<set _streetHeist.state.activity to _streetPrep.id, _streetHeist.state.feedback to null>>
              <<if _streetPrep.id is 'rehearsal'>>
                <<for _streetCrewIndex = 0; _streetCrewIndex lt _streetHeist.state.crew.length; _streetCrewIndex++>>
                  <<loadNPC _streetCrewIndex `_streetHeist.state.crew[_streetCrewIndex]`>>
                <</for>>
              <</if>>
            <</if>>
          <</lanLink>>
        <</if>><br>
      <</capture>>
    <</for>><br>
    <<if _streetHeist.conditionPenalty gte 10>>
      <span class='orange'><<lanSwitch 'You are not at your best. Take care of yourself before committing to the remaining work.' '你现在的状态不太好。落实剩余准备前，先照顾好自己。'>></span><br><br>
    <</if>>

    <div class='gold bold'><<lanSwitch 'Crew' '雇用同伙'>></div>
    <<language>>
      <<option 'EN'>>
        You need one scout and one carrier. A hire charges an advance as well as a share of the haul. The advance pays for their time even if you later withdraw.
      <<option 'CN'>>
        你需要一名侦察员和一名搬运员。人手先收一笔定金，事成后再抽成。即便之后退出，定金也不会退还。
    <</language>><br>
    <<if !_streetHeist.state.candidates.length and !_streetHeist.state.crew.length and 18 * 60 - Time.hour * 60 - Time.minute gt 15>>
      <<socialiseicon 'ask'>><<lanLink ['Ask Landry to introduce three candidates (0:15)', '请兰德里介绍三个人选 (0:15)'] 'Deadwood Street Heist Plan'>>
        <<if _streetHeist.available and _streetHeist.state.stage is 'prep' and _streetHeist.meetingAvailable and !_streetHeist.state.candidates.length and !_streetHeist.state.crew.length>>
          <<deadwood-street-heist-find-crew>>
        <</if>>
      <</lanLink>><br>
    <<elseif !_streetHeist.state.candidates.length and !_streetHeist.state.crew.length>>
      <span class='grey'><<lanSwitch 'Ask Landry to introduce three candidates (0:15)' '请兰德里介绍三个人选 (0:15)'>></span> · <span class='blue'><<lanSwitch 'Not enough opening time left.' '剩余营业时间不足。'>></span><br>
    <</if>>
    <<for _streetCandidate range _streetHeist.candidates>>
      <<set _streetKey to _streetCandidate.per>>
      <<capture _streetHeist _streetKey _streetCandidate>>
        <<socialiseicon 'ask'>><<lanLink `[_streetCandidate.name, _streetCandidate.name]` 'Deadwood Street Heist Candidate'>>
          <<if _streetHeist.available and _streetHeist.state.stage is 'prep' and _streetHeist.meetingAvailable and _streetHeist.state.candidates.includes(_streetKey) and $per_npc[_streetKey]>>
            <<endevent>><<set _streetHeist.state.candidate to _streetKey, _streetHeist.state.feedback to null>><<loadNPC 0 _streetKey>>
          <</if>>
        <</lanLink>> · <<lanSwitch 'Skill: ' '熟练：'>><span class='teal'><<= _streetCandidate.heist.skill>></span> / 1000 · <<lanSwitch 'Advance: ' '定金：'>><<printmoney _streetCandidate.heist.fee>> · <<lanSwitch 'Share: ' '抽成：'>><span class='gold'><<= _streetCandidate.heist.cut>>%</span><br>
      <</capture>>
    <</for>><br>
    <<if _streetHeist.crew.length is 2>>
      <<if !_streetHeist.state.preparations.includes('rehearsal')>>
        <<socialiseicon 'ask'>><<lanLink ['Exchange the crew roles', '交换两人的分工'] 'Deadwood Street Heist Plan'>>
          <<if _streetHeist.available and _streetHeist.state.stage is 'prep' and _streetHeist.meetingAvailable and _streetHeist.crew.length is 2 and !_streetHeist.state.preparations.includes('rehearsal')>>
            <<for _streetCrew range _streetHeist.crew>><<set _streetCrew.heist.role to _streetCrew.heist.role is 'scout' ? 'carrier' : 'scout'>><</for>>
          <</if>>
        <</lanLink>><br>
      <<else>>
        <span class='blue'><<lanSwitch 'The crew has rehearsed these roles and will keep them for the job.' '两人已经按当前分工排演，行动时会各司其职。'>></span><br>
      <</if>>
      <<lanSwitch 'Agreed shares: ' '约定分成：'>><<= maplebirch.auto('Landry')>> <span class='gold'><<= _streetHeist.split.landry>>%</span> · <<= maplebirch.auto('Wren')>> <span class='gold'><<= _streetHeist.split.wren>>%</span> · <<lanSwitch 'crew ' '雇员 '>><span class='gold'><<= _streetHeist.split.crew>>%</span> · <<lanSwitch 'you ' '你 '>><span class='gold'><<= _streetHeist.split.pc>>%</span><br>
    <</if>><br>

    <div class='gold bold'><<lanSwitch 'Departure' '撤离安排'>></div>
    <<language>>
      <<option 'EN'>>
        You can leave on foot. For a vehicle, park your own roadworthy car on High Street, with enough fuel and room for Wren and both hires. The driver must have a licence and be fit to drive.
      <<option 'CN'>>
        可以徒步离开。若要用车，请把自己的汽车停在商业街，备足燃油，并为伦恩和两名雇员留出乘客座位。你也要有驾照，并处于能够驾驶的状态。
    <</language>><br>
    <<if _streetHeist.state.vehicle is null>>
      <span class='gold'><<lanSwitch 'On foot' '徒步'>></span><br>
    <<else>>
      <<getouticon>><<lanLink ['Leave on foot', '选择徒步'] 'Deadwood Street Heist Plan'>>
        <<if _streetHeist.available and _streetHeist.state.stage is 'prep'>><<set _streetHeist.state.vehicle to null>><</if>>
      <</lanLink>><br>
    <</if>>
    <<for _streetVehicle range _streetHeist.vehicles>>
      <<set _streetModel to _streetHeist.catalog.models.find(item => item.id === _streetVehicle.model)>>
      <<capture _streetHeist _streetVehicle _streetModel>>
        <<icon `'transport/' + _streetModel.id + '.png'`>>
        <<if _streetHeist.state.vehicle is _streetVehicle.id>>
          <span class='gold'><<= maplebirch.t(_streetModel.name)>></span>
        <<else>>
          <<lanLink `[maplebirch.t(_streetModel.name), maplebirch.t(_streetModel.name)]` 'Deadwood Street Heist Plan'>>
            <<if _streetHeist.available and _streetHeist.state.stage is 'prep' and _streetHeist.vehicles.some(item => item.id === _streetVehicle.id)>><<set _streetHeist.state.vehicle to _streetVehicle.id>><</if>>
          <</lanLink>>
        <</if>><br>
      <</capture>>
    <</for>><br>
    <<if _streetHeist.ready>>
      <span class='green'><<lanSwitch 'The preparations are agreed. Go to the bank counter inside the financial centre on High Street to begin. You can still decide against entering.' '准备事项已经谈妥。到商业街金融中心的银行柜台开始行动，正式进入前仍可以反悔。'>></span><br>
    <<else>>
      <span class='blue'><<lanSwitch 'Choose an approach, finish all three preparations, and hire one person for each role before beginning. A selected vehicle must also remain ready on High Street.' '先选择方式，完成三项准备，并分别聘好两个角色。若选了车辆，车也要仍在商业街就绪。'>></span><br>
    <</if>><br>
    <<refuseicon>><<lanLink ['Withdraw from the job', '退出这桩买卖'] 'Deadwood Street Heist Plan'>>
      <<if _streetHeist.available and _streetHeist.state.stage is 'prep'>>
        <<endevent>><<set _streetHeist.state.stage to 'closed', _streetHeist.state.outcome to 'withdrawn', _streetHeist.state.settled to true, _streetHeist.state.activity to '', _streetHeist.state.candidate to ''>>
      <</if>>
    <</lanLink>><br>
  <<else>>
    <span class='blue'><<lanSwitch 'Finish your current business before changing these arrangements.' '先处理手头的事，再改变这里的安排。'>></span><br>
  <</if>>
<<else>>
  <<deadwood-street-heist-status>>
  <<if _streetHeist.inAction>>
    <span class='blue'><<lanSwitch 'The job has begun. Return to the financial centre bank counter on High Street to continue; these preparations can no longer be changed.' '行动已经开始。到商业街金融中心的银行柜台继续。这里的准备事项已经不能更改。'>></span><br>
  <<elseif _streetHeist.state.stage is 'settlement'>>
    <<if ['reported', 'sting'].includes(_streetHeist.state.outcome)>>
      <span class='blue'><<lanSwitch 'Speak to Grant at the police station to settle the verified outcome.' '到警局找格兰特，结算核实后的结果。'>></span><br>
    <<elseif _streetHeist.available and _streetHeist.meetingAvailable>>
      <<socialiseicon 'ask'>><<lanLink ['Review the outcome with Landry', '与兰德里核对结果'] 'Deadwood Street Heist Debrief'>><<endevent>><</lanLink>><br>
    <</if>>
  <</if>>
<</if>><br>
<<if _streetHeist?.businessCrew.length and _streetHeist.meetingAvailable and maplebirch.get('StreetLife').jobs.available>>
  <<socialiseicon 'ask'>><<lanLink ['Ask the former crew about warehouse and delivery work', '向原班雇员打听仓储与送货差事'] 'Deadwood Street Heist Contacts'>><<endevent>><</lanLink>><br>
<</if>>
<<getouticon>><<lanLink ['Return to the smugglers’ pub', '回到走私者酒馆'] 'Smuggler Pub'>><<endevent>><<if _streetHeist>><<set _streetHeist.state.activity to '', _streetHeist.state.candidate to ''>><</if>><</lanLink>><br>

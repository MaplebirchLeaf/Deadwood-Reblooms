:: Deadwood BirdTower Hunt End Food
<<effects>>
<<set _childrenIds to $BirdTower.feeding.waiting>>
<<set _childrenTotal to _childrenIds.length>>
<<if $BirdTower.feeding.ids.some(id => $childRecords[id].development.grow_hint_fledgling is 1 or $childRecords[id].development.grow_hint_subadult is 1)>>
  <span class="blue">
    <<language>>
      <<option 'EN'>>
        As you come near the nest, the begging chatter is louder than it used to be. The children seem to have grown a little hungrier.
      <<option 'CN'>>
        你靠近巢时，乞食的叽喳声比过去还要响亮。孩子们的食量似乎增加了一些。
    <</language>>
  </span>
  <br>
<</if>>
<<set _fedIds to $BirdTower.feeding.ids>>
<<if _fedIds.length>>
  <<language>>
    <<option 'EN'>>
      You feed the lurkers to
      <<if _fedIds.length gte 10>>
        the children
      <<else>>
        <<childrenNames _fedIds>>
      <</if>>
      in the nest.
    <<option 'CN'>>
      你将潜伏者喂给了巢里的
      <<if _fedIds.length gte 10>>
        孩子们
      <<else>>
        <<childrenNames _fedIds>>
      <</if>>
      。
  <</language>>
  <<if _fedIds.length is 1>>
    <<childSelect _fedIds[0]>>
    <<language>>
      <<option 'EN'>>
        <<if $cmonster>>
          <<childHe>> takes the meat with <<childhis>> small hands, and <<childhis>> excited chirps and giggles quiet down into happy chewing.
        <<else>>
          <<childHe>> snaps up the meat with <<childhis>> beak, flapping <<childhis>> wings in delight as <<childhis>> begging calls quiet down.
        <</if>>
      <<option 'CN'>>
        <<if $cmonster>>
          <<childHe>>用稚嫩的小手接过肉条，兴奋的唧唧叫和咯咯笑声渐渐平息，开心地小口咀嚼起来。
        <<else>>
          <<childHe>>张大雏喙叼住肉条，欢快地扑棱着毛茸茸的翅膀，乞食的尖鸣渐渐安静下来，开始开心地进食。
        <</if>>
    <</language>>
  <<else>>
    <<language>>
      <<option 'EN'>>
        The children's chirps and screeches quiet down, and they start eating happily.
      <<option 'CN'>>
        孩子们的唧唧叫和尖鸣安静下来，他们开始开心地进食。
    <</language>>
  <</if>>
  <br><br>
<<elseif !_childrenTotal>>
  <<language>>
    <<option 'EN'>>
      The children have eaten enough for today.
    <<option 'CN'>>
      孩子们今天已经吃饱了。
  <</language>>
  <br><br>
<<elseif $bird.materials.lurkers gt 0>>
  <<language>>
    <<option 'EN'>>
      The lurkers you hunted are not enough for every child.
    <<option 'CN'>>
      你猎到的潜伏者不够所有孩子吃。
  <</language>>
  <br><br>
  <<deadwood-birdtower-feeding-options _childrenIds>>
  <<lanLink ['Divide evenly among all the children', '给所有孩子平均分配'] 'Deadwood BirdTower FoodForAll'>>
    <<deadwood-birdtower-feed 'share'>>
  <</lanLink>>
  <br>
<<else>>
  <<language>>
    <<option 'EN'>>
      You have no more lurkers on hand.
    <<option 'CN'>>
      你手上没有更多潜伏者了。
  <</language>>
  <br><br>
<</if>>
<<if _fedIds.length and maplebirch.get('BirdTower').hungry.length and $bird.materials.lurkers gt 0>>
  <<lanLink ['Feed another meal', '再喂一餐'] 'Deadwood BirdTower Hunt End Food'>>
    <<deadwood-birdtower-feed>>
  <</lanLink>><br>
<</if>>
<<deadwood-birdtower-feeding-receipt>>
<<lanLink ['Continue', '继续'] 'Bird Tower'>>
  <<endevent>>
<</lanLink>>

:: Deadwood BirdTower FoodForOne
<<set _fedIds to $BirdTower.feeding.ids>>
<<if _fedIds.length>>
  <<childSelect _fedIds[0]>>
  <<language>>
    <<option 'EN'>>
      <<if $cmonster>>
        You feed the lurker to <<childname>>. <<childHe>> takes the chunk of meat with <<childhis>> small hands and <<print either('starts eating quietly', 'swallows it down eagerly', 'giggles happily while nibbling on it')>>.
      <<else>>
        You feed the lurker to <<childname>>. <<childHe>> snaps up the chunk of meat with <<childhis>> beak and <<print either('starts eating quietly', 'gulps it down almost in one go', 'flaps <<childhis>> wings excitedly while eating')>>.
      <</if>>
    <<option 'CN'>>
      <<if $cmonster>>
        你把潜伏者喂给了<<childname>>。<<childHe>>伸出小手接过肉块，<<print either('安静地开始进食', '迫不及待地大口吞下', '一边咯咯笑着一边开心地小口啃食')>>。
      <<else>>
        你把潜伏者喂给了<<childname>>。<<childHe>>张开喙迅速衔住肉块，<<print either('安静地开始进食', '几乎一仰头就吞了下去', '一边兴奋地扑腾翅膀一边开心地进食')>>。
      <</if>>
  <</language>>
  <<if $BirdTower.feeding.waiting.some(id => id isnot _fedIds[0])>>
    <<language>>
      <<option 'EN'>>
        The other children watch you feed <<childhim>>, <<print either('shrieking and begging', 'shoving one another for a turn', 'their beaks wide open', 'fluttering their wings eagerly')>>, and then cry even louder.
      <<option 'CN'>>
        其他的孩子<<print either('尖叫着争抢乞食', '推搡着想要轮到自己', '张大了雏喙', '焦急地扑腾着稚嫩的羽翼')>>看着你喂食<<childhim>>，随后叫唤得更响亮了。
    <</language>>
    <<gstress>>
  <</if>>
  <br><br>
<<else>>
  <<language>>
    <<option 'EN'>>
      There is no food to give, or your child has already eaten enough.
    <<option 'CN'>>
      没有可以喂食的食物，或孩子已经吃饱了。
  <</language>>
  <br><br>
<</if>>
<<set _childrenIds to maplebirch.get('BirdTower').hungry.map(child => child.childId)>>
<<if _childrenIds.length and $bird.materials.lurkers gt 0>>
  <<language>>
    <<option 'EN'>>
      Some children still need another meal.
    <<option 'CN'>>
      有些孩子还需要再吃一餐。
  <</language>>
  <br>
  <<deadwood-birdtower-feeding-options _childrenIds>>
<</if>>
<<deadwood-birdtower-feeding-receipt>>
<<lanLink ['Continue', '继续'] 'Bird Tower'>>
  <<endevent>>
<</lanLink>>

:: Deadwood BirdTower FoodForAll
<<set _fedIds to $BirdTower.feeding.ids>>
<<if _fedIds.length>>
  <<language>>
    <<option 'EN'>>
      You tear the lurker into little strips of meat and divide them evenly among the children.
    <<option 'CN'>>
      你把潜伏者撕成一条一条的小肉条，平均地分给了所有孩子。
  <</language>>
  <<if $BirdTower.feeding.waiting.length>>
    <<language>>
      <<option 'EN'>>
        The children's calls quiet down for a short while, but soon rise again.
      <<option 'CN'>>
        孩子们的鸣叫声短暂地安静了一小会儿，但很快又响了起来。
    <</language>>
    <<gstress>>
    <br><br>
    <span class="blue">
      <<language>>
        <<option 'EN'>>
          They need more food to satisfy today's appetite.
        <<option 'CN'>>
          他们还需要更多食物才能填饱肚子。
      <</language>>
    </span>
  <<else>>
    <<language>>
      <<option 'EN'>>
        The children crowd together around the strips of meat. Flapping their downy wings and nudging one another contentedly, their noisy screeches soften into satisfied chirps and quiet trills as they finish their meal.
      <<option 'CN'>>
        孩子们挤在肉条旁。他们欢快地扑腾着毛茸茸的翅膀，满足地互相依偎蹭碰，喧闹的乞食叫喊渐渐化作心满意足的啼鸣与欢快声响，开心地享用着这顿美餐。
    <</language>>
  <</if>>
  <br><br>
<<else>>
  <<language>>
    <<option 'EN'>>
      There is no food to give, or the children have already eaten enough.
    <<option 'CN'>>
      没有可以喂食的食物，或孩子们已经吃饱了。
  <</language>>
  <br><br>
<</if>>
<<deadwood-birdtower-feeding-receipt>>
<<lanLink ['Continue', '继续'] 'Bird Tower'>>
  <<endevent>>
<</lanLink>>

:: Deadwood BirdTower Feeding Options [widget]
<<widget 'deadwood-birdtower-feeding-options'>>
  <<for _feedId range _args[0]>>
    <<capture _feedId>>
      <<lanLink `['Feed ' + $childRecords[_feedId].name, '给' + $childRecords[_feedId].name + '吃']` 'Deadwood BirdTower FoodForOne'>>
        <<deadwood-birdtower-feed _feedId>>
      <</lanLink>>
      <br>
    <</capture>>
  <</for>>
<</widget>>

<<widget 'deadwood-birdtower-feed'>>
  <!-- 仅用于玩家点击体：正文重绘只显示 feeding 回执。 -->
  <<run maplebirch.get('BirdTower').feed(_args[0] ?? 'all')>>
  <<if $BirdTower.feeding.ids.length and ((_args[0] is 'share' and $BirdTower.feeding.waiting.length) or (Number.isInteger(_args[0]) and $BirdTower.feeding.waiting.some(id => id isnot _args[0])))>>
    <<stress 3>>
  <</if>>
<</widget>>

<<widget 'deadwood-birdtower-feeding-receipt'>>
  <<if $BirdTower.feeding.spent gt 0>>
    <span class="blue">
      <<language>>
        <<option 'EN'>>
          Lurkers used: <<print $BirdTower.feeding.spent>>. Nest stock after feeding: <<print $BirdTower.feeding.remaining>>.
        <<option 'CN'>>
          使用潜伏者：<<print $BirdTower.feeding.spent>>。喂食后巢内剩余：<<print $BirdTower.feeding.remaining>>。
      <</language>>
    </span><br><br>
  <</if>>
<</widget>>

:: Deadwood BirdTower Hunt Accept []
<<language>>
  <<option 'EN'>>
    You nod, and <<babyhawks>> burst into a delighted cheer.
  <<option 'CN'>>
    你点点头，<<babyhawks>>爆发出一阵喜悦的欢呼声。
<</language>>
<<if ($bird.activity is "sing" or $bird.activity is "groom") and $bird.state is "home">>
  <!-- 大鹰目击的反应，现在直接套用原文改了一下你→你们，要写专门的差分吗？ -->
  <<if $bird.injured gte 1>>
    <<language>>
      <<option 'EN'>>
        <<beasttype>> stirs.
      <<option 'CN'>>
        <<beasttype>>动了动。
    <</language>>
    <<if $monster is 1>>
      <<language>>
        <<option 'EN'>>
          "Good hunting," <<bhe>> tries to hide a hint of shame in <<bhis>> voice, "come back early."
        <<option 'CN'>>
          "狩猎愉快，"<<bhe>>试图掩藏自己声音里的一点点羞愧，"早点回来。"
      <</language>>
    <<else>>
      <<language>>
        <<option 'EN'>>
          As you near the edge of the perch, <<bHe>> chatters shamefacedly, wishing your hunt well.
        <<option 'CN'>>
          在你接近栖木边缘时，<<bHe>>羞愧地叽喳叫起来，祝愿你们的狩猎能够顺利。
      <</language>>
    <</if>>
  <<else>>
    <<language>>
      <<option 'EN'>>
        <<beasttype>> stirs.
      <<option 'CN'>>
        <<beasttype>>动了动。
    <</language>>
    <<if $monster is 1>>
      <<if Time.dayState is "night">>
        <<set $daily.birdNightWarning to true>>
        <<language>>
          <<option 'EN'>>
            "Hunting at night? It will be hard, good luck," <<bhe>> says, "come back early."
          <<option 'CN'>>
            "在晚上打猎吗？会很难，祝你们好运，"<<bhe>>说，"早点回来。"
        <</language>>
      <<else>>
        <<language>>
          <<option 'EN'>>
            "Good luck with the hunt," <<bhe>> says, "come back early."
          <<option 'CN'>>
            "祝你们狩猎顺利，"<<bhe>>说，"早点回来。"
        <</language>>
      <</if>>
    <<else>>
      <<language>>
        <<option 'EN'>>
          As you walk to the edge of the perch, <<bhe>> calls out, wishing you good hunting.
        <<option 'CN'>>
          当你走近栖木的边缘时，<<bhe>>发出了鸣叫声，祝你们打猎顺利。
      <</language>>
    <</if>>
  <</if>>
  <br><br>
<</if>>
<<language>>
  <<option 'EN'>>
    <<babyhawksthem>> spread their wings and leap from the tower after you.
  <<option 'CN'>>
    <<babyhawksthem>>跟随着你张开翅膀从塔上跃下。
<</language>>
<br><br>
<<lanLink ["Continue", "继续"] "Deadwood BirdTower Hunt Goal">>
  <<endevent>>
<</lanLink>>
<br>
:: Deadwood BirdTower Hunt Refuse []
<<language>>
  <<option 'EN'>>
    You shake your head and refuse <<babyhawksthem>>. <<babyhawks>> cling to your arm and grumble in displeasure, then let you go.
  <<option 'CN'>>
    你摇了摇头，拒绝了<<babyhawksthem>>。<<babyhawks>>抱着你的胳膊发出一阵不满的抱怨声，放你离开了。
<</language>>
<br><br>
<<lanLink ["Continue", "继续"] "Bird Hunt Start Alone">>
  <<HuntTogetherClean>>
<</lanLink>>
<br>
:: Deadwood BirdTower Hunt Goal []
<<set $outside to 1>>
<<set $location to "moor">>
<<effects>><<flight_effects>>
<<if !$bird.hunts.loot>>
  <<set $bird.hunts.loot to {}>>
  <<set $bird.hunts.lootAmount to 0>>
  <<set $bird.hunts.weight to (Weather.precipitation is "rain" ? 1 : 0)>>
  <<set $bird.hunts.goal to "">>
  <<set $bird.hunts.direction to "">>
  <<set $bird.hunts.distanceNorth to 0>>
  <<set $bird.hunts.distanceEast to 0>>
  <<set $bird.hunts.timer to 0>>
  <<set $moor to 40>>
  <<hawks_leader_select>>
<</if>>
<<if $phase is 1>>
  <<language>>
    <<option 'EN'>>
      You decide to look for something else to hunt.
    <<option 'CN'>>
      你决定另找其它目标。
  <</language>>
<<elseif $phase is 2>>
  <<language>>
    <<option 'EN'>>
      You ask your children whether you can hunt something else.
    <<option 'CN'>>
      你问你的孩子，你们能否猎点其他东西。
  <</language>>
<<else>>
  <<language>>
    <<option 'EN'>>
      You ride the wind high in the sky.
    <<option 'CN'>>
      你乘着风飞在高空中。
  <</language>>
  <<if Weather.precipitation is "rain">>
    <<lanSwitch 'The rain makes resisting harder, but you press on.' '雨让你的反抗更加困难，但你还是坚持着。'>><<gtiredness>><<tiredness 2>>
  <</if>>
<</if>>
<br><br>
<<language>>
  <<option 'EN'>>
    What do you plan to hunt?
  <<option 'CN'>>
    你打算猎点什么？
<</language>>
<br>
<<if $bird.hunts.lurkers is true>>
  <<lanLink ["Lurkers", "潜伏者"] "Deadwood BirdTower Hunt Direction">>
    <<set $bird.hunts.goal to "lurkers">>
  <</lanLink>>
  <br>
<</if>>
<<if $bird.hunts.materials is true>>
  <<lanLink ["Materials", "材料"] "Deadwood BirdTower Hunt Direction">>
    <<set $bird.hunts.goal to "materials">>
  <</lanLink>>
  <br>
<</if>>
<<if $bird.hunts.valuables is true>>
  <<lanLink ["Valuables", "贵重物品"] "Deadwood BirdTower Hunt Direction">>
    <<set $bird.hunts.goal to "valuables">>
  <</lanLink>>
  <br>
<</if>>
<<lanLink ["Let your children decide", "让你的孩子做决定"] "Deadwood BirdTower Hunt Direction">>
  <<set $bird.hunts.goal to "babyhawk">>
<</lanLink>>
<br>
<<set $phase to 0>>

:: Deadwood BirdTower Hunt Direction []
<<effects>><<flight_effects>><<childSelect $BirdTower.hunt.leader>>
<<lanSwitch 'You tell ' '你告诉'>><<= $cmonster ? lanSwitch("the little harpy", "小哈比") : lanSwitch("the little hawk", "小鹰")>><<if maplebirch.get('BirdTower').party.length gt 1>><<lanSwitch "s" "们">><</if>><<lanSwitch ' that you want to ' '，你想'>>
<<switch $bird.hunts.goal>>
  <<case "lurkers">>
    <<lanSwitch 'look for suitable prey to hunt. The mention of prey excites ' '找一些合适的猎物来捕猎。猎物的关键词让'>><<babyhawksthem>><<lanSwitch '.' '激动起来。'>>
  <<case "materials">>
    <<lanSwitch 'look for good things you could use to upgrade the tower.' '找些能用来升级高塔的好东西。'>>
  <<case "valuables">>
    <<lanSwitch 'look for shiny things.' '找些亮闪闪的东西。'>>
  <<case "babyhawk">>
    <<lanSwitch 'follow ' '跟着'>><<babyhawksthem>><<lanSwitch '. You beat your wings and circle around ' '。你扇动翅膀绕着'>><<babyhawks>><<lanSwitch ', then stop and wait to see what ' '飞行，随后停下等待'>><<babyhawksthem>><<lanSwitch ' will do.' '的动作。'>>
<</switch>>
<br><br>
<<flight_time_check 20 "silent">>
<<if $bird.hunts.goal is "babyhawk">>
  <<if maplebirch.get('BirdTower').party.length gt 1>><<lanSwitch 'The children chatter noisily, and in the end, ' '孩子们唧唧喳喳地吵闹起来，最终，'>><</if>>
  <<set _directionPool to []>>
  <<if $bird.hunts.distanceNorth lt 5 and $bird.hunts.distanceNorth isnot -1>>
    <<run _directionPool.pushUnique("north")>>
  <</if>>
  <<if $bird.hunts.distanceEast lt 5 and $bird.hunts.distanceEast isnot -1>>
    <<run _directionPool.pushUnique("east")>>
  <</if>>
  <<if $bird.hunts.distanceNorth gt -5 and $bird.hunts.distanceNorth isnot 1>>
    <<run _directionPool.pushUnique("south")>>
  <</if>>
  <<if $bird.hunts.distanceEast gt -5 and $bird.hunts.distanceEast isnot 1>>
    <<run _directionPool.pushUnique("west")>>
  <</if>>
  <<set $bird.hunts.direction to _directionPool.pluck()>>
  <<if maplebirch.get('BirdTower').leaderTrait is "dominant">>
    <<childname>><<lanSwitch ' screeches back at you and flies ' '尖鸣着回应你，向'>><<print $bird.hunts.direction.replace("north", lanSwitch("north", "北")).replace("south", lanSwitch("south", "南")).replace("west", lanSwitch("west", "西")).replace("east", lanSwitch("east", "东"))>><<lanSwitch '. ' '飞去。'>><<if maplebirch.get('BirdTower').party.length gt 1>><<lanSwitch 'The other children catch up with ' '其他孩子追上了'>><<childhe>><<lanSwitch '.' '。'>><</if>>
  <<elseif maplebirch.get('BirdTower').leaderTrait is "clever">>
    <<childname>><<lanSwitch ' screeches back at you, ' '尖鸣着回应你，'>><<if maplebirch.get('BirdTower').party.length gt 1>><<childhe>><<lanSwitch ' turns to chatter at the other children, and ' '转过头冲着其他孩子叽喳几声，'>><</if>><<lanSwitch 'then starts flying ' '然后开始向'>><<print $bird.hunts.direction.replace("north", lanSwitch("north", "北")).replace("south", lanSwitch("south", "南")).replace("west", lanSwitch("west", "西")).replace("east", lanSwitch("east", "东"))>><<lanSwitch '.' '飞去。'>>
  <<else>>
    <<babyhawksthem>><<lanSwitch ' stares back at you blankly. ' '茫然地回望你。'>><<childname>><<lanSwitch ' looks around, then picks the ' '四下张望，随后选中了'>><<print $bird.hunts.direction.replace("north", lanSwitch("north", "北")).replace("south", lanSwitch("south", "南")).replace("west", lanSwitch("west", "西")).replace("east", lanSwitch("east", "东"))>><<lanSwitch ' side. ' '边。'>><<if maplebirch.get('BirdTower').party.length gt 1>><<lanSwitch 'The other children seem fine with it and follow ' '其他孩子看起来没有意见，跟着'>><<childhe>><<lanSwitch ' in flight.' '飞行。'>><</if>>
  <</if>>
  <<switch $bird.hunts.direction>>
    <<case "north">>
      <<set $bird.hunts.distanceNorth++>>
    <<case "east">>
      <<set $bird.hunts.distanceEast++>>
    <<case "south">>
      <<set $bird.hunts.distanceNorth-->>
    <<case "west">>
      <<set $bird.hunts.distanceEast-->>
  <</switch>>
  <<babyhawk_loot_select>>
  <br><br>
  <<lanLink `["Continue" + " (" + getTimeString(_hoursPassed, _minutesPassed) + ")", "继续" + " (" + getTimeString(_hoursPassed, _minutesPassed) + ")"]` "Deadwood BirdTower Hunt Event">>
    <<set $fatigueMod to _fatigueMod>>
    <<set $flightTime to _flightTime>>
    <<bird_pass _flightTime>>
    <<endevent>>
  <</lanLink>>
  <<print _fatigueText>>
  <br>
<<else>>
  <<if maplebirch.get('BirdTower').leaderTrait is "dominant">>
    <<babyhawks>><<lanSwitch ' screech back. ' '尖鸣着回应。'>><<if maplebirch.get('BirdTower').party.length gt 1>><<childname>><<lanSwitch "'s cries seem to carry a hint of displeasure." '的鸣叫声中似乎带着些许不满。'>><</if>>
  <<elseif maplebirch.get('BirdTower').leaderTrait is "clever">>
    <<childname>><<lanSwitch ' screech back at you, and ' '尖鸣着回应你，'>><<= maplebirch.get('BirdTower').party.length gt 1 ? "<<babyhawks>>" : "<<childhe>>">><<lanSwitch ' wait to see what you do.' '等待着你的行动。'>>
  <<else>>
    <<babyhawks>><<lanSwitch ' chirp back at you, and ' '叽喳着回应你，'>><<babyhawksthem>><<lanSwitch ' wait to see what you do.' '等待着你的行动。'>>
  <</if>>
  <br><br>
  <<language>>
    <<option 'EN'>>
      You have an idea, and decide the direction of the hunt:
    <<option 'CN'>>
      你心中有了主意，决定了狩猎的方向：
  <</language>>
  <br>
  <<if $bird.hunts.distanceNorth lt 5>>
    <<lanLink `["North" + " (" + getTimeString(_hoursPassed, _minutesPassed) + ")", "北" + " (" + getTimeString(_hoursPassed, _minutesPassed) + ")"]` "Deadwood BirdTower Hunt Event">>
      <<set $bird.hunts.direction to "north">>
      <<set $bird.hunts.distanceNorth++>>
      <<set $fatigueMod to _fatigueMod>>
      <<set $flightTime to _flightTime>>
      <<bird_pass _flightTime>>
      <<endevent>>
    <</lanLink>>
    <<print _fatigueText>>
    <br>
  <</if>>
  <<if $bird.hunts.distanceEast lt 5>>
    <<lanLink `["East" + " (" + getTimeString(_hoursPassed, _minutesPassed) + ")", "东" + " (" + getTimeString(_hoursPassed, _minutesPassed) + ")"]` "Deadwood BirdTower Hunt Event">>
      <<set $bird.hunts.direction to "east">>
      <<set $bird.hunts.distanceEast++>>
      <<set $fatigueMod to _fatigueMod>>
      <<set $flightTime to _flightTime>>
      <<bird_pass _flightTime>>
      <<endevent>>
    <</lanLink>>
    <<print _fatigueText>>
    <br>
  <</if>>
  <<if $bird.hunts.distanceNorth gt -5>>
    <<lanLink `["South" + " (" + getTimeString(_hoursPassed, _minutesPassed) + ")", "南" + " (" + getTimeString(_hoursPassed, _minutesPassed) + ")"]` "Deadwood BirdTower Hunt Event">>
      <<set $bird.hunts.direction to "south">>
      <<set $bird.hunts.distanceNorth-->>
      <<set $fatigueMod to _fatigueMod>>
      <<set $flightTime to _flightTime>>
      <<bird_pass _flightTime>>
      <<endevent>>
    <</lanLink>>
    <<print _fatigueText>>
    <br>
  <</if>>
  <<if $bird.hunts.distanceEast gt -5>>
    <<lanLink `["West" + " (" + getTimeString(_hoursPassed, _minutesPassed) + ")", "西" + " (" + getTimeString(_hoursPassed, _minutesPassed) + ")"]` "Deadwood BirdTower Hunt Event">>
      <<set $bird.hunts.direction to "west">>
      <<set $bird.hunts.distanceEast-->>
      <<set $fatigueMod to _fatigueMod>>
      <<set $flightTime to _flightTime>>
      <<bird_pass _flightTime>>
      <<endevent>>
    <</lanLink>>
    <<print _fatigueText>>
    <br>
  <</if>>
<</if>>

:: Deadwood BirdTower Hunt Event []
<<effects>><<flight_distance_check>><<babyhawk_hunt_chance>><<flight_effects>><<childSelect $BirdTower.hunt.leader>>
<<if $phase is 2>>
  <<language>>
    <<option 'EN'>>
      You ignore the setback and keep hunting.
    <<option 'CN'>>
      你无视了遇到的挫折，继续打猎。
  <</language>>
<</if>>
<<if $bird.hunts.goal is "babyhawk">>
  <<lanSwitch 'You follow ' '你跟着'>><<babyhawks>><<lanSwitch ' toward the ' '向'>><<print $bird.hunts.direction.replace("north", lanSwitch("north", "北")).replace("south", lanSwitch("south", "南")).replace("west", lanSwitch("west", "西")).replace("east", lanSwitch("east", "东"))>><<lanSwitch ', hoping to find something.' '飞行，希望能发现些什么。'>>
<<else>>
  <<lanSwitch 'You fly together toward the ' '你们一起向'>><<print $bird.hunts.direction.replace("north", lanSwitch("north", "北")).replace("south", lanSwitch("south", "南")).replace("west", lanSwitch("west", "西")).replace("east", lanSwitch("east", "东"))>><<lanSwitch ', hoping to find something.' '飞去，希望能发现什么。'>>
<</if>>
<<if Weather.precipitation is "rain">><<lanSwitch 'The rain makes your search harder.' '雨水让你的搜索变得更加困难。'>><<elseif Weather.precipitation is "snow">><<lanSwitch 'The snow makes your search harder.' '雪让你的搜索变得更加困难。'>><</if>>
<<if $daily.birdHuntPhysique is undefined>>
  <<set $daily.birdHuntPhysique to 0>>
  <<physique 1>>
<<elseif $daily.birdHuntPhysique lt 3>>
  <<set $daily.birdHuntPhysique++>>
  <<physique 1>>
<</if>>
<br><br>
<<endevent>>
<<cleareventpool>>
<<if $stress gte $stressmax or isPregnancyEnding()>>
  <<language>>
    <<option 'EN'>>
      You no longer have the strength to keep flying. Your limp wings turn your flight into a clumsy, rapid descent. Your vision gradually goes black.
    <<option 'CN'>>
      你没有继续飞行的力气了。你无力的翅膀使你的飞行动作变成了笨拙而急速的下降滑行。你的视野逐渐变黑。
  <</language>>
  <br><br>
  <<babyhawks>><<lanSwitch ' cry out sharply behind your head, but the sound is quickly swallowed by a blurry rushing noise. Your body feels cold.' '急促的叫声在你的脑后响起，但很快被模糊不清的哗啦声掩盖。你的身体感到冰冷。'>>
  <br><br>
  <<language>>
    <<option 'EN'>>
      You feel something catch you in midair, and as you start to rise again, a sharp ache fills your ears.
    <<option 'CN'>>
      你感觉到半空中有什么抓住了你，随着你再次开始上升，你的耳膜感到一阵胀痛。
  <</language>>
  <br><br>
  <<lanLink ["Continue (?:??)", "继续 (?:??)"] "Deadwood BirdTower Hunt Passout">>
    <<bird_pass _returnTime>>
  <</lanLink>>
  <br>
<<elseif _distanceTotal is 0>>
  <<lanSwitch 'You are above the castle. ' '你正在城堡上空。'>><span class="blue"><<lanSwitch 'You will not find anything unless you fly farther.' '你发现不了任何东西，除非你飞得更远些。'>></span>
  <br><br>
  <<endevent>>
  <<babyhawk_hunt_options>>
<<elseif $daily.huntRemyCampNorth is $bird.hunts.distanceNorth and $daily.huntRemyCampEast is $bird.hunts.distanceEast>>
  <<if $daily.huntRemyAlerted>>
    <<lanSwitch 'You approach a camp you have raided before. ' '你们接近了曾经侵扰过的营地。'>><span class="red"><<lanSwitch 'The people here are very alert, their eyes fixed on the sky.' '这里的人非常警惕，眼睛一直盯着天空。'>></span>
    <br><br>
    <<if maplebirch.get('BirdTower').selectTrait("clever")>>
      <<childname _tempIDs[0]>><<lanSwitch "'s feathers puff up, and they let out a warning shriek. The people on the ground immediately begin carefully searching for the source." '羽毛炸起，发出一声警戒的尖啸。这让地面上的人立刻开始谨慎地寻找声源。'>>
      <br><br>
    <</if>>
    <<lanSwitch 'You decide you had better keep ' '你认为你最好带着'>><<babyhawks>><<lanSwitch ' away from them.' '离他们远点。'>>
    <br><br>
    <<endevent>>
    <<set $phase to 2>>
    <<flight_hunt_options>>
  <<elseif $daily.huntRemyBurnt>>
    <<language>>
      <<option 'EN'>>
        A smoldering camp lies below you. The sight brings you relief, but you will not find anything else today.
      <<option 'CN'>>
        闷烧的营地在你下方。这个景象让你感到宽慰，但你今天不会再找到任何东西了。
    <</language>>
    <br><br>
    <<if maplebirch.get('BirdTower').selectTrait("sympathy")>>
      <<childrenNames _tempIDs[0]>><<lanSwitch ' stare curiously at the burning tents. You pat ' '好奇地盯着燃烧着的帐篷。你拍了拍'>><<childhis _tempIDs[0]>><<lanSwitch ' on the head.' '的脑袋。'>>
      <br><br>
    <</if>>
    <<endevent>>
    <<flight_hunt_options>>
  <<else>>
    <<if $daily.huntRemyCamp>>
      <<lanSwitch 'You are ' '你正在'>>
      <<if $remy_seen is "farm" or $remy_seen is "livestock" or $livestock_intro isnot undefined>>
        <<lanSwitch "above the camp of Remy's men." '雷米手下的营地上方。'>>
      <<else>>
        <<lanSwitch 'above a camp. ' '营地上方。 '>>
      <</if>>
    <<else>>
      <<set $daily.huntRemyCamp to true>>
      <<language>>
        <<option 'EN'>>
          You notice several tents. Someone seems to have set up camp. You can see the owners sitting outside.
        <<option 'CN'>>
          你注意到几个帐篷。有人似乎搭了营地。你能看到营地主人坐在外面。
      <</language>>
      <<if $remy_seen is "farm" or $remy_seen is "livestock" or $livestock_intro isnot undefined>>
        <<lanSwitch 'You recognize them from the uniforms they wear. ' '你从那些人穿着的制服认出了他们。'>><span class="red"><<lanSwitch "They are Remy's men." '是雷米的手下。'>></span>
      <<else>>
        <<lanSwitch 'Some of them carry forked metal rods, others nets. They look very dangerous.' '他们中的一些拿着分叉的金属棍，另一些拿着网。他们看起来十分危险。'>>
      <</if>>
    <</if>>
    <br><br>
    <span class="blue"><<lanSwitch 'You cannot risk provoking them with ' '你不能带着'>><<= maplebirch.get('BirdTower').party.length gt 1 ? lanSwitch("the children", "孩子们") : lanSwitch("your child", "你的孩子")>><<lanSwitch ' in tow.' '冒险侵扰他们。'>></span>
    <br>
    <<lanLink ["Avoid them", "避开他们"] "Deadwood BirdTower Hunt Ignore">>
      <<endevent>>
    <</lanLink>>
    <br>
  <</if>>
<<elseif $daily.emptyCampNorth is $bird.hunts.distanceNorth and $daily.emptyCampEast is $bird.hunts.distanceEast>>
  <<if Time.dayState isnot "night">>
    <<if $daily.emptyCamp>>
      <<language>>
        <<option 'EN'>>
          You are above the abandoned camp.
        <<option 'CN'>>
          你在废弃营地的上空。
      <</language>>
    <<else>>
      <<language>>
        <<option 'EN'>>
          You see an open clearing with a smoking fire pit in the middle. Trash and other items are scattered around. It looks like someone stayed here. They may have left behind things useful to you.
        <<option 'CN'>>
          你看到一个开阔空地，中间有一个冒烟的火坑。垃圾和其他物品散落在四周。看起来有人曾在这里逗留过。他们可能留下了一些对你有用的东西。
      <</language>>
    <</if>>
    <br><br>
    <<if $daily.emptyCampLoot is 0>>
      <span class="purple"><<lanSwitch 'It has already been picked clean.' '已经被洗劫一空了。'>></span>
      <br><br>
    <<else>>
      <<lanLink ["Land (0:02)", "着陆 (0:02)"] "Deadwood BirdTower Hunt Scavenge Party Site">>
        <<endevent>>
        <<bird_pass 2>>
      <</lanLink>>
      <br><br>
    <</if>>
  <<else>>
    <<language>>
      <<option 'EN'>>
        You see a bonfire blazing in an open clearing, surrounded by crowds of people who seem to be dancing and enjoying themselves. There are too many people here now for you to approach.
      <<option 'CN'>>
        你看到一片开阔的空地上篝火熊熊，周围围满了人——他们似乎在跳舞和享乐。现在这里的人太多，你无法靠近。
    <</language>>
    <br><br>
    <<lanSwitch 'The moving figures seem to confuse your children quite a bit. ' '这些移动的人影似乎让你的孩子感到相当迷惑。'>><<babyhawksthem>><<lanSwitch ' circle the column of smoke above the bonfire a few times.' '绕着篝火上空的烟柱飞行了几圈。'>>
    <br>
    <<language>>
      <<option 'EN'>>
        The people are busy with their party and have not noticed you.
      <<option 'CN'>>
        这些人正忙于派对，没有发现你们。
    <</language>>
    <br>
    <<if maplebirch.get('BirdTower').selectTrait("sympathy")>>
      <<childrenNames _tempIDs>><<lanSwitch ' sing softly beside you, following the music from the crowd.' '在你身边轻轻地跟着人群中的音乐声鸣唱。'>><<lstress>><<stress -5>>
    <</if>>
    <br><br>
  <</if>>
  <<babyhawk_hunt_options>>
  <!-- 荒原里的石柱伏击点：原版伏击链的入口。 -->
<<elseif ($bird.hunts.distanceNorth is -3 and $bird.hunts.distanceEast is 3) or ($bird.hunts.distanceNorth is -3 and $bird.hunts.distanceEast is -3)>>
  <<language>>
    <<option 'EN'>>
      There's a tall pillar of stone at the top of a hill nearby. The bottom is completely overgrown, but a path manages to cleave through the underbrush.
    <<option 'CN'>>
      附近一座山顶上有一根高高的石柱。石柱底部完全被茂密的植物覆盖，其间一条小路穿过了灌木丛。
  <</language>>
  <<if Time.dayState is "night">>
    <<language>>
      <<option 'EN'>>
        It would make a good ambush point, but it's too dark.
      <<option 'CN'>>
        这是个伏击的好地方，但现在太暗了。
    <</language>>
    <br><br>
  <<else>>
    <<language>>
      <<option 'EN'>>
        It would be a good place to set up an ambush.
      <<option 'CN'>>
        这是个伏击的好地方。
    <</language>>
    <br><br>
    <<lanLink ["Land (0:02)", "着陆 (0:02)"] "Bird Hunt Ambush Point">>
      <<endevent>>
      <<bird_pass 2>>
    <</lanLink>>
    <br>
  <</if>>
  <<babyhawk_hunt_options>>
<<else>>
  <<addinlineevent "babyhawk_hunt_nothing" _flight_hunt_chance.nothing>>
    <<rng 3>>
    <<lanSwitch 'After a while, you still have not found anything of interest.' '过了一会儿，你还是没发现任何感兴趣的东西。'>>
    <<switch $rng>>
      <<case 1>>
        <!-- Nothing -->
      <<case 2>>
        <<switch Weather.precipitation>>
          <<case "none">>
            <<if !Weather.overcast>>
              <<switch Time.dayState>>
                <<case "dawn">>
                  <<lanSwitch 'Dawn kisses the horizon, and you become especially alert.' '晨曦亲吻地平线，你变得格外的警觉。'>><<stress -6>><<lstress>>
                <<case "day">>
                  <<lanSwitch 'You glide through the air, enjoying the warm sunlight.' '你在空中滑翔着，享受着温暖的阳光。'>><<stress -6>><<lstress>>
                <<case "dusk">>
                  <<lanSwitch 'The last light of sunset blankets the moor.' '日落余晖笼罩着荒原。'>><<stress -6>><<lstress>>
                <<case "night">>
                  <<lanSwitch 'Night has fallen over the moor, yet it is unexpectedly peaceful.' '荒原已经入夜了，却出乎意料的安宁。'>><<stress -6>><<lstress>>
              <</switch>>
            <<else>>
              <<lanSwitch 'A strong gust sweeps past, letting you glide steadily for a few minutes.' '一阵强风拂过，让你安稳地滑行了几分钟。'>><<stress -6>><<lstress>>
            <</if>>
          <<case "rain">>
            <<lanSwitch 'Rain pats against you. ' '雨点拍打在你身上。'>><<babyhawks>><<lanSwitch ' try to catch raindrops in their beaks.' '在试图叼住雨滴。'>>
          <<case "snow">>
            <<lanSwitch 'You glide through a vast, glittering white void far from the ground. The blanket of snow makes it feel like a dream from another world.' '你在远离地面的一片闪闪发光的白色虚空中滑行。皑皑白雪让你仿佛置身于另一个世界的幻梦中。'>><<trauma -3>><<ltrauma>>
            <<lanSwitch 'You can see your child trying to shake off the thin layer of frost covering them.' '你能看见你的孩子正在试图抖掉身上覆盖的薄薄一层白霜。'>><<stress -6>><<lstress>>
        <</switch>>
      <<case 3>>
        <<lanSwitch 'You let your mind wander for a moment, enjoying the feeling of flight.' '你暂时分神了一会，享受着飞翔的感觉。'>>
        <br>
        <<if maplebirch.get('BirdTower').party.length gt 1>><<lanSwitch "The children chase each other's tails in the air." '孩子们在空中互相追逐彼此的尾巴。'>><<trauma -3>><</if>><<trauma -3>><<ltrauma>>
    <</switch>>
    <br><br>
    <<endevent>>
    <<set $phase to 2>>
    <<babyhawk_hunt_options>>
  <</addinlineevent>>
  <<addinlineevent "babyhawk_hunt_camp" _flight_hunt_chance.materials>>
    <<language>>
      <<option 'EN'>>
        You notice the remains of a campsite. Perhaps there is still something worth taking.
      <<option 'CN'>>
        你注意到有个露营完后的废址。或许还留着值得带走的东西。
    <</language>>
    <br><br>
    <<lanLink ["Search the area (0:05)", "搜索这片地区 (0:05)"] "Deadwood BirdTower Hunt Camp">>
      <<bird_pass 5>>
    <</lanLink>>
    <br>
    <<lanLink ["Ignore", "无视"] "Deadwood BirdTower Hunt Ignore">>
      <<endevent>>
    <</lanLink>>
    <br>
  <</addinlineevent>>
  <<addinlineevent "babyhawk_hunt_dead_tree" _flight_hunt_chance.materials>>
    <<lanSwitch 'You find a tree that has lost all its leaves. Though it looks old and withered, its branches still look healthy enough to use for your nest. ' '你发现了一棵叶子掉光的树。虽然它看着老而凋零，但树枝看起来仍然足够健康，可以用于你的巢穴。 '>>
    <br><br>
    <<lanLink ["Land (0:05)", "着陆 (0:05)"] "Deadwood BirdTower Hunt Dead Tree">>
      <<bird_pass 5>>
    <</lanLink>>
    <br>
    <<lanLink ["Ignore", "无视"] "Deadwood BirdTower Hunt Ignore">>
      <<endevent>>
    <</lanLink>>
    <br>
  <</addinlineevent>>
  <<addinlineevent "babyhawk_hunt_sticks" _flight_hunt_chance.materials>>
    <<language>>
      <<option 'EN'>>
        You notice a pile of thick branches.
      <<option 'CN'>>
        你注意到一堆粗大的树枝。
    <</language>>
    <br><br>
    <<lanLink ["Land (0:05)", "着陆 (0:05)"] "Deadwood BirdTower Hunt Sticks">>
      <<bird_pass 5>>
    <</lanLink>>
    <br>
    <<lanLink ["Ignore", "无视"] "Deadwood BirdTower Hunt Ignore">>
      <<endevent>>
    <</lanLink>>
    <br>
  <</addinlineevent>>
  <<addinlineevent "babyhawk_hunt_leaves" _flight_hunt_chance.materials>>
    <<lanSwitch 'You find a large patch of fallen leaves on the ground.' '你发现地上有一大片散落的叶子。'>>
    <<if Time.season is "winter" or Time.season is "autumn">>
      <<lanSwitch 'Among the withered branches, these leaves stand out especially and look very high quality.' '这些叶子在枯萎的枝叶间显得尤其突出，看起来质量很高。'>>
    <</if>>
    <<lanSwitch 'These leaves would be very suitable for building a nest.' '这些叶子会很适合用来建巢的。'>>
    <br><br>
    <<lanLink ["Land (0:05)", "着陆 (0:05)"] "Deadwood BirdTower Hunt Leaves">>
      <<bird_pass 5>>
    <</lanLink>>
    <br>
    <<lanLink ["Ignore", "无视"] "Deadwood BirdTower Hunt Ignore">>
      <<endevent>>
    <</lanLink>>
    <br>
  <</addinlineevent>>
  <<addinlineevent "babyhawk_hunt_underbrush" (_flight_hunt_chance.materials - Math.floor($bird.hunts.distanceEast / 2))>>
    <<language>>
      <<option 'EN'>>
        You notice a clump of withered branches and leaves. Perhaps materials could be gathered from it easily.
      <<option 'CN'>>
        你注意到一簇枯萎的枝叶。也许能从这里面轻松收集到材料。
    <</language>>
    <br><br>
    <<lanLink ["Land (0:05)", "着陆 (0:05)"] "Deadwood BirdTower Hunt Underbrush">>
      <<bird_pass 5>>
    <</lanLink>>
    <br>
    <<lanLink ["Ignore", "无视"] "Deadwood BirdTower Hunt Ignore">>
      <<endevent>>
    <</lanLink>>
    <br>
  <</addinlineevent>>
  <<addinlineevent "babyhawk_hunt_flowers" (_flight_hunt_chance.materials + Math.floor($bird.hunts.distanceEast / 2))>>
    <<language>>
      <<option 'EN'>>
        You notice a brightly coloured patch of flowers.
      <<option 'CN'>>
        你注意到一片颜色鲜亮的花丛。
    <</language>>
    <br><br>
    <<lanLink ["Land (0:05)", "着陆 (0:05)"] "Deadwood BirdTower Hunt Flowers">>
      <<bird_pass 5>>
    <</lanLink>>
    <br>
    <<lanLink ["Ignore", "无视"] "Deadwood BirdTower Hunt Ignore">>
      <<endevent>>
    <</lanLink>>
    <br>
  <</addinlineevent>>
  <<addinlineevent "babyhawk_hunt_lurkers_1" _flight_hunt_chance.lurkers>>
    <<if maplebirch.get('BirdTower').leaderTrait is "dominant">>
      <<childname $BirdTower.hunt.leader>><<lanSwitch ' lets out a small screech to get your attention. You see some lurkers on the grass. They seem to be resting. ' '发出一声小小的尖鸣，引起你的注意。你看见草地上有些潜伏者。它们似乎正在休息。 '>><<childHe $BirdTower.hunt.leader>><<lanSwitch ' lets out another low screech, signalling a desire to attack.' '发出另一声压低的尖鸣，表明想要发动袭击。'>>
    <<else>>
      <<language>>
        <<option 'EN'>>
          You find some lurkers on the grass. They seem to be resting.
        <<option 'CN'>>
          你发现草地上有些潜伏者。它们似乎正在休息。
      <</language>>
    <</if>>
    <br><br>
    <<lanLink ["Hunt them (0:05)", "狩猎它们 (0:05)"] "Deadwood BirdTower Hunt Lurkers Lot">>
      <<bird_pass 5>>
    <</lanLink>>
    <br>
    <<lanLink ["Ignore them", "无视它们"] "Deadwood BirdTower Hunt Ignore">>
      <<endevent>>
    <</lanLink>>
    <br>
  <</addinlineevent>>
  <<addinlineevent "babyhawk_hunt_lurkers_2" _flight_hunt_chance.lurkers>>
    <<language>>
      <<option 'EN'>>
        You notice a lone lurker moving along.
      <<option 'CN'>>
        你注意到有只潜伏者孤零零地前进着。
    <</language>>
    <br><br>
    <<lanLink ["Hunt (0:05)", "狩猎 (0:05)"] "Deadwood BirdTower Hunt Lurkers Few">>
      <<bird_pass 5>>
    <</lanLink>>
    <br>
    <<lanLink ["Ignore", "无视"] "Deadwood BirdTower Hunt Ignore">>
      <<endevent>>
    <</lanLink>>
    <br>
  <</addinlineevent>>
  <<addinlineevent "babyhawk_hunt_shiny" _flight_hunt_chance.valuables>>
    <<lanSwitch 'A shining glint in the mire catches your eye' '泥沼里有一个闪光的亮点吸引了你的目光'>><<if maplebirch.get('BirdTower').selectTrait("clever")>><<lanSwitch " and " "和">><<childrenNames _tempIDs>><<lanSwitch "'s attention" "的目光">><</if>><<lanSwitch "." "。">>
    <br><br>
    <<lanLink ["Investigate (0:05)", "调查 (0:05)"] "Deadwood BirdTower Hunt Shiny">>
      <<bird_pass 5>>
    <</lanLink>>
    <br>
    <<lanLink ["Ignore", "无视"] "Deadwood BirdTower Hunt Ignore">>
      <<endevent>>
    <</lanLink>>
    <br>
  <</addinlineevent>>
  <<addinlineevent "babyhawk_hunt_shiny_pond" _flight_hunt_chance.valuables>>
    <<if maplebirch.get('BirdTower').selectTrait("clever")>><<childrenNames _tempIDs>><<lanSwitch ' let out a small screech at the ground.' '冲着地面发出一声小小的尖鸣。'>><</if>>
    <<lanSwitch 'You notice something glinting deep in the pond. Perhaps there is something interesting beneath the surface. ' '你发现池塘深处有东西在一闪一闪。也许水面之下有什么有趣的东西。 '>>
    <br><br>
    <<lanLink ["Investigate (0:05)", "调查 (0:05)"] "Deadwood BirdTower Hunt Pond Dive">>
      <<bird_pass 5>>
    <</lanLink>>
    <br>
    <<lanLink ["Ignore", "无视"] "Deadwood BirdTower Hunt Ignore">>
      <<endevent>>
    <</lanLink>>
    <br>
  <</addinlineevent>>
  <<addinlineevent "babyhawk_hunt_animals_1" _flight_hunt_chance.other>>
    <<rng 2>><<set _beastGen to ($rng is 1 ? "cat" : "fox")>><<if _beastGen is "cat">><<beastNEWinit 1 cat>><<else>><<beastNEWinit 1 fox>><</if>>
    <<lanSwitch 'You spot a lone ' '你发现下方有只孤零零的'>><<beasttype>><<lanSwitch ' below.' '。'>>
    <<rng 100>>
    <<if $rng gte 60>>
      <<set $phase to 1>>
      <<bHes>><<if $monster isnot 1>><<lanSwitch " carrying something in their beak." "叼着什么东西。">><<else>><<lanSwitch " holding something." "拿着什么东西。">><</if>>
    <</if>>
    <br><br>
    <<if maplebirch.get('BirdTower').selectTrait("sympathy")>><<childrenNames _tempIDs>><<lanSwitch ' chirp eagerly and circle around you, as if hoping you will stop to watch the ' '热切地叽喳叫，在你身边盘旋飞行，似乎希望你停下来观察'>><<beasttype>><<lanSwitch '.' '。'>><br><br><</if>>
    <<lanLink ["Watch (0:05)", "观察 (0:05)"] "Deadwood BirdTower Hunt Animal Watch">>
      <<trauma -3>>
      <<bird_pass 5>>
    <</lanLink>>
    <<ltrauma>>
    <br>
    <<lanLink ["Land (0:05)", "着陆 (0:05)"] "Deadwood BirdTower Hunt Animal Land">>
      <<bird_pass 5>>
    <</lanLink>>
    <br>
    <<lanLink ["Screech", "尖叫"] "Deadwood BirdTower Hunt Animal Screech">>
      <<stress -3>>
    <</lanLink>>
    <<lstress>>
    <br>
    <<lanLink ["Ignore", "无视"] "Deadwood BirdTower Hunt Ignore">>
      <<endevent>>
    <</lanLink>>
    <br>
  <</addinlineevent>>
  <<addinlineevent "bird_hunt_animals_2" _flight_hunt_chance.other>>
    <<beastNEWinit 1 fox>><<beastPARTNERinit 1 fox 0>>
    <<lanSwitch 'You spot two ' '你发现两只 '>>
    <<if ($monster isnot 1) or ($NPCList[0].pronoun is "m" and $NPCList[1].pronoun is "m") or ($NPCList[0].pronoun is "f" and $NPCList[1].pronoun is "f")>>
      <<beastsplural>>
    <<else>>
      <<lanSwitch 'a large and a small fox-person' '一大一小的狐狸人'>>
    <</if>>
    <<lanSwitch ' tussle below, but from this height you cannot tell whether they are playing or fighting.' '在下方打闹着，但你无法在这个高度判断那是在玩耍还是打架。'>>
    <br><br>
    <<if maplebirch.get('BirdTower').selectTrait("sympathy")>><<childrenNames _tempIDs>><<lanSwitch ' stare at them intently, seeming very interested.' '目不转睛地盯着它们，似乎很感兴趣。'>><br><br><</if>>
    <<lanLink ["Land to take a closer look (0:05)", "着陆以凑近看 (0:05)"] "Deadwood BirdTower Hunt Foxes Land">>
      <<bird_pass 5>>
    <</lanLink>>
    <br>
    <<lanLink ["Screech", "尖叫"] "Deadwood BirdTower Hunt Animal Screech">>
      <<stress -3>>
      <<set $phase to 4>>
    <</lanLink>>
    <<lstress>>
    <br>
    <<lanLink ["Ignore", "无视"] "Deadwood BirdTower Hunt Ignore">>
      <<endevent>>
    <</lanLink>>
    <br>
  <</addinlineevent>>
  <<addinlineevent "babyhawk_hunt_people_watch" (Math.floor($bird.hunts.distanceNorth / 2))>>
    <<language>>
      <<option 'EN'>>
        You spot two people walking across the moor.
      <<option 'CN'>>
        你发现两个人在荒原上走着。
    <</language>>
    <br><br>
    <<if maplebirch.get('BirdTower').selectTrait("sympathy")>><<childrenNames _tempIDs>><<lanSwitch ' chirp eagerly at you, as if hoping to observe them closely.' '热切地对你叽喳叫，似乎希望能仔细观察他们。'>><br><br><</if>>
    <<lanLink ["Follow (0:10)", "跟上 (0:10)"] "Deadwood BirdTower Hunt People Watching">>
      <<bird_pass 10>>
    <</lanLink>>
    <br>
    <<lanLink ["Ignore", "无视"] "Deadwood BirdTower Hunt Ignore">>
      <<endevent>>
    <</lanLink>>
    <br>
  <</addinlineevent>>
  <<if !$daily.birdPlaneChase>>
    <<addinlineevent "babyhawk_hunt_plane" _flight_hunt_chance.other>>
      <<set $daily.birdPlaneChase to true>>
      <<lanSwitch 'A shining glint catches your eye. This time, though, it is above you. You see an airplane flying high in the distance. ' '一个闪光的亮点吸引了你的目光。不过这一次，是在你们的上方。你看见一架飞机在远远的高空飞行。'>><<babyhawks>><<lanSwitch ' see it too.' '也看见了它。'>>
      <<babyhawksthem>><<lanSwitch ' get very excited and ' '非常兴奋地'>><<= maplebirch.get('BirdTower').party.length gt 1 ? lanSwitch("raise a ruckus", "吵成一团") : lanSwitch("scream loudly", "大声尖叫")>><<lanSwitch ", all their attention caught by the airplane's shining reflection." '，被飞机闪亮的反光吸引了全部注意。'>>
      <br><br>
      <<lanSwitch 'Before you can react, ' '你还没来得及做出任何反应，'>><<babyhawksthem>><<lanSwitch ' have already flown off toward the airplane. You hurry to catch up with ' '已经朝着飞机的方向飞去。你连忙追上'>><<babyhawks>><<lanSwitch '.' '。'>>
      <br><br>
      <<lanLink ["Continue", "继续"] "Deadwood BirdTower Hunt Plane Chase">><</lanLink>>
      <br>
    <</addinlineevent>>
  <</if>>
  <!-- 把这个事件改成孤儿崽回顾过去？ -->
  <<if !$BirdTower.seen.orphan_nest and (_distanceNorthSouth gte 4 or _distanceEastWest gte 4) and maplebirch.get('BirdTower').hasOrphan>>
    <<set _chance to 1>>
    <<if $BirdTower.hunt.leader is $orphanHawkChildId>>
      <<set _chance += 1>>
    <</if>>
    <<if $bird.hunts.goal is "babyhawk">>
      <<set _chance += 1>>
    <</if>>
    <<addinlineevent "babyhawk_hunt_orphan" _chance>>
      <<childSelect $orphanHawkChildId>>
      <<set $BirdTower.seen.orphan_nest to true>>
      <<lanSwitch 'Your ' '你的'>><<childname>><<lanSwitch ' gives a surprised chirp, drawing your attention to the bushes below.' '发出一声惊讶的叽喳声，示意你注意下方的灌木。'>>
      <br><br>
      <<lanSwitch 'You notice nothing in particular, but ' '你没注意到任何特别的东西，但'>><<childname>><<lanSwitch ' is already beating their wings toward the ground. You have no choice but to follow ' '已经拍打着翅膀向着地面飞去，你只好跟上'>><<childhim>><<lanSwitch '.' '。'>>
      <br><br>
      <<lanLink ["Land (0:05)", "降落 (0:05)"] "Deadwood BirdTower Hunt OrphanHawk Nest">>
        <<bird_pass 5>>
      <</lanLink>>
      <br>
    <</addinlineevent>>
  <</if>>
  <<runeventpool>>
<</if>>

:: Deadwood BirdTower Hunt Return []
<<effects>>
<<set $moor to 100>>
<<if $phase is 1>>
  <<if $bird.hunts.goal is "babyhawk">>
    <<lanSwitch 'You signal ' '你示意'>><<babyhawks>><<lanSwitch ' to return to the castle. ' '回城堡。'>><<babyhawksthem>><<lanSwitch ' follow along.' '跟了上来。'>>
  <<else>>
    <<language>>
      <<option 'EN'>>
        You set off on the way back.
      <<option 'CN'>>
        你们踏上返程。
    <</language>>
  <</if>>
<<elseif $phase is 2>>
  <<language>>
    <<option 'EN'>>
      You decide to cut your losses and return to your home.
    <<option 'CN'>>
      你决定及时止损，返回你们的家。
  <</language>>
<</if>>
<<language>>
  <<option 'EN'>>
    Soon you see the castle again.
  <<option 'CN'>>
    很快，你就再次看见了城堡。
<</language>>
<<lanSwitch 'You land on the perch' '你们降落在栖木上'>><<if $bird.upgrades.decor gte 3>><<lanSwitch ', and ' '，'>><<babyhawks>><<lanSwitch ' follow you through the curtain' '跟在你身后穿过帘子'>><</if>><<lanSwitch ',' '，'>>
<<if $bird.hunts.duo is false and $bird.state is "home" and birdEggsReady("Great Hawk")>>
  <<language>>
    <<option 'EN'>>
      But you immediately realize something is wrong.
    <<option 'CN'>>
      但你马上意识到有什么不对劲。
  <</language>>
  <<birdEggLayEvent "huntReturn">>
<<elseif $bird.hunts.lootAmount is 0>>
  <<lanSwitch 'Frustrated by the failed hunt.' '对失败的狩猎感到沮丧。'>><<trauma 12>><<ggtrauma>>
  <br><br>
  <<if $bird.state is "home" and $bird.activity isnot "sleep">>
    <<npc "Great Hawk">><<person1>>
    <<lanSwitch 'Your ' '你的'>><<beasttype>><<if $monster is 1>><<lanSwitch ' walks' '走'>><<else>><<lanSwitch ' leaps' '跃'>><</if>><<lanSwitch ' over to you.' '向你们。'>>
    <<if $monster is 1>>
      <<lanSwitch '"Glad to see you back." ' '"很高兴看到你们回来。"'>><<bHe>><<lanSwitch ' notices you have brought nothing back. "Not every hunt can succeed." ' '注意到你们没有带来任何东西，"不是每次狩猎都能成功的，"'>><<bhe>><<lanSwitch ' tries to comfort you and ' '试图安慰你和'>><<babyhawks>><<lanSwitch '.' '。'>>
    <<else>>
      <<bHe>><<lanSwitch ' notices you have brought nothing back. ' '注意到你们没有带来任何东西。'>><<bHe>><<lanSwitch ' gently nuzzles you with their beak, trying to comfort you.' '温柔地用喙磨蹭着你，试图安慰你。'>>
    <</if>>
    <br><br>
  <</if>>
  <<flight_hunt_end>><<HuntTogetherClean>>
  <<lanLink ["Continue", "继续"] "Bird Tower">>
    <<endevent>>
  <</lanLink>>
  <br>
<<else>>
  <<language>>
    <<option 'EN'>>
      Satisfied with a successful hunt.
    <<option 'CN'>>
      对狩猎的成功感到满足。
  <</language>>
  <br>
  <<switch $bird.upgrades.decor>>
    <<case 1>>
      <<lanSwitch 'After some tidying up, the tower has become very cozy and warm.' '经过一番修整，高塔变得十分舒适温馨。'>><<stress -6>><<lstress>>
    <<case 2>>
      <<lanSwitch 'Your hunting spoils make you feel like you have truly come home.' '你的狩猎战利品让你感到自己真的回到了家。'>><<stress -12>><<llstress>>
    <<case 3>>
      <<lanSwitch 'Your hunting spoils make you feel like you have truly come home.' '你的狩猎战利品让你感到自己真的回到了家。'>><<stress -24>><<lllstress>>
    <<case 4>>
      <<lanSwitch 'You are finally home.' '终于回家了。'>><<stress -36>><<trauma -6>><<lllstress>><<ltrauma>>
    <<case 5>>
      <<lanSwitch 'You are finally home. The silver bars ' '终于回家了。银条'>><<if Time.dayState is "night">><<lanSwitch 'gently reflect the calm moonlight.' '温柔地反射着宁静的月光。'>><<else>><<lanSwitch 'cast a calm reflection over your tower.' '在你的塔上洒下宁静的倒影。'>><</if>><<set $stress to 0>><<trauma -6>><<lllstress>><<ltrauma>>
    <<default>>
  <</switch>>
  <br>
  <<flight_hunt_loot>><<HuntTogetherClean>>
<</if>>

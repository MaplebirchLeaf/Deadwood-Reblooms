:: Deadwood BirdTower Hunt Widgets [widget]

<<widget "birdtower_hunt_companion_loot">>
  <<set _prey to maplebirch.get('BirdTower').prey>>
  <<set _other_hawks to _prey.followers>>
  <<set _caught to _prey.caught.length>>
  <<set _multi to _other_hawks.length gt 1>>
  <<if _other_hawks.length>>
    <<language>>
      <<option 'EN'>>
        You look at the other chicks.
      <<option 'CN'>>
        你看向其他孩子。
    <</language>>
    <<if _caught is 0>>
      <<language>>
        <<option 'EN'>>
          <<childrenNames _other_hawks>> <<= _multi ? "have" : "has">> empty talons, <<= _multi ? "and they whimper softly, looking dejected." : "whimpering softly and looking dejected.">>
        <<option 'CN'>>
          <<childrenNames _other_hawks>>的爪中<<if _multi>>全都<</if>>空空荡荡的，<<= _multi ? "他们" : "">>低声哀鸣着，一副垂头丧气的样子。
      <</language>>
    <<elseif _caught is _other_hawks.length>>
      <<language>>
        <<option 'EN'>>
          <<childrenNames _other_hawks>> <<= _multi ? "each hold a lurker in their talons, and they circle high in the sky, crying out proudly." : "holds a lurker in their talons and circles high in the sky, crying out proudly.">>
        <<option 'CN'>>
          <<childrenNames _other_hawks>>的爪里<<if _multi>>都各自<</if>>抓着一只潜伏者，<<= _multi ? "他们" : "">>正盘旋在高空自豪地高鸣。
      <</language>>
    <<else>>
      <<set _successful_hawks to _prey.caught>>
      <<set _multi to _successful_hawks.length gt 1>>
      <<language>>
        <<option 'EN'>>
          <<childrenNames _successful_hawks>> <<= _multi ? "each hold a lurker in their talons, but the other chicks are not so lucky. They cry out triumphantly, while the others can only watch enviously." : "holds a lurker in their talons, but the other chicks are not so lucky. They cry out triumphantly, while the others can only watch enviously.">>
        <<option 'CN'>>
          <<childrenNames _successful_hawks>>的爪里<<if _multi>>各<</if>>有一只潜伏者，但其他孩子就没那么幸运了。<<= _multi ? "他们" : "">>耀武扬威地高鸣着炫耀自己狩猎成功，而其他孩子只能眼巴巴地看着。
      <</language>>
    <</if>>
    <<if _caught gt 0>><<flight_hunt_get "lurkers" _caught>><</if>>
    <br><br>
  <</if>>
<</widget>>

<<widget "birdtower_scavenge_options">>
  <<if $bird.hunts.weight gte (3+maplebirch.get('BirdTower').party.length)>>
    <<language>>
      <<option 'EN'>>
        You cannot carry anything more. You take to the air and begin the return to the tower.
      <<option 'CN'>>
        你再也拿不下更多东西了。你飞向空中，开始返回高塔。
    <</language>>
    <br><br>
    <<flight_distance_check>>
    <<flight_time_check _returnTime "silent">>
    <<lanLink ["Return to the castle (" + getTimeString(_hoursPassed, _minutesPassed) + ")", "回到城堡 (" + getTimeString(_hoursPassed, _minutesPassed) + ")"] "Deadwood BirdTower Hunt Return">>
      <<set $fatigueMod to _fatigueMod>>
      <<set $flightTime to _flightTime>>
      <<bird_pass _flightTime>>
      <<endevent>>
    <</lanLink>>
    <<print _fatigueText>>
  <<elseif $daily.emptyCampLoot lte 0>>
    <<language>>
      <<option 'EN'>>
        You take one more look around. You have taken everything of value; all you can do now is leave.
      <<option 'CN'>>
        你再次看了一眼周围。你已经拿走了所有值钱的东西，现在能做到只有离开了。
    <</language>>
    <<endevent>>
    <<babyhawk_hunt_return>>
  <<else>>
    <<switch $daily.emptyCampLoot>>
      <<case 3>>
        <<language>>
          <<option 'EN'>>
            You have already searched part of the rubbish, but there is still plenty left to search.
          <<option 'CN'>>
            你已经翻找过了一部分垃圾，不过还有很多可以搜寻的部分。
        <</language>>
      <<case 2>>
        <<language>>
          <<option 'EN'>>
            You have already found many things, but there should still be more waiting to be discovered.
          <<option 'CN'>>
            你已经找到了许多东西，但应该还有很多等待发现。
        <</language>>
      <<case 1>>
        <<language>>
          <<option 'EN'>>
            You have searched almost every spot; there is hardly anything left to find.
          <<option 'CN'>>
            你已经几乎翻遍了所有位置，已经没有什么可以发现的了。
        <</language>>
    <</switch>>
    <br><br>
    <<set _time to Math.max(1, 10 - maplebirch.get('BirdTower').party.length * 2)>>
    <<set _showtime to String(_time).padStart(2, "0")>>
    <<lanLink ["Keep searching (0:" + _showtime + ")", "继续搜寻 (0:" + _showtime + ")"] "Deadwood BirdTower Hunt Scavenge">>
      <<bird_pass _time>>
    <</lanLink>>
    <br>
    <<lanLink ["Leave", "离开"] "Deadwood BirdTower Hunt Scavenge Leave">><</lanLink>>
    <br>
  <</if>>
<</widget>>

:: Deadwood BirdTower Widget BabyHawk HuntTogether [widget]
<!-- 清理随行狩猎状态：交给 TS 模块重置队伍、领队与方向提示。 -->
<<widget "HuntTogetherClean">>
  <<run maplebirch.get("BirdTower").resetHunt()>>
<</widget>>
<!-- 选择参与狩猎的小鹰领队：TS 模块内 dominant/clever 优先，否则随机。 -->
<!-- dominant/clever/none -->
<<widget "hawks_leader_select">>
  <<run maplebirch.get("BirdTower").pickLeader()>>
<</widget>>
<!-- dominant小鹰，目标lurkers的概率最高 -->
<!-- clever小鹰，目标valuables的概率最高 -->
<!-- sympathy小鹰，目标other的概率最高 -->
<!-- clumsy小鹰，目标trash的概率最高 -->
<<widget "babyhawk_loot_select">>
  <<rng>>
  <<if maplebirch.get('BirdTower').leaderTrait is "dominant">>
    <<set $rng += 40>>
  <<elseif maplebirch.get('BirdTower').leaderTrait is "clever">>
    <<set $rng += 20>>
  <<else>>
    <<set $rng -= 10>>
  <</if>>
  <<set _babyhawk_loot_select to "nothing">>
  <<if $rng gte 80>>
    <<set _babyhawk_loot_select to "lurker">>
  <<elseif $rng gte 60>>
    <<set _babyhawk_loot_select to "valuables">>
  <<elseif $rng gte 40>>
    <<set _babyhawk_loot_select to "materials">>
  <<elseif $rng gte 20>>
    <<set _babyhawk_loot_select to "trash">>
  <<else>>
    <<set _babyhawk_loot_select to "other">>
  <</if>>
<</widget>>

<<widget "babyhawk_hunt_chance">>
  <<if $bird.hunts.goal is "babyhawk">>
    <<babyhawk_loot_select>>
    <<switch _babyhawk_loot_select>>
      <<case "lurker">>
        <<set $_goal to "lurkers">>
      <<case "trash" "materials">>
        <<set $_goal to "materials">>
      <<case "valuables">>
        <<set $_goal to "valuables">>
      <<case "other">>
        <<set $_goal to "other">>
    <</switch>>
  <<else>>
    <<set $_goal to $bird.hunts.goal>>
  <</if>>
  <<set _flight_hunt_chance to {
    nothing: 2,
    lurkers: random(1, 3),
    materials: random(1, 2),
    valuables: random(0, 2),
    other: 1
  }>>
  <<set _flight_hunt_chance[$_goal] += ($bird.hunts.goal is "babyhawk" ? maplebirch.get('BirdTower').party.length : 1 + Math.floor(currentSkillValue("skulduggery") / 500))>>
  <<if Weather.precipitation isnot "none">>
    <<set _flight_hunt_chance.nothing += 2>>
  <</if>>
  <<if Time.dayState is "night">>
    <<set _flight_hunt_chance.nothing += 2>>
  <</if>>
  <<if $daily.huntRemyCampNorth is undefined>>
    <<set $daily.huntRemyCampNorth to random(2,5)>>
    <<set $daily.huntRemyCampEast to random(-5,5)>>
  <</if>>
  <<if $daily.emptyCampNorth is undefined>>
    <<set $daily.emptyCampNorth to random(2,5)>>
    <<set $daily.emptyCampEast to random(-5,5)>>
    <<if $daily.emptyCampNorth is $daily.huntRemyCampNorth and $daily.emptyCampEast is $daily.huntRemyCampEast>>
      <<if $daily.emptyCampNorth is 5>>
        <<set $daily.emptyCampNorth -= 1>>
      <<else>>
        <<set $daily.emptyCampNorth += 1>>
      <</if>>
      <<set $daily.emptyCampEast to random(-5,5)>>
    <</if>>
  <</if>>
<</widget>>

<<widget "babyhawk_hunt_options">>
  <<childSelect $BirdTower.hunt.leader>>
  <<flight_time_check 20 "silent">>
  <<if $bird.hunts.goal is "babyhawk">>
    <<set _directionPool to []>>
    <<if $bird.hunts.distanceNorth lt 5 and !($bird.hunts.distanceNorth is -1 and _distanceEastWest is 0)>>
      <<run _directionPool.pushUnique("north")>>
    <</if>>
    <<if $bird.hunts.distanceEast lt 5 and !($bird.hunts.distanceEast is -1 and _distanceNorthSouth is 0)>>
      <<run _directionPool.pushUnique("east")>>
    <</if>>
    <<if $bird.hunts.distanceNorth gt -5 and !($bird.hunts.distanceNorth is 1 and _distanceEastWest is 0)>>
      <<run _directionPool.pushUnique("south")>>
    <</if>>
    <<if $bird.hunts.distanceEast gt -5 and !($bird.hunts.distanceEast is 1 and _distanceNorthSouth is 0)>>
      <<run _directionPool.pushUnique("west")>>
    <</if>>
    <<set $bird.hunts.direction to _directionPool.pluck()>>
    <<switch $bird.hunts.direction>>
      <<case "north">>
        <<set _distanceNorthSouth to 1>>
        <<set _distanceEastWest to 0>>
      <<case "east">>
        <<set _distanceNorthSouth to 0>>
        <<set _distanceEastWest to 1>>
      <<case "south">>
        <<set _distanceNorthSouth to -1>>
        <<set _distanceEastWest to 0>>
      <<case "west">>
        <<set _distanceNorthSouth to 0>>
        <<set _distanceEastWest to -1>>
    <</switch>>
    <<capture _distanceNorthSouth _distanceEastWest _fatigueMod _flightTime _fatigueText>>
      <<lanLink `["Keep hunting" + " (" + getTimeString(_hoursPassed, _minutesPassed) + ")", "继续打猎" + " (" + getTimeString(_hoursPassed, _minutesPassed) + ")"]` "Deadwood BirdTower Hunt Event">>
        <<set $bird.hunts.distanceNorth += _distanceNorthSouth>>
        <<set $bird.hunts.distanceEast += _distanceEastWest>>
        <<set $fatigueMod to _fatigueMod>>
        <<set $flightTime to _flightTime>>
        <<bird_pass _flightTime>>
      <</lanLink>>
      <<print _fatigueText>>
    <</capture>>
    <br><br>
    <<lanLink ["Ask to hunt something else", "要求狩猎其它东西"] "Deadwood BirdTower Hunt Goal">>
      <<endevent>>
      <<set $phase to 2>>
    <</lanLink>>
    <br>
    <<flight_time_check _returnTime "silent">>
    <<lanLink `["Ask to return to the castle" + " (" + getTimeString(_hoursPassed, _minutesPassed) + ")", "要求回到城堡" + " (" + getTimeString(_hoursPassed, _minutesPassed) + ")"]` "Deadwood BirdTower Hunt Return Ask">>
      <<set $fatigueMod to _fatigueMod>>
      <<set $flightTime to _flightTime>>
      <<bird_pass _flightTime>>
    <</lanLink>>
    <<print _fatigueText>>
    <br>
  <<else>>
    <<if _distanceNorthSouth gte 4 or _distanceEastWest gte 4>>
      <<language>>
        <<option 'EN'>>
          You cannot see the Bird Tower from here.
        <<option 'CN'>>
          你在这里看不到鹰塔。
      <</language>>
    <<elseif _distanceNorthSouth is 0 and _distanceEastWest is 0>>
      <<language>>
        <<option 'EN'>>
          The moor stretches out before you.
        <<option 'CN'>>
          荒原在你面前延展开来。
      <</language>>
    <<else>>
      <<language>>
        <<option 'EN'>>
          The Bird Tower is
          <<if $bird.hunts.distanceNorth lte -1>> to the north<<elseif $bird.hunts.distanceNorth gte 1>> to the south<</if>><<if $bird.hunts.distanceEast lte -1>> to the east<<elseif $bird.hunts.distanceEast gte 1>> to the west<</if>>.
        <<option 'CN'>>
          鹰塔在
          <<if $bird.hunts.distanceNorth lte -1>>北<<elseif $bird.hunts.distanceNorth gte 1>>南<</if>><<if $bird.hunts.distanceEast lte -1>>东<<elseif $bird.hunts.distanceEast gte 1>>西<</if>>面。
      <</language>>
    <</if>>
    <br>
    <<if between($bird.hunts.distanceNorth, ($daily.huntRemyCampNorth - 1), ($daily.huntRemyCampNorth + 1)) and between($bird.hunts.distanceEast, ($daily.huntRemyCampEast - 1), ($daily.huntRemyCampEast + 1))>>
      <<if !($bird.hunts.distanceNorth is $daily.huntRemyCampNorth and $bird.hunts.distanceEast is $daily.huntRemyCampEast)>>
        <<language>>
          <<option 'EN'>>
            <<if $bird.hunts.distanceNorth lt $daily.huntRemyCampNorth>>north<<elseif $bird.hunts.distanceNorth gt $daily.huntRemyCampNorth>>south<</if>><<if $bird.hunts.distanceEast lt $daily.huntRemyCampEast>>east<<elseif $bird.hunts.distanceEast gt $daily.huntRemyCampEast>>west<</if>> of here, smoke is rising.
          <<option 'CN'>>
            <<if $bird.hunts.distanceNorth lt $daily.huntRemyCampNorth>>北<<elseif $bird.hunts.distanceNorth gt $daily.huntRemyCampNorth>>南<</if>><<if $bird.hunts.distanceEast lt $daily.huntRemyCampEast>>东<<elseif $bird.hunts.distanceEast gt $daily.huntRemyCampEast>>西<</if>>面有烟火升起。
        <</language>>
        <br>
      <</if>>
    <</if>>
    <<if $daily.emptyCamp and between($bird.hunts.distanceNorth, ($daily.emptyCampNorth - 1), ($daily.emptyCampNorth + 1)) and between($bird.hunts.distanceEast, ($daily.emptyCampEast - 1), ($daily.emptyCampEast + 1))>>
      <<if !($bird.hunts.distanceNorth is $daily.emptyCampNorth and $bird.hunts.distanceEast is $daily.emptyCampEast)>>
        <<language>>
          <<option 'EN'>>
            <<if $bird.hunts.distanceNorth lt $daily.emptyCampNorth>>north<<elseif $bird.hunts.distanceNorth gt $daily.emptyCampNorth>>south<</if>><<if $bird.hunts.distanceEast lt $daily.emptyCampEast>>east<<elseif $bird.hunts.distanceEast gt $daily.emptyCampEast>>west<</if>> of here, there is an abandoned camp.
          <<option 'CN'>>
            <<if $bird.hunts.distanceNorth lt $daily.emptyCampNorth>>北<<elseif $bird.hunts.distanceNorth gt $daily.emptyCampNorth>>南<</if>><<if $bird.hunts.distanceEast lt $daily.emptyCampEast>>东<<elseif $bird.hunts.distanceEast gt $daily.emptyCampEast>>西<</if>>面有个废弃的营地。
        <</language>>
        <br>
      <</if>>
    <</if>>
    <<if between($bird.hunts.distanceNorth, -4, -2) and between($bird.hunts.distanceEast, 2, 4)>>
      <<if !($bird.hunts.distanceNorth is -3 and $bird.hunts.distanceEast is 3)>>
        <<language>>
          <<option 'EN'>>
            <<if $bird.hunts.distanceNorth lt -3>>north<<elseif $bird.hunts.distanceNorth gt -3>>south<</if>><<if $bird.hunts.distanceEast lt 3>>east<<elseif $bird.hunts.distanceEast gt 3>>west<</if>> of here, there is a large rock atop a small hill.
          <<option 'CN'>>
            <<if $bird.hunts.distanceNorth lt -3>>北<<elseif $bird.hunts.distanceNorth gt -3>>南<</if>><<if $bird.hunts.distanceEast lt 3>>东<<elseif $bird.hunts.distanceEast gt 3>>西<</if>>面一座小山山顶上有块大石头。
        <</language>>
        <br>
      <</if>>
    <</if>>
    <<if between($bird.hunts.distanceNorth, -4, -2) and between($bird.hunts.distanceEast, -4, -2)>>
      <<if !($bird.hunts.distanceNorth is -3 and $bird.hunts.distanceEast is -3)>>
        <<language>>
          <<option 'EN'>>
            <<if $bird.hunts.distanceNorth lt -3>>north<<elseif $bird.hunts.distanceNorth gt -3>>south<</if>><<if $bird.hunts.distanceEast lt -3>>east<<elseif $bird.hunts.distanceEast gt -3>>west<</if>> of here, there is a large rock atop a small hill.
          <<option 'CN'>>
            <<if $bird.hunts.distanceNorth lt -3>>北<<elseif $bird.hunts.distanceNorth gt -3>>南<</if>><<if $bird.hunts.distanceEast lt -3>>东<<elseif $bird.hunts.distanceEast gt -3>>西<</if>>面一座小山山顶上有块大石头。
        <</language>>
        <br>
      <</if>>
    <</if>>
    <<if $bird.hunts.distanceNorth is 5>>
      <<language>>
        <<option 'EN'>>
          Farmland stretches to the north. It is the border of your territory.
        <<option 'CN'>>
          农田延伸至北方，那里是你们领地的边境。
      <</language>>
      <br>
      <<if maplebirch.get('BirdTower').selectTrait("sympathy") and !$BirdTower.hunt.shown.north>>
        <<set $BirdTower.hunt.shown.north to 1>>
        <<childrenNames _tempIDs>><<lanSwitch ' peek about behind you, seemingly very interested in the various creatures moving in the farmland.' '在你的身后探头探脑，似乎对农田里移动的各种生物很感兴趣。'>>
        <br>
      <</if>>
    <<elseif $bird.hunts.distanceEast is 5>>
      <<language>>
        <<option 'EN'>>
          If you keep flying east, you may enter dangerous territory you do not know.
        <<option 'CN'>>
          继续往东飞去的话，你可能会进入自己并不熟悉的危险的领域。
      <</language>>
      <br>
      <<if maplebirch.get('BirdTower').selectTrait("dominant") and !$BirdTower.hunt.shown.east>>
        <<set $BirdTower.hunt.shown.east to 1>>
        <<language>>
          <<option 'EN'>>
            <<childrenNames _tempIDs>> focus intently on the moor below their talons, searching for prey. <<= _length gt 1 ? lanSwitch("They", "他们") : "<<childhim _tempIDs[0]>>" >> will find new hunting grounds one day, but not now.
          <<option 'CN'>>
            <<childrenNames _tempIDs>>专心致志地盯着爪下的荒原寻找猎物。<<= _length gt 1 ? lanSwitch("They", "他们") : "<<childhim _tempIDs[0]>>" >>终有一天会找到新的猎场，但不是现在。
        <</language>>
        <br>
      <</if>>
    <<elseif $bird.hunts.distanceNorth is -5>>
      <<language>>
        <<option 'EN'>>
          The farther south you fly, the more your sense of direction fades. Perhaps it would be wise to turn back.
        <<option 'CN'>>
          你感觉越往南面飞去，你的方向感就越加丧失。也许掉头返回才是明智选择。
      <</language>>
      <br>
      <<if maplebirch.get('BirdTower').selectTrait("clever") and !$BirdTower.hunt.shown.south>>
        <<set _nervousChild to _tempIDs[random(0, _length - 1)]>>
        <<set $BirdTower.hunt.shown.south to 1>>
        <<language>>
          <<option 'EN'>>
            <<childname _nervousChild>> seems a little nervous, <<childhis _nervousChild>> feathers puff up slightly as they stare farther across the moor.
          <<option 'CN'>>
            <<childname _nervousChild>>似乎有些紧张，<<childhis _nervousChild>>的羽毛微微蓬起，盯着荒原的更远方。
        <</language>>
        <<if _length gt 1>>
          <<language>>
            <<option 'EN'>>
              <<childrenNames `_tempIDs.filter(id => id !== _nervousChild)`>> chirp to soothe <<childhim _nervousChild>>.
            <<option 'CN'>>
              <<childrenNames `_tempIDs.filter(id => id !== _nervousChild)`>>叽喳叫着安抚<<childhim _nervousChild>>。
          <</language>>
        <</if>>
        <br>
      <</if>>
    <<elseif $bird.hunts.distanceEast is -5>>
      <<if $bogProgress gte 1>>
        <<language>>
          <<option 'EN'>>
            The bog stretches to the west, and the forest lies farther beyond it.
          <<option 'CN'>>
            沼泽延伸至西面，森林在沼泽另一端的更远处。
        <</language>>
      <<else>>
        <<language>>
          <<option 'EN'>>
            The forest stretches to the west.
          <<option 'CN'>>
            森林延伸至西面。
        <</language>>
      <</if>>
      <br>
      <<if maplebirch.get('BirdTower').selectTrait("clumsy") and !$BirdTower.hunt.shown.west>>
        <<set $BirdTower.hunt.shown.west to 1>>
        <<language>>
          <<option 'EN'>>
            <<childrenNames _tempIDs>> gaze curiously at the dense forest. Perhaps its tangled woods are just right for little <<= _length gt 1 ? lanSwitch("ones", "他们") : "<<childhim _tempIDs[0]>>" >> to practice flying.
          <<option 'CN'>>
            <<childrenNames _tempIDs>>好奇地望着茂密的森林。也许错综复杂的林间正适合小小的<<= _length gt 1 ? lanSwitch("ones", "他们") : "<<childhim _tempIDs[0]>>" >>练习飞行呢。
        <</language>>
        <br>
      <</if>>
    <</if>>
    <<language>>
      <<option 'EN'>>
        Which direction will you fly?
      <<option 'CN'>>
        你要朝哪个方向飞？
    <</language>>
    <br>
    <<capture _hoursPassed _minutesPassed _fatigueMod _flightTime _fatigueText>>
      <<if $bird.hunts.distanceNorth lt 5>>
        <<lanLink `["North" + " (" + getTimeString(_hoursPassed, _minutesPassed) + ")", "北" + " (" + getTimeString(_hoursPassed, _minutesPassed) + ")"]` "Deadwood BirdTower Hunt Event">>
          <<set $bird.hunts.direction to "north">>
          <<set $bird.hunts.distanceNorth++>>
          <<set $fatigueMod to _fatigueMod>>
          <<set $flightTime to _flightTime>>
          <<bird_pass _flightTime>>
        <</lanLink>>
        <<print _fatigueText>>
        <br>
      <</if>>
      <<if $bird.hunts.distanceEast lt 5>>
        <<lanLink `["East" + " (" + getTimeString(_hoursPassed, _minutesPassed) + ")", "东" + " (" + getTimeString(_hoursPassed, _minutesPassed) + ")"]` "Deadwood BirdTower Hunt Event">>
          <<set $bird.hunts.direction to "east">>
          <<set $bird.hunts.distanceEast++>>
          <<set $fatigueMod to _fatigueMod>>
          <<set $flightTime to _flightTime>>
          <<bird_pass _flightTime>>
        <</lanLink>>
        <<print _fatigueText>>
        <br>
      <</if>>
      <<if $bird.hunts.distanceNorth gt -5>>
        <<lanLink `["South" + " (" + getTimeString(_hoursPassed, _minutesPassed) + ")", "南" + " (" + getTimeString(_hoursPassed, _minutesPassed) + ")"]` "Deadwood BirdTower Hunt Event">>
          <<set $bird.hunts.direction to "south">>
          <<set $bird.hunts.distanceNorth-->>
          <<set $fatigueMod to _fatigueMod>>
          <<set $flightTime to _flightTime>>
          <<bird_pass _flightTime>>
        <</lanLink>>
        <<print _fatigueText>>
        <br>
      <</if>>
      <<if $bird.hunts.distanceEast gt -5>>
        <<lanLink `["West" + " (" + getTimeString(_hoursPassed, _minutesPassed) + ")", "西" + " (" + getTimeString(_hoursPassed, _minutesPassed) + ")"]` "Deadwood BirdTower Hunt Event">>
          <<set $bird.hunts.direction to "west">>
          <<set $bird.hunts.distanceEast-->>
          <<set $fatigueMod to _fatigueMod>>
          <<set $flightTime to _flightTime>>
          <<bird_pass _flightTime>>
        <</lanLink>>
        <<print _fatigueText>>
        <br>
      <</if>>
    <</capture>>
    <br>
    <<lanLink ["Hunt something else", "捕些别的"] "Deadwood BirdTower Hunt Goal">>
      <<endevent>>
      <<set $phase to 1>>
    <</lanLink>>
    <br>
    <<flight_distance_check>>
    <<flight_time_check _returnTime "silent">>
    <<lanLink `["Return to the castle" + " (" + getTimeString(_hoursPassed, _minutesPassed) + ")", "返回城堡" + " (" + getTimeString(_hoursPassed, _minutesPassed) + ")"]` "Deadwood BirdTower Hunt Return">>
      <<set $fatigueMod to _fatigueMod>>
      <<set $flightTime to _flightTime>>
      <<bird_pass _flightTime>>
      <<endevent>>
      <<set $phase to 1>>
    <</lanLink>>
    <<print _fatigueText>>
    <br>
  <</if>>
<</widget>>

<<widget "babyhawk_hunt_return">>
  <<childSelect $BirdTower.hunt.leader>>
  <<if $bird.hunts.weight gte (3+maplebirch.get('BirdTower').party.length)>>
    <<language>>
      <<option 'EN'>>
        You cannot carry any more. You begin to head back to the tower.
      <<option 'CN'>>
        你再也拿不下更多东西了。你们开始返回高塔。
    <</language>>
    <br><br>
    <<flight_distance_check>>
    <<flight_time_check _returnTime "silent">>
    <<lanLink `["Return to the castle" + "(" + getTimeString(_hoursPassed, _minutesPassed) + ")", "回到城堡" + "(" + getTimeString(_hoursPassed, _minutesPassed) + ")"]` "Deadwood BirdTower Hunt Return">>
      <<set $fatigueMod to _fatigueMod>>
      <<set $flightTime to _flightTime>>
      <<bird_pass _flightTime>>
      <<endevent>>
    <</lanLink>>
    <<print _fatigueText>>
    <br>
  <<elseif $stress gte $stressmax or isPregnancyEnding()>>
    <<language>>
      <<option 'EN'>>
        You no longer have the strength to keep flying. Your limp wings turn your flight into a clumsy, rapid descent. Your vision gradually goes black.
      <<option 'CN'>>
        你没有继续飞行的力气了。你无力的翅膀使你的飞行动作变成了笨拙而急速的下降滑行。你的视野逐渐变黑。
    <</language>>
    <br><br>
    <<babyhawks>><<lanSwitch ' cry out sharply behind your head, but the sound is quickly swallowed by a blurry rushing noise. Your body feels cold.' '急促的叫声在你的脑后响起，但很快被模糊不清的哗啦声掩盖。你的身体感到冰冷。'>>
    <br><br>
    <<language>>
      <<option 'EN'>>
        You feel something catch you in midair, and as you start to rise again, a sharp ache fills your ears.
      <<option 'CN'>>
        你感觉到半空中有什么抓住了你，随着你再次开始上升，你的耳膜感到一阵胀痛。
    <</language>>
    <br><br>
    <<lanLink ["Continue (?:??)", "继续 (?:??)"] "Deadwood BirdTower Hunt Passout">>
      <<bird_pass _returnTime>>
    <</lanLink>>
    <br>
  <<elseif $pain gte 90>>
    <<language>>
      <<option 'EN'>>
        <<babyhawks>> fly over to your side and <<= $cmonster ? lanSwitch("take your hand", "拉住了你的手") : lanSwitch("gently peck you", "轻轻啄了你一口")>>. The light touch makes you frown in pain. You are too badly hurt to keep hunting. You turn around and start heading home.
      <<option 'CN'>>
        <<babyhawks>>飞到你的身边，<<= $cmonster ? lanSwitch("take your hand", "拉住了你的手") : lanSwitch("gently peck you", "轻轻啄了你一口")>>。这轻微的触碰却让你因疼痛而皱起了眉头。你伤得太重，无法继续打猎了。你们掉头开始往家的方向返回。
    <</language>>
    <br><br>
    <<flight_distance_check>>
    <<flight_time_check _returnTime "silent">>
    <<lanLink `["Return to the castle" + "(" + getTimeString(_hoursPassed, _minutesPassed) + ")", "回到城堡" + "(" + getTimeString(_hoursPassed, _minutesPassed) + ")"]` "Deadwood BirdTower Hunt Return">>
      <<set $fatigueMod to _fatigueMod>>
      <<set $flightTime to _flightTime>>
      <<bird_pass _flightTime>>
      <<endevent>>
    <</lanLink>>
    <<print _fatigueText>>
    <br>
  <<elseif $bird.hunts.timer gte 90>>
    <<babyhawks>><<lanSwitch ' wingbeats grow slow, and they look very tired.' '翅膀的扇动变得很慢，看起来非常疲惫。'>>
    <<childname $BirdTower.hunt.leader>><<if maplebirch.get('BirdTower').party.length gt 1>><<lanSwitch ' leads the other children to ' '带着其他孩子们'>><</if>><<lanSwitch 'land in a nearby tree to rest.' '落在了附近的树上歇脚。'>>
    <br><br>
    <<= maplebirch.get('BirdTower').party.length gt 1 ? lanSwitch("The children", "孩子们") : lanSwitch("Your child", "你的孩子")>><<lanSwitch ' do not have the stamina for a much longer flight. It is time to go home. You turn around and start heading back to the castle.' '的体力还不足以支撑太长的飞行，是时候回家了。你们调转方向开始返回城堡。'>>
    <br><br>
    <<flight_distance_check>>
    <<flight_time_check _returnTime "silent">>
    <<lanLink `["Return to the castle" + "(" + getTimeString(_hoursPassed, _minutesPassed) + ")", "回到城堡" + "(" + getTimeString(_hoursPassed, _minutesPassed) + ")"]` "Deadwood BirdTower Hunt Return">>
      <<set $fatigueMod to _fatigueMod>>
      <<set $flightTime to _flightTime>>
      <<bird_pass _flightTime>>
      <<endevent>>
    <</lanLink>>
    <<print _fatigueText>>
    <br>
  <<else>>
    <<language>>
      <<option 'EN'>>
        You climb back higher into the sky.
      <<option 'CN'>>
        你们回到更高的空中。
    <</language>>
    <<if $bird.hunts.timer gte 50>>
      <<babyhawks>><<lanSwitch ' are starting to get a little tired.' '开始变得有些疲惫了。'>>
    <<elseif Time.dayState is "dusk" and $bird.hunts.timer gte 60 and !$daily.birdNightWarning>>
      <<set $daily.birdNightWarning to true>>
      <<babyhawks>><<lanSwitch ' watch the sun sink toward the horizon.' '望着地平线上逐渐落下的太阳。'>>
      <<if maplebirch.get('BirdTower').selectTrait("clumsy")>>
        <<childname _tempIDs[0]>><<lanSwitch ' chirps uneasily.' '有些不安地喳喳叫。'>>
        <br><br>
      <</if>>
    <</if>>
    <<endevent>>
    <<if _huntFail is 1>>
      <<set $phase to 2>>
    <</if>>
    <br><br>
    <<babyhawk_hunt_options>>
  <</if>>
<</widget>>

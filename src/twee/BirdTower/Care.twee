:: Deadwood BirdTower BreastFeed []
<<set $pregnancyStats.childBreastfedInteractions++>>
<<if $worn.over_upper.name isnot "naked" or $worn.upper.name isnot "naked" or $worn.under_upper.name isnot "naked">>
  <<language>>
    <<option 'EN'>>
      You adjust your clothes so that <<childhim>> can reach your <<breasts>>.
    <<option 'CN'>>
      你调整了一下你的衣服，好让<<childhim>>能碰到你的<<breasts>>。
  <</language>>
<<else>>
  <<language>>
    <<option 'EN'>>
      You guide your child so that <<childhis>> lips can reach your <<breasts>>.
    <<option 'CN'>>
      你引导你的孩子，好让<<childhis>>的嘴唇能够碰到你的<<breasts>>。
  <</language>>
<</if>>
<br><br>
<<if $childRecords[$childSelected.childId].development.stage is "Immature">>
  <<switch $childRecords[$childSelected.childId].development?.trait>>
    <<case "clumsy">>
      <<language>>
        <<option 'EN'>>
          <<childname>> latches onto your nipple and sucks greedily, perfectly content.
        <<option 'CN'>>
          <<childname>>含住你的乳头，心满意足地大口吸吮起来。
      <</language>>
      <<breastfeed 50>>
      <<language>>
        <<option 'EN'>>
          You watch your child drink and enjoy this peaceful moment.
        <<option 'CN'>>
          你看着你的孩子喝奶，并享受着这平静的时刻。
      <</language>>
      <<lstress>><<stress -6>>
    <<case "sympathy">>
      <<language>>
        <<option 'EN'>>
          <<childname>> latches onto your nipple and sucks contentedly. More than feeding, <<childHe>> is enjoying this safe and comfortable feeling.
        <<option 'CN'>>
          <<childname>>含住你的乳头，心满意足地吸吮起来。比起进食，<<childHe>>更多的是在享受这种安全又舒适的感觉。
      <</language>>
      <<breastfeed 40>>
      <<language>>
        <<option 'EN'>>
          You watch your child drink and enjoy this peaceful moment.
        <<option 'CN'>>
          你看着你的孩子喝奶，并享受着这平静的时刻。
      <</language>>
      <<lstress>><<stress -6>>
    <<case "clever">>
      <<language>>
        <<option 'EN'>>
          <<childname>> presses <<childhis>> cheek to your chest and blinks up at you. <<childHe>> begins to suck quietly at your nipple, and stops feeding before long.
        <<option 'CN'>>
          <<childname>>把脸颊贴在你的胸口，眨巴眼睛望向你。<<childHe>>开始安静地吸吮你的乳头，没过一会儿便停止了进食。
      <</language>>
      <<breastfeed 30>>
      <<language>>
        <<option 'EN'>>
          More than milk, <<childHe>> seems to prefer lurkers now.
        <<option 'CN'>>
          比起母乳，<<childHe>>现在好像更喜欢潜伏者。
      <</language>>
    <<case "dominant">>
      <<language>>
        <<option 'EN'>>
          <<childname>> latches onto your nipple and sucks half-heartedly, stopping before long.
        <<option 'CN'>>
          <<childname>>含住你的乳头，有一搭没一搭地吸着，没多久便停止了进食。
      <</language>>
      <<breastfeed 20>>
      <<language>>
        <<option 'EN'>>
          More than milk, <<childHe>> seems to prefer lurkers now.
        <<option 'CN'>>
          比起母乳，<<childHe>>现在好像更喜欢潜伏者。
      <</language>>
  <</switch>>
<<else>>
  <<switch random(1, 4)>>
    <<case 1>>
      <<language>>
        <<option 'EN'>>
          <<childHe>> immediately grabs your breast and sucks intently.
        <<option 'CN'>>
          <<childHe>>立刻抓住你的乳房，专注地吮吸起来。
      <</language>>
      <<breastfeed 50>>
    <<case 2>>
      <<language>>
        <<option 'EN'>>
          <<childHe>> buries <<childhis>> head against your chest and wriggles about, playing for a good while before <<childhe>> begins to suck at your nipple.
        <<option 'CN'>>
          <<childHe>>埋在你的胸口晃动脑袋，玩闹了好一会儿才开始吸吮你的乳头。
      <</language>>
      <<breastfeed 40>>
    <<case 3>>
      <<language>>
        <<option 'EN'>>
          <<childHe>> clamps <<childhis>> mouth tightly around your nipple, then sucks with astonishing force. The strength of <<childhis>> sucking soon makes your nipple ache.
        <<option 'CN'>>
          <<childHe>>紧紧咬住你的乳头，然后用惊人的吸力开始吮吸。<<childhis>>吸吮的力量很快让你觉得乳头疼了起来。
      <</language>>
      <<gpain>><<pain 4>><<breastfeed 60>>
    <<default>>
      <<language>>
        <<option 'EN'>>
          <<childHe>> takes your nipple in <<childhis>> mouth and sucks half-heartedly, seeming to have little interest in feeding.
        <<option 'CN'>>
          <<childHe>>叼住你的乳头，有一搭没一搭地吸着，似乎没什么兴趣进食。
      <</language>>
      <<breastfeed 10>>
  <</switch>>
  <<language>>
    <<option 'EN'>>
      You watch your child drink and enjoy this peaceful moment.
    <<option 'CN'>>
      你看着你的孩子喝奶，并享受着这平静的时刻。
  <</language>>
  <<lstress>><<stress -6>>
  <<if $childRecords[$childSelected.childId].development.grow_hint_fledgling is 1 or $childRecords[$childSelected.childId].development.grow_hint_subadult is 1>>
    <<language>>
      <<option 'EN'>>
        <span class="blue"><<childHe>> is clearly drinking more than before.</span>
      <<option 'CN'>>
        <span class="blue"><<childHe>>喝奶的量明显比以前更多。</span>
    <</language>>
  <</if>>
<</if>>
<br><br>
<<lanLink ["Continue", "继续"] $childPassageExit>>
  <<unset $childPassageExit>>
  <<endevent>>
<</lanLink>>

:: Deadwood BirdTower Cuddle []
<<switch random(1, 5)>>
  <<case 1>>
    <<if $cmonster is 1>>
      <<language>>
        <<option 'EN'>>
          <<childHe>> wraps <<childhis>> arms around your neck and leans <<childhis>> whole body against your shoulder.
        <<option 'CN'>>
          <<childHe>>用手挽住你的脖子，随后将整个身子靠在了你的肩膀上。
      <</language>>
    <<else>>
      <<language>>
        <<option 'EN'>>
          <<childHe>> gives a happy tremble of a coo and leans against the side of your neck.
        <<option 'CN'>>
          <<childHe>>发出开心的颤鸣，依靠在你的脖颈旁边。
      <</language>>
    <</if>>
    <<language>>
      <<option 'EN'>>
        You hold each other quietly until <<childname>> lifts <<childhis>> head and hops from your arms back into the nest.
      <<option 'CN'>>
        你们静静地互相拥抱着，直到<<childname>>抬起脑袋，从你的怀抱里跳回巢。
    <</language>>
  <<case 2>>
    <<language>>
      <<option 'EN'>>
        You hum a lilting lullaby, then pat <<childname>> gently on the back and sway along with the tune. Your familiar voice seems to soothe <<childhis>> feelings, and <<childHe>> gives a soft cooing rumble in your arms.
      <<option 'CN'>>
        你哼着悠扬的摇篮曲，然后一边轻轻拍着<<childname>>的背，一边随着曲调轻轻摇晃起来，你那熟悉的声音似乎能抚慰<<childhis>>的情绪，<<childHe>>在你的怀中发出咕咕的颤鸣。
    <</language>>
    <<ltrauma>><<lstress>><<trauma -6>><<stress -6>>
  <<case 3>>
    <<language>>
      <<option 'EN'>>
        You press a gentle kiss to <<childhis>> forehead and give <<childhim>> as much closeness as you can. This gesture encourages <<childhim>><<= $cmonster ? " to lift <<childhis>> head and giggle in return." : " to lift <<childhis>> head and chirp at you.">>
      <<option 'CN'>>
        你在<<childhis>>的额头上轻轻一吻，并尽量与<<childhim>>有更多的亲密接触。这个动作鼓励<<childhim>><<= $cmonster ? "抬起了头，并用咯咯笑作为回礼。" : "抬起脑袋，对你叽叽叫。">>
    <</language>>
    <<ltrauma>><<lstress>><<trauma -6>><<stress -6>>
  <<case 4>>
    <<if $childRecords[$childSelected.childId].development.stage is "Immature">>
      <<language>>
        <<option 'EN'>>
          You put out some different materials near <<childname>> and explain their colours, shapes, textures and uses.
        <<option 'CN'>>
          你在<<childname>>附近放了一些不同的材料，解释着它们的颜色、形状、质地以及用途。
      <</language>>
      <br>
      <<switch $childRecords[$childSelected.childId].development?.trait>>
        <<case "clumsy">>
          <<language>>
            <<option 'EN'>>
              <<childHe>> listens earnestly, then before long starts to drift off, trying to catch the little black specks floating in the air.
            <<option 'CN'>>
              <<childHe>>认真听着，没一会儿便开始走神，试图抓住空气里浮动的小黑点。
          <</language>>
        <<case "sympathy">>
          <<language>>
            <<option 'EN'>>
              <<childHe>> listens earnestly and seems very interested in their particular uses.
            <<option 'CN'>>
              <<childHe>>认真听着，似乎对它们特殊的用法很感兴趣。
          <</language>>
          <<lstress>><<stress -6>>
        <<case "clever">>
          <<language>>
            <<option 'EN'>>
              <<childHe>> listens earnestly, now and then making some <<= $cmonster ? "grunts" : "trills">>, as if echoing what you say.
            <<option 'CN'>>
              <<childHe>>认真听着，时不时发出一些<<= $cmonster ? "咕哝声" : "啁鸣声">>，好像在附和你的话。
          <</language>>
          <<lstress>><<stress -6>>
        <<case "dominant">>
          <<language>>
            <<option 'EN'>>
              <<childHe>> is especially interested in some of the materials; <<childhe>> stands up and fiddles with the materials you prepared with <<childhis>> claws, and before long makes a mess of it all.
            <<option 'CN'>>
              <<childHe>>对其中一些材料格外有兴趣，<<childhe>>站起身，用自己的爪子拨弄玩耍你准备的材料，没一会儿就制造出一片狼藉。
          <</language>>
          <<set $bird.clean += 10>>
      <</switch>>
    <<else>>
      <<language>>
        <<option 'EN'>>
          You put out some different materials near <<childname>> and explain their colours, shapes and textures.
        <<option 'CN'>>
          你在<<childname>>附近放了一些不同的材料，解释着它们的颜色、形状和质地。
      <</language>>
      <<if $cmonster is 1>>
        <<language>>
          <<option 'EN'>>
            <<childHe>> reaches out and touches them, curiously exploring the space around <<childhim>>, then grabs a piece of fabric
          <<option 'CN'>>
            <<childHe>>伸手触摸，好奇地探索着<<childhis>>周围的环境，随后抓住了一块布料
        <</language>>
      <<else>>
        <<language>>
          <<option 'EN'>>
            <<childHe>> pecks at the fabric you show <<childhim>> and tries to pull it from your hands,
          <<option 'CN'>>
            <<childHe>>啄击着你展示的布料，试图把它从你手中拉走，
        <</language>>
      <</if>>
      <<language>>
        <<option 'EN'>>
          and starts tearing at it. <<childHe>> <<childgiggles>>, and you try your best to rescue the fabric from <<childhe>>'s claws.
        <<option 'CN'>>
          并开始撕扯它。<<childHe>><<childgiggles>>，你努力从<<childhe>>爪里解救下这片布料。
      <</language>>
      <<gstress>><<stress 6>>
    <</if>>
  <<default>>
    <<switch $childRecords[$childSelected.childId].development?.trait>>
      <<case "clumsy">>
        <<language>>
          <<option 'EN'>>
            <<childname>> does not want to be held any longer; <<childhe>> squirms in your arms and struggles back down into the nest.
          <<option 'CN'>>
            <<childname>>不想被你一直抱着，<<childhe>>在你的怀里扭动，挣扎着掉回了巢里。
        <</language>>
      <<case "sympathy">>
        <<language>>
          <<option 'EN'>>
            <<childname>> does not want to be held any longer; <<childhe>> gives a protesting cheep and struggles back into the nest.
          <<option 'CN'>>
            <<childname>>不想被你一直抱着，<<childhe>>发出抗议的啾啾叫，挣扎着跳回了巢里。
        <</language>>
      <<case "clever">>
        <<language>>
          <<option 'EN'>>
            <<childname>> does not want to be held any longer; <<childhe>> <<= $cmonster ? "scrunches up <<childhis>> face and slaps" : "pecks">> your arm, and the moment you loosen your grip <<childhe>> flies out of your arms.
          <<option 'CN'>>
            <<childname>>不想被你一直抱着，<<childhe>><<= $cmonster ? "皱起脸拍打" : "啄击">>你的手臂，你松一开手，<<childhe>>就从你的怀里飞了出去。
        <</language>>
      <<case "dominant">>
        <<language>>
          <<option 'EN'>>
            <<childname>> does not want to be held any longer; <<childhe>> wriggles in displeasure and struggles out of your arms in a flurry of wings.
          <<option 'CN'>>
            <<childname>>不想被你一直抱着，<<childhe>>不满地扭动，挣扎着从你的怀里飞了出去。
        <</language>>
      <<default>>
        <<language>>
          <<option 'EN'>>
            <<childname>> resists being picked up and manages to escape from your hands. <<childHe>> lands in the nest unharmed.
          <<option 'CN'>>
            <<childname>>抗拒被抱起，设法从你手中逃脱。<<childHe>>毫发无损地掉进了巢穴。
        <</language>>
    <</switch>>
<</switch>>
<br><br>
<<lanLink ["Continue", "继续"] $childPassageExit>>
  <<unset $childPassageExit>>
  <<endevent>>
<</lanLink>>

:: Deadwood BirdTower Talk []
<<switch random(1, 4)>>
  <<case 1>>
    <<language>>
      <<option 'EN'>>
        You recite a few nursery rhymes you remember from long ago. When <<childHe>> hears your strange intonation, <<childhe>> looks curious. You make a few different sounds and wait for <<childhis>> response.
        <br>
        After a moment, <<childHe>> makes a few chirps, as if imitating your intonation.
      <<option 'CN'>>
        你背诵了几首很久以前记得的童谣。当<<childHe>>听到你的奇特语调时，<<childhe>>看起来很好奇。你发出几声不同的音调，等待<<childhis>>的反应。
        <br>
        过了一会儿，<<childHe>>发出了几声啾鸣，似乎是在模仿你的语调。
    <</language>>
    <<lstress>><<stress -6>>
  <<case 2>>
    <<language>>
      <<option 'EN'>>
        You clear your throat and sing a little song off the top of your head. The lilting tune soon draws <<childname>>'s attention, and <<childhe>> chirps along with you.
      <<option 'CN'>>
        你清了清嗓子，唱起了一首即兴的小曲。悠扬的曲调很快吸引了<<childname>>的注意，让<<childhe>>跟随着你啾啾伴鸣。
    <</language>>
    <<lstress>><<stress -6>>
  <<case 3>>
    <<language>>
      <<option 'EN'>>
        You talk to <<childname>> about <<print either(lanSwitch("life in town", "小镇的生活"),lanSwitch("the sight of the sea", "大海的景象"),lanSwitch("the scenery of the forest", "森林的风景"),lanSwitch("the far reaches of the moor", "荒原的远方"),lanSwitch("the sky and the earth", "天空和大地"))>>.
      <<option 'CN'>>
        你向<<childname>>聊起<<print either("小镇的生活","大海的景象","森林的风景","荒原的远方","天空和大地")>>。
    <</language>>
    <<switch $childRecords[$childSelected.childId].development?.trait>>
      <<case "clumsy">>
        <<language>>
          <<option 'EN'>>
            <<childname>> listens earnestly, but <<childHe>> does not seem able to understand what you are saying.
          <<option 'CN'>>
            <<childname>>认真地听着，但<<childHe>>看起来并不能理解你在说什么。
        <</language>>
      <<case "sympathy">>
        <<language>>
          <<option 'EN'>>
            <<childname>> listens earnestly and seems very interested in the human life you mention now and then.
          <<option 'CN'>>
            <<childname>>认真地听着，似乎对你偶尔提到的人类生活很感兴趣。
        <</language>>
        <<lstress>><<stress -6>>
      <<case "clever">>
        <<language>>
          <<option 'EN'>>
            <<childname>> listens earnestly and seems very interested in certain key words in your sentences.
          <<option 'CN'>>
            <<childname>>认真地听着，似乎对你句子里的某些关键词很感兴趣。
        <</language>>
        <<lstress>><<stress -6>>
      <<case "dominant">>
        <<language>>
          <<option 'EN'>>
            <<childname>> listens earnestly and seems very interested in certain particular foods you mention.
          <<option 'CN'>>
            <<childname>>认真地听着，似乎对你提到的某些特别的食物很感兴趣。
        <</language>>
        <<lstress>><<stress -6>>
      <<default>>
        <<language>>
          <<option 'EN'>>
            <<childHe>> does not seem able to understand what you are saying.
          <<option 'CN'>>
            <<childHe>>看起来并不能听懂你在说什么。
        <</language>>
    <</switch>>
  <<case 4>>
    <<if getPregnancyOf($childSelected).carrier is "pc">>
      <<set _playerRole to "妈妈">>
    <<elseif getPregnancyOf($childSelected).donor is "pc">>
      <<set _playerRole to "爸爸">>
    <<elseif $player.gender_appearance is "m">>
      <<set _playerRole to "爸爸">>
    <<else>>
      <<set _playerRole to "妈妈">>
    <</if>>
    <<language>>
      <<option 'EN'>>
        You call to <<childname>>, trying to teach <<childhe>> the word "<<print lanSwitch(_playerRole is "妈妈" ? "Mom" : "Dad", _playerRole)>>". Each time you open your mouth, <<childhe>> responds softly, but <<childHe>> does not seem very interested. <<childHe>> nuzzles your leg with <<childhis>> head, then turns and leaves.
      <<option 'CN'>>
        你呼唤着<<childname>>，试图教会<<childhe>>"<<print _playerRole>>"这个词。每次你张嘴时，<<childhe>>都会轻轻地做出回应，但<<childHe>>似乎对此没什么兴趣。<<childHe>>用头蹭了一下你的腿，然后转身离开。
    <</language>>
<</switch>>
<br><br>
<<lanLink ["Continue", "继续"] $childPassageExit>>
  <<unset $childPassageExit>>
  <<endevent>>
<</lanLink>>

:: Deadwood BirdTower Play []
<<switch random(1, 2)>>
  <<case 1>>
    <<language>>
      <<option 'EN'>>
        You signal to <<childname>> and toss <<childhe>> gently out of your arms; <<childhe>> flutters <<childhis>> wings across to the far side of the tower, then flies back into your arms. After several round trips you fall into an easy rhythm, catching the returning <<childname>> with a precise reach of your hands.
      <<option 'CN'>>
        你向<<childname>>示意，把<<childhe>>从怀里轻轻抛出去，<<childhe>>扑腾着翅膀飞到塔的对面，随后又飞回你的怀里。这样往返几个来回后，你们建立起了一个默契的节奏，能精准地抬手接住返回的<<childname>>。
    <</language>>
    <<lstress>><<stress -6>>
    <<language>>
      <<option 'EN'>>
        <br>
        Before long, though, <<childhe>> stops making the trips and settles back into the nest to rest on <<childhis>> own.
      <<option 'CN'>>
        <br>
        不过没多久，<<childhe>>就停止了往返，自顾自地坐回巢里休息了。
    <</language>>
  <<case 2>>
    <<language>>
      <<option 'EN'>>
        You cover your face, then suddenly open your palms and say "peekaboo!"
      <<option 'CN'>>
        你捂住自己的脸，随后忽然打开手掌，发出一声"peekaboo!"
    <</language>>
    <<language>>
      <<option 'EN'>>
        <<childname>> seems very interested in this little game; every time you open your palms and show your face <<= $cmonster ? " <<childhe>> giggles and claps" : " <<childhe>> chirps in reply">>.
      <<option 'CN'>>
        <<childname>>似乎对这个小游戏很感兴趣，<<childhe>>在你每一次打开手掌露出脸时<<= $cmonster ? "咯咯笑着拍手" : "回应地唧唧叫">>。
    <</language>>
    <<lstress>><<stress -6>>
    <<if $childRecords[$childSelected.childId].development?.trait is "clever" or $childRecords[$childSelected.childId].development?.trait is "sympathy">>
      <br><br>
      <<language>>
        <<option 'EN'>>
          When you cover your face one last time and open your palms, <<childname>> imitates your intonation and makes a blurry "peekaboo"!
        <<option 'CN'>>
          当你最后一次捂住脸，打开手掌时，<<childname>>模仿着你的音调发出了一声模糊的"peekaboo"！
      <</language>>
      <<ltrauma>><<trauma -6>>
    <</if>>
<</switch>>
<br><br>
<<lanLink ["Continue", "继续"] $childPassageExit>>
  <<unset $childPassageExit>>
  <<endevent>>
<</lanLink>>

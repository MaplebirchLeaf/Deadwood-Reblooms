:: Deadwood Reblooms Journal Widgets [widget]

<!-- 日志入口与栏目集中维护，只读当前存档，进度结算仍由各模块负责。 -->

<!-- 企业经营 -->

<<widget 'deadwood-company-journal'>>
  <<if $Finance.company.name>>
    <div class='bold'><<print $Finance.company.name>></div>
    <ul class='journal'>
      <li>
        <<if $Finance.company.office>>
          <<lanSwitch 'Office rent: ' '办公室周租：'>><<deadwood-reblooms-finance-money `maplebirch.get('Finance').company.terms.weeklyRent`>>
          · <<deadwood-reblooms-finance-date $Finance.company.rent_day>>
          <<if $Finance.company.rent_arrears gt 0>>
            <br><span class='red'><<lanSwitch 'Overdue rent: ' '欠租：'>></span><<deadwood-reblooms-finance-money $Finance.company.rent_arrears 'red'>>
          <</if>>
        <<else>>
          <<language>>
            <<option 'EN'>>
              Your business is registered. You can rent an office in the office-building lobby.
            <<option 'CN'>>
              企业已登记。可到办公大楼大厅租用办公室。
          <</language>>
        <</if>>
      </li>
      <<if $Finance.company.contract>>
        <li>
          <<switch $Finance.company.contract.stage>>
            <<case 'production'>>
              <<language>>
                <<option 'EN'>>
                  The factory is making the company's shelving order. Arrange delivery at the yard when it is ready.
                <<option 'CN'>>
                  工厂正在生产公司的金属货架订单。完工后到厂房院落安排发货。
              <</language>>
            <<case 'disputed'>>
              <span class='red'>
                <<language>>
                  <<option 'EN'>>
                    The company's payment is overdue. Take the invoice to the accounts desk through your office.
                  <<option 'CN'>>
                    公司的货款已逾期。可从自己的办公室带账单去财务处催收。
                <</language>>
              </span>
            <<default>>
              <<lanSwitch `$Finance.company.contract.due < 0 ? 'Advance to return: ' : 'Outstanding invoice: '` `$Finance.company.contract.due < 0 ? '应退预付款：' : '待收货款：'`>><<deadwood-reblooms-finance-money `Math.abs($Finance.company.contract.due)` `$Finance.company.contract.due < 0 ? 'red' : 'gold'`>>
              · <<deadwood-reblooms-finance-date $Finance.company.contract.pay_day>>
          <</switch>>
        </li>
      <</if>>
      <<if $Finance.company.agreement>>
        <li @class='maplebirch.get("Finance").company.partner ? "green" : "red"'>
          <<if maplebirch.get('Finance').company.partner>>
            <<language>>
              <<option 'EN'>>
                Your joint operating agreement is active. New orders pay a larger advance, and changes to the supply terms require your signature.
              <<option 'CN'>>
                共同经营协议生效中。新订单提高预付款，供货条件的变更需要你的签字。
            <</language>>
          <<else>>
            <<language>>
              <<option 'EN'>>
                The agreement is suspended. Check your office rent and debt notices. Signed orders retain their original terms.
              <<option 'CN'>>
                协议暂停生效。请检查办公室租金与追偿欠款。已签订单仍按原条款履行。
            <</language>>
          <</if>>
        </li>
      <<elseif $Finance.company.office and !$Finance.company.contract>>
        <li>
          <<if $Finance.company.completed gte maplebirch.get('Finance').company.terms.partnerContracts>>
            <<lanSwitch 'You have settled enough supply orders to discuss closer cooperation. Return to your office to arrange a meeting with Avery.' '已结清足够的供货订单，可以商议进一步合作。回自己的办公室，安排与艾弗里会面。'>>
          <<else>>
            <<lanSwitch 'Supply orders can be arranged through your office. Further cooperation requires three settled company orders.' '可从自己的办公室安排供货订单。结清三笔公司供货后，再商议进一步合作。'>>
          <</if>>
        </li>
      <</if>>
      <<if maplebirch.get('Finance').company.staff.arrears gt 0>>
        <li class='red'><<lanSwitch 'Unpaid staff wages: ' '职员欠薪：'>><<printmoney `maplebirch.get('Finance').company.staff.arrears`>> · <<lanSwitch 'Unpaid staff have suspended their services. Settle wages at your office.' '欠薪职员已暂停工作，请到办公室结清工资。'>></li>
      <</if>>
    </ul>
    <hr>
  <</if>>
<</widget>>

<!-- 升华仪式 -->

<<widget 'deadwood-ascension-journal'>>
  <<deadwood-ascension-header>>
  <<if _ascension_state.ascended and !_ascension_state.jordan_told>>
    <hr>
    <div class='bold'>
      <<if _ascension_state.recognized>>
        <<lanSwitch 'Night Raven' '夜渡鸦'>>
      <<else>>
        <<lanSwitch 'Ascended' '飞升'>>
      <</if>>
    </div>
    <ul class='journal'>
      <li><<lanSwitch 'You could ask Jordan about what happened to you, if you wish to disclose it.' '如果愿意说出这件事，可以向约旦询问自身的变化。'>></li>
    </ul>
    <hr>
  <<elseif !_ascension_state.ascended and _ascension_state.prepared_day gte 0 and !$avery_fate>>
    <div class='bold'><<lanSwitch 'Your terms for the ceremony' '参与仪式的条件'>></div>
    <ul class='journal'>
      <li>
        <<language>>
          <<option 'EN'>>
            Avery agreed to pass your request to Harper. From the following day, if your business position still carries weight, you can raise it before entering the lift at the blood-moon gathering.
            The outcome remains uncertain.
          <<option 'CN'>>
            艾弗里答应把你的要求交给哈珀。从次日起，如果你在生意上仍有足够分量，可以在血月聚会乘电梯之前提出条件。
            最后的结果仍然无法保证。
        <</language>>
      </li>
    </ul>
    <hr>
  <</if>>
<</widget>>

<!-- 艾弗里邀约与私人聚会 -->

<<widget 'deadwood-avery-journal'>>
  <<set _avery_notes to $Finance.company.avery>>
  <<if _avery_notes.date_state is 'scheduled' and _avery_notes.date_day gte Math.floor(Time.days)>>
    <div class='bold'><<lanSwitch "Avery's invitation" '艾弗里的邀约'>></div>
    <ul class='journal'>
      <li>
        <<lanSwitch 'You accepted an invitation for ' '你接受了邀约，日期是'>><<deadwood-reblooms-finance-date _avery_notes.date_day>><<lanSwitch '. ' '。'>>
        <<language>>
          <<option 'EN'>>
            Meet Avery between <<ampm 20 00>> and <<ampm 21 00>>,
            <<if $avery_mansion>>in the mansion garage<<else>>on Domus Street<</if>>. Wear something formal.
          <<option 'CN'>>
            请在<<ampm 20 00>>到<<ampm 21 00>>之间，
            <<if $avery_mansion>>到宅邸的车库<<else>>到宅邸街<</if>>见艾弗里。穿正式些。
        <</language>>
      </li>
    </ul>
    <hr>
  <<elseif _avery_notes.date_state is 'cancelled' and _avery_notes.date_day gte Math.floor(Time.days)>>
    <div class='bold'><<lanSwitch "Avery's invitation" '艾弗里的邀约'>></div>
    <ul class='journal'>
      <li><<lanSwitch 'The invitation through the office could not be confirmed. Any existing arrangement with Avery still takes precedence.' '接待处约下的这次邀约没有得到确认。你与艾弗里原有的安排仍然优先。'>></li>
    </ul>
    <hr>
  <</if>>
  <<if !$avery_fate and !_avery_notes.dream_seen and (_avery_notes.papers_read or _avery_notes.site_visited)>>
    <div class='bold'><<lanSwitch "Avery's private gathering" '艾弗里的私人聚会'>></div>
    <ul class='journal'>
      <<if _avery_notes.decision is 'leave'>>
        <li>
          <<language>>
            <<option 'EN'>>
              You left before going upstairs. Avery said you would discuss it later. The ceremony has not taken place.
            <<option 'CN'>>
              你在上楼前离开了。艾弗里说，这件事以后再谈。仪式还没有举行。
          <</language>>
        </li>
      <<elseif _avery_notes.invited>>
        <li>
          <<language>>
            <<option 'EN'>>
              Avery agreed to have Harper explain your role before you go upstairs. Meet Avery at the mansion on the blood moon.
            <<option 'CN'>>
              艾弗里答应，上楼前让哈珀向你解释职责。血月期间，到宅邸找艾弗里。
          <</language>>
        </li>
      <<else>>
        <<if !_avery_notes.papers_read>>
          <li><<lanSwitch 'The construction and opening files can be reviewed through the shareholder reception desk.' '可从股东接待处查阅施工与开幕安排。'>></li>
        <</if>>
        <<if !_avery_notes.site_visited>>
          <li><<lanSwitch 'The site on Elk Street may tell you more about the arrangements.' '麋鹿街的施工现场或许能让你进一步了解安排。'>></li>
        <</if>>
        <<if _avery_notes.papers_read and _avery_notes.site_visited>>
          <li><<lanSwitch 'Once construction reaches the finishing stage, ask Avery about the private gathering through the reception desk.' '施工进入收尾阶段后，可从接待处约艾弗里，问清私人聚会的安排。'>></li>
        <</if>>
      <</if>>
    </ul>
    <hr>
  <</if>>
<</widget>>

<!-- 摩天大楼套房 -->

<<widget 'deadwood-property-suite-record'>>
  <<set _suite to maplebirch.get('Finance').company.suite>>
  <<if _suite.state.signed>>
    <ul class='journal'>
      <<if _suite.occupied>>
        <li><<language>>
          <<option 'EN'>>
            You hold an accommodation agreement for a private suite in the skyscraper on <span class='teal'>Elk Street</span>.
            The residents' lift is in the lobby.
          <<option 'CN'>>
            你签有<span class='teal'>麋鹿街摩天大楼</span>私人套房的住宿协议，住户电梯在大厅里。
        <</language>></li>
        <<if _suite.state.notice_day isnot null>>
          <li class='red'>
            <<lanSwitch 'Vacate by ' '搬离期限：'>>
            <<deadwood-reblooms-finance-date `_suite.state.notice_day + 7`>>
          </li>
        <</if>>
      <<else>>
        <li><<lanSwitch 'Your agreement no longer grants access to the suite. Any stored clothes can be collected through the lobby desk.' '套房的住宿权限已撤销。留存的衣物可通过大厅接待处领取。'>></li>
      <</if>>
      <<if _suite.state.arrears gt 0>>
        <li class='red'><<lanSwitch 'Unpaid upkeep: ' '未付维护费：'>><<printmoney _suite.state.arrears>></li>
      <</if>>
    </ul>
  <</if>>
<</widget>>

<!-- 工厂 -->

<<widget 'deadwood-industry-journal'>>
  <<if $Finance and maplebirch.get('Finance').industry.owned.length>>
    <<set _factory_daily_costs to maplebirch.get('Finance').industry.dailyCosts>>
    <<for _factory_site range maplebirch.get('Finance').industry.terms.sites>>
      <<set _factory_state to $Finance.industry.factories[_factory_site.id]>>
      <<if _factory_state.owned>>
        <div class='bold'><<= maplebirch.t(_factory_site.name)>></div>
        <ul class='journal'>
          <li><<lanSwitch "Working funds: " "周转金：">><<deadwood-reblooms-finance-money _factory_state.cash>></li>
          <li><<lanSwitch "Daily payroll and bills: " "每日工资与费用：">><<deadwood-reblooms-finance-money _factory_daily_costs[_factory_site.id]>></li>
          <li><<lanSwitch "Workers: " "工人：">><span class='teal'><<= _factory_state.workers>></span></li>
          <li><<lanSwitch "Crew morale: " "工人士气：">><span @class="_factory_state.morale < 20 ? 'red' : 'teal'"><<= _factory_state.morale>> / 100</span></li>
          <<if Time.days lt _factory_state.ready_day>>
            <li><<lanSwitch "Building work finishes on " "工程预计完成于">><<deadwood-reblooms-finance-date _factory_state.ready_day>></li>
          <</if>>
          <<if _factory_state.wage_arrears gt 0 or _factory_state.overhead_arrears gt 0>>
            <li><span class='red'><<lanSwitch "Unpaid wages and bills: " "欠薪与未付费用：">><<deadwood-reblooms-finance-money `_factory_state.wage_arrears + _factory_state.overhead_arrears`>></span></li>
          <</if>>
          <<if _factory_state.unpaid_days gt 0 and (_factory_state.workers gt 0 or _factory_state.manager or _factory_state.laboratory.technician)>>
            <li class='red'><<lanSwitch 'Days without cleared wages: ' '欠薪已持续：'>><<= _factory_state.unpaid_days>><<lanSwitch ' / 14. The crew will resign if the arrears remain unpaid.' '／14 天。仍未结清时，雇工将离职。'>></li>
          <</if>>
          <<if _factory_state.issue>>
            <li><span class='red'><<lanSwitch "There is something waiting for your decision at the yard." "院子里有件事等你决定。">></span></li>
          <</if>>
          <<if _factory_state.morale lt 20>>
            <li><span class='red'><<lanSwitch "The exhausted crew have stopped work." "工人疲惫不堪，已经停工。">></span></li>
          <</if>>
          <<if _factory_state.order>>
            <li><<lanSwitch "Current order: " "当前订单：">><<= _factory_state.order.progress>> / <<= _factory_state.order.batches>> · <<deadwood-reblooms-finance-date _factory_state.order.deadline>></li>
          <</if>>
          <<if _factory_state.laboratory.installed>>
            <li>
              <<language>>
                <<option 'EN'>>
                  Processing room: <span class='teal'><<= _factory_state.laboratory.batches.reduce((sum, batch) => sum + (batch.expires_day > Math.floor(Time.days) ? batch.units : 0), 0)>></span> packs on the shelf; <span class='red'><<= _factory_state.laboratory.spoiled>></span> lost to expiry.
                <<option 'CN'>>
                  加工间：<span class='teal'><<= _factory_state.laboratory.batches.reduce((sum, batch) => sum + (batch.expires_day > Math.floor(Time.days) ? batch.units : 0), 0)>></span>包在库，<span class='red'><<= _factory_state.laboratory.spoiled>></span>包已过期。
              <</language>>
            </li>
            <<if $Finance.industry.distribution.harper_site is _factory_state.site>>
              <li><<deadwood-laboratory-harper-status _factory_state>></li>
            <</if>>
            <<if _factory_state.laboratory.job>>
              <li>
                <<language>>
                  <<option 'EN'>>
                    Processing is underway.
                  <<option 'CN'>>
                    加工正在进行。
                <</language>>
              </li>
            <</if>>
            <<if _factory_state.laboratory.invoices.length>>
              <li>
                <<language>>
                  <<option 'EN'>>
                    Processing invoices outstanding:
                  <<option 'CN'>>
                    加工业务待收款：
                <</language>>
                <<deadwood-reblooms-finance-money `_factory_state.laboratory.invoices.reduce((sum, invoice) => sum + invoice.total, 0)`>>
              </li>
            <</if>>
          <</if>>
          <<if _factory_state.invoices.length>>
            <<set $_factoryReceivables to _factory_state.invoices.reduce((sum, invoice) => sum + Math.max(0, invoice.order.total), 0), $_factoryRefunds to _factory_state.invoices.reduce((sum, invoice) => sum + Math.max(0, -invoice.order.total), 0)>>
            <<if $_factoryReceivables gt 0>><li><<lanSwitch 'Unpaid invoices: ' '待收货款：'>><<deadwood-reblooms-finance-money $_factoryReceivables>></li><</if>>
            <<if $_factoryRefunds gt 0>><li class='red'><<lanSwitch 'Advances to return: ' '应退预付款：'>><<deadwood-reblooms-finance-money $_factoryRefunds 'red'>></li><</if>>
          <</if>>
          <<if _factory_state.automatic or _factory_state.laboratory.automatic>>
            <<if !_factory_state.manager>>
              <li class='red'><<lanSwitch 'Automatic production is waiting for a shift manager.' '自动生产正在等待值班经理。'>></li>
            <<elseif _factory_state.workers lt 2>>
              <li class='red'><<lanSwitch 'Automatic production is suspended with fewer than two workers.' '工人不足两名，自动生产暂停。'>></li>
            <<elseif _factory_state.laboratory.automatic and !_factory_state.laboratory.technician>>
              <li class='red'><<lanSwitch 'Processing is waiting for a technician.' '加工间正在等待技术员。'>></li>
            <</if>>
          <</if>>
        </ul>
        <hr>
      <</if>>
    <</for>>
  <</if>>
<</widget>>

<!-- 账户、证券与房产账目 -->

<<widget 'deadwood-reblooms-finance-journal'>>
  <<if $Finance and ($Finance.bank.opened or $Finance.brokerage.opened or $Finance.company.name or maplebirch.get('Finance').industry.owned.length or maplebirch.get('Orchard')?.state.worker.hired or maplebirch.get('Orchard')?.staff.employed or $Finance.newspaper.report or $Finance.orphanage.offer isnot null or Object.values($Finance.real_estate.owned).some(Boolean) or $Finance.collection.amount gt 0 or $Finance.donations.receipts.length or Object.values($Finance.donations.total).some(value => value > 0))>>
    <<set _finance_mortgage to maplebirch.get("Finance").realEstate.mortgage.current>>
    <h1 class='header gold bold'><<lanSwitch 'Finances' '财务'>></h1>
    <<deadwood-finance-risk-summary true>>
    <<deadwood-finance-account-statements>>
    <<deadwood-finance-operations>>
    <<if $Finance.brokerage.opened>>
      <<deadwood-finance-holdings>>
      <<deadwood-finance-news>>
    <</if>>
    <<if $Finance.brokerage.margin.history.length>><<deadwood-finance-closing-records>><</if>>
    <<if Object.values($Finance.real_estate.owned).some(Boolean)>><<deadwood-finance-property-accounts>><</if>>
    <<deadwood-finance-donation-receipts>>
    <<deadwood-finance-school-donation-journal>>
    <<deadwood-finance-aid-journal>>
    <!-- 晋升履历只读。不调用柜台情境或每日结算，查日志不会增加来访与业务天数。 -->
    <<if C.npc.Adrian.init is 1 and $Finance.adrian.career gt 0>>
      <<deadwood-card "Adrian's promotion" '阿德里安的晋升'>>
        <<switch $Finance.adrian.career>>
          <<case 1 2>>
            <<lanSwitch 'Required net deposits: ' '所需净存款：'>><<printmoney `$Finance.adrian.career === 1 ? 500000 : 2500000`>><br>
            <<language>>
              <<option 'EN'>>
                Qualifying daily settlements: <span class='blue'><<= $Finance.adrian.business_days>> / <<= $Finance.adrian.career is 1 ? 7 : 14>></span>. Below the deposit requirement or behind on repayments, the current streak starts again.
              <<option 'CN'>>
                符合条件的连续日结：<span class='blue'><<= $Finance.adrian.business_days>> / <<= $Finance.adrian.career is 1 ? 7 : 14>></span>。日结时存款不足或还款逾期，当前阶段重新累计。
            <</language>><br>
          <<case 3>>
            <<lanSwitch 'The business record is ready. Keep at least ' '业务记录已达标。保持至少 '>><<printmoney 2500000>><<lanSwitch ' in net deposits, a debit card and no overdue repayments. Authorise Adrian to include your account during counter hours.' '净存款、已办借记卡且没有逾期还款，在柜台办公时确认授权，让阿德里安将账户业务列入竞聘材料。'>><br>
          <<case 4>>
            <<lanSwitch 'The application is under review. Earliest result: ' '竞聘材料正在审核。最早可询问结果的日期：'>><<deadwood-reblooms-finance-date $Finance.adrian.career_ready_day>><br>
            <<lanSwitch 'Keep at least ' '保持至少 '>><<printmoney 2500000>><<lanSwitch ' in net deposits, a debit card and no overdue repayments. A failed daily settlement restarts the review week. Ask Adrian at the counter after the review.' '净存款、已办借记卡且没有逾期还款。日结不符合条件时，审核周重新计算。审核结束后，回柜台找阿德里安询问。'>><br>
          <<case 5>>
            <span class='green'><<lanSwitch 'Adrian has been appointed branch manager.' '阿德里安已获任分行经理。'>></span><br>
        <</switch>>
        <<if $Finance.adrian.career is 5>>
          <strong class='gold'><<lanSwitch 'Personal-loan weekly rates' '个人贷款周利率'>></strong><br>
          <<for _adrianLoan range maplebirch.get('Finance').loanProducts>>
            <<= _adrianLoan.days>> <<lanSwitch 'days' '天'>>：
            <<= (_adrianLoan.baseWeeklyRate * 100).toFixed(3)>>% →
            <span class='blue'><<= (_adrianLoan.weeklyRate * 100).toFixed(3)>>%</span><br>
          <</for>>
          <<if $Finance.bank.credit_missed_payments gt 0 or $Finance.bank.loan_missed_payments gt 0>>
            <<language>>
              <<option 'EN'>>
                <span class='red'>The discount is currently suspended because of missed repayments.</span> The rates above show your current quote. Clear the affected credit-card or personal-loan debt to reset its missed-payment record.
              <<option 'CN'>>
                <span class='red'>当前有逾期记录，优惠已暂停。</span>上方显示的是当前报价。结清有逾期记录的信用卡或个人贷款欠款，才能清除对应的漏还记录。
            <</language>>
          <<else>>
            <<language>>
              <<option 'EN'>>
                <span class='green'>The discount is active.</span> Deposit interest, credit-card interest and mortgages are unaffected.
              <<option 'CN'>>
                <span class='green'>优惠已生效。</span>存款利息、信用卡利息和房贷不受影响。
            <</language>>
          <</if>>
          <br><br>
        <</if>>
        <<if $Finance.adrian.career gt 0 and $Finance.adrian.career lt 5>>
          <<language>>
            <<option 'EN'>>
              <i>Net deposits are your bank balance minus credit-card, personal-loan, mortgage and collection debts.</i>
            <<option 'CN'>>
              <i>净存款为银行余额扣除信用卡、个人贷款、房贷与追偿欠款。</i>
          <</language>><br>
        <</if>>
      <</deadwood-card>>
    <</if>>
    <ul class='journal'>
      <<if $Finance.orphanage.pc_bought_out or $Finance.orphanage.robin_bought_out>>
        <li class='green'>
          <<language>>
            <<option 'EN'>>
              <<if $Finance.orphanage.pc_bought_out>>Your rent is bought out. Your room at the orphanage remains available.<</if>>
              <<if $Finance.orphanage.robin_bought_out>>Robin's rent is bought out. Robin's room remains available.<</if>>
            <<option 'CN'>>
              <<if $Finance.orphanage.pc_bought_out>>你的房租已买断，孤儿院原来的房间仍能使用。<</if>>
              <<if $Finance.orphanage.robin_bought_out>>罗宾的房租已买断，原房间仍能使用。<</if>>
          <</language>>
        </li>
      <</if>>
      <<if $Finance.orphanage.offer isnot null and !maplebirch.get('Finance').orphanage.boughtOut>>
        <li>
          <<language>>
            <<option 'EN'>>
              Bailey has quoted separate buyouts for your rent and Robin's.
            <<option 'CN'>>
              贝利已经分别给你和罗宾的房租买断开了价。
          <</language>>
          <<if !$Finance.orphanage.agreed and !$Finance.orphanage.robin_bought_out>>
            <<language>>
              <<option 'EN'>>
                To pay for Robin, talk to <<nnpc_him 'Robin'>> in <<nnpc_his 'Robin'>> room first. You can settle your own contract separately.
              <<option 'CN'>>
                要结清罗宾那份，先回房间和<<nnpc_him 'Robin'>>谈谈。你自己的那份可以单独办理。
            <</language>>
          <<else>>
            <<language>>
              <<option 'EN'>>
                Bring the money to Bailey's office between 7:00 and 9:50.
              <<option 'CN'>>
                准备好钱，在早上 7:00 至 9:50 之间去贝利的办公室。
            <</language>>
          <</if>>
        </li>
      <</if>>
      <<if $Finance.newspaper.report>>
        <li><<deadwood-finance-paper-summary>></li>
      <</if>>
    </ul>
    <<for _finance_property range maplebirch.get('Finance').realEstate.properties>>
      <<capture _finance_property>>
        <<if maplebirch.get('Finance').realEstate.owns(_finance_property.id) or (_finance_property.tenure is 'company' and $Finance.company.suite.signed and ($Finance.company.suite.arrears gt 0 or Object.values($wardrobes.deadwood_penthouse ?? {}).some(items => Array.isArray(items) and items.length gt 0)))>>
          <<set _finance_property_state to maplebirch.get('Finance').realEstate.managementFor(_finance_property.id)>>
          <<set _finance_property_upkeep to maplebirch.get('Finance').realEstate.maintenanceCost(_finance_property.id)>>
          <<deadwood-card _finance_property.name.EN _finance_property.name.CN>>
            <<if _finance_property.tenure is 'company'>><<deadwood-property-suite-record>><</if>>
            <<if maplebirch.get('Finance').realEstate.owns(_finance_property.id)>>
              <<if _finance_property_state.rented>>
                <<set _finance_property_rent to maplebirch.get("Finance").realEstate.weeklyRent(_finance_property.id)>>
                <<lanSwitch 'Rented out, weekly rent: ' '已出租，每周租金：'>>
                <<deadwood-reblooms-finance-money _finance_property_rent>>
              <<elseif _finance_property_state.auction_day isnot null>>
                <span class='blue'><<lanSwitch 'Auction closes on day ' '拍卖于第 '>>
                <<= _finance_property_state.auction_day>><<lanSwitch '.' ' 天结束。'>></span>
              <<else>>
                <span class='green'><<lanSwitch 'Your home' '你的住所'>></span>
              <</if>>
              <br><<lanSwitch 'Weekly upkeep: ' '每周维护费：'>>
              <<deadwood-reblooms-finance-money _finance_property_upkeep>>
              <<lanSwitch ', next settlement: ' '，下次结算：'>>
              <<deadwood-reblooms-finance-date `_finance_property.tenure === 'company' ? $Finance.company.suite.next_upkeep_day : _finance_property_state.next_settlement_day`>><<lanSwitch '.' '。'>>
              <br><<lanSwitch 'Condition: ' '房屋状况：'>><<= _finance_property_state.condition>>/100
              <<deadwood-outing-record _finance_property.id>>
              <<if maplebirch.get('Finance').realEstate.staff.weekly(_finance_property.id) gt 0>>
                <br><<lanSwitch 'Household weekly wages: ' '住宅雇员周薪：'>><<printmoney `maplebirch.get('Finance').realEstate.staff.weekly(_finance_property.id)`>>
                <<for _journal_role range maplebirch.get('Finance').realEstate.staff.roles>>
                  <<set _journal_contract to _finance_property_state.staff?.contracts[_journal_role]>>
                  <<if _journal_contract?.employed>>
                    <<set _journal_person to $per_npc['deadwood_home_' + _finance_property.id + '_' + _journal_role]>>
                    <br><<icon `maplebirch.get('Finance').realEstate.staff.terms[_journal_role].icon`>><<= lanSwitch(maplebirch.get('Finance').realEstate.staff.terms[_journal_role].name.EN, maplebirch.get('Finance').realEstate.staff.terms[_journal_role].name.CN)>><<if _journal_person?.name_known is 1>> · <<print _journal_person.name>><</if>> · <<lanSwitch 'Renewal: ' '下次续付：'>><<deadwood-reblooms-finance-date _journal_contract.paid_until>>
                    <<if _journal_contract.paid_until lte Time.days>><span class='red'> | <<lanSwitch 'Work suspended' '工作暂停'>></span><</if>>
                  <</if>>
                <</for>>
              <</if>>
              <<if $Finance.real_estate.banquet?.property is _finance_property.id and ['plan', 'prepared', 'reception', 'dinner', 'farewell'].includes($Finance.real_estate.banquet?.stage)>>
                <br><span class='blue'><<lanSwitch 'A private dinner is being arranged here.' '你正在这里筹办私人宴会。'>></span>
              <</if>>
              <<if _finance_property_state.lease_end_day isnot null>>
                <br><span class='blue'><<lanSwitch 'Tenant leaves on day ' '租客将在第 '>>
                <<= _finance_property_state.lease_end_day>><<lanSwitch '.' ' 天退租。'>></span>
              <</if>>
              <<if _finance_mortgage?.property_id is _finance_property.id>>
                <br><<lanSwitch 'Mortgage balance: ' '房贷余额：'>><<deadwood-reblooms-finance-money _finance_mortgage.outstanding>>
                · <<lanSwitch 'Weekly interest: ' '周利率：'>><span class='gold'><<= (_finance_mortgage.weekly_rate * 100).toFixed(2)>>%</span>
                <br><<lanSwitch 'Next instalment: ' '下次应还：'>><<deadwood-reblooms-finance-money _finance_mortgage.weekly_payment>>
                · <<deadwood-reblooms-finance-date _finance_mortgage.next_payment_day>>
                <br><<lanSwitch 'Final payment: ' '贷款到期：'>><<deadwood-reblooms-finance-date _finance_mortgage.maturity_day>>
                <<if _finance_mortgage.arrears gt 0>>
                  <br><span class='red'><<lanSwitch 'Overdue: ' '逾期款：'>></span><<deadwood-reblooms-finance-money _finance_mortgage.arrears 'red'>>
                <</if>>
                <<if _finance_mortgage.stage is 'notice'>>
                  <br><span class='red'><<lanSwitch 'The bank has issued a payment notice.' '银行已发出催缴通知。'>></span>
                  <<if _finance_mortgage.bailey_pending>><<lanSwitch ' Bailey is waiting outside the financial centre.' ' 贝利正在金融中心门外等你。'>><</if>>
                <<elseif _finance_mortgage.stage is 'frozen'>>
                  <br><span class='red'><<lanSwitch 'The property is frozen. Foreclosure auction: ' '房产已冻结，强制拍卖日期：'>></span><<deadwood-reblooms-finance-date `_finance_mortgage.frozen_day + maplebirch.get('Finance').realEstate.mortgage.terms.auction_after_freeze_days`>>
                <</if>>
              <</if>>
            <</if>>
          <</deadwood-card>>
        <</if>>
      <</capture>>
    <</for>>
    <<if $Finance.real_estate.last_auction>>
      <<set _finance_auction to $Finance.real_estate.last_auction>>
      <<set _finance_auction_property to maplebirch.get('Finance').realEstate.properties.find(item => item.id === _finance_auction.property_id)>>
      <<if _finance_auction_property>>
        <<deadwood-card 'Last auction' '最近一次拍卖'>>
          <span class='gold'><<= lanSwitch(_finance_auction_property.name.EN, _finance_auction_property.name.CN)>></span><br>
          <<lanSwitch 'Proceeds returned to bank: ' '返还银行账户：'>>
          <<deadwood-reblooms-finance-money _finance_auction.surplus>>
        <</deadwood-card>>
      <</if>>
    <</if>>
    <hr>
  <</if>>
<</widget>>

<<widget 'deadwood-finance-account-statements'>>
  <<set _finance_statement_bank to $Finance.bank>>
  <<if !_finance_statement_bank.opened>><<exit>><</if>>
  <<set _finance_statement_limits to maplebirch.get('Finance').accountLimits>>
  <<deadwood-card 'Bank account' '银行账户'>>
    <div class='dr-finance-summary'>
      <span><<lanSwitch 'Bank balance' '银行余额'>></span><span><<deadwood-reblooms-finance-money _finance_statement_bank.balance>></span>
      <span><<lanSwitch 'Borrowing limit' '贷款额度'>></span><span><<deadwood-reblooms-finance-money _finance_statement_limits.loan>></span>
      <span><<lanSwitch 'Outstanding loan balance' '贷款未偿余额'>></span><span><<deadwood-reblooms-finance-money _finance_statement_bank.loan_debt `_finance_statement_bank.loan_debt > 0 ? 'red' : 'gold'`>></span>
    </div>
  <</deadwood-card>>
  <<if _finance_statement_bank.credit_card>>
    <<deadwood-card 'Credit card' '信用卡'>>
      <div class='dr-finance-summary'>
        <span><<lanSwitch 'Credit limit' '信用额度'>></span><span><<deadwood-reblooms-finance-money _finance_statement_limits.credit>></span>
        <span><<lanSwitch 'Available credit' '可用额度'>></span><span><<deadwood-reblooms-finance-money `Math.max(0, _finance_statement_limits.credit - _finance_statement_bank.credit_debt)`>></span>
        <span><<lanSwitch 'Credit balance' '信用卡欠款'>></span><span><<deadwood-reblooms-finance-money _finance_statement_bank.credit_debt `_finance_statement_bank.credit_debt > 0 ? 'red' : 'gold'`>></span>
      </div>
      <<if _finance_statement_bank.credit_debt gt 0>>
        <<set _finance_statement_minimum to maplebirch.get('Finance').creditMinimumPayment>>
        <ul class='journal'>
          <li><<lanSwitch 'Next minimum payment: ' '下次最低还款：'>><<deadwood-reblooms-finance-money _finance_statement_minimum>> · <<deadwood-reblooms-finance-date _finance_statement_bank.credit_due_day>></li>
          <<if _finance_statement_bank.credit_missed_payments gt 0>>
            <li class='red'><<lanSwitch 'The card is suspended until the balance is repaid in full.' '信用卡已停用，须先还清欠款。'>></li>
          <<elseif _finance_statement_bank.balance lt _finance_statement_minimum>>
            <li class='red'><<lanSwitch 'Bank funds are insufficient for the next payment.' '银行余额不足以支付下次还款。'>></li>
          <</if>>
        </ul>
      <</if>>
    <</deadwood-card>>
  <</if>>
  <<if _finance_statement_bank.loan_debt gt 0>>
    <<deadwood-card 'Personal loan' '个人贷款'>>
      <<set $_loanRate to _finance_statement_bank.loan_rate * (_finance_statement_bank.loan_next_payment_day gt _finance_statement_bank.loan_due_day ? maplebirch.get('Finance').terms.loanOverdueMultiplier : 1)>>
      <<set $_loanDue to _finance_statement_bank.loan_debt + Math.ceil(_finance_statement_bank.loan_debt * $_loanRate * Math.max(0, _finance_statement_bank.loan_next_payment_day - _finance_statement_bank.loan_interest_last_day) / 7)>>
      <<if _finance_statement_bank.loan_next_payment_day lt _finance_statement_bank.loan_due_day>><<set $_loanDue to Math.min($_loanDue, _finance_statement_bank.loan_payment)>><</if>>
      <div class='dr-finance-summary'>
        <span><<lanSwitch 'Loan term' '贷款期限'>></span><span><<= _finance_statement_bank.loan_term>> <<lanSwitch 'days' '天'>></span>
        <span><<lanSwitch 'Weekly interest' '周利率'>></span><span class='gold'><<= (_finance_statement_bank.loan_rate * (Time.days gt _finance_statement_bank.loan_due_day ? 200 : 100)).toFixed(2)>>%</span>
        <span><<lanSwitch 'Weekly payment' '每周应还'>></span><span><<deadwood-reblooms-finance-money _finance_statement_bank.loan_payment>></span>
        <span><<lanSwitch 'Next payment' '下次还款'>></span><span><<deadwood-reblooms-finance-money $_loanDue>> · <<deadwood-reblooms-finance-date _finance_statement_bank.loan_next_payment_day>></span>
        <span><<lanSwitch 'Final payment' '贷款到期'>></span><span><<deadwood-reblooms-finance-date _finance_statement_bank.loan_due_day>></span>
        <span><<lanSwitch 'Missed payments' '未足额还款次数'>></span><span @class="_finance_statement_bank.loan_missed_payments > 0 ? 'red' : 'teal'"><<= _finance_statement_bank.loan_missed_payments>></span>
      </div>
      <<if _finance_statement_bank.loan_missed_payments gt 0 or _finance_statement_bank.loan_due_day lt Time.days>>
        <span class='red'><<lanSwitch 'Overdue. Visit the bank counter to repay.' '已逾期，请到银行柜台还款。'>></span>
      <<elseif _finance_statement_bank.balance lt $_loanDue>>
        <span class='red'><<lanSwitch 'Bank funds are insufficient for the next payment.' '银行余额不足以支付下次还款。'>></span>
      <</if>>
    <</deadwood-card>>
  <</if>>
<</widget>>

<<widget 'deadwood-finance-holdings'>>
  <<deadwood-card 'Holdings' '持仓'>>
    <<lanSwitch 'Securities funds: ' '证券资金：'>><<deadwood-reblooms-finance-money $Finance.brokerage.cash>><br>
    <<set _finance_sellable to maplebirch.get('Finance').sellableShares>>
    <div class='dr-finance-scroll'>
      <table class='dr-finance-quotes' @aria-label='lanSwitch("Holdings", "持仓")'>
        <tr>
          <th scope='col'><<lanSwitch 'Symbol' '代码'>></th>
          <th scope='col'><<lanSwitch 'Held / sellable' '股数／可卖'>></th>
          <th scope='col'><<lanSwitch 'Market value' '市值'>></th>
          <th scope='col'><<lanSwitch 'Cost / profit' '成本／盈亏'>></th>
        </tr>
        <<set _finance_has_holdings to false>>
        <<for _finance_security range maplebirch.get("Finance").securities>>
          <<set _finance_board_symbol to _finance_security.symbol>>
          <<set _finance_owned to $Finance.brokerage.holdings[_finance_board_symbol]>>
          <<if _finance_owned gt 0>>
            <<set _finance_has_holdings to true>>
            <<set _finance_holding_value to _finance_owned * $Finance.market.prices[_finance_board_symbol]>>
            <tr>
              <td><<= _finance_board_symbol>></td>
              <td><<= _finance_owned>> / <<= _finance_sellable[_finance_board_symbol]>></td>
              <td><<deadwood-reblooms-finance-money _finance_holding_value>></td>
              <td><<deadwood-reblooms-finance-money $Finance.brokerage.costs[_finance_board_symbol]>> / <<deadwood-reblooms-finance-money `_finance_holding_value - $Finance.brokerage.costs[_finance_board_symbol]` `_finance_holding_value >= $Finance.brokerage.costs[_finance_board_symbol] ? 'green' : 'red'`>></td>
            </tr>
          <</if>>
        <</for>>
        <<if !_finance_has_holdings>>
          <tr><td colspan='4' class='blue'><<lanSwitch 'No securities held.' '暂无持仓。'>></td></tr>
        <</if>>
      </table>
    </div>
    <<lanSwitch 'Realised profit / dividends: ' '已实现盈亏／分红：'>><<deadwood-reblooms-finance-money $Finance.brokerage.realised `$Finance.brokerage.realised >= 0 ? 'green' : 'red'`>> / <<deadwood-reblooms-finance-money $Finance.brokerage.dividends>>
  <</deadwood-card>>
<</widget>>

<<widget 'deadwood-finance-closing-records'>>
  <<deadwood-card 'Closing records' '平仓记录'>>
    <<set _margin to maplebirch.get('Finance').margin>>
    <<if _margin.history.length>>
      <div class='dr-finance-scroll'>
        <table class='dr-finance-quotes'>
          <thead><tr>
            <th scope='col'><<lanSwitch 'Symbol' '代码'>></th>
            <th scope='col'><<lanSwitch 'Reason' '平仓原因'>></th>
            <th scope='col'><<lanSwitch 'Profit / loss' '盈亏'>></th>
          </tr></thead>
          <tbody>
            <<for _trade range _margin.history.slice(-10).reverse()>>
              <tr>
                <td><<= _trade.symbol>><<if _trade.side>><br><span class='blue'><<lanSwitch `_trade.side === 1 ? 'Long' : 'Short'` `_trade.side === 1 ? '多头' : '空头'`>></span><</if>></td>
                <td><<lanSwitch `_trade.reason === 'liquidated' ? 'Forced liquidation' : _trade.reason === 'expired' ? 'Expired' : _trade.reason === 'stopped' ? 'Stop-loss' : _trade.reason === 'target' ? 'Take-profit' : 'Closed'` `_trade.reason === 'liquidated' ? '强制平仓' : _trade.reason === 'expired' ? '到期交割' : _trade.reason === 'stopped' ? '止损' : _trade.reason === 'target' ? '止盈' : '主动平仓'`>></td>
                <td><<deadwood-reblooms-finance-money _trade.profit `_trade.profit >= 0 ? 'green' : 'red'`>></td>
              </tr>
            <</for>>
          </tbody>
        </table>
      </div>
    <<else>>
      <span class='blue'><<lanSwitch 'No closing records yet.' '暂无平仓记录。'>></span>
    <</if>>
  <</deadwood-card>>
<</widget>>

<<widget 'deadwood-finance-property-accounts'>>
  <<set _estate to maplebirch.get('Finance').realEstate>>
  <<set _account_rent to 0, _account_cost to 0>>
  <<deadwood-card 'Property accounts' '房产总账'>>
    <<language>>
      <<option 'EN'>>
        Expected weekly figures; vacant rooms and unpaid rent can leave you with less.
      <<option 'CN'>>
        预计每周收支。空置或欠租时，实际到账可能更少。
    <</language>>
    <div class='dr-finance-summary'>
      <<for _account_property range _estate.properties>>
        <<if _estate.owns(_account_property.id)>>
          <<set _account_management to _estate.managementFor(_account_property.id)>>
          <<set _rent to _account_management.rented and Time.days gte _account_management.vacancy_until ? _estate.weeklyRent(_account_property.id) : 0>>
          <<set _upkeep to _estate.maintenanceCost(_account_property.id)>>
          <<set _fee to _account_management.managed ? Math.max(_estate.rentalTerms.managementMinimumPennies, Math.ceil(_estate.weeklyRent(_account_property.id) * _estate.rentalTerms.managementFeeRate)) : 0>>
          <<set _wages to _estate.staff.weekly(_account_property.id)>>
          <<set _account_rent += _rent, _account_cost += _upkeep + _fee + _wages>>
          <span><<= lanSwitch(_account_property.name.EN, _account_property.name.CN)>></span>
          <span><<deadwood-reblooms-finance-money _rent 'green'>> / <<deadwood-reblooms-finance-money `_upkeep + _fee + _wages` 'red'>></span>
        <</if>>
      <</for>>
      <<if $Finance.real_estate.mortgage>>
        <<set _account_cost += $Finance.real_estate.mortgage.weekly_payment>>
        <span><<lanSwitch 'Mortgage instalment' '房贷周供'>></span><span><<printmoney $Finance.real_estate.mortgage.weekly_payment>></span>
      <</if>>
      <span><<lanSwitch 'Expected weekly net' '预计每周净收支'>></span><span><<deadwood-reblooms-finance-money `_account_rent - _account_cost` `_account_rent >= _account_cost ? 'green' : 'red'`>></span>
    </div>
  <</deadwood-card>>
<</widget>>

<!-- 经营账目与待办 -->

<<widget 'deadwood-finance-operations'>>
  <<set _operations_finance to maplebirch.get('Finance')>>
  <<set _operations_factories to _operations_finance.industry.owned>>
  <<set _operations_company to _operations_finance.company>>
  <<if !_operations_company.state.office and !_operations_factories.length and !_operations_company.state.contract>><<exit>><</if>>
  <<set _operations_staff_debt to _operations_company.staff.arrears>>
  <<set _operations_arrears to _operations_company.state.rent_arrears + _operations_staff_debt + _operations_factories.reduce((sum, factory) => sum + factory.wage_arrears + factory.overhead_arrears, 0)>>
  <<set _operations_receivables to _operations_factories.reduce((sum, factory) => sum + factory.invoices.reduce((total, invoice) => total + Math.max(0, invoice.order.total), 0) + factory.laboratory.invoices.reduce((total, invoice) => total + invoice.total, 0), 0)>>
  <<if ['disputed', 'waiting'].includes(_operations_company.state.contract?.stage)>>
    <<set _operations_receivables += _operations_company.state.contract.due>>
  <</if>>
  <<deadwood-card 'Business accounts' '经营总账'>>
    <<set $_operationsRefunds to _operations_factories.reduce((sum, factory) => sum + factory.invoices.reduce((total, invoice) => total + Math.max(0, -invoice.order.total), 0), 0)>>
    <div class='dr-finance-summary'>
      <span><<lanSwitch 'Factory working funds' '工厂周转金'>></span><span><<deadwood-reblooms-finance-money `_operations_factories.reduce((sum, factory) => sum + factory.cash, 0)`>></span>
      <span><<lanSwitch 'Outstanding customer payments' '待收客户货款'>></span><span><<deadwood-reblooms-finance-money _operations_receivables>></span>
      <<if $_operationsRefunds gt 0>>
        <span><<lanSwitch 'Advances to return' '应退预付款'>></span><span><<deadwood-reblooms-finance-money $_operationsRefunds 'red'>></span>
      <</if>>
      <span><<lanSwitch 'Unpaid business wages and bills' '经营欠薪与未付费用'>></span><span><<deadwood-reblooms-finance-money _operations_arrears `_operations_arrears > 0 ? 'red' : 'gold'`>></span>
      <<if _operations_factories.length>>
        <span><<lanSwitch "Seven days' factory payroll and bills" '工厂七天工资与日常费用'>></span><span><<deadwood-reblooms-finance-money `_operations_factories.reduce((sum, factory) => sum + _operations_finance.industry.dailyCosts[factory.site] * 7, 0)`>></span>
      <</if>>
      <<if _operations_company.state.office>>
        <span><<lanSwitch 'Weekly office rent and employed staff' '办公室每周租金与在职职员工资'>></span><span><<deadwood-reblooms-finance-money `_operations_company.terms.weeklyRent + _operations_company.staff.roles.reduce((sum, role) => sum + (_operations_company.staff.state[role].employed ? _operations_company.terms.staff[role].weeklyWage : 0), 0)`>></span>
      <</if>>
    </div>
  <</deadwood-card>>
<</widget>>

<!-- 本地历史展览 -->

<<widget 'deadwood-reblooms-history-project-journal'>>
  <<if $LifeSimulation.historyProject.status is 'ongoing'>>
    <hr>
    <div class='bold'><<lanSwitch 'Local History Exhibition' '本地历史展览'>></div>
    <<set _historyDays to $LifeSimulation.historyProject.deadline - Time.days>>
    <<if $LifeSimulation.historyProject.draft gt 0>>
      <<language>>
        <<option 'EN'>>
          <span class="blue"><i>The exhibition is ready. Present it at the museum.</i></span>
        <<option 'CN'>>
          <span class="blue"><i>展览已经准备完成。到博物馆开展。</i></span>
      <</language>>
    <<elseif _historyDays lt 0>>
      <<language>>
        <<option 'EN'>>
          The preparation deadline has <span class="pink">passed</span>. Take your project to the museum.
        <<option 'CN'>>
          展览准备期限<span class="pink">已过</span>。到博物馆提交项目。
      <</language>>
    <<elseif _historyDays is 0>>
      <<language>>
        <<option 'EN'>>
          Your project is due <span class="pink">today</span>. Take it to the museum.
        <<option 'CN'>>
          展览准备期限在<span class="pink">今天</span>截止。到博物馆提交项目。
      <</language>>
    <<else>>
      <<language>>
        <<option 'EN'>>
          Your project is due in <span class="gold"><<print _historyDays>></span>
        <<if _historyDays is 1>>
          day
        <<else>>
          days
        <</if>>
        .
        <<option 'CN'>>
          距离展览准备截止还有 <span class="gold"><<print _historyDays>></span> 天。
      <</language>>
    <</if>>
    <br>
    <<if $LifeSimulation.historyProject.draft is 0 and _historyDays gt 0>>
      <<if $LifeSimulation.historyProject.archive is 0>>
        <<lanSwitch 'Read the town records at the school library next.' '下一步可以到学校图书馆查阅小镇史料。'>><br>
      <<elseif $LifeSimulation.historyProject.museum is 0>>
        <<lanSwitch 'Visit the museum to examine and compare the painting.' '下一步到博物馆，检查、比对画作。'>><br>
      <<else>>
        <<lanSwitch 'You have enough material for a draft. Write at your desk at home; the lake survey is optional.' '已有足够材料动笔。可以回家在书桌前准备展览稿，湖泊实地调查可自行选择。'>><br>
      <</if>>
    <</if>>
    <<if maplebirch.get('LifeSimulation').school.historyAssistantAvailable>>
      <<lanSwitch 'Robin is helping you organise the project.' '罗宾正在协助你整理项目。'>><br>
    <</if>>
    <<lanSwitch 'Historical records' '历史记录'>><<lanSwitch ': ' '：'>>
      <<= $LifeSimulation.historyProject.archive > 0 ? lanSwitch('complete', '已完成') : lanSwitch('incomplete', '未完成') >><br>
    <<lanSwitch 'Painting examination' '画作考证'>><<lanSwitch ': ' '：'>>
      <<= $LifeSimulation.historyProject.museum > 0 ? lanSwitch('complete', '已完成') : lanSwitch('incomplete', '未完成') >><br>
    <<lanSwitch 'Optional field trip' '可选实地调查'>><<lanSwitch ': ' '：'>>
      <<= $LifeSimulation.historyProject.ruin > 0 ? lanSwitch('complete', '已完成') : lanSwitch('not attempted', '尚未进行') >><br>
    <<if $LifeSimulation.historyProject.ruin gt 0>>
      <<antiqueicon 'golden-priestess'>>
      <<lanSwitch 'Forest lake field notes recorded' '已记录森林湖实地笔记'>><br>
    <<elseif $LifeSimulation.historyProject.archive gt 0 and $LifeSimulation.historyProject.museum gt 0 and Time.days lt $LifeSimulation.historyProject.deadline>>
      <span class='blue'><i>
        <<lanSwitch 'Survey the ruin from the forest lake shore between 06:00 and 18:00, when the lake is not frozen. This field trip is optional. You can also prepare your draft at home.' '可在湖面未结冰时，于 06:00 至 18:00 从森林湖岸勘察废墟。实地调查是可选内容，也可以直接在家准备展览稿。'>>
      </i></span><br>
    <</if>>
    <<lanSwitch 'Exhibition draft' '展览草稿'>><<lanSwitch ': ' '：'>>
      <<= $LifeSimulation.historyProject.draft > 0 ? lanSwitch('complete', '已完成') : lanSwitch('incomplete', '未完成') >>
    <hr>
  <</if>>
<</widget>>

<!-- 泳池派对 -->

<<widget 'deadwood-reblooms-pool-party-journal'>>
  <!-- 用模块实例而不是原始状态对象，dualPromise 这类判定只挂在实例上。 -->
  <<set _pool to maplebirch.get('LifeSimulation').pool_party>>
  <<if _pool.companions.length gt 0>>
    <div class='bold'><<lanSwitch 'Pool party' '泳池派对'>></div>
    <ul class='journal'>
      <li>
        <<lanSwitch 'Coming with you: ' '与你同行：'>>
        <span class='green'><<for _index, _name range _pool.companions>>
        <<if _index gt 0>>
          <<lanSwitch ', ' '、'>>
        <</if>>
        <<print maplebirch.auto(_name)>><</for>></span>
      </li>
      <<if _pool.companions.includes('Kylar')>>
        <li>
          <<lanSwitch "Kylar's jealousy: " '凯拉尔的嫉妒：'>>
          <span class='red'><<print _pool.kylarRage>>/<<print _pool.kylarRageLimit>></span>
          <<lanSwitch '. The night ends at the limit.' '。到达上限今晚就结束。'>>
        </li>
      <</if>>
      <<if _pool.has('Robin') and _pool.has('Sydney') and _pool.dualPromise>>
        <li><<lanSwitch 'Robin and Sydney both share a promise with you.' '罗宾和悉尼都与你立下了承诺。'>></li>
      <</if>>
    </ul>
    <hr>
  <</if>>
<</widget>>

<!-- 校园事务 -->

<<widget 'deadwood-reblooms-life-simulation-school-journal'>>
  <<set _schoolJournal to $LifeSimulation?.school>>
  <<if !_schoolJournal or !(
    !_schoolJournal.attendanceExempt and _schoolJournal.leightonApprovalDay gte 0
    or _schoolJournal.dress.proposal or _schoolJournal.dress.trialUntil gt 0
    or _schoolJournal.role is 'president' and _schoolJournal.dress.cooldownUntil gt Time.days
  )>><<exit>><</if>>
  <h1 class='header gold bold'><<lanSwitch 'School affairs' '校园事务'>></h1>
  <ul class='journal'>
    <<if !_schoolJournal.attendanceExempt and _schoolJournal.leightonApprovalDay gte 0>>
      <li>
        <<if _schoolJournal.baileySigned>>
          <<lanSwitch 'Bailey has signed the exemption form. Return it to Leighton in the head\'s office to activate your exemption.' '贝利已在免听申请上签字。把表格交回校长办公室，免听凭证才会生效。'>>
        <<else>>
          <<lanSwitch 'Leighton has approved the exemption application. ' '礼顿已通过免听申请的学校审核。'>>
          <<if $RobinExpansion?.bailey_defeated>>
            <<lanSwitch 'Find Bailey at the Barb Street flats for the guardian\'s signature.' '去倒钩街公寓找贝利签监护人许可。'>>
          <<else>>
            <<lanSwitch 'After three consecutive rent payments, ask Bailey to sign in the office between 07:00 and 09:00.' '连续按时交租三周后，在07:00–09:00到办公室找贝利签字。'>>
          <</if>>
        <</if>>
      </li>
    <</if>>
    <<if _schoolJournal.dress.proposal>>
      <li><<lanSwitch 'Discuss your proposal for ' '与礼顿商议'>><span class='blue'><<= maplebirch.t('deadwood-reblooms:LifeSimulation:school:policy:' + _schoolJournal.dress.proposal)>></span><<lanSwitch ' with Leighton.' '提案。'>></li>
    <</if>>
    <<if _schoolJournal.dress.trialUntil gt Time.days>>
      <li><<lanSwitch 'Days left in the dress-policy trial: ' '着装校规剩余试行天数：'>><span class='gold'><<= _schoolJournal.dress.trialUntil - Time.days>></span></li>
    <<elseif maplebirch.get('LifeSimulation').school.canReviewPolicy>>
      <li><<lanSwitch 'The dress-policy trial has ended. Ask Leighton to review the rule.' '着装校规试行期已结束，去找礼顿复核校规。'>></li>
    <</if>>
    <<if _schoolJournal.role is 'president' and _schoolJournal.dress.cooldownUntil gt Time.days>>
      <li><<lanSwitch 'You can propose another dress policy in ' '还要等 '>><span class='gold'><<= _schoolJournal.dress.cooldownUntil - Time.days>></span><<lanSwitch ' days.' '天才能再次提出着装校规。'>></li>
    <</if>>
  </ul>
  <hr>
<</widget>>

<!-- 农场雇工 -->

<<widget 'deadwood-orchard-staff-journal'>>
  <<if !maplebirch.get('Orchard')>>
    <<exit>>
  <</if>>
  <<set _crew to maplebirch.get('Orchard').staff>>
  <<if _crew.npc or _crew.state.destination isnot null or $Orchard.worker.hired or $Orchard.worker.quit_day gte 0>>
    <h1 class='header gold bold'>
      <<language>>
        <<option 'EN'>>
          Farm workers
        <<option 'CN'>>
          农场雇工
      <</language>>
    </h1>
    <ul class='journal'>
      <<if $Orchard.worker.hired>>
        <li><<lanSwitch 'Orchard worker paid until: ' '果园雇工薪资已付至：'>><span class='blue'><<= getFormattedDate(new DateTime($Orchard.worker.paid_until))>></span><<if $Orchard.worker.paid_until lte Time.date.timeStamp>> · <span class='red'><<lanSwitch 'Work is suspended until wages are renewed.' '续薪后才能恢复工作。'>></span><</if>></li>
      <</if>>
      <<set _orchardJournalReport to maplebirch.get('Orchard').workerReport>>
      <<if _orchardJournalReport?.interrupted>>
        <li class='blue'><<lanSwitch 'The last orchard shift was interrupted by trouble at the farm. Wages and contract renewal still apply; watering, harvesting and deliveries were paused.' '上次果园班次因农场遇袭中断。工资与续薪照常处理，浇水、收获与送货暂停。'>></li>
      <</if>>
      <<if _crew.npc>>
        <li><<deadwood-orchard-staff-report>></li>
      <</if>>
      <<if _crew.employed and _crew.state.status isnot 'missing'>>
        <li>
          <<lanSwitch 'Trapper paid until: ' '捕捉工薪资已付至：'>>
          <span class='gold'><<deadwood-journal-date _crew.state.paid_until>></span>
        </li>
      <</if>>
      <<if _crew.state.destination isnot null>>
        <li>
          <<language>>
            <<option 'EN'>>
              Farm-to-factory deliveries are authorised. Bottles delivered: <span class='teal'><<= _crew.state.delivered>></span>. Your carried bottles stay with you.
            <<option 'CN'>>
              已委托把农场原液送往工厂。累计送出<span class='teal'><<= _crew.state.delivered>></span>瓶。随身携带的瓶子仍由你保留。
          <</language>>
          <<if maplebirch.get('Orchard').carrier?.laboratory_report is 'unpaid'>>
            <span class='red'>
              <<language>>
                <<option 'EN'>>
                  The receiving factory lacks delivery funds above its reserve.
                <<option 'CN'>>
                  收货工厂的储备金以外，没有足够的运费。
              <</language>>
            </span>
          <</if>>
        </li>
      <</if>>
      <<if $Orchard.worker.quit_day gte 0>>
        <li class='red'>
          <<language>>
            <<option 'EN'>>
              <<print $Orchard.worker.quit_name>> left the orchard job after a week without renewed wages.
            <<option 'CN'>>
              果园一周没有续薪，<<print $Orchard.worker.quit_name>>已经辞职。
          <</language>>
        </li>
      <</if>>
    </ul>
    <hr>
  <</if>>
<</widget>>

<!-- 罗宾摊位、开店筹备与家教 -->

<<widget 'deadwood-robin-journal'>>
  <<if C.npc.Robin.init is 1 and $RobinExpansion.topics.lemonade gt $RobinExpansion.lemonade and $RobinExpansion.lemonade lt 2>>
    <li>
      <<if $RobinExpansion.asylum.status is 'admitted' and $RobinExpansion.asylum.met>>
        <<lanSwitch 'The lemonade stall can be improved. Wait until Robin leaves the asylum before discussing it.' '柠檬水摊还有改造的余地。等罗宾离开精神病院后，再谈改造。'>>
      <<elseif $robinmissing or $RobinExpansion.asylum.status is 'admitted'>>
        <<lanSwitch 'The lemonade stall can be improved. Wait until Robin returns before discussing it.' '柠檬水摊还有改造的余地。等罗宾回来后，再谈改造。'>>
      <<elseif $robin.timer.hurt isnot 0>>
        <<lanSwitch 'The lemonade stall can be improved. Wait until Robin recovers before discussing it.' '柠檬水摊还有改造的余地。等罗宾伤势恢复后，再谈改造。'>>
      <<else>>
        <<lanSwitch 'The lemonade stall can be improved. Return to Robin\'s room to discuss it with Robin.' '柠檬水摊还有改造的余地。回罗宾的房间，和罗宾谈谈改造。'>>
      <</if>>
    </li>
  <</if>>
  <<if C.npc.Robin.init is 1 and $RobinExpansion.topics.chocolate gt $RobinExpansion.chocolate and $RobinExpansion.chocolate lt 2>>
    <li>
      <<if $RobinExpansion.asylum.status is 'admitted' and $RobinExpansion.asylum.met>>
        <<lanSwitch 'The hot chocolate stall can be improved. Wait until Robin leaves the asylum before discussing it.' '热巧克力摊还有改造的余地。等罗宾离开精神病院后，再谈改造。'>>
      <<elseif $robinmissing or $RobinExpansion.asylum.status is 'admitted'>>
        <<lanSwitch 'The hot chocolate stall can be improved. Wait until Robin returns before discussing it.' '热巧克力摊还有改造的余地。等罗宾回来后，再谈改造。'>>
      <<elseif $robin.timer.hurt isnot 0>>
        <<lanSwitch 'The hot chocolate stall can be improved. Wait until Robin recovers before discussing it.' '热巧克力摊还有改造的余地。等罗宾伤势恢复后，再谈改造。'>>
      <<else>>
        <<lanSwitch 'The hot chocolate stall can be improved. Return to Robin\'s room to discuss it with Robin.' '热巧克力摊还有改造的余地。回罗宾的房间，和罗宾谈谈改造。'>>
      <</if>>
    </li>
  <</if>>
  <<if $RobinExpansion.topics.tutor and !$RobinExpansion.tutor>>
    <li><<lanSwitch 'A family on Danube Street is looking for a tutor. You can discuss it with Robin in Robin\'s room.' '多瑙河街的一户人家正在找家教。可以回罗宾的房间谈谈。'>></li>
  <</if>>
  <<if $RobinExpansion.tutor and ($RobinExpansion.asylum.status is 'admitted' or $robinmissing or $robin.timer.hurt gt 0)>>
    <li><<lanSwitch 'Robin\'s tutoring lessons are paused while Robin is away.' '罗宾不在时，家教课程暂时停了。'>></li>
  <<elseif $RobinExpansion.tutor and !Time.schoolTerm>>
    <li><<lanSwitch 'Robin\'s tutoring lessons are paused for the school holidays.' '学校放假期间，罗宾的家教课程暂时停了。'>></li>
  <<elseif $RobinExpansion.tutor and $RobinExpansion.tutor_lessons is 0>>
    <li><<lanSwitch 'Robin has arranged a trial tutoring lesson after school on Danube Street. Robin can teach without you, or you can join the lesson.' '罗宾约好多瑙河街的放学后试课。罗宾可以独自授课，你也可以过去帮忙。'>></li>
  <<elseif $RobinExpansion.tutor and $RobinExpansion.tutor_lessons gt 0>>
    <li><<language>>
      <<option 'EN'>>
        Robin tutors on Danube Street on school Tuesdays and Thursdays.
        <<if $RobinExpansion.tutor_lessons gte 6>>There is also a Friday lesson.<</if>>
      <<option 'CN'>>
        罗宾在上学期间的周二、周四，去多瑙河街做家教。
        <<if $RobinExpansion.tutor_lessons gte 6>>周五也安排了一堂课。<</if>>
    <</language>>
      <<if $RobinExpansion.tutor_lessons gte 6>>
        <<lanSwitch 'The regular lessons earn £60 each week.' '固定课程每周收入 £60。'>>
      <<else>>
        <<lanSwitch 'The regular lessons earn £40 each week.' '固定课程每周收入 £40。'>>
      <</if>>
    </li>
  <</if>>
  <<if $RobinExpansion.topics.shop and $RobinExpansion.lemonade gte 2 and $RobinExpansion.chocolate gte 2 and $RobinExpansion.shop_stage is 'none'>>
    <li><<lanSwitch 'Both stalls are fully equipped. Robin may be ready to discuss a shop on Cliff Street.' '两处摊位都已改造妥当。可以和罗宾谈谈在峭壁街开店。'>></li>
  <</if>>
  <<if !$RobinExpansion.shop and $RobinExpansion.shop_stage isnot 'none' and !maplebirch.get('Robin').shop.meeting>>
    <li><<lanSwitch 'Before going together, arrange a same-day meeting in Robin\'s room on a day without school, while Robin is home and free. Once Robin feels ready, some paperwork can also be handled alone.' '一起办理开店的事之前，先在不上学的一天，趁罗宾在家有空时去房间约好当天见面。等罗宾准备好，也能独自办理部分手续。'>></li>
  <</if>>
  <<if $RobinExpansion.shop_stage is 'planning'>>
    <li><<lanSwitch 'Robin has the stall records ready. Go to the Cliff Street town hall between 09:00 and 17:00, then wait in line to apply at the counter.' '罗宾已备好摊位账本。09:00–17:00到峭壁街的市政厅，排队后在柜台申请饮品店许可。'>></li>
    <<if C.npc.Robin.dom lt 60 or C.npc.Robin.trauma gte 50>>
      <li><<lanSwitch 'Robin would rather have you beside them at the town hall counter.' '罗宾希望你陪着去市政厅柜台。'>></li>
    <</if>>
  <<elseif $RobinExpansion.shop_stage is 'applied'>>
    <li><<lanSwitch 'The shop application is accepted. A vacant shop on Cliff Street is waiting for a deposit.' '开店申请已经受理。峭壁街的空铺还等着交押金。'>></li>
    <<if C.npc.Robin.dom lt 70 or C.npc.Robin.trauma gte 50>>
      <li><<lanSwitch 'Robin wants your company when signing for the vacant shop.' '签下空铺前，罗宾想让你一起去看看。'>></li>
    <</if>>
  <<elseif $RobinExpansion.shop_stage is 'site'>>
    <<if Time.days lte $RobinExpansion.shop_application_day>>
      <li><<lanSwitch 'The inspection can be arranged from tomorrow. Meet Robin at the vacant shop on Cliff Street.' '明天起才能安排检查。和罗宾约好，到峭壁街的空铺碰面。'>></li>
    <<else>>
      <li><<lanSwitch 'Meet Robin at the vacant shop on Cliff Street to pay for the fittings and inspection.' '和罗宾约好，到峭壁街的空铺支付设备与检查费用。'>></li>
    <</if>>
  <<elseif $RobinExpansion.shop_stage is 'inspected'>>
    <li>
    <<if Time.days gt $RobinExpansion.shop_inspection_day>>
      <<lanSwitch 'The business permit is ready. Meet Robin at the town hall between 09:00 and 17:00, then wait in line to collect it at the counter.' '经营许可已办好。与罗宾约好后，09:00–17:00到市政厅，排队后在柜台领取。'>>
    <<else>>
      <<lanSwitch 'The town hall will issue the business permit tomorrow.' '市政厅明天才会发放经营许可。'>>
    <</if>>
    </li>
  <<elseif $RobinExpansion.shop_stage is 'permitted' and !$RobinExpansion.shop>>
    <li><<lanSwitch 'The permit is ready. Discuss opening with Robin at the Cliff Street shop; the equipment and first stock cost £4,000.' '经营许可已到手。到峭壁街的店铺和罗宾商量开业，还需准备£4,000添置设备和首批原料。'>></li>
  <</if>>
  <<if $RobinExpansion.pc_loan gt 0 and !$RobinExpansion.shop>>
    <li><<lanSwitch 'Robin owes you' '罗宾还欠你'>> <span class='gold'>£<<print $RobinExpansion.pc_loan>></span><<lanSwitch '. The amount is recorded in the shop ledger.' '。这笔借款已经记在店铺账本里。'>></li>
    <li><<lanSwitch 'Check the ledger with Robin to discuss repayment.' '和罗宾核对账本，商量还款。'>></li>
  <</if>>
<</widget>>

<!-- 街头往来只记已结识人物的合作态度，交谈与行动仍到现场进行。 -->

<<widget 'deadwood-street-contact-status'>>
  <<set _streetHeist to maplebirch.get('StreetLife')?.heist>>
  <<if _streetHeist>>
    <<set _streetContacts to _streetHeist.contacts>>
    <ul class='journal'>
      <<if C.npc.Landry?.init is 1>>
        <li><<= maplebirch.auto('Landry')>>：
          <<if _streetHeist.state.betrayed>><span class='red'><<lanSwitch 'knows you betrayed this venture, and withholds further arrangements.' '已经知道你出卖了这次合作，不肯再透露安排。'>></span>
          <<elseif _streetContacts.landryTier is 2>><span class='green'><<lanSwitch 'has seen you finish worthwhile work.' '已经见识过你办事的本事。'>></span>
          <<elseif _streetContacts.landryTier is 1>><span class='teal'><<lanSwitch 'sees a reason to keep doing business with you.' '觉得与你继续做生意有利可图。'>></span>
          <<else>><<lanSwitch 'is still weighing what you can bring to the table.' '仍在掂量你能带来什么。'>><</if>>
        </li>
      <</if>>
      <<if C.npc.Wren?.init is 1>>
        <li><<= maplebirch.auto('Wren')>>：
          <<if _streetHeist.state.betrayed>><span class='red'><<lanSwitch 'knows you betrayed this venture, and no longer trusts your part in it.' '已经知道你出卖了这次合作，不再相信你的承诺。'>></span>
          <<elseif _streetContacts.wrenTier is 2>><span class='green'><<lanSwitch 'is willing to hear out another joint venture.' '愿意认真听听下一桩合作。'>></span>
          <<elseif _streetContacts.wrenTier is 1>><span class='teal'><<lanSwitch 'finds the prospect of working with you interesting.' '觉得与你搭伙有些意思。'>></span>
          <<else>><<lanSwitch 'keeps a little distance when business comes up.' '谈到生意时，仍与你保持着些距离。'>><</if>>
        </li>
      <</if>>
      <<if $mickeyPub gte 2>>
        <li><<lanSwitch 'Mickey' '米奇'>>：
          <<if ['hiding', 'hidingKnown'].includes($pubfame?.status)>><span class='orange'><<lanSwitch 'is lying low and cannot meet you at the pub.' '正在避风头，暂时无法在酒馆见你。'>></span>
          <<elseif _streetHeist.state.betrayed>><<lanSwitch 'will not review another bank arrangement with you.' '不肯再替你复核银行的安排。'>>
          <<else>><<lanSwitch 'can check information and agreed plans behind the scenes.' '可以在幕后核对消息与谈妥的安排。'>><</if>>
        </li>
      <</if>>
      <<if C.npc.Grant?.init is 1>>
        <li><<= maplebirch.auto('Grant')>>：
          <<if _streetHeist.state.settled and _streetHeist.state.policePlan and _streetHeist.state.entered and !['reported', 'sting'].includes(_streetHeist.state.outcome)>><span class='red'><<lanSwitch 'knows you did not honour the agreed handover.' '知道你没有按约完成交接。'>></span>
          <<elseif _streetContacts.grantTier is 2>><span class='green'><<lanSwitch 'takes your reports seriously, and checks them.' '认真对待你的线索，也会核实。'>></span>
          <<elseif _streetContacts.grantTier is 1>><span class='teal'><<lanSwitch 'recognises your ability to follow a lead.' '认可你追查线索的本事。'>></span>
          <<else>><<lanSwitch 'expects you to give an accurate account.' '等着你把事情如实说清。'>><</if>>
        </li>
      <</if>>
    </ul>
  <</if>>
<</widget>>

<!-- 街头委托：只读当前货物、期限和回执，交接与报酬在委托页面结算。 -->

<<widget 'deadwood-street-job-journal'>>
  <<if $StreetLife.jobs.active or $StreetLife.bailey.finished and !$StreetLife.bailey.discussed
      or $StreetLife.heist.appointment and $StreetLife.heist.stage is 'idle'
      or !['idle', 'closed'].includes($StreetLife.heist.stage)>>
    <<deadwood-card 'Street work' '街头委托'>>
      <<deadwood-street-job-status>>
      <<deadwood-street-bailey-journal>>
      <<if $StreetLife.heist.appointment and $StreetLife.heist.stage is 'idle'>>
        <ul class='journal'><li><<lanSwitch 'Landry has arranged a meeting about the bank job. Meet the crew at the smugglers\' pub, 09:00–18:00.' '兰德里约好了商议银行豪劫的会面。去走私者酒馆与同伙碰面，09:00–18:00。'>></li></ul>
      <</if>>
      <<if $StreetLife.heist.stage isnot 'closed'>><<deadwood-street-heist-status>><</if>>
    <</deadwood-card>>
    <hr>
  <</if>>

  <<if maplebirch.get('StreetLife') and (['Landry', 'Wren', 'Grant'].some(name => C.npc[name]?.init === 1) or $mickeyPub gte 2)>>
    <<deadwood-card 'Street contacts' '街头往来'>>
      <<deadwood-street-contact-status>>
    <</deadwood-card>>
    <hr>
  <</if>>
<</widget>>

<!-- 公路赛只显示已提交的赛段与回执，读日志不会推进比赛或领取奖金。 -->
<<widget 'deadwood-street-race-journal'>>
  <<set _journal_races to maplebirch.get('StreetLife')?.races>>
  <<if _journal_races?.state.session>>
    <<deadwood-card 'Road racing' '公路赛事'>>
      <<set _journal_race to _journal_races.state.session>>
      <b><<= lanSwitch(_journal_races.group.name.EN, _journal_races.group.name.CN)>></b><br>
      <<lanSwitch 'Sections completed: ' '已完成赛段：'>><span class='teal'><<= _journal_race.step>> / <<= _journal_races.terms.stages.length>></span><br>
      <<if maplebirch.get('Transport')>>
        <<lanSwitch 'Current location: ' '当前位置：'>><<= maplebirch.get('Transport').catalog.name(_journal_race.point)>><br>
      <</if>>
      <<lanSwitch 'Continue from the race scene, or pull over to withdraw.' '在比赛现场继续行驶，或靠边停车退赛。'>>
    <</deadwood-card>><hr>
  <</if>>
<</widget>>

<!-- 追缉：只读案件、回执与押送车辆，目标生成、追逐和领款由现场选择处理。 -->

<<widget 'deadwood-street-bounty-journal'>>
  <<set _journal_bounties to maplebirch.get('StreetLife')?.bounties>>
  <<if !_journal_bounties>><<exit>><</if>>
  <<set _journal_bounty_state to _journal_bounties.state>>
  <<if (C.npc.Grant.init is 1 and C.npc.Grant.state is 'active') or _journal_bounty_state.cooperating or _journal_bounty_state.active or _journal_bounty_state.last or _journal_bounty_state.hunter>>
    <<deadwood-card 'Cases and bounties' '案件与悬赏'>>
      <<if C.npc.Grant.init is 1 and C.npc.Grant.state is 'active'>>
        <ul class='journal'>
          <li>
            <<lanSwitch 'Grant receives visitors beside the noticeboard in the Barb Street police station every day, 08:00–18:00.' '格兰特每天08:00–18:00在倒钩街警察局的告示板旁接待来访。'>>
          </li>
          <<if !_journal_bounty_state.active and !_journal_bounties.wanted>>
            <<if _journal_bounty_state.cooperating>>
              <li><<lanSwitch 'Visit the bounty desk during those hours to look over the open cases.' '可在这段时间前往悬赏柜台，查看待办案件。'>></li>
            <<else>>
              <li><<lanSwitch 'Speak with the detective about helping with enquiries before taking a case.' '先与警探谈谈协助查案，再接取案件。'>></li>
            <</if>>
          <</if>>
        </ul>
      <<elseif _journal_bounty_state.cooperating>>
        <ul class='journal'>
          <li><<lanSwitch 'You have agreed to help Grant with enquiries.' '你答应了协助格兰特查案。'>></li>
        </ul>
      <</if>>
      <<deadwood-street-bounty-status>>
      <<if _journal_bounty_state.active?.stage is 'escort' and _journal_bounty_state.active.vehicle isnot null and !_journal_bounties.lost and maplebirch.get('Transport')>>
        <<set _journal_bounty_vehicle to _journal_bounties.vehicle, _journal_bounty_transport to maplebirch.get('Transport')>>
        <<set _journal_bounty_model to _journal_bounty_transport.catalog.models.find(item => item.id === _journal_bounty_vehicle.model)>>
        <ul class='journal'>
          <li><<lanSwitch 'Escort vehicle: ' '押送车辆：'>><span class='teal'><<= maplebirch.t(_journal_bounty_model.name)>></span> · <<= _journal_bounty_transport.catalog.name(_journal_bounty_vehicle.point)>></li>
        </ul>
      <</if>>
      <<if _journal_bounty_state.hunter>>
        <ul class='journal'><li @class='_journal_bounty_state.hunter.stage === "escaped" ? "green" : "red"'>
          <<switch _journal_bounty_state.hunter.stage>>
            <<case 'approach'>><<lanSwitch 'A bounty hunter has stopped you in the street.' '赏金猎人在街上拦住了你。'>>
            <<case 'confrontation'>><<lanSwitch 'The hunter is confronting you over the notice.' '猎人正在依照告示拦截你。'>>
            <<case 'fight'>><<lanSwitch 'You are fighting the hunter.' '你正在与猎人战斗。'>>
            <<case 'caught'>><<lanSwitch 'The hunter has caught you and is arranging a police handover.' '你已被猎人抓住，对方正在安排移交警方。'>>
            <<case 'escaped'>><<lanSwitch 'You have escaped this hunter.' '你已摆脱这名猎人。'>>
          <</switch>>
        </li></ul>
      <</if>>
      <<if _journal_bounties.wanted>>
        <ul class='journal'><li class='red'><<lanSwitch 'The police have enough evidence to arrest you. New assignments and reward payments are suspended. Ask at reception about your own record first; helping with enquiries does not clear it.' '警方已有足够罪证拘捕你，新委托与赏金发放暂时停止。先到前台处理你自己的记录。协助查案不会消除罪证。'>></li></ul>
      <<elseif _journal_bounty_state.active?.stage is 'settlement'>>
        <span class='blue'><<lanSwitch 'Reward collection: police station, 08:00–18:00.' '赏金领取：警察局，08:00–18:00。'>></span><br>
      <</if>>
    <</deadwood-card>>
    <hr>
  <</if>>
<</widget>>

<!-- 弹药库存只读，购买与开火在现场结算。 -->

<<widget 'deadwood-street-ammunition-journal'>>
  <<set _journal_street to maplebirch.get('StreetLife')>>
  <<if _journal_street and (Object.values($StreetLife.ammo).some(count => count > 0) or ['handheld', 'handheld_left'].some(slot => setup.clothes.handheld[$worn[slot]?.index]?.streetWeapon))>>
    <<deadwood-card 'Ammunition' '弹药'>>
      <div class='dr-finance-summary'>
        <<for _journal_ammo_id, _journal_ammo range _journal_street.ammunition>>
          <span><<icon _journal_ammo.icon>><<= lanSwitch(_journal_ammo.name[0], _journal_ammo.name[1])>></span><span class='teal'><<= $StreetLife.ammo[_journal_ammo_id]>><<lanSwitch ' rounds' ' 发'>></span>
        <</for>>
      </div>
      <ul class='journal'>
        <li><<lanSwitch 'The weapon seller at the smugglers\' pub stocks ammunition.' '走私者酒馆的武器卖家也出售弹药。'>></li>
        <li><<lanSwitch 'Practice with Eden improves your aim; pain makes it harder to keep steady.' '与伊甸练枪有助于瞄准。疼痛会让你更难保持稳定。'>></li>
      </ul>
    <</deadwood-card>><hr>
  <</if>>
<</widget>>

<!-- 出租车工作 -->

<<widget 'deadwood-taxi-journal'>>
  <<set _journal_taxi to maplebirch.get('Transport').taxi>>
  <<if _journal_taxi.active>>
    <<deadwood-card 'Taxi work' '出租车工作'>>
      <div class='dr-finance-summary'>
        <span><<lanSwitch 'This shift' '本班车辆'>></span><span><<lanSwitch `_journal_taxi.state.shift.mode is 'fleet' ? 'Company car' : 'Own car'` `_journal_taxi.state.shift.mode is 'fleet' ? '车行营运车' : '自备汽车'`>></span>
        <<if _journal_taxi.state.shift.mode is 'fleet'>>
          <span><<lanSwitch 'Awaiting collection' '待结算收入'>></span><span><<deadwood-transport-money _journal_taxi.state.shift.earned>></span>
        <</if>>
      </div>
    <</deadwood-card>>
    <hr>
  <</if>>
<</widget>>

<!-- 载具 -->

<<widget 'deadwood-transport-journal'>>
  <<set _transport to maplebirch.get('Transport')>>
  <<deadwood-taxi-journal>>
  <<if _transport.state.vehicles.length>>
    <h1 class='header gold bold'><<lanSwitch 'Vehicles' '载具'>></h1>
    <div class='deadwood-card-grid deadwood-transport-records'>
      <<for _owned range _transport.state.vehicles>>
        <<deadwood-transport-vehicle-record _owned>>
      <</for>>
    </div>
    <hr>
  <</if>>
<</widget>>

<!-- 罗宾：正式店铺账目与尚未解决的收容事件。开店筹备仍在原版时效备忘中。 -->
<<widget 'deadwood-robin-shop-journal'>>
  <<set _journal_robin to maplebirch.get('Robin')>>
  <<if !_journal_robin or C.npc.Robin.init isnot 1 or !$RobinExpansion?.shop>><<exit>><</if>>
  <<set _journal_shop to _journal_robin.shop, _journal_contract to _journal_shop.partnership.state>>
  <<deadwood-card "Robin's drinks shop" '罗宾饮品店'>>
    <<lanSwitch 'Cliff Street · 09:00–21:00' '峭壁街 · 09:00–21:00'>>
    <div class='dr-finance-summary'>
      <span><<lanSwitch "Robin's cash and reserve" '罗宾的现金与储备金'>></span><span><<printmoney `_journal_robin.funds * 100`>></span>
      <span><<lanSwitch 'Shared-shift ingredients (crates)' '共同看店原料（箱）'>></span><span @class='$RobinExpansion.shop_stock > 0 ? "teal" : "red"'><<= $RobinExpansion.shop_stock>></span>
      <span><<lanSwitch 'Permanent staff' '正式店员'>></span><span class='teal'><<= $RobinExpansion.shop_staff>></span>
      <<if $RobinExpansion.shop_staff gt 0>>
        <span><<lanSwitch 'Weekly staff wages' '店员周薪合计'>></span><span><<printmoney `_journal_shop.staffWages * 100`>></span>
      <</if>>
      <<if $RobinExpansion.pc_loan gt 0>>
        <span><<lanSwitch 'Loan owed to you' '尚欠你的借款'>></span><span><<printmoney `$RobinExpansion.pc_loan * 100`>></span>
      <</if>>
      <<if $RobinExpansion.shop_flowers>>
        <span><<lanSwitch 'Flowers in stock' '鲜花库存'>></span><span class='teal'><<= _journal_robin.flowers.stockTotal>></span>
      <</if>>
      <<if _journal_contract.agreed>>
        <span><<lanSwitch 'Private partnership' '私人合伙份额'>></span><span class='teal'><<lanSwitch 'You 50% / Robin 50%' '你50%／罗宾50%'>></span>
        <span><<lanSwitch 'Shop working money' '店铺周转金'>></span><span><<printmoney _journal_contract.treasury>></span>
        <<if _journal_contract.next_settlement gte 0>>
          <span><<lanSwitch 'Next settlement' '下次结算'>></span><span class='blue'><<deadwood-journal-date _journal_contract.next_settlement>></span>
        <</if>>
      <</if>>
    </div>
    <<if _journal_shop.employees.length or _journal_contract.report or maplebirch.get('Orchard')?.freshSupplySales gt 0 or $RobinExpansion.shop_stock is 0 or $RobinExpansion.pc_loan gt 0>>
      <ul class='journal'>
        <<if _journal_shop.employees.length>>
          <li><<lanSwitch 'Staff: ' '店员：'>><span class='blue'><<= _journal_shop.employees.join(lanSwitch(', ', '、'))>></span></li>
        <</if>>
        <<if _journal_contract.report>>
          <li><<lanSwitch 'Latest accounts: ' '上期经营：'>>
          <<lanSwitch 'Recorded business income: ' '已入账经营收入：'>><<printmoney _journal_contract.report.income>>
          · <<lanSwitch 'Dividend paid: ' '已付分红：'>><<printmoney _journal_contract.report.dividend>></li>
        <</if>>

        <<if maplebirch.get('Orchard')?.freshSupplySales gt 0>>
          <li><span class='teal'><<lanSwitch 'Your recent fruit delivery is supplying the shop.' '你最近送来的水果正在供应店铺。'>></span></li>
        <</if>>
        <<if $RobinExpansion.shop_stock is 0>>
          <li class='blue'><<lanSwitch 'Shared-shift ingredients have run out. Discuss restocking with Robin at the shop.' '共同看店的原料用完了，可以到店里和罗宾商量补货。'>></li>
        <</if>>
        <<if $RobinExpansion.pc_loan gt 0>>
          <li><<lanSwitch 'Check the ledger with Robin to discuss repayment.' '和罗宾核对账本，商量还款。'>></li>
        <</if>>
      </ul>
    <</if>>
  <</deadwood-card>>
  <hr>
<</widget>>

<<widget 'deadwood-robin-asylum-journal'>>
  <<if !maplebirch.get('Robin') or C.npc.Robin.init isnot 1 or !$RobinExpansion?.asylum>><<exit>><</if>>
  <<set _journal_asylum to $RobinExpansion.asylum>>
  <<if _journal_asylum.status is 'admitted'>>
    <div class='bold'><<lanSwitch 'Robin in the asylum' '精神病院里的罗宾'>></div>
    <ul class='journal'>
      <<if !_journal_asylum.met>>
        <li><<lanSwitch 'Robin has been taken to the asylum. Once inside, you can look for Robin in the ward during the day.' '罗宾被送进了精神病院。进入院内后，可以在白天去病区找罗宾。'>></li>
      <<elseif _journal_asylum.plan lt 2>>
        <li><<lanSwitch 'You are planning an escape with Robin. Visit the ward again after another staff shift has been observed.' '你正在与罗宾计划逃离。等罗宾再观察一次换班后，回病区继续商量。'>></li>
      <<else>>
        <li><<lanSwitch "The escape plan is ready. You'll need Harper's keycard and an opportunity after lights out." '逃离计划已准备好。还需要哈珀的门禁卡，以及熄灯后的机会。'>></li>
      <</if>>
    </ul>
    <hr>
  <</if>>
<</widget>>

<!-- 悉尼：只提醒尚未回应的换班消息和未赴约的邀请。 -->
<<widget 'deadwood-sydney-journal'>>
  <<if !maplebirch.get('Sydney') or C.npc.Sydney.init isnot 1 or !$SydneyExpansion>><<exit>><</if>>
  <<if ($SydneyExpansion.scienceHint and $sydneyScience isnot 1) or ($SydneyExpansion.estate.invited and !$SydneyExpansion.estate.visited) or ($SydneyExpansion.dormInvited and !$SydneyExpansion.dormVisited)>>
    <div class='bold'><<lanSwitch "Sydney's plans" '悉尼的安排'>></div>
    <ul class='journal'>
      <<if $SydneyExpansion.scienceHint and $sydneyScience isnot 1>>
        <li><<lanSwitch 'Sydney has mentioned moving to your science class. Ask about it after having lunch together in the school canteen.' '悉尼提过换到你的科学班。可以在学校食堂一起吃过午饭后问问。'>></li>
      <</if>>
      <<if $SydneyExpansion.estate.invited and !$SydneyExpansion.estate.visited>>
        <li><<lanSwitch 'Sirris has invited you to the house on Danube Street. Visit when Sirris or Sydney is home.' '西里斯邀请你到多瑙河街的庄园。可以在西里斯或悉尼在家时拜访。'>></li>
      <</if>>
      <<if $SydneyExpansion.dormInvited and !$SydneyExpansion.dormVisited>>
        <li><<lanSwitch 'Sydney has invited you to sit by the bunk in the temple quarters.' '悉尼邀请你到神殿宿舍的床铺旁坐坐。'>></li>
      <</if>>
    </ul>
    <hr>
  <</if>>
<</widget>>

<!-- 果园：交货合同单列，履约、取消或失效后退出提醒。 -->
<<widget 'deadwood-orchard-orders-journal'>>
  <<set _journal_orchard to maplebirch.get('Orchard')>>
  <<if !_journal_orchard or !$Orchard>><<exit>><</if>>
  <<if _journal_orchard.orderStatus is 'pending' or ($Orchard.farm_contract?.status is 'pending' and Time.days lte $Orchard.farm_contract.deadline)>>
    <<deadwood-card 'Fruit deliveries' '水果供货'>>
      <ul class='journal'>
        <<if _journal_orchard.orderStatus is 'pending'>>
          <li><<lanSwitch "Robin's drinks shop: " '罗宾饮品店：'>><<foodstufficon $Orchard.order.type>><<= setup.foodstuff[$Orchard.order.type].singular>> × <<= $Orchard.order.amount>> · <<lanSwitch 'Payment: ' '货款：'>><<printmoney `$Orchard.order.price * $Orchard.order.amount`>> · <span class='blue'><<deadwood-journal-date $Orchard.order.deadline>></span></li>
        <</if>>
        <<if ($Orchard.farm_contract?.status is 'pending' and Time.days lte $Orchard.farm_contract.deadline)>>
          <li><<lanSwitch "Alex's farm: " '艾利克斯的农场：'>><<foodstufficon $Orchard.farm_contract.type>><<= setup.foodstuff[$Orchard.farm_contract.type].singular>> × <<= $Orchard.farm_contract.amount>> · <<lanSwitch 'Payment: ' '货款：'>><<printmoney `$Orchard.farm_contract.price * $Orchard.farm_contract.amount`>> · <span class='blue'><<deadwood-journal-date $Orchard.farm_contract.deadline>></span></li>
        <</if>>
      </ul>
    <</deadwood-card>>
    <hr>
  <</if>>
<</widget>>

<!-- 酿造只读保存的批次与库存，查看日志不装瓶、不出售。 -->
<<widget 'deadwood-orchard-winery-journal'>>
  <<set _journal_winery to maplebirch.get('Orchard')?.winery>>
  <<if _journal_winery?.state.installed>>
    <<deadwood-card 'Orchard winery' '果园酿酒间'>>
      <ul class='journal'>
        <li><<icon 'orchard/winery.png'>><<lanSwitch 'Barrels in use: ' '在用酒桶：'>><span class='teal'><<= _journal_winery.state.batches.length>> / <<= _journal_winery.terms.barrelCapacity>></span></li>
        <<for _journal_batch range _journal_winery.state.batches>>
          <<set _journal_wine to _journal_winery.terms.recipes.find(recipe => recipe.id === _journal_batch.recipe)>>
          <li><<lanSwitch _journal_wine.name[0] _journal_wine.name[1]>> · <<= _journal_batch.bottles>> <<lanSwitch 'bottles' '瓶'>> ·
            <<if _journal_batch.ready_at lte Time.date.timeStamp>>
              <span class='green'><<lanSwitch 'Ready to bottle at the winery.' '可到酿酒间装瓶。'>></span>
            <<else>>
              <span class='blue'><<lanSwitch 'Fermenting, about ' '发酵中，约剩'>><<= Math.ceil((_journal_batch.ready_at - Time.date.timeStamp) / 3600)>><<lanSwitch ' hours remaining.' '小时。'>></span>
            <</if>>
          </li>
        <</for>>
        <<for _journal_wine range _journal_winery.terms.recipes>>
          <<if _journal_winery.state.stock[_journal_wine.id] gt 0>>
            <li><<lanSwitch _journal_wine.name[0] _journal_wine.name[1]>> · <span class='teal'><<= _journal_winery.state.stock[_journal_wine.id]>></span> <<lanSwitch 'bottles, keep at least: ' '瓶，保留目标：'>><<= _journal_winery.state.reserve[_journal_wine.id]>></li>
          <</if>>
        <</for>>
        <<if _journal_winery.state.shop_enabled>>
          <li><<lanSwitch "Bottles on Robin's shelf: " '罗宾侧柜存酒：'>><span class='teal'><<= _journal_winery.shopStock>></span> / <<= _journal_winery.terms.shopStockLimit>> · <<lanSwitch 'Weekly sales limit: ' '每周最多售出：'>><<= _journal_winery.terms.shopWeeklyLimit>></li>
        <</if>>
      </ul>
      <<if _journal_winery.state.automation.installed>>
        <<set _journal_winePlan to _journal_winery.terms.recipes.find(recipe => recipe.id === _journal_winery.state.automation.recipe)>>
        <<lanSwitch 'Refill recipe: ' '空桶继续酿：'>>
        <<if _journal_winePlan>><<lanSwitch _journal_winePlan.name[0] _journal_winePlan.name[1]>><<else>><<lanSwitch 'No new batches' '不再投料'>><</if>><br>
      <</if>>
      <<deadwood-orchard-winery-automation-status>>
    <</deadwood-card>><hr>
  <</if>>
<</widget>>

<!-- 交通：领证与补考日期不依赖玩家是否已经买车。 -->
<<widget 'deadwood-driving-school-journal'>>
  <<if !maplebirch.get('Transport') or !$Transport?.school>><<exit>><</if>>
  <<set _journal_driving to maplebirch.get('Transport').school, _journal_school to $Transport.school>>
  <<if !_journal_school.provisional.issued and _journal_school.provisional.applied_day lt 0
      or _journal_driving.record.licensed>><<exit>><</if>>
  <div class='bold'><<lanSwitch 'Driving school' '驾校'>></div>
  <ul class='journal'>
    <li><<lanSwitch 'Harvest Street driving school, 09:00–17:00, closed on Sundays. Lessons and exams must finish before closing.' '丰收街驾校，09:00–17:00，周日休息。课程与考试须在关门前结束。'>></li>
    <<if _journal_school.penalty_until gt Time.days>>
      <li class='red'><<lanSwitch 'The school will accept you again from ' '驾校暂停受理，恢复日期：'>><<deadwood-journal-date _journal_school.penalty_until>></li>
    <<elseif _journal_school.exam>>
      <li><<lanSwitch 'Your road test is underway. Continue with the examiner at the driving school.' '路考尚未结束，回驾校继续听考官的指示。'>></li>
    <<else>>
      <li>
        <<lanSwitch `_journal_school.category === 'motorcycle' ? 'Motorcycle course: ' : 'Car course: '` `_journal_school.category === 'motorcycle' ? '摩托车课程：' : '汽车课程：'`>>
        <<switch _journal_driving.nextStep>>
          <<case 'collect'>>
            <<lanSwitch 'Collect your provisional licence from ' '临时驾照可于'>><<deadwood-journal-date _journal_school.provisional.ready_day>><<lanSwitch ' at the school.' '起到前台领取。'>>
          <<case 'cbt'>>
            <<lanSwitch 'Book basic training. Allow six hours and arrive by 11:00 on a day with suitable weather.' '下一步预约基础培训。需六小时，在天气合适的日子于11:00前到校。'>>
          <<case 'study'>>
            <<lanSwitch 'You can revise for the theory test or sit it when ready.' '可以继续复习理论，准备好后参加理论考试。'>>
          <<case 'theory'>>
            <<lanSwitch 'Take the theory test at the front desk.' '到前台申请参加理论考试。'>>
          <<case 'lesson'>>
            <<lanSwitch 'Take practical lessons at the school. Training cars are provided; you do not need to buy one.' '继续在驾校上实操课。驾校提供练习车辆，不必先买车。'>>
          <<case 'module_1'>>
            <<lanSwitch 'Your training is sufficient for the motorcycle manoeuvring test.' '练习已经达标，可以申请摩托车场地考试。'>>
          <<case 'test'>>
            <<lanSwitch 'Your training is sufficient for the road test. Leave fifty minutes before closing.' '练习已经达标，可以申请路考，关门前需留足五十分钟。'>>
        <</switch>>
      </li>
      <<if !_journal_driving.record.theory and _journal_driving.record.theory_retest_day gt Time.days>>
        <li><<lanSwitch 'Theory retest available from: ' '理论最早补考日期：'>><<deadwood-journal-date _journal_driving.record.theory_retest_day>></li>
      <</if>>
      <<if _journal_driving.record.retest_day gt Time.days>>
        <li><<lanSwitch 'Practical retest available from: ' '实操最早补考日期：'>><<deadwood-journal-date _journal_driving.record.retest_day>></li>
      <</if>>
      <<if _journal_school.test_day is Time.days>>
        <li><<lanSwitch 'You have taken an exam today. Another can be booked from tomorrow.' '今天已经参加过考试，明天起才能再约一场。'>></li>
      <</if>>
    <</if>>
  </ul><hr>
<</widget>>

<<widget 'deadwood-journal-date'>>
  <<= getFormattedDate(new DateTime(Time.startDate).addDays(_args[0]))>>
<</widget>>

<<widget 'deadwood-finance-donation-receipts'>>
  <<if $Finance.donations.receipts.length gt 0>>
    <<deadwood-card 'Recent donation receipts' '近期捐赠收据'>>
      <ul class='journal'>
        <<for _donation_receipt range $Finance.donations.receipts.slice(-4).reverse()>>
          <li>
            <<print maplebirch.t('deadwood-reblooms:donations:' + _donation_receipt.fund)>><<if _donation_receipt.purpose>> · <<print lanSwitch(_donation_receipt.purpose.EN, _donation_receipt.purpose.CN)>><</if>>:
            <<deadwood-reblooms-finance-money _donation_receipt.amount>>
            <<if _donation_receipt.anonymous>><i><<lanSwitch ' (anonymous)' '（匿名）'>></i><</if>>
          </li>
        <</for>>
      </ul>
    <</deadwood-card>>
  <</if>>
<</widget>>

<<widget 'deadwood-donation-rewards'>>
  <<set _donation_reward to maplebirch.get('Finance').donations.state.rewards[_args[0]]>>
  <<lanSwitch 'Fame awarded: good ' '已获名声：善名 '>><span class='green'><<= _donation_reward.named + (_donation_reward.signed ? 25 : 0)>></span> / <<lanSwitch 'social ' '社交 '>><span class='teal'><<= _donation_reward.followed ? 10 : 0>></span><br>
<</widget>>

<<widget 'deadwood-finance-school-donation-journal'>>
  <<if $Finance.donations.total.school gt 0>>
    <<set _school_fund to maplebirch.get('Finance').donations.school>>
    <<deadwood-card 'School funding' '学校资助'>>
      <div class='dr-finance-summary'>
        <span><<lanSwitch 'Total donated' '累计捐款'>></span><span><<deadwood-reblooms-finance-money $Finance.donations.total.school>></span>
        <span><<lanSwitch 'Named contributions' '实名资助'>></span><span><<deadwood-reblooms-finance-money $Finance.donations.named.school>></span>
      </div>
      <<deadwood-donation-rewards 'school'>>
      <<if !_school_fund.funded>>
        <<lanSwitch 'Laboratory equipment and teaching supplies are awaiting full funding.' '实验器材与教学用品仍在募资。'>>
      <<elseif !_school_fund.ready>>
        <<if _school_fund.state.replacement_at isnot null>><<lanSwitch 'The supplier is replacing the microscope fittings.' '供应商正在更换显微镜配件。'>><<else>><<lanSwitch 'The school has placed the supply order.' '学校已订购器材与教学用品。'>><</if>>
        <br><<lanSwitch 'Expected delivery: ' '预计送达：'>><span class='blue'><<print getFormattedDate(new DateTime(_school_fund.due))>> <<print new DateTime(_school_fund.due).hour>>:<<print String(new DateTime(_school_fund.due).minute).padStart(2, '0')>></span>
      <<else>>
        <span class='green'><<lanSwitch 'The equipment and teaching supplies have arrived.' '器材与教学用品已送达。'>></span>
      <</if>>
      <<if _school_fund.eligible>>
        <<if _school_fund.state.terms is null>>
          <br><<lanSwitch "Take your receipt to Leighton's office during the school day to discuss the project." '上学日可携收据到礼顿办公室商量项目安排。'>>
        <<elseif _school_fund.state.signed_at is null>>
          <<if _school_fund.ready>>
            <br><<lanSwitch 'Review the delivery and sign the receipt at the school office.' '到校长办公室核对交付，并签收物资。'>>
          <</if>>
        <<else>>
          <<if _school_fund.state.terms is 'access'>>
            <br><<lanSwitch 'Equipment use: school days, 15:00–16:44; one short session each day.' '器材使用：上学日 15:00–16:44，每天一次短时练习。'>>
          <</if>>
          <<if !_school_fund.state.favour_used and $headnodetention isnot 1>>
            <br><<lanSwitch 'Leighton will review one minor detention with you.' '你还可向礼顿申请一次轻微留堂复核。'>>
          <</if>>
          <<if _school_fund.state.followed>><br><<lanSwitch 'A factory with a suitable production line may receive enquiries for routine supplies.' '经营相应生产线的工厂可能收到日常用品询价。'>><</if>>
          <br><<lanSwitch 'Benefactor appointment: one 20-minute meeting each school week, arranged from the corridors.' '资助者接见：上学日每周一次，20 分钟，可从走廊安排。'>>
          <<if !_school_fund.state.followed>>
            <br><<lanSwitch 'Check back with Leighton on a later school day about the supplies.' '之后的上学日，可向礼顿询问用品投入使用的情况。'>>
          <</if>>
        <</if>>
      <</if>>
    <</deadwood-card>>
  <</if>>
<</widget>>

<<widget 'deadwood-finance-aid-journal'>>
  <<set _aid to maplebirch.get('Finance').donations.aid>>
  <<for _aid_project range maplebirch.get('Finance').donations.projects.filter(project => project.id !== 'school' && project.donated > 0)>>
    <<set _aid_state to _aid.state(_aid_project.id)>>
    <<deadwood-card `maplebirch.t(_aid_project.name)` `maplebirch.t(_aid_project.name)`>>
      <div class='dr-finance-summary'>
        <span><<lanSwitch 'Total donated' '累计捐款'>></span><span><<deadwood-reblooms-finance-money _aid_project.donated>></span>
        <span><<lanSwitch 'Named contributions' '实名资助'>></span><span><<deadwood-reblooms-finance-money `$Finance.donations.named[_aid_project.id]`>></span>
      </div>
      <<print maplebirch.t(_aid_project.project)>><br>
      <<deadwood-donation-rewards _aid_project.id>>
      <<if !_aid_project.funded>>
        <<lanSwitch 'Funding target: ' '募资目标：'>><<deadwood-reblooms-finance-money _aid_project.goal>>
      <<elseif !_aid.ready(_aid_project.id)>>
        <<if _aid_state.replacement_at isnot null>><<lanSwitch 'The supplier is replacing the unsuitable items.' '供应商正在更换不合用的物资。'>><<else>><<lanSwitch 'The supply order has been placed.' '物资已订购。'>><</if>>
        <br><<lanSwitch 'Expected delivery: ' '预计送达：'>><span class='blue'><<print getFormattedDate(new DateTime(_aid.due(_aid_project.id)))>> <<print new DateTime(_aid.due(_aid_project.id)).hour>>:<<print String(new DateTime(_aid.due(_aid_project.id)).minute).padStart(2, '0')>></span>
      <<else>>
        <span class='green'><<lanSwitch 'The supplies have arrived.' '物资已送达。'>></span>
      <</if>>
      <<if _aid.has(_aid_project.id) and !(_aid_project.id is 'orphanage' and $RobinExpansion?.bailey_defeated)>>
        <br><<switch _aid_project.id>>
          <<case 'temple'>>
            <<lanSwitch 'Quiet room: once daily, 30 minutes. Private prayer and relief priorities: once weekly, 20 minutes.' '安静房间：每天一次，30 分钟。私人祈祷与救济安排：每周一次，20 分钟。'>>
            <<if _aid_state.privacy>><br><span class='blue'><<lanSwitch 'Jordan reluctantly tolerates unclothed use of the private residential areas. Keep covered when you speak to ' '约旦勉强容忍你在私人居住区域裸身活动。与'>><<nnpc_him 'Jordan'>><<lanSwitch '.' '见面时，要穿好衣服。'>></span><</if>>
          <<case 'hospital'>>
            <<lanSwitch 'Private parasite treatment: 25% off. Routine consultation: once weekly, 20 minutes.' '私密寄生虫治疗：费用减免 25%。常规健康咨询：每周一次，20 分钟。'>>
          <<case 'orphanage'>>
            <<if !$RobinExpansion?.bailey_defeated>>
              <<lanSwitch 'Private business appointment: once weekly, 07:00–10:00, arranged from the hall.' '私人事务接待：每周一次，07:00–10:00，可从大厅安排。'>>
              <<if !_aid_state.rent_used and !maplebirch.get('Finance').orphanage.pcFree>><br><<lanSwitch 'One seven-day rent extension remains; ask before the payment is overdue.' '还可申请一次七天租金延期，需在付款到期前提出。'>><</if>>
            <</if>>
        <</switch>>
      <<elseif _aid_state.signed_at isnot null and _aid.eligible(_aid_project.id) and !(_aid_project.id is 'orphanage' and $RobinExpansion?.bailey_defeated)>>
        <br><<lanSwitch 'Ask the recipient to put your benefactor arrangements in writing.' '可找负责人确认资助者待遇，并写入约定。'>>
      <</if>>
      <<if _aid_state.followed and _aid.eligible(_aid_project.id)>>
        <br><<lanSwitch 'A factory with a suitable production line may receive enquiries for routine supplies.' '经营相应生产线的工厂可能收到日常用品询价。'>>
      <</if>>
      <<if _aid.eligible(_aid_project.id) and !(_aid_project.id is 'orphanage' and $RobinExpansion?.bailey_defeated)>>
        <<if _aid_state.terms is null>>
          <br><<switch _aid_project.id>>
            <<case 'temple'>><<lanSwitch 'Discuss the relief supplies with Jordan during the day.' '白天可找约旦商量救济物资。'>>
            <<case 'hospital'>><<lanSwitch 'Ask at the hospital reception on weekdays, 09:00–17:00.' '工作日 09:00–17:00，可到医院前台询问项目接待。'>>
            <<case 'orphanage'>><<lanSwitch "Take the receipt to Bailey's office, 07:00–10:00." '07:00–10:00，可携收据到贝利办公室。'>>
          <</switch>>
        <<elseif _aid_state.signed_at is null and _aid.ready(_aid_project.id)>>
          <br><<lanSwitch 'Review the delivery and complete the receipt with the recipient.' '可找受助方核对交付，并完成签收。'>>
        <<elseif _aid_state.signed_at isnot null and !_aid_state.followed>>
          <br><<lanSwitch 'Return on a later day to hear how the supplies are being used.' '之后可回来了解物资投入使用的情况。'>>
        <</if>>
      <</if>>
    <</deadwood-card>>
  <</for>>
<</widget>>

<<widget 'deadwood-transport-vehicle-record'>>
  <<set _record_vehicle to _args[0], _record_model to maplebirch.get('Transport').catalog.models.find(model => model.id === _record_vehicle.model)>>
  <<set _record_title to '<<icon "transport/' + _record_model.id + '.png">>' + maplebirch.t(_record_model.name)>>
  <<deadwood-card _record_title _record_title>>
    <div class='dr-finance-summary'><<deadwood-transport-vehicle-status _record_model _record_vehicle>></div>
  <</deadwood-card>>
<</widget>>

<<widget 'deadwood-outing-record'>>
  <<set _journal_outings to maplebirch.get('Finance').realEstate.outings>>
  <<set _journal_outing to _journal_outings.plan>>
  <<if _journal_outings.live and _journal_outing.property is _args[0]>>
    <br><<socialiseicon 'ask'>><<print maplebirch.auto(_journal_outing.name)>> · <span class='blue'><<print getFormattedDate(new DateTime(_journal_outing.at))>> <<print _journal_outing.hour>>:<<print String(new DateTime(_journal_outing.at).minute).padStart(2, '0')>></span>
    <br><<deadwood-outing-activity _journal_outing.activity>>
    <<if _journal_outing.stage is 'offered'>> · <<lanSwitch 'Your housemate has suggested this outing.' '同住恋人提出了这次外出邀约。'>>
    <<elseif _journal_outing.stage is 'booked'>> · <<lanSwitch 'Meet at your shared home.' '在共同居住的住宅碰面。'>>
    <<elseif _journal_outing.stage is 'return'>> · <<lanSwitch 'On the way home.' '准备一起回家。'>>
    <<else>> · <<lanSwitch 'Out together.' '正在一起外出。'>><</if>>
    <<if _journal_outing.name is 'Sydney'>> <span class='purple'>| <<lanSwitch 'Return before 21:00.' '21:00 前回来。'>></span><</if>>
    <<if _journal_outing.moved>><br><span class='blue'><<lanSwitch 'Weather change agreed; the date above is current.' '已因天气调整安排，以上为当前约定。'>></span><</if>>
  <</if>>
<</widget>>

:: Deadwood Reblooms Celestial Anomalies Widgets [widget]

<!-- 天体异象设置：控制日蚀与流星雨是否启用。 -->
<<widget 'Celestial-Anomalies-Options'>>
  <details open>
    <summary class='settingsHeader options'><span class='gold'><<lanSwitch 'Celestial Anomalies' '天体异象'>></span></summary>
    <div class='settingsGrid'>
      <div class='settingsToggleItem'>
        <label>
          <<checkbox '$options.maplebirch.CelestialAnomalies.SolarEclipse' false true autocheck>>
          <<lanSwitch 'Enable Solar Eclipse' '启用日蚀天象'>>
        </label>
        <span
          class='tooltip-anchor linkBlue'
          tooltip="<span class='teal'><<lanSwitch 'When enabled, a solar eclipse will occur in the specified date.' '启用后将在指定日期出现日蚀。'>></span>"
        >(?)</span>
      </div>
      <div class='settingsToggleItem'>
        <label>
          <<checkbox '$options.maplebirch.CelestialAnomalies.MeteorShower' false true autocheck>>
          <<lanSwitch 'Enable Meteor Shower' '启用流星雨天象'>>
        </label>
        <span
          class='tooltip-anchor linkBlue'
          tooltip="<span class='teal'><<lanSwitch 'When enabled, predictable meteor showers may appear overnight.' '启用后，夜间可能出现可预测的流星雨。' >></span>"
        >(?)</span>
      </div>
    </div>
  </details><hr>
<</widget>>

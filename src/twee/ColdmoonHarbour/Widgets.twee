:: Deadwood Coldmoon Harbour Widgets [widget]

<<widget 'deadwood-harbour-link'>>
  <<if maplebirch.get('MoreTransformations') and $MoreTransformations?.harbour and !$replayScene and !$statFreeze and !$frozenValues>>
    <<icon 'coldmoon-harbour/harbour.png'>><<lanLink ['Coldmoon Harbour (0:05)', '寒月港湾 (0:05)'] 'Deadwood Coldmoon Harbour'>><<pass 5>><</lanLink>><br>
  <</if>>
<</widget>>

<<widget 'deadwood-harbour-attack'>>
  <<set $_ghostHand to _args[0], $_ghostTarget to Number(maplebirch.SugarCube.State.variables[_args[0] + 'target'])>>
  <<set $_ghost to $NPCList[$_ghostTarget]>>
  <<set $_ghostEncounter to ($_ghost?.per is 'deadwood_harbour_ghost' and $MoreTransformations?.harbour?.fighting and Time.isBloodMoon()) or ($_ghost?.per is 'deadwood_ship_undead' and $MoreTransformations?.harbour?.raid?.stage is 'fight' and $location is 'pirate_ship' and Weather.dayState is 'night') or ($_ghost?.per is 'deadwood_coin_guard' and $MoreTransformations?.treasure?.guardian is 'fight' and $location is 'island')>>
  <<if !$_ghostEncounter or !maplebirch.get('MoreTransformations') or $replayScene or $statFreeze or $frozenValues or $possessed or $nextPassage or $nextPassageCheck or $combat isnot 1 or $enemytype isnot 'man' or $enemyhealth lte 0
    or $consensual isnot 0 or maplebirch.SugarCube.State.variables[$_ghostHand + 'arm'] isnot 0 or $position is 'stalk'
    or $orgasmdown gt 0 or $dissociation gte 2 or $trance gt 0 or $panicparalysis gt 0 or $panicviolence gt 0 or ($pain gte 100 and $willpowerpain is 0)
    or $_ghost.active isnot 'active' or $_ghost.stance is 'defeated' or ($enemyno gte 2 and $_ghost.health lte 0)>><<exit>><</if>>
  <<set $_ghostMaximum to $enemyno gte 2 ? $_ghost.healthmax : $enemyhealthmax>>
  <<if _args[1] is 'banish'>>
    <<if $angel lt 4 or $angelBanish lte 0 or $banishDisable>><<exit>><</if>>
    <<set $angelBanish -= 1, $_ghostDamage to maplebirch.get('VanillaPlus')?.divineTransformations.banishDamage($_ghostMaximum) ?? 10>>
    <<set $_ghostDamage *= ($purity gte 1000 ? 2 : 1) * (random(1, 100) lte $purity / 20 ? 2 : 1)>>
    <<set $speechbanish to 1>>
    <<language>>
      <<option 'EN'>>
        You trace a sacred ward in the air. Brilliant dawn-like radiance pierces the pirate’s sodden coat, forcing the hissing corpse to reel backward with charred, smoking skin.
      <<option 'CN'>>
        你在空中划出神圣的驱邪印记。破晓般的圣光如利剑般洞穿海盗湿透发黑的外套，逼得那具散发着腐腥的惨白死尸发出尖厉的嘶鸣，连连后退。
    <</language>>
  <<else>>
    <<set $_ghostWeapon to maplebirch.get('LifeSimulation')?.weapons.weapon>>
    <<if !$_ghostWeapon>><<exit>><</if>>
    <<set $_ghostDamage to Math.min(9, 2 + Math.floor($_ghostMaximum * (0.05 + Math.clamp($prof[$_ghostWeapon], 0, 1000) / 10000)))>>
    <<set $_ghostOther to $_ghostHand is 'left' ? 'right' : 'left'>>
    <<if maplebirch.SugarCube.State.variables[$_ghostOther + 'action'] is 'deadwoodHarbourWeapon'>>
      <<set maplebirch.SugarCube.State.variables[$_ghostOther + 'action'] to 0>>
    <</if>>
    <<tiredness 1>><<prof $_ghostWeapon 0.2>><<gtiredness>>
    <<language>>
      <<option 'EN'>>
        <<if $_ghostWeapon is 'whip'>>You crack your whip through the red mist, the lash biting hard across the pirate’s face.<<else>>You drive your baton violently into the pirate’s sodden ribs.<</if>> The heavy impact rings against the corpse’s rigid frame, staggering the pale figure backward across the slick timber.
      <<option 'CN'>>
        <<if $_ghostWeapon is 'whip'>>你猛然甩动皮鞭，鞭梢带着破空声凌厉地抽上海盗的面门。<<else>>你双手握紧短棍，借着腰力狠狠砸上海盗的腰肋。<</if>>沉闷的撞击声在死尸僵硬的躯体上回荡，硬生生逼得那道死冷的身影踉跄着退后半步。
    <</language>>
  <</if>>
  <<set _thedamage to Math.min($_ghostDamage, $enemyno gte 2 ? $_ghost.health : $enemyhealth)>>
  <<if $enemyno gte 2>><<npcdamage $_ghostTarget>><</if>>
  <<set $enemyhealth -= _thedamage>><<attackstat>><br>
<</widget>>

<<widget 'deadwood-harbour-context'>>
  <<set _harbour to $MoreTransformations.harbour, _harbourNight to Time.isBloodMoon()>>
  <<if _harbour.mist and !_harbourNight>>
    <<set _harbour.mist to false, _harbour.event to '', _harbour.scene to 'dawn'>>
  <<elseif _harbourNight>>
    <<set _harbour.mist to true, _harbour.ship to true>>
  <</if>>
<</widget>>

<<widget 'deadwood-harbour-search'>>
  <<if !maplebirch.get('MoreTransformations') or !$MoreTransformations?.harbour or $replayScene or $statFreeze or $frozenValues
      or $combat or $possessed or $nextPassage or $nextPassageCheck>><<exit>><</if>>
  <<set $_harbourDawn to $MoreTransformations.harbour.mist and !Time.isBloodMoon()>>
  <<deadwood-harbour-context>>
  <<if $_harbourDawn>><<exit>><</if>>
  <<set $_harbourRoll to random(1, 6)>>
  <<if _harbourNight and _args[0] is 'dive' and _harbour.zephyr.stage is 2 and $_harbourRoll gte 5>>
    <<set _harbour.zephyr.stage to 3, _harbour.scene to 'cargo', _harbour.event to ''>>
  <<elseif _harbourNight and $_harbourRoll lte 3>>
    <<set _harbour.event to ['hostile', 'chase', 'lucid'][$_harbourRoll - 1], _harbour.scene to ''>>
  <<elseif _harbourNight and $_harbourRoll is 4>>
    <<set _harbour.event to 'voice', _harbour.voice to true, _harbour.scene to ''>>
  <<elseif $_harbourRoll is 5>>
    <<set _harbour.event to ''>>
    <<if _args[0] is 'dive' and random(1, 5) is 1>>
      <<set _harbour.scene to either('antiquecoppercompass', 'antiquerustedcutlass')>>
      <<set $antiquemoney += _harbour.scene is 'antiquecoppercompass' ? 50 : 10>>
      <<museumAntiqueStatus _harbour.scene 'found'>>
    <<else>>
      <<set _harbour.relics += 1, _harbour.scene to 'relic'>>
    <</if>>
  <<else>>
    <<set _harbour.scene to _args[0] is 'dive' ? 'silt' : 'search', _harbour.event to ''>>
  <</if>>
<</widget>>

<<widget 'deadwood-harbour-result'>>
  <<switch _harbour.scene>>
    <<case 'cargo'>>
      <<language>>
        <<option 'EN'>>
          A coarse rope brushes against your wrist beneath the surface. Tracing the line into the shadowed ribs of the sunken wreck, your fingers find a small chest half-buried in silt, its lid secured by the distinct crimson cord Zephyr described. Tearing through the foul, clinging weed, you find the saturated wood bitterly freezing to the touch. Clenching the rope firmly, you guide the prize toward the stone steps, ready to haul it clear of the brine.
        <<option 'CN'>>
          一根粗糙的绳索擦过你的手腕。你顺着缆绳探入沉船残骸阴暗的肋骨下方，果然摸到了一只被海泥半掩的小箱子，箱盖上紧紧缠扎着泽菲尔所说的猩红绳结。你奋力扯开纠缠不休的黑腐海藻，浸泡多年的湿木冰冷刺骨。你牢牢抓紧提绳，稳稳地牵引着它游向港湾石阶，准备将其带上水面。
      <</language>>
    <<case 'dawn'>>
      <<language>>
        <<option 'EN'>>
          The first pale light of dawn cuts through the bloody fog. Between one crashing swell and the next, the colossal derelict dissolves into thin air like a waking nightmare. Only trails of brine-slick footprints ending abruptly at the pier's edge prove they were ever here; whatever you managed to salvage remains securely in your hands.
        <<option 'CN'>>
          破晓的第一缕天光刺破海面上的血雾。就在两阵浪涛翻涌的刹那，那艘巍峨可怖的黑色古船竟如同幻影般凭空消散无踪。只有栈桥木板上一串串散发着海腥味的湿脚印突兀地断在码头边缘；你所打捞的一切依然沉甸甸地带在身上。
      <</language>>
    <<case 'relic'>>
      <<language>>
        <<option 'EN'>>
          Something catches your eye beneath a tangle of weed. You work the keepsake free and rub away the grit. There are initials scratched into it. You put it away.
        <<option 'CN'>>
          一团海草底下露出一点光。你取出压在下面的旧物，擦掉表面的沙粒。上面刻着几个字母。你将它收好。
      <</language>>
    <<case 'antiquecoppercompass'>>
      <<wearProp 'antique copper compass'>>
      <<language>>
        <<option 'EN'>>
          You feel something round beneath the silt. It is a copper compass. You rub the dirt from its glass; the needle still points north. A collector might be interested.
        <<option 'CN'>>
          你在淤泥底下摸到一个圆东西，是只铜罗盘。擦去玻璃上的污泥，里面的指针仍指向北方。收藏家或许会对它感兴趣。
      <</language>>
    <<case 'antiquerustedcutlass'>>
      <<wearProp 'antique rusted cutlass'>>
      <<language>>
        <<option 'EN'>>
          A curved blade lies wedged beneath the broken keel. You ease it free. The edge has rusted away and the grip crumbles in your hand, but a collector might still want it.
        <<option 'CN'>>
          破船的龙骨底下卡着一把弯刀。你慢慢将它抽出。刀刃已经锈坏，握柄在手里碎了一块，收藏家或许仍会收下它。
      <</language>>
    <<case 'search'>>
      <<language>>
        <<option 'EN'>>
          You pick your way around a pool between the rocks. A crab pulls back beneath a stone before you can get close. You find a torn fishing float and a few empty shells, but nothing worth keeping.
        <<option 'CN'>>
          你绕过礁石间的一汪积水。一只螃蟹没等你靠近，就缩进石头底下。你找到了破掉的浮漂和几只空贝壳，没有什么值得带走的东西。
      <</language>>
    <<case 'silt'>>
      <<language>>
        <<option 'EN'>>
          You reach between the broken planks, keeping clear of their barnacled edges. Silt billows around your hand. When it settles, you see only sand and broken shells.
        <<option 'CN'>>
          你避开木板边缘的藤壶，把手探进残骸间。淤泥在手边扬起。等水重新变清，下面仍只有沙子和碎贝壳。
      <</language>>
    <<case 'swim'>>
      <<language>>
        <<option 'EN'>>
          You swim along the sheltered side of the breakwater. Dark rocks show beneath the surface, their tops slick with weed. You keep to the clear water and turn back at the last mooring post.
        <<option 'CN'>>
          你沿着防波堤内侧游了一段。黑色的礁石隐在水下，上面覆着滑腻的海草。你避开它们，在最后一根系船桩旁折回。
      <</language>>
    <<case 'evaded'>>
      <<language>>
        <<option 'EN'>>
          You flatten yourself behind a pile of damp, foul-smelling fishing nets, holding your breath until your lungs ache. Heavy, waterlogged footsteps squelch past just inches from your hiding spot before fading into the gloom. Only when the pier falls utterly silent again do you slip through the shadows back toward the safety of the lanterns.
        <<option 'CN'>>
          你死死伏在一摞湿透发潮的腥臭渔网背后，屏息凝神，甚至不敢发出半点声响。沉重濡湿的靴踏声擦着你的藏身之处缓缓走过，最终在黑暗中渐行渐远。等到整座码头重新回归死寂，你才悄然贴着阴影退回灯火掩映的安全之处。
      <</language>>
    <<case 'escaped'>>
      <<language>>
        <<option 'EN'>>
          You weave frantically between rusted mooring posts, pushing for every ounce of speed across the slick stones. The wet, rhythmic thumping of footsteps behind you gradually falls away, halting at last with a low, thwarted groan at the border of the swirling fog.
        <<option 'CN'>>
          你绕过生锈的系船铁桩狂奔疾突，在湿滑的石板上拼命拉开距离。身后那杂乱急促的湿靴踩踏声终于逐渐迟滞，在一阵不甘的冰冷低吼中，停驻在翻滚浓雾的边缘。
      <</language>>
    <<case 'won'>>
      <<language>>
        <<option 'EN'>>
          Battered by your resistance, the pale corpse staggers back, its frozen fingers finally uncoiling. Without a word, it dissolves back into the swirling crimson mist. You catch your breath on the slick planks, steadying your shaking legs as quiet returns to the quay.
        <<option 'CN'>>
          那道惨白僵硬的身影受到重创，颓然倒退数步，冰冷的手指不甘地松开，随后无声无息地融化回冰冷的夜雾中。你在黏湿的栈桥木板上喘息着重新站稳身子，惊魂初定。
      <</language>>
    <<case 'released'>>
      <<language>>
        <<option 'EN'>>
          At last, the suffocating grip of those icy, dead hands tears away beneath your desperate struggles. You stagger blindly out of the crimson fog and collapse onto the stone harbour steps, gasping for air as your heart hammers in your chest.
        <<option 'CN'>>
          纠缠在身上的那些冰冷死手终于在你拼死的挣扎下彻底松开。你跌跌撞撞地冲出浓重的血雾范围，瘫倒在港湾石阶旁大口大口地喘息着，心脏狂跳不止。
      <</language>>
  <</switch>>
  <<if _harbour.scene>><br><br><</if>>
<</widget>>

<<widget 'deadwood-harbour-journal'>>
  <<if $MoreTransformations?.harbour and ($MoreTransformations.harbour.ship or $MoreTransformations.harbour.relics gt 0)>>
    <br><b><<lanSwitch 'Coldmoon Harbour' '寒月港湾'>></b><br>
    <<if $MoreTransformations.harbour.relics gt 0>>
      <<lanSwitch 'Recovered keepsakes: ' '打捞的旧物：'>><<print $MoreTransformations.harbour.relics>><br>
    <</if>>
    <<if $MoreTransformations.harbour.ship>><<language>>
      <<option 'EN'>>
        A spectral black ship makes port in the blood moon fog; pale, drowned pirates plunder the abandoned quay, retreating into the ocean abyss before dawn breaks the mist.
      <<option 'CN'>>
        血月的海雾里有一艘漆黑诡谲的鬼船靠岸，惨白浮肿的死灵海盗在废弃码头上劫掠搜刮，待到破晓天光初显时随雾退回深渊。
    <</language>><</if>>
    <<if $MoreTransformations.harbour.voice>><br><<lanSwitch 'You heard low, eerie voices calling from the black depths beneath the pier.' '你听见码头下的深水里有死灵在幽幽呼唤。'>><</if>>
    <<if $MoreTransformations.harbour.spoke>><br><<language>>
      <<option 'EN'>>
        A lucid pirate revealed they drift ashore with the blood moon fog to plunder; once dawn cuts the mist, the ancient sea-curse drags them back into the crushing deep.
      <<option 'CN'>>
        一名尚存理智的死灵海盗透露，他们随血雾靠岸搜刮战利品；待到破晓雾散，深海的古老诅咒便会把他们强行拖回万丈深渊。
    <</language>><</if>>
    <<if $MoreTransformations.harbour.exchanged>><br><<language>>
      <<option 'EN'>>
        You traded a recovered keepsake for ancient coins from the ghost ship's plunder.
      <<option 'CN'>>
        你用打捞出的旧物，换来了死灵海盗搜寻来的旧铸硬币。
    <</language>><</if>>
    <<if $MoreTransformations.harbour.zephyr.stage gt 0>><br>
      <<switch $MoreTransformations.harbour.zephyr.stage>>
        <<case 1>><<lanSwitch 'Zephyr offered a handsome bounty to recover a sealed chest stolen by the undead raiders.' '泽菲尔开出悬赏，让你找回被死灵劫掠者顺走的密封小箱。'>>
        <<case 2>><<lanSwitch 'Dive beneath the harbour steps at Coldmoon Harbour during the blood moon to find the chest bound with red cord.' '血月之夜，潜入寒月港湾的石阶水下，搜寻系着红绳的小箱子。'>>
        <<case 3>><<lanSwitch 'You recovered the chest from the deep. Deliver it to Zephyr at the smuggler’s pub or aboard ship.' '箱子已经打捞出水。带去走私者酒吧或海盗船上向泽菲尔交差。'>>
        <<case 4>><<lanSwitch 'Zephyr paid the bounty for the recovered cargo.' '泽菲尔已结清找回货物的赏金。'>>
      <</switch>>
    <</if>>
  <</if>>
<</widget>>

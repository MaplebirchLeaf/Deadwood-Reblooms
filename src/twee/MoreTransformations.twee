:: Deadwood Reblooms More Transformations Widgets [widget]

<!-- 称号沿用 pcGender。生理标记独立读取身体，双性也兼容以男女记录的角色。 -->
<<widget 'deadwood-trait-sex'>><<print ({
  m: ' (♂)',
  f: ' (♀)',
  h: ' (⚥)'
})[$player.penisExist and $player.vaginaExist ? 'h' : $player.sex] ?? ''>><</widget>>

<!-- 狐火只在成功放逐后触发，波及目标沿用原版触手伤害记录与束缚清理。 -->
<<widget 'deadwood-foxfire'>>
  <<set $_foxfireMain to _args[0]>>
  <<set $_foxfire to maplebirch.get('MoreTransformations').flare($_foxfireMain, _args[1])>>
  <<if $_foxfire>>
    <span class="teal"><<language>>
      <<option 'EN'>>
        Foxfire leaps to the <<= $_foxfire.target.fullDesc>>, scorching it.
      <<option 'CN'>>
        狐火掠向附近的<<= $_foxfire.target.fullDesc>>，将其灼伤。
    <</language>></span>
    <!-- 波及伤害已从实际放逐扣血派生，记录不再叠加驱邪之术增幅。 -->
    <<tentacle_record 'banish' $_foxfire.damage $_foxfire.target 'derived'>>
    <<if $_foxfire.target.tentaclehealth lte 0>>
      <<tentacleadvdisable $_foxfire.target>>
    <</if>>
    <<set _tentacle to $_foxfireMain>>
  <</if>>
<</widget>>

<!-- 马蹄踢击：有马蹄时替换原版踢击文本并提高反抗效果。 -->
<<widget 'deadwood-reblooms-action-kick'>>
  <<if typeof $transformationParts?.traits?.hooves is 'string' and isPartEnabled($transformationParts.traits.hooves)>>
    <<print either( maplebirch.t('deadwood-reblooms:combat:hooves:kick:1'), maplebirch.t('deadwood-reblooms:combat:hooves:kick:2'), maplebirch.t('deadwood-reblooms:combat:hooves:kick:3') )>>
  <<else>>
    <<actionskick _args[0]>>
  <</if>>
<</widget>>

<<widget 'deadwood-whale-growth'>>
  <<if !$statFreeze and !$replayScene and !$possessed and (_args[0] is 'rest' or $maplebirch.transformation.whale.build gt 0)>>
    <<set $_whaleDaily to $DeadwoodReblooms.daily.whale>>
    <<if ($_whaleDaily[_args[0]] ?? 0) lt 2>>
      <<set $_whaleGain to 1>>
      <<if _args[0] is 'dive'>>
        <<set $_whaleDaily.seconds to ($_whaleDaily.seconds ?? 0) + _args[1]>>
        <<set $_whaleGain to Math.floor($_whaleDaily.seconds / 60)>>
        <<set $_whaleDaily.seconds %= 60>>
      <</if>>
      <<set $_whaleGain to Math.min($_whaleGain, 2 - ($_whaleDaily[_args[0]] ?? 0))>>
      <<if $_whaleGain gt 0>>
        <<set $_whaleDaily[_args[0]] to ($_whaleDaily[_args[0]] ?? 0) + $_whaleGain>>
        <<transform 'whale' $_whaleGain>>
      <</if>>
    <</if>>
  <</if>>
<</widget>>

<<widget 'deadwood-whale-rest'>>
  <<iconUi 'whale.png'>><<lanLink ['Float in the pool (0:10)', '在水池里漂浮 (0:10)'] $passage>>
    <<pass 10>><<stress -3>><<deadwood-whale-growth 'rest'>>
  <</lanLink>><<lstress>><<if ($DeadwoodReblooms.daily.whale.rest ?? 0) lt 2>><<transform-hint 'whale' 'lblue'>><</if>><br>
<</widget>>

<!-- 瑞沃安装阁楼厨房后，每日送来的米可在此烹成白米饭。 -->
<<widget 'deadwood-reblooms-loft-rice'>>
  <<if $loftIngredients.rice gt 0>>
    <<foodstufficon 'rice'>><<lanLink ['Cook and eat a bowl of rice (0:10)', '煮食一碗白米饭 (0:10)'] 'Orphanage Loft Kitchen'>>
      <<set $loftIngredients.rice -= 1>>
      <<pass 10>>
      <<transform 'whale' 1>>
    <</lanLink>><<transform-hint 'whale' 'lblue'>><br>
    <<if $loftIngredients.rice gte 3>>
      <<foodstufficon 'rice'>><<lanLink ['Cook and eat three bowls of rice (0:30)', '煮食三碗白米饭 (0:30)'] 'Orphanage Loft Kitchen'>>
        <<set $loftIngredients.rice -= 3>>
        <<pass 30>>
        <<transform 'whale' 3>>
      <</lanLink>><<transform-hint 'whale' 'lblue'>><br>
    <</if>>
    <br>
  <</if>>
<</widget>>

<!-- 仅包住味觉带来的收益或描述，费用、药效、任务与陪伴收益留在调用处。 -->
<<widget 'deadwood-taste' 'container'>>
  <<if !maplebirch.get('MoreTransformations')?.Undead.active>>
    <<print _contents>>
  <<elseif _args[0]>>
    <<language>>
      <<option 'EN'>>
        You swallow, but there is no flavour. Neither sweetness nor bitterness reaches you, and the familiar comfort never comes.
      <<option 'CN'>>
        你咽了下去，却尝不出滋味。甜与苦都离你很远，熟悉的慰藉迟迟没有到来。
    <</language>>
  <</if>>
<</widget>>

<!-- 沿用原版晴夜与月相，不依赖天气立绘，也不写入新进度。 -->
<<widget 'deadwood-undead-moon'>>
  <<if !maplebirch.get('MoreTransformations')?.Undead.active or !$outside or $underwater or $combat or $nextPassage or $nextPassageCheck>><<exit>><</if>>
  <<if Time.dayState isnot 'night' or Weather.precipitation isnot 'none' or Weather.isOvercast or Time.currentMoonPhase is 'new'>><<exit>><</if>>
  <<language>>
    <<option 'EN'>>
      Moonlight falls across your hand. The skin seems to thin beneath it, exposing the pale bones of your fingers. You draw your hand back into shadow. Flesh covers it once more, cold and bloodless.
    <<option 'CN'>>
      月光落上手背，皮肤在光下渐渐淡去，露出指间苍白的骨节。你把手缩回阴影里。血肉又覆了上来，依旧冰凉，没有血色。
  <</language>>
  <<if $passage is 'Pirate Deck' and $MoreTransformations?.treasure?.together and $MoreTransformations.treasure.zephyrCoins gt 0>>
    <br><br><<language>>
      <<option 'EN'>>
        Zephyr catches you looking. The captain draws a sleeve over a bare wrist, then glances at your hand. "Best keep that out of sight. Crew's jumpy enough."
      <<option 'CN'>>
        泽菲尔察觉了你的目光，拉下袖子遮住手腕，又瞥了眼你的手。“收着点。船上那帮人已经够疑神疑鬼了。”
    <</language>>
  <</if>><br><br>
<</widget>>

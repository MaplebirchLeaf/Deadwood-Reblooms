:: Deadwood Reblooms More Transformations Widgets [widget]

<<widget 'deadwood-reblooms-action-kick'>>
	<<if !['disabled', 'hidden'].includes($transformationParts.traits.hooves)>>
		<<print either(
			maplebirch.t('deadwood-reblooms.combat.hooves.kick.1'),
			maplebirch.t('deadwood-reblooms.combat.hooves.kick.2'),
			maplebirch.t('deadwood-reblooms.combat.hooves.kick.3')
		)>><<defiance 15 _args[0]>>
	<<else>>
		<<actionskick _args[0]>><<defiance 5 _args[0]>>
	<</if>>
<</widget>>

<<widget 'deadwood-reblooms-eat-rice'>>
	<<if $lastRecipeViewed is "rice" and $_group isnot "Provided" and $foodstuff.rice.amount gt 0>>
		<<link `maplebirch.t("deadwood-reblooms.fish.eatRice.one")` $passage>><<set $foodstuff.rice.amount -= 1>><<pass 10>><<transform "fish" 1>><</link>><<transform-hint "fish" "lblue">><br>
		<<if $foodstuff.rice.amount gte 3>>
			<<link `maplebirch.t("deadwood-reblooms.fish.eatRice.three")` $passage>><<set $foodstuff.rice.amount -= 3>><<pass 30>><<transform "fish" 2>><</link>><<transform-hint "fish" "lblue">><br>
		<</if>>
	<</if>>
<</widget>>

:: Deadwood Reblooms More Transformations [widget]

<<widget 'deadwood-reblooms-action-kick'>>
	<<if !['disabled', 'hidden'].includes($transformationParts.traits.hooves)>>
		<<print either(
			maplebirch.t('deadwood-reblooms.combat.hooves.kick.1'),
			maplebirch.t('deadwood-reblooms.combat.hooves.kick.2'),
			maplebirch.t('deadwood-reblooms.combat.hooves.kick.3')
		)>><<defiance 15 _args[0]>>
	<<else>>
		<<actionskick _args[0]>><<defiance 5 _args[0]>>
	<</if>>
<</widget>>
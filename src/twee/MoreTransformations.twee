:: Deadwood Reblooms More Transformations Widgets [widget]

<!-- 沿用原版混合转化开关；马尾和恶魔尾均可见时才提供此选项。 -->
<<widget 'deadwood-reblooms-demon-horse-tail-option'>>
	<<if $_chimeraOptions.demonhorse_tail>>
		<div class='tf-part-item'>
			<<lanSwitch 'Demon horse tail:' '恶魔马尾：'>>
			<<listbox '$chimera.demonhorse.tail' autoselect>>
				<<option `lanSwitch('Show', '显示')` true>>
				<<option `lanSwitch('Hide', '隐藏')` false>>
			<</listbox>>
		</div>
	<</if>>
<</widget>>

<!-- 马蹄踢击：有马蹄时替换原版踢击文本并提高反抗效果。 -->
<<widget 'deadwood-reblooms-action-kick'>>
	<<if !['disabled', 'hidden'].includes($transformationParts.traits.hooves)>>
		<<print either( maplebirch.t('deadwood-reblooms:combat:hooves:kick:1'), maplebirch.t('deadwood-reblooms:combat:hooves:kick:2'), maplebirch.t('deadwood-reblooms:combat:hooves:kick:3') )>><<defiance 15 _args[0]>>
	<<else>>
		<<actionskick _args[0]>><<defiance 5 _args[0]>>
	<</if>>
<</widget>>

<!-- 米饭食谱：消耗一杯米并推进鱼类转化。 -->
<<widget 'deadwood-reblooms-eat-rice'>>
	<<if $lastRecipeViewed is "rice" and $_group isnot "Provided" and $foodstuff.rice.amount gt 0>>
		<<language>>
			<<option 'EN'>>
				<<link 'Cook and eat a bowl of white rice 1 cup (0:10)' $passage>>
				<<set $foodstuff.rice.amount -= 1>><<pass 10>><<transform "fish" 1>>
			<</link>>
			<<option 'CN'>>
				<<link '煮一碗白米饭并吃掉 1 杯米 (0:10)' $passage>>
				<<set $foodstuff.rice.amount -= 1>><<pass 10>><<transform "fish" 1>>
			<</link>>
		<</language>>
		<<transform-hint "fish" "lblue">><br>
		<<if $foodstuff.rice.amount gte 3>>
			<<language>>
				<<option 'EN'>>
					<<link 'Cook and eat three bowls of white rice 3 cups (0:30)' $passage>>
					<<set $foodstuff.rice.amount -= 3>><<pass 30>><<transform "fish" 2>>
				<</link>>
				<<option 'CN'>>
					<<link '煮三碗白米饭并吃掉 3 杯米 (0:30)' $passage>>
					<<set $foodstuff.rice.amount -= 3>><<pass 30>><<transform "fish" 2>>
				<</link>>
			<</language>>
			<<transform-hint "fish" "lblue">><br>
		<</if>>
	<</if>>
<</widget>>

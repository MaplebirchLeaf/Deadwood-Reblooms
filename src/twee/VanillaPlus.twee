:: Deadwood Reblooms Vanilla Plus Widgets [widget]

<!-- 主动离开或昏厥后按镜面来源提供出口；出口 passage 各自完成 location 与状态收尾。 -->
<<widget 'deadwood-reblooms-deviancy-mirror-return'>>
  <<if _args[0]>>
    <<set $outside to 0>><<set $location to 'tentworld'>><<effects>>
    <<language>>
      <<option 'EN'>>
        <<if _args[0] is 'passout'>>
          You wake on the floor. The mirror above you is still, and the plain is gone.
        <<else>>
          You step through the mirror. The plain falls away behind the glass.
        <</if>>
      <<option 'CN'>>
        <<if _args[0] is 'passout'>>
          你在地板上醒来。头顶的镜面纹丝不动，平原已经消失。
        <<else>>
          你穿过镜面。平原在镜后褪去。
        <</if>>
    <</language>>
    <br><br>
  <</if>>
  <<set _mirrorReturn to $VanillaPlus.deviancy.mirror>>
  <<if _mirrorReturn is 'home'>>
    <<lanLink ['Continue', '继续'] 'Deadwood Reblooms Deviancy Mirror Home'>><</lanLink>>
  <<elseif _mirrorReturn is 'farm'>>
    <<lanLink ['Continue', '继续'] 'Deadwood Reblooms Deviancy Mirror Farm'>><</lanLink>>
  <<elseif _mirrorReturn is 'tower'>>
    <<lanLink ['Continue', '继续'] 'Deadwood Reblooms Deviancy Mirror Tower'>><</lanLink>>
  <<elseif _mirrorReturn is 'temple'>>
    <<lanLink ['Continue', '继续'] 'Deadwood Reblooms Deviancy Mirror Temple'>><</lanLink>>
  <<elseif _mirrorReturn is 'sirris'>>
    <<lanLink ['Continue', '继续'] 'Deadwood Reblooms Deviancy Mirror Sirris'>><</lanLink>>
  <<elseif _mirrorReturn is 'kylar'>>
    <<lanLink ['Continue', '继续'] 'Deadwood Reblooms Deviancy Mirror Kylar'>><</lanLink>>
  <<elseif _mirrorReturn and _mirrorReturn.startsWith('property:')>>
    <<lanLink ['Continue', '继续'] 'Deadwood Reblooms Deviancy Mirror Property'>><</lanLink>>
  <<else>>
    <<lanLink ['Continue', '继续'] 'Bedroom'>><<set $location to 'home'>><<set $outside to 0>><</lanLink>>
  <</if>>
<</widget>>

<!-- 镜子出口统一结束触手世界，并按实际出口结算成就。未指定出口时只清理状态。 -->
<<widget 'deadwood-reblooms-mirror-exit'>>
  <<effects>><<tentacleworldend>>
  <<if _args[0] and $VanillaPlus.deviancy.mirror and $VanillaPlus.deviancy.mirror isnot _args[0]>>
    <<earnFeat 'Beyond the Mirror'>>
  <</if>>
  <<set $VanillaPlus.deviancy.mirror to ''>>
<</widget>>

<!-- 属性达到第七级上限后，显示本轮实际获得的特质，属性突破提示仍由各自场景负责。 -->
<<widget 'deadwood-reblooms-trait-unlocks'>>
  <<set _unlockedTraits to maplebirch.get("VanillaPlus").unlockTraits()>>
  <<for _trait range _unlockedTraits>>
    <<set _traitName to maplebirch.t(`deadwood-reblooms:VanillaPlus:traits:${_trait}:name`)>>
    <<set _traitNotice to maplebirch.t('deadwood-reblooms:VanillaPlus:traits:unlocked', { name: _traitName })>>
    <span @class="_trait is 'incorrigible' ? 'silver' : ['exhibitionism', 'deviancy', 'promiscuity'].includes(_trait) ? 'lustful' : 'gold'"><<= _traitNotice>></span><br>
  <</for>>
<</widget>>

<!-- 容貌不再使用独立收束任务，满足既有条件时直接开放第七级。 -->
<<widget 'deadwood-reblooms-beauty-unlock'>>
  <<set $VanillaPlus.lock.beauty to true>>
  <span class="gold"><<lanSwitch 'Your beauty has broken through its former limits.' '你的容貌突破了原本的极限。'>></span><br><br>
<</widget>>

<!-- 医院入口：符合条件时提供童贞修复手术。 -->
<<widget 'deadwood-reblooms-virginity-restoration-link'>>
  <<if ($player.vaginaExist and $player.virginity.vaginal isnot true) or ($player.penisExist and $player.virginity.penile isnot true)>>
    <<icon 'virginity-restoration.png'>><<lanLink ['Enquire about virginity restoration (0:10)', '咨询童贞修复手术 (0:10)'] 'Deadwood Reblooms Virginity Restoration' >><<pass 10>><</lanLink>>
    <br>
  <</if>>
<</widget>>

<!-- 属性面板扩展：突破后追加第七档，拉满时统一显示 7/7。 -->
<<widget 'deadwood-reblooms-characteristics-degrees-display'>>
  <<if $VanillaPlus.lock.physique>>
    <<language>>
      <<option 'EN'>>
        <<set $_display_text to `Your body is ${$player.bodyshape === 'soft' ? 'powerful' : 'perfectly conditioned'} and at its peak.`>>
      <<option 'CN'>>
        <<set $_display_text to `你的身体${$player.bodyshape === 'soft' ? '强壮' : '健美'}且已臻巅峰。`>>
    <</language>>
    <<set _physiqueConfig.maxValue to maplebirch.get("VanillaPlus").ceiling('physique')>>
    <<run _physiqueConfig.states.push({ requiredValue: _physiqueConfig.maxValue, level: 7, color: 'gold', description: $_display_text })>>
    <<if $physique gte _physiqueConfig.maxValue>>
      <<set _physiqueConfig.percent to 100>>
    <</if>>
  <</if>>

  <<if $VanillaPlus.lock.willpower>>
    <<language>>
      <<option 'EN'>>
        <<set $_display_text to 'Your will is unshakable.'>>
      <<option 'CN'>>
        <<set $_display_text to '你坚毅不可撼动。'>>
    <</language>>
    <<set _willpowerConfig.maxValue to maplebirch.get("VanillaPlus").ceiling('willpower')>>
    <<run _willpowerConfig.states.push({ requiredValue: _willpowerConfig.maxValue, level: 7, color: 'gold', description: $_display_text })>>
    <<if $willpower gte _willpowerConfig.maxValue>>
      <<set _willpowerConfig.percent to 100>>
    <</if>>
  <</if>>

  <<if $VanillaPlus.lock.beauty>>
    <<language>>
      <<option 'EN'>>
        <<set $_display_text to 'Your beauty is transcendent.'>>
      <<option 'CN'>>
        <<set $_display_text to '你的容貌超凡脱俗。'>>
    <</language>>
    <<set _beautyConfig.maxValue to maplebirch.get("VanillaPlus").ceiling('beauty')>>
    <<run _beautyConfig.states.push({ requiredValue: _beautyConfig.maxValue, level: 7, color: 'gold', description: $_display_text })>>
    <<if $beauty gte _beautyConfig.maxValue>>
      <<set _beautyConfig.percent to 100>>
    <</if>>
  <</if>>

  <<if $VanillaPlus.lock.promiscuity>>
    <<language>>
      <<option 'EN'>>
        <<set $_display_text to 'You are consumed by your lust.'>>
      <<option 'CN'>>
        <<set $_display_text to '你已被欲望吞噬。'>>
    <</language>>

    <<set _promiscuityConfig.maxValue to maplebirch.get("VanillaPlus").ceiling('promiscuity')>>
    <<run _promiscuityConfig.states.push({ requiredValue: _promiscuityConfig.maxValue, level: 7, color: 'lustful', description: $_display_text })>>
    <<if $promiscuity gte _promiscuityConfig.maxValue>>
      <<set _promiscuityConfig.percent to 100>>
    <</if>>
  <</if>>

  <<if $VanillaPlus.lock.exhibitionism>>
    <<language>>
      <<option 'EN'>>
        <<set $_display_text to 'The pleasure of nakedness drives you to rapture.'>>
      <<option 'CN'>>
        <<set $_display_text to '赤裸之欢愉教你神魂颠倒。'>>
    <</language>>
    <<set _exhibitionismConfig.maxValue to maplebirch.get("VanillaPlus").ceiling('exhibitionism')>>
    <<run _exhibitionismConfig.states.push({ requiredValue: _exhibitionismConfig.maxValue, level: 7, color: 'lustful', description: $_display_text })>>
    <<if $exhibitionism gte _exhibitionismConfig.maxValue>>
      <<set _exhibitionismConfig.percent to 100>>
    <</if>>
  <</if>>

  <<if $VanillaPlus.lock.deviancy>>
    <<language>>
      <<option 'EN'>>
        <<set $_display_text to 'Taboo instincts now rule you.'>>
      <<option 'CN'>>
        <<set $_display_text to '禁忌本能正在主宰你。'>>
    <</language>>
    <<set _deviancyConfig.maxValue to maplebirch.get("VanillaPlus").ceiling('deviancy')>>
    <<run _deviancyConfig.states.push({ requiredValue: _deviancyConfig.maxValue, level: 7, color: 'lustful', description: $_display_text })>>
    <<if $deviancy gte _deviancyConfig.maxValue>>
      <<set _deviancyConfig.percent to 100>>
    <</if>>
  <</if>>
<</widget>>

<!-- 异种癖仪式入口：满足 Gwylan 与仪式条件时显示主持选项。 -->
<<widget 'deadwood-reblooms-deviancy-conduct-link'>>
  <<set $_canConductDeviancy to maplebirch.get("VanillaPlus").deviancy.canConduct and $phase isnot 'no'>>
  <<set $_canConductDeviancy to $_canConductDeviancy and !_gwylanStatus.includes('cautious')>>
  <<set $_canConductDeviancy to $_canConductDeviancy and $settings.tentaclesEnabled and $settings.hypnosisEnabled>>
  <<if $_canConductDeviancy and !playerChastity()>>
    <<language>>
      <<option 'EN'>>
        <<ind>><<link [[Offer to lead the next cleansing|Deadwood Reblooms Deviancy Conduct]]>><</link>> <<note 'Deviancy' 'red'>>
      <<option 'CN'>>
        <<ind>><<link [[提出主持下一场净化仪式|Deadwood Reblooms Deviancy Conduct]]>><</link>> <<note '异种癖' 'red'>>
    <</language>>
    <br>
  <</if>>
<</widget>>

<!-- 露出癖战斗效果：达到特质后调整控制、压力与欲望。 -->
<<widget 'deadwood-reblooms-exhibitionism-trait-effects'>>
  <<if $VanillaPlus.traits.exhibitionism and !$desperateaction and _args[0] isnot 6>>
    <<set $_exhibitionismLevel to _args[0]>>
    <<if $control lt $controlmax>>
      <<control $controlmax>><<gggcontrol>>
    <</if>>
    <<stress $_exhibitionismLevel -300>><<lstress>><<arousal `$_exhibitionismLevel * 100`>><<garousal>>
  <</if>>
<</widget>>

<!-- 原版地图的相邻地点与移动组件仍负责路线和效果，特质只补足白天裸露时被隐藏的链接。 -->
<<widget 'deadwood-reblooms-public-walk-links'>>
  <<if maplebirch.get("VanillaPlus").exhibitionism.canRoamTown and $map.available and $map.available[$passage]>>
    <<set _routeWidgets to { 'Domus Street': 'domus', 'Barb Street': 'barb', 'Danube Street': 'danube', 'Connudatus Street': 'connudatus', 'Cliff Street': 'cliff', 'Wolf Street': 'wolf', 'High Street': 'high', 'Starfish Street': 'starfish', 'Nightingale Street': 'nightingale', 'Oxford Street': 'oxford', 'Mer Street': 'mer', 'Elk Street': 'elk', 'Harvest Street': 'harvest', 'Residential Alleyways': 'residential', 'Commercial Alleyways': 'commercial', 'Industrial Alleyways': 'industrial', 'Park': 'park' }>>
    <<if Time.dayState isnot 'night'>>
      <<set _walkTargets to $map.available[$passage].filter(target => _routeWidgets[target] && !$link_table.some(link => link.includes('|' + target + ']]')) )>>
      <<if _walkTargets.length>>
        <<add_link `'<br>' + lanSwitch('Public walk', '公开裸行') + '<br>'`>><<hideDisplay>>
        <<for _target range _walkTargets>>
          <<run maplebirch.SugarCube.Wikifier.wikifyEval('<<' + _routeWidgets[_target] + '>>')>>
        <</for>>
      <</if>>
    <</if>>
    <<for _walkIndex to 0; _walkIndex lt $link_table.length; _walkIndex++>>
      <<set _walkDestination to $link_table[_walkIndex].split('|')[1]>>
      <<if _walkDestination>>
        <<set _walkDestination to _walkDestination.split(']]')[0]>>
      <</if>>
      <<if $map.available[$passage].includes(_walkDestination) and $link_table[_walkIndex].includes('<<pass 5>>') and !$link_table[_walkIndex].includes('<<exhibitionism6>>')>>
        <<set $link_table[_walkIndex] to $link_table[_walkIndex].replace('<<pass 5>>', '<<pass 5>><<exhibitionism6>><<fameexhibitionism 5>>')>>
      <</if>>
    <</for>>
  <</if>>
<</widget>>

<<widget 'deadwood-reblooms-public-home-exit'>>
  <<set _deadwoodPublicFullyNaked to ['over_upper', 'upper', 'under_upper', 'over_lower', 'lower', 'under_lower'].every(slot => $worn[slot].name === 'naked')>>
  <<language>>
    <<option 'EN'>>
      <<if _deadwoodPublicFullyNaked>>
        Domus Street is busy beyond the door. One step outside, and everyone passing by will see your naked body.
        <br><br>
        <<dooricon 'orphanage'>><<link [[Walk out with nothing on and let the whole street see you (0:01)|Domus Street]]>><<pass 1>><<exhibitionism6>><<fameexhibitionism 5>><</link>>
      <<else>>
        People are passing just outside. What you are wearing cannot hide your exposed body from their eyes.
        <br><br>
        <<dooricon 'orphanage'>><<link [[Walk onto the street exposed and let passers-by stare (0:01)|Domus Street]]>><<pass 1>><<exhibitionism6>><<fameexhibitionism 5>><</link>>
      <</if>>
    <<option 'CN'>>
      <<if _deadwoodPublicFullyNaked>>
        门外就是人来人往的多姆斯街。只要跨出这道门，过路人就会把你赤裸的身体看个清楚。
        <br><br>
        <<dooricon 'orphanage'>><<link [[故意一丝不挂地走上街，任所有人看个清楚 (0:01)|Domus Street]]>><<pass 1>><<exhibitionism6>><<fameexhibitionism 5>><</link>>
      <<else>>
        门外不时有人经过。身上的衣物遮不住暴露的身体。只要走出去，就得迎上那些目光。
        <br><br>
        <<dooricon 'orphanage'>><<link [[带着暴露的身体走上街，任路人打量 (0:01)|Domus Street]]>><<pass 1>><<exhibitionism6>><<fameexhibitionism 5>><</link>>
      <</if>>
  <</language>>
  <br>
<</widget>>

<!-- 日常挣脱入口：体格足够时允许玩家挣断可破坏的束缚。 -->
<<widget 'deadwood-reblooms-physique-break-bindings'>>
  <<if breakableSoftBinding()>>
    <<undobindingsicon>><<lanLink ['Break your bindings', '挣断束缚'] $passage>>
      <<if pcAreArmsBound('any')>>
        <<if pcAreArmsBound('right') and $worn.handheld.name isnot 'naked'>>
          <<handheldruined>>
        <</if>>
        <<arm_unbind>>
      <</if>>
      <<set $_legsBound to ['ropes', 'vines'].includes($worn.feet.name)>>
      <<set $_legsBound to $_legsBound or [$feetuse, $leftleg, $rightleg].includes('bound')>>
      <<if $_legsBound and !['ankle cuffs', 'ball and chain'].includes($worn.feet.name)>>
        <<leg_unbind>>
      <</if>>
      <<if $head is 'bound'>>
        <<set $head to 0>>
      <</if>>
    <</lanLink>> <<note `lanSwitch('Physique', '体格')` 'gold'>>
    <br>
  <</if>>
<</widget>>

<!-- 战斗挣脱结算：消耗体格突破效果并解除指定部位束缚。 -->
<<widget 'deadwood-reblooms-physique-combat-break'>>
  <<set $VanillaPlus.physique.breakUsed to true>>
  <<switch _args[0]>>
    <<case 'arms'>>
      <<arm_unbind>>
      <span class="teal"><<lanSwitch 'You flex hard. The bindings bite into your skin, then snap.' '你猛然发力。束缚勒进皮肤，随后应声断裂。'>></span>
    <<case 'legs'>>
      <<leg_unbind>>
      <<set $_breakFreeText to lanSwitch( 'You spread your legs with all your strength. The bindings strain, then tear apart.', '你用尽力气分开双腿。束缚被拉紧，随即撕裂。' )>>
      <span class="teal"><<= $_breakFreeText>></span>
    <<case 'head'>>
      <<set $head to 0>>
      <span class="teal"><<lanSwitch 'You wrench your head back and rip yourself free.' '你猛地向后仰头，从束缚中挣脱出来。'>></span>
  <</switch>>
<</widget>>

<!-- 诡异镜入口：已发现镜面且通道开放时进入触手平原。 -->
<<widget 'deadwood-reblooms-deviancy-eerie-mirror-link'>><<silently>>
  <<set _banishAvailable to !pcAreArmsBound('both') and $angel gte 4 and $angelBanish gte 1>>
  <<set _showMirrorLink to _args[0] is (_banishAvailable ? 1 : 0) and maplebirch.get("VanillaPlus").deviancy.mirrorOpen and maplebirch.get("VanillaPlus").deviancy.discovered('home')>>
<</silently>>
<<if _showMirrorLink>>
  <<deadwood-reblooms-deviancy-mirror-enter-link 'home'>>
<</if>>
<</widget>>

<<widget 'deadwood-reblooms-deviancy-mirror-enter-link'>>
  <<set $_mirror to _args[0]>>
  <<if maplebirch.get("VanillaPlus").deviancy.mirrorOpen and maplebirch.get("VanillaPlus").deviancy.discovered($_mirror, $_mirror is 'property' ? maplebirch.get("VanillaPlus").realEstate.current?.id : undefined)>>
    <br>
    <<mirroricon 'blood'>><<lanLink ['Step through the eerie mirror', '穿过诡异镜面'] 'Deadwood Reblooms Deviancy Mirror Enter' >>
      <<set $VanillaPlus.deviancy.mirror to $_mirror is 'property' ? 'property:' + maplebirch.get("VanillaPlus").realEstate.current.id : $_mirror>>
      <<if $_mirror is 'property'>>
        <<set $VanillaPlus.deviancy.mirror_property to maplebirch.get("VanillaPlus").realEstate.current.id>>
      <</if>>
      <<run maplebirch.get("VanillaPlus").deviancy.enter()>>
    <</lanLink>>
      <<note `lanSwitch('Deviancy', '异种癖')` 'red'>>
    <br>
  <</if>>
<</widget>>

<!-- 诡异镜出口：按触手平原坐标显示已经发现的返回地点。 -->
<<widget 'deadwood-reblooms-deviancy-mirror-hint'>>
  <<set _mirrorLocations to $VanillaPlus.deviancy.mirror_locations>>
  <<set _mirrorTargets to []>>
  <<if maplebirch.get('Sydney')>>
    <<deadwood-reblooms-sirris-estate-presence>>
  <</if>>
  <<set _sirrisMirrorReady to maplebirch.get('Sydney')
    and $SydneyExpansion.estate.invited and isLoveInterest('Sydney') and _sydneyAtEstate>>
  <<set _kylarMirrorReady to maplebirch.get('Kylar')
    and $KylarExpansion.stay_invited and isLoveInterest('Kylar')
    and C.npc.Kylar.state is 'active'
    and (Time.hour gte 18 or getKylarLocation().area is 'manor_bedroom')
    and (!maplebirch.get('VanillaPlus') or !maplebirch.get("VanillaPlus").realEstate.residenceOf('Kylar'))>>
  <<if _mirrorLocations.home and maplebirch.get("VanillaPlus").deviancy.discovered('home')>>
    <<run _mirrorTargets.push({..._mirrorLocations.home, EN: 'your bedroom mirror', CN: '卧室的镜子'})>>
  <</if>>
  <<for _property range maplebirch.get("VanillaPlus").realEstate.properties>>
    <<set _coordinates to _mirrorLocations['property:' + _property.id]>>
    <<if _coordinates and maplebirch.get("VanillaPlus").deviancy.discovered('property', _property.id)
      and maplebirch.get("VanillaPlus").realEstate.owns(_property.id)
      and !maplebirch.get("VanillaPlus").realEstate.managementFor(_property.id).rented>>
      <<run _mirrorTargets.push({
        north: _coordinates.north,
        east: _coordinates.east,
        EN: _property.name.EN + ' mirror',
        CN: _property.name.CN + '的镜子'
      })>>
    <</if>>
  <</for>>
  <<if _mirrorLocations.farm and maplebirch.get("VanillaPlus").deviancy.discovered('farm')>>
    <<run _mirrorTargets.push({..._mirrorLocations.farm, EN: 'the farm mirror', CN: '农场的镜子'})>>
  <</if>>
  <<if _mirrorLocations.tower and maplebirch.get("VanillaPlus").deviancy.discovered('tower')>>
    <<run _mirrorTargets.push({..._mirrorLocations.tower, EN: 'the tower mirror', CN: '高塔的镜子'})>>
  <</if>>
  <<if _mirrorLocations.temple and maplebirch.get("VanillaPlus").deviancy.discovered('temple')>>
    <<run _mirrorTargets.push({..._mirrorLocations.temple, EN: 'the temple mirror', CN: '神殿宿舍的镜子'})>>
  <</if>>
  <<if _mirrorLocations.sirris and _sirrisMirrorReady and maplebirch.get("VanillaPlus").deviancy.discovered('sirris')>>
    <<run _mirrorTargets.push({..._mirrorLocations.sirris, EN: "Sydney's bedroom mirror", CN: '悉尼卧室的镜子'})>>
  <</if>>
  <<if _mirrorLocations.kylar and _kylarMirrorReady and maplebirch.get("VanillaPlus").deviancy.discovered('kylar')>>
    <<run _mirrorTargets.push({..._mirrorLocations.kylar, EN: "Kylar's bedroom mirror", CN: '凯拉尔卧室的镜子'})>>
  <</if>>
  <!-- 只提示最近的异地出口。同格出口由下方真实链接显示，无需方向提示。 -->
  <<set _nearestMirror to null>><<set _nearestDistance to 100>>
  <<for _target range _mirrorTargets>>
    <<set _distance to Math.abs(_target.north - $tentnorth) + Math.abs(_target.east - $tenteast)>>
    <<if _distance gt 0 and _distance lt _nearestDistance>>
      <<set _nearestMirror to _target>><<set _nearestDistance to _distance>>
    <</if>>
  <</for>>
  <<if _nearestMirror>>
    <<set _northStep to Math.sign(_nearestMirror.north - $tentnorth)>>
    <<set _eastStep to Math.sign(_nearestMirror.east - $tenteast)>>
    <<set _directionEN to
      (_northStep gt 0 ? 'north' : _northStep lt 0 ? 'south' : '') +
      (_eastStep gt 0 ? 'east' : _eastStep lt 0 ? 'west' : '')>>
    <<set _directionCN to
      (_eastStep gt 0 ? '东' : _eastStep lt 0 ? '西' : '') +
      (_northStep gt 0 ? '北' : _northStep lt 0 ? '南' : '')>>
    <span class='purple'>
      <<language>>
        <<option 'EN'>>You feel a faint pull from <<= _nearestMirror.EN>> to the <<= _directionEN>>.
        <<option 'CN'>>你隐约感到<<= _nearestMirror.CN>>在<<= _directionCN>>方牵引着你。
      <</language>>
    </span><br><br>
  <</if>>
<</widget>>

<<widget 'deadwood-reblooms-deviancy-mirror-exits'>>
  <<if $tentacleEntrance is 'mirror' and $VanillaPlus.deviancy.mirror>>
    <<set _mirrorLocations to $VanillaPlus.deviancy.mirror_locations>>
    <<deadwood-reblooms-deviancy-mirror-hint>>
    <<if _mirrorLocations.home
      and $tentnorth is _mirrorLocations.home.north
      and $tenteast is _mirrorLocations.home.east
      and maplebirch.get("VanillaPlus").deviancy.discovered('home')>>
      <<mirroricon 'blood'>><<lanLink ['Climb through the bedroom mirror', '从卧室镜子爬出去'] 'Deadwood Reblooms Deviancy Mirror Home'>><</lanLink>>
      <br>
    <</if>>
    <<for _property range maplebirch.get("VanillaPlus").realEstate.properties>>
      <<capture _property>>
        <<set _mirrorCoordinates to _mirrorLocations['property:' + _property.id]>>
        <<if _mirrorCoordinates and maplebirch.get("VanillaPlus").deviancy.discovered('property', _property.id)
          and maplebirch.get("VanillaPlus").realEstate.owns(_property.id)
          and !maplebirch.get("VanillaPlus").realEstate.managementFor(_property.id).rented>>
          <<if $tentnorth is _mirrorCoordinates.north and $tenteast is _mirrorCoordinates.east>>
            <<language>>
              <<option 'EN'>>
                <<mirroricon 'blood'>><<link _property.mirror_label.EN 'Deadwood Reblooms Deviancy Mirror Property'>>
                  <<set $VanillaPlus.deviancy.mirror_property to _property.id>>
                <</link>>
              <<option 'CN'>>
                <<mirroricon 'blood'>><<link _property.mirror_label.CN 'Deadwood Reblooms Deviancy Mirror Property'>>
                  <<set $VanillaPlus.deviancy.mirror_property to _property.id>>
                <</link>>
            <</language>>
            <br>
          <</if>>
        <</if>>
      <</capture>>
    <</for>>
    <<if _mirrorLocations.farm
      and $tentnorth is _mirrorLocations.farm.north
      and $tenteast is _mirrorLocations.farm.east
      and maplebirch.get("VanillaPlus").deviancy.discovered('farm')>>
      <<mirroricon 'blood'>><<lanLink ['Climb through the farm mirror', '从农场镜子爬出去'] 'Deadwood Reblooms Deviancy Mirror Farm'>><</lanLink>>
      <br>
    <</if>>
    <<if _mirrorLocations.tower
      and $tentnorth is _mirrorLocations.tower.north
      and $tenteast is _mirrorLocations.tower.east
      and maplebirch.get("VanillaPlus").deviancy.discovered('tower')>>
      <<mirroricon 'blood'>><<lanLink ['Climb through the tower mirror', '从高塔镜子爬出去'] 'Deadwood Reblooms Deviancy Mirror Tower'>><</lanLink>>
      <br>
    <</if>>
    <<if _mirrorLocations.temple
      and $tentnorth is _mirrorLocations.temple.north
      and $tenteast is _mirrorLocations.temple.east
      and maplebirch.get("VanillaPlus").deviancy.discovered('temple')>>
      <<mirroricon 'blood'>><<lanLink ['Climb through the temple mirror', '从神殿宿舍的镜子爬出去'] 'Deadwood Reblooms Deviancy Mirror Temple'>><</lanLink>>
      <br>
    <</if>>
    <<if _mirrorLocations.sirris and _sirrisMirrorReady
      and $tentnorth is _mirrorLocations.sirris.north
      and $tenteast is _mirrorLocations.sirris.east
      and maplebirch.get("VanillaPlus").deviancy.discovered('sirris')>>
      <<language>>
        <<option 'EN'>><<mirroricon 'blood'>><<link "Climb through Sydney's bedroom mirror" 'Deadwood Reblooms Deviancy Mirror Sirris'>><</link>>
        <<option 'CN'>><<mirroricon 'blood'>><<link '从悉尼卧室的镜子爬出去' 'Deadwood Reblooms Deviancy Mirror Sirris'>><</link>>
      <</language>><br>
    <</if>>
    <<if _mirrorLocations.kylar and _kylarMirrorReady
      and $tentnorth is _mirrorLocations.kylar.north
      and $tenteast is _mirrorLocations.kylar.east
      and maplebirch.get("VanillaPlus").deviancy.discovered('kylar')>>
      <<language>>
        <<option 'EN'>><<mirroricon 'blood'>><<link "Climb through Kylar's bedroom mirror" 'Deadwood Reblooms Deviancy Mirror Kylar'>><</link>>
        <<option 'CN'>><<mirroricon 'blood'>><<link '从凯拉尔卧室的镜子爬出去' 'Deadwood Reblooms Deviancy Mirror Kylar'>><</link>>
      <</language>><br>
    <</if>>
  <</if>>
<</widget>>

<!-- 淫乱突破结算：解锁上限并展示突破叙述。 -->
<<widget 'deadwood-reblooms-promiscuity-unlock'>>
  <<set $VanillaPlus.lock.promiscuity to true>>
  <<language>>
    <<option 'EN'>>
      Your hands, mouth, thighs and every willing opening have learned what they want. You no longer wait for someone else to use you.
      You guide every touch and offer every part of yourself by choice.
    <br><br>
    <span class="gold">Your promiscuity has broken through its former limits.</span>
    <<option 'CN'>>
      你的手、嘴、双腿与每一处甘愿敞开的入口，都已学会索取自己想要的东西。你不再等待别人享用，而是主动引导每一次触碰，
      亲自献上身体的每一处。
    <br><br>
    <span class="gold">你的淫乱突破了原本的极限。</span>
  <</language>>
  <br><br>
<</widget>>

<!-- 异种癖突破结算：完成仪式后解锁属性上限。 -->
<<widget 'deadwood-reblooms-deviancy-unlock'>>
  <<set $VanillaPlus.lock.deviancy to true>>
  <<language>>
    <<option 'EN'>>
      The last of the poison writhes through your body, following the rhythm you set. The seal closes around it. Gwylan mixed the
      reagents, but the forest moved to your command, through the body you offered it.
    <br><br>
    <span class="gold">Your deviancy has broken through its former limits.</span>
    <<option 'CN'>>
      最后的毒素沿着你定下的节奏，在体内扭动前行。封印随之合拢。格威岚调配了药剂，森林却听从了你的号令，穿行于你主动献上的身体。
    <br><br>
    <span class="gold">你的异种癖突破了原本的极限。</span>
  <</language>>
  <br><br>
<</widget>>

<!-- 露出癖突破结算：汇总关键经历并解锁属性上限。 -->
<<widget 'deadwood-reblooms-exhibitionism-unlock'>>
  <<set $VanillaPlus.lock.exhibitionism to true>>
  <<language>>
    <<option 'EN'>>
      You remember pool water against your bare skin, the ballroom lights upon your naked dance, and strangers staring in the crowded
      high street. The memories send a pleasant heat through you. Shame had every chance to stop you. You showed them more instead.
    <br><br>
    <span class="gold">Your exhibitionism has broken through its former limits.</span>
    <<option 'CN'>>
      你想起池水抚过赤裸皮肤的触感、舞厅灯光下的裸体舞姿，以及商业街上陌生人投来的目光。回忆令热意在体内升起。羞耻本可以阻止你，
      你却选择向他们展示更多。
    <br><br>
    <span class="gold">你的暴露癖突破了原本的极限。</span>
  <</language>>
  <br><br>
<</widget>>

<!-- 体格突破结算：完成挣脱事件后解锁属性上限。 -->
<<widget 'deadwood-reblooms-physique-unlock'>>
  <<set $VanillaPlus.lock.physique to true>>
  <<language>>
    <<option 'EN'>>
      Only after the danger has passed do your muscles begin to tremble. You remember shutters, raiders, fences and cages, all trying to
      keep your body where someone else wanted it. The thought of being held helpless still sends a thrill through you. It no longer feels possible.
    <br><br>
    <span class="gold">Your physique has broken through its former limits.</span>
    <<option 'CN'>>
      直到危险过去，你的肌肉才开始颤抖。你想起卷帘门、袭击者、围墙与牢笼，它们都曾试图把你的身体困在别人指定的位置。
      任人摆布的念头仍会令你战栗，如今却已不再可能。
    <br><br>
    <span class="gold">你的体格突破了原本的极限。</span>
  <</language>>
  <br><br>
<</widget>>

<!-- 意志突破入口：条件满足时允许再次潜向符文。 -->
<<widget 'deadwood-reblooms-willpower-unlock'>>
  <<if maplebirch.get("VanillaPlus").willpower.unlock>>
    <<language>>
      <<option 'EN'>>
        <<link [[Dive towards the rune again|Deadwood Reblooms Willpower Unlock 1]]>><<wraith_pass 2>><</link>>
      <<option 'CN'>>
        <<link [[再次潜向符文|Deadwood Reblooms Willpower Unlock 1]]>><<wraith_pass 2>><</link>>
    <</language>>
    <br>
  <</if>>
<</widget>>

:: Deadwood Reblooms Vanilla Plus Widgets [widget]

<!-- 医院入口：符合条件时提供童贞修复手术。 -->
<<widget 'deadwood-reblooms-virginity-restoration-link'>>
  <<if ($player.vaginaExist and $player.virginity.vaginal isnot true) or ($player.penisExist and $player.virginity.penile isnot true)>>
    <<icon 'virginity-restoration.png'>><<lanLink 'Enquire about virginity restoration (0:10)' 'Deadwood Reblooms Virginity Restoration'
    >><<pass 10>><</lanLink>>
    <br>
  <</if>>
<</widget>>

<!-- 主动请求选项：在遭遇战中按当前姿势列出可提出的性行为。 -->
<<widget 'deadwood-reblooms-promiscuity-request-options'>>
  <<if $VanillaPlus.lock.promiscuity and $enemytype is 'man' and !$npcSub>>
    <<set $_promiscuityLowerExposed to $worn.lower.vagina_exposed gte 1>>
    <<set $_promiscuityLowerExposed to $_promiscuityLowerExposed or setup.clothes.lower[clothesIndex('lower', $worn.lower)].skirt gte 1>>
    <<set $_promiscuityGenitalsExposed to $worn.over_lower.vagina_exposed gte 1>>
    <<set $_promiscuityGenitalsExposed to $_promiscuityGenitalsExposed and $_promiscuityLowerExposed>>
    <<set $_promiscuityGenitalsExposed to $_promiscuityGenitalsExposed and $worn.under_lower.vagina_exposed gte 1>>
    <<set $_promiscuityGenitalsExposed to $_promiscuityGenitalsExposed and $worn.genitals.vagina_exposed gte 1>>
    <<set $_promiscuityFreeHand to $NPCList[$mouthtarget].lefthand is 0 or $NPCList[$mouthtarget].righthand is 0>>
    <<set $_promiscuityFreeMouth to $NPCList[$mouthtarget].mouth is 0>>
    <<set $_promiscuityHis to $NPCList[$mouthtarget].pronouns.his>>
    <<set $_promiscuityFrontAccessible to $position isnot 'wall' or $walltype is 'front'>>
    <<set $_promiscuityBehindAccessible to $walltype isnot 'front'>>
    <<set $_promiscuityPenisAvailable to !['none', 'clothed'].includes($NPCList[$mouthtarget].penis)>>
    <<if $_promiscuityFreeHand and $walltype isnot 'front'>>
      <<if $_promiscuityGenitalsExposed and $player.vaginaExist and !$vaginause and !playerChastity('vagina')>>
        <<set _askActions[lanSwitch('to use '+$_promiscuityHis+' hands on your pussy', '用手玩弄你的小穴')] to 'promiscuity-hand-vagina'>>
      <</if>>
      <<if $_promiscuityGenitalsExposed and $player.penisExist and !$penisuse and !playerChastity('penis')>>
        <<set _askActions[lanSwitch('to use '+$_promiscuityHis+' hands on your penis', '用手玩弄你的肉棒')] to 'promiscuity-hand-penis'>>
      <</if>>
      <<if $_promiscuityGenitalsExposed and !$anususe and !playerChastity('anus')>>
        <<set _askActions[lanSwitch('to use '+$_promiscuityHis+' hands on your anus', '用手玩弄你的菊穴')] to 'promiscuity-hand-anus'>>
      <</if>>
    <</if>>
    <<if $_promiscuityFreeMouth>>
      <<set $_promiscuityCanKiss to $_promiscuityFrontAccessible and !$gloryhole and $head isnot 'bound'>>
      <<set $_promiscuityCanKiss to $_promiscuityCanKiss and !$worn.face.type.includes('covered')>>
      <<set $_promiscuityCanKiss to $_promiscuityCanKiss and !$worn.face.type.includes('gag') and !$mouthuse>>
      <<if $_promiscuityCanKiss>>
        <<set _askActions[lanSwitch('to kiss you', '亲吻你')] to 'promiscuity-mouth-kiss'>>
      <</if>>
      <<if $_promiscuityFrontAccessible and !$gloryhole and !$chestuse>>
        <<set _askActions[lanSwitch('to use '+$_promiscuityHis+' mouth on your chest', '亲吻你的胸部')] to 'promiscuity-mouth-chest'>>
      <</if>>
      <<if $_promiscuityBehindAccessible and !$thighuse>>
        <<set _askActions[lanSwitch('to use '+$_promiscuityHis+' mouth on your thighs', '亲吻你的大腿')] to 'promiscuity-mouth-thigh'>>
      <</if>>
      <<if $_promiscuityBehindAccessible and !$bottomuse>>
        <<set _askActions[lanSwitch('to use '+$_promiscuityHis+' mouth on your bottom', '亲吻你的屁股')] to 'promiscuity-mouth-bottom'>>
      <</if>>
      <<if $_promiscuityGenitalsExposed and $_promiscuityBehindAccessible>>
        <<if $player.vaginaExist and !$vaginause and !playerChastity('vagina')>>
          <<set _askActions[lanSwitch('to use '+$_promiscuityHis+' mouth on your pussy', '舔你的小穴')] to 'promiscuity-mouth-vagina'>>
        <</if>>
        <<if $player.penisExist and !$penisuse and !playerChastity('penis')>>
          <<set _askActions[lanSwitch('to use '+$_promiscuityHis+' mouth on your penis', '舔你的肉棒')] to 'promiscuity-mouth-penis'>>
        <</if>>
        <<if !$anususe and !playerChastity('anus')>>
          <<set _askActions[lanSwitch('to use '+$_promiscuityHis+' mouth on your anus', '舔你的菊穴')] to 'promiscuity-mouth-anus'>>
        <</if>>
      <</if>>
    <</if>>
    <<if $_promiscuityGenitalsExposed and $_promiscuityBehindAccessible and $_promiscuityPenisAvailable>>
      <<if $player.vaginaExist and !$vaginause and !playerChastity('vagina')>>
        <<set _askActions[lanSwitch('to enter your pussy', '插入你的小穴')] to 'promiscuity-penetrate-vagina'>>
      <</if>>
      <<if !$anususe and !playerChastity('anus')>>
        <<set _askActions[lanSwitch('to enter your anus', '插入你的菊穴')] to 'promiscuity-penetrate-anus'>>
      <</if>>
    <</if>>
  <</if>>
<</widget>>

<!-- 主动请求结算：检定请求是否成功并设置对应战斗动作。 -->
<<widget 'deadwood-reblooms-promiscuity-request'>>
  <<if $mouthaction is 'ask' and $askAction.startsWith('promiscuity-')>>
    <<set $_promiscuityChoice to $askAction>>
    <<set $_promiscuityTarget to $mouthtarget>>
    <<set $mouthaction to 0>>
    <<set $mouthactiondefault to 'rest'>>
    <<unset $askAction>>
    <<personselect $_promiscuityTarget>>
    <<set $_promiscuitySuccess to $VanillaPlus.traits.promiscuity or $gamemode is 'soft' or $gloryhole>>
    <<set $_promiscuitySuccess to $_promiscuitySuccess or combatSkillCheck(
      'seduction',
      $_promiscuityTarget,
      $NPCList[$_promiscuityTarget].fullDescription
    )>>
    <<language>>
      <<option 'EN'>>
        You tell <<him>> exactly how you want <<him>> to use your body.
      <<option 'CN'>>
        你明确告诉<<him>>，自己想让<<him>>如何享用你的身体。
    <</language>>
    <<if $_promiscuitySuccess>>
      <span class="green">
        <<language>>
          <<option 'EN'>>
            <<He_Short>> looks over your body, then obeys.
          <<option 'CN'>>
            <<He_Short>>打量着你的身体，随后顺从了你的要求。
        <</language>>
      </span>
      <<switch $_promiscuityChoice>>
        <<case 'promiscuity-hand-vagina' 'promiscuity-hand-penis' 'promiscuity-hand-anus'>>
          <<set $_promiscuityHand to $NPCList[$_promiscuityTarget].lefthand is 0 ? 'lefthand' : 'righthand'>>
          <<if $_promiscuityChoice is 'promiscuity-hand-vagina'>>
            <<set $NPCList[$_promiscuityTarget][$_promiscuityHand] to 'vaginaentrance'>>
            <<set $vaginause to 1>>
            <<set $vaginastate to 'otherhandentrance'>>
            <<set $vaginatarget to $_promiscuityTarget>>
          <<elseif $_promiscuityChoice is 'promiscuity-hand-penis'>>
            <<set $NPCList[$_promiscuityTarget][$_promiscuityHand] to 'penisentrance'>>
            <<set $penisuse to 1>>
            <<set $penisstate to 'otherhandentrance'>>
            <<set $penistarget to $_promiscuityTarget>>
          <<else>>
            <<set $NPCList[$_promiscuityTarget][$_promiscuityHand] to 'anusentrance'>>
            <<set $anususe to 'handentrance'>>
            <<set $anusstate to 'handentrance'>>
            <<set $anustarget to $_promiscuityTarget>>
          <</if>>
        <<case 'promiscuity-mouth-vagina' 'promiscuity-mouth-penis' 'promiscuity-mouth-anus'>>
          <<if $_promiscuityChoice is 'promiscuity-mouth-vagina'>>
            <<set $NPCList[$_promiscuityTarget].mouth to 'vaginaentrance'>>
            <<set $vaginause to 'othermouth'>>
            <<set $vaginastate to 'othermouthentrance'>>
            <<set $vaginatarget to $_promiscuityTarget>>
          <<elseif $_promiscuityChoice is 'promiscuity-mouth-penis'>>
            <<set $NPCList[$_promiscuityTarget].mouth to 'penisentrance'>>
            <<set $penisuse to 'othermouth'>>
            <<set $penisstate to 'othermouthentrance'>>
            <<set $penistarget to $_promiscuityTarget>>
          <<else>>
            <<set $NPCList[$_promiscuityTarget].mouth to 'anusentrance'>>
            <<set $anususe to 'othermouth'>>
            <<set $anusstate to 'othermouthentrance'>>
            <<set $anustarget to $_promiscuityTarget>>
          <</if>>
        <<case 'promiscuity-mouth-kiss'>>
          <<set $NPCList[$_promiscuityTarget].mouth to 'kissentrance'>>
          <<set $mouthuse to 'kiss'>>
          <<set $mouthstate to 'kissentrance'>>
          <<set $mouthtarget to $_promiscuityTarget>>
        <<case 'promiscuity-mouth-chest'>>
          <<set $NPCList[$_promiscuityTarget].mouth to 'chestentrance'>>
          <<set $chestuse to 'mouth'>>
          <<set $cheststate to 'mouthentrance'>>
          <<set $chesttarget to $_promiscuityTarget>>
        <<case 'promiscuity-mouth-thigh'>>
          <<set $NPCList[$_promiscuityTarget].mouth to 'thigh'>>
          <<set $thighuse to 'mouth'>>
          <<set $thightarget to $_promiscuityTarget>>
        <<case 'promiscuity-mouth-bottom'>>
          <<set $NPCList[$_promiscuityTarget].mouth to 'bottom'>>
          <<set $bottomuse to 'mouth'>>
          <<set $bottomtarget to $_promiscuityTarget>>
        <<case 'promiscuity-penetrate-vagina'>>
          <<deadwood-reblooms-promiscuity-request-penetration 'vagina' $_promiscuityTarget>>
        <<case 'promiscuity-penetrate-anus'>>
          <<deadwood-reblooms-promiscuity-request-penetration 'anus' $_promiscuityTarget>>
      <</switch>>
      <<combatpromiscuity6>>
    <<else>>
      <span class="red">
        <<language>>
          <<option 'EN'>>
            <<He_Short>> smirks and ignores your request.
          <<option 'CN'>>
            <<He_Short>>嗤笑一声，无视了你的要求。
        <</language>>
      </span>
      <<if $consensual is 1>>
        <<set $consensual to 0>>
        <<molested>><<controlloss>>
      <</if>>
    <</if>>
  <</if>>
<</widget>>

<!-- 主动插入：将已同意的请求写入原版战斗部位状态。 -->
<<widget 'deadwood-reblooms-promiscuity-request-penetration'>>
  <<set $_promiscuityPart to _args[0]>>
  <<set $_promiscuityTarget to _args[1]>>
  <<personselect $_promiscuityTarget>>
  <<if $_promiscuityPart is 'vagina'>>
    <<set $vaginause to 'penis'>>
    <<set $vaginastate to 'entrance'>>
    <<set $vaginatarget to $_promiscuityTarget>>
    <<set $NPCList[$_promiscuityTarget].penis to 'vaginaentrance'>>
    <<language>>
      <<option 'EN'>>
        <<He_Short>> lines up <<his>> penis and presses the tip against your <<pussy>>.
      <<option 'CN'>>
        <<He_Short>>对准位置，将<<his>>肉棒龟头抵在你的<<pussy>>上。
    <</language>>
  <<else>>
    <<set $anususe to 'penis'>>
    <<set $anusstate to 'entrance'>>
    <<set $anustarget to $_promiscuityTarget>>
    <<set $NPCList[$_promiscuityTarget].penis to 'anusentrance'>>
    <<language>>
      <<option 'EN'>>
        <<He_Short>> lines up <<his>> penis and presses the tip against your anus.
      <<option 'CN'>>
        <<He_Short>>对准位置，将<<his>>肉棒龟头抵在你的菊穴上。
    <</language>>
  <</if>>
<</widget>>

<!-- 请求结果确认：核对动作是否真正执行并结算熟练度。 -->
<<widget 'deadwood-reblooms-promiscuity-direct-result'>>
  <<if _vanillaPlusPromiscuityTarget isnot undefined>>
    <<set $_promiscuityDirectSuccess to false>>
    <<switch _args[0]>>
      <<case 'vagina'>>
        <<set $_promiscuityDirectSuccess to $vaginause is 'penis'>>
        <<set $_promiscuityDirectSuccess to $_promiscuityDirectSuccess and $NPCList[_vanillaPlusPromiscuityTarget].penis is 'vaginaentrance'>>
      <<case 'anus'>>
        <<set $_promiscuityDirectSuccess to $anususe is 'penis'>>
        <<set $_promiscuityDirectSuccess to $_promiscuityDirectSuccess and $NPCList[_vanillaPlusPromiscuityTarget].penis is 'anusentrance'>>
      <<case 'penis-vagina'>>
        <<set $_promiscuityDirectSuccess to $penisuse is 'othervagina'>>
        <<set $_promiscuityDirectSuccess to $_promiscuityDirectSuccess and $NPCList[_vanillaPlusPromiscuityTarget].vagina is 'penisentrance'>>
      <<case 'penis-anus'>>
        <<set $_promiscuityDirectSuccess to $penisuse is 'otheranus'>>
        <<set $_promiscuityDirectSuccess to $_promiscuityDirectSuccess and [
          $NPCList[_vanillaPlusPromiscuityTarget].vagina,
          $NPCList[_vanillaPlusPromiscuityTarget].penis
        ].includes('otheranusentrance')>>
    <</switch>>
    <<set $promiscuityIgnore to _vanillaPlusPromiscuityIgnore>>
    <<if $_promiscuityDirectSuccess>>
      <<combatpromiscuity6>>
    <</if>>
    <<unset _vanillaPlusPromiscuity>>
    <<unset _vanillaPlusPromiscuityIgnore>>
    <<unset _vanillaPlusPromiscuityTarget>>
    <<unset $_promiscuityDirectSuccess>>
  <</if>>
<</widget>>

<!-- 属性面板扩展：为突破上限的属性替换最高等级说明。 -->
<<widget 'deadwood-reblooms-characteristics-degrees-display'>>
  <<if $VanillaPlus.lock.physique>>
    <<language>>
      <<option 'EN'>>
        <<set $_display_text to `Your body is ${$player.bodyshape === 'soft' ? 'powerful' : 'perfectly conditioned'} and at its peak.`>>
      <<option 'CN'>>
        <<set $_display_text to `你的身体${$player.bodyshape === 'soft' ? '强壮' : '健美'}且已臻巅峰。`>>
    <</language>>
    <<set _physiqueConfig.maxValue to Math.floor($physiquesize * 1.25)>>
    <<run Object.assign(_physiqueConfig.states[_physiqueConfig.states.length - 1], { color: 'gold', description: $_display_text })>>
  <</if>>

  <<if $VanillaPlus.lock.willpower>>
    <<language>>
      <<option 'EN'>>
        <<set $_display_text to 'Your will is unshakable.'>>
      <<option 'CN'>>
        <<set $_display_text to '你坚毅不可撼动。'>>
    <</language>>
    <<set _willpowerConfig.maxValue to Math.floor($willpowermax * 1.25)>>
    <<run Object.assign(_willpowerConfig.states[_willpowerConfig.states.length - 1], { color: 'gold', description: $_display_text })>>
  <</if>>

  <<if $VanillaPlus.lock.beauty>>
    <<language>>
      <<option 'EN'>>
        <<set $_display_text to 'Your beauty is transcendent.'>>
      <<option 'CN'>>
        <<set $_display_text to '你的容貌超凡脱俗。'>>
    <</language>>
    <<set _beautyConfig.maxValue to Math.floor($beautymax * 1.25)>>
    <<run Object.assign(_beautyConfig.states[_beautyConfig.states.length - 1], { color: 'gold', description: $_display_text })>>
  <</if>>

  <<if $VanillaPlus.lock.promiscuity>>
    <<language>>
      <<option 'EN'>>
        <<set $_display_text to 'You are consumed by your lust.'>>
      <<option 'CN'>>
        <<set $_display_text to '你已被欲望吞噬。'>>
    <</language>>

    <<set _promiscuityConfig.maxValue to 150>>
    <<run Object.assign(_promiscuityConfig.states[_promiscuityConfig.states.length - 1], { color: 'lustful', description: $_display_text })>>
  <</if>>

  <<if $VanillaPlus.lock.exhibitionism>>
    <<language>>
      <<option 'EN'>>
        <<set $_display_text to 'The pleasure of nakedness drives you to rapture.'>>
      <<option 'CN'>>
        <<set $_display_text to '赤裸之欢愉教你神魂颠倒。'>>
    <</language>>
    <<set _exhibitionismConfig.maxValue to 150>>
    <<run Object.assign(_exhibitionismConfig.states[_exhibitionismConfig.states.length - 1], { color: 'lustful', description: $_display_text })>>
  <</if>>

  <<if $VanillaPlus.lock.deviancy>>
    <<language>>
      <<option 'EN'>>
        <<set $_display_text to 'Taboo instincts now rule you.'>>
      <<option 'CN'>>
        <<set $_display_text to '禁忌本能正在主宰你。'>>
    <</language>>
    <<set _deviancyConfig.maxValue to 150>>
    <<run Object.assign(_deviancyConfig.states[_deviancyConfig.states.length - 1], { color: 'lustful', description: $_display_text })>>
  <</if>>
<</widget>>

<!-- 异种癖仪式入口：满足 Gwylan 与仪式条件时显示主持选项。 -->
<<widget 'deadwood-reblooms-deviancy-conduct-link'>>
  <<set $_canConductDeviancy to maplebirch.VP.deviancy.canConduct and $phase isnot 'no'>>
  <<set $_canConductDeviancy to $_canConductDeviancy and !_gwylanStatus.includes('cautious')>>
  <<set $_canConductDeviancy to $_canConductDeviancy and $settings.tentaclesEnabled and $settings.hypnosisEnabled>>
  <<if $_canConductDeviancy and !playerChastity()>>
    <<language>>
      <<option 'EN'>>
        <<ind>><<link [[Offer to lead the next cleansing|Deadwood Reblooms Deviancy Conduct]]>><</link>> <<note 'Deviancy' 'red'>>
      <<option 'CN'>>
        <<ind>><<link [[提出主持下一场净化仪式|Deadwood Reblooms Deviancy Conduct]]>><</link>> <<note '异种癖' 'red'>>
    <</language>>
    <br>
  <</if>>
<</widget>>

<!-- 露出癖战斗效果：达到特质后调整控制、压力、创伤与欲望。 -->
<<widget 'deadwood-reblooms-exhibitionism-trait-effects'>>
  <<if $VanillaPlus.traits.exhibitionism and !$desperateaction>>
    <<set $_exhibitionismLevel to _args[0]>>
    <<if $control lt $controlmax>>
      <<control $controlmax>><<gggcontrol>>
    <</if>>
    <<stress $_exhibitionismLevel -300>><<combattrauma `$_exhibitionismLevel * -30`>><<lstress>><<ltrauma>><<arousal `$_exhibitionismLevel * 100`>><<garousal>>
  <</if>>
<</widget>>

<!-- 日常挣脱入口：体格足够时允许玩家挣断可破坏的束缚。 -->
<<widget 'deadwood-reblooms-physique-break-bindings'>>
  <<if breakableSoftBinding()>>
    <<undobindingsicon>><<lanLink 'Break your bindings' $passage>>
      <<if pcAreArmsBound('any')>>
        <<if pcAreArmsBound('right') and $worn.handheld.name isnot 'naked'>>
          <<handheldruined>>
        <</if>>
        <<arm_unbind>>
      <</if>>
      <<set $_legsBound to ['ropes', 'vines'].includes($worn.feet.name)>>
      <<set $_legsBound to $_legsBound or [$feetuse, $leftleg, $rightleg].includes('bound')>>
      <<if $_legsBound and !['ankle cuffs', 'ball and chain'].includes($worn.feet.name)>>
        <<leg_unbind>>
      <</if>>
      <<if $head is 'bound'>>
        <<set $head to 0>>
      <</if>>
    <</lanLink>> <<note `lanSwitch('Physique', '体格')` 'gold'>>
    <br>
  <</if>>
<</widget>>

<!-- 战斗挣脱结算：消耗体格突破效果并解除指定部位束缚。 -->
<<widget 'deadwood-reblooms-physique-combat-break'>>
  <<run maplebirch.VP.physique.use()>>
  <<switch _args[0]>>
    <<case 'arms'>>
      <<arm_unbind>>
      <span class="teal"><<lanSwitch 'You flex hard. The bindings bite into your skin, then snap.' '你猛然发力。束缚勒进皮肤，随后应声断裂。'>></span>
    <<case 'legs'>>
      <<leg_unbind>>
      <<set $_breakFreeText to lanSwitch(
        'You spread your legs with all your strength. The bindings strain, then tear apart.',
        '你用尽力气分开双腿。束缚被拉紧，随即撕裂。'
      )>>
      <span class="teal"><<= $_breakFreeText>></span>
    <<case 'head'>>
      <<set $head to 0>>
      <span class="teal"><<lanSwitch 'You wrench your head back and rip yourself free.' '你猛地向后仰头，从束缚中挣脱出来。'>></span>
  <</switch>>
<</widget>>

<!-- 诡异镜入口：已发现镜面且通道开放时进入触手平原。 -->
<<widget 'deadwood-reblooms-deviancy-mirror-enter-link'>>
  <<set $_mirror to _args[0]>>
  <<if maplebirch.VP.deviancy.mirrorOpen and maplebirch.VP.deviancy.discovered($_mirror)>>
    <<mirroricon 'blood'>><<lanLink 'Step through the eerie mirror' 'Deadwood Reblooms Deviancy Mirror Enter'
    >>
      <<set $VanillaPlus.deviancy.mirrorOrigin to $_mirror>>
    <</lanLink>>
      <<note `lanSwitch('Deviancy', '异种癖')` 'red'>>
    <br>
  <</if>>
<</widget>>

<!-- 诡异镜出口：按触手平原坐标显示已经发现的返回地点。 -->
<<widget 'deadwood-reblooms-deviancy-mirror-exits'>>
  <<if $tentacleEntrance is 'vanillaPlusMirror'>>
    <<if $tentnorth is 0 and $tenteast is 0 and maplebirch.VP.deviancy.discovered('home')>>
      <<mirroricon 'blood'>><<lanLink 'Climb through the bedroom mirror' 'Deadwood Reblooms Deviancy Mirror Home'>><</lanLink>>
      <br><br>
    <</if>>
    <<if $tentnorth is 3 and $tenteast is -3 and maplebirch.VP.deviancy.discovered('farm')>>
      <<mirroricon 'blood'>><<lanLink 'Climb through the farm mirror' 'Deadwood Reblooms Deviancy Mirror Farm'>><</lanLink>>
      <br><br>
    <</if>>
    <<if $tentnorth is -3 and $tenteast is 3 and maplebirch.VP.deviancy.discovered('tower')>>
      <<mirroricon 'blood'>><<lanLink 'Climb through the tower mirror' 'Deadwood Reblooms Deviancy Mirror Tower'>><</lanLink>>
      <br><br>
    <</if>>
  <</if>>
<</widget>>

<!-- 淫乱突破结算：解锁上限并展示突破叙述。 -->
<<widget 'deadwood-reblooms-promiscuity-unlock'>>
  <<set $VanillaPlus.lock.promiscuity to true>>
  <<language>>
    <<option 'EN'>>
      Your hands, mouth, thighs and every willing opening have learned what they want. You no longer wait for someone else to use you.
      You guide every touch and offer every part of yourself by choice.
    <br><br>
    <span class="gold">Your promiscuity has broken through its former limits.</span>
    <<option 'CN'>>
      你的手、嘴、双腿与每一处甘愿敞开的入口，都已学会索取自己想要的东西。你不再等待别人享用，而是主动引导每一次触碰，
      亲自献上身体的每一处。
    <br><br>
    <span class="gold">你的淫乱突破了原本的极限。</span>
  <</language>>
  <br><br>
<</widget>>

<!-- 容貌突破入口：条件满足时从摄影棚故障引出突破事件。 -->
<<widget 'deadwood-reblooms-beauty-breakthrough-link'>>
  <<if maplebirch.VP.beauty.unlock>>
    <<language>>
      <<option 'EN'>>
        A light behind the diffuser flickers, then bursts with a sharp pop.
      <br><<link [[Check the failed light|Deadwood Reblooms Beauty Breakthrough]]>><</link>> <<note 'Beauty' 'gold'>>
      <<option 'CN'>>
        柔光板后的灯闪烁几下，随即砰然炸裂。
      <br><<link [[查看坏掉的灯|Deadwood Reblooms Beauty Breakthrough]]>><</link>> <<note '容貌' 'gold'>>
    <</language>>
    <br>
  <</if>>
<</widget>>

<!-- 异种癖突破结算：完成仪式后解锁属性上限。 -->
<<widget 'deadwood-reblooms-deviancy-unlock'>>
  <<set $VanillaPlus.lock.deviancy to true>>
  <<language>>
    <<option 'EN'>>
      The last of the poison writhes through your body, following the rhythm you set. The seal closes around it. Gwylan mixed the
      reagents, but the forest moved to your command, through the body you offered it.
    <br><br>
    <span class="gold">Your deviancy has broken through its former limits.</span>
    <<option 'CN'>>
      最后的毒素沿着你定下的节奏，在体内扭动前行。封印随之合拢。格威岚调配了药剂，森林却听从了你的号令，穿行于你主动献上的身体。
    <br><br>
    <span class="gold">你的异种癖突破了原本的极限。</span>
  <</language>>
  <br><br>
<</widget>>

<!-- 露出癖突破结算：汇总关键经历并解锁属性上限。 -->
<<widget 'deadwood-reblooms-exhibitionism-unlock'>>
  <<set $VanillaPlus.lock.exhibitionism to true>>
  <<language>>
    <<option 'EN'>>
      You remember pool water against your bare skin, the ballroom lights upon your naked dance, and strangers staring in the crowded
      high street. The memories send a pleasant heat through you. Shame had every chance to stop you. You showed them more instead.
    <br><br>
    <span class="gold">Your exhibitionism has broken through its former limits.</span>
    <<option 'CN'>>
      你想起池水抚过赤裸皮肤的触感、舞厅灯光下的裸体舞姿，以及商业街上陌生人投来的目光。回忆令热意在体内升起。羞耻本可以阻止你，
      你却选择向他们展示更多。
    <br><br>
    <span class="gold">你的暴露癖突破了原本的极限。</span>
  <</language>>
  <br><br>
<</widget>>

<!-- 体格突破结算：完成挣脱事件后解锁属性上限。 -->
<<widget 'deadwood-reblooms-physique-unlock'>>
  <<set $VanillaPlus.lock.physique to true>>
  <<language>>
    <<option 'EN'>>
      Only after the danger has passed do your muscles begin to tremble. You remember shutters, raiders, fences and cages, all trying to
      keep your body where someone else wanted it. The thought of being held helpless still sends a thrill through you. It no longer feels possible.
    <br><br>
    <span class="gold">Your physique has broken through its former limits.</span>
    <<option 'CN'>>
      直到危险过去，你的肌肉才开始颤抖。你想起卷帘门、袭击者、围墙与牢笼，它们都曾试图把你的身体困在别人指定的位置。
      任人摆布的念头仍会令你战栗，如今却已不再可能。
    <br><br>
    <span class="gold">你的体格突破了原本的极限。</span>
  <</language>>
  <br><br>
<</widget>>

<!-- 意志突破入口：条件满足时允许再次潜向符文。 -->
<<widget 'deadwood-reblooms-willpower-unlock'>>
  <<if maplebirch.VP.willpower.unlock>>
    <<language>>
      <<option 'EN'>>
        <<link [[Dive towards the rune again|Deadwood Reblooms Willpower Unlock 1]]>><<wraith_pass 2>><</link>>
      <<option 'CN'>>
        <<link [[再次潜向符文|Deadwood Reblooms Willpower Unlock 1]]>><<wraith_pass 2>><</link>>
    <</language>>
    <br>
  <</if>>
<</widget>>

:: Deadwood Reblooms Virginity Restoration []
<<set $outside to 0>><<set $location to 'hospital'>><<effects>>
<<generate1>><<person1>>
<<language>>
  <<option 'EN'>>
    The receptionist types something into <<his>> computer and directs you to the waiting room.
  <<option 'CN'>>
    接待员在电脑上敲了几下，示意你去候诊室等候。
<</language>>
<br><br>
<<endevent>>
<<harper_intro>>
<<language>>
  <<option 'EN'>>
    "Virginity restoration," Harper says, glancing down at <<his>> clipboard. "I can repair the physical signs. It won't erase what happened."
  <<option 'CN'>>
    “童贞修复。”哈珀垂眼看着写字板，“我可以修复身体上的痕迹。它抹不掉已经发生的事。”
<</language>>
<br><br>
<<if $player.vaginaExist and $player.virginity.vaginal isnot true>>
  <<hospitalicon>><<lanLink 'Ask about hymen reconstruction' 'Deadwood Reblooms Virginity Restoration Confirm'>><<set $phase to 'vaginal'>><</lanLink>>
  <br>
<</if>>
<<if $player.penisExist and $player.virginity.penile isnot true>>
  <<hospitalicon>><<lanLink 'Ask about foreskin restoration' 'Deadwood Reblooms Virginity Restoration Confirm'>><<set $phase to 'penile'>><</lanLink>>
  <br>
<</if>>
<<getouticon>><<lanLink 'Leave' 'Hospital Foyer'>><<endevent>><</lanLink>>

:: Deadwood Reblooms Virginity Restoration Confirm []
<<set $outside to 0>><<set $location to 'hospital'>><<effects>>
<<harper_intro>>
<<if $phase is 'vaginal'>>
  <<language>>
    <<option 'EN'>>
      "Hymen reconstruction is a simple operation," Harper says. "It costs £1000 and takes one hour."
    <<option 'CN'>>
      “处女膜修复是个简单的手术。”哈珀说，“费用是 £1000，需要一个小时。”
  <</language>>
<<elseif $phase is 'penile'>>
  <<language>>
    <<option 'EN'>>
      "I can restore your foreskin to its former condition," Harper says. "It costs £1000 and takes one hour."
    <<option 'CN'>>
      “我可以让你的包皮恢复到原来的状态。”哈珀说，“费用是 £1000，需要一个小时。”
  <</language>>
<</if>>
<br><br>
<<if ($phase is 'vaginal' and playerChastity('vagina')) or ($phase is 'penile' and playerChastity('penis'))>>
  <<language>>
    <<option 'EN'>>
      Harper taps <<his>> pen against the clipboard. "I can't operate while that remains in place."
    <<option 'CN'>>
      哈珀用笔轻点写字板。“那东西还戴着，我没法做手术。”
  <</language>>
  <br><br>
<<elseif $money gte 100000 and (($phase is 'vaginal' and $player.vaginaExist and $player.virginity.vaginal isnot true) or ($phase is 'penile' and $player.penisExist and $player.virginity.penile isnot true))>>
  <<ind>><<lanLink 'Accept (1:00)' 'Deadwood Reblooms Virginity Restoration Surgery'>><<pass 1 hours>><</lanLink>>
  <br>
<<else>>
  <<language>>
    <<option 'EN'>>
      You can't afford it.
    <<option 'CN'>>
      你的钱不够。
  <</language>>
  <br><br>
<</if>>
<<getouticon>><<lanLink 'Leave' 'Hospital Foyer'>><<endevent>><</lanLink>>

:: Deadwood Reblooms Virginity Restoration Surgery []
<<set $outside to 0>><<set $location to 'hospital'>><<effects>>
<<money -100000 'hospitalVirginityRestoration'>>
<<upperstrip>><<lowerstrip>><<underlowerstrip>><<underupperstrip>>
<<language>>
  <<option 'EN'>>
    Harper accepts the payment. "Please undress," <<he>> says, standing to leave the room.
    <br><br>
    You strip and wait. <<He>> soon returns with a medical gown and leads you to a small room. You lie on the bed as instructed. Harper presses a mask
    over your face. Your thoughts blur. Just before everything goes dark, you see <<him>> reach into <<his>> pocket.
  <<option 'CN'>>
    哈珀收下钱。“请脱掉衣服。”<<he>>说着起身离开房间。
    <br><br>
    你脱光衣服等候。<<He>>很快拿着一件手术服回来，将你领进一间摆着小床的房间。你依言躺下。哈珀把面罩压在你脸上，你的思绪渐渐模糊。
    在一切陷入黑暗前，你看见<<him>>把手伸进口袋。
<</language>>
<br><br>
<<fameexhibitionism 10 'pic'>>
<<lanLink 'Next' 'Deadwood Reblooms Virginity Restoration Done'>><</lanLink>>

:: Deadwood Reblooms Virginity Restoration Done []
<<set $outside to 0>><<set $location to 'hospital'>><<effects>>
<<if $phase is 'vaginal'>>
  <<set $player.virginity.vaginal to true>>
  <<if $player.virginityDetails?.vaginal>>
    <<unset $player.virginityDetails.vaginal>>
  <</if>>
<<elseif $phase is 'penile'>>
  <<set $player.virginity.penile to true>>
  <<if $player.virginityDetails?.penile>>
    <<unset $player.virginityDetails.penile>>
  <</if>>
<</if>>
<<language>>
  <<option 'EN'>>
    You wake in the same room, sore between your legs. Harper enters and consults <<his>> clipboard.
    <br><br>
    "The operation was successful," <<he>> says. <<His>> eyes linger between your thighs. "Physically, you're a virgin again."
    <br><br>
    <<He>> turns a page. "You can leave straight away. Be well." <<He>> leaves you to dress.
  <<option 'CN'>>
    你在同一间房里醒来，双腿之间隐隐作痛。哈珀走进来，查看<<his>>写字板。
    <br><br>
    “手术很成功。”<<he>>说。<<His>>目光在你双腿之间停留片刻。“从身体上说，你又是童贞了。”
    <br><br>
    <<He>>翻过一页。“你现在就可以走了。保重。”<<He>>留下你独自穿衣。
<</language>>
<br><br>
<<endevent>>
<<lanLink 'Next' 'Hospital Foyer'>><<clotheson>><</lanLink>>



:: Deadwood Reblooms Finance Risk Widgets [widget]
<<widget 'deadwood-finance-risk-summary'>>
  <<if $VanillaPlus.finance.collection.amount gt 0>>
    <span class='red'><<lanSwitch 'Outstanding recovery debt: ' '待追偿欠款：'>><<deadwood-reblooms-finance-money $VanillaPlus.finance.collection.amount>></span><br>
    <<lanSwitch 'Payment deadline: ' '缴清期限：'>><<deadwood-reblooms-finance-date $VanillaPlus.finance.collection.due_day>><br>
    <<if $location is 'financial_centre'>>
      <<lanLink ['Deal with the debt', '处理欠款'] 'Deadwood Reblooms Financial Debt'>><</lanLink>><br>
    <<else>><<lanSwitch 'Visit the financial centre to settle the debt.' '到金融中心办理清偿。'>><br><</if>>
  <</if>>
  <<if $VanillaPlus.finance.brokerage.margin.positions.length>>
    <<lanSwitch 'Margin positions: ' '保证金持仓：'>><<= $VanillaPlus.finance.brokerage.margin.positions.length>> ·
    <<set $_margin_equity to maplebirch.get('VanillaPlus').finance.margin.equityTotal>>
    <<lanSwitch 'Current equity: ' '当前权益：'>><<deadwood-reblooms-finance-money $_margin_equity>><br>
  <</if>>
<</widget>>

<<widget 'deadwood-finance-margin-quote'>>
  <<if _args[0]>>
    <<lanSwitch 'Order value: ' '合约／股票总值：'>><<deadwood-reblooms-finance-money _args[0].notional>><br>
    <<lanSwitch 'Margin / opening fee: ' '保证金／开仓手续费：'>><<deadwood-reblooms-finance-money _args[0].margin>> / <<deadwood-reblooms-finance-money _args[0].fee>><br>
    <<lanSwitch 'Required funds: ' '本次需划出：'>><<deadwood-reblooms-finance-money _args[0].total>>
    <<if _args[0].total gt $VanillaPlus.finance.brokerage.cash>>
      <span class='red'><<lanSwitch 'Insufficient available funds.' '可用资金不足。'>></span>
    <</if>>
    <br>
  <<else>><span class='red'><<lanSwitch 'Enter a valid quantity to obtain a quote.' '填写有效数量后才能报价。'>></span><br><</if>>
<</widget>>

<<widget 'deadwood-finance-bank-notice'>>
  <<if $VanillaPlus.finance.bank.loan_missed_payments gt 0 or $VanillaPlus.finance.bank.credit_missed_payments gt 0>>
    <span class='red'><<lanSwitch 'A payment was not covered. Two insufficient payments on the same loan or credit account send its remaining debt to collection.' '有一期还款未付足。同一笔贷款或信用卡累计两次未足额还款后，剩余欠款将转交追偿。'>></span><br>
  <</if>>
  <<deadwood-finance-risk-summary>>
<</widget>>

<<widget 'deadwood-finance-collection-gate'>>
  <<if maplebirch.get('VanillaPlus').finance.collectionEncounter>>
    <<goto 'Deadwood Reblooms Financial Debt Encounter'>>
  <</if>>
<</widget>>

:: Deadwood Reblooms Financial Centre Margin []
<<set $outside to 0>><<set $location to 'financial_centre'>><<effects>>
<<set $_margin to maplebirch.get('VanillaPlus').finance.margin>>
<<if !$_margin.open or !$VanillaPlus.finance.brokerage.opened>>
  <<lanSwitch 'The trading desk is unavailable.' '现在无法办理交易。'>><br>
  <<getouticon>><<lanLink ['Return', '返回'] 'Deadwood Reblooms Financial Centre Securities'>><</lanLink>><<exit>>
<</if>>
<<deadwood-reblooms-adrian-greeting 'financial_centre_securities'>>
<<language>>
  <<option 'EN'>>
    The clerk lays two forms beside the price board. "Financing buys shares. Futures settle the difference when you close them, or when the contract expires. We close positions if the margin runs too low." A smaller line beneath the signature reads: <span class='red'>Losses exceeding the deposit remain payable.</span>
  <<option 'CN'>>
    柜员把两张表放在行情板旁。“融资是借钱买股票。期货在平仓或者到期时结算差价。保证金不够，我们就替你平仓。”签名栏下还有一行小字：<span class='red'>亏损超过保证金的部分仍须偿还。</span>
<</language>><br><br>
<<lanSwitch 'Available securities funds: ' '证券可用资金：'>><<deadwood-reblooms-finance-money $VanillaPlus.finance.brokerage.cash>><br>
<<deadwood-finance-risk-summary>>
<<language>>
  <<option 'EN'>>
    Each opening and closing costs 0.25% of the traded value, at least £1. Stock financing charges 1.4% weekly on the borrowed amount, accrued daily. Positions close when equity falls to a quarter of the deposited margin. Futures expire after fourteen days, including weekends.
  <<option 'CN'>>
    开仓和平仓各收成交金额的 0.25%，最低 £1。融资股票按借款计收每周 1.4% 的利息，逐日累计。权益降至所缴保证金的四分之一时强制平仓。期货十四天后到期，周末也计入期限。
<</language>><br><br>
<<if $VanillaPlus.finance.collection.amount lte 0>>
  <<set _marginSymbol to 'AVY'>>
  <<set _marginShares to 10>><<set _marginLots to 1>><<set _stockLeverage to 2>><<set _futuresLeverage to 5>>
  <<set _marginOptions to {}>>
  <<for $_security range maplebirch.get('VanillaPlus').finance.securities>>
    <<set _marginOptions[lanSwitch($_security.name.EN, $_security.name.CN)] to $_security.symbol>>
  <</for>>
  <h3><<lanSwitch 'Financed shares' '融资股票'>></h3>
  <div class='dr-finance-form'>
  <label><<lanSwitch 'Security: ' '证券：'>><<listbox '_marginSymbol' autoselect>><<optionsfrom _marginOptions>><</listbox>></label><br>
  <label><<lanSwitch 'Shares: ' '股数：'>><<numberbox '_marginShares' 10>></label><br>
  <label><<lanSwitch 'Leverage: ' '杠杆：'>><<listbox '_stockLeverage' autoselect>><<optionsfrom $_margin.terms.stockLeverage>><</listbox>></label><br>
  <<lanLink ['Check the quote', '核对报价']>>
    <<set $_marginQuote to maplebirch.get('VanillaPlus').finance.margin.orderQuote('stock', _marginSymbol, 1, Number(_marginShares), Number(_stockLeverage))>>
    <<replace '#deadwood-stock-quote'>><<deadwood-finance-margin-quote $_marginQuote>><</replace>>
  <</lanLink>><div id='deadwood-stock-quote' aria-live='polite'></div>
  <<lanLink ['Buy with financing', '融资买入'] 'Deadwood Reblooms Financial Centre Margin Result'>>
    <<set $VanillaPlus.finance.last_result to maplebirch.get('VanillaPlus').finance.margin.place('stock', _marginSymbol, 1, Number(_marginShares), Number(_stockLeverage)) ? 'ok' : 'rejected'>>
  <</lanLink>><br><br></div>
  <h3><<lanSwitch 'Futures' '期货'>></h3>
  <div class='dr-finance-form'>
  <<set _futureSymbol to 'INDEX'>><<set _futureOptions to Object.assign({}, _marginOptions)>>
  <<set _futureOptions[lanSwitch('Town index', '小镇指数')] to 'INDEX'>>
  <label><<lanSwitch 'Underlying: ' '标的：'>><<listbox '_futureSymbol' autoselect>><<optionsfrom _futureOptions>><</listbox>></label><br>
  <label><<lanSwitch 'Units: ' '数量：'>><<numberbox '_marginLots' 1>></label><br>
  <label><<lanSwitch 'Leverage: ' '杠杆：'>><<listbox '_futuresLeverage' autoselect>><<optionsfrom $_margin.terms.futuresLeverage>><</listbox>></label><br>
  <<language>>
    <<option 'EN'>>One index contract represents 100 index units. A single-security contract represents one share. The current index is
    <<option 'CN'>>每份指数合约对应 100 个指数单位，个股合约对应一股。当前指数为
  <</language>> <span class='gold'><<= ($_margin.quote('INDEX') / 100).toFixed(2)>></span>.<br>
  <<lanLink ['Check the quote', '核对报价']>>
    <<set $_marginQuote to maplebirch.get('VanillaPlus').finance.margin.orderQuote('futures', _futureSymbol, 1, Number(_marginLots), Number(_futuresLeverage))>>
    <<replace '#deadwood-futures-quote'>><<deadwood-finance-margin-quote $_marginQuote>><</replace>>
  <</lanLink>><div id='deadwood-futures-quote' aria-live='polite'></div>
  <<lanLink ['Open long', '买入开仓'] 'Deadwood Reblooms Financial Centre Margin Result'>>
    <<set $VanillaPlus.finance.last_result to maplebirch.get('VanillaPlus').finance.margin.place('futures', _futureSymbol, 1, Number(_marginLots), Number(_futuresLeverage)) ? 'ok' : 'rejected'>>
  <</lanLink>> | <<lanLink ['Open short', '卖出开仓'] 'Deadwood Reblooms Financial Centre Margin Result'>>
    <<set $VanillaPlus.finance.last_result to maplebirch.get('VanillaPlus').finance.margin.place('futures', _futureSymbol, -1, Number(_marginLots), Number(_futuresLeverage)) ? 'ok' : 'rejected'>>
  <</lanLink>><br></div>
<</if>>
<h3><<lanSwitch 'Open positions' '未平仓持仓'>></h3>
<<for $_position range $_margin.positions>>
  <<capture $_position>>
    <strong><<= $_position.symbol>></strong> · <<lanSwitch `$_position.kind === 'stock' ? 'Financed shares' : 'Futures'` `$_position.kind === 'stock' ? '融资股票' : '期货'`>> · <<lanSwitch `$_position.side === 1 ? 'Long' : 'Short'` `$_position.side === 1 ? '多头' : '空头'`>><br>
    <<lanSwitch 'Leverage / units: ' '杠杆／单位：'>><<= $_position.leverage>>× / <<= $_position.units>> · <<lanSwitch 'Entry / current: ' '开仓／现价：'>><<deadwood-reblooms-finance-money $_position.entry>> / <<deadwood-reblooms-finance-money `$_margin.quote($_position.symbol)`>><br>
    <<lanSwitch 'Margin / equity: ' '保证金／权益：'>><<deadwood-reblooms-finance-money $_position.margin>> / <<deadwood-reblooms-finance-money `$_margin.equity($_position)`>><br>
    <<lanSwitch 'Accrued interest: ' '累计利息：'>><<deadwood-reblooms-finance-money $_position.fees>><br>
    <<if $_position.expires isnot null>>
      <<lanSwitch 'Expiry: ' '到期：'>><<deadwood-reblooms-finance-date $_position.expires>><br>
    <</if>>
    <<lanLink ['Close position', '平仓'] 'Deadwood Reblooms Financial Centre Margin Result'>><<set $VanillaPlus.finance.last_result to maplebirch.get('VanillaPlus').finance.margin.close($_position.id) ? 'closed' : 'rejected'>><</lanLink>> |
    <<lanLink ['Add £1,000 margin', '追加 £1,000 保证金'] 'Deadwood Reblooms Financial Centre Margin Result'>><<set $VanillaPlus.finance.last_result to maplebirch.get('VanillaPlus').finance.margin.topUp($_position.id, 1000) ? 'topped-up' : 'rejected'>><</lanLink>><br><br>
  <</capture>>
<</for>>
<h3><<lanSwitch 'Recent settlements' '最近结算'>></h3>
<<for $_trade range $_margin.history.slice(-10).reverse()>>
  <<= $_trade.symbol>> · <<lanSwitch `$_trade.reason === 'liquidated' ? 'Forced liquidation' : $_trade.reason === 'expired' ? 'Expired' : 'Closed'` `$_trade.reason === 'liquidated' ? '强制平仓' : $_trade.reason === 'expired' ? '到期交割' : '主动平仓'`>> · <<deadwood-reblooms-finance-money $_trade.profit>><br>
<</for>><br>
<<getouticon>><<lanLink ['Return to securities desk', '返回证券业务台'] 'Deadwood Reblooms Financial Centre Securities'>><</lanLink>>

:: Deadwood Reblooms Financial Centre Margin Result []
<<set $outside to 0>><<set $location to 'financial_centre'>><<effects>>
<<if $VanillaPlus.finance.last_result is 'ok'>>
  <<language>>
    <<option 'EN'>>The clerk stamps your order and slides the receipt under the glass. The margin has left your available funds. The numbers on the board keep moving.
    <<option 'CN'>>柜员盖好委托单，把回执从玻璃下推出来。保证金已从可用资金里划走。行情板上的数字仍在变动。
  <</language>>
<<elseif $VanillaPlus.finance.last_result is 'closed'>>
  <<lanSwitch 'The clerk stamps the closing slip. The balance after fees has been settled.' '柜员在平仓单上盖了章。扣除费用后的余额已经结算。'>><br>
  <<set $_settlement to maplebirch.get('VanillaPlus').finance.margin.history.at(-1)>>
  <<if $_settlement>>
    <<lanSwitch 'Profit / loss after fees: ' '扣费后盈亏：'>><<deadwood-reblooms-finance-money $_settlement.profit>><br>
  <</if>>
  <<deadwood-finance-risk-summary>>
<<elseif $VanillaPlus.finance.last_result is 'topped-up'>>
  <<lanSwitch "£1,000 has moved from your available securities funds to the position's margin." '£1,000 已从证券可用资金划入这笔持仓的保证金。'>>
<<else>>
  <span class='red'><<lanSwitch 'The order was rejected. Check the funds, quantity, trading hours and overdue debts.' '委托未获受理。检查可用资金、数量、营业时间与逾期欠款。'>></span>
<</if>><br><br>
<<lanLink ['Return', '返回'] 'Deadwood Reblooms Financial Centre Margin'>><</lanLink>>

:: Deadwood Reblooms Property Collateral []
<<set $outside to 0>><<set $location to 'financial_centre'>><<effects>>
<<set $_estate to maplebirch.get('VanillaPlus').realEstate>>
<<set $_id to $VanillaPlus.real_estate.collateral_property>>
<<set $_limit to $_estate.collateralLimit($_id)>>
<<if $_limit lte 0>>
  <<lanSwitch 'This deed is not available as collateral.' '这份房契现在无法用于抵押。'>><br>
<<else>>
  <<deadwood-reblooms-adrian-greeting 'financial_centre_property'>>
  <<language>>
    <<option 'EN'>>The agent checks the deed against the inspection notes. "You can stay there, or keep collecting rent. If you stop paying, we take the property. An auction does not guarantee that the debt is cleared."
    <<option 'CN'>>中介把房契与查验记录核对了一遍。“你可以继续住，也可以继续收租。停了还款，我们就收房。拍卖不一定能把欠款全部抵清。”
  <</language>><br><br>
  <<lanSwitch 'Appraised value: ' '评估价：'>><<deadwood-reblooms-finance-money `$_estate.appraisal($_id)`>><br>
  <<lanSwitch 'Maximum borrowing (60%): ' '可借上限（60%）：'>><<deadwood-reblooms-finance-money $_limit>><br>
  <<language>>
    <<option 'EN'>>The bank deducts a 2% fee from the advance. Weekly interest is 0.35%. Keep enough in your account for the first instalment.
    <<option 'CN'>>银行从放款中扣除 2% 手续费，周利率为 0.35%。记得在账户里留够第一期还款。
  <</language>><br>
  <<set _collateralAmount to Math.floor($_limit / 100)>>
  <label><<lanSwitch 'Borrow £' '借款 £'>><<numberbox '_collateralAmount' _collateralAmount>></label><br>
  <label><<lanSwitch 'Term (days): ' '期限（天）：'>><<listbox '$VanillaPlus.real_estate.mortgage_term' autoselect>><<optionsfrom $_estate.mortgage.terms.available_terms>><</listbox>></label><br>
  <<lanLink ['Sign the mortgage', '签订抵押借款合同'] 'Deadwood Reblooms Property Collateral Result'>>
    <<set $VanillaPlus.finance.last_result to maplebirch.get('VanillaPlus').realEstate.borrowAgainst($VanillaPlus.real_estate.collateral_property, Number(_collateralAmount), $VanillaPlus.real_estate.mortgage_term)>>
  <</lanLink>><br>
<</if>><br>
<<getouticon>><<lanLink ['Return', '返回'] 'Deadwood Reblooms Property Office'>><</lanLink>>

:: Deadwood Reblooms Property Collateral Result []
<<set $outside to 0>><<set $location to 'financial_centre'>><<effects>>
<<if $VanillaPlus.finance.last_result is 'ok'>>
  <<language>>
    <<option 'EN'>>The clerk registers the charge against your deed. The money appears in your bank account, less the fee. The copy you take away lists the first payment date.
    <<option 'CN'>>柜员登记了房契上的抵押。扣除手续费后的借款进入银行账户。你带走的合同副本上列着第一次还款的日期。
  <</language>>
<<else>><span class='red'><<lanSwitch 'The mortgage could not be arranged.' '这笔抵押借款未能办理。'>></span><</if>><br><br>
<<lanLink ['Return', '返回'] 'Deadwood Reblooms Property Office'>><</lanLink>>

:: Deadwood Reblooms Financial Debt []
<<set $outside to 0>><<set $location to 'financial_centre'>><<effects>>
<<if $VanillaPlus.finance.collection.amount lte 0>>
  <<lanSwitch 'There is no outstanding recovery debt.' '没有尚待追偿的欠款。'>><br><br>
  <<getouticon>><<lanLink ['Return', '返回'] 'Deadwood Reblooms Financial Centre'>><</lanLink>><<exit>>
<</if>>
<<language>>
  <<option 'EN'>>The notice lists the sum still owed after settlement. Beneath it is a deadline. After that, the claim passes to a collector.
  <<option 'CN'>>通知列出了结算后仍需偿还的金额，下面印着缴款期限。超过期限，债权就会转交追债人。
<</language>><br><br>
<<lanSwitch 'Amount due: ' '应还金额：'>><<deadwood-reblooms-finance-money $VanillaPlus.finance.collection.amount>><br>
<<lanSwitch 'Payment deadline: ' '缴清期限：'>><<deadwood-reblooms-finance-date $VanillaPlus.finance.collection.due_day>><br>
<<if Time.days gte $VanillaPlus.finance.collection.due_day>>
  <span class='red'><<lanSwitch 'The payment deadline has passed.' '缴款期限已过。'>></span><br>
<</if>>
<br>
<<lanLink ['Pay from bank funds and cash', '用银行存款与现金缴清'] 'Deadwood Reblooms Financial Debt Result'>><<set $VanillaPlus.finance.last_result to maplebirch.get('VanillaPlus').finance.repayCollection() ? 'ok' : 'rejected'>><</lanLink>><br>
<<lanSwitch 'Bank funds / cash: ' '银行存款／现金：'>><<deadwood-reblooms-finance-money $VanillaPlus.finance.bank.balance>> / <<deadwood-reblooms-finance-money $money>><br>
<<if !$VanillaPlus.finance.collection.extended>>
  <<set $_extensionFee to Math.ceil($VanillaPlus.finance.collection.amount * 0.05)>>
  <<lanSwitch 'Seven-day extension fee: ' '延期七天的费用：'>><<deadwood-reblooms-finance-money $_extensionFee>><br>
  <<if maplebirch.get('VanillaPlus').finance.canExtendCollection>>
    <<lanLink ['Pay the extension fee from your bank account', '从银行账户支付延期费用'] 'Deadwood Reblooms Financial Debt'>><<run maplebirch.get('VanillaPlus').finance.extendCollection()>><</lanLink>><br>
  <<else>><span class='red'><<lanSwitch 'Your bank balance cannot cover the extension fee.' '银行存款不足以支付延期费用。'>></span><br><</if>>
<<else>><span class='blue'><<lanSwitch 'The one extension has already been used.' '这笔欠款已经延期过一次。'>></span><br><</if>><br>
<<getouticon>><<lanLink ['Return', '返回'] 'Deadwood Reblooms Financial Centre'>><</lanLink>>

:: Deadwood Reblooms Financial Debt Result []
<<set $outside to 0>><<set $location to 'financial_centre'>><<effects>>
<<if $VanillaPlus.finance.last_result is 'ok'>><<lanSwitch 'The receipt is stamped PAID.' '收据上盖好了“已缴清”的印章。'>>
<<else>><span class='red'><<lanSwitch 'You cannot cover the outstanding sum.' '你的钱不够缴清这笔欠款。'>></span><</if>><br><br>
<<lanLink ['Return', '返回'] 'Deadwood Reblooms Financial Debt'>><</lanLink>>

:: Deadwood Reblooms Financial Debt Encounter []
<<if $VanillaPlus.finance.collection.amount lte 0>>
  <<goto 'High Street'>><<exit>>
<</if>>
<<run maplebirch.get('VanillaPlus').finance.evadeCollection()>>
<<if $VanillaPlus.finance.collection.destination is null>>
  <<set $VanillaPlus.finance.collection.destination to random(0, 1) is 0 ? 'farm' : 'brothel'>>
<</if>>
<<set $outside to 1>><<set $location to 'town'>><<effects>><<npc Bailey>><<person1>>
<<language>>
  <<option 'EN'>>Bailey steps away from a parked van. A folded notice sticks out of <<his>> pocket. "
  <<if $VanillaPlus.finance.collection.source is 'mortgage'>>
    The house is gone. You still owe money.
  <<elseif $VanillaPlus.finance.collection.source is 'margin'>>
    Playing the markets with money you didn’t have. And now I have to collect what’s left.
  <<elseif $VanillaPlus.finance.collection.source is 'bank'>>
    The bank has waited long enough. Your account is mine now.
  <<else>>
    All those unpaid bills. They're my problem now.
  <</if>>
  " <<He>> blocks your way. "Money. Now."
  <<option 'CN'>>贝利从停着的货车旁走来，口袋里露出折好的催缴单。“
  <<if $VanillaPlus.finance.collection.source is 'mortgage'>>
    房子没了，钱可没还完。
  <<elseif $VanillaPlus.finance.collection.source is 'margin'>>
    没钱还敢玩这么大。到头来，还得我来收尾。
  <<elseif $VanillaPlus.finance.collection.source is 'bank'>>
    银行等得够久了。你的账，现在归我管。
  <<else>>
    欠了这么多账，还得我来收。
  <</if>>
  ”<<He>>挡住你的路。“钱。现在给。”
<</language>><br><br>
<<lanSwitch 'Debt: ' '欠款：'>><<deadwood-reblooms-finance-money $VanillaPlus.finance.collection.amount>><br>
<<lanLink ['Pay', '付款'] 'Deadwood Reblooms Financial Debt Encounter Paid'>><<set $VanillaPlus.finance.last_result to maplebirch.get('VanillaPlus').finance.repayCollection() ? 'ok' : 'rejected'>><</lanLink>><br>
<<lanLink ['Resist', '反抗'] 'Deadwood Reblooms Financial Debt Fight'>><<set $fightstart to 1>><</lanLink>><br>
<<lanLink ['Submit', '顺从'] 'Deadwood Reblooms Financial Debt Taken'>><</lanLink>>

:: Deadwood Reblooms Financial Debt Encounter Paid []
<<effects>><<npc Bailey>><<person1>>
<<if $VanillaPlus.finance.last_result is 'ok'>>
  <<lanSwitch 'Bailey checks the receipt, then lets you past.' '贝利核对了收据，才让你过去。'>><br><br>
  <<lanLink ['Continue', '继续'] 'High Street'>><</lanLink>>
<<else>>
  <<lanSwitch 'Bailey does not move. You still owe the money.' '贝利没有让开。你仍欠着这笔钱。'>><br><br>
  <<lanLink ['Continue', '继续'] 'Deadwood Reblooms Financial Debt Encounter'>><</lanLink>>
<</if>>

:: Deadwood Reblooms Financial Debt Fight []
<<if $fightstart is 1>>
  <<set $fightstart to 0>><<npc Bailey>><<neutral 1>><<maninit>><<set $enemyanger += 200>><<npcidlegenitals>>
  <<lanSwitch 'Bailey reaches for your arm. You strike before the grip closes.' '贝利伸手抓你的胳膊。你抢在被抓住之前动了手。'>><br><br>
<</if>>
<<effects>><<effectsman>><<man>><<stateman>><br><br><<actionsman>>
<<if _combatend or ($pain gte 100 and $willpowerpain is 0)>>
  <span id='next'><<lanLink ['Continue', '继续'] 'Deadwood Reblooms Financial Debt Fight Finish'>><</lanLink>></span><<nexttext>>
<<else>>
  <span id='next'><<lanLink ['Continue', '继续'] 'Deadwood Reblooms Financial Debt Fight'>><</lanLink>></span><<nexttext>>
<</if>>

:: Deadwood Reblooms Financial Debt Fight Finish []
<<effects>>
<<if $enemyhealth lte 0 or $enemyarousal gte $enemyarousalmax>>
  <<run maplebirch.get('VanillaPlus').finance.evadeCollection()>>
  <<lanSwitch 'Bailey staggers back. You get away, but the debt remains.' '贝利踉跄着后退。你脱了身，欠款却仍在那里。'>><br><br>
  <<clotheson>><<endcombat>>
  <<lanLink ['Continue', '继续'] 'High Street'>><</lanLink>>
<<else>>
  <<endcombat>>
